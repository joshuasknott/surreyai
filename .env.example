# Convex backend
CONVEX_URL=https://your-project.convex.cloud
CONVEX_SITE_URL=https://your-project.convex.site
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Clerk auth
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Admin dashboard security
CSRF_SECRET=replace-with-a-long-random-string

# Public website AI assistant
# Paste your Google AI Studio key here. Do not use a PUBLIC_ prefix.
GEMINI_API_KEY=
# Optional kill switch. The assistant is enabled automatically when GEMINI_API_KEY is set unless this is false.
AI_FEATURES_ENABLED=true
# Free-tier confirmed Gemini 3.1 Flash-Lite preview model, with Gemini 3 Flash as automatic fallback.
AI_MODEL=gemini-3.1-flash-lite-preview
AI_FALLBACK_MODEL=gemini-3-flash-preview
AI_THINKING_LEVEL=minimal
AI_MAX_OUTPUT_TOKENS=512
AI_TIMEOUT_MS=4500
AI_ASSISTANT_MAX_INPUT_CHARS=900
AI_ASSISTANT_MAX_MESSAGES=8
