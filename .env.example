# Convex backend
CONVEX_URL=https://your-project.convex.cloud
CONVEX_SITE_URL=https://your-project.convex.site
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Optional: only needed if you still use Convex membership/auth helpers that expect Clerk JWT issuer config.
# Public sites no longer ship an admin CMS or Clerk UI.
# PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Optional server-side contact endpoint credentials. The public form opens
# the visitor's email app and does not use this endpoint.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Public website AI assistant
# Paste your Google AI Studio key here. Do not use a PUBLIC_ prefix.
GEMINI_API_KEY=
# Optional kill switch. The assistant is enabled automatically when GEMINI_API_KEY is set unless this is false.
AI_FEATURES_ENABLED=true
# Gemini 3.1 Flash-Lite is used for fast, low-cost/free-tier assistant and builder responses.
AI_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_THINKING_LEVEL=minimal
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=15000
AI_ASSISTANT_MAX_INPUT_CHARS=1200
AI_ASSISTANT_MAX_MESSAGES=12
# Required when GEMINI_API_KEY is enabled. Set the same value in Convex and every site deployment.
ASSISTANT_RATE_LIMIT_SECRET=replace-with-a-second-long-random-string
# Required by Agentic Builder. Set the same value in Convex and the AI site deployment.
AGENT_BUILDS_SERVER_SECRET=replace-with-a-third-long-random-string
