# Root Convex deployment settings. Keep the real values in a private root
# .env.local when running Convex CLI commands.
CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
CLERK_JWT_ISSUER_DOMAIN=

# AI app server settings. Put the populated values in apps/ai/.env.local;
# Astro reads that app-local file during development and build.
PUBLIC_CLERK_PUBLISHABLE_KEY=
PUBLIC_CLERK_KEYLESS_DISABLED=
CLERK_SECRET_KEY=
CSRF_SECRET=
BLOB_READ_WRITE_TOKEN=

# Planner access and mention-email relay. Use the same random values on the
# AI server and the connected Convex deployment where the code requires it.
PLANNER_SIGN_IN_SECRET=
PLANNER_EMAIL_SECRET=
RESEND_API_KEY=
COMMITTEE_FROM_EMAIL=
CONTACT_FROM_EMAIL=

# Public AI assistant and Agentic Builder. These are server-side values;
# do not rename them with a PUBLIC_ prefix.
GEMINI_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_FALLBACK_MODEL=
AI_THINKING_LEVEL=
AI_FEATURES_ENABLED=true
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=
AI_ASSISTANT_MAX_INPUT_CHARS=
AI_ASSISTANT_MAX_MESSAGES=
ASSISTANT_RATE_LIMIT_SECRET=
AGENT_BUILDS_SERVER_SECRET=

# Portfolio Studio is a separate app. Its Cloudflare Pages, D1, Workers AI,
# publishing and domain variables belong in apps/portfoliostudio/.env.example
# or Wrangler/hosting configuration, not this root file.
