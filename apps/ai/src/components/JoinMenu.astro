---
import { ArrowUpRight, ChevronDown, Landmark, Mail } from 'lucide-astro';
import type { Society } from '@surreysocieties/admin/types';
import SocialIcon from '@surreysocieties/ui/components/SocialIcon';

interface Props { society: Society; }
const { society } = Astro.props;
const communityLinks = [
  { key: 'whatsapp', label: 'WhatsApp', description: 'Society news & group chat' },
  { key: 'discord', label: 'Discord', description: 'Keep the conversation going' },
] as const;
const socialLinks = [
  { key: 'instagram', label: 'Instagram' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'linktree', label: 'Linktree' },
] as const;
---

<details class="society-join-menu ai-join-menu" data-join-menu>
  <summary class="society-nav-join ai-join-trigger">
    Join <ChevronDown class="ai-join-chevron" size={17} aria-hidden="true" />
  </summary>
  <nav class="ai-join-panel" aria-label="Join and follow the society">
    <div class="ai-join-intro">
      <p class="ai-join-title">Come get involved.</p>
      <p class="ai-join-subtitle">Every degree. Every level of experience.</p>
    </div>
    <a class="ai-join-membership" href={society.membershipUrl || society.studentsUnionUrl} target="_blank" rel="noopener noreferrer">
      <Landmark class="ai-join-membership-icon" size={26} aria-hidden="true" />
      <span class="ai-join-copy"><span class="ai-join-label">Join the society</span><span class="ai-join-description">Students’ Union membership</span></span>
      <ArrowUpRight class="ai-join-arrow" size={21} aria-hidden="true" />
    </a>
    <div class="ai-join-community">
      {communityLinks.map(({ key, label, description }) => society.socials[key] && (
        <a class="ai-join-community-link" href={society.socials[key]} target="_blank" rel="noopener noreferrer">
          <span class:list={['ai-join-brand', `ai-join-brand--${key}`]}><SocialIcon name={key} /></span>
          <span class="ai-join-copy"><span class="ai-join-label">{label}</span><span class="ai-join-description">{description}</span></span>
          <ArrowUpRight class="ai-join-arrow" size={20} aria-hidden="true" />
        </a>
      ))}
    </div>
    <div class="ai-join-socials">
      {socialLinks.map(({ key, label }) => society.socials[key] && (
        <a href={society.socials[key]} target="_blank" rel="noopener noreferrer">
          <span class:list={['ai-join-brand', `ai-join-brand--${key}`]}><SocialIcon name={key} /></span>
          <span>{label}</span>
        </a>
      ))}
    </div>
    <a class="ai-join-email" href={`mailto:${society.contactEmail}`}>
      <Mail size={23} aria-hidden="true" /><span>Email us</span><ArrowUpRight class="ai-join-arrow" size={20} aria-hidden="true" />
    </a>
  </nav>
</details>

<style>
  .ai-join-menu { position: relative; flex-shrink: 0; }
  :global(.society-ai .society-header:has(.ai-join-menu[open])) { z-index: 1000; }
  :global(.society-public .society-header) .ai-join-trigger { gap: 9px; }
  :global(.society-public .society-header) .ai-join-menu[open] > .ai-join-trigger { background: #ff4a00; color: #111; }
  .ai-join-chevron { flex-shrink: 0; transition: transform 140ms ease; }
  .ai-join-menu[open] .ai-join-chevron { transform: rotate(180deg); }
  .ai-join-panel {
    box-sizing: border-box;
    position: absolute;
    z-index: 60;
    top: calc(100% + 9px);
    right: 0;
    width: min(356px, calc(100vw - 32px));
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px 20px 7px;
    border: 1px solid #d2ccc3;
    border-radius: 14px;
    background: #fffefa;
    color: #111;
    box-shadow: 0 8px 24px #24201612;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.4;
    text-align: left;
  }
  .ai-join-intro { margin-bottom: 11px; }
  .ai-join-title { margin: 0 0 3px; font-size: 22px; font-weight: 650; line-height: 1.25; letter-spacing: -.035em; }
  .ai-join-subtitle { margin: 0; color: #5b5752; font-size: 13px; line-height: 1.45; letter-spacing: -.025em; }
  .ai-join-panel a { display: flex; align-items: center; color: inherit; text-decoration: none; border-radius: 8px; }
  .ai-join-panel a:focus-visible { outline: 2px solid #111; outline-offset: 2px; }
  .ai-join-panel a:hover { background: #f3efe8; }
  .ai-join-panel .ai-join-membership { min-height: 55px; gap: 14px; padding: 9px 14px; background: #ff4a00; border-radius: 10px; }
  .ai-join-panel .ai-join-membership:hover { background: #ee4500; }
  .ai-join-membership-icon { flex-shrink: 0; }
  .ai-join-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 2px; }
  .ai-join-label { font-size: 16px; font-weight: 600; letter-spacing: -.025em; line-height: 1.3; }
  .ai-join-description { color: #5b5752; font-size: 12px; line-height: 1.4; }
  .ai-join-membership .ai-join-description { color: #111; }
  .ai-join-arrow { flex-shrink: 0; margin-left: auto; }
  .ai-join-community { padding: 0; }
  .ai-join-community-link { min-height: 56px; gap: 15px; padding: 7px 5px; }
  .ai-join-brand { display: flex; flex-shrink: 0; align-items: center; justify-content: center; }
  .ai-join-community .ai-join-brand { width: 34px; }
  .ai-join-community :global(.social-icon) { width: 29px; height: 29px; flex-basis: 29px; }
  .ai-join-brand--whatsapp { color: #11b84c; }
  .ai-join-brand--discord { color: #5865f2; }
  .ai-join-brand--instagram { color: #d52b7c; }
  .ai-join-brand--linkedin { color: #0a77b5; }
  .ai-join-brand--linktree { color: #16b94e; }
  .ai-join-socials { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3px; padding-block: 2px; border-block: 1px solid #d9d4cc; }
  .ai-join-socials a { justify-content: center; gap: 7px; min-height: 44px; padding: 4px 0; font-size: 12px; font-weight: 500; letter-spacing: -.025em; }
  .ai-join-socials :global(.social-icon) { width: 22px; height: 22px; flex-basis: 22px; }
  .ai-join-email { min-height: 44px; gap: 14px; padding: 7px 5px; font-size: 15px; font-weight: 500; }
  @media (max-width: 600px) {
    .ai-join-menu { position: static; }
    .ai-join-panel { top: calc(100% + 4px); left: 12px; right: 12px; width: auto; max-height: calc(100dvh - 150px); }
  }
  @media (max-width: 360px) {
    .ai-join-panel { padding-inline: 14px; }
    .ai-join-subtitle { font-size: 12px; }
    .ai-join-socials a { gap: 5px; font-size: 11px; }
    .ai-join-socials :global(.social-icon) { width: 19px; height: 19px; flex-basis: 19px; }
  }
  @media (prefers-reduced-motion: reduce) { .ai-join-chevron { transition: none; } }
</style>
