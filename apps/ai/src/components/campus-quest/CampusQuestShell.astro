---
---

<div data-cq3-root>
  <div class="cq3-canvas-mount" id="cq3-canvas-mount"></div>
  <div class="cq3-vignette" id="cq3-vignette" hidden></div>

  <div class="cq3-overlay cq3-unsupported" id="cq3-unsupported-screen" hidden>
    <div class="cq3-unsupported-content">
      <div class="cq3-unsupported-icon" aria-hidden="true">&#9888;&#65039;</div>
      <h2 class="cq3-unsupported-title">Browser Not Supported</h2>
      <p class="cq3-unsupported-msg">VibeCooking Caf&eacute; requires WebGL and a desktop browser with pointer lock support.</p>
      <a href="/" class="cq3-back-link">Back to homepage</a>
    </div>
  </div>

  <div class="cq3-overlay cq3-mobile" id="cq3-mobile-screen" hidden>
    <div class="cq3-mobile-content">
      <span class="cq3-badge">3D Cafe Sim</span>
      <h2 class="cq3-mobile-title">Desktop Recommended</h2>
      <p class="cq3-mobile-msg">VibeCooking Caf&eacute; uses pointer lock for mouse look, which works best on desktop browsers. You can still try on mobile, but the experience may be limited.</p>
      <div class="cq3-mobile-actions">
        <button type="button" class="cq3-enter-btn" id="cq3-mobile-enter-btn">Continue Anyway</button>
        <a href="/" class="cq3-back-link">Back to homepage</a>
      </div>
    </div>
  </div>

  <div class="cq3-overlay cq3-start" id="cq3-start-screen" data-screen="start">
    <div class="cq3-start-bg"></div>
    <div class="cq3-start-content">
      <span class="cq3-badge">3D Cafe Sim</span>
      <h1 class="cq3-title">VibeCooking Caf&eacute;</h1>
      <p class="cq3-subtitle">A compact first-person cafe walkthrough. Step inside, walk up to the counter, and collect a fresh coffee.</p>
      <button type="button" class="cq3-enter-btn" id="cq3-enter-btn">Enter Caf&eacute;</button>
      <p class="cq3-hint">Desktop browser with WebGL required. Uses pointer lock for mouse look.</p>
    </div>
  </div>

  <div class="cq3-overlay cq3-loading" id="cq3-loading-screen" data-screen="loading" hidden>
    <div class="cq3-loading-content">
      <div class="cq3-spinner"></div>
      <p class="cq3-loading-text">Loading caf&eacute;&hellip;</p>
      <div class="cq3-progress-track">
        <div class="cq3-progress-fill" id="cq3-progress-fill"></div>
      </div>
      <p class="cq3-progress-pct" id="cq3-progress-pct">0%</p>
    </div>
  </div>

  <div class="cq3-overlay cq3-error" id="cq3-error-screen" data-screen="error" hidden>
    <div class="cq3-error-content">
      <div class="cq3-error-icon" aria-hidden="true">&#9888;&#65039;</div>
      <h2 class="cq3-error-title">Something went wrong</h2>
      <p class="cq3-error-msg" id="cq3-error-msg">An unexpected error occurred.</p>
      <button type="button" class="cq3-retry-btn" id="cq3-retry-btn">Try Again</button>
      <a href="/" class="cq3-back-link">Back to homepage</a>
    </div>
  </div>

  <div class="cq3-hud" id="cq3-hud" hidden>
    <div class="cq3-crosshair" aria-hidden="true"></div>
    <div class="cq3-hud-top">
      <div class="cq3-hud-controls" id="cq3-hud-controls">
        <span class="cq3-key">WASD</span> Move
        <span class="cq3-key">Mouse</span> Look
        <span class="cq3-key">E</span> Interact
      </div>
      <div class="cq3-hud-order" id="cq3-hud-order">
        <span class="cq3-order-label">Objective</span>
        <span class="cq3-order-text" id="cq3-order-text">Walk to the counter and get a coffee.</span>
      </div>
    </div>
    <div class="cq3-hud-bottom">
      <div class="cq3-hud-prepared" id="cq3-hud-prepared" hidden>
        <span class="cq3-prepared-label">Status</span>
        <span class="cq3-prepared-item" id="cq3-prepared-item"></span>
      </div>
      <div class="cq3-hud-prompt" id="cq3-hud-prompt" hidden>
        <span class="cq3-prompt-key">E</span>
        <span class="cq3-prompt-text" id="cq3-prompt-text"></span>
      </div>
      <div class="cq3-hud-attribution">
        <span>&#9749; &ldquo;Isometric Cafe&rdquo; by LowPolyBoy &mdash; CC BY</span>
      </div>
    </div>
  </div>

  <div class="cq3-toast" id="cq3-toast" hidden>
    <span class="cq3-toast-text" id="cq3-toast-text"></span>
  </div>

  <div class="cq3-nudge" id="cq3-nudge" hidden>
    <span class="cq3-nudge-text" id="cq3-nudge-text"></span>
  </div>

  <div class="cq3-pause" id="cq3-pause-screen" hidden>
    <div class="cq3-pause-content">
      <h2 class="cq3-pause-title">Paused</h2>
      <div class="cq3-pause-controls">
        <div class="cq3-pause-row"><span class="cq3-key">WASD</span> Move</div>
        <div class="cq3-pause-row"><span class="cq3-key">Mouse</span> Look around</div>
        <div class="cq3-pause-row"><span class="cq3-key">E</span> Interact at the counter</div>
        <div class="cq3-pause-row"><span class="cq3-key">Esc</span> Pause / unlock cursor</div>
      </div>
      <p class="cq3-pause-hint">Click anywhere to resume the walkthrough</p>
      <p class="cq3-pause-attr">&ldquo;Isometric Cafe&rdquo; by LowPolyBoy &mdash; CC BY</p>
      <a href="/" class="cq3-leave-link">Leave Caf&eacute;</a>
    </div>
  </div>

  <div class="cq3-station-panel" id="cq3-station-panel" hidden>
    <div class="cq3-station-inner">
      <div class="cq3-station-header">
        <h3 class="cq3-station-title" id="cq3-station-title"></h3>
        <p class="cq3-station-desc" id="cq3-station-desc"></p>
      </div>
      <div class="cq3-station-choices" id="cq3-station-choices"></div>
      <div class="cq3-station-footer">
        <button type="button" class="cq3-station-close" id="cq3-station-close">Back to Caf&eacute;</button>
      </div>
    </div>
  </div>

  <div class="cq3-overlay cq3-outcome" id="cq3-outcome-screen" hidden>
    <div class="cq3-outcome-bg"></div>
    <div class="cq3-outcome-content">
      <span class="cq3-outcome-badge">Walkthrough Complete</span>
      <h2 class="cq3-outcome-title" id="cq3-outcome-title"></h2>
      <p class="cq3-outcome-desc" id="cq3-outcome-desc"></p>
      <div class="cq3-outcome-stats">
        <div class="cq3-stat-item">
          <span class="cq3-stat-val" id="cq3-outcome-score">0</span>
          <span class="cq3-stat-label">Coffee</span>
        </div>
        <div class="cq3-stat-item">
          <span class="cq3-stat-val" id="cq3-outcome-orders">0/1</span>
          <span class="cq3-stat-label">Progress</span>
        </div>
      </div>
      <button type="button" class="cq3-restart-btn" id="cq3-restart-btn">Walk Again</button>
      <a href="/" class="cq3-back-link">Back to homepage</a>
    </div>
  </div>

  <div class="cq3-attribution" id="cq3-attribution-panel" hidden>
    <button type="button" class="cq3-attr-toggle" id="cq3-attr-toggle" aria-label="Toggle attribution">&#9432;</button>
    <div class="cq3-attr-body" id="cq3-attr-body" hidden>
      <p>&ldquo;(FREE) Isometric Cafe&rdquo; by <strong>LowPolyBoy</strong> is licensed under <strong>Creative Commons Attribution</strong>.</p>
      <a href="/models/small-cafe/ATTRIBUTION.md" target="_blank" rel="noopener noreferrer">Full attribution</a>
    </div>
  </div>

  <noscript>
    <div class="cq3-nojs">
      <p>JavaScript is required to run VibeCooking Caf&eacute;.</p>
      <a href="/">Return to homepage</a>
    </div>
  </noscript>
</div>

<style>
  [data-cq3-root] {
    position: fixed;
    inset: 0;
    background: #0f0d0a;
    color: #f1f5f9;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    overflow: hidden;
  }

  .cq3-canvas-mount {
    position: absolute;
    inset: 0;
    z-index: 1;
    cursor: pointer;
  }

  .cq3-canvas-mount canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cq3-vignette {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(15,13,10,0.5) 100%);
  }

  .cq3-vignette[hidden] { display: none; }

  /* ── Unsupported / WebGL fail ── */
  .cq3-unsupported-content { text-align: center; padding: 2rem; max-width: 24rem; }
  .cq3-unsupported-icon { font-size: 3rem; margin-bottom: 1rem; line-height: 1; }
  .cq3-unsupported-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.75rem; color: #fb7185; }
  .cq3-unsupported-msg { font-size: 0.9rem; color: #94a3b8; line-height: 1.6; margin-bottom: 1.5rem; }

  /* ── Mobile fallback ── */
  .cq3-mobile-content {
    text-align: center; padding: 3rem 2rem; max-width: 28rem;
    position: relative; z-index: 2;
  }
  .cq3-mobile-title { font-size: clamp(1.5rem, 4vw, 2.4rem); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 0.75rem; color: #faf5eb; }
  .cq3-mobile-msg { font-size: 0.9rem; color: #94a3b8; line-height: 1.7; margin-bottom: 2rem; }
  .cq3-mobile-actions { display: flex; flex-direction: column; align-items: center; gap: 1rem; }

  /* ── Overlays ── */
  .cq3-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cq3-overlay[hidden] {
    display: none;
  }

  /* ── Start Screen ── */
  .cq3-start-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(255, 200, 100, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 70%, rgba(180, 120, 60, 0.06) 0%, transparent 50%),
      #0f0d0a;
  }

  .cq3-start-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 3rem 2rem;
    max-width: 28rem;
  }

  .cq3-badge {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 9999px;
    background: rgba(255, 200, 100, 0.1);
    color: #fbbf24;
    border: 1px solid rgba(255, 200, 100, 0.2);
    margin-bottom: 1.5rem;
  }

  .cq3-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    color: #faf5eb;
  }

  .cq3-subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cq3-enter-btn, .cq3-restart-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 2.4rem;
    font-size: 1rem;
    font-weight: 700;
    color: #0f0d0a;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
    box-shadow: 0 6px 24px rgba(245, 158, 11, 0.3);
    font-family: inherit;
  }

  .cq3-enter-btn:hover, .cq3-restart-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 32px rgba(245, 158, 11, 0.4);
  }

  .cq3-enter-btn:focus-visible, .cq3-restart-btn:focus-visible {
    outline: 2px solid #f59e0b;
    outline-offset: 3px;
  }

  .cq3-enter-btn:active, .cq3-restart-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .cq3-hint {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  /* ── Loading ── */
  .cq3-loading-content { text-align: center; padding: 2rem; }

  .cq3-spinner {
    width: 48px; height: 48px;
    border: 3px solid rgba(255,255,255,0.08);
    border-top-color: #f59e0b;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    animation: cq3-spin 0.8s linear infinite;
  }

  @keyframes cq3-spin { to { transform: rotate(360deg); } }

  .cq3-loading-text { font-size: 1rem; font-weight: 600; color: #cbd5e1; margin-bottom: 1.25rem; }

  .cq3-progress-track {
    width: 240px; height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 3px; overflow: hidden;
    margin: 0 auto 0.5rem;
  }

  .cq3-progress-fill {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #f59e0b, #fbbf24);
    border-radius: 3px;
    transition: width 0.3s ease;
  }

  .cq3-progress-pct { font-size: 0.8rem; font-weight: 700; color: #94a3b8; font-variant-numeric: tabular-nums; }

  /* ── Error ── */
  .cq3-error-content { text-align: center; padding: 2rem; max-width: 24rem; }
  .cq3-error-icon { font-size: 3rem; margin-bottom: 1rem; line-height: 1; }
  .cq3-error-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.75rem; color: #fb7185; }
  .cq3-error-msg { font-size: 0.9rem; color: #94a3b8; line-height: 1.6; margin-bottom: 2rem; word-break: break-word; }

  .cq3-retry-btn, .cq3-back-link {
    font-family: inherit;
  }

  .cq3-retry-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.7rem 1.8rem; font-size: 0.9rem; font-weight: 700;
    color: #fff; background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 9999px; cursor: pointer; transition: all 0.2s; margin-bottom: 1rem;
  }

  .cq3-retry-btn:hover { background: rgba(255,255,255,0.14); }
  .cq3-retry-btn:focus-visible { outline: 2px solid #f59e0b; outline-offset: 3px; }

  .cq3-back-link {
    display: block; font-size: 0.8rem; color: #64748b; text-decoration: none; transition: color 0.2s;
  }

  .cq3-back-link:hover { color: #f59e0b; }

  /* ── HUD ── */
  .cq3-hud {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    display: flex; flex-direction: column; justify-content: space-between;
  }

  .cq3-hud[hidden] { display: none; }

  .cq3-crosshair {
    position: absolute; top: 50%; left: 50%;
    width: 4px; height: 4px; margin: -2px 0 0 -2px;
    background: rgba(255,255,255,0.45);
    border-radius: 50%;
    pointer-events: none;
  }

  .cq3-hud-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 0.75rem; gap: 0.75rem; flex-wrap: wrap;
  }

  .cq3-hud-controls {
    font-size: 0.6rem; color: rgba(255,255,255,0.25);
    display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;
    transition: opacity 0.5s ease;
  }

  .cq3-key {
    display: inline-block; padding: 0.12rem 0.35rem;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.07);
    border-radius: 3px; font-weight: 700; font-size: 0.55rem; color: rgba(255,255,255,0.35);
  }

  .cq3-hud-order {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    background: rgba(15,13,10,0.6); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.5rem; backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    max-width: min(420px, calc(100vw - 1.5rem));
  }

  .cq3-order-label { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #f59e0b; white-space: nowrap; }
  .cq3-order-text { font-size: 0.72rem; font-weight: 600; color: #e2e8f0; line-height: 1.35; }

  .cq3-hud-bottom {
    display: flex; align-items: flex-end; justify-content: space-between;
    padding: 0.75rem; gap: 0.75rem; flex-wrap: wrap;
  }

  .cq3-hud-prepared {
    display: flex; align-items: center; gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2);
    border-radius: 0.5rem;
  }

  .cq3-hud-prepared[hidden] { display: none; }

  .cq3-prepared-label { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; color: #f59e0b; }
  .cq3-prepared-item { font-size: 0.75rem; font-weight: 600; color: #fbbf24; }

  .cq3-hud-prompt {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(15,13,10,0.65); border: 1px solid rgba(245,158,11,0.2);
    border-radius: 0.5rem; backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.3);
  }

  .cq3-hud-prompt[hidden] { display: none; }

  .cq3-prompt-key {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.3);
    border-radius: 4px; font-size: 0.7rem; font-weight: 800; color: #f59e0b;
  }

  .cq3-prompt-text { font-size: 0.78rem; font-weight: 600; color: #e2e8f0; }

  /* ── Toast ── */
  .cq3-toast {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    z-index: 7; padding: 0.65rem 1.3rem;
    background: rgba(110,231,183,0.12); border: 1px solid rgba(110,231,183,0.2);
    border-radius: 0.6rem; backdrop-filter: blur(8px);
    font-size: 0.85rem; font-weight: 700; color: #6ee7b7;
    pointer-events: none;
    animation: cq3-toast-in 0.3s ease forwards;
  }

  .cq3-toast[hidden] { display: none; }

  @keyframes cq3-toast-in {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
    to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  /* ── Nudge ── */
  .cq3-nudge {
    position: absolute; bottom: 7rem; left: 50%; transform: translateX(-50%);
    z-index: 7; padding: 0.5rem 1rem; max-width: 340px; text-align: center;
    background: rgba(15,13,10,0.85); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.5rem; backdrop-filter: blur(8px);
    font-size: 0.72rem; color: #94a3b8; line-height: 1.5;
    pointer-events: none;
  }

  .cq3-nudge[hidden] { display: none; }

  /* ── Pause ── */
  .cq3-pause {
    position: absolute; inset: 0; z-index: 8;
    display: flex; align-items: center; justify-content: center;
    background: rgba(10,8,6,0.6); backdrop-filter: blur(4px); cursor: pointer;
  }

  .cq3-pause[hidden] { display: none; }
  .cq3-pause-content { text-align: center; }
  .cq3-pause-title { font-size: 1.5rem; font-weight: 800; color: #faf5eb; margin-bottom: 1rem; }
  .cq3-pause-controls {
    display: inline-flex; flex-direction: column; gap: 0.5rem;
    margin-bottom: 1.5rem; text-align: left;
    font-size: 0.85rem; color: #cbd5e1;
  }
  .cq3-pause-row { display: flex; align-items: center; gap: 0.6rem; }
  .cq3-pause-attr { font-size: 0.7rem; color: #475569; margin-bottom: 1rem; }
  .cq3-pause-hint { font-size: 0.85rem; color: #94a3b8; margin-bottom: 1rem; }

  /* ── Station Panel ── */
  .cq3-station-panel {
    position: absolute; inset: 0; z-index: 9;
    display: flex; align-items: center; justify-content: center;
    background: rgba(10,8,6,0.7); backdrop-filter: blur(6px);
  }

  .cq3-station-panel[hidden] { display: none; }

  .cq3-station-inner {
    width: 320px; max-width: 90vw;
    background: rgba(20,18,15,0.95);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 1rem; overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    animation: cq3-panel-in 0.2s cubic-bezier(0.16,1,0.3,1) forwards;
  }

  @keyframes cq3-panel-in {
    from { opacity: 0; transform: scale(0.95) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .cq3-station-header { padding: 1.25rem 1.25rem 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .cq3-station-title { font-size: 1.1rem; font-weight: 800; color: #f59e0b; letter-spacing: -0.02em; margin-bottom: 0.4rem; }
  .cq3-station-desc { font-size: 0.78rem; color: #94a3b8; line-height: 1.5; }
  .cq3-station-choices { padding: 0.75rem; display: flex; flex-direction: column; gap: 0.4rem; }

  .cq3-choice-btn {
    display: flex; align-items: center; gap: 0.6rem; width: 100%;
    padding: 0.7rem 0.9rem; font-size: 0.85rem; font-weight: 600;
    color: #e2e8f0; background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 0.6rem; cursor: pointer; transition: all 0.15s ease;
    text-align: left; font-family: inherit;
  }

  .cq3-choice-btn:hover { background: rgba(245,158,11,0.08); border-color: rgba(245,158,11,0.2); transform: translateX(4px); }
  .cq3-choice-btn:focus-visible { outline: 2px solid #f59e0b; outline-offset: 2px; }
  .cq3-choice-btn:active { transform: translateX(2px) scale(0.99); }

  .cq3-choice-arrow {
    flex-shrink: 0; width: 16px; height: 16px; color: #475569; transition: color 0.15s, transform 0.15s;
  }

  .cq3-choice-btn:hover .cq3-choice-arrow { color: #f59e0b; transform: translateX(2px); }

  .cq3-station-footer { padding: 0.5rem 0.75rem 0.75rem; }

  .cq3-station-close {
    width: 100%; padding: 0.6rem; font-size: 0.78rem; font-weight: 600;
    color: #64748b; background: transparent; border: 1px solid rgba(255,255,255,0.05);
    border-radius: 0.5rem; cursor: pointer; transition: all 0.15s; font-family: inherit;
  }

  .cq3-station-close:hover { color: #94a3b8; border-color: rgba(255,255,255,0.1); }
  .cq3-station-close:focus-visible { outline: 2px solid #f59e0b; outline-offset: 2px; }

  /* ── Outcome ── */
  .cq3-outcome-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 40% 40%, rgba(110,231,183,0.08) 0%, transparent 55%),
      radial-gradient(ellipse at 70% 60%, rgba(251,191,36,0.06) 0%, transparent 50%),
      #0f0d0a;
  }

  .cq3-outcome-content {
    position: relative; z-index: 2; text-align: center; padding: 3rem 2rem; max-width: 28rem;
  }

  .cq3-outcome-badge {
    display: inline-block; padding: 0.3rem 0.9rem;
    font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
    border-radius: 9999px; background: rgba(110,231,183,0.1); color: #6ee7b7;
    border: 1px solid rgba(110,231,183,0.2); margin-bottom: 1.5rem;
  }

  .cq3-outcome-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800;
    letter-spacing: -0.04em; margin-bottom: 0.75rem; color: #faf5eb;
  }

  .cq3-outcome-desc { font-size: 0.95rem; color: #94a3b8; line-height: 1.7; margin-bottom: 2rem; }

  .cq3-outcome-stats {
    display: flex; justify-content: center; gap: 2rem; margin-bottom: 2.5rem;
  }

  .cq3-stat-item { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }
  .cq3-stat-item .cq3-stat-val { font-size: 1.8rem; font-weight: 800; color: #fbbf24; }
  .cq3-stat-item .cq3-stat-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #64748b; }

  /* ── Attribution ── */
  .cq3-attribution { position: absolute; bottom: 0.75rem; right: 0.75rem; z-index: 6; }
  .cq3-attribution[hidden] { display: none; }

  .cq3-attr-toggle {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.4); font-size: 1rem; cursor: pointer;
    transition: all 0.2s; display: flex; align-items: center; justify-content: center; pointer-events: auto;
  }

  .cq3-attr-toggle:hover { background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.6); }
  .cq3-attr-toggle:focus-visible { outline: 2px solid #f59e0b; outline-offset: 2px; }

  .cq3-attr-body {
    position: absolute; bottom: calc(100% + 0.5rem); right: 0;
    width: 260px; padding: 1rem;
    background: rgba(15,13,10,0.92); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.75rem; backdrop-filter: blur(12px);
    font-size: 0.75rem; color: #94a3b8; line-height: 1.6;
  }

  .cq3-attr-body[hidden] { display: none; }
  .cq3-attr-body strong { color: #f59e0b; }
  .cq3-attr-body a { display: inline-block; margin-top: 0.5rem; color: #f59e0b; text-decoration: none; font-weight: 600; }
  .cq3-attr-body a:hover { text-decoration: underline; }

  .cq3-nojs {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1rem; z-index: 20; color: #94a3b8; font-size: 0.9rem;
  }

  .cq3-nojs a { color: #f59e0b; text-decoration: none; font-weight: 600; }

  @media (prefers-reduced-motion: reduce) {
    .cq3-spinner { animation: none; }
    .cq3-enter-btn, .cq3-restart-btn { transition: none; }
    .cq3-progress-fill { transition: none; }
    .cq3-station-inner { animation: none; }
    .cq3-choice-btn { transition: none; }
    .cq3-vignette { display: none; }
  }
</style>

<script>
  (function() {
    var ARROW = '<svg class="cq3-choice-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';

    var root = document.querySelector('[data-cq3-root]');
    if (!root) return;

    function hasWebGL() {
      try {
        var c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch (_) { return false; }
    }

    var isMobile = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    var unsupportedScreen = document.getElementById('cq3-unsupported-screen');
    var mobileScreen = document.getElementById('cq3-mobile-screen');
    var mobileEnterBtn = document.getElementById('cq3-mobile-enter-btn');
    var vignetteEl = document.getElementById('cq3-vignette');

    if (!hasWebGL()) {
      if (unsupportedScreen) unsupportedScreen.hidden = false;
      return;
    }

    if (isMobile) {
      if (mobileScreen) mobileScreen.hidden = false;
      var mobileEntered = false;
      if (mobileEnterBtn) {
        mobileEnterBtn.addEventListener('click', function() {
          if (mobileEntered) return;
          mobileEntered = true;
          if (mobileScreen) mobileScreen.hidden = true;
          enterCafe();
        });
      }
      return;
    }

    var startScreen = document.getElementById('cq3-start-screen');
    var loadingScreen = document.getElementById('cq3-loading-screen');
    var errorScreen = document.getElementById('cq3-error-screen');
    var errorMsg = document.getElementById('cq3-error-msg');
    var progressFill = document.getElementById('cq3-progress-fill');
    var progressPct = document.getElementById('cq3-progress-pct');
    var canvasMount = document.getElementById('cq3-canvas-mount');
    var enterBtn = document.getElementById('cq3-enter-btn');
    var retryBtn = document.getElementById('cq3-retry-btn');
    var hud = document.getElementById('cq3-hud');
    var hudControls = document.getElementById('cq3-hud-controls');
    var pauseScreen = document.getElementById('cq3-pause-screen');
    var hudPrompt = document.getElementById('cq3-hud-prompt');
    var promptText = document.getElementById('cq3-prompt-text');
    var orderText = document.getElementById('cq3-order-text');
    var preparedEl = document.getElementById('cq3-hud-prepared');
    var preparedItem = document.getElementById('cq3-prepared-item');
    var toastEl = document.getElementById('cq3-toast');
    var toastText = document.getElementById('cq3-toast-text');
    var nudgeEl = document.getElementById('cq3-nudge');
    var nudgeText = document.getElementById('cq3-nudge-text');
    var stationPanel = document.getElementById('cq3-station-panel');
    var stationTitle = document.getElementById('cq3-station-title');
    var stationDesc = document.getElementById('cq3-station-desc');
    var stationChoices = document.getElementById('cq3-station-choices');
    var stationClose = document.getElementById('cq3-station-close');
    var outcomeScreen = document.getElementById('cq3-outcome-screen');
    var outcomeTitle = document.getElementById('cq3-outcome-title');
    var outcomeDesc = document.getElementById('cq3-outcome-desc');
    var outcomeScore = document.getElementById('cq3-outcome-score');
    var outcomeOrders = document.getElementById('cq3-outcome-orders');
    var restartBtn = document.getElementById('cq3-restart-btn');
    var attrPanel = document.getElementById('cq3-attribution-panel');
    var attrToggle = document.getElementById('cq3-attr-toggle');
    var attrBody = document.getElementById('cq3-attr-body');

    var engineApi = null;
    var attrOpen = false;
    var controlsFadeTimer = null;
    var panelOpen = false;
    var toastTimer = null;
    var nudgeTimer = null;
    var gameState = null;
    var gameModule = null;

    var STATION_DATA = {
      'coffee-counter': {
        title: 'Cafe Counter',
        desc: 'The barista has a fresh coffee ready for you.',
        choices: [
          { id: 'order-coffee', label: 'Take the Coffee' },
        ],
      },
    };

    var HOTSPOT_PROMPTS = {
      'coffee-counter': 'Get Coffee',
    };

    function showScreen(name) {
      if (startScreen) startScreen.hidden = name !== 'start';
      if (loadingScreen) loadingScreen.hidden = name !== 'loading';
      if (errorScreen) errorScreen.hidden = name !== 'error';
      if (pauseScreen) pauseScreen.hidden = true;
    }

    function renderHUD() {
      if (!gameState || !gameModule) return;
      if (orderText) {
        orderText.textContent = gameModule.getObjective(gameState);
      }

      if (preparedEl && preparedItem) {
        if (gameState.hasCoffee) {
          preparedEl.hidden = false;
          preparedItem.textContent = 'Coffee in hand';
        } else {
          preparedEl.hidden = true;
        }
      }
    }

    function showToast(msg) {
      clearTimeout(toastTimer);
      if (toastText) toastText.textContent = msg;
      if (toastEl) toastEl.hidden = false;
      toastTimer = setTimeout(function() {
        if (toastEl) toastEl.hidden = true;
      }, 2000);
    }

    function showNudge(msg) {
      clearTimeout(nudgeTimer);
      if (nudgeText) nudgeText.textContent = msg;
      if (nudgeEl) nudgeEl.hidden = false;
      nudgeTimer = setTimeout(function() {
        if (nudgeEl) nudgeEl.hidden = true;
      }, 4000);
    }

    function showOutcome() {
      if (!gameState || !gameModule) return;
      var outcome = gameModule.getOutcome(gameState);
      if (outcomeTitle) outcomeTitle.textContent = outcome.title;
      if (outcomeDesc) outcomeDesc.textContent = outcome.description;
      if (outcomeScore) outcomeScore.textContent = gameState.hasCoffee ? 'Yes' : 'No';
      if (outcomeOrders) outcomeOrders.textContent = gameModule.getProgress(gameState);
      if (outcomeScreen) outcomeScreen.hidden = false;
      if (hud) hud.hidden = true;
      if (document.pointerLockElement) document.exitPointerLock();
    }

    function openStationPanel(station) {
      if (panelOpen) return;
      panelOpen = true;
      var data = STATION_DATA[station];
      if (!data) { panelOpen = false; return; }

      if (engineApi) engineApi.setInteractionEnabled(false);

      if (stationTitle) stationTitle.textContent = data.title;
      if (stationDesc) stationDesc.textContent = data.desc;

      if (stationChoices) {
        stationChoices.innerHTML = '';
        data.choices.forEach(function(choice) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'cq3-choice-btn';
          btn.innerHTML = '<span>' + choice.label + '</span>' + ARROW;
          btn.addEventListener('click', function() {
            onStationChoice(station, choice.id);
          });
          stationChoices.appendChild(btn);
        });
      }

      if (stationPanel) stationPanel.hidden = false;
      if (hudPrompt) hudPrompt.hidden = true;
      if (document.pointerLockElement) document.exitPointerLock();
    }

    function closeStationPanel() {
      if (!panelOpen) return;
      panelOpen = false;
      if (stationPanel) stationPanel.hidden = true;
      if (gameState && gameState.shiftComplete) {
        showOutcome();
        return;
      }
      if (engineApi) {
        engineApi.setInteractionEnabled(true);
        setTimeout(function() { engineApi.requestPointerLock(); }, 100);
      }
    }

    function onStationChoice(station, choiceId) {
      if (!gameState || !gameModule) return;
      var wasComplete = gameState.shiftComplete;
      var result = gameModule.processStationChoice(gameState, station, choiceId);
      gameState = result.state;

      if (!wasComplete && gameState.shiftComplete && engineApi) {
        engineApi.markCustomerServed(0);
      }

      if (result.toast) showToast(result.toast);
      if (result.nudge) showNudge(result.nudge);

      renderHUD();

      if (gameState.shiftComplete) {
        closeStationPanel();
        return;
      }

      closeStationPanel();
    }

    function enterCafe() {
      if (startScreen) startScreen.hidden = true;
      if (loadingScreen) loadingScreen.hidden = false;
      if (errorScreen) errorScreen.hidden = true;
      if (pauseScreen) pauseScreen.hidden = true;
      if (hud) hud.hidden = true;
      if (attrPanel) attrPanel.hidden = true;
      if (outcomeScreen) outcomeScreen.hidden = true;
      if (vignetteEl) vignetteEl.hidden = true;
      if (stationPanel) stationPanel.hidden = true;
      panelOpen = false;
      clearTimeout(toastTimer);
      clearTimeout(nudgeTimer);

      Promise.all([
        import('../../lib/campus-quest/engine.ts'),
        import('../../lib/campus-quest/game-state.ts'),
      ]).then(function(modules) {
        var engineMod = modules[0];
        gameModule = modules[1];
        gameState = gameModule.createInitialState();

        return engineMod.createCampusQuestEngine(canvasMount, {
          onLoadingProgress: function(pct) {
            if (progressFill) progressFill.style.width = pct + '%';
            if (progressPct) progressPct.textContent = pct + '%';
          },
          onReady: function() {
            showScreen('');
            if (hud) hud.hidden = false;
            if (attrPanel) attrPanel.hidden = false;
            if (vignetteEl) vignetteEl.hidden = false;
            renderHUD();
            if (engineApi) engineApi.requestPointerLock();
          },
          onError: function(msg) {
            if (errorMsg) errorMsg.textContent = msg;
            showScreen('error');
          },
          onPointerLockChange: function(locked) {
            if (panelOpen) return;
            pauseScreen.hidden = locked;
            if (locked) {
              clearTimeout(controlsFadeTimer);
              if (hudControls) hudControls.style.opacity = '1';
              controlsFadeTimer = setTimeout(function() {
                if (hudControls) hudControls.style.opacity = '0';
              }, 5000);
            } else {
              clearTimeout(controlsFadeTimer);
              if (hudControls) hudControls.style.opacity = '1';
            }
          },
          onHotspotChange: function(hotspot) {
            if (panelOpen) return;
            if (hotspot && hudPrompt && promptText) {
              promptText.textContent = HOTSPOT_PROMPTS[hotspot.station] || 'Interact';
              hudPrompt.hidden = false;
            } else if (hudPrompt) {
              hudPrompt.hidden = true;
            }
          },
          onInteract: function(hotspotId) {
            if (panelOpen) return;
            if (STATION_DATA[hotspotId]) {
              openStationPanel(hotspotId);
            }
          },
        });
      }).then(function(api) {
        engineApi = api;
      }).catch(function(err) {
        if (errorMsg) errorMsg.textContent = err instanceof Error ? err.message : 'Failed to initialise.';
        showScreen('error');
      });
    }

    function restartShift() {
      if (engineApi) {
        try { engineApi.dispose(); } catch (_) {}
        engineApi = null;
      }
      gameModule = null;
      gameState = null;
      if (outcomeScreen) outcomeScreen.hidden = true;
      if (vignetteEl) vignetteEl.hidden = true;
      enterCafe();
    }

    enterBtn.addEventListener('click', enterCafe);

    retryBtn.addEventListener('click', function() {
      if (engineApi) { try { engineApi.dispose(); } catch (_) {} engineApi = null; }
      enterCafe();
    });

    if (restartBtn) restartBtn.addEventListener('click', restartShift);

    if (pauseScreen) {
      pauseScreen.addEventListener('click', function() {
        if (engineApi) engineApi.requestPointerLock();
      });
    }

    if (canvasMount) {
      canvasMount.addEventListener('click', function() {
        if (panelOpen) return;
        if (engineApi && !engineApi.isPointerLocked()) engineApi.requestPointerLock();
      });
    }

    if (stationClose) stationClose.addEventListener('click', closeStationPanel);

    document.addEventListener('keydown', function(e) {
      if (e.code === 'Escape' && panelOpen) {
        e.preventDefault();
        e.stopPropagation();
        closeStationPanel();
      }
    });

    if (attrToggle && attrBody) {
      attrToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        attrOpen = !attrOpen;
        attrBody.hidden = !attrOpen;
      });
    }

    function cleanup() {
      clearTimeout(controlsFadeTimer);
      clearTimeout(toastTimer);
      clearTimeout(nudgeTimer);
      if (engineApi) { try { engineApi.dispose(); } catch (_) {} engineApi = null; }
    }

    window.addEventListener('beforeunload', cleanup);
    document.addEventListener('astro:before-swap', cleanup);
    document.addEventListener('astro:before-preparation', cleanup);
  })();
</script>
