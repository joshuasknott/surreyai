---
interface Props {
  title: string;
  description?: string;
  centered?: boolean;
  minHeight?: string;
}

const { title, description, centered = false, minHeight = "auto" } = Astro.props;
---

<section class="animated-hero" style={`min-height: ${minHeight};`}>
  <div class="animated-hero__bg">
    <canvas class="animated-hero__canvas" aria-hidden="true"></canvas>
  </div>

  <div class={`animated-hero__inner ${centered ? 'text-center' : ''}`}>
    <h1 class="animated-hero__title">
      {title}
    </h1>
    {description && (
      <p class="animated-hero__description">
        {description}
      </p>
    )}
    <slot />
  </div>
</section>

<script>
  const heroSections = document.querySelectorAll(".animated-hero");

  heroSections.forEach((hero) => {
    const canvas = hero.querySelector(".animated-hero__canvas") as HTMLCanvasElement | null;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (canvas) {
      const context = canvas.getContext("2d");
      
      const mouse = {
        x: 0,
        y: 0,
        targetX: 0,
        targetY: 0,
        active: false,
        repelRadius: 180,
      };

      // Soft stardust particle configuration
      const particleCount = 70;
      const particles: Array<{
        x: number;
        y: number;
        ox: number; // Original x coordinates
        oy: number; // Original y coordinates
        vx: number;
        vy: number;
        size: number;
        alpha: number;
        targetAlpha: number;
        color: string;
        driftOffset: number;
        driftSpeed: number;
      }> = [];

      const colors = [
        "rgba(79, 70, 229, 0.35)",  // Indigo
        "rgba(124, 58, 237, 0.35)", // Violet
        "rgba(244, 63, 94, 0.28)",  // Coral
        "rgba(245, 158, 11, 0.28)",  // Amber
        "rgba(16, 185, 129, 0.28)"  // Sage
      ];

      const initParticles = (width: number, height: number) => {
        particles.length = 0;
        for (let i = 0; i < particleCount; i++) {
          const px = Math.random() * width;
          const py = Math.random() * height;
          particles.push({
            x: px,
            y: py,
            ox: px,
            oy: py,
            vx: (Math.random() - 0.5) * 0.2,
            vy: (Math.random() - 0.5) * 0.2,
            size: 0.8 + Math.random() * 1.8,
            alpha: 0.12 + Math.random() * 0.4,
            targetAlpha: 0.15 + Math.random() * 0.45,
            color: colors[i % colors.length],
            driftOffset: Math.random() * Math.PI * 2,
            driftSpeed: 0.002 + Math.random() * 0.006,
          });
        }
      };

      const resize = () => {
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        const rect = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, Math.floor(rect.width * ratio));
        canvas.height = Math.max(1, Math.floor(rect.height * ratio));
        context?.setTransform(ratio, 0, 0, ratio, 0, 0);
        initParticles(rect.width, rect.height);
      };

      const draw = (time = 0) => {
        if (!context) return;
        const rect = canvas.getBoundingClientRect();
        context.clearRect(0, 0, rect.width, rect.height);

        if (mouse.active) {
          mouse.x += (mouse.targetX - mouse.x) * 0.08;
          mouse.y += (mouse.targetY - mouse.y) * 0.08;
        }

        // Draw stardust particles
        particles.forEach((p) => {
          // Slow organic sine drift
          p.driftOffset += p.driftSpeed;
          const driftX = Math.sin(p.driftOffset) * 0.12;
          const driftY = Math.cos(p.driftOffset) * 0.12;

          p.x += p.vx + driftX;
          p.y += p.vy + driftY;

          // React to cursor when near
          if (mouse.active) {
            const dx = mouse.x - p.x;
            const dy = mouse.y - p.y;
            const dist = Math.hypot(dx, dy);

            if (dist < mouse.repelRadius) {
              const force = (1 - dist / mouse.repelRadius);
              // Gently push away or swirl around mouse
              const angle = Math.atan2(dy, dx);
              p.vx -= Math.cos(angle) * force * 0.12;
              p.vy -= Math.sin(angle) * force * 0.12;
              p.alpha += (0.8 - p.alpha) * 0.05;
            } else {
              // Return home slowly
              p.vx += (p.ox - p.x) * 0.001;
              p.vy += (p.oy - p.y) * 0.001;
              p.alpha += (p.targetAlpha - p.alpha) * 0.02;
            }
          } else {
            p.vx += (p.ox - p.x) * 0.0005;
            p.vy += (p.oy - p.y) * 0.0005;
            p.alpha += (p.targetAlpha - p.alpha) * 0.02;
          }

          // Damping friction
          p.vx *= 0.96;
          p.vy *= 0.96;

          // Loop boundary wrap
          if (p.x < 0) p.x = rect.width;
          if (p.x > rect.width) p.x = 0;
          if (p.y < 0) p.y = rect.height;
          if (p.y > rect.height) p.y = 0;

          context.fillStyle = p.color;
          context.globalAlpha = p.alpha;
          context.beginPath();
          context.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          context.fill();
        });

        context.globalAlpha = 1.0;
        if (!prefersReducedMotion) requestAnimationFrame(draw);
      };

      resize();
      draw();

      window.addEventListener("resize", resize);

      hero.addEventListener("mousemove", (e: any) => {
        const rect = canvas.getBoundingClientRect();
        mouse.targetX = e.clientX - rect.left;
        mouse.targetY = e.clientY - rect.top;
        if (!mouse.active) {
          mouse.x = mouse.targetX;
          mouse.y = mouse.targetY;
          mouse.active = true;
        }
      });

      hero.addEventListener("mouseenter", () => {
        mouse.active = true;
      });

      hero.addEventListener("mouseleave", () => {
        mouse.active = false;
      });
    }
  });
</script>

<style>
  .animated-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--ai-fg);
    border-bottom: 1px solid var(--ai-border);
    padding: 6rem 1.5rem 4rem; /* Similar to pt-24 pb-16 */
    background: var(--ai-bg);
  }

  .animated-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .animated-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.85;
    pointer-events: none;
  }

  /* Abstract slow-moving color gradients (Google mesh style) */
  .animated-hero__bg::before,
  .animated-hero__bg::after {
    content: "";
    position: absolute;
    width: 55vw;
    height: 55vw;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.16;
    animation: float 22s infinite ease-in-out alternate;
    z-index: 0;
    pointer-events: none;
  }
  
  :root[data-theme="light"] .animated-hero__bg::before,
  :root[data-theme="light"] .animated-hero__bg::after {
    opacity: 0.12;
    filter: blur(140px);
  }

  .animated-hero__bg::before {
    background: var(--ai-coral);
    top: -12vw;
    right: -10vw;
    animation-delay: -5s;
  }

  .animated-hero__bg::after {
    background: var(--ai-azure);
    bottom: -15vw;
    left: -12vw;
  }

  .animated-hero__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 64rem); /* max-w-5xl approx */
    margin: 0 auto;
    width: 100%;
  }

  .animated-hero__inner.text-center {
    text-align: center;
  }

  .animated-hero__title {
    margin: 0 0 1.5rem 0;
    font-size: clamp(2.75rem, 5.5vw, 4.25rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 850;
    background: linear-gradient(135deg, var(--ai-fg) 35%, color-mix(in srgb, var(--ai-fg) 70%, var(--ai-azure)) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .animated-hero__description {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    line-height: 1.625;
    color: var(--ai-fg-muted);
    max-width: 42rem;
    letter-spacing: -0.01em;
  }

  .animated-hero__inner.text-center .animated-hero__description {
    margin-left: auto;
    margin-right: auto;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(4vw, 4vw) scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animated-hero__bg::before,
    .animated-hero__bg::after {
      animation: none;
    }
  }

  @media (min-width: 640px) {
    .animated-hero {
      padding: 8rem 1.5rem 5rem;
    }
  }
</style>
