---
interface Props {
  variant?: "light" | "dark";
  compact?: boolean;
  priority?: boolean;
}

const { variant = "light", compact = false } = Astro.props;
---

<span
  class:list={[
    "brand-logo",
    `brand-logo--${variant}`,
    compact && "brand-logo--compact",
  ]}
  role="img"
  aria-label="Surrey Artificial Intelligence Society"
>
  <img class="brand-logo__mark" src="/logos/society.png" alt="" width="56" height="56" />
  <span class="brand-logo__name" aria-hidden="true">
    <span>Surrey</span>
    <span>Artificial Intelligence</span>
    <span>Society</span>
  </span>
</span>
