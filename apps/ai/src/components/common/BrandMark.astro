---
interface Props {
  size?: "small" | "default" | "large";
}

const { size = "default" } = Astro.props;

const pixelSize = size === "large" ? 80 : size === "small" ? 36 : 48;
const loading = size === "small" ? "lazy" : "eager";
---

<span class:list={["brand-mark", `brand-mark--${size}`]} aria-hidden="true">
  <img
    class="brand-mark__img"
    src="/logos/brand/surrey-ai-avatar-light.png"
    alt=""
    width={pixelSize}
    height={pixelSize}
    loading={loading}
    decoding="async"
  />
</span>

<style>
  .brand-mark {
    display: inline-grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
  }

  .brand-mark--small {
    width: 2.25rem;
    height: 2.25rem;
  }

  .brand-mark--large {
    width: 5rem;
    height: 5rem;
  }

  .brand-mark__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0.4rem;
  }

</style>
