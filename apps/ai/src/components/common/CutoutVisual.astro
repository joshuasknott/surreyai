---
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string;
  title?: string;
  body?: string;
  compact?: boolean;
  align?: "left" | "center" | "right";
  loading?: "eager" | "lazy";
}

const {
  image,
  alt,
  title,
  body,
  compact = false,
  align = "center",
  loading = "lazy",
} = Astro.props;
---

<figure
  class:list={[
    "cutout-visual",
    compact && "cutout-visual--compact",
    `cutout-visual--${align}`,
  ]}
  tabindex="0"
>
  <div class="cutout-visual__glow" aria-hidden="true"></div>
  <Image
    src={image}
    alt={alt}
    widths={[640, 960, 1280, 1600]}
    sizes={compact ? "(min-width: 900px) 38vw, 100vw" : "(min-width: 900px) 48vw, 100vw"}
    class="cutout-visual__image"
    loading={loading}
    format="webp"
    quality={76}
  />

  {(title || body) && (
    <figcaption class="cutout-visual__caption">
      {title && <strong>{title}</strong>}
      {body && <span>{body}</span>}
    </figcaption>
  )}
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".cutout-visual").forEach((visual) => {
    if (visual.dataset.cutoutReady) return;
    visual.dataset.cutoutReady = "true";

    visual.addEventListener("pointermove", (event) => {
      const rect = visual.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      visual.style.setProperty("--tx", `${(-x * 14).toFixed(1)}px`);
      visual.style.setProperty("--ty", `${(-y * 10).toFixed(1)}px`);
      visual.style.setProperty("--rx", `${(y * 1.6).toFixed(2)}deg`);
      visual.style.setProperty("--ry", `${(-x * 2.2).toFixed(2)}deg`);
      visual.classList.add("is-active");
    });

    visual.addEventListener("pointerleave", () => {
      visual.classList.remove("is-active");
      visual.style.removeProperty("--tx");
      visual.style.removeProperty("--ty");
      visual.style.removeProperty("--rx");
      visual.style.removeProperty("--ry");
    });
  });
</script>

<style>
  .cutout-visual {
    --tx: 0px;
    --ty: 0px;
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: grid;
    min-height: clamp(22rem, 38vw, 34rem);
    place-items: center;
    margin: 0;
    overflow: visible;
    isolation: isolate;
    outline: none;
  }

  .cutout-visual--compact {
    min-height: clamp(18rem, 30vw, 27rem);
  }

  .cutout-visual--left {
    justify-items: start;
  }

  .cutout-visual--right {
    justify-items: end;
  }

  .cutout-visual__glow {
    position: absolute;
    inset: 12% 3% 4%;
    z-index: 0;
    border-radius: 999px;
    background:
      radial-gradient(ellipse at 56% 44%, color-mix(in srgb, var(--ai-azure) 20%, transparent), transparent 58%),
      radial-gradient(ellipse at 36% 68%, color-mix(in srgb, var(--ai-coral) 14%, transparent), transparent 52%);
    filter: blur(16px);
    opacity: 0.92;
    transform: translateY(8%);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .cutout-visual::after {
    content: "";
    position: absolute;
    inset: auto 12% 7%;
    z-index: 0;
    height: 12%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-fg) 10%, transparent);
    filter: blur(28px);
    opacity: 0.18;
  }

  .cutout-visual__image {
    position: relative;
    z-index: 2;
    display: block;
    width: min(100%, 48rem);
    height: auto;
    filter: drop-shadow(0 34px 48px rgba(17, 24, 39, 0.16));
    transform: translate3d(var(--tx), var(--ty), 0) rotateX(var(--rx)) rotateY(var(--ry)) scale(1);
    transform-origin: center;
    transition: transform 520ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 520ms ease;
    will-change: transform;
  }

  .cutout-visual:hover .cutout-visual__image,
  .cutout-visual.is-active .cutout-visual__image,
  .cutout-visual:focus-visible .cutout-visual__image {
    filter: drop-shadow(0 42px 60px rgba(17, 24, 39, 0.22));
    transform: translate3d(var(--tx), var(--ty), 0) rotateX(var(--rx)) rotateY(var(--ry)) scale(1.035);
  }

  .cutout-visual:hover .cutout-visual__glow,
  .cutout-visual.is-active .cutout-visual__glow,
  .cutout-visual:focus-visible .cutout-visual__glow {
    opacity: 1;
    transform: translateY(4%) scale(1.04);
  }



  .cutout-visual__caption {
    position: absolute;
    inset: auto clamp(1rem, 3vw, 2rem) clamp(0.2rem, 2vw, 1.1rem);
    z-index: 3;
    max-width: 24rem;
    padding: 0.85rem 1rem;
    border: 1px solid color-mix(in srgb, var(--ai-border-strong) 72%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--ai-surface) 86%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: 0 18px 44px rgba(17, 24, 39, 0.1);
  }

  .cutout-visual__caption strong {
    display: block;
    color: var(--ai-fg);
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .cutout-visual__caption span {
    display: block;
    margin-top: 0.35rem;
    color: var(--ai-fg-muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .cutout-visual:focus-visible {
    outline: 3px solid var(--ai-azure);
    outline-offset: 0.35rem;
  }



  @media (max-width: 640px) {
    .cutout-visual {
      min-height: 19rem;
    }

    .cutout-visual__caption {
      position: relative;
      inset: auto;
      margin-top: -1.5rem;
      width: min(100%, 24rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cutout-visual__image,
    .cutout-visual__glow {
      transition: none;
      will-change: auto;
    }

    .cutout-visual:hover .cutout-visual__image,
    .cutout-visual.is-active .cutout-visual__image,
    .cutout-visual:focus-visible .cutout-visual__image {
      transform: none;
    }


  }
</style>
