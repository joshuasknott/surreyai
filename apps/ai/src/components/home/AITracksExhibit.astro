---
import TrackLab from "./track-lab/TrackLab.astro";
---

<section id="tracks" class="tracks-exhibit" aria-labelledby="tracks-title">
  <div class="tracks-exhibit__mesh" aria-hidden="true"></div>

  <div class="tracks-exhibit__inner">
    <div class="tracks-exhibit__header">
      <p class="tracks-exhibit__kicker">Central Experience</p>
      <h2 id="tracks-title" class="tracks-exhibit__title">
        AI Tracks, compressed into one live lab.
      </h2>
      <p class="tracks-exhibit__lead">
        Pick a track. The lab reconfigures the explanation, society activities, and visual prototype into one coherent exhibit, so you can understand where to start without navigating six separate demos.
      </p>
    </div>

    <div class="tracks-exhibit__frame">
      <div class="tracks-exhibit__frame-glow" aria-hidden="true"></div>
      <TrackLab />
    </div>
  </div>
</section>

<style>
  .tracks-exhibit {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 9vw, 8rem) 1.5rem;
    border-block: 1px solid var(--ai-border);
    background:
      radial-gradient(circle at 18% 20%, color-mix(in srgb, var(--ai-purple) 20%, transparent), transparent 29rem),
      radial-gradient(circle at 84% 34%, color-mix(in srgb, var(--ai-cyan) 18%, transparent), transparent 32rem),
      linear-gradient(180deg, var(--ai-bg), color-mix(in srgb, var(--ai-surface) 82%, var(--ai-bg)) 52%, var(--ai-bg));
    color: var(--ai-fg);
  }

  .tracks-exhibit__mesh {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    background-image:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--ai-cyan) 32%, transparent) 1px, transparent 0),
      linear-gradient(115deg, transparent 0 48%, color-mix(in srgb, var(--ai-purple) 10%, transparent) 48% 52%, transparent 52%);
    background-size: 28px 28px, 100% 100%;
    mask-image: radial-gradient(circle at 50% 35%, #000 0%, transparent 78%);
    pointer-events: none;
  }

  .tracks-exhibit__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 88rem);
    margin: 0 auto;
  }

  .tracks-exhibit__header {
    max-width: 58rem;
    margin: 0 auto 2.3rem;
    text-align: center;
  }

  .tracks-exhibit__kicker {
    margin: 0 0 0.85rem;
    color: var(--ai-cyan);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .tracks-exhibit__title {
    margin: 0;
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.075em;
    font-weight: 900;
  }

  .tracks-exhibit__lead {
    max-width: 48rem;
    margin: 1.3rem auto 0;
    color: var(--ai-fg-muted);
    font-size: clamp(1rem, 1.45vw, 1.22rem);
    line-height: 1.75;
  }

  .tracks-exhibit__frame {
    position: relative;
    border-radius: 2.1rem;
  }

  .tracks-exhibit__frame-glow {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(135deg, color-mix(in srgb, var(--ai-cyan) 56%, transparent), color-mix(in srgb, var(--ai-purple) 46%, transparent), transparent 64%);
    filter: blur(22px);
    opacity: 0.36;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .tracks-exhibit {
      padding-inline: 1rem;
    }
  }
</style>
