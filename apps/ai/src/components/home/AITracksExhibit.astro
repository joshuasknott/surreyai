---
import TrackLab from "./track-lab/TrackLab.astro";
---

<section id="tracks" class="py-20 sm:py-24 px-6 bg-surface relative overflow-hidden border-b border-border-subtle">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(6,182,212,0.12),transparent_30%),radial-gradient(circle_at_78%_12%,rgba(139,92,246,0.12),transparent_34%)] pointer-events-none"></div>

  <div class="mx-auto max-w-6xl relative z-10">
    <div class="max-w-3xl mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-3 mb-5 border border-border-subtle px-3 py-1.5 bg-surface-card/40">
        <span class="w-2 h-2 bg-accent-blue shadow-[0_0_12px_rgba(6,182,212,0.8)]"></span>
        <span class="text-accent-blue text-xs font-bold font-mono-tech tracking-widest uppercase">
          Track Lab
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-5">
        Explore Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-blue to-accent-purple">AI Tracks</span>
      </h2>
      <p class="text-text-secondary text-base sm:text-lg leading-relaxed max-w-2xl">
        Six areas of artificial intelligence we explore as a society. Select a track to see what we cover, how we practise, and a live visual prototype.
      </p>
    </div>

    <TrackLab />
  </div>
</section>
