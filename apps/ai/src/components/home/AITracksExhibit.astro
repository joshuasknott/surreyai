---
import TrackLab from "./track-lab/TrackLab.astro";
---

<section id="tracks" class="py-24 sm:py-32 px-6 bg-ai-bg relative overflow-hidden border-y border-ai-border">
  <div class="mx-auto max-w-7xl relative z-10">
    <div class="max-w-3xl mb-16 text-center mx-auto flex flex-col items-center">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6 text-ai-fg">
        Explore Our <span class="text-ai-cyan">AI Tracks</span>
      </h2>
      <p class="text-ai-fg-muted text-lg sm:text-xl leading-relaxed max-w-2xl text-center">
        Six areas of artificial intelligence we explore as a society. Select a track to see what we cover, how we practise, and a live visual prototype.
      </p>
    </div>

    <div class="relative">
      <div class="relative rounded-2xl overflow-hidden border border-ai-border shadow-lg bg-ai-surface z-10">
        <TrackLab />
      </div>
    </div>
  </div>
</section>
