---
---

<section id="explore" class="bg-ai-bg text-ai-fg py-24 relative z-10">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">Core Focus Areas</h2>
      <p class="text-lg text-ai-fg-muted max-w-2xl">
        We explore the technical, ethical, and creative dimensions of artificial intelligence through hands-on projects and deep-dive discussions.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Build with AI (Span 2) -->
      <article class="bento-card md:col-span-2 lg:col-span-2 flex flex-col md:flex-row gap-8 group">
        <div class="bento-glow bg-ai-azure/20"></div>
        <div class="bento-content md:w-1/2 flex flex-col justify-center">
          <h3 class="text-2xl sm:text-3xl font-bold mb-4 tracking-tight">Build with AI</h3>
          <p class="text-ai-fg-muted text-base sm:text-lg leading-relaxed">
            Agents, automation, apps, tools
          </p>
        </div>
        <div class="bento-visual md:w-1/2 min-h-[240px] md:min-h-full bg-ai-bg/50 border border-white/5 rounded-2xl flex items-center justify-center p-6 relative overflow-hidden">
          <div class="visual-agents w-full scale-90 sm:scale-100">
            <div class="node node-user"></div>
            <div class="flow-line"></div>
            <div class="node node-plan"></div>
            <div class="flow-line"></div>
            <div class="node-group">
              <div class="node node-action"></div>
              <div class="node node-action"></div>
              <div class="node node-action"></div>
            </div>
            <div class="flow-line"></div>
            <div class="node node-output"></div>
          </div>
        </div>
      </article>

      <!-- Create with AI (Span 1) -->
      <article class="bento-card col-span-1 flex flex-col gap-6 group">
        <div class="bento-glow bg-ai-coral/20"></div>
        <div class="bento-visual h-48 sm:h-56 w-full bg-ai-bg/50 border border-white/5 rounded-2xl relative overflow-hidden">
          <div class="visual-gen-ai">
            <div class="sketch"></div>
            <div class="polished"></div>
          </div>
        </div>
        <div class="bento-content mt-auto">
          <h3 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight">Create with AI</h3>
          <p class="text-ai-fg-muted text-sm sm:text-base leading-relaxed">
            Generative AI, design, media, content
          </p>
        </div>
      </article>

      <!-- Understand AI (Span 1) -->
      <article class="bento-card col-span-1 flex flex-col gap-6 group">
        <div class="bento-glow bg-ai-sage/20"></div>
        <div class="bento-visual h-48 sm:h-56 w-full bg-ai-bg/50 border border-white/5 rounded-2xl relative overflow-hidden flex items-center justify-center">
          <div class="visual-ml w-full h-full max-w-[200px] max-h-[200px]">
            <div class="dots-container"></div>
          </div>
        </div>
        <div class="bento-content mt-auto">
          <h3 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight">Understand AI</h3>
          <p class="text-ai-fg-muted text-sm sm:text-base leading-relaxed">
            Machine learning, models, foundations
          </p>
        </div>
      </article>

      <!-- Use AI Responsibly (Span 1) -->
      <article class="bento-card col-span-1 flex flex-col gap-6 group">
        <div class="bento-glow bg-ai-coral/20"></div>
        <div class="bento-visual h-48 sm:h-56 w-full bg-ai-bg/50 border border-white/5 rounded-2xl relative overflow-hidden flex items-center justify-center">
          <div class="visual-responsible scale-90">
            <div class="slider-group">
              <div class="slider-track"><div class="slider-thumb thumb-1"></div></div>
              <div class="slider-track"><div class="slider-thumb thumb-2"></div></div>
            </div>
          </div>
        </div>
        <div class="bento-content mt-auto">
          <h3 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight">Use AI Responsibly</h3>
          <p class="text-ai-fg-muted text-sm sm:text-base leading-relaxed">
            Ethics, policy, safety, society
          </p>
        </div>
      </article>

      <!-- Build Together (Span 1) -->
      <article class="bento-card col-span-1 flex flex-col gap-6 group md:col-span-2 lg:col-span-1">
        <div class="bento-glow bg-ai-azure/20"></div>
        <div class="bento-visual h-48 sm:h-56 w-full bg-ai-bg/50 border border-white/5 rounded-2xl relative overflow-hidden flex items-center justify-center">
          <div class="visual-build scale-90 w-full px-6">
            <div class="build-timeline">
              <div class="build-block"></div>
              <div class="build-block"></div>
              <div class="build-block"></div>
            </div>
          </div>
        </div>
        <div class="bento-content mt-auto">
          <h3 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight">Build Together</h3>
          <p class="text-ai-fg-muted text-sm sm:text-base leading-relaxed">
            Hackathons, projects, demos, community
          </p>
        </div>
      </article>

    </div>
  </div>
</section>

<script>
  // Simple dots clustering for ML section
  const container = document.querySelector('.dots-container');
  if (container) {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (let i = 0; i < 40; i++) {
      const dot = document.createElement('div');
      dot.className = 'dot';
      const cluster = i % 3;
      const targetX = cluster === 0 ? 30 : cluster === 1 ? 70 : 50;
      const targetY = cluster === 0 ? 70 : cluster === 1 ? 70 : 30;
      
      const startX = Math.random() * 100;
      const startY = Math.random() * 100;
      
      dot.style.left = `${isReduced ? targetX : startX}%`;
      dot.style.top = `${isReduced ? targetY : startY}%`;
      
      if (cluster === 0) dot.style.backgroundColor = 'var(--ai-coral)';
      if (cluster === 1) dot.style.backgroundColor = 'var(--ai-azure)';
      if (cluster === 2) dot.style.backgroundColor = 'var(--ai-sage)';
      
      container.appendChild(dot);
      
      if (!isReduced) {
        setTimeout(() => {
          dot.style.left = `${targetX + (Math.random() * 25 - 12)}%`;
          dot.style.top = `${targetY + (Math.random() * 25 - 12)}%`;
        }, 1000);
      }
    }
  }
</script>

<style>
  /* Bento Grid Base Styles */
  .bento-card {
    position: relative;
    background: var(--ai-surface);
    border: 1px solid var(--ai-border);
    border-radius: 1.5rem;
    padding: 2rem;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s;
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05), 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .bento-card:hover {
    transform: translateY(-4px);
    border-color: var(--ai-border-strong);
  }

  .bento-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    filter: blur(60px);
    transform: scale(1.5);
    transition: opacity 0.5s ease;
    z-index: 0;
    pointer-events: none;
  }

  .bento-card:hover .bento-glow {
    opacity: 0.15;
  }

  .bento-content, .bento-visual {
    position: relative;
    z-index: 1;
  }

  /* Gen AI Visual */
  .visual-gen-ai {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sketch {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(45deg, transparent, transparent 10px, var(--ai-border) 10px, var(--ai-border) 11px);
    opacity: 0.5;
  }

  .polished {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--ai-coral), var(--ai-azure));
    clip-path: circle(0% at 50% 50%);
    animation: reveal 5s infinite alternate ease-in-out;
  }

  @keyframes reveal {
    to { clip-path: circle(120% at 50% 50%); }
  }

  /* Agents Visual */
  .visual-agents {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .node {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--ai-surface);
    border: 2px solid var(--ai-border-strong);
    transition: all 0.3s;
  }

  .node-group {
    display: flex;
    gap: 1rem;
  }

  .node-user { border-color: var(--ai-coral); animation: pulse-node 3s infinite; }
  .node-plan { border-color: var(--ai-azure); animation: pulse-node 3s infinite 1s; }
  .node-action { border-color: var(--ai-sage); border-radius: 0.5rem; animation: pulse-node 3s infinite 2s; }
  .node-output { border-color: var(--ai-coral); animation: pulse-node 3s infinite 3s; }

  .flow-line {
    width: 2px;
    height: 1.5rem;
    background: var(--ai-border-strong);
  }

  @keyframes pulse-node {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 16px currentColor; }
  }

  /* ML Visual */
  .visual-ml {
    position: relative;
  }
  
  .dots-container {
    position: absolute;
    inset: 0;
  }

  :global(.dot) {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transition: all 2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Responsible AI Visual */
  .visual-responsible {
    width: 100%;
    max-width: 240px;
  }

  .slider-group {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .slider-track {
    width: 100%;
    height: 6px;
    background: var(--ai-border);
    border-radius: 9999px;
    position: relative;
  }

  .slider-thumb {
    position: absolute;
    top: 50%;
    width: 20px;
    height: 20px;
    background: var(--ai-sage);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: left 2s ease-in-out;
  }

  .thumb-1 { left: 20%; animation: slide-1 4s infinite alternate ease-in-out; }
  .thumb-2 { left: 80%; background: var(--ai-coral); animation: slide-2 4s infinite alternate ease-in-out; }

  @keyframes slide-1 { to { left: 80%; } }
  @keyframes slide-2 { to { left: 20%; } }

  /* Build Culture Visual */
  .visual-build {
    width: 100%;
    max-width: 280px;
  }

  .build-timeline {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .build-block {
    height: 2.5rem;
    background: var(--ai-border);
    border-radius: 0.5rem;
    width: 0%;
    animation: build 3s infinite;
  }

  .build-block:nth-child(1) { background: var(--ai-coral); animation-delay: 0s; }
  .build-block:nth-child(2) { background: var(--ai-azure); animation-delay: 1s; }
  .build-block:nth-child(3) { background: var(--ai-sage); animation-delay: 2s; }

  @keyframes build {
    0% { width: 0%; }
    50%, 100% { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-card { transition: none; }
    .bento-glow { display: none; }
    .polished { animation: none; clip-path: circle(120% at 50% 50%); }
    .node-user, .node-plan, .node-action, .node-output { animation: none; }
    .thumb-1 { animation: none; left: 50%; }
    .thumb-2 { animation: none; left: 50%; }
    .build-block { animation: none; width: 100%; }
  }
</style>
