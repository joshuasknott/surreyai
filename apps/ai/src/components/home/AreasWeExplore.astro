---
import CutoutVisual from "../common/CutoutVisual.astro";
import learningToolkitCutout from "../../assets/generated/ai-learning-toolkit-cutout.png";

const routes = [
  {
    label: "01",
    title: "Learn practical skills",
    text: "Workshops and tutorials help members build confidence with Python, machine learning, data analysis, generative AI, and model evaluation.",
  },
  {
    label: "02",
    title: "Build with others",
    text: "Hackathons, build nights, and project sessions turn ideas into small prototypes, portfolio pieces, and team experiments.",
  },
  {
    label: "03",
    title: "Understand the impact",
    text: "Industry awareness, ethics, careers, accessibility, bias, and social impact stay part of the conversation from the start.",
  },
];
---

<section id="explore" class="ai-section ai-section--tinted explore-section" aria-labelledby="explore-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
      <h2 id="explore-title" class="section-title">What we offer</h2>
      </div>
      <p class="section-intro">
        Surrey AI and Data Science is designed for experienced coders, curious beginners, and students from any discipline who want to understand how AI and data science are changing the world.
      </p>
    </div>

    <div class="explore-grid">
      <CutoutVisual
        compact
        image={learningToolkitCutout}
        alt="AI learning toolkit with a whiteboard tablet, notebook, data cards, calculator, and headphones"
        title="Test AI for yourself."
        body="Sessions turn models, datasets, tools, and judgement into shared material members can inspect and improve."
      />
      <div class="impact-routes">
        {routes.map((route) => (
          <article class="impact-route">
            <span class="impact-route__label">{route.label}</span>
            <div>
              <h3>{route.title}</h3>
              <p>{route.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .explore-section {
    overflow: clip;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.82fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .impact-routes {
    display: grid;
    gap: clamp(1.2rem, 3vw, 1.8rem);
  }

  .impact-route {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-bottom: clamp(1.2rem, 3vw, 1.8rem);
    border-bottom: 1px solid var(--ai-border);
  }

  .impact-route__label {
    color: var(--ai-azure);
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.2;
  }

  .impact-route h3 {
    margin: 0 0 0.45rem;
    color: var(--ai-fg);
    font-size: 1.15rem;
    letter-spacing: 0;
  }

  .impact-route p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .explore-grid {
      grid-template-columns: 1fr;
    }

    .impact-route {
      grid-template-columns: 2.75rem 1fr;
    }
  }
</style>
