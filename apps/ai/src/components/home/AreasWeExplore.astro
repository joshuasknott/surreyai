<style>
  /* Bento Grid Base & Theme-based Design Tokens */
  :root {
    --bento-visual-bg: #f8fafc;
    --bento-visual-border: var(--ai-border);
    --bento-visual-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.03);
    --bento-grid-color: rgba(15, 23, 42, 0.02);
    --bento-wire-color: rgba(15, 23, 42, 0.08);
    --bento-wire-hover: rgba(15, 23, 42, 0.16);
    --bento-node-bg: #ffffff;
    --bento-node-border: rgba(15, 23, 42, 0.08);
    --bento-text-light: #475569;
    --bento-canvas-card: #ffffff;
  }

  :root[data-theme="dark"] {
    --bento-visual-bg: #060913;
    --bento-visual-border: rgba(255, 255, 255, 0.04);
    --bento-visual-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.6);
    --bento-grid-color: rgba(255, 255, 255, 0.015);
    --bento-wire-color: rgba(255, 255, 255, 0.05);
    --bento-wire-hover: rgba(255, 255, 255, 0.08);
    --bento-node-bg: #090d1a;
    --bento-node-border: rgba(255, 255, 255, 0.1);
    --bento-text-light: #94a3b8;
    --bento-canvas-card: #0b0f19;
  }
  
  /* Text gradient utility */
  .text-gradient {
    background: linear-gradient(135deg, var(--ai-fg) 40%, color-mix(in srgb, var(--ai-fg) 70%, var(--ai-azure)) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .bento-card {
    position: relative;
    background: var(--ai-surface);
    border: 1px solid var(--ai-border);
    border-radius: 1.5rem;
    padding: 2.25rem;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05), 
                0 4px 24px rgba(0, 0, 0, 0.02);
  }

  /* Deep Interactive Hover Lift & Glow */
  .bento-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--card-brand-color) 45%, transparent);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08),
                0 16px 40px -10px rgba(0, 0, 0, 0.2),
                0 0 28px color-mix(in srgb, var(--card-brand-color) 12%, transparent);
  }

  /* 4x Corner Brackets (Tech Aesthetics) */
  .corner-tick {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: var(--ai-border-strong);
    opacity: 0.2;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  
  .top-left { top: 12px; left: 12px; border-top: 1.5px solid; border-left: 1.5px solid; }
  .top-right { top: 12px; right: 12px; border-top: 1.5px solid; border-right: 1.5px solid; }
  .bottom-left { bottom: 12px; left: 12px; border-bottom: 1.5px solid; border-left: 1.5px solid; }
  .bottom-right { bottom: 12px; right: 12px; border-bottom: 1.5px solid; border-right: 1.5px solid; }

  .bento-card:hover .corner-tick {
    opacity: 0.9;
    border-color: var(--card-brand-color);
    transform: scale(1.1);
  }

  .bento-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    filter: blur(60px);
    transform: scale(1.4);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
    pointer-events: none;
  }

  .bento-card:hover .bento-glow {
    opacity: 0.12;
  }

  .bento-content, .bento-visual {
    position: relative;
    z-index: 1;
  }

  /* All Visualizers adapt dynamically to light/dark modes */
  .bento-visual {
    background: var(--bento-visual-bg);
    border: 1px solid var(--bento-visual-border);
    box-shadow: var(--bento-visual-shadow);
    transition: border-color 0.4s, background-color 0.4s;
  }

  .bento-card:hover .bento-visual {
    border-color: color-mix(in srgb, var(--card-brand-color) 30%, var(--bento-visual-border));
