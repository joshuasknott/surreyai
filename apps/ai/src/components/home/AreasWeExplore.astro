---
import CutoutVisual from "../common/CutoutVisual.astro";
import learningToolkitCutout from "../../assets/generated/ai-learning-toolkit-cutout.png";

const routes = [
  {
    label: "01",
    title: "Start with confidence",
    text: "The new website will guide members toward workshops, beginner-friendly resources, and practical routes into artificial intelligence.",
  },
  {
    label: "02",
    title: "Find the community",
    text: "Launch updates will make it easier to discover welcome sessions, build nights, hackathons, and other ways to meet people.",
  },
  {
    label: "03",
    title: "Understand the impact",
    text: "Responsible artificial intelligence, careers, accessibility, bias, and social impact stay part of the society from the start.",
  },
];
---

<section id="explore" class="ai-section ai-section--tinted explore-section" aria-labelledby="explore-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
      <h2 id="explore-title" class="section-title">What the website is for</h2>
      </div>
      <p class="section-intro">
        The September launch will give curious beginners, experienced coders, and students from any discipline a clearer place to find the society, understand the offer, and get involved.
      </p>
    </div>

    <div class="explore-grid">
      <CutoutVisual
        compact
        image={learningToolkitCutout}
        alt="Artificial intelligence learning toolkit with a whiteboard tablet, notebook, data cards, calculator, and headphones"
        title="A clearer place to begin."
        body="The website will bring together society updates, learning routes, event information, and simple joining steps in one student-friendly space."
      />
      <div class="impact-routes">
        {routes.map((route) => (
          <article class="impact-route">
            <span class="impact-route__label">{route.label}</span>
            <div>
              <h3>{route.title}</h3>
              <p>{route.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .explore-section {
    overflow: clip;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.82fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .impact-routes {
    display: grid;
    gap: clamp(1.2rem, 3vw, 1.8rem);
  }

  .impact-route {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-bottom: clamp(1.2rem, 3vw, 1.8rem);
    border-bottom: 1px solid var(--ai-border);
  }

  .impact-route__label {
    color: var(--ai-azure);
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.2;
  }

  .impact-route h3 {
    margin: 0 0 0.45rem;
    color: var(--ai-fg);
    font-size: 1.15rem;
    letter-spacing: 0;
  }

  .impact-route p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .explore-grid {
      grid-template-columns: 1fr;
    }

    .impact-route {
      grid-template-columns: 2.75rem 1fr;
    }
  }
</style>
