---
---

<section id="explore" class="bg-ai-bg text-ai-fg py-24 relative z-10">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4 text-gradient">Core Focus Areas</h2>
      <p class="text-lg text-ai-fg-muted max-w-2xl">
        We explore the technical, ethical, and creative dimensions of artificial intelligence through clear explanations, practical prototypes, and honest critique.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Build with AI (Span 2) -->
      <article class="bento-card md:col-span-2 lg:col-span-2 flex flex-col md:flex-row gap-8 group ml-card-wrapper" style="--card-brand-color: var(--ai-azure);">
        <!-- Cybernetic Corner Brackets -->
        <div class="corner-tick top-left"></div>
        <div class="corner-tick top-right"></div>
        <div class="corner-tick bottom-left"></div>
        <div class="corner-tick bottom-right"></div>
        
        <div class="bento-glow bg-ai-azure/20"></div>
        
        <div class="bento-content md:w-1/2 flex flex-col justify-center">
          <h3 class="text-2xl sm:text-3xl font-bold mb-4 tracking-tight">Build with AI</h3>
          <p class="text-ai-fg-muted text-base sm:text-lg leading-relaxed mb-6">
            Design small agents, automations, apps, and tools that solve defined student problems instead of demonstrating AI for its own sake.
          </p>
        </div>
        
        <div class="bento-visual md:w-1/2 min-h-[260px] md:min-h-full rounded-2xl relative overflow-hidden flex items-center justify-center">
          <!-- Fine Grid System -->
          <div class="generative-grid"></div>
          
          <!-- Cyber Sweep scanner -->
          <div class="scan-sweep"></div>

          <div class="visual-agents w-full h-full relative flex items-center justify-center p-4">
            <svg class="agents-svg w-full h-full max-w-[480px] min-h-[180px]" viewBox="0 0 480 180" fill="none">
              <defs>
                <linearGradient id="flow-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="var(--ai-coral)" />
                  <stop offset="50%" stop-color="var(--ai-azure)" />
                  <stop offset="100%" stop-color="var(--ai-sage)" />
                </linearGradient>
              </defs>

              <!-- Connection Paths (Static Base Lines) -->
              <path d="M 40,90 H 130" class="wire-path"/>
              <path d="M 170,90 Q 200,45 240,45" class="wire-path"/>
              <path d="M 170,90 H 240" class="wire-path"/>
              <path d="M 170,90 Q 200,135 240,135" class="wire-path"/>
              <path d="M 280,45 Q 320,45 350,90" class="wire-path"/>
              <path d="M 280,90 H 350" class="wire-path"/>
              <path d="M 280,135 Q 320,135 350,90" class="wire-path"/>
              <path d="M 390,90 H 440" class="wire-path"/>

              <!-- Flowing Dash Particles -->
              <path d="M 40,90 H 130" class="pulse-path" style="animation-delay: 0s;" />
              <path d="M 170,90 Q 200,45 240,45" class="pulse-path" style="animation-delay: 0.2s;" />
              <path d="M 170,90 H 240" class="pulse-path" style="animation-delay: 0.4s;" />
              <path d="M 170,90 Q 200,135 240,135" class="pulse-path" style="animation-delay: 0.6s;" />
              <path d="M 280,45 Q 320,45 350,90" class="pulse-path" style="animation-delay: 0.8s;" />
              <path d="M 280,90 H 350" class="pulse-path" style="animation-delay: 1.0s;" />
              <path d="M 280,135 Q 320,135 350,90" class="pulse-path" style="animation-delay: 1.2s;" />
              <path d="M 390,90 H 440" class="pulse-path" style="animation-delay: 1.4s;" />

              <!-- Interactive agent sequence cursor -->
              <g class="agent-cursor">
                <path d="M 0,0 L 10,3 L 7,6 L 10,9 L 8,11 L 5,8 L 2,9 Z" fill="var(--ai-azure)" stroke="#ffffff" stroke-width="0.8"/>
              </g>
            </svg>

            <!-- User Idea Node -->
            <div class="agent-node user-node" style="left: 8.33%; top: 50%;">
              <div class="node-icon-wrapper text-ai-coral animate-pulse">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              </div>
              <span class="node-label">Idea</span>
            </div>

            <!-- Planner Node -->
            <div class="agent-node plan-node" style="left: 31.25%; top: 50%;">
              <div class="node-icon-wrapper text-ai-azure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
              </div>
              <span class="node-label">Plan</span>
            </div>

            <!-- Action Nodes (Tools) -->
            <div class="agent-node tool-node node-t1" style="left: 54.16%; top: 25%;">
              <div class="node-icon-wrapper text-ai-sage">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </div>
              <span class="node-label">Research</span>
            </div>
            <div class="agent-node tool-node node-t2" style="left: 54.16%; top: 50%;">
              <div class="node-icon-wrapper text-ai-sage">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
              </div>
              <span class="node-label">Write</span>
            </div>
            <div class="agent-node tool-node node-t3" style="left: 54.16%; top: 75%;">
              <div class="node-icon-wrapper text-ai-sage">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
              </div>
              <span class="node-label">Format</span>
            </div>

            <!-- Reviewer Node -->
            <div class="agent-node eval-node" style="left: 77.08%; top: 50%;">
              <div class="node-icon-wrapper text-ai-azure">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 22 12 12 22 2 12 12 2"></polygon></svg>
              </div>
              <span class="node-label">Review</span>
            </div>

            <!-- Output Node -->
            <div class="agent-node out-node" style="left: 91.66%; top: 50%;">
              <div class="node-icon-wrapper text-ai-coral">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <span class="node-label">Launch</span>
            </div>
          </div>

          <!-- Conversational Agent Status Capsule -->
          <div class="agent-status-bubble">
            <svg class="w-3.5 h-3.5 text-ai-azure shrink-0 animate-spin" style="animation-duration: 3s;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            <span class="agent-status-text"></span>
          </div>
        </div>
      </article>

      <!-- Create with AI (Span 1) -->
      <article class="bento-card col-span-1 flex flex-col gap-6 group" style="--card-brand-color: var(--ai-coral);">
        <!-- Cybernetic Corner Brackets -->
        <div class="corner-tick top-left"></div>
        <div class="corner-tick top-right"></div>
        <div class="corner-tick bottom-left"></div>
        <div class="corner-tick bottom-right"></div>

        <div class="bento-glow bg-ai-coral/20"></div>
        
        <div class="bento-visual h-48 sm:h-56 w-full rounded-2xl relative overflow-hidden flex items-center justify-center">
          <!-- Fine Grid System -->
          <div class="generative-grid"></div>
          
          <!-- Cyber Sweep scanner -->
          <div class="scan-sweep"></div>
          
          <!-- Creative Design Canvas Overlay -->
          <div class="creative-canvas w-full h-full relative flex items-center justify-center p-4">
            <svg class="canvas-svg w-full h-full max-w-[240px]" viewBox="0 0 240 160" fill="none">
              <!-- Browser Window Frame -->
              <g class="browser-window">
                <!-- Outer background and border -->
                <rect x="15" y="10" width="210" height="140" rx="8" class="window-bg" fill="var(--bento-canvas-card)" stroke="var(--bento-wire-color)" stroke-width="1.5"/>
                <!-- Browser Header Bar -->
                <rect x="15" y="10" width="210" height="24" rx="8" class="window-header" fill="var(--bento-visual-bg)" stroke="var(--bento-wire-color)" stroke-width="1.5"/>
                <!-- URL Address Bar -->
                <rect x="62" y="16" width="116" height="12" rx="4" fill="var(--bento-node-bg)" stroke="var(--bento-node-border)" stroke-width="1"/>
                <text x="120" y="24" font-family="var(--font-mono)" font-size="5.5" font-weight="bold" fill="var(--bento-text-light)" text-anchor="middle">surreyai.com</text>
                <!-- Three window dots -->
                <circle cx="27" cy="22" r="3" fill="#ff5f56"/>
                <circle cx="37" cy="22" r="3" fill="#ffbd2e"/>
                <circle cx="47" cy="22" r="3" fill="#27c93f"/>
              </g>

              <!-- Landing Page Content Viewport (Clipped to browser body) -->
              <g class="browser-content" clip-path="url(#browser-clip)">
                <clipPath id="browser-clip">
                  <rect x="16" y="34.5" width="208" height="114" rx="1"/>
                </clipPath>

                <!-- NAVBAR -->
                <g class="ui-navbar">
                  <!-- Logo tag -->
                  <rect x="24" y="42" width="22" height="6" rx="1.5" fill="var(--ai-coral)" opacity="0.85"/>
                  <!-- Navbar links -->
                  <rect x="135" y="43" width="12" height="3" rx="0.8" fill="var(--bento-text-light)" opacity="0.5"/>
                  <rect x="153" y="43" width="12" height="3" rx="0.8" fill="var(--bento-text-light)" opacity="0.5"/>
                  <rect x="171" y="43" width="12" height="3" rx="0.8" fill="var(--bento-text-light)" opacity="0.5"/>
                  <!-- Action button -->
                  <rect x="189" y="41" width="23" height="7" rx="2" fill="var(--ai-azure)" opacity="0.85"/>
                </g>

                <!-- HERO SECTION -->
                <g class="ui-hero">
                  <!-- Left Hero Info: Headline and Copy lines -->
                  <!-- Headline line 1 -->
                  <rect x="24" y="58" width="70" height="5" rx="1" fill="var(--ai-fg)"/>
                  <!-- Headline line 2 -->
                  <rect x="24" y="65" width="50" height="5" rx="1" fill="var(--ai-fg)"/>
                  <!-- Paragraph block lines -->
                  <rect x="24" y="74" width="75" height="2" rx="0.5" fill="var(--bento-text-light)" opacity="0.6"/>
                  <rect x="24" y="78" width="65" height="2" rx="0.5" fill="var(--bento-text-light)" opacity="0.6"/>
                  <rect x="24" y="82" width="45" height="2" rx="0.5" fill="var(--bento-text-light)" opacity="0.6"/>
                  <!-- Hero CTA Button -->
                  <rect x="24" y="88" width="30" height="9" rx="2.5" fill="var(--ai-coral)" class="ui-cta-btn"/>
                  
                  <!-- Right Hero Media Panel (Mock Dashboard card) -->
                  <g class="ui-hero-media">
                    <rect x="115" y="58" width="97" height="40" rx="4" fill="var(--bento-node-bg)" stroke="var(--bento-node-border)" stroke-width="1.5"/>
                    <rect x="115" y="58" width="97" height="40" rx="4" fill="none" stroke="var(--bento-wire-color)" stroke-width="1" stroke-dasharray="2,2"/>
                    <!-- Dashboard charts inside media panel -->
                    <circle cx="134" cy="78" r="10" fill="var(--ai-azure)" opacity="0.12" class="ui-dash-circle"/>
                    <path d="M 124,78 A 10,10 0 0,1 144,78" stroke="var(--ai-azure)" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
                    <rect x="152" y="67" width="50" height="4" rx="1" fill="var(--bento-text-light)" opacity="0.5"/>
                    <rect x="152" y="74" width="40" height="2" rx="0.5" fill="var(--bento-text-light)" opacity="0.3"/>
                    <rect x="152" y="79" width="45" height="2" rx="0.5" fill="var(--bento-text-light)" opacity="0.3"/>
                    <rect x="152" y="84" width="30" height="2" rx="0.5" fill="var(--bento-text-light)" opacity="0.3"/>
                    <!-- Small Sparkle -->
                    <path d="M 198,64 L 200,67 L 203,68 L 200,69 L 198,72 L 196,69 L 193,68 L 196,67 Z" fill="var(--ai-coral)" opacity="0.8"/>
                  </g>
                </g>

                <!-- FEATURES Bento Row -->
                <g class="ui-features">
                  <!-- Feature Card 1 -->
                  <g class="ui-feat-card card-f1">
                    <rect x="24" y="106" width="54" height="32" rx="4" fill="var(--bento-node-bg)" stroke="var(--bento-node-border)" stroke-width="1"/>
                    <circle cx="34" cy="116" r="4.5" fill="var(--ai-azure)" opacity="0.15"/>
                    <rect x="43" y="114" width="28" height="3" rx="0.8" fill="var(--ai-fg)"/>
                    <rect x="30" y="124" width="42" height="1.5" rx="0.4" fill="var(--bento-text-light)" opacity="0.5"/>
                    <rect x="30" y="128" width="30" height="1.5" rx="0.4" fill="var(--bento-text-light)" opacity="0.5"/>
                  </g>
                  
                  <!-- Feature Card 2 -->
                  <g class="ui-feat-card card-f2">
                    <rect x="85" y="106" width="54" height="32" rx="4" fill="var(--bento-node-bg)" stroke="var(--bento-node-border)" stroke-width="1"/>
                    <circle cx="95" cy="116" r="4.5" fill="var(--ai-coral)" opacity="0.15"/>
                    <rect x="104" y="114" width="28" height="3" rx="0.8" fill="var(--ai-fg)"/>
                    <rect x="91" y="124" width="42" height="1.5" rx="0.4" fill="var(--bento-text-light)" opacity="0.5"/>
                    <rect x="91" y="128" width="30" height="1.5" rx="0.4" fill="var(--bento-text-light)" opacity="0.5"/>
                  </g>
                  
                  <!-- Feature Card 3 -->
                  <g class="ui-feat-card card-f3">
                    <rect x="146" y="106" width="64" height="32" rx="4" fill="var(--bento-node-bg)" stroke="var(--bento-node-border)" stroke-width="1"/>
                    <circle cx="156" cy="116" r="4.5" fill="var(--ai-sage)" opacity="0.15"/>
                    <rect x="165" y="114" width="35" height="3" rx="0.8" fill="var(--ai-fg)"/>
                    <rect x="152" y="124" width="52" height="1.5" rx="0.4" fill="var(--bento-text-light)" opacity="0.5"/>
                    <rect x="152" y="128" width="38" height="1.5" rx="0.4" fill="var(--bento-text-light)" opacity="0.5"/>
                  </g>
                </g>

                <!-- Interactive building cursor -->
                <g class="ui-cursor">
                  <path d="M 0,0 L 10,3 L 7,6 L 10,9 L 8,11 L 5,8 L 2,9 Z" fill="var(--ai-coral)" stroke="#ffffff" stroke-width="0.8"/>
                </g>
              </g>
            </svg>
          </div>

          <!-- Prompt bubble floating overlay -->
          <div class="prompt-bubble">
            <svg class="w-3.5 h-3.5 text-ai-coral shrink-0 animate-pulse" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L14.8 9.2L22 12L14.8 14.8L12 22L9.2 14.8L2 12L9.2 9.2Z"/>
            </svg>
            <span>"Create a landing page for my project"</span>
          </div>
        </div>
        
        <div class="bento-content mt-auto">
          <h3 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight">Create with AI</h3>
          <p class="text-ai-fg-muted text-sm sm:text-base leading-relaxed mb-4">
            Explore generative AI for design, media, writing, and ideation while learning where human review and attribution matter.
          </p>
        </div>
      </article>

      <!-- Understand AI (Span 1) -->
      <article class="bento-card col-span-1 flex flex-col gap-6 group ml-card" style="--card-brand-color: var(--ai-sage);">
        <!-- Cybernetic Corner Brackets -->
        <div class="corner-tick top-left"></div>
        <div class="corner-tick top-right"></div>
        <div class="corner-tick bottom-left"></div>
        <div class="corner-tick bottom-right"></div>

        <div class="bento-glow bg-ai-sage/20"></div>
        
        <div class="bento-visual h-48 sm:h-56 w-full rounded-2xl relative overflow-hidden flex items-center justify-center">
          <!-- Fine Grid System -->
          <div class="generative-grid"></div>
          
          <!-- Cyber Sweep scanner -->
          <div class="scan-sweep"></div>
          
          <div class="neural-network w-full h-full max-w-[240px] max-h-[180px] relative flex items-center justify-center">
            <svg class="nn-svg w-full h-full" viewBox="0 0 240 160" fill="none">
              <!-- Connections (Background wires) -->
              <!-- Input (X: 30) to Hidden (X: 120) -->
              <path d="M 30,40 L 120,30" class="nn-wire"/>
              <path d="M 30,40 L 120,65" class="nn-wire"/>
              <path d="M 30,40 L 120,100" class="nn-wire"/>
              <path d="M 30,40 L 120,130" class="nn-wire"/>
              
              <path d="M 30,80 L 120,30" class="nn-wire"/>
              <path d="M 30,80 L 120,65" class="nn-wire"/>
              <path d="M 30,80 L 120,100" class="nn-wire"/>
              <path d="M 30,80 L 120,130" class="nn-wire"/>
              
              <path d="M 30,120 L 120,30" class="nn-wire"/>
              <path d="M 30,120 L 120,65" class="nn-wire"/>
              <path d="M 30,120 L 120,100" class="nn-wire"/>
              <path d="M 30,120 L 120,130" class="nn-wire"/>

              <!-- Hidden (X: 120) to Output (X: 210) -->
              <path d="M 120,30 L 210,55" class="nn-wire"/>
              <path d="M 120,30 L 210,105" class="nn-wire"/>
              
              <path d="M 120,65 L 210,55" class="nn-wire"/>
              <path d="M 120,65 L 210,105" class="nn-wire"/>
              
              <path d="M 120,100 L 210,55" class="nn-wire"/>
              <path d="M 120,100 L 210,105" class="nn-wire"/>
              
              <path d="M 120,130 L 210,55" class="nn-wire"/>
              <path d="M 120,130 L 210,105" class="nn-wire"/>

              <!-- Flowing pulses traveling along wires -->
              <path d="M 30,80 L 120,65 L 210,55" class="nn-pulse nn-pulse-1"/>
              <path d="M 30,40 L 120,30 L 210,105" class="nn-pulse nn-pulse-2" style="animation-delay: 1s;"/>
              <path d="M 30,120 L 120,100 L 210,55" class="nn-pulse nn-pulse-3" style="animation-delay: 2s;"/>
              
              <!-- Nodes -->
              <!-- Input Nodes (X: 30) -->
              <circle cx="30" cy="40" r="6" class="nn-node nn-node-in" fill="var(--ai-azure)"/>
              <circle cx="30" cy="80" r="6" class="nn-node nn-node-in" fill="var(--ai-azure)"/>
              <circle cx="30" cy="120" r="6" class="nn-node nn-node-in" fill="var(--ai-azure)"/>

              <!-- Hidden Nodes (X: 120) -->
              <circle cx="120" cy="30" r="5" class="nn-node nn-node-hidden" fill="var(--ai-sage)"/>
              <circle cx="120" cy="65" r="5" class="nn-node nn-node-hidden" fill="var(--ai-sage)"/>
              <circle cx="120" cy="100" r="5" class="nn-node nn-node-hidden" fill="var(--ai-sage)"/>
              <circle cx="120" cy="130" r="5" class="nn-node nn-node-hidden" fill="var(--ai-sage)"/>

              <!-- Output Nodes (X: 210) -->
              <circle cx="210" cy="55" r="7" class="nn-node nn-node-out nn-node-active" fill="var(--ai-coral)"/>
              <circle cx="210" cy="105" r="7" class="nn-node nn-node-out" fill="var(--ai-coral)" opacity="0.4"/>
            </svg>
            
            <!-- Dynamic tech badge -->
            <div class="ml-tech-badge font-mono">Learning in progress</div>
          </div>
        </div>
        
        <div class="bento-content mt-auto">
          <h3 class="text-xl sm:text-2xl font-bold mb-3 tracking-tight">Understand AI</h3>
          <p class="text-ai-fg-muted text-sm sm:text-base leading-relaxed mb-4">
            Break down machine learning concepts, model behaviour, evaluation, and data quality with beginner-friendly visual experiments.
          </p>
        </div>
      </article>

      <!-- Use AI Responsibly (Span 1) -->
      <article class="bento-card col-span-1 flex flex-col gap-6 group" style="--card-brand-color: var(--ai-coral);">
        <!-- Cybernetic Corner Brackets -->
        <div class="corner-tick top-left"></div>
        <div class="corner-tick top-right"></div>
        <div class="corner-tick bottom-left"></div>
        <div class="corner-tick bottom-right"></div>

        <div class="bento-glow bg-ai-coral/20"></div>
        
        <div class="bento-visual h-48 sm:h-56 w-full rounded-2xl relative overflow-hidden flex items-center justify-center">
          <div class="generative-grid"></div>
          
          <!-- Cyber Sweep scanner -->
          <div class="scan-sweep"></div>
          
          <div class="responsible-radar w-full h-full max-w-[240px] max-h-[180px] relative flex items-center justify-center">
            <svg class="radar-svg w-full h-full" viewBox="0 0 240 160" fill="none">
              <!-- Grid lines representing pipeline path -->
              <line x1="20" y1="80" x2="220" y2="80" stroke="var(--bento-wire-color)" stroke-width="1.5" stroke-dasharray="4,4"/>
              
              <!-- Filter Gates (Vertical barriers) -->
              <!-- Gate 1: Privacy Filter -->
              <line x1="85" y1="30" x2="85" y2="130" stroke="var(--ai-azure)" stroke-width="3" stroke-linecap="round" opacity="0.8" class="safety-gate gate-privacy"/>
              <rect x="75" y="45" width="20" height="70" rx="4" fill="var(--ai-azure)" opacity="0.1" class="gate-glow-1"/>
              <text x="85" y="22" font-family="var(--font-mono)" font-size="7" font-weight="bold" fill="var(--ai-azure)" text-anchor="middle">PRIVACY</text>
              
              <!-- Gate 2: Fact Check Filter -->
              <line x1="155" y1="30" x2="155" y2="130" stroke="var(--ai-sage)" stroke-width="3" stroke-linecap="round" opacity="0.8" class="safety-gate gate-fact"/>
              <rect x="145" y="45" width="20" height="70" rx="4" fill="var(--ai-sage)" opacity="0.1" class="gate-glow-2"/>
              <text x="155" y="22" font-family="var(--font-mono)" font-size="7" font-weight="bold" fill="var(--ai-sage)" text-anchor="middle">FACT-CHECK</text>

              <!-- Document passing through -->
              <g class="pipeline-doc">
                <!-- Outer glow and card -->
                <rect x="-16" y="-22" width="32" height="44" rx="4" fill="var(--bento-canvas-card)" stroke="var(--bento-wire-color)" stroke-width="1.5" class="doc-body"/>
                <!-- Simulated lines of text on document -->
                <line x1="-10" y1="-12" x2="10" y2="-12" stroke="var(--bento-wire-hover)" stroke-width="2" stroke-linecap="round"/>
