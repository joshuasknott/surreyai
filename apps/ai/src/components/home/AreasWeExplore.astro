---
const activities = [
  { title: 'Workshops', text: 'Try AI tools, learn to code and get to grips with machine learning. Start with the basics or bring a project of your own.' },
  { title: 'Projects & challenges', text: 'Build something with other students, take part in a hackathon or test an idea you’ve been thinking about.' },
  { title: 'Talks & socials', text: 'Meet researchers, hear from people working in AI and get to know students beyond your course.' },
];
---
<section id="about" class="ai-about" aria-labelledby="about-title">
  <div class="ai-about__inner">
    <div class="ai-about__intro">
      <h2 id="about-title">Curious about AI?<br />You’re in the right place.</h2>
      <p>We’re a student-run community exploring what AI can do — and what it should do. Learn useful skills, work on ideas together, and discuss the questions behind the technology, from privacy to its impact on everyday life.</p>
    </div>
    <div id="activities" class="ai-activities" aria-label="Society activities">
      {activities.map(activity => <article><h3>{activity.title}</h3><p>{activity.text}</p></article>)}
    </div>
  </div>
</section>
<style>
  .ai-about { background: #faf8f3; padding: clamp(56px, 7vw, 96px) 28px; color: #111; }
  .ai-about__inner { max-width: 1168px; margin: auto; }
  .ai-about__intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center; margin-bottom: 52px; }
  h2 { font-size: clamp(32px, 4vw, 48px); font-weight: 750; line-height: 1.15; letter-spacing: -.035em; }
  p { color: #5b5752; font-size: 17px; line-height: 1.7; margin: 0; }
  .ai-activities { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  article { padding-top: 24px; border-top: 2px solid #ff4a00; }
  h3 { font-size: 24px; font-weight: 650; line-height: 1.3; margin: 0 0 14px; }
  @media(max-width: 760px) { .ai-about { padding-inline: 20px; } .ai-about__intro, .ai-activities { grid-template-columns: 1fr; gap: 28px; } }
</style>
