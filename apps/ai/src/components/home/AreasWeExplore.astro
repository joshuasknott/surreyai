  /* Fine Technical Grid */
  .generative-grid {
    position: absolute;
    inset: 0;
    background-size: 16px 16px;
    background-image: 
      linear-gradient(to right, var(--bento-grid-color) 1px, transparent 1px),
      linear-gradient(to bottom, var(--bento-grid-color) 1px, transparent 1px);
    opacity: 0.8;
  }

  /* ──────────────────────────────────────────────────────────
