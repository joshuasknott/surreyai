---
---

<section id="explore" class="bg-ai-bg text-ai-fg">
  <!-- Generative AI -->
  <article class="explore-section">
    <div class="explore-content">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">Generative AI</h2>
      <p class="text-lg sm:text-xl text-ai-fg-muted leading-relaxed max-w-2xl">
        From prompt to reality. We explore how language models and diffusion networks create text, code, and art.
      </p>
    </div>
    <div class="explore-visual bg-ai-surface" aria-hidden="true">
      <div class="visual-gen-ai">
        <div class="sketch"></div>
        <div class="polished"></div>
      </div>
    </div>
  </article>

  <!-- Agents and Automation -->
  <article class="explore-section">
    <div class="explore-content">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">Agents and Automation</h2>
      <p class="text-lg sm:text-xl text-ai-fg-muted leading-relaxed max-w-2xl">
        Systems that think in steps. We look at how AI is moving from answering questions to executing complex workflows autonomously.
      </p>
    </div>
    <div class="explore-visual bg-ai-surface" aria-hidden="true">
      <div class="visual-agents">
        <div class="node node-user"></div>
        <div class="flow-line"></div>
        <div class="node node-plan"></div>
        <div class="flow-line"></div>
        <div class="node-group">
          <div class="node node-action"></div>
          <div class="node node-action"></div>
          <div class="node node-action"></div>
        </div>
        <div class="flow-line"></div>
        <div class="node node-output"></div>
      </div>
    </div>
  </article>

  <!-- Machine Learning -->
  <article class="explore-section">
    <div class="explore-content">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">Machine Learning</h2>
      <p class="text-lg sm:text-xl text-ai-fg-muted leading-relaxed max-w-2xl">
        How machines find meaning in noise. We break down the fundamentals of data, patterns, and prediction.
      </p>
    </div>
    <div class="explore-visual bg-ai-surface" aria-hidden="true">
      <div class="visual-ml">
        <div class="dots-container"></div>
      </div>
    </div>
  </article>

  <!-- Responsible AI -->
  <article class="explore-section">
    <div class="explore-content">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">Responsible AI</h2>
      <p class="text-lg sm:text-xl text-ai-fg-muted leading-relaxed max-w-2xl">
        Building with caution. We debate the ethics, privacy, and societal impact of deploying intelligence at scale.
      </p>
    </div>
    <div class="explore-visual bg-ai-surface" aria-hidden="true">
      <div class="visual-responsible">
        <div class="slider-group">
          <div class="slider-track"><div class="slider-thumb thumb-1"></div></div>
          <div class="slider-track"><div class="slider-thumb thumb-2"></div></div>
        </div>
      </div>
    </div>
  </article>

  <!-- Hackathons & Build Culture -->
  <article class="explore-section">
    <div class="explore-content">
      <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-6">Hackathons & Build Culture</h2>
      <p class="text-lg sm:text-xl text-ai-fg-muted leading-relaxed max-w-2xl">
        Bringing ideas to life. We host rapid-prototyping events where students from all backgrounds team up to build working software.
      </p>
    </div>
    <div class="explore-visual bg-ai-surface" aria-hidden="true">
      <div class="visual-build">
        <div class="build-timeline">
          <div class="build-block"></div>
          <div class="build-block"></div>
          <div class="build-block"></div>
        </div>
      </div>
    </div>
  </article>
</section>

<script>
  // Simple dots clustering for ML section
  const container = document.querySelector('.dots-container');
  if (container) {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (let i = 0; i < 50; i++) {
      const dot = document.createElement('div');
      dot.className = 'dot';
      const cluster = i % 3;
      const targetX = cluster === 0 ? 20 : cluster === 1 ? 80 : 50;
      const targetY = cluster === 0 ? 80 : cluster === 1 ? 80 : 20;
      
      const startX = Math.random() * 100;
      const startY = Math.random() * 100;
      
      dot.style.left = `${isReduced ? targetX : startX}%`;
      dot.style.top = `${isReduced ? targetY : startY}%`;
      
      if (cluster === 0) dot.style.backgroundColor = 'var(--ai-coral)';
      if (cluster === 1) dot.style.backgroundColor = 'var(--ai-azure)';
      if (cluster === 2) dot.style.backgroundColor = 'var(--ai-sage)';
      
      container.appendChild(dot);
      
      if (!isReduced) {
        setTimeout(() => {
          dot.style.left = `${targetX + (Math.random() * 20 - 10)}%`;
          dot.style.top = `${targetY + (Math.random() * 20 - 10)}%`;
        }, 1000);
      }
    }
  }
</script>

<style>
  .explore-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 70vh;
    border-bottom: 1px solid var(--ai-border);
  }

  .explore-section:nth-child(even) {
    grid-template-columns: 1fr 1fr;
    direction: rtl;
  }

  .explore-section:nth-child(even) > * {
    direction: ltr;
  }

  .explore-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem;
  }

  .explore-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--ai-border);
    padding: 4rem;
  }

  .explore-section:nth-child(even) .explore-visual {
    border-left: none;
    border-right: 1px solid var(--ai-border);
  }

  /* Gen AI Visual */
  .visual-gen-ai {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--ai-bg);
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--ai-border);
  }

  .sketch {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(45deg, transparent, transparent 10px, var(--ai-border) 10px, var(--ai-border) 11px);
    opacity: 0.5;
  }

  .polished {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--ai-coral), var(--ai-azure));
    clip-path: circle(0% at 50% 50%);
    animation: reveal 5s infinite alternate ease-in-out;
  }

  @keyframes reveal {
    to { clip-path: circle(150% at 50% 50%); }
  }

  /* Agents Visual */
  .visual-agents {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .node {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--ai-surface);
    border: 2px solid var(--ai-border-strong);
    transition: all 0.3s;
  }

  .node-group {
    display: flex;
    gap: 1rem;
  }

  .node-user { border-color: var(--ai-coral); animation: pulse-node 3s infinite; }
  .node-plan { border-color: var(--ai-azure); animation: pulse-node 3s infinite 1s; }
  .node-action { border-color: var(--ai-sage); border-radius: 0.5rem; animation: pulse-node 3s infinite 2s; }
  .node-output { border-color: var(--ai-coral); animation: pulse-node 3s infinite 3s; }

  .flow-line {
    width: 2px;
    height: 2rem;
    background: var(--ai-border-strong);
  }

  @keyframes pulse-node {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 20px currentColor; }
  }

  /* ML Visual */
  .visual-ml {
    width: 100%;
    aspect-ratio: 1;
    max-width: 400px;
    position: relative;
  }
  
  .dots-container {
    position: absolute;
    inset: 0;
  }

  :global(.dot) {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    transition: all 2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Responsible AI Visual */
  .visual-responsible {
    width: 100%;
    max-width: 300px;
  }

  .slider-group {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .slider-track {
    width: 100%;
    height: 6px;
    background: var(--ai-border);
    border-radius: 9999px;
    position: relative;
  }

  .slider-thumb {
    position: absolute;
    top: 50%;
    width: 24px;
    height: 24px;
    background: var(--ai-sage);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: left 2s ease-in-out;
  }

  .thumb-1 { left: 20%; animation: slide-1 4s infinite alternate ease-in-out; }
  .thumb-2 { left: 80%; background: var(--ai-coral); animation: slide-2 4s infinite alternate ease-in-out; }

  @keyframes slide-1 { to { left: 80%; } }
  @keyframes slide-2 { to { left: 20%; } }

  /* Build Culture Visual */
  .visual-build {
    width: 100%;
    max-width: 400px;
  }

  .build-timeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .build-block {
    height: 3rem;
    background: var(--ai-border);
    border-radius: 0.5rem;
    width: 0%;
    animation: build 3s infinite;
  }

  .build-block:nth-child(1) { background: var(--ai-coral); animation-delay: 0s; }
  .build-block:nth-child(2) { background: var(--ai-azure); animation-delay: 1s; }
  .build-block:nth-child(3) { background: var(--ai-sage); animation-delay: 2s; }

  @keyframes build {
    0% { width: 0%; }
    50%, 100% { width: 100%; }
  }

  @media (max-width: 1024px) {
    .explore-section, .explore-section:nth-child(even) {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .explore-section:nth-child(even) > * {
      direction: ltr;
    }

    .explore-content {
      padding: 3rem 2rem;
    }

    .explore-visual {
      border-left: none !important;
      border-right: none !important;
      border-top: 1px solid var(--ai-border);
      padding: 3rem 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .polished { animation: none; clip-path: circle(150% at 50% 50%); }
    .node-user, .node-plan, .node-action, .node-output { animation: none; }
    .thumb-1 { animation: none; left: 50%; }
    .thumb-2 { animation: none; left: 50%; }
    .build-block { animation: none; width: 100%; }
  }
</style>
