---
import CutoutVisual from "../common/CutoutVisual.astro";
import learningToolkitCutout from "../../assets/generated/ai-learning-toolkit-cutout.optimized.webp";

const routes = [
  {
    label: "01",
    title: "Learn the basics",
    text: "Join workshops, beginner sessions, and practical activities that make artificial intelligence easier to understand.",
  },
  {
    label: "02",
    title: "Meet other builders",
    text: "Come to build nights, challenges, talks, and socials with students working on similar ideas.",
  },
  {
    label: "03",
    title: "Use AI responsibly",
    text: "Discuss data quality, bias, accessibility, careers, and the real impact of AI tools.",
  },
];
---

<section id="explore" class="ai-section ai-section--tinted explore-section" aria-labelledby="explore-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
      <h2 id="explore-title" class="section-title">What members can do</h2>
      </div>
      <p class="section-intro">
        Join practical sessions, meet other students, and explore how AI systems are built and used.
      </p>
    </div>

    <div class="explore-grid">
      <CutoutVisual
        compact
        image={learningToolkitCutout}
        alt="Artificial intelligence learning toolkit with a whiteboard tablet, notebook, data cards, calculator, and headphones"
        title="Start where you are."
        body="Find events, projects, learning routes, and the official joining link in one place."
      />
      <div class="impact-routes">
        {routes.map((route) => (
          <article class="impact-route">
            <span class="impact-route__label">{route.label}</span>
            <div>
              <h3>{route.title}</h3>
              <p>{route.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .explore-section {
    overflow: clip;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.82fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .impact-routes {
    display: grid;
    gap: clamp(1.2rem, 3vw, 1.8rem);
  }

  .impact-route {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-bottom: clamp(1.2rem, 3vw, 1.8rem);
    border-bottom: 1px solid var(--ai-border);
  }

  .impact-route__label {
    color: var(--ai-azure);
    font-size: 1rem;
    font-weight: 850;
    line-height: 1.2;
  }

  .impact-route h3 {
    margin: 0 0 0.45rem;
    color: var(--ai-fg);
    font-size: 1.15rem;
    letter-spacing: 0;
  }

  .impact-route p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .explore-grid {
      grid-template-columns: 1fr;
    }

    .impact-route {
      grid-template-columns: 2.75rem 1fr;
    }
  }
</style>
