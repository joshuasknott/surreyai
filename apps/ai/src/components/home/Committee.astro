---
import { Image } from 'astro:assets';
import type { Society } from '@surreysocieties/admin/types';
import joshua from '../../assets/committee/joshua-refined.webp';
import poppy from '../../assets/committee/poppy-refined.webp';
import vinayak from '../../assets/committee/vinayak-refined.webp';
import amanda from '../../assets/committee/amanda-refined.webp';
import samuelJoyson from '../../assets/committee/samuel-joyson-refined.webp';
import kusumitha from '../../assets/committee/kusumitha-refined.webp';
import fatima from '../../assets/committee/fatima-refined.webp';
import george from '../../assets/committee/george-refined.webp';
import miguel from '../../assets/committee/miguel-refined.webp';
import ibrahim from '../../assets/committee/ibrahim-refined.webp';
import samuelYoung from '../../assets/committee/samuel-young-refined.webp';
import bibek from '../../assets/committee/bibek-refined.webp';
import zain from '../../assets/committee/zain-refined.webp';
import deepanshu from '../../assets/committee/deepanshu-refined.webp';

interface Props {
  society: Society;
  committee?: Array<{ name: string; role?: string }>;
}

const { society, committee = [] } = Astro.props;
const linkedInProfiles = new Map([
  ['Joshua Knott', 'https://www.linkedin.com/in/joshuasknott/'],
  ['Poppy Holmes', 'https://www.linkedin.com/in/poppy-holmes-97072b282/'],
  ['Vinayak Vadhera', 'https://www.linkedin.com/in/vinayakvadhera/'],
  ["Amanda Lages O'Connor", 'https://www.linkedin.com/in/amanda-lages-o-connor/'],
  ['Tadavarthi Kusumitha', 'https://www.linkedin.com/in/kusumitha-tadavarthi-5a1360255/'],
  ['George Mahon', 'https://www.linkedin.com/in/george-mahon-131b73260/'],
  ['Miguel Antonio', 'https://www.linkedin.com/in/miguelpcantonio/'],
  ['Ibrahim Haque', 'https://www.linkedin.com/in/ibrahim-haque-5b0468307/'],
  ['Samuel Young', 'https://www.linkedin.com/in/samuel-young-b1b04a2a1/'],
  ['Bibek Limbu', 'https://www.linkedin.com/in/bibek-limbu-445791213/'],
  ['Deepanshu Dariya', 'https://www.linkedin.com/in/deepanshu-dariya-424a64227/'],
]);
const signatoryPortraits = new Map([
  ['Joshua Knott', joshua],
  ['Poppy Holmes', poppy],
  ['Vinayak Vadhera', vinayak],
]);
const officers = society.signatories.map(officer => {
  const member = committee.find(member => member.role === officer.role && member.name.trim()) ?? officer;
  const name = member.name.trim().replace(/\s+/g, ' ').replace(/^Josh Knott$/, 'Joshua Knott').replace(/^Vinayak Manojkumar Vadhera$/, 'Vinayak Vadhera');
  // Match the person, so a future roster change cannot reuse somebody else's face.
  const portrait = signatoryPortraits.get(name);
  const initials = name.split(' ').filter((_, i, parts) => i === 0 || i === parts.length - 1).map(part => part[0]).join('');
  return { name, role: officer.role, portrait, initials, linkedin: linkedInProfiles.get(name) };
});
const teams = [
  { role: 'Workshops & Learning', members: [
    { name: "Amanda Lages O'Connor", portrait: amanda },
    { name: 'Samuel Joyson Rekala', portrait: samuelJoyson },
    { name: 'Tadavarthi Kusumitha', portrait: kusumitha },
  ] },
  { role: 'Events & Socials', members: [
    { name: 'Fatima Waheed', portrait: fatima },
    { name: 'George Mahon', portrait: george },
    { name: 'Miguel Antonio', portrait: miguel },
  ] },
  { role: 'Industry & Partnerships', members: [
    { name: 'Ibrahim Haque', portrait: ibrahim },
    { name: 'Samuel Young', portrait: samuelYoung },
  ] },
  { role: 'Projects & Hackathons', members: [
    { name: 'Bibek Limbu', portrait: bibek },
    { name: 'Muhammad Zain Khan', portrait: zain },
  ] },
  { role: 'Careers & Opportunities', members: [
    { name: 'Deepanshu Dariya', portrait: deepanshu },
  ] },
];
---

<section id="committee" class="flow-section flow-committee" aria-labelledby="committee-title">
  <div class="flow-shell">
    <h2 id="committee-title" class="flow-heading">Meet the <span>committee.</span></h2>
    <p id="signatories-title" class="flow-committee__signatories">Signatories</p>
    <div class="flow-officers" role="group" aria-labelledby="signatories-title">
      {officers.map(officer => <article class="flow-officer">
        {officer.portrait
          ? officer.linkedin
            ? <a class="flow-committee__profile" href={officer.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${officer.name} on LinkedIn (opens in a new tab)`}>
                <Image class="flow-committee__portrait" src={officer.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />
              </a>
            : <Image class="flow-committee__portrait" src={officer.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />
          : <div class="flow-committee__portrait flow-committee__initials" aria-hidden="true">{officer.initials}</div>}
        <div class="flow-officer__identity">
          <h3>{officer.name}</h3>
          <p class="flow-officer__role">{officer.role}</p>
        </div>
      </article>)}
    </div>
    <svg class="flow-committee__branches" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M1 40V11Q1 1 11 1H989Q999 1 999 11V40M250 1V40M500 1V40M750 1V40" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="flow-teams">
      {teams.map(team => <article class="flow-team">
        <h3><span>{team.role.split(' & ')[0]} &amp;</span> <span>{team.role.split(' & ')[1]}</span></h3>
        <ul>
          {team.members.map(member => <li>
            {linkedInProfiles.has(member.name)
              ? <a class="flow-committee__profile" href={linkedInProfiles.get(member.name)} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn (opens in a new tab)`}>
                  <Image class="flow-committee__portrait" src={member.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />
                </a>
              : <Image class="flow-committee__portrait" src={member.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />}
            <span>{member.name}</span>
          </li>)}
        </ul>
      </article>)}
    </div>
  </div>
</section>

<style>
  .flow-committee { padding: 60px 0 150px; }
  .flow-committee > .flow-shell { width: min(1280px, calc(100% - 32px)); }
  .flow-committee .flow-heading {
    text-align: center;
    font-size: clamp(40px, 7.7vw, 104px);
    transform: none;
  }
  .flow-committee .flow-committee__signatories {
    margin: 26px 0 16px;
    color: var(--flow-ink);
    font-size: 28px;
    font-weight: 750;
    line-height: 1.25;
    text-align: center;
  }
  .flow-officers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: min(700px, 85%);
    margin-inline: auto;
  }
  .flow-officer { min-width: 0; text-align: center; }
  .flow-committee__portrait {
    display: block;
    width: 144px;
    height: 144px;
    margin: 0 auto 10px;
    border-radius: 50%;
    object-fit: cover;
  }
  .flow-officer .flow-committee__portrait { width: 154px; height: 154px; }
  .flow-committee__profile {
    display: block;
    width: fit-content;
    margin: 0 auto 10px;
    border-radius: 50%;
  }
  .flow-committee__profile .flow-committee__portrait { margin: 0; }
  .flow-committee__profile:focus-visible {
    outline: 3px solid var(--flow-orange);
    outline-offset: 5px;
  }
  .flow-committee__initials {
    display: grid;
    place-items: center;
    background: #eee7dc;
    font: 800 40px/1 var(--flow-display);
  }
  .flow-officer h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -.03em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .flow-committee .flow-officer__role {
    margin: 4px 0 0;
    color: #cc3b00;
    font-size: 21px;
    font-weight: 550;
    line-height: 1.3;
  }
  .flow-committee__branches {
    display: block;
    width: 80%;
    height: 40px;
    margin: 55px auto 16px;
    color: var(--flow-orange);
  }
  .flow-teams {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    text-align: center;
  }
  .flow-team { min-width: 0; padding-inline: 8px; }
  .flow-team h3 {
    max-width: 180px;
    min-height: 55px;
    margin: 0 auto 22px;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .flow-team h3 > span { display: block; }
  .flow-team ul { display: grid; grid-auto-rows: 206px; gap: 8px; padding: 0; margin: 0; list-style: none; }
  .flow-team li { min-width: 0; min-height: 194px; }
  .flow-team li > span {
    display: block;
    max-width: 180px;
    margin-inline: auto;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -.025em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  @media (max-width: 1023px) {
    .flow-committee { padding-bottom: 120px; }
    .flow-committee > .flow-shell { width: calc(100% - 48px); }
    .flow-committee__branches { display: none; }
    .flow-officers { width: min(700px, 100%); }
    .flow-officer .flow-committee__portrait { width: 120px; height: 120px; }
    .flow-officer h3 { font-size: 20px; }
    .flow-committee .flow-officer__role { font-size: 18px; }
    .flow-teams { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; margin-top: 44px; }
    .flow-team { border-top: 2px solid var(--flow-orange); padding: 22px 0 0; }
    .flow-team h3 { max-width: none; min-height: 0; margin-bottom: 22px; font-size: 23px; }
    .flow-team h3 > span { display: inline; }
    .flow-team ul { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; gap: 20px 12px; }
    .flow-team li { min-height: 0; }
    .flow-team .flow-committee__portrait { width: 112px; height: 112px; }
    .flow-team li > span { font-size: 18px; }
  }
  @media (max-width: 599px) {
    .flow-committee { padding: 36px 0 105px; }
    .flow-committee > .flow-shell { width: calc(100% - 40px); }
    .flow-committee .flow-heading { font-size: clamp(36px, 9.5vw, 52px); }
    .flow-committee .flow-committee__signatories { margin-top: 26px; font-size: 23px; }
    .flow-officers { grid-template-columns: 1fr; gap: 22px; max-width: 350px; }
    .flow-officer { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 18px; align-items: center; text-align: left; }
    .flow-officer .flow-committee__portrait { width: 96px; height: 96px; margin: 0; }
    .flow-officer .flow-committee__profile { margin: 0; }
    .flow-officer h3 { font-size: 20px; text-wrap: initial; }
    .flow-committee .flow-officer__role { margin-top: 5px; font-size: 17px; }
    .flow-teams { grid-template-columns: 1fr; gap: 32px; margin-top: 36px; }
    .flow-team h3 { font-size: 22px; }
    .flow-team ul { gap: 22px 16px; }
    .flow-team .flow-committee__portrait { width: 96px; height: 96px; }
    .flow-team li > span { max-width: 155px; font-size: 17px; }
    .flow-team li:last-child:nth-child(odd) { grid-column: 1 / -1; width: calc(50% - 8px); justify-self: center; }
  }
</style>
