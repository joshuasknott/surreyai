---
import { Image } from 'astro:assets';
import SocialIcon from '@surreysocieties/ui/components/SocialIcon';
import { BookOpen, Users, Handshake, Laptop, Briefcase } from 'lucide-astro';
import type { Society } from '@surreysocieties/admin/types';
import joshua from '../../assets/committee/joshua-refined.webp';
import poppy from '../../assets/committee/poppy-refined.webp';
import vinayak from '../../assets/committee/vinayak-refined.webp';
import amanda from '../../assets/committee/amanda-refined.webp';
import samuelJoyson from '../../assets/committee/samuel-joyson-refined.webp';
import kusumitha from '../../assets/committee/kusumitha-refined.webp';
import fatima from '../../assets/committee/fatima-refined.webp';
import george from '../../assets/committee/george-refined.webp';
import miguel from '../../assets/committee/miguel-refined.webp';
import ibrahim from '../../assets/committee/ibrahim-refined.webp';
import samuelYoung from '../../assets/committee/samuel-young-refined.webp';
import bibek from '../../assets/committee/bibek-refined.webp';
import zain from '../../assets/committee/zain-refined.webp';
import deepanshu from '../../assets/committee/deepanshu-refined.webp';

interface Props {
  society: Society;
  committee?: Array<{ name: string; role?: string }>;
}

const { society, committee = [] } = Astro.props;
const linkedInProfiles = new Map([
  ['Joshua Knott', 'https://www.linkedin.com/in/joshuasknott/'],
  ['Poppy Holmes', 'https://www.linkedin.com/in/poppy-holmes-97072b282/'],
  ['Vinayak Vadhera', 'https://www.linkedin.com/in/vinayakvadhera/'],
  ["Amanda Lages O'Connor", 'https://www.linkedin.com/in/amanda-lages-o-connor/'],
  ['Tadavarthi Kusumitha', 'https://www.linkedin.com/in/kusumitha-tadavarthi-5a1360255/'],
  ['George Mahon', 'https://www.linkedin.com/in/george-mahon-131b73260/'],
  ['Miguel Antonio', 'https://www.linkedin.com/in/miguelpcantonio/'],
  ['Ibrahim Haque', 'https://www.linkedin.com/in/ibrahim-haque-5b0468307/'],
  ['Samuel Young', 'https://www.linkedin.com/in/samuel-young-b1b04a2a1/'],
  ['Bibek Limbu', 'https://www.linkedin.com/in/bibek-limbu-445791213/'],
  ['Deepanshu Dariya', 'https://www.linkedin.com/in/deepanshu-dariya-424a64227/'],
]);
const signatoryPortraits = new Map([
  ['Joshua Knott', joshua],
  ['Poppy Holmes', poppy],
  ['Vinayak Vadhera', vinayak],
]);
const officers = society.signatories.map(officer => {
  const member = committee.find(member => member.role === officer.role && member.name.trim()) ?? officer;
  const name = member.name.trim().replace(/\s+/g, ' ').replace(/^Josh Knott$/, 'Joshua Knott').replace(/^Vinayak Manojkumar Vadhera$/, 'Vinayak Vadhera');
  // Match the person, so a future roster change cannot reuse somebody else's face.
  const portrait = signatoryPortraits.get(name);
  const initials = name.split(' ').filter((_, i, parts) => i === 0 || i === parts.length - 1).map(part => part[0]).join('');
  return { name, role: officer.role, portrait, initials, linkedin: linkedInProfiles.get(name) };
});
const teams = [
  { role: 'Workshops & Learning', icon: BookOpen, members: [
    { name: "Amanda Lages O'Connor", portrait: amanda },
    { name: 'Samuel Joyson Rekala', portrait: samuelJoyson },
    { name: 'Tadavarthi Kusumitha', portrait: kusumitha },
  ] },
  { role: 'Events & Socials', icon: Users, members: [
    { name: 'Fatima Waheed', portrait: fatima },
    { name: 'George Mahon', portrait: george },
    { name: 'Miguel Antonio', portrait: miguel },
  ] },
  { role: 'Industry & Partnerships', icon: Handshake, members: [
    { name: 'Ibrahim Haque', portrait: ibrahim },
    { name: 'Samuel Young', portrait: samuelYoung },
  ] },
  { role: 'Projects & Hackathons', icon: Laptop, members: [
    { name: 'Bibek Limbu', portrait: bibek },
    { name: 'Muhammad Zain Khan', portrait: zain },
  ] },
  { role: 'Careers & Opportunities', icon: Briefcase, members: [
    { name: 'Deepanshu Dariya', portrait: deepanshu },
  ] },
];
---

<section id="committee" class="flow-section flow-committee" aria-labelledby="committee-title">
  <div class="flow-shell">
    <h2 id="committee-title" class="flow-heading">Meet the <span>committee.</span></h2>
    <p id="signatories-title" class="flow-committee__signatories">Signatories</p>
    <div class="flow-officers" role="group" aria-labelledby="signatories-title">
      {officers.map(officer => <article class="flow-officer">
        {officer.portrait
          ? officer.linkedin
            ? <a class="flow-committee__profile" href={officer.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${officer.name} on LinkedIn (opens in a new tab)`}>
                <Image class="flow-committee__portrait" src={officer.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />
              <span class="flow-committee__linkedin" aria-hidden="true"><SocialIcon name="linkedin" /></span></a>
            : <Image class="flow-committee__portrait" src={officer.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />
          : <div class="flow-committee__portrait flow-committee__initials" aria-hidden="true">{officer.initials}</div>}
        <div class="flow-officer__identity">
          <h3>{officer.name}</h3>
          <p class="flow-officer__role">{officer.role}</p>
        </div>
      </article>)}
    </div>
    <div class="flow-teams">
      {teams.map(team => <article class="flow-team">
        <h3><span class="flow-team__icon"><team.icon size={20} aria-hidden="true" /></span><span>{team.role}</span></h3>
        <ul>
          {team.members.map(member => <li>
            {linkedInProfiles.has(member.name)
              ? <a class="flow-committee__profile" href={linkedInProfiles.get(member.name)} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn (opens in a new tab)`}>
                  <Image class="flow-committee__portrait" src={member.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />
                <span class="flow-committee__linkedin" aria-hidden="true"><SocialIcon name="linkedin" /></span></a>
              : <Image class="flow-committee__portrait" src={member.portrait} width={360} height={360} alt="" loading="lazy" decoding="async" />}
            <span>{member.name}</span>
          </li>)}
        </ul>
      </article>)}
    </div>
  </div>
</section>

<style>
  .flow-committee {
    padding: 34px 0 40px;
    background: #faf8f3;
  }
  .flow-committee > .flow-shell { width: min(1180px, 90%); }
  .flow-committee .flow-heading {
    text-align: center;
    font-size: clamp(42px, 5vw, 60px);
    line-height: 1;
    transform: none;
  }
  .flow-committee .flow-committee__signatories {
    margin: 8px 0 18px;
    color: var(--flow-ink);
    font: 800 22px/1.1 var(--flow-display);
    text-align: center;
  }
  .flow-officers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    width: min(720px, 100%);
    margin-inline: auto;
  }
  .flow-officer { min-width: 0; text-align: center; }
  .flow-committee__portrait {
    display: block;
    width: 80px;
    height: 80px;
    margin: 0 auto 8px;
    border-radius: 50%;
    object-fit: cover;
  }
  .flow-officer .flow-committee__portrait { width: 140px; height: 140px; }
  .flow-committee__profile {
    position: relative;
    display: block;
    width: fit-content;
    margin: 0 auto 8px;
    border-radius: 50%;
  }
  .flow-committee__profile .flow-committee__portrait { margin: 0; }
  .flow-committee__profile:focus-visible {
    outline: 3px solid var(--flow-orange);
    outline-offset: 5px;
  }
  .flow-committee__initials {
    display: grid;
    place-items: center;
    background: #eee7dc;
    font: 800 40px/1 var(--flow-display);
  }
  .flow-officer h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -.025em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .flow-committee .flow-officer__role {
    margin: 4px 0 0;
    color: #cc3b00;
    font-size: 15px;
    font-weight: 650;
    line-height: 1.2;
  }
  .flow-teams {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px 24px;
    margin-top: 24px;
    text-align: center;
  }
  .flow-team {
    grid-column: span 2;
    min-width: 0;
    padding: 14px 12px 16px;
    border: 1px solid #e1dbd1;
    border-top: 3px solid var(--flow-orange);
    border-radius: 18px;
    background: #fffdf8;
  }
  .flow-team:nth-child(4) { grid-column: 2 / span 2; }
  .flow-team:nth-child(5) { grid-column: 4 / span 2; }
  .flow-team h3 {
    min-height: 24px;
    margin: 0 0 12px;
    font: 800 22px/1.05 var(--flow-display);
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .flow-team h3 > span { display: inline; }
  .flow-team ul {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .flow-team li {
    display: flex;
    min-width: 0;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
  }
  .flow-team .flow-committee__profile { margin: 0 auto 8px; }
  .flow-team li > span {
    display: block;
    max-width: 12ch;
    margin-inline: auto;
    font-size: 15px;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -.02em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .flow-committee__linkedin { position:absolute; right:-3px; bottom:0; display:grid; place-items:center; width:24px; height:24px; background:white; color:#111; border:1px solid #e1dbd1; border-radius:50%; }
  .flow-committee__linkedin :global(.social-icon) { width:14px; height:14px; flex-basis:14px; }
  .flow-team h3 { display:flex; align-items:center; justify-content:center; gap:8px; font-size:20px; }
  .flow-team h3 > .flow-team__icon { display:grid; place-items:center; flex:0 0 30px; height:30px; color:white; background:#ff4a00; border-radius:7px; }
  @media (max-width: 1023px) {
    .flow-committee { padding-bottom: 40px; }
    .flow-committee > .flow-shell { width: min(920px, calc(100% - 48px)); }
    .flow-officers { width: min(680px, 100%); gap: 20px; }
    .flow-officer .flow-committee__portrait { width: 120px; height: 120px; }
    .flow-teams { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 26px; }
    .flow-team,
    .flow-team:nth-child(4),
    .flow-team:nth-child(5) { grid-column: span 2; }
    .flow-team:nth-child(4) { grid-column: span 2; }
    .flow-team:nth-child(5) { grid-column: 2 / span 2; }
    .flow-team { padding-inline: 8px; }
    .flow-team .flow-committee__portrait { width: 72px; height: 72px; }
    .flow-team ul { gap: 6px; }
    .flow-team li > span { font-size: 14px; }
  }
  @media (max-width: 760px) {
    .flow-committee { padding: 32px 0 36px; }
    .flow-committee > .flow-shell { width: calc(100% - 40px); }
    .flow-committee .flow-heading { font-size: clamp(38px, 9vw, 56px); }
    .flow-committee .flow-committee__signatories { margin: 12px 0 20px; font-size: 21px; }
    .flow-officers { width: 100%; gap: 12px; }
    .flow-officer .flow-committee__portrait { width: 80px; height: 80px; }
    .flow-officer h3 { font-size: 15px; }
    .flow-committee .flow-officer__role { margin-top: 4px; font-size: 14px; }
    .flow-teams { grid-template-columns: 1fr; gap: 16px; margin-top: 30px; }
    .flow-team,
    .flow-team:nth-child(4),
    .flow-team:nth-child(5) { grid-column: auto; padding: 16px 14px 18px; }
    .flow-team h3 { min-height: 0; margin-bottom: 14px; font-size: 22px; }
    .flow-team .flow-committee__portrait { width: 76px; height: 76px; }
    .flow-team ul { gap: 10px; }
    .flow-team li > span { max-width: 13ch; font-size: 14px; }
  }
  @media (max-width: 380px) {
    .flow-committee > .flow-shell { width: calc(100% - 28px); }
    .flow-officers { gap: 6px; }
    .flow-officer .flow-committee__portrait { width: 76px; height: 76px; }
    .flow-team .flow-committee__portrait { width: 68px; height: 68px; }
    .flow-team ul { gap: 5px; }
  }
</style>
