---
interface Props {
  committee: {
    _id: string;
    name?: string;
    role: string;
    displayOrder?: number;
  }[];
}

const { committee } = Astro.props;

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || "?").trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return "?";
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
};
---

<section class="py-20 sm:py-24 px-6 relative overflow-hidden bg-ai-bg">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-ai-fg">
        Meet the Committee
      </h2>
      <p class="mt-4 text-ai-fg-muted text-lg">
        The students behind Surrey Artificial Intelligence Society.
      </p>
    </div>

    {committee.length === 0 ? (
      <div class="border border-ai-border bg-ai-surface rounded-xl p-8 sm:p-12 text-center flex flex-col items-center shadow-sm">
        <div class="w-16 h-16 rounded-full bg-ai-purple/10 flex items-center justify-center mb-6" aria-hidden="true">
          <svg class="w-8 h-8 text-ai-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl mb-2 text-ai-fg">Committee details coming soon</h3>
        <p class="text-ai-fg-muted text-base leading-relaxed max-w-md mx-auto mb-8">
          Check back soon to meet the Surrey Artificial Intelligence Society committee.
        </p>
        <a href="/about" class="px-6 py-3 bg-ai-purple hover:opacity-90 text-white transition-opacity rounded-lg text-sm font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ai-purple">
          Read about our society
        </a>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {committee.map((member) => (
          <div class="border border-ai-border bg-ai-surface rounded-xl p-6 flex items-start gap-4 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full bg-ai-purple/10 flex items-center justify-center text-ai-purple text-sm font-bold shrink-0">
              {getInitials(member.name, member.role)}
            </div>
            <div>
              <h3 class="font-semibold text-ai-fg text-lg">{member.role}</h3>
              {member.name && (
                <p class="text-ai-fg-muted mt-1">{member.name}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
