---
interface Props {
  committee: {
    _id: string;
    name?: string;
    role: string;
    displayOrder?: number;
  }[];
}

const { committee } = Astro.props;

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || "?").trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return "?";
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
};
---

<section class="committee-preview py-16 sm:py-24 px-6 relative overflow-hidden bg-ai-bg">
  <div class="committee-preview__backdrop" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl">
    <div class="mb-10 relative z-10">
      <p class="committee-preview__kicker">Committee</p>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-[-0.055em] text-ai-fg">
        Meet the Committee
      </h2>
      <p class="mt-3 text-ai-fg-muted text-base max-w-2xl leading-relaxed">
        The students behind Surrey Artificial Intelligence Society.
      </p>
    </div>

    {committee.length === 0 ? (
      <div class="committee-preview__empty relative z-10">
        <div class="committee-preview__matrix" aria-hidden="true">
          {Array.from({ length: 9 }).map((_, index) => (
            <span class={index === 4 ? "is-core" : ""}></span>
          ))}
        </div>
        <h3 class="font-extrabold text-2xl sm:text-3xl tracking-tight mb-3 text-ai-fg">Committee roster coming soon</h3>
        <p class="text-ai-fg-muted text-base leading-relaxed max-w-xl mx-auto mb-8">
          Our committee for the new academic year will be listed here once elections are complete. Check the About page to learn more about the society.
        </p>
        <a href="/about" class="btn-primary">
          About the society
        </a>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
        {committee.map((member) => (
          <div class="border border-ai-border bg-ai-surface rounded-2xl p-6 flex items-start gap-4 hover:shadow-xl transition-shadow relative overflow-hidden">
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-ai-cyan via-ai-purple to-ai-cyan opacity-70"></div>
            <div class="w-12 h-12 rounded-2xl bg-ai-purple/10 border border-ai-purple/20 flex items-center justify-center text-ai-purple text-sm font-bold shrink-0">
              {getInitials(member.name, member.role)}
            </div>
            <div>
              <h3 class="font-semibold text-ai-fg text-lg">{member.role}</h3>
              {member.name && (
                <p class="text-ai-fg-muted mt-1">{member.name}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .committee-preview__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 80% 12%, color-mix(in srgb, var(--ai-purple) 14%, transparent), transparent 26rem),
      linear-gradient(color-mix(in srgb, var(--ai-border) 30%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ai-border) 30%, transparent) 1px, transparent 1px);
    background-size: auto, 38px 38px, 38px 38px;
    mask-image: radial-gradient(circle at 50% 10%, #000, transparent 76%);
  }

  .committee-preview__kicker {
    margin: 0 0 0.6rem;
    color: var(--ai-purple);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .committee-preview__empty {
    border: 1px solid color-mix(in srgb, var(--ai-purple) 24%, var(--ai-border));
    border-radius: 1.75rem;
    padding: clamp(2rem, 5vw, 4rem);
    text-align: center;
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--ai-purple) 18%, transparent), transparent 19rem),
      var(--ai-surface);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 44%, transparent);
  }

  .committee-preview__matrix {
    display: grid;
    grid-template-columns: repeat(3, 4.2rem);
    gap: 0.7rem;
    justify-content: center;
    margin: 0 auto 2rem;
  }

  .committee-preview__matrix span {
    aspect-ratio: 1;
    border: 1px solid var(--ai-border);
    border-radius: 1.1rem;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--ai-surface) 85%, transparent), color-mix(in srgb, var(--ai-bg) 76%, transparent));
    box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 44%, transparent);
  }

  .committee-preview__matrix span.is-core {
    border-color: color-mix(in srgb, var(--ai-purple) 55%, var(--ai-border));
    background: radial-gradient(circle, color-mix(in srgb, var(--ai-purple) 34%, transparent), var(--ai-surface) 68%);
    box-shadow: 0 0 2rem color-mix(in srgb, var(--ai-purple) 32%, transparent);
  }

  @media (max-width: 640px) {
    .committee-preview__matrix {
      grid-template-columns: repeat(3, 3.4rem);
    }
  }
</style>
