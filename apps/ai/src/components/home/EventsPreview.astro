---
interface Props {
  events: {
    _id: string;
    title: string;
    description?: string;
    date?: string;
    startTime?: string;
    endTime?: string;
    location?: string;
    category?: string;
    status: string;
  }[];
}

const { events } = Astro.props;

const formatEventDate = (date?: string) => {
  if (!date) return "Date TBC";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
  });
};
---

<section id="events" class="bg-ai-surface text-ai-fg py-16 sm:py-24 px-6 border-b border-ai-border">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-2">
          Recent & Upcoming Events
        </h2>
      </div>
      <a href="/events" class="text-ai-azure hover:underline text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ai-azure rounded-sm">
        View all events &rarr;
      </a>
    </div>

    {events.length === 0 ? (
      <div class="text-center py-16 bg-ai-bg border border-ai-border rounded-2xl">
        <h3 class="font-bold text-2xl tracking-tight mb-3 text-ai-fg">Events being announced soon</h3>
        <p class="text-ai-fg-muted text-base leading-relaxed max-w-xl mx-auto mb-8">
          We're currently planning our next semester of events. Join our community to get notified.
        </p>
        <a href="/join" class="btn-primary">
          Become a member
        </a>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.slice(0, 3).map((event) => (
          <article class="bg-ai-bg border border-ai-border rounded-xl p-8 hover:shadow-lg transition-shadow duration-300 flex flex-col">
            <time class="text-3xl font-extrabold text-ai-fg mb-4 uppercase tracking-tighter">
              {formatEventDate(event.date)}
            </time>
            
            <h3 class="font-bold text-xl text-ai-fg mb-2">
              {event.title}
            </h3>
            
            {(event.location || event.startTime) && (
              <p class="text-sm font-medium text-ai-azure mb-4 uppercase tracking-wide">
                {[event.location, event.startTime].filter(Boolean).join(" • ")}
              </p>
            )}

            {event.description && (
              <p class="text-ai-fg-muted text-sm leading-relaxed mb-6 flex-grow">{event.description}</p>
            )}

            <a href="/events" class="text-ai-fg font-semibold text-sm hover:text-ai-azure transition-colors mt-auto inline-flex items-center gap-1 group">
              View details <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
