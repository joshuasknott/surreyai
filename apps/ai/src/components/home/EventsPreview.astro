---
import { getSocietyById } from '@surreysocieties/admin/config';
interface Props {
  events: { _id: string; title: string; date?: string; startTime?: string; location?: string }[];
}
const { events } = Astro.props;
const society = getSocietyById('ai')!;
const formatDate = (date?: string) => {
  const parsed = new Date((date || '') + 'T00:00:00');
  return Number.isNaN(parsed.getTime()) ? 'Date to be announced' : parsed.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
};
---

<section id="events" class="events-preview" aria-labelledby="events-preview-title">
  <div class="events-preview__inner">
    <div class="events-preview__heading">
      <h2 id="events-preview-title">Meet. Learn. Make.</h2>
      <a href="/events" class="text-link">Explore events &rarr;</a>
    </div>
    {events.length ? (
      <div class="event-list">
        {events.slice(0, 3).map(event => (
          <a class="event-row" href={'/events#event-' + event._id}>
            <time datetime={event.date}>{formatDate(event.date)}</time>
            <span><strong>{event.title}</strong><span>{[event.startTime, event.location].filter(Boolean).join(' · ') || 'Details on the event page'}</span></span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="event-empty">
        <h3>New dates are on the way.</h3>
        <p>Workshops, project nights, talks and socials. Follow the society for the next announcement.</p>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-link">Follow @surreyaisociety &rarr;</a>
      </div>
    )}
  </div>
</section>

<style>
  .events-preview { padding: 2.5rem 1.25rem; border-bottom: 1px solid var(--ai-border); background: var(--ai-paper-soft); }
  .events-preview__inner { display: grid; grid-template-columns: minmax(15rem, 0.55fr) minmax(0, 1fr); gap: 3rem; max-width: 82rem; margin: 0 auto; align-items: center; }
  .events-preview__heading h2 { margin: 0 0 0.35rem; font-size: 1.65rem; font-weight: 800; letter-spacing: -0.035em; line-height: 1.2; }
  .event-empty { border-left: 1px solid var(--ai-border-strong); padding-left: 2rem; }
  .event-empty h3 { margin: 0 0 0.45rem; font-size: 1.1rem; font-weight: 750; }
  .event-empty p { margin: 0 0 0.25rem; max-width: 42rem; color: var(--ai-fg-muted); line-height: 1.6; }
  .event-row { display: grid; grid-template-columns: 6rem 1fr auto; align-items: center; gap: 1rem; padding: 1rem 0; color: var(--ai-fg); text-decoration: none; border-bottom: 1px solid var(--ai-border); }
  .event-row time { color: var(--ai-link); font-size: 0.9rem; font-weight: 750; }
  .event-row strong { display: block; font-weight: 750; }
  .event-row > span > span { display: block; margin-top: 0.3rem; color: var(--ai-fg-muted); font-size: 0.9rem; }
  .event-row:hover strong { text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 720px) {
    .events-preview { padding: 2rem 1.2rem; }
    .events-preview__inner { grid-template-columns: 1fr; gap: 1.25rem; }
    .event-empty { border-left: 0; border-top: 1px solid var(--ai-border-strong); padding: 1.25rem 0 0; }
    .event-row { grid-template-columns: 4.5rem 1fr auto; gap: 0.75rem; }
  }
</style>
