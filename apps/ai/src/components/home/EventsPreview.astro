---
interface Props {
  events: {
    _id: string;
    title: string;
    description?: string;
    date?: string;
    startTime?: string;
    endTime?: string;
    location?: string;
    category?: string;
    status: string;
  }[];
}

const { events } = Astro.props;

const formatEventDate = (date?: string) => {
  if (!date) return "Date TBC";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};
---

<section id="events" class="bg-ai-surface text-ai-fg py-20 sm:py-24 px-6 relative overflow-hidden border-b border-ai-border">
  <div class="mx-auto max-w-6xl relative z-10">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">
          What's Coming Up
        </h2>
      </div>
      <a href="/events" class="text-ai-cyan hover:underline text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ai-cyan rounded-sm">
        View all events <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    {events.length === 0 ? (
      <div class="border border-ai-border bg-ai-bg rounded-xl p-8 sm:p-12 text-center flex flex-col items-center shadow-sm">
        <div class="w-16 h-16 rounded-full bg-ai-cyan/10 flex items-center justify-center mb-6" aria-hidden="true">
          <svg class="w-8 h-8 text-ai-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl mb-2 text-ai-fg">Events being announced soon</h3>
        <p class="text-ai-fg-muted text-base leading-relaxed max-w-md mx-auto mb-8">
          We're planning workshops, build nights, discussions, and more for the year ahead. Check back soon or follow our socials for updates.
        </p>
        <a href="/join" class="px-6 py-3 bg-ai-cyan hover:opacity-90 text-white transition-opacity rounded-lg text-sm font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ai-cyan">
          Become a member
        </a>
      </div>
    ) : (
      <div class="flex flex-col gap-4">
        {events.slice(0, 4).map((event) => (
          <div class="group relative bg-ai-bg border border-ai-border rounded-xl p-6 hover:shadow-md transition-shadow flex flex-col sm:flex-row gap-4 sm:gap-8 sm:items-center overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-ai-cyan opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <div class="flex-shrink-0 w-40 text-sm font-medium text-ai-fg-muted">
              <div>{formatEventDate(event.date)}</div>
              {event.startTime && <div>{event.startTime}</div>}
            </div>

            <div class="flex-grow">
              <div class="flex items-center gap-3 mb-1">
                {event.category && (
                  <span class="text-xs font-semibold text-ai-purple">
                    {event.category}
                  </span>
                )}
              </div>
              <h3 class="font-bold text-lg text-ai-fg mb-1 group-hover:text-ai-cyan transition-colors">
                {event.title}
              </h3>
              {event.description && (
                <p class="text-ai-fg-muted text-sm">{event.description}</p>
              )}
            </div>

            <div class="hidden sm:flex flex-shrink-0 text-ai-fg-muted group-hover:text-ai-cyan transition-colors items-center justify-center w-8 h-8 rounded-full bg-ai-surface group-hover:bg-ai-cyan/10">
              <span class="text-lg" aria-hidden="true">&rarr;</span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
