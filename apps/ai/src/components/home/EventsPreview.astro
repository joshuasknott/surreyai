---
interface Props {
  events: {
    _id: string;
    title: string;
    description?: string;
    date?: string;
    startTime?: string;
    endTime?: string;
    location?: string;
    category?: string;
    status: string;
  }[];
}

const { events } = Astro.props;

const plannedFormats = ["Welcome sessions", "Workshops", "Build nights", "Talks", "Careers activity"];

const formatEventDate = (date?: string) => {
  if (!date) return "Date not published";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
  });
};
---

<section id="events" class="ai-section ai-section--tinted" aria-labelledby="events-preview-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
        <h2 id="events-preview-title" class="section-title">Events and updates</h2>
        <p class="section-intro">Confirmed details appear here once the committee publishes them.</p>
      </div>
      <a href="/events" class="text-link">View all events &rarr;</a>
    </div>

    <div class="events-preview-grid">
      {events.length === 0 ? (
        <div class="event-empty">
          <h3>Confirmed events will appear here once added.</h3>
          <p>
            Dates, locations, and joining routes will be published here once they are ready to share.
          </p>
          <div class="event-formats" aria-label="Society activity areas">
            {plannedFormats.map((format) => <span>{format}</span>)}
          </div>
          <div class="event-empty__actions">
            <a href="/join" class="btn-primary">Become a member</a>
            <a href="/events" class="btn-secondary">View updates</a>
          </div>
        </div>
      ) : (
        <div class="event-list">
          {events.slice(0, 3).map((event) => (
            <article class="event-row">
              <time>{formatEventDate(event.date)}</time>
              <div>
                <h3>{event.title}</h3>
                <p>
                  {[event.startTime, event.location, event.category].filter(Boolean).join(" / ") || "Details to be announced"}
                </p>
              </div>
              <a href="/events">Details &rarr;</a>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .events-preview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.4rem, 4vw, 2.5rem);
    align-items: stretch;
  }

  .event-empty {
    align-self: center;
    max-width: 58rem;
    padding: clamp(1.5rem, 4vw, 2.4rem);
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--ai-surface) 84%, var(--ai-paper));
    box-shadow: 0 18px 44px color-mix(in srgb, var(--ai-slate-base) 7%, transparent);
  }

  .event-empty h3 {
    margin: 0 0 0.85rem;
    color: var(--ai-fg);
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .event-empty p {
    color: var(--ai-fg-muted);
    line-height: 1.65;
  }

  .event-formats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.35rem;
    color: var(--ai-fg);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .event-formats span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--ai-border);
    border-radius: 999px;
    background: var(--ai-bg);
  }

  .event-formats span::before {
    content: "";
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--ai-azure);
  }

  .event-formats span:nth-child(2)::before,
  .event-formats span:nth-child(5)::before {
    background: var(--ai-sage);
  }

  .event-formats span:nth-child(4)::before {
    background: var(--ai-coral);
  }

  .event-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .event-list {
    border: 1px solid var(--ai-border);
    border-radius: 1.35rem;
    background: var(--ai-surface);
    overflow: hidden;
  }

  .event-row {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.35rem 1.5rem;
  }

  .event-row + .event-row {
    border-top: 1px solid var(--ai-border);
  }

  .event-row time {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .event-row h3 {
    margin: 0 0 0.35rem;
    color: var(--ai-fg);
    font-size: 1.15rem;
  }

  .event-row p {
    margin: 0;
    color: var(--ai-fg-muted);
  }

  .event-row a {
    color: var(--ai-azure);
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .event-row {
      grid-template-columns: 1fr;
    }
  }


</style>
