---
interface Props {
  events: {
    _id: string;
    title: string;
    description?: string;
    date?: string;
    startTime?: string;
    endTime?: string;
    location?: string;
    category?: string;
    status: string;
  }[];
}

const { events } = Astro.props;

const plannedFormats = ["Prompt labs", "Data clinics", "Responsible AI debates"];

const formatEventDate = (date?: string) => {
  if (!date) return "Date TBC";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;
  return parsed.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
  });
};
---

<section id="events" class="ai-section ai-section--tinted" aria-labelledby="events-preview-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
        <h2 id="events-preview-title" class="section-title">Join when the next session lands.</h2>
      </div>
      <a href="/events" class="text-link">View all events -></a>
    </div>

    <div class="events-preview-grid">
      {events.length === 0 ? (
        <div class="event-empty">
          <h3>Next events will appear here once confirmed.</h3>
          <p>
            The calendar is managed by society signatories. While the live list is pending, the programme direction is already clear: practical workshops, project sessions, and careful discussions about AI in use.
          </p>
          <div class="event-formats" aria-label="Likely event formats">
            {plannedFormats.map((format) => <span>{format}</span>)}
          </div>
          <div class="event-empty__actions">
            <a href="/join" class="btn-primary">Become a member</a>
            <a href="/events" class="btn-secondary">Events page</a>
          </div>
        </div>
      ) : (
        <div class="event-list">
          {events.slice(0, 3).map((event) => (
            <article class="event-row">
              <time>{formatEventDate(event.date)}</time>
              <div>
                <h3>{event.title}</h3>
                <p>
                  {[event.startTime, event.location, event.category].filter(Boolean).join(" / ") || "Details to be announced"}
                </p>
              </div>
              <a href="/events">Details -></a>
            </article>
          ))}
        </div>
      )}
      <aside class="event-visual" aria-label="AI event planning visual">
        <div class="event-visual__board">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
        <svg viewBox="0 0 600 420" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 310 C92 242 168 336 254 268 S416 182 600 248" />
          <path d="M72 372 C156 292 236 350 310 288 S460 206 572 272" />
        </svg>
      </aside>
    </div>
  </div>
</section>

<style>
  .events-preview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.72fr);
    gap: clamp(1.4rem, 4vw, 2.5rem);
    align-items: stretch;
  }

  .event-empty {
    align-self: center;
    max-width: 44rem;
  }

  .event-empty h3 {
    margin: 0 0 0.85rem;
    color: var(--ai-fg);
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .event-empty p {
    color: var(--ai-fg-muted);
    line-height: 1.65;
  }

  .event-formats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1rem;
    margin-top: 1.35rem;
    color: var(--ai-fg);
    font-weight: 800;
  }

  .event-formats span + span::before {
    color: var(--ai-azure);
    content: "/";
    margin-right: 1rem;
  }

  .event-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .event-list {
    border: 1px solid var(--ai-border);
    border-radius: 1.35rem;
    background: var(--ai-surface);
    overflow: hidden;
  }

  .event-row {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.35rem 1.5rem;
  }

  .event-row + .event-row {
    border-top: 1px solid var(--ai-border);
  }

  .event-row time {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .event-row h3 {
    margin: 0 0 0.35rem;
    color: var(--ai-fg);
    font-size: 1.15rem;
  }

  .event-row p {
    margin: 0;
    color: var(--ai-fg-muted);
  }

  .event-row a {
    color: var(--ai-azure);
    font-weight: 800;
    text-decoration: none;
  }

  .event-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 24rem;
    margin: 0;
    overflow: clip;
    border-radius: 1.35rem;
    border: 1px solid var(--ai-border);
    background:
      radial-gradient(circle at 70% 18%, color-mix(in srgb, var(--ai-azure) 16%, transparent), transparent 14rem),
      radial-gradient(circle at 28% 82%, color-mix(in srgb, var(--ai-coral) 14%, transparent), transparent 14rem),
      var(--ai-surface);
  }

  .event-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, color-mix(in srgb, var(--ai-bg) 24%, transparent), transparent 56%),
      linear-gradient(90deg, transparent, color-mix(in srgb, var(--ai-azure) 8%, transparent));
    pointer-events: none;
  }

  .event-visual__board {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(78%, 24rem);
    gap: 0.9rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--ai-border-strong);
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--ai-bg) 78%, transparent);
    box-shadow: 0 28px 58px rgba(17, 24, 39, 0.14);
    transform: rotate(-2deg);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .event-visual:hover .event-visual__board {
    transform: rotate(0deg) translateY(-0.35rem);
  }

  .event-visual__board span {
    display: block;
    height: 2.8rem;
    border-radius: 0.85rem;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-azure) 22%, transparent), transparent 46%),
      color-mix(in srgb, var(--ai-bg) 72%, var(--ai-surface));
    border: 1px solid var(--ai-border);
  }

  .event-visual__board span:nth-child(2) {
    width: 82%;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-coral) 22%, transparent), transparent 52%),
      color-mix(in srgb, var(--ai-bg) 72%, var(--ai-surface));
  }

  .event-visual__board span:nth-child(3) {
    width: 70%;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-sage) 18%, transparent), transparent 52%),
      color-mix(in srgb, var(--ai-bg) 72%, var(--ai-surface));
  }

  .event-visual__board span:nth-child(4) {
    width: 90%;
  }

  .event-visual__board span:nth-child(5) {
    width: 64%;
  }

  .event-visual svg {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .event-visual path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.68);
    stroke-width: 2;
    stroke-dasharray: 16 18;
    animation: event-signal 7s linear infinite;
  }

  .event-visual path + path {
    stroke: color-mix(in srgb, var(--ai-coral) 74%, #ffffff);
    animation-direction: reverse;
  }

  @keyframes event-signal {
    to {
      stroke-dashoffset: -136;
    }
  }

  @media (max-width: 720px) {
    .events-preview-grid,
    .event-row {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-visual path {
      animation: none;
    }
  }
</style>
