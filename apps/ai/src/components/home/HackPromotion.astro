---
import { Image } from 'astro:assets';
import { ArrowUpRight } from 'lucide-astro';
import hackLogo from '../../assets/brand/surrey-ai-hack-2027.webp';
import laptop from '../../assets/generated/illustrated/laptop.webp';
---
<section id="surrey-ai-hack" class="home-hack" aria-label="Surrey AI Hack 2027">
  <div class="flow-shell home-hack__inner">
    <div class="home-hack__copy">
      <Image class="home-hack__brand" src={hackLogo} alt="Surrey AI Hack 2027" width={360} loading="lazy" />
      <h2 class="flow-heading">Build something<br />worth showing.</h2>
      <p>A national weekend for UK university students to build and demo AI projects.<br />Beginners welcome. Every discipline welcome.</p>
      <a class="flow-button flow-button--orange" href="https://surrey-ai-hack-2027.vercel.app/" target="_blank" rel="noopener noreferrer">Explore Surrey AI Hack 2027 <ArrowUpRight size={21} aria-hidden="true" /></a>
      <p class="home-hack__details">2026/27 academic year · Details to be announced</p>
    </div>
    <Image class="home-hack__art" src={laptop} width={640} alt="" loading="lazy" />
  </div>
</section>
