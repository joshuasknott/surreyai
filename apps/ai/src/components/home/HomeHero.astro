---
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <canvas class="home-hero__canvas" id="ai-hero-canvas" aria-hidden="true"></canvas>
  
  <!-- Subtle ambient glowing background orbs -->
  <div class="hero-glow-orb orb-1" aria-hidden="true"></div>
  <div class="hero-glow-orb orb-2" aria-hidden="true"></div>
  <div class="hero-glow-orb orb-3" aria-hidden="true"></div>

  <div class="home-hero__inner">
    <div class="home-hero__content">
      <h1 id="home-hero-title" class="home-hero__title">
        Surrey Artificial Intelligence Society.
        <span class="gradient-text-band">Learn the systems. Build the prototypes. Question the impact.</span>
      </h1>
      <p class="home-hero__intro">
        A beginner-friendly technical community for students who want to understand machine learning,
        generative AI, automation, and responsible deployment through practical sessions and member projects.
      </p>
      
      <div class="home-hero__actions">
        <a href="/join" class="btn-primary">Join the Society</a>
        <a href="#explore" class="btn-secondary">Explore AI tracks</a>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById("ai-hero-canvas") as HTMLCanvasElement | null;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas) {
    const context = canvas.getContext("2d");
    
    // Mouse state for gravity lens warping
    const mouse = {
      x: 0,
      y: 0,
      targetX: 0,
      targetY: 0,
      active: false,
      warpRadius: 240,
    };

    // Particle pool configuration (star dust)
    const particleCount = 130;
    const particles: Array<{
      x: number;
      y: number;
      ox: number; // Original x (for drifting back)
      oy: number; // Original y
      vx: number;
      vy: number;
      size: number;
      alpha: number;
      targetAlpha: number;
      color: string;
      angle: number;
      orbitSpeed: number;
      noiseOffset: number;
    }> = [];

    const colors = [
      "rgba(79, 70, 229, 0.45)",  // Indigo
      "rgba(124, 58, 237, 0.45)", // Violet
      "rgba(167, 139, 250, 0.4)", // Orchid Purple
      "rgba(245, 158, 11, 0.35)", // Sunset Amber
      "rgba(224, 83, 60, 0.35)",  // Soft Coral
      "rgba(16, 185, 129, 0.35)"  // Sage Green
    ];

    const initParticles = (width: number, height: number) => {
      particles.length = 0;
      for (let i = 0; i < particleCount; i++) {
        const px = Math.random() * width;
        const py = Math.random() * height;
        particles.push({
          x: px,
          y: py,
          ox: px,
          oy: py,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          size: 0.8 + Math.random() * 2.0,
          alpha: 0.15 + Math.random() * 0.5,
          targetAlpha: 0.2 + Math.random() * 0.6,
          color: colors[i % colors.length],
          angle: Math.random() * Math.PI * 2,
          orbitSpeed: 0.005 + Math.random() * 0.015,
          noiseOffset: Math.random() * 1000,
        });
      }
    };

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(rect.width * ratio));
      canvas.height = Math.max(1, Math.floor(rect.height * ratio));
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      initParticles(rect.width, rect.height);
    };

    let animationFrameId: number;

    const draw = (time = 0) => {
      if (!context) return;
      const rect = canvas.getBoundingClientRect();
      context.clearRect(0, 0, rect.width, rect.height);

      // Smooth mouse interpolation
      if (mouse.active) {
        mouse.x += (mouse.targetX - mouse.x) * 0.08;
        mouse.y += (mouse.targetY - mouse.y) * 0.08;
      }

      // 1. Draw gravitational grid space warp (Antigravity spacetime lensing)
      const gridSpacing = 70;
      context.strokeStyle = document.documentElement.getAttribute("data-theme") === "light"
        ? "rgba(30, 30, 31, 0.035)"
        : "rgba(255, 255, 255, 0.02)";
      context.lineWidth = 0.8;

      for (let x = 0; x < rect.width + gridSpacing; x += gridSpacing) {
        context.beginPath();
        for (let y = 0; y < rect.height + gridSpacing; y += 12) {
          let drawX = x;
          let drawY = y;

          if (mouse.active) {
            const dx = x - mouse.x;
            const dy = y - mouse.y;
            const dist = Math.hypot(dx, dy);

            if (dist < mouse.warpRadius) {
              const force = Math.exp(-dist / 140);
              // Gravity lensing pulling effect
              drawX += (mouse.x - x) * force * 0.28;
              drawY += (mouse.y - y) * force * 0.28;
            }
          }

          if (y === 0) {
            context.moveTo(drawX, drawY);
          } else {
            context.lineTo(drawX, drawY);
          }
        }
        context.stroke();
      }

      for (let y = 0; y < rect.height + gridSpacing; y += gridSpacing) {
        context.beginPath();
        for (let x = 0; x < rect.width + gridSpacing; x += 12) {
          let drawX = x;
          let drawY = y;

          if (mouse.active) {
            const dx = x - mouse.x;
            const dy = y - mouse.y;
            const dist = Math.hypot(dx, dy);

            if (dist < mouse.warpRadius) {
              const force = Math.exp(-dist / 140);
              drawX += (mouse.x - x) * force * 0.28;
              drawY += (mouse.y - y) * force * 0.28;
            }
          }

          if (x === 0) {
            context.moveTo(drawX, drawY);
          } else {
            context.lineTo(drawX, drawY);
          }
        }
        context.stroke();
      }

      // 2. Update and draw stardust particles (Orbiting gravity field)
      particles.forEach((p, idx) => {
        // Natural organic noise drift
        p.noiseOffset += 0.002;
        const driftX = Math.sin(p.noiseOffset + p.angle) * 0.15;
        const driftY = Math.cos(p.noiseOffset - p.angle) * 0.15;
        
        p.x += p.vx + driftX;
        p.y += p.vy + driftY;

        // Interaction field: Gravitational warping or orbit
        if (mouse.active) {
          const dx = mouse.x - p.x;
          const dy = mouse.y - p.y;
          const dist = Math.hypot(dx, dy);

          if (dist < mouse.warpRadius + 80) {
            const pullAngle = Math.atan2(dy, dx);
            const gravityForce = Math.min(1.8, 280 / (dist + 30));

            // Pull towards mouse + Orbit force around it
            p.vx += Math.cos(pullAngle) * gravityForce * 0.015 + Math.sin(pullAngle) * gravityForce * 0.025;
            p.vy += Math.sin(pullAngle) * gravityForce * 0.015 - Math.cos(pullAngle) * gravityForce * 0.025;
            p.alpha += (0.9 - p.alpha) * 0.05; // Light up near gravity source
          } else {
            p.vx += (p.ox - p.x) * 0.001; // Return home slowly
            p.vy += (p.oy - p.y) * 0.001;
            p.alpha += (p.targetAlpha - p.alpha) * 0.03;
          }
        } else {
          p.vx += (p.ox - p.x) * 0.0005;
          p.vy += (p.oy - p.y) * 0.0005;
          p.alpha += (p.targetAlpha - p.alpha) * 0.03;
        }

        // Apply visual air resistance / damping
        p.vx *= 0.97;
        p.vy *= 0.97;

        // Keep boundaries sane
        if (p.x < 0 || p.x > rect.width) p.x = Math.random() * rect.width;
        if (p.y < 0 || p.y > rect.height) p.y = Math.random() * rect.height;

        context.fillStyle = p.color;
        context.globalAlpha = p.alpha;
        context.beginPath();
        context.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        context.fill();
        context.globalAlpha = 1.0;
      });

      if (!prefersReducedMotion) {
        animationFrameId = requestAnimationFrame(draw);
      }
    };

    resize();
    draw();

    window.addEventListener("resize", resize);

    const onMouseMove = (e: MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      mouse.targetX = e.clientX - rect.left;
      mouse.targetY = e.clientY - rect.top;
      if (!mouse.active) {
        mouse.x = mouse.targetX;
        mouse.y = mouse.targetY;
        mouse.active = true;
      }
    };

    const onMouseLeave = () => {
      mouse.active = false;
    };

    canvas.parentElement?.addEventListener("mousemove", onMouseMove);
    canvas.parentElement?.addEventListener("mouseenter", () => mouse.active = true);
    canvas.parentElement?.addEventListener("mouseleave", onMouseLeave);
  }
</script>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - 5rem);
    display: flex;
    align-items: center;
    color: var(--ai-fg);
    background: var(--ai-bg);
  }

  .home-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.85;
    pointer-events: none;
  }

  /* Deep layered premium ambient blurs (Google Antigravity & Gemini mesh glows) */
  .hero-glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    z-index: 0;
    opacity: 0.16;
    pointer-events: none;
    animation: drift 25s infinite alternate ease-in-out;
  }
  
  :root[data-theme="light"] .hero-glow-orb {
    opacity: 0.12;
    filter: blur(160px);
  }

  .orb-1 {
    top: -10%;
    left: 8%;
    width: 50vw;
    height: 50vw;
    background: radial-gradient(circle, var(--ai-azure) 0%, transparent 70%);
  }
  .orb-2 {
    bottom: -12%;
    right: 3%;
    width: 52vw;
    height: 52vw;
    background: radial-gradient(circle, var(--ai-coral) 0%, transparent 70%);
    animation-delay: -5s;
    animation-duration: 28s;
  }
  .orb-3 {
    top: 25%;
    left: 55%;
    width: 40vw;
    height: 40vw;
    background: radial-gradient(circle, var(--ai-sage) 0%, transparent 70%);
    animation-delay: -10s;
    animation-duration: 22s;
  }

  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(3%, 5%) scale(1.08); }
    100% { transform: translate(-2%, -3%) scale(0.95); }
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;
    width: min(100%, 86rem);
    margin: 0 auto;
    padding: 6rem 2.5rem;
  }

  .home-hero__content {
    max-width: 62rem;
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(3.2rem, 5.8vw, 4.8rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 850;
    color: var(--ai-fg);
  }

  .gradient-text-band {
    display: block;
    margin-top: 1rem;
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 30%, #a78bfa 60%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  :root[data-theme="light"] .gradient-text-band {
    background: linear-gradient(135deg, #1A73E8 0%, #7C3AED 45%, #E0533C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .home-hero__intro {
    max-width: 44rem;
    margin: 2rem 0 0;
    color: var(--ai-fg-muted);
    font-size: clamp(1.1rem, 1.8vw, 1.25rem);
    line-height: 1.75;
    letter-spacing: -0.01em;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 720px) {
    .home-hero {
      min-height: auto;
    }

    .home-hero__inner {
      padding: 5rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow-orb {
      animation: none;
    }
  }
</style>
