---
import { Image } from 'astro:assets';
import { ArrowRight } from 'lucide-astro';
import { getSocietyById } from '@surreysocieties/admin/config';
import book from '../../assets/generated/illustrated/book.webp';
import speech from '../../assets/generated/illustrated/speech.webp';
import blocks from '../../assets/generated/illustrated/blocks.webp';
const society = getSocietyById('ai')!;
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__inner">
    <Image class="home-hero__book" src={book} width={420} alt="" loading="eager" />
    <Image class="home-hero__speech" src={speech} width={360} alt="" loading="eager" />
    <Image class="home-hero__blocks" src={blocks} width={280} alt="" loading="eager" />
    <div class="home-hero__copy">
      <h1 id="home-hero-title" class="home-hero__title"><span>Learn it.</span><span>Build it.</span><span>Question it.</span></h1>
      <p class="home-hero__intro">Explore AI with other Surrey students. Every degree welcome.</p>
      <div class="home-hero__actions" data-hero-actions>
        <a class="flow-button flow-button--orange" href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer">Join the society <ArrowRight aria-hidden="true" size={21} /></a>
        <a class="flow-button flow-button--paper" href="#programme">Explore events <ArrowRight aria-hidden="true" size={21} /></a>
      </div>
    </div>
  </div>
</section>
<style>
.home-hero { background:#111; color:#faf8f3; border-radius:0 0 50% 50% / 0 0 54px 54px; }
.home-hero__inner { position:relative; width:min(1360px,96%); margin:auto; padding:22px 0 50px; }
.home-hero__copy { position:relative; z-index:1; text-align:center; }
.home-hero__title { margin:0; font:800 clamp(76px,7.7vw,110px)/.78 'Baloo 2',ui-rounded,sans-serif; letter-spacing:-.045em; }
.home-hero__title span { display:block; }
.home-hero__title span:first-child { transform:rotate(-3deg); }
.home-hero__title span:nth-child(2) { transform:rotate(2deg); }
.home-hero__title span:last-child { color:#ff4a00; margin-top:4px; }
.home-hero__intro { margin:22px 0 0; font-size:20px; line-height:1.5; letter-spacing:-.025em; }
.home-hero__actions { display:flex; justify-content:center; gap:16px; margin-top:20px; }
.home-hero__inner > img { position:absolute; height:auto; pointer-events:none; }
.home-hero__book { width:25%; left:0; top:30px; transform:rotate(-8deg); }
.home-hero__speech { width:22%; right:0; top:8px; transform:rotate(5deg); }
.home-hero__blocks { width:17%; right:1%; bottom:40px; }
@media (max-width:1100px) and (min-width:701px) {
 .home-hero__title { font-size:9.6vw; }
 .home-hero__intro { font-size:17px; }
 .home-hero__inner { padding-top:42px; }
 .home-hero__book { top:74px; width:23%; }
 .home-hero__blocks { width:15%; bottom:60px; }
}
@media (max-width:700px) {
 .home-hero { border-bottom-left-radius:50% 24px; border-bottom-right-radius:50% 24px; }
 .home-hero__inner { width:calc(100% - 32px); padding:148px 0 48px; }
 .home-hero__title { font-size:clamp(52px,12.8vw,88px); line-height:.94; }
 .home-hero__intro { max-width:32ch; margin:22px auto 0; font-size:16px; }
 .home-hero__book { width:150px; left:calc(50% - 155px); top:8px; }
 .home-hero__speech { width:142px; right:calc(50% - 150px); top:8px; }
 .home-hero__blocks { width:70px; right:calc(50% - 155px); top:85px; bottom:auto; }
 .home-hero__actions { gap:10px; margin-top:22px; }
 .home-hero__actions :global(.flow-button) { padding:12px; font-size:14px; gap:8px; white-space:nowrap; }
}
@media (max-width:380px) {
 .home-hero__actions { flex-direction:column; width:min(280px,100%); margin-inline:auto; }
 .home-hero__title { font-size:12.8vw; }
 .home-hero__book { width:130px; left:calc(50% - 134px); }
 .home-hero__speech { width:122px; right:calc(50% - 130px); }
 .home-hero__blocks { width:60px; right:calc(50% - 130px); }
}
</style>
