---
import BackgroundVideo from "@surreysocieties/ui/components/BackgroundVideo";
---

<section class="bg-ai-bg text-ai-fg relative overflow-hidden flex items-center min-h-[85vh] border-b border-ai-border">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 relative z-10 w-full">
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(400px,1fr)] gap-12 lg:gap-16 items-center">
      <div class="flex flex-col items-start max-w-2xl">
        <span class="text-ai-cyan font-semibold text-sm sm:text-base mb-4 block" aria-hidden="true">
          University of Surrey
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] mb-6">
          Empowering Students in <span class="text-ai-cyan">Artificial Intelligence</span>
        </h1>
        <p class="text-ai-fg-muted text-lg leading-relaxed max-w-xl mb-10">
          We are a student-led community dedicated to learning, building, and discussing artificial intelligence. Open to every discipline and experience level.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a
            href="/join"
            class="px-8 py-3.5 bg-ai-cyan hover:opacity-90 text-white font-semibold rounded-lg transition-colors text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ai-cyan"
          >
            Join the Society
          </a>
          <a
            href="#events"
            class="px-8 py-3.5 bg-ai-surface hover:bg-ai-border text-ai-fg font-medium rounded-lg border border-ai-border transition-colors text-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ai-cyan"
          >
            View Events
          </a>
        </div>
      </div>
      
      <div class="relative w-full aspect-video lg:aspect-[4/3] rounded-2xl overflow-hidden shadow-xl ring-1 ring-ai-border">
        <BackgroundVideo
          src="/videos/optimized/ai-hero.optimized.mp4"
          webmSrc="/videos/optimized/ai-hero.optimized.webm"
          poster="/videos/posters/ai-hero.poster.jpg"
          objectPosition="center center"
        />
      </div>
    </div>
  </div>
</section>

