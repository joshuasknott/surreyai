---
import { Image } from "astro:assets";
import homeStudyCutout from "../../assets/generated/ai-home-study-cutout.png";
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__art" aria-hidden="true">
    <div class="home-hero__art-glow"></div>
    <Image
      src={homeStudyCutout}
      alt=""
      widths={[720, 1080, 1440, 1800]}
      sizes="(min-width: 900px) 58vw, 100vw"
      class="home-hero__image"
      loading="eager"
      format="webp"
    />
  </div>
  <svg class="home-hero__signal" viewBox="0 0 1400 760" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 542 C178 472 292 588 450 502 S710 342 892 416 1140 548 1400 392" />
    <path d="M118 650 C264 572 394 624 522 548 S772 396 938 474 1180 596 1368 474" />
    <circle cx="450" cy="502" r="5" />
    <circle cx="892" cy="416" r="7" />
    <circle cx="1164" cy="486" r="5" />
  </svg>
  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <h1 id="home-hero-title" class="home-hero__title">
        Surrey AI and Data Science Society
      </h1>
      <p class="home-hero__intro">
        A student community for exploring artificial intelligence, machine learning, and data science through practical workshops, projects, competitions, and responsible discussion.
      </p>
      <p class="home-hero__domains">Beginner-friendly learning / hands-on projects / hackathons / responsible AI / careers</p>
      <div class="home-hero__actions">
        <a href="/join" class="btn-primary">Join the Society</a>
        <a href="#projects" class="btn-secondary">See Projects</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    display: flex;
    min-height: min(760px, calc(100svh - 5rem));
    align-items: center;
    overflow: clip;
    padding: clamp(4.5rem, 7vw, 6.75rem) 1.25rem clamp(4rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--ai-border);
    background:
      radial-gradient(circle at 84% 28%, color-mix(in srgb, var(--ai-azure) 16%, transparent), transparent 24rem),
      radial-gradient(circle at 70% 80%, color-mix(in srgb, var(--ai-coral) 12%, transparent), transparent 22rem),
      linear-gradient(90deg, var(--ai-bg) 0%, color-mix(in srgb, var(--ai-surface) 68%, var(--ai-bg)) 100%);
    color: var(--ai-fg);
    isolation: isolate;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, var(--ai-bg) 0%, color-mix(in srgb, var(--ai-bg) 92%, transparent) 38%, transparent 72%),
      linear-gradient(0deg, var(--ai-bg) 0%, transparent 34%);
    pointer-events: none;
  }

  .home-hero__art {
    position: absolute;
    inset: clamp(1rem, 4vw, 3rem) max(-9rem, -8vw) -2rem 43%;
    z-index: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .home-hero__art-glow {
    position: absolute;
    inset: 14% 8% 4%;
    border-radius: 999px;
    background:
      radial-gradient(ellipse at 56% 48%, color-mix(in srgb, var(--ai-azure) 22%, transparent), transparent 60%),
      radial-gradient(ellipse at 42% 70%, color-mix(in srgb, var(--ai-coral) 16%, transparent), transparent 55%);
    filter: blur(18px);
  }

  .home-hero__image {
    position: relative;
    z-index: 1;
    width: min(100%, 58rem);
    height: auto;
    filter: drop-shadow(0 42px 58px rgba(17, 24, 39, 0.18));
    animation: hero-float 8s ease-in-out infinite;
  }

  .home-hero__signal {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.7;
  }

  :global(:root[data-theme="dark"]) .home-hero__signal {
    mix-blend-mode: screen;
    opacity: 0.82;
  }

  .home-hero__signal path {
    fill: none;
    stroke: color-mix(in srgb, var(--ai-azure) 58%, transparent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 18 22;
    animation: hero-signal 8s linear infinite;
  }

  .home-hero__signal path + path {
    stroke: color-mix(in srgb, var(--ai-coral) 46%, transparent);
    animation-duration: 10s;
    animation-direction: reverse;
  }

  .home-hero__signal circle {
    fill: color-mix(in srgb, var(--ai-coral) 80%, #ffffff);
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--ai-coral) 55%, transparent));
    animation: hero-node 2.8s ease-in-out infinite;
  }

  .home-hero__inner {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 82rem;
    margin: 0 auto;
  }

  .home-hero__copy {
    max-width: 46rem;
  }

  .home-hero__title {
    max-width: 15ch;
    margin: 0 0 1.15rem;
    color: var(--ai-fg);
    font-size: clamp(2.35rem, 5vw, 4.85rem);
    font-weight: 850;
    line-height: 1.03;
    letter-spacing: 0;
  }

  .home-hero__intro {
    max-width: 38rem;
    color: var(--ai-fg-muted);
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    line-height: 1.55;
  }

  .home-hero__domains {
    max-width: 40rem;
    margin: 1.35rem 0 0;
    color: color-mix(in srgb, var(--ai-fg) 74%, var(--ai-fg-muted));
    font-size: 0.96rem;
    font-weight: 800;
    line-height: 1.6;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.9rem;
  }

  @keyframes hero-float {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    50% { transform: translate3d(0, -0.55rem, 0) rotate(0.4deg); }
  }

  @keyframes hero-signal {
    to {
      stroke-dashoffset: -160;
    }
  }

  @keyframes hero-node {
    0%, 100% { opacity: 0.38; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  @media (max-width: 980px) {
    .home-hero {
      min-height: auto;
      padding-top: 4.25rem;
    }

    .home-hero::after {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--ai-bg) 98%, transparent) 0%, color-mix(in srgb, var(--ai-bg) 82%, transparent) 58%, color-mix(in srgb, var(--ai-bg) 48%, transparent) 100%);
    }

    .home-hero__art {
      inset: 3.5rem -12rem -2rem 18%;
      opacity: 0.36;
    }

    .home-hero__title {
      max-width: 14ch;
      font-size: clamp(2.2rem, 10vw, 3.7rem);
    }
  }

  @media (max-width: 560px) {
    .home-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__image,
    .home-hero__signal path,
    .home-hero__signal circle {
      animation: none;
    }
  }
</style>
