---
---

<section class="bg-ai-bg text-ai-fg relative overflow-hidden flex items-center border-b border-ai-border">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32 relative z-10 w-full">
    <div class="grid lg:grid-cols-[1fr_minmax(340px,520px)] gap-12 lg:gap-16 items-center">
      <div class="flex flex-col items-start max-w-2xl">
        <span class="text-ai-cyan font-semibold text-xs uppercase tracking-widest mb-4 block" aria-hidden="true">
          University of Surrey
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] mb-6">
          Empowering Students in <span class="text-ai-cyan">Artificial Intelligence</span>
        </h1>
        <p class="text-ai-fg-muted text-lg leading-relaxed max-w-xl mb-10">
          We are a student-led community dedicated to learning, building, and discussing artificial intelligence. Open to every discipline and experience level.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a href="/join" class="btn-primary text-center">
            Join the Society
          </a>
          <a href="#events" class="btn-secondary text-center">
            View Events
          </a>
        </div>
      </div>
      
      <div class="relative w-full aspect-video lg:aspect-[4/3] rounded-2xl overflow-hidden shadow-xl ring-1 ring-ai-border bg-ai-surface flex items-center justify-center">
        <!-- Abstract signal/grid motif -->
        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, var(--ai-cyan) 1px, transparent 0); background-size: 24px 24px;"></div>
        <svg class="w-1/2 h-1/2 text-ai-cyan opacity-80" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M50 10 L90 50 L50 90 L10 50 L50 10Z" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" />
          <circle cx="50" cy="50" r="20" stroke="var(--ai-purple)" stroke-width="2" />
          <circle cx="50" cy="50" r="4" fill="currentColor" class="animate-pulse" />
        </svg>
      </div>
    </div>
  </div>
</section>
