---
import { getImage } from "astro:assets";
import campusHero from "../../assets/generated/ai-surrey-campus-signal-sketch-hero.optimized.webp";

const heroImage = await getImage({
  src: campusHero,
  width: 1800,
  format: "webp",
  quality: 72,
});
---

<section
  class="home-hero"
  aria-labelledby="home-hero-title"
  style={`--home-hero-image: url(${heroImage.src})`}
>
  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <h1 id="home-hero-title" class="home-hero__title">
        Surrey Artificial Intelligence Society
      </h1>
      <p class="home-hero__intro">
        Welcome to the online home for Surrey students curious about artificial intelligence, machine learning, data science, and responsible technology.
      </p>
      <p class="home-hero__domains">
        Beginner-friendly learning / workshops / community updates / responsible artificial intelligence / careers
      </p>

      <div class="home-hero__actions">
        <a href="/join" class="btn-primary">Join the Society</a>
        <a href="#events" class="btn-secondary">See events</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: clip;
    min-height: clamp(42rem, 72svh, 56rem);
    color: var(--ai-fg);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-paper) 98%, transparent) 0%, color-mix(in srgb, var(--ai-paper) 88%, transparent) 32%, color-mix(in srgb, var(--ai-paper) 24%, transparent) 62%, transparent 100%),
      linear-gradient(0deg, color-mix(in srgb, var(--ai-paper) 94%, transparent) 0%, transparent 24%),
      var(--home-hero-image) center right / cover no-repeat,
      var(--ai-paper);
    border-bottom: 1px solid color-mix(in srgb, var(--ai-fg) 18%, var(--ai-bg));
    isolation: isolate;
  }

  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 87% 42%, color-mix(in srgb, var(--ai-azure) 16%, transparent), transparent 18rem),
      linear-gradient(115deg, transparent 0 18%, color-mix(in srgb, var(--ai-azure) 14%, transparent) 18.08% 18.18%, transparent 18.28% 100%),
      linear-gradient(132deg, transparent 0 74%, color-mix(in srgb, var(--ai-coral) 16%, transparent) 74.08% 74.18%, transparent 74.28% 100%);
    opacity: 0.72;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 0;
    height: 26%;
    pointer-events: none;
    background: linear-gradient(0deg, var(--ai-bg), transparent);
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: center;
    width: min(100%, 82rem);
    min-height: clamp(42rem, 72svh, 56rem);
    margin: 0 auto;
    padding: clamp(3.25rem, 7vw, 6.5rem) 1.25rem clamp(4rem, 7vw, 5.75rem);
  }

  .home-hero__copy {
    max-width: 42.5rem;
  }

  .home-hero__kicker {
    margin: 0 0 1.05rem;
    color: var(--ai-azure);
    font-size: 0.8rem;
    line-height: 1.25;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-hero__title {
    max-width: 14ch;
    margin: 0;
    color: var(--ai-fg);
    font-size: clamp(3rem, 5.4vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: 0;
    font-weight: 850;
    text-wrap: balance;
  }

  .home-hero__intro {
    max-width: 35rem;
    margin: 1.35rem 0 0;
    color: var(--ai-fg-muted);
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    line-height: 1.62;
    letter-spacing: 0;
  }

  .home-hero__domains {
    max-width: 36rem;
    margin: 1.25rem 0 0;
    color: color-mix(in srgb, var(--ai-sage) 78%, var(--ai-fg));
    font-size: 1rem;
    font-style: italic;
    font-weight: 800;
    line-height: 1.6;
    letter-spacing: 0;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.8rem;
  }

  .home-hero__actions .btn-primary,
  .home-hero__actions .btn-secondary {
    min-height: 3.15rem;
  }

  :global(:root[data-theme="dark"]) .home-hero {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-bg) 98%, transparent) 0%, color-mix(in srgb, var(--ai-bg) 90%, transparent) 36%, color-mix(in srgb, var(--ai-bg) 40%, transparent) 72%, transparent 100%),
      linear-gradient(0deg, color-mix(in srgb, var(--ai-bg) 96%, transparent) 0%, transparent 30%),
      var(--home-hero-image) center right / cover no-repeat,
      var(--ai-bg);
  }

  @media (max-width: 760px) {
    .home-hero {
      min-height: min(44rem, calc(100svh - 5rem));
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--ai-paper) 64%, transparent) 0%, color-mix(in srgb, var(--ai-paper) 78%, transparent) 43%, var(--ai-bg) 100%),
        linear-gradient(90deg, color-mix(in srgb, var(--ai-paper) 78%, transparent) 0%, color-mix(in srgb, var(--ai-paper) 36%, transparent) 63%, transparent 100%),
        var(--home-hero-image) 64% top / auto 58% no-repeat,
        var(--ai-paper);
    }

    .home-hero__inner {
      min-height: inherit;
      padding: clamp(11rem, 44vw, 15rem) 1.2rem 2.35rem;
      align-items: end;
    }

    .home-hero__copy {
      max-width: 34rem;
      margin-inline: auto;
      text-align: center;
    }

    .home-hero__kicker {
      margin-bottom: 0.7rem;
      font-size: 0.7rem;
    }

    .home-hero__title {
      max-width: 12ch;
      margin-inline: auto;
      font-size: clamp(2.45rem, 12vw, 3.4rem);
      line-height: 1;
    }

    .home-hero__intro {
      margin-top: 1rem;
      margin-inline: auto;
      font-size: 1rem;
      line-height: 1.48;
    }

    .home-hero__domains {
      margin-top: 0.9rem;
      margin-inline: auto;
      font-size: 0.88rem;
      line-height: 1.45;
    }

    .home-hero__actions {
      margin-top: 1.2rem;
      gap: 0.6rem;
      justify-content: center;
      margin-inline: auto;
      max-width: 24rem;
    }

    .home-hero__actions .btn-primary,
    .home-hero__actions .btn-secondary {
      width: 100%;
      min-height: 2.85rem;
      padding: 0.85rem 1rem;
    }
  }

  @media (max-width: 760px) {
    :global(:root[data-theme="dark"]) .home-hero {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--ai-bg) 66%, transparent) 0%, color-mix(in srgb, var(--ai-bg) 80%, transparent) 48%, var(--ai-bg) 100%),
        linear-gradient(90deg, color-mix(in srgb, var(--ai-bg) 86%, transparent) 0%, color-mix(in srgb, var(--ai-bg) 42%, transparent) 66%, transparent 100%),
        var(--home-hero-image) 64% top / auto 58% no-repeat,
        var(--ai-bg);
    }
  }

  @media (max-width: 380px) {
    .home-hero__domains {
      display: none;
    }
  }
</style>
