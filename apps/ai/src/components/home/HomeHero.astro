---
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__bg"></div>

  <div class="home-hero__inner">
    <div class="home-hero__content">
      <h1 id="home-hero-title" class="home-hero__title">
        Surrey Artificial Intelligence Society.
        <span class="block mt-4 text-ai-fg-muted font-medium text-3xl sm:text-5xl tracking-tight leading-[1.1]">We learn, build, and debate the systems shaping the future.</span>
      </h1>
      
      <div class="home-hero__actions">
        <a href="#explore" class="btn-secondary">Explore our focus areas</a>
        <a href="/join" class="btn-primary">Join the Society</a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    align-items: center;
    color: var(--ai-fg);
  }

  .home-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--ai-bg);
    overflow: hidden;
  }
  
  /* Abstract slow-moving color gradient */
  .home-hero__bg::before,
  .home-hero__bg::after {
    content: "";
    position: absolute;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: float 20s infinite ease-in-out alternate;
  }

  .home-hero__bg::before {
    background: var(--ai-coral);
    top: -10vw;
    right: -10vw;
    animation-delay: -5s;
  }

  .home-hero__bg::after {
    background: var(--ai-azure);
    bottom: -10vw;
    left: -10vw;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 86rem);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .home-hero__content {
    max-width: 60rem;
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 800;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(5vw, 5vw) scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__bg::before,
    .home-hero__bg::after {
      animation: none;
    }
  }
</style>
