<section class="bg-navy text-text-on-dark py-20 sm:py-28 px-6 relative overflow-hidden border-t-2 border-accent-blue/30">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(91,142,219,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(91,142,219,0.04)_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(6,182,212,0.08),transparent_40%)] pointer-events-none"></div>

  <div class="mx-auto max-w-3xl text-center relative z-10">
    <div class="inline-flex items-center gap-3 mb-6 border border-accent-blue/30 px-3 py-1.5 bg-accent-blue/10">
      <div class="w-2 h-2 bg-accent-blue"></div>
      <span class="text-accent-blue text-xs font-bold uppercase tracking-widest">Get Involved</span>
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-6">
      Ready to Get Involved?
    </h2>
    <p class="text-text-on-dark-secondary text-lg mb-10 max-w-xl mx-auto leading-relaxed border-l-2 border-accent-blue/40 pl-4 text-left">
      Whether you're studying computer science, business, psychology, or
      anything else &mdash; if you're curious about AI, you're welcome here.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/join"
        class="px-10 py-4 bg-accent-blue hover:bg-accent-blue-dark text-white font-bold uppercase tracking-wide text-sm transition-all duration-200 border border-accent-blue hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-accent-blue-light)] text-center"
      >
        Join Surrey AI Society
      </a>
      <a
        href="/events"
        class="px-10 py-4 bg-transparent hover:bg-surface-card text-text-on-dark font-bold uppercase tracking-wide text-sm border border-border-strong transition-all duration-200 hover:shadow-[0_0_15px_rgba(139,92,246,0.3)] text-center"
      >
        View Events
      </a>
    </div>
  </div>
</section>
