---
import BrandMark from "../common/BrandMark.astro";
---

<section class="ai-section join-strip" aria-labelledby="join-strip-title">
  <div class="ai-section__inner join-strip__inner">
    <div class="join-strip__copy">
      <BrandMark size="small" />
      <h2 id="join-strip-title" class="section-title">Become a member</h2>
      <p class="section-intro">
        Become part of a student community preparing to launch a clearer home for artificial intelligence learning, events, resources, responsible discussion, and careers activity this September.
      </p>
    </div>
    <a href="/join" class="btn-primary">Join via Students' Union</a>
  </div>
</section>

<style>
  .join-strip {
    position: relative;
    border-top: 1px solid var(--ai-border);
    overflow: clip;
  }

  .join-strip::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 0 28%, color-mix(in srgb, var(--ai-azure) 10%, transparent) 28.2% 28.6%, transparent 28.8% 100%),
      linear-gradient(132deg, transparent 0 55%, color-mix(in srgb, var(--ai-sage) 12%, transparent) 55.2% 55.6%, transparent 55.8% 100%);
    pointer-events: none;
  }

  .join-strip__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .join-strip__copy {
    display: grid;
    gap: 0.9rem;
  }

  @media (max-width: 760px) {
    .join-strip__inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
