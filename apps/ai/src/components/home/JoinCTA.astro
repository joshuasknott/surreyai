---
import { getSocietyById } from "@surreysocieties/admin/config";

const society = getSocietyById("ai")!;
---

<section id="join" class="join-strip" aria-labelledby="join-strip-title">
  <div class="join-strip__inner">
    <div class="join-strip__copy">
      <p class="section-number section-number--ink" aria-hidden="true">04</p>
      <h2 id="join-strip-title">Find your place in AI.</h2>
      <span>Join through Surrey Students' Union, then come along to a workshop, project session or social. All degrees and experience levels welcome.</span>
    </div>
    <div class="join-strip__actions">
      <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="join-strip__primary">Join through Students&apos; Union</a>
      <a href={`mailto:${society.contactEmail}`} class="join-strip__secondary">Ask us a question</a>
    </div>
  </div>
</section>

<style>
  .join-strip {
    padding: clamp(2rem, 4vw, 3.75rem) 1.25rem;
    border-top: 1px solid rgba(17, 17, 17, 0.18);
    background: #ff4a00;
    color: #111111;
  }

  .join-strip__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    width: min(100%, 82rem);
    margin: 0 auto;
  }

  .join-strip__copy > .section-number {
    margin: 0 0 0.65rem;
  }

  .join-strip__copy h2 {
    margin: 0;
    color: #111111;
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .join-strip__copy span {
    display: block;
    max-width: 38rem;
    margin-top: 0.9rem;
    color: rgba(17, 17, 17, 0.72);
    line-height: 1.55;
  }

  .join-strip__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .join-strip__actions a {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.35rem;
    border: 1px solid #111111;
    border-radius: 0.2rem;
    font-size: 0.88rem;
    font-weight: 850;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .join-strip__actions a:hover,
  .join-strip__actions a:focus-visible { transform: translateY(-2px); }

  .join-strip__primary { background: #111111; color: #faf8f3; }
  .join-strip__secondary { background: #faf8f3; color: #111111; }
  .join-strip__actions a:focus-visible { outline: 3px solid #111111; outline-offset: 4px; }

  @media (max-width: 840px) {
    .join-strip__inner { grid-template-columns: 1fr; }
    .join-strip__actions { width: 100%; }
  }

  @media (max-width: 540px) {
    .join-strip__actions { display: grid; }
    .join-strip__actions a { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .join-strip__actions a { transition: none; }
    .join-strip__actions a:hover,
    .join-strip__actions a:focus-visible { transform: none; }
  }
</style>
