---
import { Image } from "astro:assets";
import BrandMark from "../common/BrandMark.astro";
import racingHero from "../../assets/generated/ai-racing-simulator.optimized.webp";
---

<section class="drift-lab-section" aria-label="Student Project: Racing Simulator">
  <div class="drift-lab-inner">
    <div class="drift-lab-header">
      <span class="drift-lab-badge">Student Project</span>
      <h2 class="drift-lab-title">Racing Simulator</h2>
      <p class="drift-lab-subtitle">
        A quick campus-inspired racer where every rival has a different style.
      </p>
    </div>

    <div id="drift-lab-launcher" class="drift-lab-launcher">
      <header class="drift-lab-launcher__topbar">
        <div class="drift-lab-launcher__brand">
          <BrandMark size="small" />
          <div>
            <h2>Racing Simulator</h2>
            <p>Surrey Artificial Intelligence Society</p>
          </div>
        </div>
        <div class="drift-lab-launcher__specs" aria-label="Race format">
          <span>3 laps</span><i></i><span>5 cars</span><i></i><span>1 winner</span>
        </div>
      </header>

      <div class="drift-lab-launcher__main">
        <Image
          class="drift-lab-launcher__backdrop"
          src={racingHero}
          alt=""
          widths={[960, 1440, 1920]}
          sizes="100vw"
          format="webp"
          quality={86}
          loading="eager"
          aria-hidden="true"
        />
        <div class="drift-lab-launcher__veil" aria-hidden="true"></div>

        <div class="drift-lab-launcher__hero">
          <span class="drift-lab-launcher__eyebrow">Campus night race</span>
          <h2>Beat the grid.</h2>
          <p>Five cars. Three laps. Four rivals with their own strengths&mdash;and real consequences when you make contact.</p>
          <div class="drift-lab-launcher__features" aria-label="Game features">
            <span><i></i> Rivals with different styles</span>
            <span><i></i> Satisfying drifts</span>
            <span><i></i> Crashes have consequences</span>
          </div>
        </div>

        <aside class="drift-lab-lobby" aria-label="Starting grid and controls">
          <div class="drift-lab-lobby__head">
            <div><span>Starting grid</span><strong>You start P5</strong></div>
            <span class="drift-lab-lobby__live"><i></i> Rivals ready</span>
          </div>
          <div class="drift-lab-rivals">
            <span><i style="--rival:#38BDF8"></i><b>Nova</b><small>clean lines</small></span>
            <span><i style="--rival:#A78BFA"></i><b>Apex</b><small>late braker</small></span>
            <span><i style="--rival:#FBBF24"></i><b>Echo</b><small>steady racer</small></span>
            <span><i style="--rival:#34D399"></i><b>Flux</b><small>top speed</small></span>
          </div>
          <div class="drift-lab-lobby__controls drift-lab-lobby__controls--desktop">
            <span><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></span>
            <p>Accelerate, brake, and steer. You can also use the arrow keys.</p>
          </div>
          <div class="drift-lab-lobby__controls drift-lab-lobby__controls--mobile">
            <span class="mini-stick" aria-hidden="true"><span></span></span>
            <p>Use the steering stick with the gas and brake pedals.</p>
          </div>
          <button id="drift-lab-launch-btn" class="drift-lab-launch-btn" type="button">
            <span>Start race</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
          </button>
          <small class="drift-lab-lobby__hint">A 3&ndash;2&ndash;1 countdown starts on the grid.</small>
        </aside>
      </div>
    </div>

    <div id="drift-lab-game" class="drift-lab-game" hidden>
      <canvas id="drift-lab-canvas" width="960" height="540"></canvas>

      <div id="drift-lab-start" class="drift-lab-overlay">
        <div class="drift-lab-overlay-inner">
          <span class="drift-lab-mode">Campus AI challenge</span>
          <h3 class="drift-lab-game-title">Racing Simulator</h3>
          <p class="drift-lab-game-subtitle">Race three laps around a campus-inspired track while four rivals fight you for the lead.</p>
          <button id="drift-lab-play-btn" class="drift-lab-play-btn" type="button">
            Start Race
          </button>
          <div class="drift-lab-controls-info">
            <div class="drift-lab-key-row drift-lab-key-row--desktop">
              <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd>
              <span>or arrow keys</span>
            </div>
            <div class="drift-lab-key-row drift-lab-key-row--mobile">
              <span class="mini-stick" aria-hidden="true"><span></span></span>
              <span>Joystick steering plus gas and brake pedals.</span>
            </div>
          </div>
        </div>
      </div>

      <div id="drift-lab-countdown" class="drift-lab-countdown" hidden aria-live="assertive">
        <div class="drift-lab-start-lights" aria-hidden="true"><i></i><i></i><i></i></div>
        <strong id="drift-lab-countdown-label">3</strong>
        <span>Hold W to launch</span>
      </div>

      <div id="drift-lab-hud" class="drift-lab-hud" hidden>
        <div class="hud-left">
          <div class="hud-speed" id="drift-lab-speed">0 mph</div>
          <div class="hud-telemetry" id="drift-lab-telemetry">N 900 rpm</div>
          <div class="hud-lap" id="drift-lab-lap">Lap 1 / 3</div>
        </div>
        <div class="hud-center">
          <div class="hud-position" id="drift-lab-position">P5 / 5</div>
          <div class="hud-drift-label" id="drift-lab-drift-label">Grip limit</div>
          <div class="hud-drift" aria-label="Drift meter">
            <span id="drift-lab-grip"></span>
          </div>
        </div>
        <div class="hud-right">
          <div class="hud-time" id="drift-lab-time">0:00.00</div>
          <div class="hud-best" id="drift-lab-best">Best race: --:--.--</div>
          <div class="hud-damage" aria-label="Car damage">
            <span id="drift-lab-damage-label">Body 100%</span>
            <i><b id="drift-lab-damage"></b></i>
          </div>
        </div>
        <div class="hud-bottom">
          <button id="drift-lab-sound-btn" class="hud-sound" type="button" aria-label="Toggle sound">Sound: On</button>
          <button id="drift-lab-restart-btn" class="hud-restart" type="button" aria-label="Restart race">&#x21BA; Restart</button>
        </div>
      </div>

      <div class="drift-lab-game-actions">
        <button id="drift-lab-fullscreen-btn" class="drift-lab-fullscreen-btn" type="button" aria-label="Enter fullscreen">
          <svg class="fullscreen-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" /></svg>
          <svg class="fullscreen-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M20 15h-5v5M4 15h5v5" /></svg>
        </button>
      </div>

      <div id="drift-lab-impact" class="drift-lab-impact" hidden>Heavy contact</div>

      <div id="drift-lab-complete" class="drift-lab-overlay" hidden>
        <div class="drift-lab-overlay-inner">
          <span class="drift-lab-mode">Race complete</span>
          <h3 class="drift-lab-complete-title" id="drift-lab-result-title">Finished!</h3>
          <div class="drift-lab-complete-time" id="drift-lab-final-time">0:00.00</div>
          <div class="drift-lab-lap-breakdown" id="drift-lap-breakdown"></div>
          <div class="drift-lab-complete-best" id="drift-lab-final-best"></div>
          <button id="drift-lab-again-btn" class="drift-lab-play-btn" type="button">
            Race Again
          </button>
          <p class="drift-lab-complete-hint">Press Space or click to race again</p>
        </div>
      </div>

      <div id="drift-lab-mobile" class="drift-lab-mobile" hidden>
        <div class="mobile-joystick" id="drift-lab-joystick" aria-label="Steering joystick" role="application">
          <span class="mobile-joystick__ring" aria-hidden="true">
            <span class="mobile-joystick__thumb" id="drift-lab-joystick-thumb"></span>
          </span>
        </div>
        <div class="mobile-pedals" aria-label="Pedals">
          <button type="button" class="mobile-pedal mobile-pedal--brake" aria-label="Brake" data-key="down">Brake</button>
          <button type="button" class="mobile-pedal mobile-pedal--gas" aria-label="Accelerate" data-key="up">Gas</button>
        </div>
      </div>

      <noscript>
        <div class="drift-lab-nojs">
          <p>JavaScript is required to play Racing Simulator.</p>
        </div>
      </noscript>
    </div>

    <p class="drift-lab-note">
      A student-built racing simulator for quick play between workshops.
    </p>
  </div>
</section>

<style>
  .drift-lab-section {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--ai-paper) 78%, var(--ai-bg)), var(--ai-bg));
    color: var(--ai-fg);
    padding: 1.5rem 2rem;
    overflow: hidden;
  }

  .drift-lab-inner {
    max-width: 1400px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    min-height: 0;
    flex: 1;
  }

  .drift-lab-launcher {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    border-radius: 0;
    background: #07101b;
    color: #f8fafc;
    overflow: hidden;
  }

  .drift-lab-launcher[hidden] {
    display: none;
  }

  .drift-lab-launcher__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 4.25rem;
    padding: 0.75rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid rgba(255,255,255,.11);
    background: rgba(6, 12, 21, 0.88);
    flex: 0 0 auto;
    color: #f8fafc;
    backdrop-filter: blur(18px);
  }

  .drift-lab-launcher__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .drift-lab-launcher__brand :global(.brand-mark) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .drift-lab-launcher__brand > div {
    min-width: 0;
  }

  .drift-lab-launcher__brand h2 {
    margin: 0;
    color: #f8fafc;
    font-size: 1.25rem;
    font-weight: 850;
    line-height: 1.1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drift-lab-launcher__brand p {
    margin: 0.15rem 0 0;
    color: rgba(226,232,240,.58);
    font-size: 0.78rem;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drift-lab-launcher__main {
    position: relative;
    display: grid;
    grid-template-columns: minmax(20rem, 1.15fr) minmax(19rem, 0.72fr);
    gap: clamp(2rem, 5vw, 5rem);
    flex: 1;
    min-height: 0;
    align-items: end;
    padding: clamp(2rem, 5vw, 4.8rem);
    isolation: isolate;
  }

  .drift-lab-launcher__specs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(226,232,240,.62);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .drift-lab-launcher__specs i {
    width: 0.22rem;
    height: 0.22rem;
    border-radius: 50%;
    background: #5fd2c7;
  }

  .drift-lab-launcher__backdrop,
  .drift-lab-launcher__veil {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .drift-lab-launcher__backdrop {
    object-fit: cover;
    object-position: center 55%;
    filter: saturate(.84) contrast(1.1) brightness(.56);
    transform: scale(1.015);
  }

  .drift-lab-launcher__veil {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(4,9,17,.94) 0%, rgba(4,9,17,.72) 48%, rgba(4,9,17,.44) 100%),
      linear-gradient(0deg, rgba(4,9,17,.92), transparent 66%);
  }

  .drift-lab-launcher__hero { align-self: center; max-width: 42rem; }

  .drift-lab-launcher__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #63d8c7;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .drift-lab-launcher__eyebrow::before {
    width: 2rem;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .drift-lab-launcher__hero h2 {
    max-width: 9ch;
    margin: 0.8rem 0 1rem;
    color: #f8fafc;
    font-size: clamp(3rem, 6.2vw, 6.3rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: .88;
  }

  .drift-lab-launcher__hero > p {
    max-width: 39rem;
    margin: 0;
    color: rgba(226,232,240,.72);
    font-size: clamp(.9rem, 1.35vw, 1.04rem);
    line-height: 1.65;
  }

  .drift-lab-launcher__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1.45rem;
  }

  .drift-lab-launcher__features span {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: rgba(241,245,249,.68);
    font-size: .7rem;
    font-weight: 750;
  }

  .drift-lab-launcher__features i {
    width: .38rem;
    height: .38rem;
    border-radius: 50%;
    background: #ff8a72;
    box-shadow: 0 0 0 .22rem rgba(255,138,114,.12);
  }

  .drift-lab-lobby {
    align-self: center;
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 2.5vw, 1.45rem);
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 18px;
    background: rgba(7, 13, 23, .74);
    box-shadow: 0 28px 80px rgba(0,0,0,.32);
    backdrop-filter: blur(18px);
  }

  .drift-lab-lobby__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .85rem;
    border-bottom: 1px solid rgba(255,255,255,.11);
  }

  .drift-lab-lobby__head > div { display: grid; gap: .18rem; }
  .drift-lab-lobby__head > div span { color: rgba(226,232,240,.5); font-size: .6rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .drift-lab-lobby__head strong { color: #fff; font-size: 1rem; }

  .drift-lab-lobby__live {
    display: inline-flex;
    align-items: center;
    gap: .42rem;
    color: #84e1d5;
    font-size: .62rem;
    font-weight: 800;
  }

  .drift-lab-lobby__live i { width: .4rem; height: .4rem; border-radius: 50%; background: #5ee3bd; box-shadow: 0 0 0 .24rem rgba(94,227,189,.12); }

  .drift-lab-rivals { display: grid; grid-template-columns: repeat(2, 1fr); gap: .55rem; }

  .drift-lab-rivals > span {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .05rem .48rem;
    align-items: center;
    padding: .65rem;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 10px;
    background: rgba(255,255,255,.035);
  }

  .drift-lab-rivals i { grid-row: 1 / 3; width: .55rem; height: 1.65rem; border-radius: 999px; background: var(--rival); box-shadow: 0 0 .8rem color-mix(in srgb, var(--rival) 55%, transparent); }
  .drift-lab-rivals b { color: #f8fafc; font-size: .76rem; }
  .drift-lab-rivals small { color: rgba(226,232,240,.48); font-size: .6rem; }

  .drift-lab-lobby__controls { display: grid; grid-template-columns: auto 1fr; gap: .7rem; align-items: center; }
  .drift-lab-lobby__controls > span { display: flex; gap: .22rem; }
  .drift-lab-lobby__controls kbd {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    border: 1px solid rgba(255,255,255,.19);
    border-radius: 6px;
    background: rgba(255,255,255,.08);
    color: #f8fafc;
    font: 800 .62rem/1 inherit;
    box-shadow: 0 2px 0 rgba(255,255,255,.12);
  }
  .drift-lab-lobby__controls p { margin: 0; color: rgba(226,232,240,.54); font-size: .65rem; line-height: 1.4; }
  .drift-lab-lobby__controls--mobile { display: none; }

  .drift-lab-launcher__instructions {
    display: grid;
    gap: 1rem;
    width: min(100%, 36rem);
  }

  .drift-lab-control-card {
    display: grid;
    gap: 0.8rem;
    justify-items: center;
    padding: 1rem;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--ai-surface) 88%, transparent), color-mix(in srgb, var(--ai-paper) 72%, transparent));
    text-align: center;
  }

  .control-card__title {
    color: var(--ai-azure);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .drift-lab-control-card p {
    margin: 0;
    color: var(--ai-fg-muted);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .control-keys {
    display: grid;
    grid-template-columns: repeat(3, 2.25rem);
    gap: 0.35rem;
  }

  .control-keys kbd,
  .drift-lab-controls-info kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.05rem;
    border: 1px solid var(--ai-border-strong);
    border-radius: 6px;
    background: var(--ai-paper);
    color: var(--ai-fg);
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 850;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--ai-border-strong) 55%, transparent);
  }

  .control-phone {
    display: grid;
    grid-template-columns: 4.5rem 3.2rem 3.7rem;
    align-items: end;
    gap: 0.7rem;
  }

  .control-phone__stick,
  .mini-stick {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid color-mix(in srgb, var(--ai-azure) 34%, var(--ai-border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-azure) 8%, var(--ai-surface));
  }

  .control-phone__stick span,
  .mini-stick span {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--ai-azure);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--ai-azure) 24%, transparent);
  }

  .control-phone__pedal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.6rem;
    padding-inline: 0.5rem;
    border-radius: 999px;
    color: var(--ai-accent-contrast);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .control-phone__pedal--brake {
    background: var(--ai-coral);
  }

  .control-phone__pedal--gas {
    min-height: 4.45rem;
    background: var(--ai-azure);
  }

  .drift-lab-control-card--mobile {
    display: none;
  }

  .drift-lab-launch-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.35rem;
    padding: 0.85rem 2rem;
    border: 1px solid #ff8069;
    border-radius: 11px;
    background: #ff8069;
    color: #111923;
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 850;
    transition: transform 0.2s, background-color 0.2s, color 0.2s, box-shadow 0.2s;
    box-shadow: 0 16px 38px rgba(255, 99, 76, .2);
  }

  .drift-lab-launch-btn svg { width: 1.15rem; height: 1.15rem; margin-left: auto; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }

  .drift-lab-launch-btn:hover {
    transform: translateY(-1px);
    background: #fff;
    border-color: #fff;
    color: #111923;
    box-shadow: 0 18px 44px rgba(0,0,0,.24);
  }

  .drift-lab-launch-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .drift-lab-lobby__hint { display: block; margin-top: -.35rem; color: rgba(226,232,240,.42); font-size: .59rem; text-align: center; }

  .drift-lab-header {
    text-align: left;
    margin-bottom: 0.85rem;
    flex: 0 0 auto;
  }

  .drift-lab-badge,
  .drift-lab-mode {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-azure) 12%, transparent);
    color: var(--ai-azure);
    border: 1px solid color-mix(in srgb, var(--ai-azure) 25%, transparent);
    margin-bottom: 0.5rem;
  }

  .drift-lab-mode {
    background: color-mix(in srgb, var(--ai-sage) 12%, var(--ai-paper));
    border-color: color-mix(in srgb, var(--ai-sage) 28%, transparent);
    color: var(--ai-sage);
    margin-bottom: 0.75rem;
  }

  .drift-lab-title {
    font-size: 1.8rem;
    font-weight: 850;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
    color: var(--ai-fg);
  }

  .drift-lab-subtitle {
    font-size: 0.95rem;
    color: var(--ai-fg-muted);
    max-width: 36rem;
    margin: 0;
    line-height: 1.45;
  }

  .drift-lab-game {
    position: relative;
