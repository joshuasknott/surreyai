---
import BrandMark from "../common/BrandMark.astro";
---

<section class="drift-lab-section" aria-label="Student Project: Racing Simulator">
  <div class="drift-lab-inner">
    <div class="drift-lab-header">
      <span class="drift-lab-badge">Student Project</span>
      <h2 class="drift-lab-title">Racing Simulator</h2>
      <p class="drift-lab-subtitle">
        A low-poly campus racer where you drift through corners while chasing AI drivers.
      </p>
    </div>

    <div id="drift-lab-launcher" class="drift-lab-launcher">
      <header class="drift-lab-launcher__topbar">
        <div class="drift-lab-launcher__brand">
          <BrandMark size="small" />
          <div>
            <h2>Racing Simulator</h2>
            <p>Surrey Artificial Intelligence Society</p>
          </div>
        </div>
      </header>

      <main class="drift-lab-launcher__main">
        <div class="drift-lab-launcher__instructions" aria-label="Controls">
          <div class="drift-lab-control-card drift-lab-control-card--desktop">
            <span class="control-card__title">Desktop controls</span>
            <div class="control-keys" aria-hidden="true">
              <span></span>
              <kbd>W</kbd>
              <span></span>
              <kbd>A</kbd>
              <kbd>S</kbd>
              <kbd>D</kbd>
            </div>
            <p>Steer with A/D or arrows. W accelerates, S brakes.</p>
          </div>
          <div class="drift-lab-control-card drift-lab-control-card--mobile">
            <span class="control-card__title">Mobile controls</span>
            <div class="control-phone" aria-hidden="true">
              <span class="control-phone__stick"><span></span></span>
              <span class="control-phone__pedal control-phone__pedal--brake">Brake</span>
              <span class="control-phone__pedal control-phone__pedal--gas">Gas</span>
            </div>
            <p>Drag the stick to steer. Hold gas to accelerate, brake to slow down.</p>
          </div>
        </div>
        <button id="drift-lab-launch-btn" class="drift-lab-launch-btn" type="button">
          Start Race
        </button>
      </main>
    </div>

    <div id="drift-lab-game" class="drift-lab-game" hidden>
      <canvas id="drift-lab-canvas" width="960" height="540"></canvas>

      <div id="drift-lab-start" class="drift-lab-overlay">
        <div class="drift-lab-overlay-inner">
          <span class="drift-lab-mode">Campus AI challenge</span>
          <h3 class="drift-lab-game-title">Racing Simulator</h3>
          <p class="drift-lab-game-subtitle">Race three laps around a campus-inspired circuit while AI drivers chase the line beside you.</p>
          <button id="drift-lab-play-btn" class="drift-lab-play-btn" type="button">
            Start Race
          </button>
          <div class="drift-lab-controls-info">
            <div class="drift-lab-key-row drift-lab-key-row--desktop">
              <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd>
              <span>or arrow keys</span>
            </div>
            <div class="drift-lab-key-row drift-lab-key-row--mobile">
              <span class="mini-stick" aria-hidden="true"><span></span></span>
              <span>Joystick steering plus gas and brake pedals.</span>
            </div>
          </div>
        </div>
      </div>

      <div id="drift-lab-hud" class="drift-lab-hud" hidden>
        <div class="hud-left">
          <div class="hud-speed" id="drift-lab-speed">0 mph</div>
          <div class="hud-telemetry" id="drift-lab-telemetry">N 900 rpm</div>
          <div class="hud-lap" id="drift-lab-lap">Lap 1 / 3</div>
        </div>
        <div class="hud-center">
          <div class="hud-position" id="drift-lab-position">P5 / 5</div>
          <div class="hud-drift-label" id="drift-lab-drift-label">Grip limit</div>
          <div class="hud-drift" aria-label="Drift meter">
            <span id="drift-lab-grip"></span>
          </div>
        </div>
        <div class="hud-right">
          <div class="hud-time" id="drift-lab-time">0:00.00</div>
          <div class="hud-best" id="drift-lab-best">Best race: --:--.--</div>
        </div>
        <div class="hud-bottom">
          <button id="drift-lab-sound-btn" class="hud-sound" type="button" aria-label="Toggle sound">Sound: On</button>
          <button id="drift-lab-restart-btn" class="hud-restart" type="button" aria-label="Restart race">&#x21BA; Restart</button>
        </div>
      </div>

      <div class="drift-lab-game-actions">
        <button id="drift-lab-fullscreen-btn" class="drift-lab-fullscreen-btn" type="button" aria-label="Enter fullscreen">
          Full screen
        </button>
      </div>

      <div id="drift-lab-complete" class="drift-lab-overlay" hidden>
        <div class="drift-lab-overlay-inner">
          <span class="drift-lab-mode">Race complete</span>
          <h3 class="drift-lab-complete-title" id="drift-lab-result-title">Finished!</h3>
          <div class="drift-lab-complete-time" id="drift-lab-final-time">0:00.00</div>
          <div class="drift-lab-lap-breakdown" id="drift-lap-breakdown"></div>
          <div class="drift-lab-complete-best" id="drift-lab-final-best"></div>
          <button id="drift-lab-again-btn" class="drift-lab-play-btn" type="button">
            Race Again
          </button>
          <p class="drift-lab-complete-hint">Press Space or click to race again</p>
        </div>
      </div>

      <div id="drift-lab-mobile" class="drift-lab-mobile" hidden>
        <div class="mobile-joystick" id="drift-lab-joystick" aria-label="Steering joystick" role="application">
          <span class="mobile-joystick__ring" aria-hidden="true">
            <span class="mobile-joystick__thumb" id="drift-lab-joystick-thumb"></span>
          </span>
        </div>
        <div class="mobile-pedals" aria-label="Pedals">
          <button type="button" class="mobile-pedal mobile-pedal--brake" aria-label="Brake" data-key="down">Brake</button>
          <button type="button" class="mobile-pedal mobile-pedal--gas" aria-label="Accelerate" data-key="up">Gas</button>
        </div>
      </div>

      <noscript>
        <div class="drift-lab-nojs">
          <p>JavaScript is required to play Racing Simulator.</p>
        </div>
      </noscript>
    </div>

    <p class="drift-lab-note">
      A student-built racing simulator for quick play between workshops.
    </p>
  </div>
</section>

<style>
  .drift-lab-section {
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--ai-paper) 78%, var(--ai-bg)), var(--ai-bg));
    color: var(--ai-fg);
    padding: 1.5rem 2rem;
    overflow: hidden;
  }

  .drift-lab-inner {
    max-width: 1400px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    min-height: 0;
    flex: 1;
  }

  .drift-lab-launcher {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    border-radius: 0;
    background: var(--ai-surface);
    color: var(--ai-fg);
    overflow: hidden;
  }

  .drift-lab-launcher[hidden] {
    display: none;
  }

  .drift-lab-launcher__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 4.25rem;
    padding: 0.75rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--ai-border);
    background: color-mix(in srgb, var(--ai-surface) 96%, transparent);
    flex: 0 0 auto;
  }

  .drift-lab-launcher__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .drift-lab-launcher__brand :global(.brand-mark) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .drift-lab-launcher__brand > div {
    min-width: 0;
  }

  .drift-lab-launcher__brand h2 {
    margin: 0;
    color: var(--ai-fg);
    font-size: 1.25rem;
    font-weight: 850;
    line-height: 1.1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drift-lab-launcher__brand p {
    margin: 0.15rem 0 0;
    color: var(--ai-fg-muted);
    font-size: 0.78rem;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drift-lab-launcher__main {
    display: grid;
    gap: clamp(1.2rem, 3vw, 1.8rem);
    flex: 1;
    min-height: 0;
    place-items: center;
    padding: 2rem 1.5rem;
  }

  .drift-lab-launcher__instructions {
    display: grid;
    gap: 1rem;
    width: min(100%, 36rem);
  }

  .drift-lab-control-card {
    display: grid;
    gap: 0.8rem;
    justify-items: center;
    padding: 1rem;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    background:
      linear-gradient(140deg, color-mix(in srgb, var(--ai-surface) 88%, transparent), color-mix(in srgb, var(--ai-paper) 72%, transparent));
    text-align: center;
  }

  .control-card__title {
    color: var(--ai-azure);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .drift-lab-control-card p {
    margin: 0;
    color: var(--ai-fg-muted);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .control-keys {
    display: grid;
    grid-template-columns: repeat(3, 2.25rem);
    gap: 0.35rem;
  }

  .control-keys kbd,
  .drift-lab-controls-info kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2.05rem;
    border: 1px solid var(--ai-border-strong);
    border-radius: 6px;
    background: var(--ai-paper);
    color: var(--ai-fg);
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 850;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--ai-border-strong) 55%, transparent);
  }

  .control-phone {
    display: grid;
    grid-template-columns: 4.5rem 3.2rem 3.7rem;
    align-items: end;
    gap: 0.7rem;
  }

  .control-phone__stick,
  .mini-stick {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px solid color-mix(in srgb, var(--ai-azure) 34%, var(--ai-border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-azure) 8%, var(--ai-surface));
  }

  .control-phone__stick span,
  .mini-stick span {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--ai-azure);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--ai-azure) 24%, transparent);
  }

  .control-phone__pedal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.6rem;
    padding-inline: 0.5rem;
    border-radius: 999px;
    color: var(--ai-accent-contrast);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .control-phone__pedal--brake {
    background: var(--ai-coral);
  }

  .control-phone__pedal--gas {
    min-height: 4.45rem;
    background: var(--ai-azure);
  }

  .drift-lab-control-card--mobile {
    display: none;
  }

  .drift-lab-launch-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 10rem;
    min-height: 3rem;
    padding: 0.85rem 2rem;
    border: 1px solid var(--ai-fg);
    border-radius: 8px;
    background: var(--ai-fg);
    color: var(--ai-bg);
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 850;
    transition: transform 0.2s, background-color 0.2s, color 0.2s, box-shadow 0.2s;
    box-shadow: 0 16px 38px color-mix(in srgb, var(--ai-slate-base) 10%, transparent);
  }

  .drift-lab-launch-btn:hover {
    transform: translateY(-1px);
    background: var(--ai-azure);
    border-color: var(--ai-azure);
    color: var(--ai-accent-contrast);
    box-shadow: 0 18px 44px color-mix(in srgb, var(--ai-azure) 20%, transparent);
  }

  .drift-lab-launch-btn:focus-visible {
    outline: 2px solid var(--ai-azure);
    outline-offset: 3px;
  }

  .drift-lab-header {
    text-align: left;
    margin-bottom: 0.85rem;
    flex: 0 0 auto;
  }

  .drift-lab-badge,
  .drift-lab-mode {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-azure) 12%, transparent);
    color: var(--ai-azure);
    border: 1px solid color-mix(in srgb, var(--ai-azure) 25%, transparent);
    margin-bottom: 0.5rem;
  }

  .drift-lab-mode {
    background: color-mix(in srgb, var(--ai-sage) 12%, var(--ai-paper));
    border-color: color-mix(in srgb, var(--ai-sage) 28%, transparent);
    color: var(--ai-sage);
    margin-bottom: 0.75rem;
  }

  .drift-lab-title {
    font-size: 1.8rem;
    font-weight: 850;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
    color: var(--ai-fg);
  }

  .drift-lab-subtitle {
    font-size: 0.95rem;
    color: var(--ai-fg-muted);
    max-width: 36rem;
    margin: 0;
    line-height: 1.45;
  }

  .drift-lab-game {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 0;
    max-height: calc(100% - 100px);
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--ai-border-strong);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--ai-slate-base) 12%, transparent);
    background: #0b1517;
    aspect-ratio: 16/9;
  }

  .drift-lab-game[hidden] {
    display: none;
  }

  .drift-lab-game canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #080c14;
  }

  .drift-lab-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-paper) 94%, transparent), color-mix(in srgb, var(--ai-paper) 78%, transparent) 58%, color-mix(in srgb, var(--ai-paper) 36%, transparent)),
      linear-gradient(0deg, color-mix(in srgb, var(--ai-bg) 36%, transparent), transparent 62%);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  .drift-lab-overlay[hidden] {
    display: none;
  }

  .drift-lab-overlay-inner {
    position: relative;
    text-align: left;
    padding: clamp(1rem, 3vw, 1.55rem);
    max-width: 25rem;
    max-height: 100%;
    overflow-y: auto;
    margin-right: auto;
    border: 1px solid color-mix(in srgb, var(--ai-border-strong) 72%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--ai-surface) 88%, transparent);
    box-shadow: 0 22px 54px color-mix(in srgb, var(--ai-slate-base) 15%, transparent);
    backdrop-filter: blur(16px);
  }

  .drift-lab-game-title {
    font-size: clamp(1.55rem, 3.3vw, 2.25rem);
    font-weight: 850;
    letter-spacing: 0;
    margin: 0 0 0.55rem;
    color: var(--ai-fg);
  }

  .drift-lab-game-subtitle {
    color: var(--ai-fg-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .drift-lab-play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 2rem;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--ai-accent-contrast);
    background: var(--ai-azure);
    border: 1px solid color-mix(in srgb, var(--ai-azure) 30%, transparent);
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s, background-color 0.2s;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ai-azure) 20%, transparent);
    font-family: inherit;
  }

  .drift-lab-play-btn:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--ai-azure) 90%, #000);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--ai-azure) 30%, transparent);
  }

  .drift-lab-play-btn:focus-visible {
    outline: 2px solid #818CF8;
    outline-offset: 3px;
  }

  .drift-lab-controls-info {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.85rem;
    color: var(--ai-fg-muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .drift-lab-key-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    white-space: normal;
  }

  .drift-lab-key-row--mobile {
    display: none;
  }

  .mini-stick {
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
  }

  .mini-stick span {
    width: 1.05rem;
    height: 1.05rem;
  }

  .drift-lab-hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    padding: 0.75rem 1rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    font-family: 'Fira Code', ui-monospace, monospace;
  }

  .drift-lab-hud[hidden] {
    display: none;
  }

  .hud-left,
  .hud-center,
  .hud-right {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hud-center {
    align-items: center;
  }

  .hud-right {
    align-items: flex-end;
  }

  .hud-speed,
  .hud-time,
  .hud-position {
    font-size: clamp(0.95rem, 2.4vw, 1.45rem);
    font-weight: 800;
    color: #F8FAFC;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .hud-position {
    color: #FBBF24;
  }

  .hud-lap,
  .hud-telemetry,
  .hud-best,
  .hud-drift-label {
    font-size: 0.7rem;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .hud-drift-label {
    color: #FBBF24;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }

  .hud-drift {
    width: 100px;
    height: 4px;
    border-radius: 9999px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hud-drift span {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #10B981, #FBBF24, #FF6B6B);
    transition: width 0.08s linear;
  }

  .hud-bottom {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    pointer-events: auto;
  }

  .hud-sound,
  .hud-restart {
    padding: 0.35rem 0.85rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: #CBD5E1;
    background: rgba(11, 15, 25, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    font-family: inherit;
  }

  .hud-sound:hover,
  .hud-restart:hover {
    color: #F8FAFC;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .hud-sound:focus-visible,
  .hud-restart:focus-visible {
    outline: 2px solid #818CF8;
    outline-offset: 2px;
  }

  .drift-lab-game-actions {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 9;
    display: flex;
    gap: 0.45rem;
    pointer-events: auto;
  }

  .drift-lab-fullscreen-btn {
    min-height: 2.4rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    background: rgba(8, 12, 20, 0.72);
    color: #F8FAFC;
    cursor: pointer;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(14px);
  }

  .drift-lab-fullscreen-btn:hover,
  .drift-lab-fullscreen-btn:focus-visible {
    background: rgba(63, 109, 128, 0.88);
    border-color: rgba(255, 255, 255, 0.28);
    outline: none;
  }

  .drift-lab-complete-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: #10B981;
  }

  .drift-lab-complete-time {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    font-family: 'Fira Code', ui-monospace, monospace;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
    color: #F8FAFC;
  }

  .drift-lab-lap-breakdown {
    margin-bottom: 0.8rem;
  }

  .lap-row {
    font-size: 0.82rem;
    font-family: 'Fira Code', ui-monospace, monospace;
    color: #94A3B8;
    line-height: 1.8;
  }

  .lap-row.lap-best {
    color: #10B981;
  }

  .lap-row.lap-best::after {
    content: ' best lap';
    color: #64748B;
    font-size: 0.72rem;
  }

