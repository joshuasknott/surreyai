---
import { Image } from "astro:assets";
import racingPreview from "../../assets/generated/ai-racing-cover-v2.png";
import builderPreview from "../../assets/generated/ai-agentic-builder-cover-v2.png";
import hintzeHallPreview from "../../assets/generated/ai-hintze-cover-v2.png";
import beatPreview from "../../assets/generated/ai-neural-beat-cover-v2.png";
---

<section id="projects" class="ai-section student-projects" aria-labelledby="student-projects-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
        <p class="section-number" aria-hidden="true">03</p>
        <h2 id="student-projects-title" class="section-title">Explore student projects</h2>
      </div>
      <p class="section-intro">
        Try interactive projects created by Surrey students. They show how ideas can become experiments, prototypes and portfolio work, as well as the practical experience members can develop together.
      </p>
    </div>

    <div class="project-tools" aria-label="Interactive student projects">
      <article class="project-tool project-tool--hintze" data-project-tool="hintze-hall">
        <button class="project-preview" type="button" data-project-start aria-label="Open Hintze Hall After Hours">
          <span class="project-preview__media">
            <Image
              src={hintzeHallPreview}
              alt="A photogrammetric point-cloud reconstruction of a natural-history hall beneath a blue whale skeleton"
              widths={[640, 960, 1280]}
              sizes="(min-width: 860px) 46vw, 100vw"
              format="webp"
              quality={90}
              loading="lazy"
            />
            <span class="project-preview__shade"></span>
            <span class="project-preview__launch" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5L8 5.5Z" /></svg>
            </span>
          </span>
          <span class="project-preview__copy">
            <strong>Hintze Hall After Hours</strong>
            <span class="project-preview__description">Walk quietly through a real photogrammetric capture beneath Hope the blue whale.</span>
            <span class="project-preview__action">Open project</span>
          </span>
        </button>

        <dialog class="project-modal" data-project-modal aria-labelledby="hintze-hall-project-title">
          <div class="project-modal__frame" data-project-frame>
            <header class="project-modal__header">
              <div class="project-modal__identity">
                <span class="project-modal__dot project-modal__dot--hintze" aria-hidden="true"></span>
                <div><p>Student project</p><h3 id="hintze-hall-project-title">Hintze Hall After Hours</h3></div>
              </div>
              <div class="project-modal__actions">
                <button type="button" class="project-modal__icon" data-project-fullscreen aria-label="Enter full screen" title="Full screen">
                  <svg class="icon-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" /></svg>
                  <svg class="icon-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M20 15h-5v5M4 15h5v5" /></svg>
                </button>
                <button type="button" class="project-modal__icon" data-project-close aria-label="Close Hintze Hall After Hours" title="Close">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
              </div>
            </header>
            <div class="project-modal__body" tabindex="-1">
              <iframe data-project-embed data-src="/projects/hintze-hall?embed=1" title="Hintze Hall After Hours interactive project" loading="lazy"></iframe>
            </div>
          </div>
        </dialog>
      </article>

      <article class="project-tool project-tool--racing" data-project-tool="racing">
        <button class="project-preview" type="button" data-project-start aria-label="Open Racing Simulator">
          <span class="project-preview__media">
            <Image
              src={racingPreview}
              alt="Four autonomous race cars following an orange racing line around a night circuit"
              widths={[640, 960, 1280]}
              sizes="(min-width: 860px) 46vw, 100vw"
              format="webp"
              quality={88}
              loading="lazy"
            />
            <span class="project-preview__shade"></span>
            <span class="project-preview__launch" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5L8 5.5Z" /></svg>
            </span>
          </span>
          <span class="project-preview__copy">
            <strong>Racing Simulator</strong>
            <span class="project-preview__description">Race rivals with different personalities around a campus-inspired track.</span>
            <span class="project-preview__action">Open project</span>
          </span>
        </button>

        <dialog class="project-modal" data-project-modal aria-labelledby="racing-project-title">
          <div class="project-modal__frame" data-project-frame>
            <header class="project-modal__header">
              <div class="project-modal__identity">
                <span class="project-modal__dot project-modal__dot--racing" aria-hidden="true"></span>
                <div><p>Student project</p><h3 id="racing-project-title">Racing Simulator</h3></div>
              </div>
              <div class="project-modal__actions">
                <button type="button" class="project-modal__icon" data-project-fullscreen aria-label="Enter full screen" title="Full screen">
                  <svg class="icon-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" /></svg>
                  <svg class="icon-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M20 15h-5v5M4 15h5v5" /></svg>
                </button>
                <button type="button" class="project-modal__icon" data-project-close aria-label="Close Racing Simulator" title="Close">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
              </div>
            </header>
            <div class="project-modal__body" tabindex="-1">
              <iframe data-project-embed data-src="/projects/racing-simulator?embed=1" title="Racing Simulator interactive project" loading="lazy"></iframe>
            </div>
          </div>
        </dialog>
      </article>

      <article class="project-tool project-tool--builder" data-project-tool="builder">
        <button class="project-preview" type="button" data-project-start aria-label="Open Agentic Builder">
          <span class="project-preview__media">
            <Image
              src={builderPreview}
              alt="Four connected AI work areas collaboratively assembling a web interface"
              widths={[640, 960, 1280]}
              sizes="(min-width: 860px) 46vw, 100vw"
              format="webp"
              quality={90}
              loading="lazy"
            />
            <span class="project-preview__shade"></span>
            <span class="project-preview__launch" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5L8 5.5Z" /></svg>
            </span>
          </span>
          <span class="project-preview__copy">
            <strong>Agentic Builder</strong>
            <span class="project-preview__description">Describe an idea and watch a tiny AI team turn it into a prototype.</span>
            <span class="project-preview__action">Open project</span>
          </span>
        </button>

        <dialog class="project-modal" data-project-modal aria-labelledby="builder-project-title">
          <div class="project-modal__frame" data-project-frame>
            <header class="project-modal__header">
              <div class="project-modal__identity">
                <span class="project-modal__dot project-modal__dot--builder" aria-hidden="true"></span>
                <div><p>Student project</p><h3 id="builder-project-title">Agentic Builder</h3></div>
              </div>
              <div class="project-modal__actions">
                <button type="button" class="project-modal__icon" data-project-fullscreen aria-label="Enter full screen" title="Full screen">
                  <svg class="icon-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" /></svg>
                  <svg class="icon-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M20 15h-5v5M4 15h5v5" /></svg>
                </button>
                <button type="button" class="project-modal__icon" data-project-close aria-label="Close Agentic Builder" title="Close">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
              </div>
            </header>
            <div class="project-modal__body" tabindex="-1">
              <div class="project-modal__loading" data-project-loading role="status" aria-live="polite">
                <span class="project-modal__loading-mark" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>Opening Agentic Builder</strong>
                <span>Preparing the interactive workspace…</span>
              </div>
              <iframe data-project-embed data-src="/projects/agentic-builder?embed=1" title="Agentic Builder interactive project" loading="eager"></iframe>
            </div>
          </div>
        </dialog>
      </article>

      <article class="project-tool project-tool--beat" data-project-tool="beat">
        <button class="project-preview" type="button" data-project-start aria-label="Open Neural Beat Lab">
          <span class="project-preview__media">
            <Image
              src={beatPreview}
              alt="A black vinyl record transforming into an orange and warm-white audio waveform"
              widths={[640, 960, 1280]}
              sizes="(min-width: 1180px) 23vw, (min-width: 860px) 46vw, 100vw"
              format="webp"
              quality={90}
              loading="lazy"
            />
            <span class="project-preview__shade"></span>
            <span class="project-preview__launch">
              <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5L8 5.5Z" /></svg>
            </span>
          </span>
          <span class="project-preview__copy">
            <strong>Neural Beat Lab</strong>
            <span class="project-preview__description">Type a feeling. Get a tiny original beat to play and remix.</span>
            <span class="project-preview__action">Open project</span>
          </span>
        </button>

        <dialog class="project-modal" data-project-modal aria-labelledby="beat-project-title">
          <div class="project-modal__frame" data-project-frame>
            <header class="project-modal__header">
              <div class="project-modal__identity">
                <span class="project-modal__dot project-modal__dot--beat" aria-hidden="true"></span>
                <div><p>Student project</p><h3 id="beat-project-title">Neural Beat Lab</h3></div>
              </div>
              <div class="project-modal__actions">
                <button type="button" class="project-modal__icon" data-project-fullscreen aria-label="Enter full screen" title="Full screen">
                  <svg class="icon-enter" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4H4v4.5M15.5 4H20v4.5M20 15.5V20h-4.5M8.5 20H4v-4.5" /></svg>
                  <svg class="icon-exit" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M20 15h-5v5M4 15h5v5" /></svg>
                </button>
                <button type="button" class="project-modal__icon" data-project-close aria-label="Close Neural Beat Lab" title="Close">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
              </div>
            </header>
            <div class="project-modal__body" tabindex="-1">
              <iframe data-project-embed data-src="/projects/neural-beat-lab?embed=1" title="Neural Beat Lab interactive project" loading="lazy"></iframe>
            </div>
          </div>
        </dialog>
      </article>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-tool]").forEach((tool) => {
    const starter = tool.querySelector<HTMLButtonElement>("[data-project-start]");
    const modal = tool.querySelector<HTMLDialogElement>("[data-project-modal]");
    const frame = tool.querySelector<HTMLElement>("[data-project-frame]");
    const closeButton = tool.querySelector<HTMLButtonElement>("[data-project-close]");
    const fullscreenButton = tool.querySelector<HTMLButtonElement>("[data-project-fullscreen]");
    const modalBody = tool.querySelector<HTMLElement>(".project-modal__body");
    const embed = tool.querySelector<HTMLIFrameElement>("[data-project-embed]");
    const loadingState = tool.querySelector<HTMLElement>("[data-project-loading]");

    const setEmbedReady = (ready: boolean) => {
      tool.dataset.projectReady = ready ? "true" : "false";
      modalBody?.setAttribute("aria-busy", ready ? "false" : "true");
      if (loadingState) loadingState.hidden = ready;
    };

    const ensureEmbedLoaded = () => {
      if (!embed || embed.hasAttribute("src")) return;
      setEmbedReady(false);
      embed.src = embed.dataset.src || "about:blank";
    };

    embed?.addEventListener("load", () => {
      if (!embed.hasAttribute("src")) return;
      setEmbedReady(true);
    });

    if (tool.dataset.projectTool === "builder") {
      starter?.addEventListener("pointerenter", ensureEmbedLoaded, { once: true });
      starter?.addEventListener("focus", ensureEmbedLoaded, { once: true });
    }

    const updateFullscreenButton = () => {
      if (!fullscreenButton || !frame) return;
      const active = document.fullscreenElement === frame;
      fullscreenButton.dataset.active = active ? "true" : "false";
      fullscreenButton.setAttribute("aria-label", active ? "Exit full screen" : "Enter full screen");
      fullscreenButton.title = active ? "Exit full screen" : "Full screen";
    };

    starter?.addEventListener("click", () => {
      if (!modal) return;
      if (typeof modal.showModal === "function") modal.showModal();
      else modal.setAttribute("open", "");
      ensureEmbedLoaded();
      document.documentElement.classList.add("project-modal-is-open");
      window.dispatchEvent(new CustomEvent("surrey-ai-project-modal-open", {
        detail: { project: tool.dataset.projectTool },
      }));
      modalBody?.focus({ preventScroll: true });
    });

    closeButton?.addEventListener("click", () => modal?.close());

    fullscreenButton?.addEventListener("click", async () => {
      if (!frame || !document.fullscreenEnabled) return;
      try {
        if (document.fullscreenElement === frame) await document.exitFullscreen();
        else await frame.requestFullscreen({ navigationUI: "hide" });
      } catch {}
    });

    if (!document.fullscreenEnabled) fullscreenButton?.setAttribute("hidden", "");
    document.addEventListener("fullscreenchange", updateFullscreenButton);
    updateFullscreenButton();

    modal?.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });

    modal?.addEventListener("close", () => {
      const restoreFocus = () => requestAnimationFrame(() => starter?.focus({ preventScroll: true }));
      if (frame && document.fullscreenElement === frame) document.exitFullscreen().then(restoreFocus).catch(restoreFocus);
      else restoreFocus();
      document.documentElement.classList.remove("project-modal-is-open");
      if (embed) {
        embed.removeAttribute("src");
        setEmbedReady(false);
      }
      window.dispatchEvent(new CustomEvent("surrey-ai-project-modal-close", {
        detail: { project: tool.dataset.projectTool },
      }));
    });
  });
</script>

<style>
  .student-projects { overflow: hidden; }

  .project-tools {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.4vw, 1.8rem);
  }

  .project-tool { min-width: 0; }

  .project-preview {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 0;
    grid-template-rows: auto auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--ai-border-strong);
    border-radius: 6px;
    background: #111111;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
    box-shadow: 0 18px 50px color-mix(in srgb, var(--ai-slate-base) 10%, transparent);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s, box-shadow 0.3s;
  }

  .project-preview:hover,
  .project-preview:focus-visible {
    border-color: color-mix(in srgb, var(--ai-azure) 55%, var(--ai-border-strong));
    outline: none;
    transform: translateY(-5px);
    box-shadow: 0 28px 70px color-mix(in srgb, var(--ai-slate-base) 16%, transparent);
  }

  .project-preview__media {
    position: relative;
    display: block;
    min-height: 0;
    aspect-ratio: 1.12;
    overflow: hidden;
    background: #0b1117;
    isolation: isolate;
  }

  .project-preview__media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) contrast(1.06);
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s;
  }

  .project-tool--builder .project-preview__media > img { object-position: 50% 45%; }

  .project-preview:hover .project-preview__media > img,
  .project-preview:focus-visible .project-preview__media > img {
    filter: saturate(1.05) contrast(1.05);
    transform: scale(1.035);
  }

  .project-preview__shade {
    position: absolute;
    z-index: 2;
    inset: 0;
    background: linear-gradient(180deg, transparent 48%, rgba(17, 17, 17, 0.56));
    pointer-events: none;
  }

  .project-preview__launch {
    position: absolute;
    z-index: 3;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    background: #FAF8F3;
    color: #111111;
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(12px);
    transition: transform 0.25s, background-color 0.25s;
  }

  .project-preview__launch svg { width: 1.15rem; fill: currentColor; }

  .project-preview:hover .project-preview__launch,
  .project-preview:focus-visible .project-preview__launch {
    background: #fff;
    transform: scale(1.08);
  }

  .project-preview__copy {
    display: grid;
    gap: 0.45rem;
    padding: 1.2rem 1.35rem 1.35rem;
    min-height: 10.8rem;
    background: #111111;
  }

  .project-preview__copy strong {
    color: #FAF8F3;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .project-preview__description {
    color: #B9B2AA;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .project-preview__action {
    margin-top: auto;
    padding-top: 0.7rem;
    color: #FF4A00;
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }


  .project-modal {
    position: fixed;
    inset: 50% auto auto 50%;
    width: min(110rem, calc(100vw - 0.75rem));
    max-width: none;
    height: calc(100dvh - 0.75rem);
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ai-fg);
    transform: translate(-50%, -50%);
  }

  .project-modal::backdrop {
    background: color-mix(in srgb, var(--ai-slate-base) 68%, transparent);
    backdrop-filter: blur(12px) saturate(0.75);
  }

  .project-modal__frame {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-rows: 3.65rem minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ai-border-strong) 74%, transparent);
    border-radius: 8px;
    background: var(--ai-surface);
    box-shadow: 0 36px 100px rgba(4, 11, 16, 0.38);
  }

  .project-modal__frame:fullscreen {
    width: 100vw;
    height: 100dvh;
    border: 0;
    border-radius: 0;
  }

  .project-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.55rem 0.45rem 1rem;
    border-bottom: 1px solid var(--ai-border);
    background: color-mix(in srgb, var(--ai-surface) 94%, transparent);
    backdrop-filter: blur(18px);
  }

  .project-tool--builder .project-modal__frame {
    position: relative;
    grid-template-rows: minmax(0, 1fr);
  }

  .project-tool--builder .project-modal__header {
    position: absolute;
    z-index: 4;
    top: 1.4rem;
    right: 1.4rem;
    padding: 0;
    border: 0;
    background: transparent;
    backdrop-filter: none;
  }

  .project-tool--builder .project-modal__identity {
    display: none;
  }

  .project-tool--builder .project-modal__icon {
    background: color-mix(in srgb, var(--ai-paper) 88%, transparent);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ai-slate-base) 8%, transparent);
    backdrop-filter: blur(14px);
  }

  .project-tool--builder .project-modal__body {
    grid-row: 1;
  }

  .project-modal__identity,
  .project-modal__actions { display: flex; align-items: center; }
  .project-modal__identity { min-width: 0; gap: 0.7rem; }
  .project-modal__actions { gap: 0.4rem; }

  .project-modal__dot {
    width: 0.72rem;
    height: 0.72rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--ai-azure);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--ai-azure) 12%, transparent);
  }

  .project-modal__dot--hintze { background: #c99a5f; box-shadow: 0 0 0 .3rem rgba(201,154,95,.14); }
  .project-modal__dot--builder { background: var(--ai-sage); box-shadow: 0 0 0 .3rem color-mix(in srgb, var(--ai-sage) 12%, transparent); }
  .project-modal__dot--beat { background: var(--ai-coral); box-shadow: 0 0 0 .3rem color-mix(in srgb, var(--ai-coral) 12%, transparent); }

  .project-modal__identity p {
    margin: 0 0 0.08rem;
    color: var(--ai-fg-muted);
    font-size: 0.56rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-modal__identity h3 {
    margin: 0;
    overflow: hidden;
    color: var(--ai-fg);
    font-size: 0.9rem;
    font-weight: 850;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-modal__icon {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    padding: 0;
    border: 1px solid var(--ai-border);
    border-radius: 10px;
    background: var(--ai-paper);
    color: var(--ai-fg);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .project-modal__icon:hover,
  .project-modal__icon:focus-visible {
    border-color: var(--ai-fg);
    background: var(--ai-fg);
    color: var(--ai-bg);
    outline: none;
    transform: translateY(-1px);
  }

  .project-modal__icon svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .project-modal__icon .icon-exit,
  .project-modal__icon[data-active="true"] .icon-enter { display: none; }
  .project-modal__icon[data-active="true"] .icon-exit { display: block; }

  .project-modal__body {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: var(--ai-bg);
  }

  .project-modal__body:focus { outline: none; }

  .project-modal__body > iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--ai-bg);
  }

  .project-modal__loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.55rem;
    padding: 2rem;
    color: var(--ai-fg);
    text-align: center;
    background:
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--ai-orange) 10%, transparent), transparent 32%),
      var(--ai-bg);
  }

