---
import { Image } from "astro:assets";
import racingPreview from "../../assets/generated/ai-racing-simulator.png";
import agenticPreview from "../../assets/generated/ai-agentic-builder.png";

const projects = [
  {
    id: "drift-lab",
    title: "Interactive learning",
    type: "Website preview",
    description: "A glimpse of the hands-on, technical learning culture the society wants to make easier to discover.",
    action: "Preview visual",
    image: racingPreview,
    alt: "Website preview visual with a racing track and trajectory overlay",
  },
  {
    id: "agentic-workspace",
    title: "Build nights",
    type: "Coming soon",
    description: "A teaser for future sessions where members can explore tools, ideas, workflows, and responsible technology together.",
    action: "Preview visual",
    image: agenticPreview,
    alt: "Laptop showing an abstract artificial intelligence workflow interface",
  },
];
---

<section id="projects" class="ai-section" aria-labelledby="student-projects-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
        <h2 id="student-projects-title" class="section-title">Website preview</h2>
      </div>
      <p class="section-intro">
        A teaser of the visual and technical direction for the new Surrey Artificial Intelligence Society website, launching this September.
      </p>
    </div>

    <div class="project-showcase" aria-label="Student projects list">
      {projects.map((project) => (
        <article class="project-preview">
          <Image
            src={project.image}
            alt={project.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 900px) 50vw, 100vw"
            class="project-preview__image"
            loading="lazy"
            format="webp"
          />
          <span class="project-preview__scrim" aria-hidden="true"></span>
          <span class="project-preview__content">
            <span class="project-preview__type">{project.type}</span>
            <strong>{project.title}</strong>
            <span>{project.description}</span>
            <span class="project-preview__action">{project.action}</span>
          </span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .project-showcase {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .project-preview {
    position: relative;
    min-height: clamp(23rem, 33vw, 31rem);
    overflow: hidden;
    border: 0;
    border-radius: clamp(1rem, 2vw, 1.7rem);
    background: color-mix(in srgb, var(--ai-surface) 70%, var(--ai-bg));
    color: #fff;
    font: inherit;
    padding: 0;
    text-align: left;
  }

  .project-preview__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-preview:hover .project-preview__image {
    transform: scale(1.05);
  }

  .project-preview__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 10, 18, 0.84), rgba(5, 10, 18, 0.2) 62%, rgba(5, 10, 18, 0.1)),
      linear-gradient(0deg, rgba(5, 10, 18, 0.55), transparent 45%);
  }

  .project-preview__content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    max-width: 28rem;
    gap: 0.7rem;
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .project-preview__type {
    width: max-content;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .project-preview strong {
    color: #fff;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: 0;
    line-height: 1.05;
  }

  .project-preview span {
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.5;
  }

  .project-preview__action {
    color: #fff !important;
    font-weight: 800;
    margin-top: 0.25rem;
  }

  @media (max-width: 840px) {
    .project-showcase {
      grid-template-columns: 1fr;
    }
  }
</style>
