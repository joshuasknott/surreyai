---
import StudentProjectSlot from "./StudentProjectSlot.astro";
import IdeaAnalyser from "./student-projects/IdeaAnalyser.astro";
import AgenticWorkspace from "./student-projects/AgenticWorkspace.astro";

const projects = [
  {
    id: "drift-lab",
    title: "Racing Simulator",
    type: "Playable game",
    description: "A third-person browser racing simulator with AI drivers, tire grip, and automatic drift handling.",
    action: "Play",
    color: "var(--ai-azure)"
  },
  {
    id: "idea-analyser",
    title: "Idea Analyser",
    type: "Live AI feedback",
    description: "Instant AI feedback on business, startup, product, and project ideas.",
    action: "Analyse",
    color: "var(--ai-coral)"
  },
  {
    id: "agentic-workspace",
    title: "Agentic Workspace",
    type: "Frontend simulation",
    description: "A visual prototype of agents planning, building, reviewing, and handing off work inside a shared workspace.",
    action: "Launch",
    color: "var(--ai-sage)"
  }
];
---

<section class="student-projects-section" aria-labelledby="student-projects-title">
  <div class="projects-container">
    <div class="projects-header">
      <h2 id="student-projects-title" class="projects-title">Student Projects</h2>
      <p class="projects-subtitle">An interactive gallery of prototypes, games, and tools built by our members.</p>
    </div>

    <div class="projects-layout">
      <div class="projects-scroll-container">
        <div class="projects-scroll-row" aria-label="Student projects list">
          {projects.map((p) => (
            <button 
              class="premium-card project-card scrollable-card text-left group" 
              data-project-id={p.id}
              aria-label={`View ${p.title}`}
              aria-haspopup="dialog"
              style={`--card-brand-color: ${p.color}; --brand-color: ${p.color};`}
            >
              <!-- Cybernetic Corner Brackets -->
              <div class="corner-tick top-left"></div>
              <div class="corner-tick top-right"></div>
              <div class="corner-tick bottom-left"></div>
              <div class="corner-tick bottom-right"></div>

              <!-- Luminescent Glow, Grid, and Sweep Scan -->
              <div class="premium-glow"></div>
              <div class="premium-grid opacity-25"></div>
              <div class="premium-scan"></div>

              <div class="card-content relative z-10 flex-grow flex flex-col justify-between h-full w-full">
                <div>
                  <div class="card-meta flex justify-between items-center mb-6">
                    <span class="card-type text-[10px] font-semibold uppercase tracking-wider text-ai-azure">{p.type}</span>
                  </div>
                  <h3 class="card-title font-extrabold text-2xl text-ai-fg mb-3 tracking-tight group-hover:text-[var(--card-brand-color)] transition-colors duration-300">{p.title}</h3>
                  <p class="card-description text-ai-fg-muted leading-relaxed text-sm mb-6 flex-grow">{p.description}</p>
                </div>
                <div class="card-action flex items-center gap-2 text-sm font-bold text-[var(--card-brand-color)] mt-auto transition-all duration-300 group-hover:translate-x-1">
                  <span class="action-text">{p.action}</span>
                  <svg class="action-icon w-4 h-4" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>

    <dialog id="project-modal" class="project-modal" aria-label="Project Interactive View">
      <div class="modal-wrapper">
        <button id="close-modal" class="close-modal-btn" aria-label="Close Project">
          <span class="close-text">Close</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="modal-content" aria-live="polite">
          <div id="panel-drift-lab" class="project-panel" hidden>
            <div class="panel-inner">
              <StudentProjectSlot />
            </div>
          </div>

          <div id="panel-idea-analyser" class="project-panel" hidden>
            <div class="panel-inner">
              <IdeaAnalyser />
            </div>
          </div>

          <div id="panel-agentic-workspace" class="project-panel" hidden>
            <div class="panel-inner">
              <AgenticWorkspace />
            </div>
          </div>
        </div>
      </div>
    </dialog>
  </div>
</section>

<style>
  .student-projects-section {
    padding: 6rem 1.5rem;
    background: var(--ai-bg);
    border-top: 1px solid var(--ai-border);
    position: relative;
    overflow: hidden;
  }

  .projects-container {
    max-width: 80rem; /* matches max-w-7xl */
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
    z-index: 2;
  }

  .projects-header {
    margin-bottom: 4rem;
    text-align: left;
  }

  .projects-title {
    font-size: 2.25rem; /* matches text-4xl sm:text-5xl */
    font-weight: 800;
    letter-spacing: -0.025em; /* matches tracking-tight */
    color: var(--ai-fg);
    margin-bottom: 1rem;
  }
  @media (min-width: 640px) {
    .projects-title {
      font-size: 3rem;
    }
  }

  .projects-subtitle {
    font-size: 1.125rem; /* matches text-lg */
    color: var(--ai-fg-muted);
    max-width: 42rem;
    line-height: 1.7;
  }

  .projects-layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .projects-scroll-container {
    width: 100%;
    overflow: visible;
  }

  .projects-scroll-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .scrollable-card {
    width: 100%;
    min-width: 0;
  }

  .project-card {
    min-height: 260px;
    font-family: inherit;
    outline: none;
    border-radius: 1.5rem;
  }

  .project-card:focus-visible {
    outline: 2px solid var(--ai-azure);
    outline-offset: 4px;
  }

  .project-card.active {
    border-color: var(--brand-color);
    box-shadow: 0 0 0 2px var(--brand-color), 0 12px 32px color-mix(in srgb, var(--brand-color) 20%, transparent);
  }

  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .card-type {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ai-fg-muted);
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ai-fg);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .card-description {
    font-size: 0.9375rem;
    color: var(--ai-fg-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .card-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--brand-color);
    font-weight: 700;
    font-size: 0.9375rem;
    margin-top: auto;
    transition: transform 0.2s ease;
  }

  .project-card:hover .card-action {
    transform: translateX(4px);
  }

  .project-card.active .card-action {
    color: var(--ai-fg);
  }

  /* ── Modal Area ── */

  .project-modal {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
  }

  .project-modal::backdrop {
    background: rgba(6, 10, 18, 0.85);
    backdrop-filter: blur(12px);
  }

  .project-modal[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: modal-fade-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modal-fade-in {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  .modal-wrapper {
    position: relative;
    width: 95vw;
    height: 95vh;
    max-width: 1600px;
    margin: 2.5vh;
    border-radius: 1.5rem;
    background: var(--ai-bg);
    border: 1px solid var(--ai-border);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .close-modal-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    height: 48px;
    padding: 0 1.25rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--ai-surface) 86%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--ai-border);
    color: var(--ai-fg);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .close-modal-btn:hover {
    background: color-mix(in srgb, var(--ai-surface) 94%, var(--ai-fg));
    transform: scale(1.02);
  }

  .close-modal-btn:focus-visible {
    outline: 2px solid var(--ai-azure);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .close-text {
      display: none;
    }
    .close-modal-btn {
      padding: 0;
      width: 48px;
      justify-content: center;
    }
  }

  .modal-content {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .project-panel {
    width: 100%;
    height: 100%;
  }

  .project-panel[hidden] {
    display: none;
  }

  .panel-inner {
    width: 100%;
    height: 100%;
  }

  /* Hide inner redundant headers and backgrounds from modules to make them fit */
  .panel-inner > :global(section) {
    border: none !important;
    background: transparent !important;
    padding: 1.5rem !important;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .student-projects-section {
      padding: 4rem 1rem;
    }
    .projects-scroll-row {
      gap: 1rem;
    }
    .modal-content {
      min-height: 500px;
    }
    .panel-inner > :global(.drift-lab-section) {
      padding: 1rem 0.5rem;
    }
    .modal-wrapper {
      margin: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
    .card-glow {
      display: none;
    }
  }
</style>

<script>
  // Vanilla JS for Modal Interaction
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.project-card');
    const modal = document.getElementById('project-modal') as HTMLDialogElement;
    const closeModalBtn = document.getElementById('close-modal');
    const panels = document.querySelectorAll('.project-panel');

    const resetActiveProject = () => {
      window.dispatchEvent(new CustomEvent('surrey-ai-project-modal-close'));
      panels.forEach(p => p.setAttribute('hidden', ''));
      document.body.style.overflow = '';
    };

    // Open modal when card is clicked
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const projectId = card.getAttribute('data-project-id');
        const targetId = `panel-${projectId}`;

        // Hide all panels
        panels.forEach(p => p.setAttribute('hidden', ''));
        
        // Show selected panel
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.removeAttribute('hidden');
        }

        // Show modal
        if (modal) {
          modal.showModal();
          // Prevent scrolling on body
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Close modal function
    const closeModal = () => {
      if (modal?.open) {
        modal.close();
      }
    };

    if (closeModalBtn) {
      closeModalBtn.addEventListener('click', closeModal);
    }

    // Close on backdrop click
    if (modal) {
      modal.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
        if (!isInDialog) {
          closeModal();
        }
      });

      // Handle Escape key (dialog handles it natively, but we need to reset body overflow)
      modal.addEventListener('close', () => {
        resetActiveProject();
      });
    }
  });
</script>
