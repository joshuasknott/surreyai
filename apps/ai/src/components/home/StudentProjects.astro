---
import StudentProjectSlot from "./StudentProjectSlot.astro";
import CampusQuest from "./student-projects/CampusQuest.astro";
import PosterStudio from "./student-projects/PosterStudio.astro";
import TokenRush from "./student-projects/TokenRush.astro";

const featuredProject = {
  id: "campus-quest",
  title: "Cafe Walkthrough",
  type: "3D sim",
  status: "Live prototype",
  description: "Step inside a first-person 3D cafe, walk up to the counter, and collect a fresh coffee.",
  action: "Enter Café",
  color: "var(--ai-sage)"
};

const projects = [
  {
    id: "drift-lab",
    title: "Surrey Drift Lab",
    type: "Playable game",
    status: "Live prototype",
    description: "A tiny top-down browser racing game built for the AI Society student projects showcase.",
    action: "Play",
    color: "var(--ai-azure)"
  },
  {
    id: "poster-studio",
    title: "Poster Studio",
    type: "Creative tool",
    status: "Live prototype",
    description: "Generate slick event poster concepts for societies, workshops, socials, and hackathons.",
    action: "Create",
    color: "var(--ai-coral)"
  },
  {
    id: "token-rush",
    title: "Token Rush",
    type: "Reaction game",
    status: "Live prototype",
    description: "A fast typing/reaction game where you chase prompts, dodge bugs, and keep your streak alive.",
    action: "Play",
    color: "var(--ai-sage)"
  }
];
---

<section class="student-projects-section" aria-labelledby="student-projects-title">
  <div class="projects-container">
    <div class="projects-header">
      <h2 id="student-projects-title" class="projects-title">Student Projects</h2>
      <p class="projects-subtitle">An interactive gallery of prototypes, games, and tools built by our members.</p>
    </div>

    <div class="projects-layout">
      <!-- Top Area: Featured Project -->
      <button 
        class="project-card featured-project" 
        data-project-id={featuredProject.id}
        aria-label={`View ${featuredProject.title}`}
        aria-haspopup="dialog"
        style={`--brand-color: ${featuredProject.color}`}
      >
        <div class="card-glow"></div>
        <div class="card-content">
          <div class="card-meta">
            <span class="card-type">Featured Project • {featuredProject.type}</span>
            <span class:list={["card-status", featuredProject.status === "Live prototype" ? "status-live" : "status-soon"]}>
              {featuredProject.status}
            </span>
          </div>
          <h3 class="card-title">{featuredProject.title}</h3>
          <p class="card-description">{featuredProject.description}</p>
          <div class="card-action">
            <span class="action-text">{featuredProject.action}</span>
            <svg class="action-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </div>
        </div>
      </button>

      <!-- Bottom Area: Scrollable List -->
      <div class="projects-scroll-container">
        <div class="projects-scroll-row" aria-label="Student projects list">
          {projects.map((p, i) => (
            <button 
              class="project-card scrollable-card" 
              data-project-id={p.id}
              aria-label={`View ${p.title}`}
              aria-haspopup="dialog"
              style={`--brand-color: ${p.color}`}
            >
              <div class="card-glow"></div>
              <div class="card-content">
                <div class="card-meta">
                  <span class="card-type">{p.type}</span>
                  <span class:list={["card-status", p.status === "Live prototype" ? "status-live" : "status-soon"]}>
                    {p.status}
                  </span>
                </div>
                <h3 class="card-title">{p.title}</h3>
                <p class="card-description">{p.description}</p>
                <div class="card-action">
                  <span class="action-text">{p.action}</span>
                  <svg class="action-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>

    <dialog id="project-modal" class="project-modal" aria-label="Project Interactive View">
      <div class="modal-wrapper">
        <button id="close-modal" class="close-modal-btn" aria-label="Close Project">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <div class="modal-content" aria-live="polite">
          <!-- Surrey Drift Lab -->
          <div id="panel-drift-lab" class="project-panel" hidden>
            <div class="panel-inner">
              <StudentProjectSlot />
            </div>
          </div>

          <!-- Campus Quest -->
          <div id="panel-campus-quest" class="project-panel" hidden>
            <div class="panel-inner">
              <CampusQuest />
            </div>
          </div>

          <!-- Poster Studio -->
          <div id="panel-poster-studio" class="project-panel" hidden>
            <div class="panel-inner">
              <PosterStudio />
            </div>
          </div>

          <!-- Token Rush -->
          <div id="panel-token-rush" class="project-panel" hidden>
            <div class="panel-inner">
              <TokenRush />
            </div>
          </div>
        </div>
      </div>
    </dialog>
  </div>
</section>

<style>
  .student-projects-section {
    padding: 6rem 1.5rem;
    background: var(--ai-bg);
    border-top: 1px solid var(--ai-border);
    position: relative;
    overflow: hidden;
  }

  .projects-container {
    max-width: 72rem;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .projects-header {
    margin-bottom: 4rem;
    text-align: center;
  }

  .projects-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ai-fg);
    margin-bottom: 1rem;
  }

  .projects-subtitle {
    font-size: 1.125rem;
    color: var(--ai-fg-muted);
    max-width: 42rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  .projects-layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .featured-project {
    width: 100%;
    min-height: 320px;
  }
  
  .featured-project .card-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
  }

  .projects-scroll-container {
    width: 100%;
    overflow-x: auto;
    /* Hide scrollbar */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none;  /* IE and Edge */
  }

  .projects-scroll-container::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }

  .projects-scroll-row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 1.5rem;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
  }

  .scrollable-card {
    flex: 0 0 auto;
    width: 100%;
    min-width: 300px;
    max-width: 360px;
    scroll-snap-align: start;
  }

  .project-card {
    position: relative;
    text-align: left;
    background: var(--ai-surface);
    border: 1px solid var(--ai-border);
    border-radius: 1.25rem;
    padding: 2rem;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    min-height: 240px;
    font-family: inherit;
    outline: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--brand-color) 8%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project-card:hover .card-glow,
  .project-card.active .card-glow {
    opacity: 1;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--brand-color) 40%, var(--ai-border));
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--ai-azure);
    outline-offset: 4px;
  }

  .project-card.active {
    border-color: var(--brand-color);
    box-shadow: 0 0 0 1px var(--brand-color), 0 12px 32px color-mix(in srgb, var(--brand-color) 15%, transparent);
  }

  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .card-type {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ai-fg-muted);
  }

  .card-status {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .status-live {
    background: color-mix(in srgb, var(--ai-azure) 12%, transparent);
    color: var(--ai-azure);
  }

  .status-live::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ai-azure);
    box-shadow: 0 0 8px var(--ai-azure);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
    100% { opacity: 1; transform: scale(1); }
  }

  .status-soon {
    background: var(--ai-border);
    color: var(--ai-fg-muted);
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ai-fg);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .card-description {
    font-size: 0.9375rem;
    color: var(--ai-fg-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .card-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--brand-color);
    font-weight: 700;
    font-size: 0.9375rem;
    margin-top: auto;
    transition: transform 0.2s ease;
  }

  .project-card:hover .card-action {
    transform: translateX(4px);
  }

  .project-card.active .card-action {
    color: var(--ai-fg);
  }

  /* ── Modal Area ── */

  .project-modal {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
  }

  .project-modal::backdrop {
    background: rgba(6, 10, 18, 0.85);
    backdrop-filter: blur(12px);
  }

  .project-modal[open] {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: modal-fade-in 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modal-fade-in {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  .modal-wrapper {
    position: relative;
    width: 100%;
    max-width: 960px;
    margin: 2rem;
    border-radius: 1.5rem;
    background: var(--ai-slate-base);
    border: 1px solid var(--ai-border);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  .close-modal-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 50;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #F8FAFC;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .close-modal-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  .close-modal-btn:focus-visible {
    outline: 2px solid var(--ai-azure);
    outline-offset: 2px;
  }

  .modal-content {
    position: relative;
    width: 100%;
    min-height: 600px;
  }

  .project-panel {
    width: 100%;
    height: 100%;
  }

  .project-panel[hidden] {
    display: none;
  }

  .panel-inner {
    width: 100%;
    height: 100%;
  }

  /* Hide inner redundant headers and backgrounds from modules to make them fit */
  .panel-inner :global(.drift-lab-section),
  .panel-inner :global(.cq-section),
  .panel-inner :global(.ps-section),
  .panel-inner :global(.tr-section) {
    border: none;
    background: transparent;
    padding: 4rem 1.5rem;
  }

  /* ── Placeholder Concept Panels ── */

  .placeholder-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    color: #F8FAFC;
    position: relative;
  }

  .placeholder-inner {
    text-align: center;
    max-width: 32rem;
    position: relative;
    z-index: 2;
  }

  .placeholder-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, color-mix(in srgb, var(--brand-color) 15%, transparent) 0%, transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .placeholder-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--brand-color);
    margin-bottom: 2rem;
  }

  .placeholder-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--brand-color);
    margin-bottom: 1rem;
  }

  .placeholder-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: #fff;
  }

  .placeholder-desc {
    font-size: 1.125rem;
    color: #94A3B8;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .placeholder-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .detail-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .detail-label {
    font-size: 0.875rem;
    color: #64748B;
    font-weight: 600;
  }

  .detail-value {
    font-size: 0.875rem;
    color: #E2E8F0;
    font-weight: 500;
  }

  .placeholder-note {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .student-projects-section {
      padding: 4rem 1rem;
    }
    .projects-scroll-row {
      gap: 1rem;
    }
    .scrollable-card {
      min-width: 280px;
    }
    .modal-content {
      min-height: 500px;
    }
    .panel-inner :global(.drift-lab-section),
    .panel-inner :global(.cq-section),
    .panel-inner :global(.ps-section),
    .panel-inner :global(.tr-section) {
      padding: 2rem 0.5rem;
    }
    .modal-wrapper {
      margin: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
    .card-glow {
      display: none;
    }
    .status-live::before {
      animation: none;
    }
  }
</style>

<script>
  // Vanilla JS for Modal Interaction
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.project-card');
    const modal = document.getElementById('project-modal') as HTMLDialogElement;
    const closeModalBtn = document.getElementById('close-modal');
    const panels = document.querySelectorAll('.project-panel');

    // Open modal when card is clicked
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const projectId = card.getAttribute('data-project-id');
        const targetId = `panel-${projectId}`;

        // Hide all panels
        panels.forEach(p => p.setAttribute('hidden', ''));
        
        // Show selected panel
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.removeAttribute('hidden');
        }

        // Show modal
        if (modal) {
          modal.showModal();
          // Prevent scrolling on body
          document.body.style.overflow = 'hidden';
        }
      });
    });

    // Close modal function
    const closeModal = () => {
      if (modal) {
        modal.close();
        document.body.style.overflow = '';
        // Hide all panels to reset state and stop potential media playing if they rely on it
        panels.forEach(p => p.setAttribute('hidden', ''));
      }
    };

    if (closeModalBtn) {
      closeModalBtn.addEventListener('click', closeModal);
    }

    // Close on backdrop click
    if (modal) {
      modal.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
        if (!isInDialog) {
          closeModal();
        }
      });

      // Handle Escape key (dialog handles it natively, but we need to reset body overflow)
      modal.addEventListener('close', () => {
        document.body.style.overflow = '';
        panels.forEach(p => p.setAttribute('hidden', ''));
      });
    }
  });
</script>
