---
import { Image } from "astro:assets";
import StudentProjectSlot from "./StudentProjectSlot.astro";
import AgenticWorkspace from "./student-projects/AgenticWorkspace.astro";
import racingPreview from "../../assets/generated/ai-racing-simulator.png";
import agenticPreview from "../../assets/generated/ai-agentic-builder.png";

const projects = [
  {
    id: "drift-lab",
    title: "Racing Simulator",
    type: "Playable project",
    description: "An autonomous racing environment for experimenting with perception, planning, and control.",
    action: "Open project",
    image: racingPreview,
    alt: "Racing simulator track preview with AI trajectory overlay",
  },
  {
    id: "agentic-workspace",
    title: "Agentic Builder",
    type: "Interactive tool",
    description: "A live workspace showing how agent steps can plan, generate, review, and refine an app idea.",
    action: "Launch demo",
    image: agenticPreview,
    alt: "Laptop showing an abstract AI agent workflow interface",
  },
];
---

<section id="projects" class="ai-section" aria-labelledby="student-projects-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
        <h2 id="student-projects-title" class="section-title">Student projects</h2>
      </div>
      <p class="section-intro">
        Open interactive demos, inspect how they work, and see the kind of practical experiments members can build toward.
      </p>
    </div>

    <div class="project-showcase" aria-label="Student projects list">
      {projects.map((project) => (
        <button
          class="project-preview"
          type="button"
          data-project-id={project.id}
          aria-label={`Open ${project.title}`}
          aria-haspopup="dialog"
        >
          <Image
            src={project.image}
            alt={project.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 900px) 50vw, 100vw"
            class="project-preview__image"
            loading="lazy"
            format="webp"
          />
          <span class="project-preview__scrim" aria-hidden="true"></span>
          <span class="project-preview__content">
            <span class="project-preview__type">{project.type}</span>
            <strong>{project.title}</strong>
            <span>{project.description}</span>
            <span class="project-preview__action">{project.action} -></span>
          </span>
        </button>
      ))}
    </div>

    <dialog id="project-modal" class="project-modal" aria-label="Project interactive view">
      <div class="modal-wrapper">
        <button id="close-modal" class="close-modal-btn" aria-label="Close project">
          Close
        </button>
        <div class="modal-content" aria-live="polite">
          <div id="panel-drift-lab" class="project-panel" hidden>
            <div class="panel-inner">
              <StudentProjectSlot />
            </div>
          </div>

          <div id="panel-agentic-workspace" class="project-panel" hidden>
            <div class="panel-inner">
              <AgenticWorkspace />
            </div>
          </div>
        </div>
      </div>
    </dialog>
  </div>
</section>

<script>
  const modal = document.getElementById("project-modal") as HTMLDialogElement | null;
  const closeBtn = document.getElementById("close-modal");
  const projectButtons = document.querySelectorAll<HTMLButtonElement>("[data-project-id]");
  const panels = document.querySelectorAll<HTMLElement>(".project-panel");

  const showProject = (id: string) => {
    panels.forEach((panel) => {
      panel.hidden = panel.id !== `panel-${id}`;
    });
    if (modal && !modal.open) modal.showModal();
  };

  projectButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.projectId;
      if (id) showProject(id);
    });
  });

  closeBtn?.addEventListener("click", () => {
    modal?.close();
    window.dispatchEvent(new CustomEvent("surrey-ai-project-modal-close"));
  });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) {
      modal.close();
      window.dispatchEvent(new CustomEvent("surrey-ai-project-modal-close"));
    }
  });
</script>

<style>
  .project-showcase {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .project-preview {
    position: relative;
    min-height: clamp(23rem, 33vw, 31rem);
    overflow: hidden;
    border: 0;
    border-radius: clamp(1rem, 2vw, 1.7rem);
    background: color-mix(in srgb, var(--ai-surface) 70%, var(--ai-bg));
    color: #fff;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-align: left;
  }

  .project-preview__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-preview:hover .project-preview__image {
    transform: scale(1.05);
  }

  .project-preview__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 10, 18, 0.84), rgba(5, 10, 18, 0.2) 62%, rgba(5, 10, 18, 0.1)),
      linear-gradient(0deg, rgba(5, 10, 18, 0.55), transparent 45%);
  }

  .project-preview__content {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    max-width: 28rem;
    gap: 0.7rem;
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .project-preview__type {
    width: max-content;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .project-preview strong {
    color: #fff;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: 0;
    line-height: 1.05;
  }

  .project-preview span {
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.5;
  }

  .project-preview__action {
    color: #fff !important;
    font-weight: 800;
    margin-top: 0.25rem;
  }

  .project-preview:focus-visible {
    outline: 3px solid var(--ai-azure);
    outline-offset: 4px;
  }

  .project-modal {
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .project-modal::backdrop {
    background: rgba(6, 10, 18, 0.82);
    backdrop-filter: blur(12px);
  }

  .project-modal[open] {
    display: grid;
    place-items: center;
  }

  .modal-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(96vw, 96rem);
    height: min(94vh, 62rem);
    overflow: hidden;
    border: 1px solid var(--ai-border);
    border-radius: 1.35rem;
    background: var(--ai-bg);
  }

  .close-modal-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 20;
    border: 1px solid var(--ai-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-surface) 88%, transparent);
    color: var(--ai-fg);
    cursor: pointer;
    font-weight: 800;
    padding: 0.8rem 1rem;
  }

  .modal-content {
    width: 100%;
    height: 100%;
    overflow: auto;
  }

  .project-panel,
  .panel-inner {
    width: 100%;
    height: 100%;
  }

  .project-panel[hidden] {
    display: none;
  }

  .panel-inner > :global(section) {
    min-height: 100%;
    box-sizing: border-box;
    overflow: visible;
  }

  @media (max-width: 840px) {
    .project-showcase {
      grid-template-columns: 1fr;
    }
  }
</style>
