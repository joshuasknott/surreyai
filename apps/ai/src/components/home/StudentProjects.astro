---
import { Image } from "astro:assets";
import StudentProjectSlot from "./StudentProjectSlot.astro";
import AgenticWorkspace from "./student-projects/AgenticWorkspace.astro";
import racingSimulator from "../../assets/generated/ai-racing-simulator.optimized.webp";
import agenticBuilder from "../../assets/generated/ai-agentic-builder.optimized.webp";
---

<section id="projects" class="ai-section student-projects" aria-labelledby="student-projects-title">
  <div class="ai-section__inner">
    <div class="ai-section__header ai-section__header--split">
      <div>
        <h2 id="student-projects-title" class="section-title">Student projects</h2>
      </div>
      <p class="section-intro">
        Four interactive demos, designed to be tried: build a prototype, race the circuit, compose a track, or solve a live AI mystery.
      </p>
    </div>

    <div class="project-tools" aria-label="Interactive student projects">
      <article class="project-tool project-tool--racing" data-project-tool="racing">
        <button class="project-preview" type="button" data-project-start aria-label="Open Racing Simulator">
          <Image
            src={racingSimulator}
            alt="Racing simulator preview with a race car on a campus-inspired track"
            widths={[480, 720, 960]}
            sizes="(min-width: 860px) 32vw, 100vw"
            format="webp"
            quality={76}
            loading="lazy"
          />
          <span class="project-preview__copy">
            <strong>Racing Simulator</strong>
          </span>
        </button>
        <dialog class="project-modal" data-project-modal aria-label="Racing Simulator">
          <div class="project-modal__frame">
            <header class="project-modal__header">
              <div>
                <p>Student project</p>
                <h3>Racing Simulator</h3>
              </div>
              <button class="project-modal__close" type="button" data-project-close aria-label="Close Racing Simulator">Close</button>
            </header>
            <div class="project-modal__body" tabindex="-1">
              <StudentProjectSlot />
            </div>
          </div>
        </dialog>
      </article>

      <article class="project-tool project-tool--builder" data-project-tool="builder">
        <button class="project-preview" type="button" data-project-start aria-label="Open Agentic Builder">
          <Image
            src={agenticBuilder}
            alt="Agentic Builder preview with a generated app interface and workflow controls"
            widths={[480, 720, 960]}
            sizes="(min-width: 860px) 32vw, 100vw"
            format="webp"
            quality={76}
            loading="lazy"
          />
          <span class="project-preview__copy">
            <strong>Agentic Builder</strong>
          </span>
        </button>
        <dialog class="project-modal" data-project-modal aria-label="Agentic Builder">
          <div class="project-modal__frame">
            <header class="project-modal__header">
              <div>
                <p>Student project</p>
                <h3>Agentic Builder</h3>
              </div>
              <button class="project-modal__close" type="button" data-project-close aria-label="Close Agentic Builder">Close</button>
            </header>
            <div class="project-modal__body" tabindex="-1">
              <AgenticWorkspace />
            </div>
          </div>
        </dialog>
      </article>

      <article class="project-tool project-tool--beat">
        <a class="project-preview" href="/projects/neural-beat-lab" aria-label="Open Neural Beat Lab">
          <span class="project-preview__art project-preview__art--beat" aria-hidden="true">
            <span class="beat-art__topline"><span>NEURAL BEAT LAB</span><span>124 BPM</span></span>
            <span class="beat-art__orb"><i></i><i></i><i></i><i></i><i></i><i></i></span>
            <span class="beat-art__grid"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
            <span class="beat-art__track">MIDNIGHT / MOTION</span>
          </span>
          <span class="project-preview__copy">
            <small>AI music studio</small>
            <strong>Neural Beat Lab</strong>
          </span>
        </a>
      </article>

      <article class="project-tool project-tool--signal">
        <a class="project-preview" href="/projects/signal-lost" aria-label="Open Signal Lost">
          <span class="project-preview__art project-preview__art--signal" aria-hidden="true">
            <span class="signal-art__case">CASE 02 / 03</span>
            <span class="signal-art__room"><i></i><i></i><i></i><i></i><b></b></span>
            <span class="signal-art__trace"></span>
            <span class="signal-art__status">3 clues recovered</span>
          </span>
          <span class="project-preview__copy">
            <small>Adaptive AI mystery</small>
            <strong>Signal Lost</strong>
          </span>
        </a>
      </article>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-tool]").forEach((tool) => {
    const starter = tool.querySelector<HTMLButtonElement>("[data-project-start]");
    const modal = tool.querySelector<HTMLDialogElement>("[data-project-modal]");
    const closeButton = tool.querySelector<HTMLButtonElement>("[data-project-close]");
    const modalBody = tool.querySelector<HTMLElement>(".project-modal__body");

    starter?.addEventListener("click", () => {
      if (!modal) return;
      if (typeof modal.showModal === "function") {
        modal.showModal();
      } else {
        modal.setAttribute("open", "");
      }
      window.dispatchEvent(new CustomEvent("surrey-ai-project-modal-open", {
        detail: { project: tool.dataset.projectTool },
      }));
      modalBody?.focus({ preventScroll: true });
    });

    closeButton?.addEventListener("click", () => modal?.close());

    modal?.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });

    modal?.addEventListener("close", () => {
      window.dispatchEvent(new CustomEvent("surrey-ai-project-modal-close", {
        detail: { project: tool.dataset.projectTool },
      }));
    });
  });
</script>

<style>
  .student-projects {
    overflow: hidden;
  }

  .project-tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: stretch;
  }

  .project-tool {
    position: relative;
    min-height: clamp(25rem, 40vw, 34rem);
    overflow: visible;
    border: 0;
    border-radius: 8px;
    background: transparent;
  }

  .project-preview {
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 100%;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--ai-border-strong);
    border-radius: 8px;
    background: var(--ai-paper);
    color: inherit;
    font: inherit;
    text-align: left;
    box-shadow: 0 18px 46px color-mix(in srgb, var(--ai-slate-base) 12%, transparent);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .project-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.03) contrast(1.02);
    transition: transform 0.35s ease;
  }

  .project-preview::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, color-mix(in srgb, var(--ai-slate-base) 72%, transparent) 0%, color-mix(in srgb, var(--ai-slate-base) 22%, transparent) 34%, transparent 68%);
    pointer-events: none;
  }

  .project-preview__copy {
    position: absolute;
    inset: auto 1.35rem 1.35rem;
    z-index: 1;
    display: grid;
    max-width: 30rem;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }

  .project-preview strong {
    color: #fff;
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    line-height: 1.05;
  }

  .project-preview small {
    margin-bottom: 0.35rem;
    color: color-mix(in srgb, #fff 78%, transparent);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-preview__art {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .project-preview__art--beat {
    color: #f5fbff;
    background:
      radial-gradient(circle at 50% 44%, color-mix(in srgb, var(--ai-azure) 66%, transparent), transparent 24%),
      linear-gradient(138deg, #0d2537 0%, #174a68 50%, #102739 100%);
  }

  .beat-art__topline,
  .beat-art__track,
  .signal-art__case,
  .signal-art__status {
    position: absolute;
    z-index: 1;
    font-size: clamp(0.58rem, 1.1vw, 0.72rem);
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .beat-art__topline {
    inset: 1.1rem 1.15rem auto;
    display: flex;
    justify-content: space-between;
    color: color-mix(in srgb, #fff 82%, transparent);
  }

  .beat-art__orb {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: clamp(8rem, 17vw, 14rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, #fff 38%, transparent);
    border-radius: 50%;
    box-shadow: 0 0 0 1.5rem color-mix(in srgb, var(--ai-azure) 13%, transparent), 0 0 5rem color-mix(in srgb, var(--ai-azure) 40%, transparent);
    transform: translate(-50%, -50%);
  }

  .beat-art__orb::before,
  .beat-art__orb::after,
  .beat-art__orb i {
    position: absolute;
    width: 52%;
    height: 1px;
    border-radius: 999px;
    background: color-mix(in srgb, #fff 86%, transparent);
    content: "";
  }

  .beat-art__orb::before { transform: rotate(0deg); }
  .beat-art__orb::after { transform: rotate(60deg); }
  .beat-art__orb i:nth-child(1) { transform: rotate(120deg); }
  .beat-art__orb i:nth-child(2) { width: 23%; height: 23%; border-radius: 50%; background: var(--ai-coral); box-shadow: 0 0 1.8rem color-mix(in srgb, var(--ai-coral) 72%, transparent); }
  .beat-art__orb i:nth-child(n + 3) { display: none; }

  .beat-art__grid {
    position: absolute;
    inset: auto 1.1rem 1.35rem;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.34rem;
    height: 1.65rem;
    align-items: end;
  }

  .beat-art__grid i {
    display: block;
    height: var(--bar-height, 45%);
    border-radius: 999px;
    background: color-mix(in srgb, #fff 72%, transparent);
  }

  .beat-art__grid i:nth-child(2n) { --bar-height: 100%; background: var(--ai-coral); }
  .beat-art__grid i:nth-child(3n) { --bar-height: 68%; }
  .beat-art__grid i:nth-child(5n) { --bar-height: 30%; }

  .beat-art__track {
    top: 50%;
    left: 50%;
    color: #fff;
    font-size: clamp(1rem, 2.3vw, 1.65rem);
    line-height: 1.1;
    text-align: center;
    text-shadow: 0 0.2rem 1.2rem rgba(0, 0, 0, 0.28);
    transform: translate(-50%, -50%);
  }

  .project-preview__art--signal {
    color: var(--ai-fg);
    background:
      radial-gradient(circle at 50% 55%, color-mix(in srgb, var(--ai-azure) 18%, transparent), transparent 22%),
      linear-gradient(145deg, var(--ai-paper) 0%, color-mix(in srgb, var(--ai-bg) 78%, var(--ai-azure)) 100%);
  }

  .signal-art__case {
    top: 1.1rem;
    left: 1.15rem;
    color: var(--ai-azure);
  }

  .signal-art__room {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(16rem, 54%);
    height: 7.4rem;
    border: 2px solid color-mix(in srgb, var(--ai-slate-base) 72%, transparent);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--ai-paper) 66%, transparent);
    box-shadow: 0 1rem 2.4rem color-mix(in srgb, var(--ai-slate-base) 13%, transparent);
    transform: translate(-50%, -42%) perspective(30rem) rotateX(8deg);
  }

  .signal-art__room::before,
  .signal-art__room::after,
  .signal-art__room i,
  .signal-art__room b {
    position: absolute;
    display: block;
    border: 2px solid color-mix(in srgb, var(--ai-slate-base) 56%, transparent);
    content: "";
  }

  .signal-art__room::before { inset: 1.15rem 27% 2.5rem; border-radius: 0.3rem; background: color-mix(in srgb, var(--ai-azure) 18%, var(--ai-paper)); }
  .signal-art__room::after { right: 13%; bottom: 1.1rem; width: 18%; height: 0.7rem; border-radius: 999px; background: var(--ai-coral); }
  .signal-art__room i:nth-child(1) { left: 12%; bottom: 1.1rem; width: 14%; height: 1.2rem; border-radius: 0.2rem; }
  .signal-art__room i:nth-child(2) { left: 16%; bottom: 2.75rem; width: 5%; height: 0.4rem; border-radius: 999px; background: var(--ai-azure); }
  .signal-art__room i:nth-child(n + 3) { display: none; }
  .signal-art__room b { bottom: -2.2rem; left: 12%; width: 76%; height: 1.8rem; border-top: 0; transform: skewX(-35deg); }

  .signal-art__trace {
    position: absolute;
    top: 52%;
    left: 18%;
    width: 64%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--ai-coral) 20%, var(--ai-coral) 80%, transparent);
    box-shadow: 0 0 1.3rem color-mix(in srgb, var(--ai-coral) 58%, transparent);
  }

  .signal-art__status {
    right: 1.15rem;
    bottom: 1.2rem;
    color: color-mix(in srgb, var(--ai-fg) 72%, transparent);
  }

  .project-preview:hover,
  .project-preview:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--ai-azure) 38%, var(--ai-border-strong));
    box-shadow: 0 24px 58px color-mix(in srgb, var(--ai-slate-base) 16%, transparent);
    outline: 0;
  }

  .project-preview:hover img,
  .project-preview:focus-visible img {
    transform: scale(1.025);
  }

  .project-modal {
    position: fixed;
    inset: 50% auto auto 50%;
    width: min(92rem, calc(100vw - 2rem));
    max-width: none;
    height: min(52rem, calc(100dvh - 2rem));
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ai-fg);
    box-shadow: none;
    transform: translate(-50%, -50%);
  }

  .project-modal::backdrop {
    background: color-mix(in srgb, var(--ai-slate-base) 62%, transparent);
    backdrop-filter: blur(10px);
  }

  .project-modal__frame {
    position: relative;
    display: block;
    height: 100%;
    min-height: 0;
  }

  .project-modal__header {
    position: absolute;
    z-index: 20;
    top: 0.75rem;
    right: 0.75rem;
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .project-modal__header > div {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .project-modal__header p {
    margin: 0 0 0.2rem;
    color: var(--ai-coral);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-modal__header h3 {
    margin: 0;
    color: var(--ai-fg);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 850;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .project-modal__close {
    min-height: 2.4rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ai-border-strong) 76%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--ai-paper) 90%, transparent);
    color: var(--ai-fg);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 12px 32px color-mix(in srgb, var(--ai-slate-base) 18%, transparent);
    backdrop-filter: blur(14px);
  }

  .project-modal__close:hover,
  .project-modal__close:focus-visible {
    background: var(--ai-fg);
    color: var(--ai-bg);
    outline: none;
  }

  .project-modal__body {
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: 0;
    background: transparent;
  }

  .project-modal__body:focus {
    outline: none;
  }

  .project-modal__body :global(.drift-lab-section) {
    padding: 0;
    background: transparent;
  }

  .project-modal__body :global(.drift-lab-inner) {
    max-width: none;
  }

  .project-modal__body :global(.drift-lab-header),
  .project-modal__body :global(.drift-lab-note) {
    display: none;
  }

  .project-modal__body :global(.drift-lab-game) {
    max-height: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  @media (max-width: 860px) {
    .project-tools {
      grid-template-columns: 1fr;
    }

    .project-tool {
      min-height: 24rem;
    }

    .project-modal {
      width: calc(100vw - 1rem);
      height: calc(100dvh - 1rem);
    }

    .project-modal__header {
      top: 0.5rem;
      right: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-preview {
      transition: none;
    }

    .project-preview:hover,
    .project-preview:focus-visible {
      transform: none;
    }
  }
</style>
