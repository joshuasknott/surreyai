<section class="py-20 sm:py-24 px-6 bg-surface relative overflow-hidden border-b border-border-subtle">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_25%,rgba(6,182,212,0.08),transparent_30%),radial-gradient(circle_at_75%_15%,rgba(139,92,246,0.08),transparent_34%)] pointer-events-none"></div>

  <div class="mx-auto max-w-6xl relative z-10">
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-3 mb-5 border border-border-subtle px-3 py-1.5 bg-surface-card/40">
        <span class="w-2 h-2 bg-accent-blue shadow-[0_0_12px_rgba(6,182,212,0.8)]"></span>
        <span class="text-accent-blue text-xs font-bold font-mono-tech tracking-widest uppercase">
          About Us
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-5">
        What We Do
      </h2>
      <p class="text-text-secondary text-base sm:text-lg leading-relaxed max-w-2xl">
        Surrey Artificial Intelligence Society is a student-led community at the
        University of Surrey for learning, building, discussing, and applying
        artificial intelligence. We welcome students from every discipline and
        experience level.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6">
      <div class="group border border-border-subtle bg-surface-card/50 p-6 sm:p-8 hover:border-accent-blue/40 transition-all duration-300">
        <div class="w-12 h-12 flex items-center justify-center mb-5 border border-accent-blue/30 bg-accent-blue/10 text-accent-blue font-mono-tech font-bold text-lg">
          L
        </div>
        <h3 class="font-bold text-lg uppercase tracking-wide mb-3 text-text-primary">Learn</h3>
        <p class="text-text-secondary text-sm leading-relaxed">
          Beginner-friendly workshops on machine learning, generative AI, computer
          vision, and more. No prerequisites &mdash; just curiosity.
        </p>
      </div>

      <div class="group border border-border-subtle bg-surface-card/50 p-6 sm:p-8 hover:border-accent-purple/40 transition-all duration-300">
        <div class="w-12 h-12 flex items-center justify-center mb-5 border border-accent-purple/30 bg-accent-purple/10 text-accent-purple font-mono-tech font-bold text-lg">
          B
        </div>
        <h3 class="font-bold text-lg uppercase tracking-wide mb-3 text-text-primary">Build</h3>
        <p class="text-text-secondary text-sm leading-relaxed">
          Hands-on build nights, collaborative projects, and hackathons where you
          turn ideas into working prototypes alongside other students.
        </p>
      </div>

      <div class="group border border-border-subtle bg-surface-card/50 p-6 sm:p-8 hover:border-accent-blue-light/40 transition-all duration-300">
        <div class="w-12 h-12 flex items-center justify-center mb-5 border border-accent-blue-light/30 bg-accent-blue-light/10 text-accent-blue-light font-mono-tech font-bold text-lg">
          C
        </div>
        <h3 class="font-bold text-lg uppercase tracking-wide mb-3 text-text-primary">Connect</h3>
        <p class="text-text-secondary text-sm leading-relaxed">
          Join a welcoming community of AI-curious students, attend discussions on
          ethics and policy, and shape how AI is understood at Surrey.
        </p>
      </div>
    </div>
  </div>
</section>
