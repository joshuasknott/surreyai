---
const audiences = [
  {
    title: "Beginners",
    description:
      "Never touched AI? Most of our events are designed as starting points with no prerequisites.",
    icon: "\u25B7",
  },
  {
    title: "Builders",
    description:
      "Already code and want to apply your skills? Our build nights and project groups are for you.",
    icon: "\u2692",
  },
  {
    title: "Creatives",
    description:
      "Explore generative art, AI-powered music, creative writing tools, and design experiments.",
    icon: "\u2604",
  },
  {
    title: "Social Science & Policy",
    description:
      "Interested in ethics, regulation, or societal implications? We host discussions and panels on these topics.",
    icon: "\u2696",
  },
  {
    title: "Researchers",
    description:
      "Deepen your understanding, connect with like-minded students, and explore cutting-edge AI methods.",
    icon: "\u2316",
  },
  {
    title: "Entrepreneurs",
    description:
      "Discover how AI can power new ventures, automate workflows, and create competitive products.",
    icon: "\u2605",
  },
];
---

<section class="py-20 sm:py-24 px-6 bg-ai-surface relative overflow-hidden border-t border-ai-border">
  <div class="mx-auto max-w-7xl relative z-10">
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-5 text-ai-fg">
        Who It's For
      </h2>
      <p class="text-ai-fg-muted text-lg sm:text-xl leading-relaxed max-w-2xl">
        Whether you're studying computer science, business, psychology, law, or anything else &mdash; if you're curious about AI, you're welcome here.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {audiences.map((audience) => (
        <div class="bg-ai-bg border border-ai-border rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-ai-purple/10 flex items-center justify-center text-ai-purple text-xl" aria-hidden="true">
              {audience.icon}
            </div>
            <h3 class="font-semibold text-lg text-ai-fg">{audience.title}</h3>
          </div>
          <p class="text-ai-fg-muted text-base leading-relaxed">{audience.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
