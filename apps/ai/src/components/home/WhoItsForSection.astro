---

<section class="py-12 sm:py-16 px-6 bg-ai-surface relative overflow-hidden border-t border-ai-border">
  <div class="mx-auto max-w-7xl relative z-10">
    <div class="max-w-2xl mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3 text-ai-fg">
        Who It's For
      </h2>
      <p class="text-ai-fg-muted text-base leading-relaxed">
        Whether you're studying computer science, business, psychology, law, or anything else — if you're curious about AI, you're welcome here.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {audiences.map((audience) => (
        <div class="bg-ai-bg border border-ai-border rounded-xl p-6 hover:shadow-md transition-shadow">
          <div class:list={[audience.bg, "w-10 h-10 rounded-lg flex items-center justify-center mb-5"]} aria-hidden="true">
            <svg class:list={[audience.accent, "w-5 h-5"]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d={audience.iconPath} />
            </svg>
          </div>
          <h3 class="font-semibold text-base text-ai-fg mb-2">{audience.title}</h3>
          <p class="text-ai-fg-muted text-sm leading-relaxed">{audience.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
