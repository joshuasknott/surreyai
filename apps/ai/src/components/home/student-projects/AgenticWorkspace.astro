  @media (prefers-reduced-motion: reduce) {
    .aw-spinner,
    .aw-agent-node[data-state="active"] .aw-node-icon,
    .aw-agent-node[data-state="active"] + .aw-node-connector .aw-connector-pulse {
      animation: none;
    }
