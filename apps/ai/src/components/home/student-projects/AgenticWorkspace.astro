</style>

<script>
  type AgentStep = {
    thinking?: string;
    output?: string;
  };

  type WorkflowData = {
    planner?: AgentStep;
    researcher?: AgentStep;
    builder?: AgentStep;
    reviewer?: AgentStep;
  };

  type StreamEvent = {
    type?: string;
    agent?: keyof WorkflowData;
    step?: AgentStep;
    output?: WorkflowData;
    buildId?: string | null;
    source?: string;
    model?: string;
    error?: string;
  };

  const root = document.querySelector<HTMLElement>('[data-agentic-workspace]');

  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-aw-form]');
    const textarea = root.querySelector<HTMLTextAreaElement>('#aw-task');
    const count = root.querySelector<HTMLElement>('#aw-count');
    const submit = root.querySelector<HTMLButtonElement>('[data-aw-submit]');
    const status = root.querySelector<HTMLElement>('[data-aw-status]');
    const modelSelect = root.querySelector<HTMLSelectElement>('#aw-model-select');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-aw-tab]');
    const views = root.querySelectorAll<HTMLElement>('[data-aw-view]');
    const previewIframe = root.querySelector<HTMLIFrameElement>('[data-aw-preview-iframe]');
    const textResult = root.querySelector<HTMLElement>('[data-aw-text-result]');
    const shareButton = root.querySelector<HTMLButtonElement>('[data-aw-share]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-aw-copy]');
    const downloadButton = root.querySelector<HTMLButtonElement>('[data-aw-download]');
    const fullscreenButton = root.querySelector<HTMLButtonElement>('[data-aw-fullscreen]');
    const regenerateButton = root.querySelector<HTMLButtonElement>('[data-aw-regenerate]');
    const newButton = root.querySelector<HTMLButtonElement>('[data-aw-new]');

    const attachBtn = root.querySelector<HTMLButtonElement>('#aw-attach-btn');
    const attachmentsArea = root.querySelector<HTMLElement>('#aw-attachments');

    // Terminal log selector
    const consoleLog = root.querySelector<HTMLElement>('#aw-console-log');

    const stageMap = [
      { key: 'brief', agent: 'planner', title: 'Brief' },
      { key: 'plan', agent: 'researcher', title: 'Plan' },
      { key: 'create', agent: 'builder', title: 'Create' },
      { key: 'review', agent: 'reviewer', title: 'Review' },
    ];

    let workflowData: WorkflowData | null = null;
    let currentBuildId: string | null = null;
    const modelNames: Record<string, string> = {
      gemini37: 'Gemini 3.7 Flash',
      gemini31lite: 'Gemini 3.1 Flash Lite',
    };

    let selectedModelKey = modelSelect?.value || 'gemini37';
    let attachedFiles: File[] = [];

    const selectedModelName = () => modelNames[selectedModelKey] || modelNames.gemini37;

    const setAwState = (state: 'initial' | 'working' | 'complete') => {
      root.setAttribute('data-aw-state', state);
      root.setAttribute('aria-busy', String(state === 'working'));

      const initialView = root.querySelector<HTMLElement>('.aw-initial-view');
      const workingView = root.querySelector<HTMLElement>('.aw-working-view');
      const completeView = root.querySelector<HTMLElement>('.aw-canvas');

      if (initialView) initialView.hidden = state !== 'initial';
      if (workingView) workingView.hidden = state !== 'working';
      if (completeView) completeView.hidden = state !== 'complete';

      const spinner = root.querySelector('.aw-spinner');
      const sparkle = root.querySelector('.aw-brand-logo-svg');
      if (spinner && sparkle) {
        if (state === 'working') {
          spinner.removeAttribute('hidden');
          sparkle.setAttribute('hidden', '');
        } else {
          spinner.setAttribute('hidden', '');
          sparkle.removeAttribute('hidden');
        }
      }
    };

    const setStatus = (message: string, tone = '') => {
      if (!status) return;
      status.textContent = message;
      if (tone) {
        status.setAttribute('data-tone', tone);
      } else {
        status.removeAttribute('data-tone');
      }
    };

    const updateCount = () => {
      if (!textarea || !count) return;
      count.textContent = String(textarea.value.length);
    };

    const setLoading = (loading: boolean) => {
      if (submit) submit.disabled = loading;
      if (modelSelect) modelSelect.disabled = loading;
    };

    const switchView = (viewName: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.awTab === viewName;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });

      views.forEach((view) => {
        const active = view.dataset.awView === viewName;
        view.classList.toggle('is-active', active);
        view.hidden = !active;
      });
    };

    const setStage = (activeKey: string, completedKeys: string[] = []) => {
      const keyToNodeMap: Record<string, string> = {
        brief: 'planner',
        plan: 'researcher',
        create: 'builder',
        review: 'reviewer'
      };

      Object.entries(keyToNodeMap).forEach(([key, nodeName]) => {
        const node = root.querySelector<HTMLElement>(`[data-agent-node="${nodeName}"]`);
        if (!node) return;

        node.removeAttribute('data-state');
        const statusEl = node.querySelector('.aw-node-status');

        if (completedKeys.includes(key)) {
          node.setAttribute('data-state', 'done');
          if (statusEl) statusEl.textContent = 'Complete';
        } else if (key === activeKey) {
          node.setAttribute('data-state', 'active');
          if (statusEl) statusEl.textContent = 'Working...';
          appendConsoleLog(`\n[System] Agent ${nodeName.toUpperCase()} is now active.`);
        } else {
          if (statusEl) statusEl.textContent = 'Pending';
        }
      });
    };

    const stageForAgent = (agent?: keyof WorkflowData) => {
      return stageMap.find((stage) => stage.agent === agent);
    };

    const completedStageKeys = () => {
      return stageMap
         .filter((stage) => Boolean(workflowData?.[stage.agent as keyof WorkflowData]))
         .map((stage) => stage.key);
    };

    const trimText = (text = '', max = 250) => {
      const cleaned = text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
      if (cleaned.length <= max) return cleaned;
      return `${cleaned.slice(0, max - 3).trimEnd()}...`;
    };

    const appendConsoleLog = (message: string, isThinking = false) => {
      if (!consoleLog) return;

      const line = document.createElement('span');
      line.className = 'aw-log-line' + (isThinking ? ' is-thinking' : '');
      consoleLog.appendChild(line);

      if (isThinking) {
        const textLines = message.split('\n');
        let currentLineIdx = 0;

        const printNextLine = () => {
          if (currentLineIdx >= textLines.length) return;
          const subLine = document.createElement('div');
          subLine.className = 'aw-log-subline';
          subLine.textContent = `  > ${textLines[currentLineIdx]}`;
          line.appendChild(subLine);
          consoleLog.scrollTop = consoleLog.scrollHeight;
          currentLineIdx++;
          setTimeout(printNextLine, 40);
        };
        printNextLine();
      } else {
        line.textContent = message;
        consoleLog.scrollTop = consoleLog.scrollHeight;
      }
    };

    const clearConsoleLog = () => {
      if (!consoleLog) return;
      consoleLog.innerHTML = `<span class="aw-log-line opacity-50">> Initializing workspace environments...</span>`;
    };

    const renderStepList = () => {
      const stepListEl = root.querySelector('[data-aw-step-list]');
      if (!stepListEl || !workflowData) return;

      const stepsHtml = stageMap.map((stage) => {
        const step = workflowData?.[stage.agent as keyof WorkflowData];
        const status = step ? 'Complete' : 'Pending';
        const desc = step
          ? trimText(step.thinking || step.output || 'Completed.', 320)
          : `The builder will stream details for this agent once building starts.`;

        return `
          <article>
            <span>${stage.title} (${status})</span>
            <h3>${step ? 'Tasks completed' : 'Waiting...'}</h3>
            <p>${desc}</p>
          </article>
        `;
      }).join('');

      stepListEl.innerHTML = stepsHtml;
    };

    const resetPreview = () => {
      if (previewIframe) {
        previewIframe.srcdoc = '';
        previewIframe.hidden = true;
      }
      if (textResult) {
        textResult.textContent = '';
        textResult.hidden = true;
      }
    };

    const resetWorkspace = (clearPrompt = false) => {
      workflowData = null;
      currentBuildId = null;
      if (clearPrompt && textarea) textarea.value = '';
      updateCount();
      setLoading(false);
      setStatus('Builds in moments. Your prompt stays on this page.');
      setStage('brief', []);
      clearConsoleLog();

      attachedFiles = [];
      if (attachmentsArea) {
        attachmentsArea.innerHTML = '';
        attachmentsArea.setAttribute('hidden', '');
      }

      setAwState('initial');
      resetPreview();
      switchView('preview');
    };

    const getFinalCode = () => workflowData?.reviewer?.output || workflowData?.builder?.output || '';

    const syncShareUrl = () => {
      if (!currentBuildId) return window.location.href;
      const url = new URL(window.location.href);
      url.searchParams.set('build', currentBuildId);
      return url.toString();
    };

    const renderResult = (data: WorkflowData) => {
      workflowData = data;
      const finalCode = getFinalCode();
      const isHtml = /<!DOCTYPE html>|<html|<body|<style|<script/i.test(finalCode);

      if (isHtml && previewIframe) {
        previewIframe.srcdoc = finalCode;
        previewIframe.hidden = false;
        if (textResult) textResult.hidden = true;
        return;
      }

      if (textResult) {
        textResult.textContent = finalCode || 'The build completed, but no previewable result was returned.';
        textResult.hidden = false;
      }
      if (previewIframe) previewIframe.hidden = true;
    };

    const applyStreamEvent = (event: StreamEvent) => {
      if (event.type === 'stage-start') {
        const stage = stageForAgent(event.agent);
        if (stage) {
          setStage(stage.key, completedStageKeys());
          appendConsoleLog(`\n[Agent: ${stage.title}] Starting process...`);
        }
        return;
      }

      if (event.type === 'stage-complete' && event.agent && event.step) {
        workflowData = { ...(workflowData || {}), [event.agent]: event.step };
        const stage = stageForAgent(event.agent);
        if (stage) {
          setStage('', completedStageKeys());
          appendConsoleLog(`[Agent: ${stage.title}] Task complete.`);
          if (event.step.thinking) {
            appendConsoleLog(event.step.thinking, true);
          }
        }
        return;
      }

      if (event.type === 'complete') {
        workflowData = event.output || workflowData;
        currentBuildId = event.buildId || null;
        if (workflowData) {
          setStage('', stageMap.map((stage) => stage.key));
          renderResult(workflowData);
          renderStepList();
        }
        appendConsoleLog(`\n[System] Code generation completed successfully.`);
        appendConsoleLog(`[System] Launching app preview...`);

        setTimeout(() => {
          setAwState('complete');
          setStatus(currentBuildId ? 'Draft ready. Share link saved.' : 'Draft ready. Sharing is unavailable.', 'success');
        }, 1200);
        return;
      }

      if (event.type === 'error') {
        handleBuildError(event.error || 'Agentic Builder is unavailable right now.');
      }
    };

    const handleBuildError = (errorMessage: string) => {
      setLoading(false);

      const workingStatus = root.querySelector('#aw-working-status');
      if (workingStatus) {
        workingStatus.textContent = 'Build failed. Check the logs below.';
        (workingStatus as HTMLElement).style.color = 'var(--aw-coral)';
      }

      const activeNode = root.querySelector('.aw-agent-node[data-state="active"]');
      if (activeNode) {
        activeNode.setAttribute('data-state', 'error');
        const statusEl = activeNode.querySelector('.aw-node-status');
        if (statusEl) statusEl.textContent = 'Failed';
      }

      appendConsoleLog(`\n[Fatal Error] Build failed: ${errorMessage}`);
      appendConsoleLog(`[System] Process terminated abnormally.`);

      const errorActions = root.querySelector<HTMLElement>('#aw-error-actions');
      if (errorActions) {
        errorActions.hidden = false;
      }
    };

    const readWorkflowStream = async (response: Response) => {
      const reader = response.body?.getReader();
      if (!reader) {
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || 'Agentic Builder is unavailable right now.');
        applyStreamEvent({ type: 'complete', output: payload.output, buildId: payload.buildId, source: payload.source });
        return;
      }

      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (!line.trim()) continue;
          applyStreamEvent(JSON.parse(line) as StreamEvent);
        }
      }

      if (buffer.trim()) {
        applyStreamEvent(JSON.parse(buffer) as StreamEvent);
      }
    };

    const loadSharedBuild = async (buildId: string) => {
      setLoading(true);
      resetPreview();
      setStatus('Loading shared build.');
      setAwState('working');

      try {
        const response = await fetch(`/api/ai/agent-build?id=${encodeURIComponent(buildId)}`);
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || 'Build could not be loaded.');
        workflowData = payload.output || null;
        currentBuildId = buildId;
        if (textarea && typeof payload.task === 'string') textarea.value = payload.task;
        updateCount();
        if (workflowData) {
          renderResult(workflowData);
          renderStepList();
          setStage('', stageMap.map((stage) => stage.key));
        }
        setAwState('complete');
        setStatus('Shared draft loaded.', 'success');
      } catch {
        setStatus('Shared build could not be loaded.', 'error');
        setAwState('initial');
      } finally {
        setLoading(false);
      }
    };

    // Tabs Listeners
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        if (tab.dataset.awTab) switchView(tab.dataset.awTab);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-aw-example]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!textarea) return;
        textarea.value = button.dataset.awExample || '';
        updateCount();
        textarea.focus();
        setStatus('Example added. Start the build when ready.');
      });
    });

    textarea?.addEventListener('input', updateCount);
    modelSelect?.addEventListener('change', () => {
      selectedModelKey = modelSelect.value;
      setStatus(`${selectedModelName()} selected.`);
    });

    // Mock file input listener for actual file picking
    const fileInput = root.querySelector<HTMLInputElement>('#aw-file-input');

    attachBtn?.addEventListener('click', () => {
      fileInput?.click();
    });

    fileInput?.addEventListener('change', () => {
      if (!fileInput.files || !attachmentsArea) return;

      Array.from(fileInput.files).forEach((file) => {
        if (attachedFiles.some((f) => f.name === file.name)) return;

        attachedFiles.push(file);

        const chip = document.createElement('div');
        chip.className = 'aw-file-chip';
        chip.setAttribute('data-filename', file.name);

        const isImage = file.type.startsWith('image/');
        const iconHtml = isImage
          ? `<svg class="aw-clip-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
               <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375 0 11-.75 0 .375 0 01.75 0z" />
             </svg>`
          : `<svg class="aw-clip-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
               <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
             </svg>`;

        chip.innerHTML = `
          ${iconHtml}
          <span>${file.name}</span>
          <button type="button" class="aw-remove-file" aria-label="Remove file">x</button>
        `;

        chip.querySelector('.aw-remove-file')?.addEventListener('click', () => {
          chip.remove();
          attachedFiles = attachedFiles.filter((f) => f.name !== file.name);
          if (attachmentsArea.children.length === 0) {
            attachmentsArea.setAttribute('hidden', '');
          }
        });

        attachmentsArea.appendChild(chip);
        attachmentsArea.removeAttribute('hidden');
      });

      setStatus(`${fileInput.files.length} file(s) attached.`, 'success');
      fileInput.value = '';
    });

    const readFileAsBase64 = (file: File): Promise<{ mimeType: string; data: string }> =>
      new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const result = reader.result as string;
          const base64 = result.split(',')[1] || '';
          resolve({ mimeType: file.type || 'application/octet-stream', data: base64 });
        };
        reader.onerror = () => reject(new Error('Failed to read file'));
        reader.readAsDataURL(file);
      });

    // Form submission listener
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!textarea) return;

      const task = textarea.value.trim();
      if (task.length < 10) {
        setStatus('Add a little more detail before starting.', 'error');
        textarea.focus();
        return;
      }

      setLoading(true);
      workflowData = null;
      currentBuildId = null;
      resetPreview();
      clearConsoleLog();

      const workingTitle = root.querySelector('#aw-working-title');
      if (workingTitle) {
        workingTitle.textContent = task.length > 30 ? `${task.slice(0, 30)}...` : task;
      }

      // Hide error state triggers
      const errorActions = root.querySelector<HTMLElement>('#aw-error-actions');
      if (errorActions) errorActions.hidden = true;

      const workingStatus = root.querySelector('#aw-working-status');
      if (workingStatus) {
        workingStatus.textContent = 'Cooperative Multi-Agent Environment active...';
        (workingStatus as HTMLElement).style.color = '';
      }

      setAwState('working');
      setStage('brief', []);
      switchView('preview');
      setStatus(`${selectedModelName()} is building your draft.`);

      try {
        const filePayloads = await Promise.all(
          attachedFiles.slice(0, 5).filter((f) => f.size < 4_200_000).map(readFileAsBase64)
        );
        const response = await fetch('/api/ai/agent-workflow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ task, model: selectedModelKey, files: filePayloads }),
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          handleBuildError(payload.error || 'Agentic Builder is unavailable right now.');
          return;
        }

        await readWorkflowStream(response);
      } catch (err: any) {
        handleBuildError(err?.message || 'Network error. Please try again.');
      } finally {
        setLoading(false);
      }
    });

    newButton?.addEventListener('click', () => resetWorkspace(true));

    // Error recovery triggers
    const errorBackBtn = root.querySelector('#aw-error-back-btn');
    const errorRetryBtn = root.querySelector('#aw-error-retry-btn');

    errorBackBtn?.addEventListener('click', () => {
      setAwState('initial');
      setStatus('Prompt restored. Edit and try again.');
    });

    errorRetryBtn?.addEventListener('click', () => {
      form?.requestSubmit();
    });

    regenerateButton?.addEventListener('click', () => {
      form?.requestSubmit();
    });

    copyButton?.addEventListener('click', async () => {
      const code = getFinalCode();
      if (!code) {
        setStatus('Build something first, then copy the HTML.', 'error');
        return;
      }

      try {
        await navigator.clipboard.writeText(code);
        setStatus('Generated HTML copied.', 'success');
      } catch {
        setStatus('Copy failed. Try downloading instead.', 'error');
      }
    });

    downloadButton?.addEventListener('click', () => {
      const code = getFinalCode();
      if (!code) {
        setStatus('Build something first, then download it.', 'error');
        return;
      }

      const blob = new Blob([code], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'agentic-builder-draft.html';
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus('HTML download started.', 'success');
    });

    fullscreenButton?.addEventListener('click', () => {
      const code = getFinalCode();
      if (!code) {
        setStatus('Build something first, then open it full screen.', 'error');
        return;
      }

      const preview = window.open('', '_blank', 'noopener,noreferrer');
      if (!preview) {
        setStatus('Full screen preview was blocked by the browser.', 'error');
        return;
      }
      preview.document.open();
      preview.document.write(code);
      preview.document.close();
      setStatus('Full screen preview opened.', 'success');
    });

    shareButton?.addEventListener('click', async () => {
      const shareText = textarea?.value.trim()
        ? `Agentic Builder draft: ${textarea.value.trim()}`
        : 'Agentic Builder on Surrey AI Society';
      const shareUrl = syncShareUrl();

      try {
        if (navigator.share) {
          await navigator.share({
            title: 'Agentic Builder',
            text: shareText,
            url: shareUrl,
          });
          setStatus('Share sheet opened.', 'success');
          return;
        }

        await navigator.clipboard.writeText(`${shareText}\n${shareUrl}`);
        setStatus('Share link copied.', 'success');
      } catch {
        setStatus('Share was cancelled.');
      }
    });

    updateCount();

    const sharedBuildId = new URL(window.location.href).searchParams.get('build');
    if (sharedBuildId) {
      loadSharedBuild(sharedBuildId);
    }
  }
</script>
