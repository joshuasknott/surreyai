  .aw-examples button[data-tone="coral"] .aw-example-icon { background: color-mix(in srgb, var(--aw-coral) 12%, var(--aw-surface)); color: var(--aw-coral); }
  .aw-examples button[data-tone="sage"] .aw-example-icon { background: color-mix(in srgb, #79a95f 17%, var(--aw-surface)); color: #5d8c49; }
  .aw-examples button[data-tone="azure"] .aw-example-icon { background: color-mix(in srgb, #4d9ee8 15%, var(--aw-surface)); color: #2d80c7; }

