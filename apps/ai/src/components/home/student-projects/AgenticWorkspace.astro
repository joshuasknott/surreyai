    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
    flex: 1;
  }

  [data-aw-text-result] {
    white-space: pre-wrap;
    color: var(--aw-text);
    font: 0.9rem/1.6 var(--font-mono);
    padding: 1.5rem;
    margin: 0;
    overflow: auto;
    height: 100%;
    background: var(--aw-surface-soft);
  }

  .aw-step-list {
    display: grid;
    gap: 0.75rem;
    max-width: 58rem;
    margin: 0 auto;
    width: 100%;
  }

  .aw-step-list article {
    padding: 1rem 1.25rem;
    border: 1px solid var(--aw-line);
