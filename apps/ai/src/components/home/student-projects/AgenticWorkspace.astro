---
---

<section data-agentic-workspace class="aw-root" aria-label="Student Project: Agentic Workspace visual simulation">
  <div class="aw-shell">
    <div class="aw-orb aw-orb--sage"></div>
    <div class="aw-orb aw-orb--azure"></div>
    <div class="aw-orb aw-orb--coral"></div>

    <header class="aw-header">
      <span class="aw-badge">Frontend visual simulation</span>
      <h2 class="aw-title">Agentic Workspace</h2>
      <p class="aw-subtitle">
        A cinematic mock workspace showing planner, researcher, builder, and reviewer agents passing tasks through a shared project canvas.
      </p>
      <p class="aw-disclaimer">Purely visual prototype. No live agents, no API calls, no autonomous execution.</p>
    </header>

    <div class="aw-stage" aria-label="Animated agent flowchart">
      <div class="aw-grid-bg" aria-hidden="true"></div>
      <svg class="aw-lines" viewBox="0 0 1200 620" role="presentation" aria-hidden="true">
        <defs>
          <linearGradient id="aw-line-main" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--ai-sage)" />
            <stop offset="52%" stop-color="var(--ai-azure)" />
            <stop offset="100%" stop-color="var(--ai-coral)" />
          </linearGradient>
          <filter id="aw-line-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <path class="aw-path aw-path--one" d="M178 178 C 330 82, 486 82, 604 210" />
        <path class="aw-path aw-path--two" d="M604 210 C 744 78, 920 88, 1022 178" />
        <path class="aw-path aw-path--three" d="M1022 178 C 930 364, 748 408, 604 332" />
        <path class="aw-path aw-path--four" d="M604 332 C 456 454, 282 422, 178 338" />
        <path class="aw-path aw-path--five" d="M178 338 C 322 568, 842 568, 1022 338" />
      </svg>

      <div class="aw-hub" aria-label="Shared workspace canvas">
        <div class="aw-hub-ring"></div>
        <div class="aw-hub-core">
          <span>Shared Canvas</span>
          <strong>Project State</strong>
          <small>brief -> tasks -> draft -> review</small>
        </div>
        <div class="aw-mini-card aw-mini-card--brief">Mission brief</div>
        <div class="aw-mini-card aw-mini-card--tasks">Task board</div>
        <div class="aw-mini-card aw-mini-card--risk">Risk note</div>
      </div>

      <article class="aw-agent aw-agent--planner">
        <span class="aw-agent-kicker">01</span>
        <h3>Planner Agent</h3>
        <p>Decomposes the goal into milestones, owners, and handoff points.</p>
      </article>

      <article class="aw-agent aw-agent--researcher">
        <span class="aw-agent-kicker">02</span>
        <h3>Researcher Agent</h3>
        <p>Surfaces constraints, assumptions, context, and missing evidence.</p>
      </article>

      <article class="aw-agent aw-agent--builder">
        <span class="aw-agent-kicker">03</span>
        <h3>Builder Agent</h3>
        <p>Turns the plan into draft artifacts, checklists, and working notes.</p>
      </article>

      <article class="aw-agent aw-agent--reviewer">
        <span class="aw-agent-kicker">04</span>
        <h3>Reviewer Agent</h3>
        <p>Flags risks, checks quality, and prepares a human handoff.</p>
      </article>

      <div class="aw-packet aw-packet--one">Planner decomposed goal</div>
      <div class="aw-packet aw-packet--two">Researcher found constraints</div>
      <div class="aw-packet aw-packet--three">Builder drafted artifact</div>
      <div class="aw-packet aw-packet--four">Reviewer flagged risk</div>
      <div class="aw-packet aw-packet--five">Human handoff ready</div>

      <div class="aw-event aw-event--one">
        <span></span>
        Goal split into tasks
      </div>
      <div class="aw-event aw-event--two">
        <span></span>
        Evidence attached
      </div>
      <div class="aw-event aw-event--three">
        <span></span>
        Draft created
      </div>
      <div class="aw-event aw-event--four">
        <span></span>
        Review queued
      </div>
    </div>
  </div>
</section>

<style>
  .aw-root {
    --aw-panel: color-mix(in srgb, var(--ai-surface) 90%, transparent);
    --aw-panel-soft: color-mix(in srgb, var(--ai-surface) 76%, transparent);
    --aw-text: var(--ai-fg);
    --aw-muted: var(--ai-fg-muted);
    --aw-line: var(--ai-border);
    height: 100%;
    overflow: hidden;
    color: var(--aw-text);
  }

  :global(:root[data-theme="dark"]) .aw-root {
    --aw-panel: rgba(19, 26, 43, 0.78);
    --aw-panel-soft: rgba(15, 23, 42, 0.58);
    --aw-text: #F8FAFC;
    --aw-muted: #CBD5E1;
    --aw-line: rgba(226, 232, 240, 0.13);
  }

  .aw-shell {
    position: relative;
    width: min(100%, 78rem);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    isolation: isolate;
    overflow: hidden;
  }

  .aw-shell::before {
    content: "";
    position: absolute;
    inset: -2rem -1.5rem;
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 18% 12%, color-mix(in srgb, var(--ai-sage) 12%, transparent), transparent 30%),
      radial-gradient(circle at 82% 8%, color-mix(in srgb, var(--ai-azure) 12%, transparent), transparent 28%),
      var(--ai-bg);
    z-index: -3;
  }

  .aw-orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(90px);
    opacity: 0.18;
    pointer-events: none;
    z-index: -2;
  }

  .aw-orb--sage {
    width: 30rem;
    height: 30rem;
    top: 8rem;
    left: -10rem;
    background: var(--ai-sage);
  }

  .aw-orb--azure {
    width: 28rem;
    height: 28rem;
    right: -8rem;
    top: -6rem;
    background: var(--ai-azure);
  }

  .aw-orb--coral {
    width: 22rem;
    height: 22rem;
    right: 15%;
    bottom: -8rem;
    background: var(--ai-coral);
  }

  .aw-header {
    max-width: 54rem;
    padding-right: 5.5rem;
    margin-bottom: 0;
  }

  .aw-badge {
    display: inline-flex;
    margin-bottom: 0.75rem;
    color: var(--ai-sage);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .aw-title {
    margin: 0;
    color: var(--aw-text);
    font-size: clamp(2.1rem, 4vw, 3.75rem);
    font-weight: 850;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .aw-subtitle {
    margin: 0.7rem 0 0;
    color: var(--aw-muted);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.45;
  }

  .aw-disclaimer {
    display: inline-flex;
    margin: 0.7rem 0 0;
    padding: 0.52rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--ai-coral) 28%, var(--aw-line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-coral) 8%, var(--aw-panel-soft));
    color: var(--aw-muted);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .aw-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--aw-line);
    border-radius: 2rem;
    background:
      linear-gradient(145deg, var(--aw-panel), var(--aw-panel-soft)),
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--ai-sage) 10%, transparent), transparent 42%);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), 0 26px 80px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(18px);
  }

  .aw-grid-bg {
    position: absolute;
    inset: 0;
    opacity: 0.42;
    background-image:
      linear-gradient(var(--aw-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--aw-line) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle at 50% 48%, black, transparent 78%);
  }

  .aw-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .aw-path {
    fill: none;
    stroke: url(#aw-line-main);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 10 14;
    opacity: 0.64;
    filter: url(#aw-line-glow);
    animation: aw-drift-lines 8s linear infinite;
  }

  .aw-path--two { animation-delay: -1.4s; }
  .aw-path--three { animation-delay: -2.8s; }
  .aw-path--four { animation-delay: -4.2s; }
  .aw-path--five { animation-delay: -5.6s; opacity: 0.42; }

  .aw-hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(23rem, 34vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .aw-hub-ring {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--ai-sage) 36%, var(--aw-line));
    border-radius: 999px;
    background:
      radial-gradient(circle, color-mix(in srgb, var(--ai-sage) 10%, transparent), transparent 62%),
      conic-gradient(from 90deg, color-mix(in srgb, var(--ai-sage) 35%, transparent), color-mix(in srgb, var(--ai-azure) 30%, transparent), color-mix(in srgb, var(--ai-coral) 28%, transparent), color-mix(in srgb, var(--ai-sage) 35%, transparent));
    opacity: 0.48;
    animation: aw-rotate 24s linear infinite;
  }

  .aw-hub-core {
    position: absolute;
    inset: 18%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.35rem;
    border: 1px solid var(--aw-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-bg) 76%, transparent);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.18);
    text-align: center;
  }

  .aw-hub-core span,
  .aw-mini-card,
  .aw-agent-kicker {
    color: var(--ai-sage);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .aw-hub-core strong {
    color: var(--aw-text);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .aw-hub-core small {
    max-width: 11rem;
    color: var(--aw-muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .aw-mini-card {
    position: absolute;
    padding: 0.62rem 0.78rem;
    border: 1px solid var(--aw-line);
    border-radius: 0.9rem;
    background: var(--aw-panel);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.13);
    animation: aw-pop-card 7.5s ease-in-out infinite;
  }

  .aw-mini-card--brief {
    left: -1.5rem;
    top: 22%;
  }

  .aw-mini-card--tasks {
    right: -1.8rem;
    top: 44%;
    color: var(--ai-azure);
    animation-delay: -2.4s;
  }

  .aw-mini-card--risk {
    left: 26%;
    bottom: -0.8rem;
    color: var(--ai-coral);
    animation-delay: -4.8s;
  }

  .aw-agent {
    position: absolute;
    width: min(18rem, 25vw);
    min-height: 9.5rem;
    padding: 1.1rem;
    overflow: hidden;
    border: 1px solid var(--aw-line);
    border-radius: 1.4rem;
    background: linear-gradient(145deg, var(--aw-panel), color-mix(in srgb, var(--aw-panel-soft) 88%, transparent));
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), 0 18px 55px rgba(0, 0, 0, 0.15);
    animation: aw-agent-breathe 7s ease-in-out infinite;
  }

  .aw-agent::after {
    content: "";
    position: absolute;
    width: 8rem;
    height: 8rem;
    right: -3rem;
    bottom: -3.5rem;
    border-radius: 999px;
    background: var(--agent-color, var(--ai-sage));
    filter: blur(32px);
    opacity: 0.16;
  }

  .aw-agent--planner {
    --agent-color: var(--ai-sage);
    left: 4%;
    top: 9%;
  }

  .aw-agent--researcher {
    --agent-color: var(--ai-azure);
    right: 4%;
    top: 9%;
    animation-delay: -1.75s;
  }

  .aw-agent--builder {
    --agent-color: var(--ai-coral);
    right: 4%;
    bottom: 9%;
    animation-delay: -3.5s;
  }

  .aw-agent--reviewer {
    --agent-color: var(--ai-sage);
    left: 4%;
    bottom: 9%;
    animation-delay: -5.25s;
  }

  .aw-agent-kicker {
    color: var(--agent-color, var(--ai-sage));
  }

  .aw-agent h3 {
    margin: 0.45rem 0;
    color: var(--aw-text);
    font-size: 1.15rem;
    font-weight: 850;
    letter-spacing: -0.03em;
  }

  .aw-agent p {
    margin: 0;
    color: var(--aw-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .aw-packet {
    position: absolute;
    z-index: 5;
    max-width: 15rem;
    padding: 0.58rem 0.72rem;
    border: 1px solid color-mix(in srgb, var(--packet-color, var(--ai-sage)) 36%, var(--aw-line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--aw-panel) 92%, transparent);
    color: var(--aw-text);
    box-shadow: 0 14px 34px color-mix(in srgb, var(--packet-color, var(--ai-sage)) 13%, transparent);
    font-size: 0.8rem;
    font-weight: 800;
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(0.92);
    animation: aw-task-pulse 10s ease-in-out infinite;
  }

  .aw-packet::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 999px;
    background: var(--packet-color, var(--ai-sage));
    box-shadow: 0 0 16px var(--packet-color, var(--ai-sage));
  }

  .aw-packet--one {
    --packet-color: var(--ai-sage);
    left: 25%;
    top: 18%;
    animation-delay: 0s;
  }

  .aw-packet--two {
    --packet-color: var(--ai-azure);
    right: 25%;
    top: 18%;
    animation-delay: -8s;
  }

  .aw-packet--three {
    --packet-color: var(--ai-coral);
    right: 23%;
    bottom: 22%;
    animation-delay: -6s;
  }

  .aw-packet--four {
    --packet-color: var(--ai-sage);
    left: 24%;
    bottom: 22%;
    animation-delay: -4s;
  }

  .aw-packet--five {
    --packet-color: var(--ai-azure);
    left: 50%;
    bottom: 7%;
    transform-origin: center;
    animation-delay: -2s;
  }

  .aw-event {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--aw-line);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--ai-bg) 62%, transparent);
    color: var(--aw-muted);
    font-size: 0.78rem;
    font-weight: 800;
    opacity: 0;
    animation: aw-event-pop 8s ease-in-out infinite;
  }

  .aw-event span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--ai-sage);
  }

  .aw-event--one {
    left: 16%;
    top: 39%;
  }

  .aw-event--two {
    right: 15%;
    top: 40%;
    animation-delay: -6s;
  }

  .aw-event--three {
    right: 26%;
    bottom: 39%;
    animation-delay: -4s;
  }

  .aw-event--four {
    left: 26%;
    bottom: 39%;
    animation-delay: -2s;
  }

  @keyframes aw-drift-lines {
    to { stroke-dashoffset: -96; }
  }

  @keyframes aw-rotate {
    to { transform: rotate(360deg); }
  }

  @keyframes aw-agent-breathe {
    0%, 100% { transform: translateY(0); border-color: var(--aw-line); }
    50% { transform: translateY(-5px); border-color: color-mix(in srgb, var(--agent-color, var(--ai-sage)) 42%, var(--aw-line)); }
  }

  @keyframes aw-task-pulse {
    0%, 8% { opacity: 0; transform: translateY(10px) scale(0.92); }
    14%, 34% { opacity: 1; transform: translateY(0) scale(1); }
    42%, 100% { opacity: 0; transform: translateY(-12px) scale(0.96); }
  }

  @keyframes aw-event-pop {
    0%, 18% { opacity: 0; transform: translateY(8px) scale(0.94); }
    24%, 42% { opacity: 1; transform: translateY(0) scale(1); }
    52%, 100% { opacity: 0; transform: translateY(-8px) scale(0.96); }
  }

  @keyframes aw-pop-card {
    0%, 100% { transform: translateY(0); opacity: 0.74; }
    50% { transform: translateY(-6px); opacity: 1; }
  }

  @media (max-width: 980px) {
    .aw-hub {
      width: min(19rem, 34vw);
    }

    .aw-agent {
      width: min(17rem, 36vw);
      min-height: 8.5rem;
      padding: 0.95rem;
    }

    .aw-agent--planner { left: 5%; top: 5%; }
    .aw-agent--researcher { right: 5%; top: 5%; }
    .aw-agent--builder { right: 5%; bottom: 5%; }
    .aw-agent--reviewer { left: 5%; bottom: 5%; }

    .aw-packet--one { left: 12%; top: 29%; }
    .aw-packet--two { right: 12%; top: 29%; }
    .aw-packet--three { right: 10%; bottom: 29%; }
    .aw-packet--four { left: 10%; bottom: 29%; }
  }

  @media (max-width: 680px) {
    .aw-header {
      padding-right: 3.8rem;
    }

    .aw-subtitle,
    .aw-disclaimer {
      display: none;
    }

    .aw-stage {
      border-radius: 1.35rem;
    }

    .aw-lines {
      opacity: 0.42;
    }

    .aw-hub {
      top: 50%;
      width: min(13rem, 52vw);
    }

    .aw-agent {
      left: auto;
      right: auto;
      width: min(10.5rem, 40vw);
      min-height: 7.3rem;
      padding: 0.72rem;
      transform: none;
    }

    .aw-agent h3 {
      font-size: 0.95rem;
    }

    .aw-agent p {
      font-size: 0.74rem;
      line-height: 1.28;
    }

    .aw-agent--planner { left: 0.75rem; top: 0.75rem; }
    .aw-agent--researcher { right: 0.75rem; top: 0.75rem; }
    .aw-agent--builder { right: 0.75rem; bottom: 0.75rem; }
    .aw-agent--reviewer { left: 0.75rem; bottom: 0.75rem; }

    .aw-packet,
    .aw-event {
      max-width: calc(100% - 2rem);
      font-size: 0.7rem;
    }

    .aw-packet--one { left: 28%; top: 30%; }
    .aw-packet--two { right: 20%; top: 36%; }
    .aw-packet--three { right: 18%; bottom: 34%; }
    .aw-packet--four { left: 18%; bottom: 30%; }
    .aw-packet--five { left: 36%; bottom: 17%; }

    .aw-event--one { left: 8%; top: 45%; }
    .aw-event--two { right: 7%; top: 45%; }
    .aw-event--three { right: 10%; bottom: 45%; }
    .aw-event--four { left: 10%; bottom: 45%; }

    @keyframes aw-agent-breathe {
      0%, 100% { transform: translateY(0); border-color: var(--aw-line); }
      50% { transform: translateY(-3px); border-color: color-mix(in srgb, var(--agent-color, var(--ai-sage)) 42%, var(--aw-line)); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aw-path,
    .aw-hub-ring,
    .aw-agent,
    .aw-packet,
    .aw-event,
    .aw-mini-card {
      animation: none;
    }

    .aw-packet,
    .aw-event {
      opacity: 1;
      transform: none;
    }
  }
</style>
