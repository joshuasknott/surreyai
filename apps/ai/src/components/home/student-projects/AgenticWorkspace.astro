---
import BrandMark from "../../common/BrandMark.astro";
import { ArrowUp, BookOpen, CalendarDays, ChevronDown, Paperclip, UsersRound } from "lucide-astro";
---

<section data-agentic-workspace class="aw-root" data-aw-state="initial" aria-label="Student Project: Agentic Builder">
  <header class="aw-topbar">
    <div class="aw-brand">
      <div class="aw-logo-container">
        <span class="aw-spinner" aria-hidden="true" hidden></span>
        <BrandMark size="small" />
      </div>
      <div>
        <h2>Agentic Builder</h2>
        <p class="aw-brand-desc">Surrey Artificial Intelligence Society</p>
      </div>
    </div>

    <div class="aw-ready" aria-label="Four AI roles ready">
      <span class="aw-ready-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span>4 roles ready</span>
    </div>

    <div class="aw-top-actions" aria-label="Builder actions">
      <button type="button" class="aw-action-btn" data-aw-new>New Build</button>
      <button type="button" class="aw-action-btn" data-aw-regenerate>Regenerate</button>
      <button type="button" class="aw-action-btn aw-btn-highlight" data-aw-copy>Copy HTML</button>
      <button type="button" class="aw-action-btn" data-aw-download>Download</button>
      <button type="button" class="aw-action-btn" data-aw-fullscreen>Full Screen</button>
      <button type="button" class="aw-action-btn" data-aw-share>Share</button>
    </div>
  </header>

  <!-- 1. INITIAL STATE: Minimalist Prompt UI -->
  <div class="aw-initial-view">
    <div class="aw-showcase-brand">
      <img
        src="/logos/brand/surrey-ai-logo-transparent.png"
        alt="Surrey Artificial Intelligence Society"
        width="1320"
        height="360"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="aw-hero">
      <h2>What should we build?</h2>
      <p>Describe an app, page, tool, or experiment.</p>
    </div>

    <form data-aw-form class="aw-chat-box-form" novalidate>
      <div class="aw-chat-container">
        <textarea
          id="aw-task"
          name="task"
          maxlength="600"
          placeholder="A calm study timer that grows a tiny garden..."
          required
        ></textarea>

        <!-- Attached Files Area -->
        <div id="aw-attachments" class="aw-attachments-area" hidden>
          <!-- Mock file chips appear here dynamically -->
        </div>

        <div class="aw-chat-controls">
          <div class="aw-left-controls">
            <button type="button" id="aw-attach-btn" class="aw-control-btn aw-attach-icon-btn" aria-label="Add files or photos">
              <Paperclip aria-hidden="true" />
            </button>
            <input type="file" id="aw-file-input" style="display: none;" multiple />

            <label class="aw-sr-only" for="aw-model-select">AI model</label>
            <span class="aw-model-pill">
              <select id="aw-model-select" name="model" aria-label="AI model">
                <option value="gemini37">Gemini 3.7 Flash</option>
                <option value="gemini31lite">Gemini 3.1 Flash Lite</option>
              </select>
              <ChevronDown class="aw-model-chevron" aria-hidden="true" />
            </span>
          </div>

          <div class="aw-right-controls">
            <span class="aw-char-count"><span id="aw-count">0</span>/600</span>
            <button type="submit" id="aw-submit-btn" class="aw-send-btn" data-aw-submit aria-label="Start build">
              <span class="aw-send-icon" aria-hidden="true"><ArrowUp /></span>
              <span>Build prototype</span>
            </button>
          </div>
        </div>
      </div>
    </form>

    <div class="aw-examples-row">
      <span>Try an example</span>
      <div class="aw-examples" aria-label="Example prompts">
        <button type="button" data-tone="coral" data-aw-example="An event planner for my society that lets people browse events, RSVP, and get reminders.">
          <span class="aw-example-icon" aria-hidden="true"><CalendarDays /></span>
          <span>Event planner</span>
        </button>
        <button type="button" data-tone="sage" data-aw-example="A revision tracker that helps students plan topics, track confidence, and review weak areas.">
          <span class="aw-example-icon" aria-hidden="true"><BookOpen /></span>
          <span>Study tracker</span>
        </button>
        <button type="button" data-tone="azure" data-aw-example="A simple club landing page with events, committee details, and a join call to action.">
          <span class="aw-example-icon" aria-hidden="true"><UsersRound /></span>
          <span>Club page</span>
        </button>
      </div>
    </div>

    <p class="aw-status-text aw-sr-only" data-aw-status aria-live="polite">Builds in moments. Your prompt stays on this page.</p>
  </div>

  <!-- 2. WORKING STATE: Impressive Agent Collaborative Visualization -->
  <div class="aw-working-view" hidden>
    <div class="aw-work-header">
      <h3>Building: <span id="aw-working-title">Your application</span></h3>
      <p id="aw-working-status">Cooperative Multi-Agent Environment active...</p>

      <!-- Error Actions -->
      <div id="aw-error-actions" class="aw-error-actions" hidden>
        <button type="button" class="aw-action-btn" id="aw-error-back-btn">Edit Prompt</button>
        <button type="button" class="aw-action-btn aw-btn-highlight" id="aw-error-retry-btn">Retry Build</button>
      </div>
    </div>

    <!-- Agent Nodes Visualization -->
    <div class="aw-agents-grid">
      <!-- Node 1: Planner -->
      <div class="aw-agent-node" data-agent-node="planner">
        <div class="aw-node-glow"></div>
        <div class="aw-node-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <span class="aw-node-label">Planner Agent</span>
        <span class="aw-node-status">Pending</span>
      </div>

      <!-- Connector 1 -->
      <div class="aw-node-connector">
        <div class="aw-connector-line"></div>
        <div class="aw-connector-pulse"></div>
      </div>

      <!-- Node 2: Researcher -->
      <div class="aw-agent-node" data-agent-node="researcher">
        <div class="aw-node-glow"></div>
        <div class="aw-node-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <span class="aw-node-label">Researcher Agent</span>
        <span class="aw-node-status">Pending</span>
      </div>

      <!-- Connector 2 -->
      <div class="aw-node-connector">
        <div class="aw-connector-line"></div>
        <div class="aw-connector-pulse"></div>
      </div>

      <!-- Node 3: Developer -->
      <div class="aw-agent-node" data-agent-node="builder">
        <div class="aw-node-glow"></div>
        <div class="aw-node-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
          </svg>
        </div>
        <span class="aw-node-label">Developer Agent</span>
        <span class="aw-node-status">Pending</span>
      </div>

      <!-- Connector 3 -->
      <div class="aw-node-connector">
        <div class="aw-connector-line"></div>
        <div class="aw-connector-pulse"></div>
      </div>

      <!-- Node 4: Reviewer -->
      <div class="aw-agent-node" data-agent-node="reviewer">
        <div class="aw-node-glow"></div>
        <div class="aw-node-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <span class="aw-node-label">Reviewer Agent</span>
        <span class="aw-node-status">Pending</span>
      </div>
    </div>

    <!-- Live Console Output -->
    <div class="aw-console">
      <div class="aw-console-header">
        <div class="aw-console-dots">
          <span class="aw-dot-red"></span>
          <span class="aw-dot-yellow"></span>
          <span class="aw-dot-green"></span>
        </div>
        <span class="aw-console-title">agent_thinking_log.sh</span>
      </div>
      <div id="aw-console-log" class="aw-console-body">
        <!-- Live streams appear here -->
        <span class="aw-log-line opacity-50">> Initializing workspace environments...</span>
      </div>
    </div>
  </div>

  <!-- 3. COMPLETE STATE: Interactive Preview & Source tabs -->
  <div class="aw-canvas" hidden>
    <div class="aw-tabs-row">
      <div class="aw-tabs" role="tablist" aria-label="Builder views">
        <button type="button" id="aw-tab-preview" class="is-active" role="tab" aria-selected="true" aria-controls="aw-view-preview" data-aw-tab="preview">
          Preview
        </button>
        <button type="button" id="aw-tab-steps" role="tab" aria-selected="false" aria-controls="aw-view-steps" data-aw-tab="steps">
          Build steps
        </button>
      </div>
    </div>

    <section id="aw-view-preview" class="aw-view is-active" role="tabpanel" aria-labelledby="aw-tab-preview" data-aw-view="preview">
      <div class="aw-preview-frame">
        <iframe
          data-aw-preview-iframe
          title="Agentic Builder generated preview"
          sandbox="allow-forms allow-modals allow-popups allow-scripts"
          hidden
        ></iframe>
        <pre data-aw-text-result hidden></pre>
      </div>
    </section>

    <section id="aw-view-steps" class="aw-view" role="tabpanel" aria-labelledby="aw-tab-steps" data-aw-view="steps" hidden>
      <div class="aw-step-list" data-aw-step-list>
        <!-- Rendered steps -->
      </div>
    </section>
  </div>
</section>

<style>
  .aw-root {
    --aw-bg: var(--ai-bg);
    --aw-surface: var(--ai-surface);
    --aw-surface-soft: var(--ai-paper-soft);
    --aw-line: var(--ai-border);
    --aw-line-strong: var(--ai-border-strong);
    --aw-text: var(--ai-fg);
    --aw-muted: var(--ai-fg-muted);
    --aw-blue: var(--ai-fg);
    --aw-green: var(--ai-sage);
    --aw-coral: var(--ai-coral);
    --aw-button-text: var(--ai-bg);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at 10% 18%, color-mix(in srgb, var(--ai-coral) 9%, transparent), transparent 27rem),
      radial-gradient(circle at 86% 82%, color-mix(in srgb, var(--ai-azure) 10%, transparent), transparent 31rem),
      linear-gradient(145deg, var(--aw-surface), color-mix(in srgb, var(--aw-bg) 82%, var(--ai-azure)));
    color: var(--aw-text);
    font-family: var(--font-sans);
    isolation: isolate;
  }

  .aw-root::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.35;
    background-image: radial-gradient(color-mix(in srgb, var(--aw-text) 24%, transparent) 0.7px, transparent 0.7px);
    background-size: 25px 25px;
    mask-image: linear-gradient(135deg, #000, transparent 75%);
    content: "";
  }

  .aw-root[data-aw-state="initial"] {
    background:
      radial-gradient(circle at 55% 60%, color-mix(in srgb, var(--aw-coral) 8%, transparent), transparent 30rem),
      linear-gradient(145deg, #fdfbf7, #fff8f3);
  }

  /* ── State visibility rules ── */
  .aw-root[data-aw-state="initial"] .aw-topbar .aw-top-actions {
    display: none;
  }
  .aw-root[data-aw-state="initial"] .aw-topbar {
    display: none;
  }
  .aw-root[data-aw-state="initial"] .aw-initial-view {
    display: flex;
  }
  .aw-root[data-aw-state="initial"] .aw-working-view,
  .aw-root[data-aw-state="initial"] .aw-canvas {
    display: none;
  }

  .aw-root[data-aw-state="working"] .aw-topbar .aw-top-actions {
    display: none;
  }
  .aw-root[data-aw-state="working"] .aw-initial-view,
  .aw-root[data-aw-state="working"] .aw-canvas {
    display: none;
  }
  .aw-root[data-aw-state="working"] .aw-working-view {
    display: flex;
  }

  .aw-root[data-aw-state="complete"] .aw-topbar .aw-top-actions {
    display: flex;
  }
  .aw-root[data-aw-state="complete"] .aw-initial-view,
  .aw-root[data-aw-state="complete"] .aw-working-view {
    display: none;
  }
  .aw-root[data-aw-state="complete"] .aw-canvas {
    display: flex;
  }

  /* ── Header Topbar styling ── */
  .aw-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 4rem;
    padding: 0.65rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--aw-line);
    background: color-mix(in srgb, var(--aw-surface) 82%, transparent);
    flex: 0 0 auto;
    z-index: 10;
    backdrop-filter: blur(18px);
  }

  .aw-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .aw-brand > div {
    min-width: 0;
  }

  .aw-logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--aw-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--aw-surface) 82%, transparent);
    color: var(--aw-blue);
    flex: 0 0 auto;
  }

  .aw-logo-container :global(.brand-mark) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .aw-brand h2 {
    margin: 0;
    color: var(--aw-text);
    font-size: 1.25rem;
    font-weight: 850;
    line-height: 1.1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .aw-brand-desc {
    margin: 0.15rem 0 0;
    color: var(--aw-muted);
    font-size: 0.78rem;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .aw-spinner {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    border: 2px solid var(--aw-line);
    border-top-color: var(--aw-blue);
    animation: awSpin 1s linear infinite;
  }

  .aw-ready {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--aw-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--aw-surface) 70%, transparent);
    color: var(--aw-muted);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .aw-ready-dots { display: flex; }
  .aw-ready-dots i {
    width: 0.43rem;
    height: 0.43rem;
    margin-left: -0.08rem;
    border: 1px solid var(--aw-surface);
    border-radius: 50%;
    background: var(--aw-blue);
  }
  .aw-ready-dots i:nth-child(2) { background: var(--aw-coral); }
  .aw-ready-dots i:nth-child(3) { background: var(--aw-green); }
  .aw-ready-dots i:nth-child(4) { background: var(--ai-azure); }
  .aw-root[data-aw-state="complete"] .aw-ready { display: none; }

  .aw-top-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .aw-action-btn {
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 800;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--aw-line-strong);
    background: var(--aw-surface);
    color: var(--aw-text);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
  }

  .aw-action-btn:hover {
    background: var(--aw-surface-soft);
    border-color: var(--aw-text);
    transform: translateY(-1px);
  }

  .aw-btn-highlight {
    background: var(--aw-blue);
    color: var(--aw-button-text);
    border-color: var(--aw-blue);
  }

  .aw-btn-highlight:hover {
    background: color-mix(in srgb, var(--aw-text) 92%, var(--aw-bg));
    border-color: var(--aw-blue);
    color: var(--aw-button-text);
  }

  /* ── INITIAL STATE: Society showcase canvas ── */
  .aw-initial-view {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex: 1;
    min-height: 0;
    width: 100%;
    margin: 0 auto;
    padding: clamp(10.5rem, 23.25vh, 15.35rem) clamp(1.5rem, 5vw, 5rem) clamp(2.5rem, 7vh, 5rem);
    overflow-y: auto;
    isolation: isolate;
  }

  .aw-initial-view::before {
    position: absolute;
    z-index: -1;
    inset: 16% 18% 6%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 48% 48%, color-mix(in srgb, var(--aw-coral) 7%, transparent), transparent 44%),
      radial-gradient(circle at 60% 56%, color-mix(in srgb, #f6b884 10%, transparent), transparent 56%);
    filter: blur(22px);
    content: "";
    pointer-events: none;
  }

  .aw-showcase-brand {
    position: absolute;
    top: clamp(1.5rem, 3vw, 2.5rem);
    left: clamp(1.5rem, 3vw, 3rem);
    width: clamp(13rem, 20vw, 19.5rem);
  }

  .aw-showcase-brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .aw-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .aw-hero h2 {
    margin: 0;
    color: var(--aw-text);
    font-size: clamp(3rem, 4.9vw, 5rem);
    font-weight: 850;
    letter-spacing: -0.068em;
    line-height: 0.96;
  }

  .aw-hero p {
    margin: 1.25rem 0 0;
    color: color-mix(in srgb, var(--aw-muted) 90%, var(--aw-text));
    font-size: clamp(1.05rem, 1.55vw, 1.35rem);
    line-height: 1.45;
  }

  .aw-chat-box-form {
    width: min(100%, 58rem);
    margin-top: 2rem;
  }

  .aw-chat-container {
    width: 100%;
    padding: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--aw-coral) 26%, var(--aw-line));
    border-radius: 24px;
    background: color-mix(in srgb, var(--aw-surface) 94%, transparent);
    box-shadow:
      0 28px 76px color-mix(in srgb, var(--ai-slate-base) 14%, transparent),
      0 8px 28px color-mix(in srgb, var(--aw-coral) 10%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    gap: 0;
    transition: border-color 0.2s, box-shadow 0.2s;
    backdrop-filter: blur(18px);
  }

  .aw-chat-container:focus-within {
    border-color: color-mix(in srgb, var(--aw-coral) 66%, var(--aw-line));
    box-shadow:
      0 30px 84px color-mix(in srgb, var(--ai-slate-base) 15%, transparent),
      0 10px 32px color-mix(in srgb, var(--aw-coral) 18%, transparent),
      0 0 0 4px color-mix(in srgb, var(--aw-coral) 8%, transparent);
  }

  .aw-chat-container textarea {
    width: 100%;
    min-height: 11.5rem;
    max-height: 13rem;
    padding: 1.55rem 1.45rem 1.25rem;
    border: 0;
    background: transparent;
    color: var(--aw-text);
    font: inherit;
    font-size: 1.2rem;
    line-height: 1.5;
    resize: none;
    outline: none;
  }

  .aw-chat-container textarea::placeholder {
    color: var(--aw-muted);
    opacity: 0.65;
  }

  .aw-chat-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0.55rem 0.15rem;
    padding: 0.95rem 0.3rem 0.25rem;
    border-top: 1px solid color-mix(in srgb, var(--aw-line) 90%, transparent);
  }

  .aw-left-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .aw-control-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border-radius: 12px;
    border: 1px solid var(--aw-line);
    background: var(--aw-surface);
    color: var(--aw-text);
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .aw-control-btn:hover {
    border-color: var(--aw-coral);
    background: color-mix(in srgb, var(--aw-coral) 6%, var(--aw-surface));
    color: var(--aw-coral);
  }

  .aw-attach-icon-btn {
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .aw-attach-icon-btn svg {
    width: 1.18rem;
    height: 1.18rem;
    stroke-width: 1.9;
  }

  .aw-model-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-width: 14rem;
    min-height: 3.5rem;
    padding: 0;
    border: 1px solid var(--aw-line);
    border-radius: 12px;
    background: var(--aw-surface);
    color: var(--aw-text);
    font-size: 0.82rem;
    font-weight: 750;
    white-space: nowrap;
    transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s;
  }

  .aw-model-pill:hover {
    border-color: color-mix(in srgb, var(--aw-coral) 45%, var(--aw-line));
    background: color-mix(in srgb, var(--aw-coral) 4%, var(--aw-surface));
  }

  .aw-model-pill:focus-within {
    border-color: var(--aw-coral);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--aw-coral) 12%, transparent);
  }

  .aw-model-pill select {
    width: 100%;
    min-width: 0;
