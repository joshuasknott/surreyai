---
---

<section data-agentic-workspace class="aw-root" aria-label="Student Project: Agentic Builder">
  <header class="aw-topbar">
    <div class="aw-brand">
      <span class="aw-spinner" aria-hidden="true"></span>
      <div>
        <h2>Agentic Builder</h2>
        <p>Describe what you want to make. The builder turns it into a working draft.</p>
      </div>
    </div>

    <div class="aw-top-actions" aria-label="Builder actions">
      <span class="aw-model-note">Powered by Gemini 3 Flash</span>
      <button type="button" class="aw-ghost-btn" data-aw-regenerate>Regenerate</button>
      <button type="button" class="aw-ghost-btn" data-aw-copy>Copy HTML</button>
      <button type="button" class="aw-ghost-btn" data-aw-download>Download</button>
      <button type="button" class="aw-ghost-btn" data-aw-fullscreen>Full screen</button>
      <button type="button" class="aw-ghost-btn" data-aw-share>Share</button>
      <button type="button" class="aw-ghost-btn" data-aw-new>New build</button>
      <button type="button" class="aw-ghost-btn" data-aw-close>Close</button>
    </div>
  </header>

  <div class="aw-shell">
    <aside class="aw-composer" aria-label="Build setup">
      <form data-aw-form class="aw-form" novalidate>
        <div class="aw-field-head">
          <label for="aw-task">What should we build?</label>
          <span id="aw-count">0/600</span>
        </div>

        <textarea
          id="aw-task"
          name="task"
          maxlength="600"
          rows="6"
          placeholder="An event planner for my society that lets people browse events, RSVP, and get reminders."
          required
        ></textarea>

        <div class="aw-examples" aria-label="Example prompts">
          <button type="button" data-aw-example="An event planner for my society that lets people browse events, RSVP, and get reminders.">
            Event planner
          </button>
          <button type="button" data-aw-example="A revision tracker that helps students plan topics, track confidence, and review weak areas.">
            Study tracker
          </button>
          <button type="button" data-aw-example="A simple club landing page with events, committee details, and a join call to action.">
            Club page
          </button>
        </div>

        <button type="submit" class="aw-primary-btn" data-aw-submit>Start build</button>
        <p class="aw-help" data-aw-status aria-live="polite">Builds in moments. Your prompt stays on this page.</p>
      </form>

      <div class="aw-progress" aria-label="Build progress">
        <h3>Build progress</h3>
        <ol>
          <li data-aw-stage="brief" data-state="done">
            <span class="aw-stage-dot" aria-hidden="true"></span>
            <div>
              <strong>Brief</strong>
              <p>We understand what you want to build.</p>
            </div>
          </li>
          <li data-aw-stage="plan">
            <span class="aw-stage-dot" aria-hidden="true"></span>
            <div>
              <strong>Plan</strong>
              <p>We map the useful pieces.</p>
            </div>
          </li>
          <li data-aw-stage="create">
            <span class="aw-stage-dot" aria-hidden="true"></span>
            <div>
              <strong>Create</strong>
              <p>We build the first working draft.</p>
            </div>
          </li>
          <li data-aw-stage="review">
            <span class="aw-stage-dot" aria-hidden="true"></span>
            <div>
              <strong>Review</strong>
              <p>We check and refine the result.</p>
            </div>
          </li>
        </ol>
      </div>
    </aside>

    <main class="aw-canvas" aria-label="Builder output">
      <div class="aw-tabs" role="tablist" aria-label="Builder views">
        <button type="button" id="aw-tab-preview" class="is-active" role="tab" aria-selected="true" aria-controls="aw-view-preview" data-aw-tab="preview">
          Preview
        </button>
        <button type="button" id="aw-tab-steps" role="tab" aria-selected="false" aria-controls="aw-view-steps" data-aw-tab="steps">
          Build steps
        </button>
      </div>

      <section id="aw-view-preview" class="aw-view is-active" role="tabpanel" aria-labelledby="aw-tab-preview" data-aw-view="preview">
        <div class="aw-preview-frame">
          <div class="aw-preview-placeholder" data-aw-preview-placeholder>
            <div class="aw-empty-preview" role="status">
              <span class="aw-empty-mark" aria-hidden="true"></span>
              <h3>Tell Agentic Builder what to make.</h3>
              <p>
                Add a short brief on the left, then start a build. Your generated app or tool will appear here when it is ready.
              </p>
            </div>
          </div>

          <iframe
            data-aw-preview-iframe
            title="Agentic Builder generated preview"
            sandbox="allow-forms allow-modals allow-popups allow-scripts"
            hidden
          ></iframe>
          <pre data-aw-text-result hidden></pre>
        </div>
      </section>

      <section id="aw-view-steps" class="aw-view" role="tabpanel" aria-labelledby="aw-tab-steps" data-aw-view="steps" hidden>
        <div class="aw-step-list" data-aw-step-list>
          <article data-step-card="planner">
            <span>Brief</span>
            <h3>Ready for your prompt</h3>
            <p>Add a short description and start a build to see each step here.</p>
          </article>
          <article data-step-card="researcher">
            <span>Plan</span>
            <h3>Waiting</h3>
            <p>The builder will turn your prompt into a simple plan.</p>
          </article>
          <article data-step-card="builder">
            <span>Create</span>
            <h3>Waiting</h3>
            <p>Your first working draft will appear in Preview.</p>
          </article>
          <article data-step-card="reviewer">
            <span>Review</span>
            <h3>Waiting</h3>
            <p>The builder checks the draft before handing it back.</p>
          </article>
        </div>
      </section>
    </main>

    <aside class="aw-guidance" aria-label="Build updates">
      <h3>What’s happening</h3>
      <div class="aw-update-list" data-aw-updates>
        <article>
          <span class="aw-update-mark" aria-hidden="true"></span>
          <div>
            <strong>Ready when you are</strong>
            <p>Describe a small app, page, or tool and start the build.</p>
          </div>
        </article>
        <article>
          <span class="aw-update-mark is-muted" aria-hidden="true"></span>
          <div>
            <strong>Preview stays central</strong>
            <p>The working draft will render in the main canvas.</p>
          </div>
        </article>
      </div>
      <div class="aw-next-action" data-aw-next-action>
        <strong>Next up</strong>
        <p>Try the event planner example or write your own brief.</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .aw-root {
    --aw-bg: #f7f8f3;
    --aw-surface: #ffffff;
    --aw-surface-soft: #eef2ef;
    --aw-line: #dce4e0;
    --aw-line-strong: #bfcbc8;
    --aw-text: #172329;
    --aw-muted: #5e6c70;
    --aw-blue: #3f6d80;
    --aw-green: #617c65;
    --aw-coral: #a9674b;
    --aw-button-text: #ffffff;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--aw-bg);
    color: var(--aw-text);
    font-family: var(--font-sans);
  }

  :global(#project-modal:has([data-agentic-workspace]) .close-modal-btn) {
    display: none;
  }

  .aw-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 5.25rem;
    padding: 1.35rem clamp(1.1rem, 2.4vw, 2rem);
    border-bottom: 1px solid var(--aw-line);
    background: color-mix(in srgb, var(--aw-surface) 74%, transparent);
  }

  .aw-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  .aw-brand h2 {
    margin: 0;
    color: var(--aw-text);
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .aw-brand p,
  .aw-help,
  .aw-progress p,
  .aw-guidance p,
  .aw-step-list p {
    margin: 0;
    color: var(--aw-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .aw-spinner {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    border: 3px solid color-mix(in srgb, var(--aw-green) 18%, transparent);
    border-top-color: var(--aw-green);
    flex: 0 0 auto;
    animation: awSpin 1.1s linear infinite;
  }

  .aw-top-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .aw-model-note {
    color: var(--aw-muted);
    font-size: 0.85rem;
    padding-right: 0.55rem;
    margin-right: 0.2rem;
    border-right: 1px solid var(--aw-line);
    white-space: nowrap;
  }

  .aw-ghost-btn,
  .aw-tabs button,
  .aw-examples button {
    font: inherit;
  }

  .aw-ghost-btn {
    min-height: 2.35rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--aw-text);
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 700;
    padding: 0.55rem 0.78rem;
  }

  .aw-ghost-btn:hover,
  .aw-ghost-btn:focus-visible {
    background: var(--aw-surface-soft);
    border-color: var(--aw-line);
  }

  .aw-shell {
    display: grid;
    grid-template-columns: minmax(17rem, 22rem) minmax(0, 1fr) minmax(16rem, 19.5rem);
    min-height: 0;
    flex: 1;
  }

  .aw-composer,
  .aw-canvas,
  .aw-guidance {
    min-width: 0;
    min-height: 0;
  }

  .aw-composer {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    overflow-y: auto;
    padding: clamp(1.1rem, 2vw, 1.7rem);
    border-right: 1px solid var(--aw-line);
  }

  .aw-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .aw-field-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .aw-field-head label,
  .aw-progress h3,
  .aw-guidance h3 {
    color: var(--aw-text);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .aw-field-head span {
    color: var(--aw-muted);
    font-size: 0.78rem;
  }

  .aw-form textarea {
    width: 100%;
    min-height: 10.75rem;
    resize: vertical;
    border: 1px solid var(--aw-line-strong);
    border-radius: 0.8rem;
    background: var(--aw-surface);
    color: var(--aw-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.55;
    padding: 1rem;
  }

  .aw-form textarea:focus {
    border-color: var(--aw-blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--aw-blue) 16%, transparent);
    outline: none;
  }

  .aw-examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .aw-examples button {
    border: 1px solid var(--aw-line);
    border-radius: 999px;
    background: var(--aw-surface);
    color: var(--aw-text);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.52rem 0.72rem;
  }

  .aw-examples button:hover,
  .aw-examples button:focus-visible {
    border-color: var(--aw-blue);
    color: var(--aw-blue);
    outline: none;
  }

  .aw-primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.15rem;
    border: 1px solid color-mix(in srgb, var(--aw-blue) 35%, transparent);
    border-radius: 0.8rem;
    background: var(--aw-blue);
    color: var(--aw-button-text);
    cursor: pointer;
    font: inherit;
    font-size: 1rem;
    font-weight: 800;
    padding: 0.9rem 1rem;
  }

  .aw-primary-btn:hover,
  .aw-primary-btn:focus-visible {
    background: color-mix(in srgb, var(--aw-blue) 90%, #000);
    outline: none;
  }

  .aw-primary-btn:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .aw-help[data-tone="error"] {
    color: var(--aw-coral);
  }

  .aw-help[data-tone="success"] {
    color: var(--aw-green);
  }

  .aw-progress {
    padding-top: 1.4rem;
    border-top: 1px solid var(--aw-line);
  }

  .aw-progress h3,
  .aw-guidance h3 {
    margin: 0 0 1rem;
  }

  .aw-progress ol {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .aw-progress li {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    padding: 0 0 1.35rem;
  }

  .aw-progress li::before {
    content: "";
    position: absolute;
    left: 0.71rem;
    top: 1.75rem;
    bottom: 0.25rem;
    width: 1px;
    background: var(--aw-line-strong);
  }

  .aw-progress li:last-child::before {
    display: none;
  }

  .aw-stage-dot {
    width: 1.45rem;
    height: 1.45rem;
    border: 2px solid var(--aw-line-strong);
    border-radius: 999px;
    background: var(--aw-bg);
    margin-top: 0.15rem;
  }

  .aw-progress li[data-state="done"] .aw-stage-dot,
  .aw-progress li[data-state="active"] .aw-stage-dot {
    border-color: var(--aw-green);
    background: var(--aw-green);
    box-shadow: inset 0 0 0 5px var(--aw-bg);
  }

  .aw-progress li[data-state="active"] .aw-stage-dot {
    animation: awPulse 1.2s ease-in-out infinite;
  }

  .aw-progress li[data-state="done"]::before {
    background: var(--aw-green);
  }

  .aw-progress strong {
    display: block;
    color: var(--aw-text);
    font-size: 0.98rem;
    font-weight: 800;
    margin-bottom: 0.2rem;
  }

  .aw-canvas {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: color-mix(in srgb, var(--aw-bg) 88%, var(--aw-surface));
  }

  .aw-tabs {
    display: flex;
    align-items: stretch;
    gap: 1.6rem;
    min-height: 5.25rem;
    padding: 0 2.25rem;
    border-bottom: 1px solid var(--aw-line);
    background: color-mix(in srgb, var(--aw-surface) 38%, transparent);
  }

  .aw-tabs button {
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--aw-text);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.3rem 0;
  }

  .aw-tabs button.is-active {
    border-color: var(--aw-blue);
    color: var(--aw-blue);
  }

  .aw-tabs button:focus-visible {
    outline: 2px solid var(--aw-blue);
    outline-offset: 5px;
  }

  .aw-view {
    min-height: 0;
    flex: 1;
    overflow: auto;
    padding: clamp(1.2rem, 2.7vw, 2.3rem);
  }

  .aw-view[hidden] {
    display: none;
  }

  .aw-preview-frame {
    min-height: 100%;
    border: 1px solid var(--aw-line);
    border-radius: 0.9rem;
    background: var(--aw-surface);
    overflow: hidden;
  }

  .aw-preview-frame iframe {
    display: block;
    width: 100%;
    min-height: 720px;
    border: 0;
    background: #fff;
  }

  .aw-text-result {
    margin: 0;
  }

  [data-aw-text-result] {
    white-space: pre-wrap;
    color: var(--aw-text);
    font: 0.95rem/1.6 var(--font-sans);
    padding: 1.5rem;
  }

  .aw-preview-placeholder {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 100%;
    padding: clamp(1.2rem, 2.6vw, 1.9rem);
  }

  .aw-empty-preview {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    width: min(100%, 31rem);
    margin: auto;
    color: var(--aw-text);
    text-align: center;
  }

  .aw-empty-mark {
    width: 3.25rem;
    height: 3.25rem;
    border: 2px solid color-mix(in srgb, var(--aw-green) 28%, transparent);
    border-top-color: var(--aw-green);
    border-radius: 999px;
  }

  .aw-empty-preview h3 {
    margin: 0;
    color: var(--aw-text);
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    font-weight: 850;
    line-height: 1.1;
  }

  .aw-empty-preview p {
    margin: 0;
    color: var(--aw-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .aw-step-list {
    display: grid;
    gap: 0;
    max-width: 58rem;
    border: 1px solid var(--aw-line);
    border-radius: 0.9rem;
    background: var(--aw-surface);
    overflow: hidden;
  }

  .aw-step-list article {
    padding: 1.2rem 1.35rem;
    border-bottom: 1px solid var(--aw-line);
  }

  .aw-step-list article:last-child {
    border-bottom: 0;
  }

  .aw-step-list span {
    display: block;
    color: var(--aw-green);
    font-size: 0.82rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }

  .aw-step-list h3 {
    margin: 0 0 0.35rem;
    color: var(--aw-text);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .aw-guidance {
    overflow-y: auto;
    padding: clamp(1.1rem, 2vw, 1.7rem);
    border-left: 1px solid var(--aw-line);
  }

  .aw-update-list {
    display: grid;
    gap: 1.4rem;
  }

  .aw-update-list article {
    display: grid;
    grid-template-columns: 1.65rem 1fr;
    gap: 0.85rem;
  }

  .aw-update-mark {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--aw-green);
    box-shadow: inset 0 0 0 5px var(--aw-bg);
    margin-top: 0.1rem;
  }

  .aw-update-mark.is-muted {
    background: var(--aw-line-strong);
  }

  .aw-update-list strong,
  .aw-next-action strong {
    display: block;
    color: var(--aw-text);
    font-size: 0.96rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .aw-next-action {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--aw-line);
  }

  @keyframes awSpin {
    to { transform: rotate(360deg); }
  }

  @keyframes awPulse {
    50% { box-shadow: inset 0 0 0 4px var(--aw-bg), 0 0 0 6px color-mix(in srgb, var(--aw-green) 12%, transparent); }
  }

  @media (max-width: 1120px) {
    .aw-shell {
      grid-template-columns: minmax(16rem, 21rem) minmax(0, 1fr);
    }

    .aw-guidance {
      display: none;
    }
  }

  @media (max-width: 780px) {
    .aw-root {
      overflow: auto;
    }

    .aw-topbar,
    .aw-shell {
      display: flex;
      flex-direction: column;
    }

    .aw-topbar {
      align-items: stretch;
    }

    .aw-top-actions {
      justify-content: flex-start;
    }

    .aw-model-note {
      width: 100%;
      border-right: 0;
      padding: 0 0 0.35rem;
    }

    .aw-composer,
    .aw-guidance {
      border: 0;
    }

    .aw-canvas {
      min-height: 42rem;
    }

    .aw-tabs {
      min-height: 4rem;
      padding: 0 1.25rem;
    }

    .aw-view {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aw-spinner,
    .aw-progress li[data-state="active"] .aw-stage-dot {
      animation: none;
    }
  }
</style>

<script>
  type AgentStep = {
    thinking?: string;
    output?: string;
  };

  type WorkflowData = {
    planner?: AgentStep;
    researcher?: AgentStep;
    builder?: AgentStep;
    reviewer?: AgentStep;
  };

  type StreamEvent = {
    type?: string;
    agent?: keyof WorkflowData;
    step?: AgentStep;
    output?: WorkflowData;
    buildId?: string | null;
    source?: string;
    model?: string;
    error?: string;
  };

  const root = document.querySelector<HTMLElement>('[data-agentic-workspace]');

  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-aw-form]');
    const textarea = root.querySelector<HTMLTextAreaElement>('#aw-task');
    const count = root.querySelector<HTMLElement>('#aw-count');
    const submit = root.querySelector<HTMLButtonElement>('[data-aw-submit]');
    const status = root.querySelector<HTMLElement>('[data-aw-status]');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-aw-tab]');
    const views = root.querySelectorAll<HTMLElement>('[data-aw-view]');
    const stageItems = root.querySelectorAll<HTMLElement>('[data-aw-stage]');
    const stepCards = root.querySelectorAll<HTMLElement>('[data-step-card]');
    const updates = root.querySelector<HTMLElement>('[data-aw-updates]');
    const nextAction = root.querySelector<HTMLElement>('[data-aw-next-action]');
    const previewPlaceholder = root.querySelector<HTMLElement>('[data-aw-preview-placeholder]');
    const previewIframe = root.querySelector<HTMLIFrameElement>('[data-aw-preview-iframe]');
    const textResult = root.querySelector<HTMLElement>('[data-aw-text-result]');
    const shareButton = root.querySelector<HTMLButtonElement>('[data-aw-share]');
    const copyButton = root.querySelector<HTMLButtonElement>('[data-aw-copy]');
    const downloadButton = root.querySelector<HTMLButtonElement>('[data-aw-download]');
    const fullscreenButton = root.querySelector<HTMLButtonElement>('[data-aw-fullscreen]');
    const regenerateButton = root.querySelector<HTMLButtonElement>('[data-aw-regenerate]');
    const newButton = root.querySelector<HTMLButtonElement>('[data-aw-new]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-aw-close]');

    const stageMap = [
      { key: 'brief', agent: 'planner', title: 'Brief' },
      { key: 'plan', agent: 'researcher', title: 'Plan' },
      { key: 'create', agent: 'builder', title: 'Create' },
      { key: 'review', agent: 'reviewer', title: 'Review' },
    ];

    let workflowData: WorkflowData | null = null;
    let currentBuildId: string | null = null;

    const setStatus = (message: string, tone = '') => {
      if (!status) return;
      status.textContent = message;
      if (tone) {
        status.setAttribute('data-tone', tone);
      } else {
        status.removeAttribute('data-tone');
      }
    };

    const updateCount = () => {
      if (!textarea || !count) return;
      count.textContent = `${textarea.value.length}/600`;
    };

    const setLoading = (loading: boolean) => {
      if (!submit) return;
      submit.disabled = loading;
      submit.textContent = loading ? 'Building...' : 'Start build';
    };

    const switchView = (viewName: string) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.awTab === viewName;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });

      views.forEach((view) => {
        const active = view.dataset.awView === viewName;
        view.classList.toggle('is-active', active);
        view.hidden = !active;
      });
    };

    const setStage = (activeKey: string, completedKeys: string[] = []) => {
      stageItems.forEach((item) => {
        const key = item.dataset.awStage || '';
        item.removeAttribute('data-state');
        if (completedKeys.includes(key)) item.setAttribute('data-state', 'done');
        if (key === activeKey) item.setAttribute('data-state', 'active');
      });
    };

    const stageForAgent = (agent?: keyof WorkflowData) => {
      return stageMap.find((stage) => stage.agent === agent);
    };

    const completedStageKeys = () => {
      return stageMap
        .filter((stage) => Boolean(workflowData?.[stage.agent as keyof WorkflowData]))
        .map((stage) => stage.key);
    };

    const trimText = (text = '', max = 250) => {
      const cleaned = text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
      if (cleaned.length <= max) return cleaned;
      return `${cleaned.slice(0, max - 3).trimEnd()}...`;
    };

    const resetStepCards = () => {
      const defaults = {
        planner: ['Ready for your prompt', 'Add a short description and start a build to see each step here.'],
        researcher: ['Waiting', 'The builder will turn your prompt into a simple plan.'],
        builder: ['Waiting', 'Your first working draft will appear in Preview.'],
        reviewer: ['Waiting', 'The builder checks the draft before handing it back.'],
      };

      stepCards.forEach((card) => {
        const key = card.dataset.stepCard as keyof typeof defaults;
        const copy = defaults[key];
        const heading = card.querySelector('h3');
        const body = card.querySelector('p');
        if (heading && copy) heading.textContent = copy[0];
        if (body && copy) body.textContent = copy[1];
      });
    };

    const resetPreview = () => {
      previewPlaceholder?.removeAttribute('hidden');
      if (previewIframe) {
        previewIframe.srcdoc = '';
        previewIframe.hidden = true;
      }
      if (textResult) {
        textResult.textContent = '';
        textResult.hidden = true;
      }
    };

    const resetWorkspace = (clearPrompt = false) => {
      workflowData = null;
      currentBuildId = null;
      if (clearPrompt && textarea) textarea.value = '';
      updateCount();
      setLoading(false);
      setStatus('Builds in moments. Your prompt stays on this page.');
      setStage('brief', []);
      resetStepCards();
      resetPreview();
      updateGuidance('Ready when you are', 'Describe a small app, page, or tool and start the build.', 'Preview stays central', 'The working draft will render in the main canvas.', 'Try an example or write your own brief.');
      switchView('preview');
    };

    const getFinalCode = () => workflowData?.reviewer?.output || workflowData?.builder?.output || '';

    const syncShareUrl = () => {
      if (!currentBuildId) return window.location.href;
      const url = new URL(window.location.href);
      url.searchParams.set('build', currentBuildId);
      return url.toString();
    };

    const updateGuidance = (
      firstTitle: string,
      firstBody: string,
      secondTitle: string,
      secondBody: string,
      next: string
    ) => {
      if (updates) {
        updates.innerHTML = `
          <article>
            <span class="aw-update-mark" aria-hidden="true"></span>
            <div>
              <strong>${firstTitle}</strong>
              <p>${firstBody}</p>
            </div>
          </article>
          <article>
            <span class="aw-update-mark is-muted" aria-hidden="true"></span>
            <div>
              <strong>${secondTitle}</strong>
              <p>${secondBody}</p>
            </div>
          </article>
        `;
      }

      if (nextAction) {
        nextAction.innerHTML = `<strong>Next up</strong><p>${next}</p>`;
      }
    };

    const updateStepCard = (agent: keyof WorkflowData, title: string, step?: AgentStep) => {
      const card = root.querySelector<HTMLElement>(`[data-step-card="${agent}"]`);
      if (!card) return;
      const heading = card.querySelector('h3');
      const body = card.querySelector('p');
      if (heading) heading.textContent = title;
      if (body) body.textContent = trimText(step?.thinking || step?.output || 'Completed.', 320);
    };

    const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    const animateStages = async (data: WorkflowData) => {
      const completed: string[] = [];

      for (const stage of stageMap) {
        setStage(stage.key, completed);
        updateStepCard(stage.agent as keyof WorkflowData, `${stage.title} complete`, data[stage.agent as keyof WorkflowData]);
        await delay(420);
        completed.push(stage.key);
      }

      setStage('', completed);
    };

    const renderResult = (data: WorkflowData) => {
      workflowData = data;
      const finalCode = getFinalCode();
      const isHtml = /<!DOCTYPE html>|<html|<body|<style|<script/i.test(finalCode);

      previewPlaceholder?.setAttribute('hidden', '');

      if (isHtml && previewIframe) {
        previewIframe.srcdoc = finalCode;
        previewIframe.hidden = false;
        if (textResult) textResult.hidden = true;
        return;
      }

      if (textResult) {
        textResult.textContent = finalCode || 'The build completed, but no previewable result was returned.';
        textResult.hidden = false;
      }
      if (previewIframe) previewIframe.hidden = true;
    };

    const applyStreamEvent = (event: StreamEvent) => {
      if (event.type === 'stage-start') {
        const stage = stageForAgent(event.agent);
        if (stage) {
          setStage(stage.key, completedStageKeys());
          updateGuidance(`${stage.title} running`, 'This agent is working on the build now.', 'Preview pending', 'The canvas will update when the reviewed draft is ready.', 'Build steps are updating live.');
        }
        return;
      }

      if (event.type === 'stage-complete' && event.agent && event.step) {
        workflowData = { ...(workflowData || {}), [event.agent]: event.step };
        const stage = stageForAgent(event.agent);
        if (stage) {
          updateStepCard(event.agent, `${stage.title} complete`, event.step);
          setStage('', completedStageKeys());
        }
        return;
      }

      if (event.type === 'complete') {
        workflowData = event.output || workflowData;
        currentBuildId = event.buildId || null;
        if (workflowData) {
          setStage('', stageMap.map((stage) => stage.key));
          stageMap.forEach((stage) => {
            updateStepCard(
              stage.agent as keyof WorkflowData,
              `${stage.title} complete`,
              workflowData?.[stage.agent as keyof WorkflowData]
            );
          });
          renderResult(workflowData);
        }
        setStatus(currentBuildId ? 'Draft ready. Share link saved.' : 'Draft ready. Sharing is unavailable.', 'success');
        updateGuidance('Build complete', 'The working draft is ready in Preview.', 'Review available', 'Open Build steps to inspect the agent outputs.', 'Copy, download, regenerate, or share the build.');
        return;
      }

      if (event.type === 'error') {
        setStatus(event.error || 'Agentic Builder is unavailable right now.', 'error');
        updateGuidance('Build paused', 'The builder could not finish this request.', 'Nothing was changed', 'Your prompt is still here if you want to try again.', 'Try regenerating the build.');
      }
    };

    const readWorkflowStream = async (response: Response) => {
      const reader = response.body?.getReader();
      if (!reader) {
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || 'Agentic Builder is unavailable right now.');
        applyStreamEvent({ type: 'complete', output: payload.output, buildId: payload.buildId, source: payload.source });
        return;
      }

      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (!line.trim()) continue;
          applyStreamEvent(JSON.parse(line) as StreamEvent);
        }
      }

      if (buffer.trim()) {
        applyStreamEvent(JSON.parse(buffer) as StreamEvent);
      }
    };

    const loadSharedBuild = async (buildId: string) => {
      setLoading(true);
      resetPreview();
      resetStepCards();
      setStatus('Loading shared build.');
      updateGuidance('Loading build', 'The saved prompt and preview are being restored.', 'Preview pending', 'The generated app will appear shortly.', 'Keep this window open.');

      try {
        const response = await fetch(`/api/ai/agent-build?id=${encodeURIComponent(buildId)}`);
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || 'Build could not be loaded.');
        workflowData = payload.output || null;
        currentBuildId = buildId;
        if (textarea && typeof payload.task === 'string') textarea.value = payload.task;
        updateCount();
        if (workflowData) {
          stageMap.forEach((stage) => {
            updateStepCard(
              stage.agent as keyof WorkflowData,
              `${stage.title} complete`,
              workflowData?.[stage.agent as keyof WorkflowData]
            );
          });
          setStage('', stageMap.map((stage) => stage.key));
          renderResult(workflowData);
        }
        setStatus('Shared draft loaded.', 'success');
        updateGuidance('Build loaded', 'The saved generated draft is ready in Preview.', 'Steps restored', 'Open Build steps to inspect the agent outputs.', 'Copy, download, regenerate, or share the build.');
      } catch {
        setStatus('Shared build could not be loaded.', 'error');
        updateGuidance('Load failed', 'The saved build may no longer be available.', 'Prompt unchanged', 'You can still start a new build.', 'Try a new prompt or check the shared link.');
      } finally {
        setLoading(false);
      }
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        if (tab.dataset.awTab) switchView(tab.dataset.awTab);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-aw-example]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!textarea) return;
        textarea.value = button.dataset.awExample || '';
        updateCount();
        textarea.focus();
        setStatus('Example added. Start the build when ready.');
      });
    });

    textarea?.addEventListener('input', updateCount);

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!textarea) return;

      const task = textarea.value.trim();
      if (task.length < 10) {
        setStatus('Add a little more detail before starting.', 'error');
        textarea.focus();
        return;
      }

      setLoading(true);
      workflowData = null;
      currentBuildId = null;
      resetPreview();
      resetStepCards();
      setStage('brief', []);
      switchView('preview');
      setStatus('Gemini 3 Flash is building your draft.');
      updateGuidance('Reading your brief', 'We are turning your prompt into a simple build plan.', 'Preparing the draft', 'The preview will update when the reviewed result is ready.', 'Keep this window open while the build runs.');

      try {
        const response = await fetch('/api/ai/agent-workflow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ task }),
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          setStatus(payload.error || 'Agentic Builder is unavailable right now.', 'error');
          updateGuidance('Build paused', 'The builder could not start from this environment.', 'Nothing was changed', 'Your prompt is still here if you want to try again.', 'Check the AI configuration or start a new build.');
          return;
        }

        await readWorkflowStream(response);
      } catch {
        setStatus('Network error. Please try again.', 'error');
        updateGuidance('Build paused', 'The connection dropped before the draft was ready.', 'Prompt saved', 'Your text is still available on the left.', 'Try starting the build again.');
      } finally {
        setLoading(false);
      }
    });

    newButton?.addEventListener('click', () => resetWorkspace(true));

    closeButton?.addEventListener('click', () => {
      const dialog = root.closest('dialog') as HTMLDialogElement | null;
      dialog?.close();
      window.dispatchEvent(new CustomEvent('surrey-ai-project-modal-close'));
    });

    regenerateButton?.addEventListener('click', () => {
      form?.requestSubmit();
    });

    copyButton?.addEventListener('click', async () => {
      const code = getFinalCode();
      if (!code) {
        setStatus('Build something first, then copy the HTML.', 'error');
        return;
      }

      try {
        await navigator.clipboard.writeText(code);
        setStatus('Generated HTML copied.', 'success');
      } catch {
        setStatus('Copy failed. Try downloading instead.', 'error');
      }
    });

    downloadButton?.addEventListener('click', () => {
      const code = getFinalCode();
      if (!code) {
        setStatus('Build something first, then download it.', 'error');
        return;
      }

      const blob = new Blob([code], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'agentic-builder-draft.html';
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus('HTML download started.', 'success');
    });

    fullscreenButton?.addEventListener('click', () => {
      const code = getFinalCode();
      if (!code) {
        setStatus('Build something first, then open it full screen.', 'error');
        return;
      }

      const preview = window.open('', '_blank', 'noopener,noreferrer');
      if (!preview) {
        setStatus('Full screen preview was blocked by the browser.', 'error');
        return;
      }
      preview.document.open();
      preview.document.write(code);
      preview.document.close();
      setStatus('Full screen preview opened.', 'success');
    });

    shareButton?.addEventListener('click', async () => {
      const shareText = textarea?.value.trim()
        ? `Agentic Builder draft: ${textarea.value.trim()}`
        : 'Agentic Builder on Surrey AI Society';
      const shareUrl = syncShareUrl();

      try {
        if (navigator.share) {
          await navigator.share({
            title: 'Agentic Builder',
            text: shareText,
            url: shareUrl,
          });
          setStatus('Share sheet opened.', 'success');
          return;
        }

        await navigator.clipboard.writeText(`${shareText}\n${shareUrl}`);
        setStatus('Share link copied.', 'success');
      } catch {
        setStatus('Share was cancelled.');
      }
    });

    updateCount();

    const sharedBuildId = new URL(window.location.href).searchParams.get('build');
    if (sharedBuildId) {
      loadSharedBuild(sharedBuildId);
    }
  }
</script>
