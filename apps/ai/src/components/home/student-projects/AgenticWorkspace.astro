---
---

<section data-agentic-workspace class="aw-root bg-transparent text-ai-fg" aria-label="Student Project: Agentic Builder live pipeline">
  <div class="max-w-[76rem] mx-auto py-6 px-4 sm:px-6 w-full h-full flex flex-col justify-start">
    
    <!-- Mini Header -->
    <header class="text-center mb-6">
      <span class="inline-flex px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-ai-sage bg-ai-sage/10 rounded-full mb-1">Student Project</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ai-fg mb-1">Agentic Builder</h2>
      <p class="text-xs sm:text-sm text-ai-fg-muted max-w-xl mx-auto leading-relaxed">
        Autonomous IDE. Define a web app or task, and watch our multi-agent chain plan, research, build, and review a live-rendered application in real-time.
      </p>
    </header>

    <!-- Two-Column Layout -->
    <div class="flex flex-col md:flex-row gap-5 items-stretch w-full min-h-[500px]">
      
      <!-- LEFT COLUMN: Inputs & Stepper (40%) -->
      <div class="w-full md:w-[38%] flex flex-col gap-4">
        
        <!-- Form Input -->
        <div class="premium-card p-5 flex flex-col justify-between" style="--card-brand-color: var(--ai-sage);">
          <form id="aw-form" class="space-y-4" novalidate>
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center">
                <label for="aw-task" class="text-[10px] font-extrabold uppercase tracking-wider text-ai-fg">Define App / Task</label>
                <button id="aw-example" class="text-[10px] font-bold text-ai-sage hover:underline cursor-pointer" type="button">Use example</button>
              </div>
              
              <textarea
                id="aw-task"
                name="task"
                maxlength="500"
                rows="2"
                class="w-full bg-ai-bg text-ai-fg border border-ai-border rounded-xl p-2.5 text-xs focus:outline-none focus:border-ai-sage focus:ring-1 focus:ring-ai-sage/30 resize-none transition-colors"
                placeholder="Example: Build a beautiful responsive counter app with glowing incremental buttons..."
                required
              ></textarea>
              
              <div class="flex justify-between items-center text-[10px] text-ai-fg-muted opacity-80">
                <span>Min 10 characters</span>
                <span id="aw-count">0/500</span>
              </div>
            </div>

            <div class="flex justify-between items-center pt-1">
              <p id="aw-status" class="text-[10px] text-ai-fg-muted truncate max-w-[60%]" aria-live="polite"></p>
              <button id="aw-submit" type="submit" class="btn-primary py-2 px-5 text-xs" style="--ai-azure: var(--ai-sage); cursor: pointer;">
                <span>Launch Workspace</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Pipeline Stepper -->
        <div class="premium-card p-5 flex-1" style="--card-brand-color: var(--ai-sage);">
          <div class="flex items-center justify-between mb-4 border-b border-ai-border pb-2">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-ai-fg">Execution Pipeline</h3>
            <span class="text-[9px] px-2 py-0.5 rounded-full bg-ai-bg border border-ai-border font-bold text-ai-fg-muted">Sequential</span>
          </div>

          <div class="flex flex-col relative space-y-4">
            <!-- Stepper Connecting Line -->
            <div class="absolute left-[9px] top-3 bottom-3 w-[2px] bg-ai-border transition-colors duration-500" id="aw-connector-line"></div>
            
            <!-- Planner Step (Button) -->
            <button type="button" id="btn-step-planner" class="flex items-center gap-3 w-full text-left outline-none group cursor-pointer aw-step-btn" data-step="planner" disabled>
              <div class="w-[20px] h-[20px] rounded-full border-2 border-ai-border bg-ai-surface flex items-center justify-center transition-all duration-300 aw-indicator">
                <div class="w-1.5 h-1.5 rounded-full bg-transparent transition-all duration-300 aw-dot"></div>
                <svg class="hidden w-[10px] h-[10px] text-white aw-check animate-scale-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="flex-1 flex justify-between items-center">
                <span class="text-xs font-bold text-ai-fg group-hover:text-ai-sage transition-colors">Planner Agent</span>
                <span class="text-[9px] font-extrabold uppercase tracking-wider text-ai-fg-muted aw-status-text">Pending</span>
              </div>
            </button>

            <!-- Researcher Step (Button) -->
            <button type="button" id="btn-step-researcher" class="flex items-center gap-3 w-full text-left outline-none group cursor-pointer aw-step-btn" data-step="researcher" disabled>
              <div class="w-[20px] h-[20px] rounded-full border-2 border-ai-border bg-ai-surface flex items-center justify-center transition-all duration-300 aw-indicator">
                <div class="w-1.5 h-1.5 rounded-full bg-transparent transition-all duration-300 aw-dot"></div>
                <svg class="hidden w-[10px] h-[10px] text-white aw-check animate-scale-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="flex-1 flex justify-between items-center">
                <span class="text-xs font-bold text-ai-fg group-hover:text-ai-sage transition-colors">Researcher Agent</span>
                <span class="text-[9px] font-extrabold uppercase tracking-wider text-ai-fg-muted aw-status-text">Pending</span>
              </div>
            </button>

            <!-- Builder Step (Button) -->
            <button type="button" id="btn-step-builder" class="flex items-center gap-3 w-full text-left outline-none group cursor-pointer aw-step-btn" data-step="builder" disabled>
              <div class="w-[20px] h-[20px] rounded-full border-2 border-ai-border bg-ai-surface flex items-center justify-center transition-all duration-300 aw-indicator">
                <div class="w-1.5 h-1.5 rounded-full bg-transparent transition-all duration-300 aw-dot"></div>
                <svg class="hidden w-[10px] h-[10px] text-white aw-check animate-scale-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="flex-1 flex justify-between items-center">
                <span class="text-xs font-bold text-ai-fg group-hover:text-ai-sage transition-colors">Builder Agent</span>
                <span class="text-[9px] font-extrabold uppercase tracking-wider text-ai-fg-muted aw-status-text">Pending</span>
              </div>
            </button>

            <!-- Reviewer Step (Button) -->
            <button type="button" id="btn-step-reviewer" class="flex items-center gap-3 w-full text-left outline-none group cursor-pointer aw-step-btn" data-step="reviewer" disabled>
              <div class="w-[20px] h-[20px] rounded-full border-2 border-ai-border bg-ai-surface flex items-center justify-center transition-all duration-300 aw-indicator">
                <div class="w-1.5 h-1.5 rounded-full bg-transparent transition-all duration-300 aw-dot"></div>
                <svg class="hidden w-[10px] h-[10px] text-white aw-check animate-scale-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="flex-1 flex justify-between items-center">
                <span class="text-xs font-bold text-ai-fg group-hover:text-ai-sage transition-colors">Reviewer Agent</span>
                <span class="text-[9px] font-extrabold uppercase tracking-wider text-ai-fg-muted aw-status-text">Pending</span>
              </div>
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Interactive IDE Viewport (60%) -->
      <div class="w-full md:w-[62%] flex flex-col">
        <div class="premium-card p-5 h-full flex flex-col justify-between" style="--card-brand-color: var(--ai-sage);">
          
          <!-- Workspace Header & Tabs -->
          <div class="flex items-center justify-between border-b border-ai-border pb-3 mb-4">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full bg-ai-sage animate-pulse"></div>
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-ai-fg" id="aw-inspector-title">Agent IDE</h3>
            </div>
            
            <div class="flex gap-1">
              <button type="button" id="tab-preview" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-ai-bg text-ai-fg-muted border border-ai-border cursor-pointer hover:border-ai-sage transition-colors aw-tab" data-tab="preview">
                🌐 Live Preview
              </button>
              <button type="button" id="tab-code" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-ai-bg text-ai-fg-muted border border-ai-border cursor-pointer hover:border-ai-sage transition-colors aw-tab" data-tab="code">
                💻 Code View
              </button>
              <button type="button" id="tab-log" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-ai-bg text-ai-fg-muted border border-ai-border cursor-pointer hover:border-ai-sage transition-colors aw-tab" data-tab="log">
                🧠 Thinking Log
              </button>
            </div>
          </div>

          <!-- Sandbox Area -->
          <div class="flex-1 min-h-[340px] bg-ai-bg border border-ai-border rounded-xl overflow-hidden relative">
            
            <!-- Tab contents -->
            
            <!-- Tab 1: Live Preview -->
            <div id="content-preview" class="w-full h-full aw-content">
              <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center" id="aw-preview-placeholder">
                <svg class="w-10 h-10 text-ai-fg-muted/40 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-.778.099-1.533.284-2.253m0 0h17.432"></path>
                </svg>
                <h4 class="text-xs font-bold text-ai-fg mb-1">Live Sandbox Preview</h4>
                <p class="text-[10px] text-ai-fg-muted max-w-[240px]">Once the Builder and Reviewer compile your application, it will render here interactively.</p>
              </div>
              <iframe id="aw-preview-iframe" class="w-full h-full border-none bg-white hidden" title="Agent Sandbox Execution View"></iframe>
            </div>

            <!-- Tab 2: Code View -->
            <div id="content-code" class="w-full h-full p-4 overflow-y-auto hidden aw-content">
              <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center" id="aw-code-placeholder">
                <h4 class="text-xs font-bold text-ai-fg mb-1">Source Code Inspector</h4>
                <p class="text-[10px] text-ai-fg-muted max-w-[240px]">Select any active step on the left to inspect its custom compiled code or raw artifact output.</p>
              </div>
              <pre id="aw-code-output" class="text-[11px] font-mono text-ai-fg leading-relaxed whitespace-pre hidden"></pre>
            </div>

            <!-- Tab 3: Agent Thinking Log -->
            <div id="content-log" class="w-full h-full p-4 overflow-y-auto hidden aw-content space-y-4">
              <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center" id="aw-log-placeholder">
                <h4 class="text-xs font-bold text-ai-fg mb-1">Thinking Log Terminal</h4>
                <p class="text-[10px] text-ai-fg-muted max-w-[240px]">Streaming logs from our agentic chain will appear here as they execute.</p>
              </div>
              
              <div id="aw-log-container" class="space-y-4 hidden text-[11px] leading-relaxed">
                <!-- Log steps will append here -->
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .aw-root {
    height: 100%;
    overflow-y: auto !important;
    padding-bottom: 2rem;
  }

  /* Connector line styles */
  .aw-step-btn[data-state="completed"]::before {
    background: var(--ai-sage);
  }

  /* Button Indicator States */
  .aw-step-btn[data-state="running"] .aw-indicator {
    border-color: var(--ai-sage);
    box-shadow: 0 0 10px color-mix(in srgb, var(--ai-sage) 40%, transparent);
  }
  
  .aw-step-btn[data-state="running"] .aw-dot {
    background: var(--ai-sage);
    animation: aw-pulse-dot 1.2s infinite;
  }
  
  .aw-step-btn[data-state="running"] .aw-status-text {
    color: var(--ai-sage);
  }

  .aw-step-btn[data-state="completed"] .aw-indicator {
    border-color: var(--ai-sage);
    background: var(--ai-sage);
  }
  
  .aw-step-btn[data-state="completed"] .aw-dot {
    display: none;
  }
  
  .aw-step-btn[data-state="completed"] .aw-check {
    display: block !important;
  }
  
  .aw-step-btn[data-state="completed"] .aw-status-text {
    color: var(--ai-sage);
  }

  .aw-step-btn:disabled {
    cursor: default;
    opacity: 0.65;
  }

  @keyframes aw-pulse-dot {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.5; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* Active tabs and navigation */
  .aw-tab.active-tab {
    border-color: var(--ai-sage) !important;
    background: var(--ai-surface) !important;
    color: var(--ai-fg) !important;
    box-shadow: 0 0 8px color-mix(in srgb, var(--ai-sage) 12%, transparent);
  }

  .aw-step-btn.active-step .aw-indicator {
    border-color: var(--ai-sage) !important;
    box-shadow: 0 0 10px color-mix(in srgb, var(--ai-sage) 40%, transparent);
  }

  .aw-step-btn.active-step {
    border-radius: 8px;
    background: color-mix(in srgb, var(--ai-sage) 5%, transparent);
  }

  /* Animation for check scale up */
  .animate-scale-up {
    animation: scaleUp 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes scaleUp {
    from { transform: scale(0.6); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  const root = document.querySelector('[data-agentic-workspace]');

  if (root) {
    const form = root.querySelector('#aw-form');
    const textarea = root.querySelector('#aw-task') as HTMLTextAreaElement;
    const count = root.querySelector('#aw-count');
    const submit = root.querySelector('#aw-submit') as HTMLButtonElement;
    const example = root.querySelector('#aw-example');
    const status = root.querySelector('#aw-status');
    const connectorLine = root.querySelector('#aw-connector-line') as HTMLElement;
    const stepButtons = root.querySelectorAll('.aw-step-btn');
    
    // Viewport Elements
    const tabs = root.querySelectorAll('.aw-tab');
    const tabContents = root.querySelectorAll('.aw-content');
    
    // Previews
    const previewIframe = root.querySelector('#aw-preview-iframe') as HTMLIFrameElement;
    const previewPlaceholder = root.querySelector('#aw-preview-placeholder') as HTMLElement;
    
    // Code View
    const codeOutput = root.querySelector('#aw-code-output') as HTMLElement;
    const codePlaceholder = root.querySelector('#aw-code-placeholder') as HTMLElement;
    
    // Log View
    const logContainer = root.querySelector('#aw-log-container') as HTMLElement;
    const logPlaceholder = root.querySelector('#aw-log-placeholder') as HTMLElement;
    
    const inspectorTitle = root.querySelector('#aw-inspector-title') as HTMLElement;

    const exampleTask = 'Create a simple fully functional neon-styled calculator web app.';

    let workflowData: any = null;
    let currentActiveStep = 'planner';

    const setStatus = (message: string, tone = '') => {
      if (!status) return;
      status.textContent = message;
      if (tone) {
        status.setAttribute('data-tone', tone);
      } else {
        status.removeAttribute('data-tone');
      }
    };

    const updateCount = () => {
      if (!textarea || !count) return;
      count.textContent = `${textarea.value.length}/500`;
    };

    const setLoading = (loading: boolean) => {
      if (!submit) return;
      submit.disabled = loading;
      const span = submit.querySelector('span');
      if (span) span.textContent = loading ? 'Orchestrating...' : 'Launch Workspace';
    };

    const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));

    // Tab Navigation
    const switchTab = (tabName: string) => {
      tabs.forEach(t => {
        if (t.getAttribute('data-tab') === tabName) {
          t.classList.add('active-tab');
        } else {
          t.classList.remove('active-tab');
        }
      });

      tabContents.forEach(c => {
        if (c.id === `content-${tabName}`) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
    };

    tabs.forEach(t => {
      t.addEventListener('click', () => {
        const tabName = t.getAttribute('data-tab');
        if (tabName) switchTab(tabName);
      });
    });

    const resetSteps = () => {
      stepButtons.forEach(btn => {
        btn.setAttribute('data-state', 'pending');
        btn.setAttribute('disabled', 'true');
        btn.classList.remove('active-step');
        const title = btn.querySelector('.aw-status-text');
        if (title) title.textContent = 'Pending';
      });
      
      if (connectorLine) {
        connectorLine.style.background = '';
      }

      // Reset logs
      if (logContainer) {
        logContainer.textContent = '';
        logContainer.classList.add('hidden');
      }
      if (logPlaceholder) logPlaceholder.classList.remove('hidden');

      // Reset Code
      if (codeOutput) {
        codeOutput.textContent = '';
        codeOutput.classList.add('hidden');
      }
      if (codePlaceholder) codePlaceholder.classList.remove('hidden');

      // Reset Preview
      if (previewIframe) {
        previewIframe.srcdoc = '';
        previewIframe.classList.add('hidden');
      }
      if (previewPlaceholder) previewPlaceholder.classList.remove('hidden');
      
      workflowData = null;
    };

    // Load selected step data into Code and Log tabs
    const selectStep = (stepName: string) => {
      if (!workflowData || !workflowData[stepName]) return;
      currentActiveStep = stepName;

      stepButtons.forEach(btn => {
        if (btn.getAttribute('data-step') === stepName) {
          btn.classList.add('active-step');
        } else {
          btn.classList.remove('active-step');
        }
      });

      if (inspectorTitle) {
        inspectorTitle.textContent = `${stepName.charAt(0).toUpperCase() + stepName.slice(1)} Agent View`;
      }

      // Populate Code/Output
      if (codeOutput) {
        codeOutput.textContent = workflowData[stepName].output || '';
        codeOutput.classList.remove('hidden');
      }
      if (codePlaceholder) codePlaceholder.classList.add('hidden');
    };

    stepButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const step = btn.getAttribute('data-step');
        if (step) {
          selectStep(step);
          switchTab('code');
        }
      });
    });

    const appendLog = (role: string, thinking: string) => {
      if (!logContainer) return;
      logContainer.classList.remove('hidden');
      if (logPlaceholder) logPlaceholder.classList.add('hidden');

      const logBlock = document.createElement('div');
      logBlock.className = 'border-l-2 border-ai-sage/40 pl-3.5 space-y-1';
      
      const header = document.createElement('span');
      header.className = 'block font-extrabold uppercase text-[10px] tracking-wider text-ai-sage';
      header.textContent = `${role.toUpperCase()} AGENT LOG`;

      const body = document.createElement('p');
      body.className = 'italic text-ai-fg-muted font-serif';
      body.textContent = thinking;

      logBlock.appendChild(header);
      logBlock.appendChild(body);
      logContainer.appendChild(logBlock);
      
      // scroll to bottom
      logContainer.parentElement?.scrollTo({ top: logContainer.scrollHeight, behavior: 'smooth' });
    };

    const runAgentStep = async (role: string, data: any, progressPct: number) => {
      const btn = root.querySelector(`#btn-step-${role}`) as HTMLButtonElement;
      if (!btn) return;

      btn.removeAttribute('disabled');
      btn.setAttribute('data-state', 'running');
      const statusText = btn.querySelector('.aw-status-text');
      if (statusText) statusText.textContent = 'Executing...';

      // Stream thinking log
      appendLog(role, data.thinking || '');
      
      // Auto display in log tab or code tab
      selectStep(role);
      if (role === 'planner') {
        switchTab('log');
      } else {
        switchTab('code');
      }

      await delay(2500);

      btn.setAttribute('data-state', 'completed');
      if (statusText) statusText.textContent = 'Completed';

      if (connectorLine) {
        connectorLine.style.background = `linear-gradient(to bottom, var(--ai-sage) ${progressPct}%, var(--ai-border) ${progressPct}%)`;
      }
    };

    textarea?.addEventListener('input', updateCount);

    example?.addEventListener('click', () => {
      if (!textarea) return;
      textarea.value = exampleTask;
      updateCount();
      textarea.focus();
      setStatus('Example added. Click Launch when ready.');
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!textarea) return;

      const task = textarea.value.trim();
      if (task.length < 10) {
        setStatus('Add a little more detail before launching the workspace.', 'error');
        textarea.focus();
        return;
      }

      setLoading(true);
      resetSteps();
      switchTab('log');
      setStatus('Initializing virtual nodes...');

      try {
        const response = await fetch('/api/ai/agent-workflow', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ task }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          setStatus(data.error || 'Agentic Builder is unavailable right now.', 'error');
          return;
        }

        setStatus('Autonomous container compiled. Launching...', 'success');
        workflowData = data.output;

        // Run sequential orchestrations
        await runAgentStep('planner', workflowData.planner, 25);
        await runAgentStep('researcher', workflowData.researcher, 50);
        await runAgentStep('builder', workflowData.builder, 75);
        await runAgentStep('reviewer', workflowData.reviewer, 100);

        // Load into live preview if reviewer or builder returns HTML code
        const finalCode = workflowData.reviewer.output || workflowData.builder.output || '';
        const isHtml = /<!DOCTYPE html>|<html|<body>|<script>/i.test(finalCode);

        if (isHtml) {
          if (previewIframe && previewPlaceholder) {
            previewIframe.srcdoc = finalCode;
            previewIframe.classList.remove('hidden');
            previewPlaceholder.classList.add('hidden');
            switchTab('preview');
          }
          setStatus('Autonomous compile complete! Live rendering view.', 'success');
        } else {
          switchTab('code');
          setStatus('Workflow complete. Code generated.', 'success');
        }

      } catch {
        setStatus('Network error. Check connection and try again.', 'error');
      } finally {
        setLoading(false);
      }
    });

    updateCount();
  }
</script>
