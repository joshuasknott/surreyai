---
---

<section data-bias-detective class="bd-root" aria-label="Student Project: Bias Detective">
  <div class="bd-shell">
    <header class="bd-header">
      <span class="bd-badge">Responsible AI simulator</span>
      <h2>Bias Detective</h2>
      <p>Adjust a toy decision system and see how accuracy, selection rate, and fairness metrics change.</p>
    </header>

    <div class="bd-stage">
      <div class="bd-panel bd-controls">
        <label><span>Threshold</span><input id="bd-threshold" type="range" min="25" max="85" value="58" /></label>
        <label><span>Historical bias</span><input id="bd-bias" type="range" min="-30" max="30" value="14" /></label>
        <label><span>Noise</span><input id="bd-noise" type="range" min="0" max="35" value="12" /></label>
        <div class="bd-actions">
          <button type="button" id="bd-reroll">New sample</button>
          <button type="button" id="bd-balance">Balance data</button>
        </div>
        <p id="bd-note">This toy model is synthetic, but the trade-offs mirror real evaluation questions.</p>
      </div>

      <aside class="bd-panel bd-output">
        <div class="bd-metrics">
          <div><strong id="bd-accuracy">0%</strong><span>Accuracy</span></div>
          <div><strong id="bd-gap">0%</strong><span>Selection gap</span></div>
          <div><strong id="bd-flag">Review</strong><span>Status</span></div>
        </div>
        <div class="bd-chart" aria-label="Group metric comparison">
          <div><span>Group A selected</span><i><b id="bd-a-selected"></b></i></div>
          <div><span>Group B selected</span><i><b id="bd-b-selected"></b></i></div>
          <div><span>Group A qualified</span><i><b id="bd-a-qualified"></b></i></div>
          <div><span>Group B qualified</span><i><b id="bd-b-qualified"></b></i></div>
        </div>
        <div class="bd-grid" id="bd-grid"></div>
      </aside>
    </div>
  </div>
</section>

<style>
  .bd-root { height: 100%; overflow: hidden; color: var(--ai-fg); }
  .bd-shell { width: min(100%, 78rem); height: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
  .bd-header { max-width: 54rem; padding-right: 5.5rem; }
  .bd-badge, .bd-controls label span, .bd-metrics span {
    color: var(--ai-sage);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .bd-header h2 { margin: 0.35rem 0 0; font-size: clamp(2.1rem, 4vw, 3.7rem); line-height: 0.95; font-weight: 850; letter-spacing: -0.04em; }
  .bd-header p { max-width: 44rem; margin: 0.7rem 0 0; color: var(--ai-fg-muted); line-height: 1.5; }
  .bd-stage { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(17rem, 0.34fr) minmax(0, 1fr); gap: 1rem; }
  .bd-panel { min-height: 0; border: 1px solid var(--ai-border); border-radius: 1rem; background: color-mix(in srgb, var(--ai-surface) 92%, transparent); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16); }
  .bd-controls, .bd-output { display: flex; flex-direction: column; gap: 1rem; padding: 1rem; overflow: hidden; }
  .bd-controls label { display: grid; gap: 0.55rem; }
  .bd-controls input { width: 100%; accent-color: var(--ai-sage); }
  .bd-actions { display: grid; gap: 0.55rem; }
  .bd-actions button {
    min-height: 2.55rem;
    border: 1px solid var(--ai-border);
    border-radius: 999px;
    background: transparent;
    color: var(--ai-fg);
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }
  #bd-reroll { background: var(--ai-sage); border-color: var(--ai-sage); color: white; }
  .bd-controls p { margin: auto 0 0; color: var(--ai-fg-muted); line-height: 1.45; }
  .bd-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.65rem; }
  .bd-metrics div { border: 1px solid var(--ai-border); border-radius: 0.85rem; padding: 0.8rem; background: color-mix(in srgb, var(--ai-bg) 64%, transparent); }
  .bd-metrics strong { display: block; font-size: clamp(1.25rem, 3vw, 1.9rem); line-height: 1; margin-bottom: 0.35rem; }
  .bd-chart { display: grid; gap: 0.65rem; }
  .bd-chart div { display: grid; grid-template-columns: 10rem minmax(0, 1fr); align-items: center; gap: 0.75rem; color: var(--ai-fg-muted); font-size: 0.88rem; font-weight: 750; }
  .bd-chart i { height: 0.75rem; border-radius: 999px; background: color-mix(in srgb, var(--ai-border) 70%, transparent); overflow: hidden; }
  .bd-chart b { display: block; width: 0%; height: 100%; border-radius: inherit; background: var(--ai-azure); transition: width 0.25s ease; }
  .bd-grid { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); gap: 0.28rem; overflow: hidden; }
  .bd-dot { border-radius: 0.35rem; min-height: 0.9rem; background: var(--ai-border); }
  .bd-dot[data-group="A"] { background: color-mix(in srgb, var(--ai-azure) 66%, var(--ai-bg)); }
  .bd-dot[data-group="B"] { background: color-mix(in srgb, var(--ai-coral) 66%, var(--ai-bg)); }
  .bd-dot[data-selected="true"] { outline: 2px solid #FBBF24; outline-offset: -2px; }
  @media (max-width: 760px) {
    .bd-header { padding-right: 3.5rem; }
    .bd-header p, .bd-controls p { display: none; }
    .bd-stage { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); }
    .bd-controls { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bd-grid { grid-template-columns: repeat(16, minmax(0, 1fr)); }
  }
</style>

<script>
  const biasRoot = document.querySelector('[data-bias-detective]');
  if (biasRoot) {
    let sample = [];
    const thresholdEl = biasRoot.querySelector('#bd-threshold');
    const biasEl = biasRoot.querySelector('#bd-bias');
    const noiseEl = biasRoot.querySelector('#bd-noise');
    const gridEl = biasRoot.querySelector('#bd-grid');
    const pct = (value) => `${Math.round(value * 100)}%`;
    const rand = (min, max) => min + Math.random() * (max - min);

    function makeSample() {
      sample = Array.from({ length: 120 }, (_, index) => {
        const group = index % 2 === 0 ? 'A' : 'B';
        const ability = Math.max(0, Math.min(100, rand(20, 92) + (group === 'A' ? 4 : -4)));
        const qualified = ability > 55;
        return { group, ability, qualified };
      });
      update();
    }

    function statsFor(group, selected) {
      const people = sample.filter((person) => person.group === group);
      const selectedPeople = people.filter(selected);
      return {
        selectionRate: people.length ? selectedPeople.length / people.length : 0,
        qualifiedRate: people.length ? people.filter((person) => person.qualified).length / people.length : 0,
      };
    }

    function update() {
      const threshold = Number(thresholdEl?.value || 58);
      const historicalBias = Number(biasEl?.value || 0);
      const noise = Number(noiseEl?.value || 0);
      const selected = (person) => {
        const modelScore = person.ability + (person.group === 'A' ? historicalBias : -historicalBias) + Math.sin(person.ability) * noise;
        return modelScore >= threshold;
      };
      const correct = sample.filter((person) => selected(person) === person.qualified).length / sample.length;
      const a = statsFor('A', selected);
      const b = statsFor('B', selected);
      const gap = Math.abs(a.selectionRate - b.selectionRate);
      const setWidth = (id, value) => {
        const el = biasRoot.querySelector(id);
        if (el) el.style.width = `${Math.round(value * 100)}%`;
      };
      biasRoot.querySelector('#bd-accuracy').textContent = pct(correct);
      biasRoot.querySelector('#bd-gap').textContent = pct(gap);
      biasRoot.querySelector('#bd-flag').textContent = gap > 0.22 ? 'Audit' : gap > 0.12 ? 'Review' : 'Stable';
      setWidth('#bd-a-selected', a.selectionRate);
      setWidth('#bd-b-selected', b.selectionRate);
      setWidth('#bd-a-qualified', a.qualifiedRate);
      setWidth('#bd-b-qualified', b.qualifiedRate);
      if (gridEl) {
        gridEl.textContent = '';
        sample.forEach((person) => {
          const dot = document.createElement('span');
          dot.className = 'bd-dot';
          dot.dataset.group = person.group;
          dot.dataset.selected = String(selected(person));
          dot.title = `${person.group}: score ${Math.round(person.ability)}`;
          gridEl.appendChild(dot);
        });
      }
    }

    thresholdEl?.addEventListener('input', update);
    biasEl?.addEventListener('input', update);
    noiseEl?.addEventListener('input', update);
    biasRoot.querySelector('#bd-reroll')?.addEventListener('click', makeSample);
    biasRoot.querySelector('#bd-balance')?.addEventListener('click', () => {
      if (biasEl) biasEl.value = '0';
      if (thresholdEl) thresholdEl.value = '56';
      update();
    });
    makeSample();
  }
</script>
