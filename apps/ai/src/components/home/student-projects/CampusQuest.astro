---
---
<section class="cq-section" aria-label="Student Project: VibeCooking Cafe">
  <div class="cq-teaser">
    <div class="cq-teaser-bg"></div>
    <div class="cq-teaser-content">
      <span class="cq-teaser-badge">3D Cafe Sim</span>
      <h2 class="cq-teaser-title">Campus Quest: VibeCooking Caf&eacute;</h2>
      <p class="cq-teaser-desc">Step inside a first-person 3D caf&eacute;, walk up to the counter, and collect a fresh coffee. A compact full-screen walkthrough prototype built with Three.js.</p>
      <a href="/campus-quest" class="cq-teaser-btn">Enter Caf&eacute;</a>
      <div class="cq-teaser-details">
        <div class="cq-detail-row">
          <span class="cq-detail-label">Engine</span>
          <span class="cq-detail-value">Three.js, first-person controls</span>
        </div>
        <div class="cq-detail-row">
          <span class="cq-detail-label">Input</span>
          <span class="cq-detail-value">WASD + mouse look (pointer lock)</span>
        </div>
        <div class="cq-detail-row">
          <span class="cq-detail-label">Duration</span>
          <span class="cq-detail-value">~1 min walkthrough</span>
        </div>
      </div>
      <p class="cq-teaser-note">Opens as a full-screen 3D experience in a new page. Desktop browser with WebGL recommended.</p>
    </div>
  </div>
</section>

<style>
  .cq-section {
    border-top: 1px solid var(--ai-border);
    border-bottom: 1px solid var(--ai-border);
    background: var(--ai-slate-base);
    color: #F8FAFC;
    padding: 4rem 1.5rem;
  }

  .cq-teaser {
    position: relative;
    max-width: 36rem;
    margin: 0 auto;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(0, 0, 0, 0.2);
  }

  .cq-teaser-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 40%, rgba(245, 158, 11, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 70%, rgba(251, 191, 36, 0.05) 0%, transparent 50%),
      var(--ai-slate-base);
    pointer-events: none;
  }

  .cq-teaser-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 3rem 2rem;
  }

  .cq-teaser-badge {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.2);
    margin-bottom: 1.5rem;
  }

  .cq-teaser-title {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    color: #F8FAFC;
  }

  .cq-teaser-desc {
    font-size: 0.95rem;
    color: #94A3B8;
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
  }

  .cq-teaser-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 2.4rem;
    font-size: 1rem;
    font-weight: 700;
    color: #0f0d0a;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
    box-shadow: 0 6px 24px rgba(245, 158, 11, 0.3);
    font-family: inherit;
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .cq-teaser-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 32px rgba(245, 158, 11, 0.4);
  }

  .cq-teaser-btn:focus-visible {
    outline: 2px solid #f59e0b;
    outline-offset: 3px;
  }

  .cq-teaser-btn:active {
    transform: translateY(0) scale(0.98);
  }

  .cq-teaser-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .cq-detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .cq-detail-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cq-detail-label {
    font-size: 0.8rem;
    color: #64748B;
    font-weight: 600;
  }

  .cq-detail-value {
    font-size: 0.8rem;
    color: #CBD5E1;
    font-weight: 500;
  }

  .cq-teaser-note {
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .cq-section {
      padding: 2rem 0.75rem;
    }
    .cq-teaser-content {
      padding: 2rem 1.25rem;
    }
    .cq-detail-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cq-teaser-btn {
      transition: none;
    }
  }
</style>
