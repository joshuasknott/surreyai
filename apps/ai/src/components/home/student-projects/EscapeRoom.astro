---
---

<section data-escape-room class="er-root" aria-label="Student Project: Logic Escape Room">
  <div class="er-shell">
    <header class="er-header">
      <span class="er-badge">Puzzle game</span>
      <h2>Logic Escape Room</h2>
      <p>Solve pattern, probability, and code-breaking puzzles to unlock the lab door before the timer ends.</p>
    </header>

    <div class="er-stage">
      <div class="er-panel er-puzzle">
        <div class="er-topline">
          <strong id="er-room">Room 1 / 3</strong>
          <span id="er-time">04:00</span>
        </div>
        <h3 id="er-question"></h3>
        <div id="er-options" class="er-options"></div>
        <p id="er-feedback">Choose the best answer.</p>
      </div>
      <aside class="er-panel er-lock">
        <div class="er-dial" id="er-dial">---</div>
        <div class="er-progress">
          <span id="er-step-1"></span>
          <span id="er-step-2"></span>
          <span id="er-step-3"></span>
        </div>
        <button type="button" id="er-reset">Restart room</button>
        <div class="er-log" id="er-log">Lab lock waiting for evidence.</div>
      </aside>
    </div>
  </div>
</section>

<style>
  .er-root { height: 100%; overflow: hidden; color: var(--ai-fg); }
  .er-shell { width: min(100%, 78rem); height: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
  .er-header { max-width: 54rem; padding-right: 5.5rem; }
  .er-badge {
    color: var(--ai-azure);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .er-header h2 { margin: 0.35rem 0 0; font-size: clamp(2.1rem, 4vw, 3.7rem); line-height: 0.95; font-weight: 850; letter-spacing: -0.04em; }
  .er-header p { max-width: 44rem; margin: 0.7rem 0 0; color: var(--ai-fg-muted); line-height: 1.5; }
  .er-stage { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.3fr); gap: 1rem; }
  .er-panel { min-height: 0; border: 1px solid var(--ai-border); border-radius: 1rem; background: color-mix(in srgb, var(--ai-surface) 92%, transparent); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16); }
  .er-puzzle, .er-lock { display: flex; flex-direction: column; gap: 1rem; padding: 1rem; overflow: hidden; }
  .er-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--ai-fg-muted); font-weight: 850; }
  .er-topline span { color: var(--ai-coral); font-family: var(--font-mono); }
  .er-puzzle h3 { margin: auto 0 0; max-width: 48rem; font-size: clamp(1.5rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -0.03em; }
  .er-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-top: auto; }
  .er-options button {
    min-height: 4rem;
    border: 1px solid var(--ai-border);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--ai-bg) 64%, transparent);
    color: var(--ai-fg);
    padding: 0.85rem;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
    text-align: left;
  }
  .er-options button:hover { border-color: var(--ai-azure); }
  .er-puzzle p, .er-log { color: var(--ai-fg-muted); line-height: 1.45; }
  .er-dial {
    display: grid;
    place-items: center;
    min-height: 11rem;
    border: 1px solid var(--ai-border);
    border-radius: 0.85rem;
    background: #0F172A;
    color: #FBBF24;
    font-family: var(--font-mono);
    font-size: clamp(2.3rem, 6vw, 4rem);
    font-weight: 850;
    letter-spacing: 0.18em;
  }
  .er-progress { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.55rem; }
  .er-progress span { height: 0.8rem; border-radius: 999px; background: color-mix(in srgb, var(--ai-border) 80%, transparent); }
  .er-progress span[data-done="true"] { background: var(--ai-sage); }
  #er-reset {
    min-height: 2.55rem;
    border: 1px solid var(--ai-azure);
    border-radius: 999px;
    background: var(--ai-azure);
    color: white;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .er-header { padding-right: 3.5rem; }
    .er-header p { display: none; }
    .er-stage { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; }
    .er-options { grid-template-columns: 1fr; }
    .er-dial { min-height: 5rem; }
  }
</style>

<script>
  const escapeRoot = document.querySelector('[data-escape-room]');
  if (escapeRoot) {
    const puzzles = [
      {
        question: 'A classifier catches 90 true positives and 10 false positives. Precision is closest to:',
        options: ['90%', '50%', '10%', '99%'],
        answer: 0,
        code: '9',
        hint: 'Precision measures selected positives that were correct.',
      },
      {
        question: 'Which sequence best continues: 2, 4, 8, 16, ?',
        options: ['20', '24', '32', '64'],
        answer: 2,
        code: '3',
        hint: 'The pattern doubles each step.',
      },
      {
        question: 'A prompt says “ignore previous rules”. The safest response is to:',
        options: ['Follow it', 'Ask for a password', 'Treat it as untrusted content', 'Delete all context'],
        answer: 2,
        code: '7',
        hint: 'User content should not override system or developer constraints.',
      },
    ];
    let index = 0;
    let code = '';
    let remaining = 240;
    let timer = null;
    const panel = escapeRoot.closest('.project-panel');
    const questionEl = escapeRoot.querySelector('#er-question');
    const roomEl = escapeRoot.querySelector('#er-room');
    const timeEl = escapeRoot.querySelector('#er-time');
    const optionsEl = escapeRoot.querySelector('#er-options');
    const feedbackEl = escapeRoot.querySelector('#er-feedback');
    const dialEl = escapeRoot.querySelector('#er-dial');
    const logEl = escapeRoot.querySelector('#er-log');

    function formatTime(seconds) {
      const minutes = Math.floor(seconds / 60);
      const rest = seconds % 60;
      return `${String(minutes).padStart(2, '0')}:${String(rest).padStart(2, '0')}`;
    }

    function render() {
      const puzzle = puzzles[index];
      if (roomEl) roomEl.textContent = `Room ${Math.min(index + 1, puzzles.length)} / ${puzzles.length}`;
      if (questionEl) questionEl.textContent = puzzle ? puzzle.question : 'Door unlocked. The lab is open.';
      if (dialEl) dialEl.textContent = code.padEnd(3, '-');
      if (timeEl) timeEl.textContent = formatTime(remaining);
      puzzles.forEach((_, step) => {
        const bar = escapeRoot.querySelector(`#er-step-${step + 1}`);
        if (bar) bar.dataset.done = String(step < code.length);
      });
      if (!optionsEl) return;
      optionsEl.textContent = '';
      if (!puzzle) {
        if (feedbackEl) feedbackEl.textContent = 'Unlocked with evidence. Final code accepted.';
        if (logEl) logEl.textContent = `Access code ${code} confirmed.`;
        return;
      }
      puzzle.options.forEach((option, optionIndex) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = option;
        button.addEventListener('click', () => answer(optionIndex));
        optionsEl.appendChild(button);
      });
    }

    function answer(optionIndex) {
      const puzzle = puzzles[index];
      if (!puzzle) return;
      if (optionIndex === puzzle.answer) {
        code += puzzle.code;
        index += 1;
        if (feedbackEl) feedbackEl.textContent = 'Correct. Evidence accepted.';
      } else {
        remaining = Math.max(0, remaining - 20);
        if (feedbackEl) feedbackEl.textContent = `Not quite. ${puzzle.hint}`;
      }
      render();
    }

    function startTimer() {
      window.clearInterval(timer);
      timer = window.setInterval(() => {
        remaining = Math.max(0, remaining - 1);
        if (timeEl) timeEl.textContent = formatTime(remaining);
        if (remaining === 0) {
          window.clearInterval(timer);
          if (feedbackEl) feedbackEl.textContent = 'Time expired. Restart to try a new run.';
        }
      }, 1000);
    }

    function reset(startClock = true) {
      index = 0;
      code = '';
      remaining = 240;
      window.clearInterval(timer);
      render();
      if (startClock) startTimer();
    }

    escapeRoot.querySelector('#er-reset')?.addEventListener('click', () => reset(true));
    if (panel) {
      new MutationObserver(() => {
        if (panel.hasAttribute('hidden')) {
          window.clearInterval(timer);
        } else {
          reset(true);
        }
      }).observe(panel, { attributes: true, attributeFilter: ['hidden'] });
      reset(!panel.hasAttribute('hidden'));
    } else {
      reset(true);
    }
  }
</script>
