---
---

<section data-idea-analyser class="ia-root" aria-label="Student Project: Idea Analyser">
  <div class="ia-shell">
    <div class="ia-ambient ia-ambient--coral"></div>
    <div class="ia-ambient ia-ambient--azure"></div>

    <header class="ia-header">
      <div>
        <span class="ia-badge">Student Project</span>
        <h2 class="ia-title">Idea Analyser</h2>
        <p class="ia-subtitle">
          Instant AI feedback for business, startup, product, and project ideas. Built as a live server-powered society tool.
        </p>
      </div>
      <div class="ia-route-pill" aria-label="Server-powered AI route">
        <span class="ia-route-dot"></span>
        Server AI
      </div>
    </header>

    <div class="ia-grid">
      <form id="ia-form" class="ia-card ia-form" novalidate>
        <div class="ia-field">
          <label for="ia-idea" class="ia-label">Your idea</label>
          <textarea
            id="ia-idea"
            class="ia-textarea"
            name="idea"
            maxlength="1200"
            rows="8"
            placeholder="Example: A marketplace that helps student societies share equipment, sponsors, and event planning templates across campus."
            required
          ></textarea>
          <div class="ia-field-footer">
            <span>Minimum 15 characters</span>
            <span id="ia-count">0/1200</span>
          </div>
        </div>

        <div class="ia-control-block">
          <span class="ia-label" id="ia-stage-label">Stage</span>
          <div class="ia-chips" role="radiogroup" aria-labelledby="ia-stage-label">
            <button class="ia-chip" type="button" data-group="stage" data-value="early concept" role="radio" aria-checked="true">Early concept</button>
            <button class="ia-chip" type="button" data-group="stage" data-value="prototype" role="radio" aria-checked="false">Prototype</button>
            <button class="ia-chip" type="button" data-group="stage" data-value="ready to test" role="radio" aria-checked="false">Ready to test</button>
          </div>
        </div>

        <div class="ia-control-block">
          <span class="ia-label" id="ia-audience-label">Audience</span>
          <div class="ia-chips" role="radiogroup" aria-labelledby="ia-audience-label">
            <button class="ia-chip" type="button" data-group="audience" data-value="students" role="radio" aria-checked="true">Students</button>
            <button class="ia-chip" type="button" data-group="audience" data-value="societies" role="radio" aria-checked="false">Societies</button>
            <button class="ia-chip" type="button" data-group="audience" data-value="local businesses" role="radio" aria-checked="false">Local business</button>
            <button class="ia-chip" type="button" data-group="audience" data-value="general public" role="radio" aria-checked="false">Public</button>
          </div>
        </div>

        <div class="ia-control-block">
          <span class="ia-label" id="ia-category-label">Category</span>
          <div class="ia-chips" role="radiogroup" aria-labelledby="ia-category-label">
            <button class="ia-chip" type="button" data-group="category" data-value="business" role="radio" aria-checked="true">Business</button>
            <button class="ia-chip" type="button" data-group="category" data-value="product" role="radio" aria-checked="false">Product</button>
            <button class="ia-chip" type="button" data-group="category" data-value="campus project" role="radio" aria-checked="false">Campus project</button>
            <button class="ia-chip" type="button" data-group="category" data-value="social impact" role="radio" aria-checked="false">Social impact</button>
          </div>
        </div>

        <div class="ia-actions">
          <button id="ia-submit" class="ia-submit" type="submit">Analyse idea</button>
          <button id="ia-example" class="ia-secondary" type="button">Use example</button>
        </div>

        <p id="ia-status" class="ia-status" aria-live="polite"></p>
      </form>

      <aside class="ia-card ia-output" aria-label="Idea feedback">
        <div id="ia-empty" class="ia-empty">
          <div class="ia-orbit" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <h3>Ready for a useful first pass.</h3>
          <p>
            Submit an idea to receive structured feedback on clarity, risks, next experiments, and responsible use.
          </p>
        </div>

        <div id="ia-result" class="ia-result" aria-live="polite" hidden>
          <div class="ia-score-row">
            <div>
              <span class="ia-kicker">AI feedback</span>
              <h3 id="ia-summary-title">Analysis complete</h3>
            </div>
            <div class="ia-score" aria-label="Idea score">
              <span id="ia-score-value">0</span>
              <small>/100</small>
            </div>
          </div>

          <div class="ia-score-track" aria-hidden="true">
            <div id="ia-score-fill" class="ia-score-fill"></div>
          </div>

          <p id="ia-summary" class="ia-summary"></p>

          <div class="ia-result-grid">
            <section class="ia-result-section">
              <h4>Strengths</h4>
              <ul id="ia-strengths"></ul>
            </section>
            <section class="ia-result-section">
              <h4>Risks</h4>
              <ul id="ia-risks"></ul>
            </section>
            <section class="ia-result-section">
              <h4>Next steps</h4>
              <ul id="ia-next-steps"></ul>
            </section>
            <section class="ia-result-section">
              <h4>Experiments</h4>
              <ul id="ia-experiments"></ul>
            </section>
          </div>

          <section class="ia-questions">
            <h4>Questions to answer</h4>
            <ul id="ia-questions"></ul>
          </section>

          <p id="ia-ethics" class="ia-ethics"></p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ia-root {
    --ia-panel: color-mix(in srgb, var(--ai-surface) 90%, transparent);
    --ia-panel-soft: color-mix(in srgb, var(--ai-surface) 76%, transparent);
    --ia-panel-deep: color-mix(in srgb, var(--ai-bg) 80%, transparent);
    --ia-text: var(--ai-fg);
    --ia-muted: var(--ai-fg-muted);
    --ia-line: var(--ai-border);
    height: 100%;
    color: var(--ia-text);
    overflow: hidden;
  }

  :global(:root[data-theme="dark"]) .ia-root {
    --ia-panel: rgba(19, 26, 43, 0.78);
    --ia-panel-soft: rgba(15, 23, 42, 0.56);
    --ia-panel-deep: rgba(11, 15, 25, 0.68);
    --ia-text: #F8FAFC;
    --ia-muted: #CBD5E1;
    --ia-line: rgba(226, 232, 240, 0.13);
  }

  .ia-shell {
    position: relative;
    width: min(100%, 76rem);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    isolation: isolate;
    overflow: hidden;
  }

  .ia-ambient {
    position: absolute;
    width: 26rem;
    height: 26rem;
    border-radius: 999px;
    filter: blur(90px);
    opacity: 0.18;
    pointer-events: none;
    z-index: -1;
  }

  .ia-ambient--coral {
    top: -8rem;
    right: 0;
    background: var(--ai-coral);
  }

  .ia-ambient--azure {
    left: -8rem;
    bottom: 2rem;
    background: var(--ai-azure);
  }

  .ia-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 0;
    padding-right: 5.5rem;
  }

  .ia-badge,
  .ia-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--ai-coral);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ia-title {
    margin: 0;
    color: var(--ia-text);
    font-size: clamp(2.1rem, 4vw, 3.75rem);
    font-weight: 850;
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .ia-subtitle {
    max-width: 46rem;
    margin: 0.75rem 0 0;
    color: var(--ia-muted);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.45;
  }

  .ia-route-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex: 0 0 auto;
    margin-top: 0.4rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--ia-line);
    border-radius: 999px;
    background: var(--ia-panel-soft);
    color: var(--ia-muted);
    font-size: 0.85rem;
    font-weight: 700;
    backdrop-filter: blur(14px);
  }

  .ia-route-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--ai-sage);
    box-shadow: 0 0 18px var(--ai-sage);
  }

  .ia-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 1rem;
    align-items: stretch;
    flex: 1;
    min-height: 0;
  }

  .ia-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ia-line);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, var(--ia-panel), var(--ia-panel-soft));
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), 0 24px 70px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(18px);
  }

  .ia-form {
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
    min-height: 0;
    padding: 1rem;
  }

  .ia-field,
  .ia-control-block {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ia-label {
    color: var(--ia-text);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ia-textarea {
    width: 100%;
    min-height: clamp(7rem, 18vh, 10rem);
    resize: none;
    border: 1px solid var(--ia-line);
    border-radius: 1.15rem;
    background: var(--ia-panel-deep);
    color: var(--ia-text);
    padding: 0.85rem;
    font: inherit;
    line-height: 1.55;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .ia-textarea::placeholder {
    color: #64748B;
  }

  .ia-textarea:focus {
    border-color: color-mix(in srgb, var(--ai-coral) 70%, white);
    background: var(--ia-panel-deep);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ai-coral) 18%, transparent);
  }

  .ia-field-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ia-muted);
    font-size: 0.76rem;
  }

  .ia-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .ia-chip,
  .ia-secondary,
  .ia-submit {
    appearance: none;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .ia-chip {
    padding: 0.48rem 0.68rem;
    border: 1px solid var(--ia-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--ai-surface) 70%, transparent);
    color: var(--ia-muted);
    font-size: 0.82rem;
    font-weight: 700;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .ia-chip:hover {
    transform: translateY(-1px);
    border-color: rgba(226, 232, 240, 0.3);
  }

  .ia-chip[aria-checked="true"] {
    border-color: color-mix(in srgb, var(--ai-coral) 70%, white);
    background: color-mix(in srgb, var(--ai-coral) 20%, transparent);
    color: #ffffff;
  }

  .ia-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0;
  }

  .ia-submit,
  .ia-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.65rem;
    padding: 0.72rem 1.05rem;
    border-radius: 999px;
    font-weight: 800;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, box-shadow 0.2s ease;
  }

  .ia-submit {
    background: var(--ai-coral);
    color: #ffffff;
    box-shadow: 0 16px 30px color-mix(in srgb, var(--ai-coral) 24%, transparent);
  }

  .ia-secondary {
    border: 1px solid var(--ia-line);
    background: color-mix(in srgb, var(--ai-surface) 70%, transparent);
    color: var(--ia-text);
  }

  .ia-submit:hover,
  .ia-secondary:hover {
    transform: translateY(-2px);
  }

  .ia-submit:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  .ia-chip:focus-visible,
  .ia-submit:focus-visible,
  .ia-secondary:focus-visible {
    outline: 2px solid var(--ai-coral);
    outline-offset: 3px;
  }

  .ia-status {
    min-height: 1.2rem;
    margin: 0;
    color: var(--ia-muted);
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .ia-status[data-tone="error"] {
    color: #FDA4AF;
  }

  .ia-status[data-tone="success"] {
    color: #86EFAC;
  }

  .ia-output {
    min-height: 0;
    padding: 1rem;
  }

  .ia-empty {
    display: grid;
    min-height: 100%;
    place-items: center;
    align-content: center;
    gap: 1rem;
    text-align: center;
    padding: 1rem;
  }

  .ia-empty h3,
  .ia-result h3 {
    margin: 0;
    color: var(--ia-text);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .ia-empty p {
    max-width: 28rem;
    margin: 0;
    color: var(--ia-muted);
    line-height: 1.65;
  }

  .ia-orbit {
    position: relative;
    width: clamp(5rem, 12vh, 7rem);
    height: clamp(5rem, 12vh, 7rem);
    margin-bottom: 0.5rem;
    border: 1px solid rgba(226, 232, 240, 0.14);
    border-radius: 2rem;
    background: radial-gradient(circle at 50% 50%, rgba(255, 107, 107, 0.18), transparent 65%);
  }

  .ia-orbit span {
    position: absolute;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--ai-coral);
    box-shadow: 0 0 24px currentColor;
  }

  .ia-orbit span:nth-child(1) {
    top: 1.1rem;
    left: 1.4rem;
    color: var(--ai-coral);
  }

  .ia-orbit span:nth-child(2) {
    top: 3.7rem;
    right: 1.2rem;
    color: var(--ai-azure);
    background: var(--ai-azure);
  }

  .ia-orbit span:nth-child(3) {
    left: 3.6rem;
    bottom: 1.2rem;
    color: var(--ai-sage);
    background: var(--ai-sage);
  }

  .ia-result {
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .ia-result[hidden],
  .ia-empty[hidden] {
    display: none !important;
  }

  .ia-score-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .ia-score {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.1rem;
    flex: 0 0 auto;
    min-width: 5rem;
    min-height: 5rem;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--ai-coral) 38%, rgba(255, 255, 255, 0.12));
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--ai-coral) 14%, rgba(255, 255, 255, 0.04));
    color: var(--ia-text);
  }

  .ia-score span {
    font-size: 1.95rem;
    font-weight: 850;
    letter-spacing: -0.06em;
  }

  .ia-score small {
    color: var(--ia-muted);
    font-weight: 800;
  }

  .ia-score-track {
    height: 0.7rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ia-line) 75%, transparent);
  }

  .ia-score-fill {
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--ai-coral), var(--ai-azure), var(--ai-sage));
    transition: width 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ia-summary {
    margin: 0;
    color: var(--ia-muted);
    font-size: 0.92rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .ia-result-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    min-height: 0;
  }

  .ia-result-section,
  .ia-questions {
    padding: 0.72rem;
    border: 1px solid var(--ia-line);
    border-radius: 0.95rem;
    background: var(--ia-panel-deep);
    min-height: 0;
  }

  .ia-result-section h4,
  .ia-questions h4 {
    margin: 0 0 0.45rem;
    color: var(--ia-text);
    font-size: 0.86rem;
    font-weight: 850;
    letter-spacing: -0.01em;
  }

  .ia-result-section ul,
  .ia-questions ul {
    display: grid;
    gap: 0.32rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ia-result-section li,
  .ia-questions li {
    position: relative;
    padding-left: 1rem;
    color: var(--ia-muted);
    font-size: 0.82rem;
    line-height: 1.32;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .ia-result-section li::before,
  .ia-questions li::before {
    content: "";
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--ai-coral);
  }

  .ia-ethics {
    margin: 0;
    padding: 0.72rem;
    border: 1px solid color-mix(in srgb, var(--ai-sage) 26%, rgba(255, 255, 255, 0.1));
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--ai-sage) 10%, rgba(255, 255, 255, 0.04));
    color: color-mix(in srgb, var(--ai-sage) 72%, var(--ia-text));
    font-size: 0.84rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (max-width: 980px) {
    .ia-header {
      gap: 1rem;
      padding-right: 4.5rem;
    }

    .ia-title {
      font-size: clamp(1.8rem, 4vw, 3rem);
    }

    .ia-subtitle {
      max-width: 38rem;
    }
  }

  @media (max-width: 640px) {
    .ia-shell {
      padding-top: 0;
    }

    .ia-header {
      padding-right: 3.7rem;
      margin-bottom: -0.25rem;
    }

    .ia-subtitle,
    .ia-route-pill {
      display: none;
    }

    .ia-grid {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 0.65rem;
    }

    .ia-form,
    .ia-output {
      padding: 0.72rem;
      border-radius: 1.2rem;
    }

    .ia-control-block:nth-of-type(3) {
      display: none;
    }

    .ia-textarea {
      min-height: 5.5rem;
    }

    .ia-empty p {
      display: none;
    }

    .ia-result-grid {
      grid-template-columns: 1fr;
    }

    .ia-score-row {
      align-items: center;
    }

    .ia-score {
      min-width: 4.25rem;
      min-height: 4.25rem;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ia-chip,
    .ia-submit,
    .ia-secondary,
    .ia-score-fill {
      transition: none;
    }

    .ia-submit:hover,
    .ia-secondary:hover,
    .ia-chip:hover {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-idea-analyser]');

  if (root) {
    const form = root.querySelector('#ia-form');
    const textarea = root.querySelector('#ia-idea');
    const count = root.querySelector('#ia-count');
    const submit = root.querySelector('#ia-submit');
    const example = root.querySelector('#ia-example');
    const status = root.querySelector('#ia-status');
    const empty = root.querySelector('#ia-empty');
    const result = root.querySelector('#ia-result');
    const scoreValue = root.querySelector('#ia-score-value');
    const scoreFill = root.querySelector('#ia-score-fill');
    const summary = root.querySelector('#ia-summary');
    const ethics = root.querySelector('#ia-ethics');
    const chips = root.querySelectorAll('.ia-chip');

    const exampleIdea = 'A platform that helps student societies share equipment, sponsorship leads, volunteer roles, and event templates so smaller societies can run better events with less admin.';

    const setStatus = (message, tone = '') => {
      if (!status) return;
      status.textContent = message;
      if (tone) {
        status.setAttribute('data-tone', tone);
      } else {
        status.removeAttribute('data-tone');
      }
    };

    const updateCount = () => {
      if (!textarea || !count) return;
      count.textContent = `${textarea.value.length}/1200`;
    };

    const selectedValue = (group) => {
      const selected = root.querySelector(`.ia-chip[data-group="${group}"][aria-checked="true"]`);
      return selected ? selected.getAttribute('data-value') || '' : '';
    };

    const setLoading = (loading) => {
      if (!submit) return;
      submit.disabled = loading;
      submit.textContent = loading ? 'Analysing...' : 'Analyse idea';
    };

    const setList = (id, items) => {
      const list = root.querySelector(id);
      if (!list) return;
      list.textContent = '';
      for (const item of Array.isArray(items) ? items : []) {
        const li = document.createElement('li');
        li.textContent = String(item);
        list.appendChild(li);
      }
    };

    const renderResult = (output) => {
      if (!output || typeof output !== 'object') return;
      const score = Math.max(0, Math.min(100, Number(output.score) || 0));

      if (empty) empty.hidden = true;
      if (result) result.hidden = false;
      if (scoreValue) scoreValue.textContent = String(score);
      if (scoreFill) scoreFill.style.width = `${score}%`;
      if (summary) summary.textContent = String(output.summary || '');
      if (ethics) ethics.textContent = output.ethicsNote ? `Responsible use: ${output.ethicsNote}` : '';

      setList('#ia-strengths', output.strengths);
      setList('#ia-risks', output.risks);
      setList('#ia-next-steps', output.nextSteps);
      setList('#ia-experiments', output.experiments);
      setList('#ia-questions', output.questions);
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const group = chip.getAttribute('data-group');
        if (!group) return;
        root.querySelectorAll(`.ia-chip[data-group="${group}"]`).forEach((candidate) => {
          candidate.setAttribute('aria-checked', candidate === chip ? 'true' : 'false');
        });
      });
    });

    textarea?.addEventListener('input', updateCount);

    example?.addEventListener('click', () => {
      if (!textarea) return;
      textarea.value = exampleIdea;
      updateCount();
      textarea.focus();
      setStatus('Example added. Edit it or analyse when ready.');
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!textarea) return;

      const idea = textarea.value.trim();
      if (idea.length < 15) {
        setStatus('Add a little more detail before analysing your idea.', 'error');
        textarea.focus();
        return;
      }

      setLoading(true);
      setStatus('Sending your idea to the server-side AI analyser...');

      try {
        const response = await fetch('/api/ai/idea-analyser', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            idea,
            stage: selectedValue('stage'),
            audience: selectedValue('audience'),
            category: selectedValue('category'),
          }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          setStatus(data.error || 'Idea Analyser is unavailable right now.', 'error');
          return;
        }

        renderResult(data.output);
        setStatus('Analysis complete. Feedback updated on the right.', 'success');
      } catch {
        setStatus('Network error. Please check your connection and try again.', 'error');
      } finally {
        setLoading(false);
      }
    });

    updateCount();
  }
</script>
