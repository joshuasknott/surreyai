---
---

<section data-idea-analyser class="ia-root" aria-label="Student Project: Idea Analyser">
  <div class="ia-shell">
    <div class="ia-ambient ia-ambient--coral"></div>
    <div class="ia-ambient ia-ambient--azure"></div>

    <div class="ia-container">
      <header class="ia-header text-center">
        <span class="ia-badge">Student Project</span>
        <h2 class="ia-title">Idea Analyser</h2>
        <p class="ia-subtitle">
          An AI-powered evaluator to instantly calculate a viability score out of 10 and receive constructive feedback on your business, startup, or project concept.
        </p>
      </header>

      <div class="ia-card">
        <form id="ia-form" class="ia-form" novalidate>
          <div class="ia-field">
            <div class="ia-field-header">
              <label for="ia-idea" class="ia-label">Your project or startup idea</label>
              <button id="ia-example" class="ia-example-btn" type="button">Use example</button>
            </div>
            
            <textarea
              id="ia-idea"
              class="ia-textarea"
              name="idea"
              maxlength="800"
              rows="4"
              placeholder="Describe your startup, project, or campus society event idea..."
              required
            ></textarea>
            
            <div class="ia-field-footer">
              <span>Minimum 15 characters</span>
              <span id="ia-count">0/800</span>
            </div>
          </div>

          <div class="ia-actions">
            <button id="ia-submit" class="ia-submit" type="submit">
              <span>Analyse idea</span>
            </button>
          </div>

          <p id="ia-status" class="ia-status" aria-live="polite"></p>
        </form>

        <div id="ia-result" class="ia-result" aria-live="polite" hidden>
          <div class="ia-divider"></div>
          
          <div class="ia-result-header">
            <div class="ia-score-circle" aria-label="Viability Score">
              <svg class="ia-progress-svg" viewBox="0 0 100 100">
                <circle class="ia-progress-bg" cx="50" cy="50" r="42"></circle>
                <circle id="ia-progress-fill" class="ia-progress-fill" cx="50" cy="50" r="42" stroke-dasharray="264" stroke-dashoffset="264"></circle>
              </svg>
              <div class="ia-score-text">
                <span id="ia-score-val">0</span>
                <span class="ia-score-max">/10</span>
              </div>
            </div>
            
            <div class="ia-score-label-wrapper">
              <span class="ia-kicker">Viability Score</span>
              <h3 id="ia-score-tier" class="ia-score-tier">Promising</h3>
            </div>
          </div>

          <div class="ia-reasoning-container">
            <h4 class="ia-reasoning-title">Evaluation Reasoning</h4>
            <p id="ia-reasoning-text" class="ia-reasoning-text"></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ia-root {
    --ia-panel: color-mix(in srgb, var(--ai-surface) 90%, transparent);
    --ia-panel-soft: color-mix(in srgb, var(--ai-surface) 76%, transparent);
    --ia-panel-deep: color-mix(in srgb, var(--ai-bg) 80%, transparent);
    --ia-text: var(--ai-fg);
    --ia-muted: var(--ai-fg-muted);
    --ia-line: var(--ai-border);
    height: 100%;
    color: var(--ia-text);
    overflow-y: auto !important;
    padding-bottom: 2rem;
  }

  :global(:root[data-theme="dark"]) .ia-root {
    --ia-panel: rgba(19, 26, 43, 0.78);
    --ia-panel-soft: rgba(15, 23, 42, 0.56);
    --ia-panel-deep: rgba(11, 15, 25, 0.68);
    --ia-text: #F8FAFC;
    --ia-muted: #CBD5E1;
    --ia-line: rgba(226, 232, 240, 0.13);
  }

  .ia-shell {
    position: relative;
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    isolation: isolate;
  }

  .ia-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .ia-ambient {
    position: absolute;
    width: 32rem;
    height: 32rem;
    border-radius: 999px;
    filter: blur(120px);
    opacity: 0.15;
    pointer-events: none;
    z-index: -1;
  }

  .ia-ambient--coral {
    top: -4rem;
    right: -4rem;
    background: var(--ai-coral);
  }

  .ia-ambient--azure {
    left: -4rem;
    bottom: -4rem;
    background: var(--ai-azure);
  }

  .ia-header {
    text-align: center;
  }

  .ia-badge {
    display: inline-flex;
    align-items: center;
    margin-bottom: 0.75rem;
    color: var(--ai-coral);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ia-title {
    margin: 0;
    color: var(--ia-text);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .ia-subtitle {
    max-width: 34rem;
    margin: 0.75rem auto 0;
    color: var(--ia-muted);
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    line-height: 1.45;
  }

  .ia-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--ia-line);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, var(--ia-panel), var(--ia-panel-soft));
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08), 0 24px 70px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(18px);
    padding: 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ia-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ia-field {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ia-field-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ia-label {
    color: var(--ia-text);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ia-example-btn {
    appearance: none;
    border: none;
    background: none;
    color: var(--ai-coral);
    font-weight: 700;
    font-size: 0.8rem;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s;
  }

  .ia-example-btn:hover {
    opacity: 0.8;
  }

  .ia-textarea {
    width: 100%;
    min-height: 7.5rem;
    resize: none;
    border: 1px solid var(--ia-line);
    border-radius: 1rem;
    background: var(--ia-panel-deep);
    color: var(--ia-text);
    padding: 1rem;
    font: inherit;
    line-height: 1.55;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .ia-textarea::placeholder {
    color: #64748B;
  }

  .ia-textarea:focus {
    border-color: color-mix(in srgb, var(--ai-coral) 70%, white);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ai-coral) 18%, transparent);
  }

  .ia-field-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ia-muted);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .ia-actions {
    display: flex;
    justify-content: flex-end;
  }

  .ia-submit {
    appearance: none;
    border: 0;
    font: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.72rem 1.5rem;
    border-radius: 999px;
    font-weight: 800;
    background: var(--ai-coral);
    color: #ffffff;
    box-shadow: 0 12px 24px color-mix(in srgb, var(--ai-coral) 24%, transparent);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, box-shadow 0.2s ease;
  }

  .ia-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 28px color-mix(in srgb, var(--ai-coral) 30%, transparent);
  }

  .ia-submit:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  .ia-status {
    margin: 0;
    color: var(--ia-muted);
    font-size: 0.84rem;
    line-height: 1.35;
    text-align: center;
  }

  .ia-status[data-tone="error"] {
    color: #FDA4AF;
  }

  .ia-status[data-tone="success"] {
    color: #86EFAC;
  }

  .ia-divider {
    height: 1px;
    background: var(--ia-line);
    margin: 2rem 0;
  }

  .ia-result {
    animation: ia-slide-down 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes ia-slide-down {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ia-result[hidden] {
    display: none !important;
  }

  .ia-result-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .ia-score-circle {
    position: relative;
    width: 4.75rem;
    height: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ia-progress-svg {
    transform: rotate(-90deg);
    width: 100%;
    height: 100%;
  }

  .ia-progress-bg {
    fill: none;
    stroke: color-mix(in srgb, var(--ia-line) 60%, transparent);
    stroke-width: 8;
  }

  .ia-progress-fill {
    fill: none;
    stroke: var(--ai-coral);
    stroke-width: 8;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ia-score-text {
    position: absolute;
    display: flex;
    align-items: baseline;
    justify-content: center;
    color: var(--ia-text);
  }

  .ia-score-text span:first-child {
    font-size: 1.5rem;
    font-weight: 850;
    letter-spacing: -0.04em;
  }

  .ia-score-max {
    color: var(--ia-muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .ia-score-label-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ia-kicker {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ai-coral);
  }

  .ia-score-tier {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ia-text);
    letter-spacing: -0.02em;
  }

  .ia-reasoning-container {
    background: var(--ia-panel-deep);
    border: 1px solid var(--ia-line);
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .ia-reasoning-title {
    margin: 0 0 0.5rem 0;
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ia-text);
  }

  .ia-reasoning-text {
    margin: 0;
    color: var(--ia-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .ia-shell {
      padding: 1.5rem 1rem;
    }
    .ia-card {
      padding: 1.25rem;
    }
    .ia-result-header {
      gap: 1rem;
    }
  }
</style>

<script>
  const root = document.querySelector('[data-idea-analyser]');

  if (root) {
    const form = root.querySelector('#ia-form');
    const textarea = root.querySelector('#ia-idea') as HTMLTextAreaElement;
    const count = root.querySelector('#ia-count');
    const submit = root.querySelector('#ia-submit') as HTMLButtonElement;
    const example = root.querySelector('#ia-example');
    const status = root.querySelector('#ia-status');
    const result = root.querySelector('#ia-result') as HTMLElement;
    const scoreVal = root.querySelector('#ia-score-val');
    const scoreFill = root.querySelector('#ia-progress-fill') as SVGElement;
    const scoreTier = root.querySelector('#ia-score-tier');
    const reasoningText = root.querySelector('#ia-reasoning-text');

    const exampleIdea = 'A campus-wide peer-to-peer textbook rental network where students can scan an ISBN to list books they own, set a weekly price, and rent books securely from peers on campus.';

    const setStatus = (message: string, tone = '') => {
      if (!status) return;
      status.textContent = message;
      if (tone) {
        status.setAttribute('data-tone', tone);
      } else {
        status.removeAttribute('data-tone');
      }
    };

    const updateCount = () => {
      if (!textarea || !count) return;
      count.textContent = `${textarea.value.length}/800`;
    };

    const setLoading = (loading: boolean) => {
      if (!submit) return;
      submit.disabled = loading;
      const span = submit.querySelector('span');
      if (span) span.textContent = loading ? 'Analysing...' : 'Analyse idea';
    };

    const getScoreTier = (score: number) => {
      if (score >= 9) return 'Exceptional';
      if (score >= 7) return 'Strong Potential';
      if (score >= 5) return 'Promising Concept';
      if (score >= 3) return 'Needs Refinement';
      return 'High Challenge';
    };

    const getScoreColor = (score: number) => {
      if (score >= 8) return 'var(--ai-sage)';
      if (score >= 5) return 'var(--ai-azure)';
      return 'var(--ai-coral)';
    };

    const renderResult = (output: any) => {
      if (!output || typeof output !== 'object') return;
      const score = Math.max(0, Math.min(10, Number(output.score) || 0));
      
      if (result) result.hidden = false;
      if (scoreVal) scoreVal.textContent = String(score);
      
      if (scoreFill) {
        const offset = 264 - (score / 10) * 264;
        scoreFill.style.strokeDashoffset = String(offset);
        scoreFill.style.stroke = getScoreColor(score);
      }

      if (scoreTier) {
        scoreTier.textContent = getScoreTier(score);
      }
      
      if (reasoningText) {
        reasoningText.textContent = String(output.reasoning || '');
      }
    };

    textarea?.addEventListener('input', updateCount);

    example?.addEventListener('click', () => {
      if (!textarea) return;
      textarea.value = exampleIdea;
      updateCount();
      textarea.focus();
      setStatus('Example added. Click Analyse when ready.');
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!textarea) return;

      const idea = textarea.value.trim();
      if (idea.length < 15) {
        setStatus('Add a little more detail before analysing your idea.', 'error');
        textarea.focus();
        return;
      }

      setLoading(true);
      setStatus('Evaluating your idea via Gemini AI...');

      try {
        const response = await fetch('/api/ai/idea-analyser', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ idea }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          setStatus(data.error || 'Idea Analyser is unavailable right now.', 'error');
          return;
        }

        renderResult(data.output);
        setStatus('Analysis complete!', 'success');
      } catch {
        setStatus('Network error. Please check your connection and try again.', 'error');
      } finally {
        setLoading(false);
      }
    });

    updateCount();
  }
</script>
