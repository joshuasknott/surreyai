---
const pulses = Array.from({ length: 16 }, (_, index) => index);
---

<section class="nbl-root" data-neural-beat-lab data-playing="false" aria-label="Student Project: Neural Beat Lab">
  <header class="nbl-topbar">
    <div class="nbl-brand">
      <span class="nbl-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span><strong>Neural Beat Lab</strong><small>Make a beat from a feeling</small></span>
    </div>
    <span class="nbl-top-status"><i></i> Ready to play</span>
  </header>

  <div class="nbl-main">
    <div class="nbl-copy">
      <span class="nbl-eyebrow">A tiny music toy</span>
      <h2>What should your beat feel like?</h2>
      <p>No timelines, knobs, or music theory. Describe a moment and the lab makes the choices for you.</p>
    </div>

    <form class="nbl-prompt" data-nbl-form novalidate>
      <label for="nbl-prompt">Your idea</label>
      <div class="nbl-prompt-box">
        <textarea
          id="nbl-prompt"
          name="prompt"
          rows="3"
          minlength="3"
          maxlength="140"
          required
          placeholder="A sunny walk home after the last exam..."
        ></textarea>
        <button type="submit" data-nbl-create>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6M4 4h4M6 2v4M16 18h4m-2-2v4" /></svg>
          Make my beat
        </button>
      </div>
      <div class="nbl-ideas" aria-label="Example ideas">
        <span>Try</span>
        <button type="button" data-nbl-idea="sunset on campus with friends">sunset with friends</button>
        <button type="button" data-nbl-idea="a rainy late-night library session">rainy library night</button>
        <button type="button" data-nbl-surprise>surprise me</button>
      </div>
      <p class="nbl-status" data-nbl-status aria-live="polite">Sound starts only after you press play.</p>
    </form>

    <section class="nbl-player" data-nbl-player hidden aria-label="Your generated beat">
      <div class="nbl-art" aria-hidden="true">
        <span class="nbl-orbit nbl-orbit--one"></span>
        <span class="nbl-orbit nbl-orbit--two"></span>
        <span class="nbl-record"><i></i><b></b></span>
        <span class="nbl-pulses">
          {pulses.map((pulse) => <i data-nbl-pulse={pulse}></i>)}
        </span>
      </div>

      <div class="nbl-track-copy">
        <span class="nbl-now">Your tiny original</span>
        <h2 data-nbl-title>Campus glow</h2>
        <p data-nbl-description>Made from your idea.</p>
      </div>

      <div class="nbl-player-controls">
        <button class="nbl-play" type="button" data-nbl-play aria-label="Play beat">
          <svg class="nbl-icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5L8 5.5Z" /></svg>
          <svg class="nbl-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7V5Zm6 0h4v14h-4V5Z" /></svg>
          <span data-nbl-play-label>Play beat</span>
        </button>
        <button type="button" data-nbl-remix>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 3.5 21 7l-3.5 3.5M3 7h4.5c5 0 5 10 10 10H21M17.5 20.5 21 17l-3.5-3.5M3 17h4.5c1.4 0 2.5-.8 3.3-1.8" /></svg>
          Remix
        </button>
        <button type="button" data-nbl-new>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
          New idea
        </button>
      </div>
    </section>
  </div>
</section>

<style>
  .nbl-root {
    --nbl-ink: #f7f5ee;
    --nbl-muted: rgba(247, 245, 238, 0.66);
    --nbl-line: rgba(255, 255, 255, 0.14);
    --nbl-coral: #ff927f;
    --nbl-sun: #f3ca74;
    --nbl-aqua: #70ced0;
    position: relative;
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    color: var(--nbl-ink);
    background:
      radial-gradient(circle at 12% 12%, rgba(255, 146, 127, 0.2), transparent 27rem),
      radial-gradient(circle at 88% 85%, rgba(112, 206, 208, 0.16), transparent 30rem),
      linear-gradient(145deg, #121321, #1b1d31 50%, #102a31);
    color-scheme: dark;
    font-family: var(--font-sans, Inter, ui-sans-serif, system-ui, sans-serif);
    isolation: isolate;
  }

  .nbl-root::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.24;
    background-image: radial-gradient(rgba(255,255,255,.32) 0.75px, transparent 0.75px);
    background-size: 24px 24px;
    mask-image: linear-gradient(135deg, #000, transparent 72%);
    content: "";
  }

  .nbl-root *, .nbl-root *::before, .nbl-root *::after { box-sizing: border-box; }

  .nbl-topbar {
    display: flex;
    min-height: 4.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--nbl-line);
    background: rgba(11, 13, 24, 0.44);
    backdrop-filter: blur(18px);
  }

  .nbl-brand { display: flex; align-items: center; gap: 0.75rem; }
  .nbl-brand > span:last-child, .nbl-brand strong, .nbl-brand small { display: block; }
  .nbl-brand strong { font-size: 0.95rem; letter-spacing: -0.01em; }
  .nbl-brand small { margin-top: 0.12rem; color: var(--nbl-muted); font-size: 0.68rem; }

  .nbl-brand-mark {
    position: relative;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--nbl-line);
    border-radius: 50%;
    background: conic-gradient(from 20deg, var(--nbl-coral), var(--nbl-sun), var(--nbl-aqua), var(--nbl-coral));
    box-shadow: inset 0 0 0 0.45rem rgba(15, 18, 31, 0.7), 0 8px 26px rgba(0,0,0,.2);
  }

  .nbl-brand-mark i { position: absolute; width: 0.2rem; border-radius: 999px; background: #fff; }
  .nbl-brand-mark i:nth-child(1) { height: 0.7rem; transform: translateX(-0.38rem); }
  .nbl-brand-mark i:nth-child(2) { height: 1.05rem; }
  .nbl-brand-mark i:nth-child(3) { height: 0.5rem; transform: translateX(0.38rem); }

  .nbl-top-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--nbl-muted);
    font-size: 0.68rem;
    font-weight: 750;
  }

  .nbl-top-status i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--nbl-aqua);
    box-shadow: 0 0 0 0.25rem rgba(112, 206, 208, 0.12);
  }

  .nbl-main {
    display: grid;
    width: min(74rem, 100%);
    min-height: 0;
    flex: 1;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(22rem, 1.2fr);
    align-content: center;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .nbl-copy { max-width: 29rem; }

  .nbl-eyebrow,
  .nbl-now {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--nbl-coral);
    font-size: 0.66rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nbl-eyebrow::before { width: 1.8rem; height: 1px; background: currentColor; content: ""; }

  .nbl-copy h2 {
    max-width: 10ch;
    margin: 0.85rem 0 1rem;
    font-size: clamp(2.4rem, 5.6vw, 5.5rem);
    font-weight: 850;
    letter-spacing: -0.065em;
    line-height: 0.93;
  }

  .nbl-copy p {
    max-width: 34rem;
    margin: 0;
    color: var(--nbl-muted);
    font-size: clamp(0.92rem, 1.5vw, 1.08rem);
    line-height: 1.65;
  }

  .nbl-prompt {
    position: relative;
    display: grid;
    gap: 0.85rem;
    padding: clamp(1rem, 2.6vw, 1.5rem);
    border: 1px solid var(--nbl-line);
    border-radius: 24px;
    background: rgba(246, 246, 239, 0.08);
    box-shadow: 0 30px 90px rgba(4, 6, 16, 0.34);
    backdrop-filter: blur(20px);
  }

  .nbl-prompt > label {
    color: var(--nbl-muted);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nbl-prompt-box {
    display: grid;
    gap: 1rem;
    padding: 1.15rem;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 18px;
    background: rgba(249, 248, 242, 0.96);
    box-shadow: 0 12px 34px rgba(0,0,0,.14);
  }

  .nbl-prompt-box:focus-within { border-color: var(--nbl-aqua); box-shadow: 0 14px 45px rgba(112, 206, 208, .16); }

  .nbl-prompt textarea {
    width: 100%;
    min-height: 6.8rem;
    padding: 0;
    resize: none;
    border: 0;
    outline: 0;
    background: transparent;
    color: #172128;
    font: 750 clamp(1.05rem, 1.8vw, 1.3rem)/1.45 inherit;
  }

  .nbl-prompt textarea::placeholder { color: rgba(23, 33, 40, 0.42); }

  .nbl-prompt-box > button,
  .nbl-play {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.75rem 1.2rem;
    border: 0;
    border-radius: 12px;
    background: #172128;
    color: #fff;
    cursor: pointer;
    font: 850 0.9rem/1 inherit;
    box-shadow: 0 12px 28px rgba(23, 33, 40, .2);
    transition: transform 0.2s, background-color 0.2s;
  }

  .nbl-prompt-box > button:hover,
  .nbl-play:hover { background: #2f737b; transform: translateY(-2px); }

  .nbl-prompt button svg,
  .nbl-player-controls button svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }

  .nbl-ideas { display: flex; flex-wrap: wrap; align-items: center; gap: 0.42rem; }
  .nbl-ideas > span { margin-right: 0.2rem; color: var(--nbl-muted); font-size: 0.68rem; font-weight: 750; }
  .nbl-ideas button {
    padding: 0.42rem 0.7rem;
    border: 1px solid var(--nbl-line);
    border-radius: 999px;
    background: rgba(255,255,255,.05);
    color: var(--nbl-muted);
    cursor: pointer;
    font: 750 0.68rem/1 inherit;
  }
  .nbl-ideas button:hover, .nbl-ideas button:focus-visible { border-color: var(--nbl-aqua); color: #fff; outline: none; }

  .nbl-status { margin: 0; color: rgba(247,245,238,.48); font-size: 0.67rem; }

  .nbl-player {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    text-align: center;
  }
  .nbl-player[hidden], .nbl-prompt[hidden] { display: none; }

  .nbl-art {
    position: relative;
    display: grid;
    width: min(16rem, 28vw);
    aspect-ratio: 1;
    place-items: center;
  }

  .nbl-orbit { position: absolute; border: 1px solid rgba(255,255,255,.12); border-radius: 50%; }
  .nbl-orbit--one { inset: 8%; }
  .nbl-orbit--two { inset: 21%; border-style: dashed; }

  .nbl-record {
    position: relative;
    display: block;
    width: 55%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, transparent 0 7px, rgba(255,255,255,.08) 8px 9px),
      conic-gradient(from 40deg, var(--nbl-coral), var(--nbl-sun), var(--nbl-aqua), #aa84c5, var(--nbl-coral));
    box-shadow: 0 28px 70px rgba(0,0,0,.32), inset 0 0 0 1rem rgba(10,13,23,.34);
  }

  .nbl-record i { position: absolute; inset: 36%; border-radius: 50%; background: #f5f2e9; }
  .nbl-record b { position: absolute; inset: 47%; border-radius: 50%; background: #172128; }

  .nbl-pulses { position: absolute; inset: 0; }
  .nbl-pulses i {
    --angle: calc(var(--pulse) * 22.5deg);
    position: absolute;
    top: 50%; left: 50%;
    width: 0.35rem; height: 0.35rem;
    border-radius: 50%;
    background: rgba(255,255,255,.28);
    transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-7.15rem);
    transition: background-color 0.1s, box-shadow 0.1s, transform 0.1s;
  }

  .nbl-pulses i:nth-child(1) { --pulse: 0; } .nbl-pulses i:nth-child(2) { --pulse: 1; }
  .nbl-pulses i:nth-child(3) { --pulse: 2; } .nbl-pulses i:nth-child(4) { --pulse: 3; }
  .nbl-pulses i:nth-child(5) { --pulse: 4; } .nbl-pulses i:nth-child(6) { --pulse: 5; }
  .nbl-pulses i:nth-child(7) { --pulse: 6; } .nbl-pulses i:nth-child(8) { --pulse: 7; }
  .nbl-pulses i:nth-child(9) { --pulse: 8; } .nbl-pulses i:nth-child(10) { --pulse: 9; }
  .nbl-pulses i:nth-child(11) { --pulse: 10; } .nbl-pulses i:nth-child(12) { --pulse: 11; }
  .nbl-pulses i:nth-child(13) { --pulse: 12; } .nbl-pulses i:nth-child(14) { --pulse: 13; }
  .nbl-pulses i:nth-child(15) { --pulse: 14; } .nbl-pulses i:nth-child(16) { --pulse: 15; }
  .nbl-pulses i.is-active { background: #fff; box-shadow: 0 0 1.2rem var(--nbl-coral); transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-7.55rem) scale(1.7); }

  .nbl-root[data-playing="true"] .nbl-record { animation: nblSpin 8s linear infinite; }
  .nbl-root[data-playing="true"] .nbl-orbit--two { animation: nblSpinReverse 14s linear infinite; }

  .nbl-track-copy h2 { margin: 0.45rem 0 0.35rem; font-size: clamp(1.65rem, 3.4vw, 2.55rem); letter-spacing: -0.045em; }
  .nbl-track-copy p { margin: 0; color: var(--nbl-muted); font-size: 0.86rem; }

  .nbl-player-controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.55rem; }
  .nbl-player-controls button:not(.nbl-play) {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--nbl-line);
    border-radius: 12px;
    background: rgba(255,255,255,.06);
    color: var(--nbl-ink);
    cursor: pointer;
    font: 800 0.8rem/1 inherit;
  }
  .nbl-player-controls button:not(.nbl-play):hover { border-color: var(--nbl-aqua); background: rgba(255,255,255,.1); }
  .nbl-icon-pause { display: none; fill: currentColor !important; stroke: none !important; }
  .nbl-icon-play { fill: currentColor !important; stroke: none !important; }
  .nbl-root[data-playing="true"] .nbl-icon-play { display: none; }
  .nbl-root[data-playing="true"] .nbl-icon-pause { display: block; }

  @keyframes nblSpin { to { transform: rotate(360deg); } }
  @keyframes nblSpinReverse { to { transform: rotate(-360deg); } }

  @media (max-width: 820px) {
    .nbl-root { overflow: auto; }
    .nbl-main { grid-template-columns: 1fr; align-content: start; gap: 1.7rem; padding: 1.5rem; }
    .nbl-copy { max-width: 38rem; }
    .nbl-copy h2 { max-width: 13ch; font-size: clamp(2.4rem, 11vw, 4rem); }
    .nbl-art { width: min(18rem, 74vw); }
    .nbl-pulses i { transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-8rem); }
    .nbl-pulses i.is-active { transform: translate(-50%, -50%) rotate(var(--angle)) translateY(-8.45rem) scale(1.6); }
  }

  @media (max-width: 520px) {
    .nbl-top-status { display: none; }
    .nbl-main { padding: 1.1rem; }
    .nbl-copy h2 { margin-top: 0.65rem; }
    .nbl-prompt { border-radius: 18px; }
    .nbl-prompt-box { border-radius: 14px; }
    .nbl-player-controls { width: 100%; }
    .nbl-player-controls button { flex: 1; justify-content: center; }
    .nbl-play { flex-basis: 100% !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nbl-root[data-playing="true"] .nbl-record,
    .nbl-root[data-playing="true"] .nbl-orbit--two { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-neural-beat-lab]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-nbl-form]');
    const prompt = root.querySelector<HTMLTextAreaElement>('#nbl-prompt');
    const player = root.querySelector<HTMLElement>('[data-nbl-player]');
    const title = root.querySelector<HTMLElement>('[data-nbl-title]');
    const description = root.querySelector<HTMLElement>('[data-nbl-description]');
    const status = root.querySelector<HTMLElement>('[data-nbl-status]');
    const playButton = root.querySelector<HTMLButtonElement>('[data-nbl-play]');
    const playLabel = root.querySelector<HTMLElement>('[data-nbl-play-label]');
    const remixButton = root.querySelector<HTMLButtonElement>('[data-nbl-remix]');
    const newButton = root.querySelector<HTMLButtonElement>('[data-nbl-new]');
    const pulses = Array.from(root.querySelectorAll<HTMLElement>('[data-nbl-pulse]'));

    const surpriseIdeas = [
      'first coffee on a bright Monday morning',
      'cycling through campus just before sunset',
      'the feeling after submitting a huge assignment',
      'a cosy train ride home in the rain',
      'friends dancing in a tiny kitchen at midnight',
    ];
    const scales = [
      [130.81, 146.83, 164.81, 196, 220, 261.63],
      [146.83, 164.81, 185, 220, 246.94, 293.66],
      [110, 130.81, 146.83, 164.81, 196, 220],
    ];

    let audio: AudioContext | null = null;
    let schedulerTimer: number | null = null;
    let playing = false;
    let currentPrompt = '';
    let seed = 1;
    let tempo = 104;
    let step = 0;
    let nextStepAt = 0;
    let generation = 0;

    const hashText = (value: string) => {
      let hash = 2166136261;
      for (let index = 0; index < value.length; index += 1) {
        hash ^= value.charCodeAt(index);
        hash = Math.imul(hash, 16777619);
      }
      return Math.abs(hash >>> 0);
    };

    const titleFromPrompt = (value: string) => {
      const words = value.toLowerCase().match(/[a-z0-9]+/g)?.filter((word) => word.length > 2) || ['tiny', 'moment'];
      const picked = words.slice(0, 3).map((word) => word.charAt(0).toUpperCase() + word.slice(1));
      return `${picked.join(' ')} Mix`;
    };

    const stopPlayback = () => {
      playing = false;
      root.dataset.playing = 'false';
      if (schedulerTimer !== null) window.clearTimeout(schedulerTimer);
      schedulerTimer = null;
      pulses.forEach((pulse) => pulse.classList.remove('is-active'));
      if (playLabel) playLabel.textContent = 'Play beat';
      playButton?.setAttribute('aria-label', 'Play beat');
    };

    const tone = (frequency: number, when: number, duration: number, volume: number, type: OscillatorType = 'sine') => {
      if (!audio) return;
      const oscillator = audio.createOscillator();
      const gain = audio.createGain();
      oscillator.type = type;
      oscillator.frequency.setValueAtTime(frequency, when);
      gain.gain.setValueAtTime(volume, when);
      gain.gain.exponentialRampToValueAtTime(0.001, when + duration);
      oscillator.connect(gain);
      gain.connect(audio.destination);
      oscillator.start(when);
      oscillator.stop(when + duration + 0.03);
    };

    const kick = (when: number) => {
      if (!audio) return;
      const oscillator = audio.createOscillator();
      const gain = audio.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(125, when);
      oscillator.frequency.exponentialRampToValueAtTime(42, when + 0.18);
      gain.gain.setValueAtTime(0.22, when);
      gain.gain.exponentialRampToValueAtTime(0.001, when + 0.22);
      oscillator.connect(gain);
      gain.connect(audio.destination);
      oscillator.start(when);
      oscillator.stop(when + 0.24);
    };

    const scheduleStep = (index: number, when: number) => {
      const scale = scales[seed % scales.length];
      if (index % 4 === 0 || (index === 10 && seed % 2 === 0)) kick(when);
      if (index % 8 === 4) {
        tone(180, when, 0.08, 0.045, 'triangle');
        tone(260, when + 0.018, 0.06, 0.025, 'square');
      }
      if (index % 2 === 1) tone(2100 + ((seed + index) % 5) * 260, when, 0.035, 0.012, 'square');
      if (index % 2 === 0) {
        const noteIndex = (seed + index / 2 + generation) % scale.length;
        tone(scale[noteIndex], when, 0.18, 0.035, index % 4 === 0 ? 'triangle' : 'sine');
        if (index % 8 === 0) tone(scale[noteIndex] / 2, when, 0.32, 0.04, 'sine');
      }
      const delay = Math.max(0, (when - (audio?.currentTime || 0)) * 1000);
      window.setTimeout(() => {
        pulses.forEach((pulse, pulseIndex) => pulse.classList.toggle('is-active', pulseIndex === index));
      }, delay);
    };

    const scheduler = () => {
      if (!playing || !audio) return;
      const stepDuration = 60 / tempo / 2;
      while (nextStepAt < audio.currentTime + 0.12) {
        scheduleStep(step, nextStepAt);
        nextStepAt += stepDuration;
        step = (step + 1) % 16;
      }
      schedulerTimer = window.setTimeout(scheduler, 45);
    };

    const startPlayback = async () => {
      if (!audio) audio = new AudioContext();
      if (audio.state === 'suspended') await audio.resume();
      playing = true;
      root.dataset.playing = 'true';
      step = 0;
      nextStepAt = audio.currentTime + 0.06;
      if (playLabel) playLabel.textContent = 'Pause beat';
      playButton?.setAttribute('aria-label', 'Pause beat');
      scheduler();
    };

    const revealTrack = (value: string, shouldPlay = false) => {
      stopPlayback();
      currentPrompt = value;
      seed = hashText(`${value}-${generation}`);
      tempo = 92 + (seed % 33);
      if (title) title.textContent = titleFromPrompt(value);
      if (description) description.textContent = `A ${tempo} BPM loop made from “${value}”.`;
      form?.setAttribute('hidden', '');
      player?.removeAttribute('hidden');
      if (status) status.textContent = 'Your beat is ready.';
      if (shouldPlay) startPlayback();
      else playButton?.focus({ preventScroll: true });
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = prompt?.value.trim() || '';
      if (value.length < 3) {
        if (status) status.textContent = 'Give the lab a few words to work with.';
        prompt?.focus();
        return;
      }
      generation = 0;
      revealTrack(value);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-nbl-idea]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!prompt) return;
        prompt.value = button.dataset.nblIdea || '';
        prompt.focus();
      });
    });

    root.querySelector<HTMLButtonElement>('[data-nbl-surprise]')?.addEventListener('click', () => {
      if (!prompt) return;
      const idea = surpriseIdeas[Math.floor(Math.random() * surpriseIdeas.length)];
      prompt.value = idea;
      prompt.focus();
    });

    playButton?.addEventListener('click', () => {
      if (playing) stopPlayback();
      else startPlayback();
    });

    remixButton?.addEventListener('click', () => {
      generation += 1;
      revealTrack(currentPrompt, playing);
    });

    newButton?.addEventListener('click', () => {
      stopPlayback();
      player?.setAttribute('hidden', '');
      form?.removeAttribute('hidden');
      if (prompt) {
        prompt.value = '';
        prompt.focus({ preventScroll: true });
      }
      if (status) status.textContent = 'Sound starts only after you press play.';
    });

    window.addEventListener('surrey-ai-project-modal-close', (event) => {
      const project = event instanceof CustomEvent ? event.detail?.project : undefined;
      if (!project || project === 'beat') stopPlayback();
    });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stopPlayback(); });
  }
</script>
