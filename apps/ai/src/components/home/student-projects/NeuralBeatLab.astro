---
const steps = Array.from({ length: 16 }, (_, index) => index);
const lanes = [
  { id: "kick", label: "Kick", hint: "Low pulse", colour: "#79B8C9" },
  { id: "clap", label: "Clap", hint: "Backbeat", colour: "#C18BB9" },
  { id: "hats", label: "Hats", hint: "High rhythm", colour: "#9EBB8D" },
  { id: "synth", label: "Pulse", hint: "Synth phrase", colour: "#E1B980" },
] as const;
---

<section class="nbl-root" data-neural-beat-lab data-nbl-state="setup" aria-label="Student Project: Neural Beat Lab">
  <header class="nbl-topbar">
    <div class="nbl-brand">
      <span class="nbl-brand-mark" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span>
        <strong>Neural Beat Lab</strong>
        <small>Prompt-to-music playground</small>
      </span>
    </div>
    <span class="nbl-top-status" data-nbl-top-status>Ready to compose</span>
  </header>

  <div class="nbl-view nbl-setup" data-nbl-setup>
    <div class="nbl-setup-copy">
      <span class="nbl-eyebrow">A tiny AI music studio</span>
      <h1>Turn a feeling into a beat.</h1>
      <p>Give the lab a scene, choose its mood, then play the 16-step track it builds for you.</p>
    </div>

    <form class="nbl-form" data-nbl-form novalidate>
      <label class="nbl-prompt-label" for="nbl-prompt">What should it feel like?</label>
      <textarea
        id="nbl-prompt"
        name="prompt"
        minlength="3"
        maxlength="160"
        rows="3"
        required
        placeholder="A late-night walk back from the library after finishing a big deadline..."
      ></textarea>

      <fieldset class="nbl-moods">
        <legend>Mood</legend>
        <div class="nbl-mood-options">
          <label>
            <input type="radio" name="mood" value="dreamy" checked />
            <span>Dreamy</span>
          </label>
          <label>
            <input type="radio" name="mood" value="focused" />
            <span>Focused</span>
          </label>
          <label>
            <input type="radio" name="mood" value="bright" />
            <span>Bright</span>
          </label>
          <label>
            <input type="radio" name="mood" value="electric" />
            <span>Electric</span>
          </label>
        </div>
      </fieldset>

      <div class="nbl-energy-row">
        <label for="nbl-energy">
          <span>Energy</span>
          <output for="nbl-energy" data-nbl-energy-output>3 / 5</output>
        </label>
        <input id="nbl-energy" name="energy" type="range" min="1" max="5" value="3" step="1" />
        <div class="nbl-energy-scale" aria-hidden="true"><span>Slow glow</span><span>Full charge</span></div>
      </div>

      <button class="nbl-compose-button" type="submit" data-nbl-compose>
        <span data-nbl-compose-label>Compose my track</span>
        <span class="nbl-compose-loader" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
      <p class="nbl-form-status" data-nbl-form-status aria-live="polite">Sound only starts when you press Play.</p>
    </form>
  </div>

  <div class="nbl-view nbl-player" data-nbl-player hidden aria-busy="false">
    <div class="nbl-track-head">
      <div>
        <div class="nbl-track-source-row">
          <span class="nbl-source-badge" data-nbl-source>AI arrangement</span>
          <span class="nbl-tempo" data-nbl-tempo>112 BPM</span>
        </div>
        <h2 data-nbl-title>Untitled beat</h2>
        <p data-nbl-brief></p>
      </div>
      <div class="nbl-controls" aria-label="Playback controls">
        <button class="nbl-play" type="button" data-nbl-play aria-label="Play track">
          <svg class="nbl-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8L18 12 8 5.6Z" /></svg>
          <svg class="nbl-pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7V5Zm6 0h4v14h-4V5Z" /></svg>
          <span data-nbl-play-label>Play</span>
        </button>
        <button type="button" data-nbl-remix>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.7 3.3 21 6.6l-3.3 3.3M3 6.6h4.8c5.4 0 5.4 10.8 10.8 10.8H21M17.7 20.7l3.3-3.3-3.3-3.3M3 17.4h4.8c1.4 0 2.4-.7 3.2-1.7" /></svg>
          Remix
        </button>
        <button type="button" data-nbl-reset>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.9 9A8 8 0 1 1 5 15M4.9 9V4.5M4.9 9h4.5" /></svg>
          Start over
        </button>
      </div>
    </div>

    <div class="nbl-visualizer" aria-hidden="true">
      <canvas data-nbl-visualizer></canvas>
      <div class="nbl-step-pulse">
        {steps.map((step) => <span data-nbl-pulse={step}></span>)}
      </div>
    </div>

    <div class="nbl-sequencer-region">
      <div class="nbl-sequencer-heading">
        <div>
          <h3>Live loop</h3>
          <p>Mute a lane or tap any step to reshape the beat.</p>
        </div>
        <span>16 steps</span>
      </div>

      <div class="nbl-sequencer-scroll" tabindex="0" aria-label="Scrollable 16-step music sequencer">
        <div class="nbl-sequencer">
          <div class="nbl-step-numbers" aria-hidden="true">
            <span></span>
            {steps.map((step) => <i class:list={{ "is-beat": step % 4 === 0 }}>{step + 1}</i>)}
          </div>

          {lanes.map((lane, laneIndex) => (
            <div class="nbl-lane" data-nbl-lane={lane.id} style={`--lane: var(--nbl-c${laneIndex}, ${lane.colour})`}>
              <button
                class="nbl-lane-mute"
                type="button"
                data-nbl-mute={lane.id}
                aria-pressed="false"
                aria-label={`Mute ${lane.label} lane`}
              >
                <span class="nbl-lane-dot" aria-hidden="true"></span>
                <span><strong>{lane.label}</strong><small>{lane.hint}</small></span>
              </button>
              {steps.map((step) => (
                <button
                  class:list={["nbl-step", { "is-beat-start": step % 4 === 0 }]}
                  type="button"
                  data-nbl-step={step}
                  data-nbl-step-lane={lane.id}
                  aria-label={`${lane.label} step ${step + 1}, off`}
                  aria-pressed="false"
                ><span></span></button>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>

    <footer class="nbl-player-footer">
      <p data-nbl-source-note>Generated from your prompt with Gemini.</p>
      <p data-nbl-player-status aria-live="polite">Your track is ready. Press Play when you are.</p>
    </footer>
  </div>
</section>

<style>
  .nbl-root {
    --nbl-bg: #071013;
    --nbl-panel: #0d191d;
    --nbl-panel-strong: #122328;
    --nbl-line: rgba(229, 239, 234, 0.13);
    --nbl-line-strong: rgba(229, 239, 234, 0.23);
    --nbl-text: #f1f3eb;
    --nbl-muted: #9eadaa;
    --nbl-accent: #79b8c9;
    --nbl-c0: #79b8c9;
    --nbl-c1: #c18bb9;
    --nbl-c2: #9ebb8d;
    --nbl-c3: #e1b980;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: auto;
    color: var(--nbl-text);
    background:
      radial-gradient(circle at 12% 8%, color-mix(in srgb, var(--nbl-c0) 14%, transparent), transparent 25rem),
      radial-gradient(circle at 88% 92%, color-mix(in srgb, var(--nbl-c1) 10%, transparent), transparent 26rem),
      var(--nbl-bg);
    color-scheme: dark;
    font-family: var(--font-sans, Inter, ui-sans-serif, system-ui, sans-serif);
    isolation: isolate;
  }

  .nbl-root *,
  .nbl-root *::before,
  .nbl-root *::after {
    box-sizing: border-box;
  }

  .nbl-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    padding: 0.8rem clamp(1rem, 3vw, 2rem);
    border-bottom: 1px solid var(--nbl-line);
    background: color-mix(in srgb, var(--nbl-bg) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .nbl-brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .nbl-brand > span:last-child,
  .nbl-brand strong,
  .nbl-brand small {
    display: block;
  }

  .nbl-brand strong {
    color: var(--nbl-text);
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .nbl-brand small {
    margin-top: 0.15rem;
    color: var(--nbl-muted);
    font-size: 0.72rem;
  }

  .nbl-brand-mark {
    display: grid;
    grid-template-columns: repeat(4, 0.22rem);
    align-items: center;
    justify-content: center;
    gap: 0.16rem;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--nbl-line-strong);
    border-radius: 0.72rem;
    background: var(--nbl-panel);
  }

  .nbl-brand-mark span {
    display: block;
    height: 0.65rem;
    border-radius: 999px;
    background: var(--nbl-c0);
  }

  .nbl-brand-mark span:nth-child(2) { height: 1.25rem; background: var(--nbl-c1); }
  .nbl-brand-mark span:nth-child(3) { height: 0.9rem; background: var(--nbl-c2); }
  .nbl-brand-mark span:nth-child(4) { height: 1.55rem; background: var(--nbl-c3); }

  .nbl-top-status,
  .nbl-source-badge,
  .nbl-tempo {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--nbl-line);
    border-radius: 999px;
    background: var(--nbl-panel);
    color: var(--nbl-muted);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .nbl-view[hidden] { display: none; }

  .nbl-setup {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(22rem, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    width: min(72rem, calc(100% - 2rem));
    margin: auto;
    padding: clamp(2rem, 6vh, 5rem) 0;
  }

  .nbl-setup-copy { max-width: 30rem; }

  .nbl-eyebrow {
    display: block;
    margin-bottom: 1rem;
    color: var(--nbl-c0);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nbl-setup-copy h1 {
    max-width: 8ch;
    margin: 0;
    color: var(--nbl-text);
    font-size: clamp(2.8rem, 6vw, 5.8rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .nbl-setup-copy p {
    max-width: 29rem;
    margin: 1.35rem 0 0;
    color: var(--nbl-muted);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.6;
  }

  .nbl-form {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.15rem, 3vw, 1.6rem);
    border: 1px solid var(--nbl-line-strong);
    border-radius: 1.2rem;
    background: color-mix(in srgb, var(--nbl-panel) 93%, transparent);
    box-shadow: 0 1.5rem 5rem rgba(0, 0, 0, 0.28);
  }

  .nbl-prompt-label,
  .nbl-moods legend,
  .nbl-energy-row label {
    color: var(--nbl-text);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .nbl-form textarea {
    width: 100%;
    min-height: 7rem;
    resize: vertical;
    padding: 1rem;
    border: 1px solid var(--nbl-line);
    border-radius: 0.8rem;
    outline: 0;
    background: var(--nbl-bg);
    color: var(--nbl-text);
    font: inherit;
    font-size: 0.98rem;
    line-height: 1.55;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .nbl-form textarea::placeholder { color: color-mix(in srgb, var(--nbl-muted) 68%, transparent); }
  .nbl-form textarea:focus { border-color: var(--nbl-c0); box-shadow: 0 0 0 3px color-mix(in srgb, var(--nbl-c0) 15%, transparent); }

  .nbl-moods { min-width: 0; margin: 0; padding: 0; border: 0; }
  .nbl-moods legend { margin-bottom: 0.65rem; }
  .nbl-mood-options { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
  .nbl-mood-options label { min-width: 0; cursor: pointer; }
  .nbl-mood-options input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .nbl-mood-options span {
    display: grid;
    min-height: 2.75rem;
    place-items: center;
    padding: 0.5rem;
    border: 1px solid var(--nbl-line);
    border-radius: 0.65rem;
    background: var(--nbl-bg);
    color: var(--nbl-muted);
    font-size: 0.78rem;
    font-weight: 750;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  .nbl-mood-options input:checked + span { border-color: var(--nbl-c0); background: color-mix(in srgb, var(--nbl-c0) 13%, var(--nbl-bg)); color: var(--nbl-text); }
  .nbl-mood-options input:focus-visible + span { outline: 2px solid var(--nbl-c0); outline-offset: 2px; }

  .nbl-energy-row { display: grid; gap: 0.65rem; }
  .nbl-energy-row label,
  .nbl-energy-scale { display: flex; align-items: center; justify-content: space-between; }
  .nbl-energy-row output { color: var(--nbl-c3); font: 700 0.76rem/1 var(--font-mono, ui-monospace, monospace); }
  .nbl-energy-row input { width: 100%; accent-color: var(--nbl-c0); cursor: pointer; }
  .nbl-energy-scale { color: var(--nbl-muted); font-size: 0.68rem; }

  .nbl-compose-button,
  .nbl-controls button,
  .nbl-lane-mute,
  .nbl-step {
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .nbl-compose-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.15rem;
    border-radius: 0.72rem;
    background: var(--nbl-c0);
    color: #071013;
    font-size: 0.9rem;
    font-weight: 850;
    transition: transform 160ms ease, filter 160ms ease;
  }
  .nbl-compose-button:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .nbl-compose-button:disabled { cursor: wait; filter: saturate(0.6); transform: none; }
  .nbl-compose-loader { display: none; align-items: center; gap: 0.22rem; }
  .nbl-compose-loader i { width: 0.3rem; height: 0.3rem; border-radius: 50%; background: currentColor; animation: nblBounce 900ms ease-in-out infinite; }
  .nbl-compose-loader i:nth-child(2) { animation-delay: 120ms; }
  .nbl-compose-loader i:nth-child(3) { animation-delay: 240ms; }
  .nbl-form[aria-busy="true"] .nbl-compose-loader { display: inline-flex; }
  .nbl-form-status { min-height: 1.2rem; margin: -0.25rem 0 0; color: var(--nbl-muted); font-size: 0.74rem; text-align: center; }
  .nbl-form-status[data-tone="error"] { color: #ef9a8f; }

  .nbl-player {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.2rem;
    width: min(80rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(1.4rem, 3vw, 2.25rem) 0 1.5rem;
  }

  .nbl-track-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nbl-track-source-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
  .nbl-source-badge { border-color: color-mix(in srgb, var(--nbl-c0) 45%, transparent); color: var(--nbl-c0); }
  .nbl-track-head h2 { margin: 0.7rem 0 0; color: var(--nbl-text); font-size: clamp(2rem, 4vw, 3.7rem); letter-spacing: -0.045em; line-height: 0.95; }
  .nbl-track-head p { max-width: 42rem; margin: 0.65rem 0 0; overflow: hidden; color: var(--nbl-muted); font-size: 0.84rem; text-overflow: ellipsis; white-space: nowrap; }

  .nbl-controls { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.5rem; }
  .nbl-controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.65rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--nbl-line-strong);
    border-radius: 0.65rem;
    background: var(--nbl-panel);
    color: var(--nbl-text);
    font-size: 0.78rem;
    font-weight: 800;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  .nbl-controls button:hover { border-color: var(--nbl-c0); background: var(--nbl-panel-strong); transform: translateY(-1px); }
  .nbl-controls button svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .nbl-controls .nbl-play { min-width: 6.5rem; border-color: var(--nbl-c0); background: var(--nbl-c0); color: #071013; }
  .nbl-controls .nbl-play svg { fill: currentColor; stroke: none; }
  .nbl-pause-icon { display: none; }
  .nbl-root[data-nbl-playing="true"] .nbl-play-icon { display: none; }
  .nbl-root[data-nbl-playing="true"] .nbl-pause-icon { display: block; }

  .nbl-visualizer {
    position: relative;
    min-height: clamp(6rem, 15vh, 9rem);
    overflow: hidden;
    border: 1px solid var(--nbl-line);
    border-radius: 0.85rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--nbl-c0) 7%, transparent), transparent),
      repeating-linear-gradient(90deg, transparent 0, transparent calc(6.25% - 1px), var(--nbl-line) calc(6.25% - 1px), var(--nbl-line) 6.25%),
      var(--nbl-panel);
  }
  .nbl-visualizer canvas { display: block; width: 100%; height: clamp(6rem, 15vh, 9rem); }
  .nbl-step-pulse { position: absolute; inset: auto 0 0; display: grid; grid-template-columns: repeat(16, 1fr); height: 0.25rem; }
  .nbl-step-pulse span { background: transparent; }
  .nbl-step-pulse span.is-current { background: var(--nbl-c3); box-shadow: 0 0 1rem var(--nbl-c3); }

  .nbl-sequencer-region {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--nbl-line);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--nbl-panel) 92%, transparent);
  }
  .nbl-sequencer-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1rem; border-bottom: 1px solid var(--nbl-line); }
  .nbl-sequencer-heading h3 { margin: 0; font-size: 0.92rem; }
  .nbl-sequencer-heading p { margin: 0.2rem 0 0; color: var(--nbl-muted); font-size: 0.7rem; }
  .nbl-sequencer-heading > span { color: var(--nbl-muted); font: 700 0.7rem/1 var(--font-mono, ui-monospace, monospace); }
  .nbl-sequencer-scroll { flex: 1; min-height: 0; overflow: auto; padding: 0.6rem; outline: 0; }
  .nbl-sequencer-scroll:focus-visible { box-shadow: inset 0 0 0 2px var(--nbl-c0); }
  .nbl-sequencer { display: grid; gap: 0.4rem; min-width: 47rem; }
  .nbl-step-numbers,
  .nbl-lane { display: grid; grid-template-columns: 7rem repeat(16, minmax(1.8rem, 1fr)); gap: 0.3rem; align-items: center; }
  .nbl-step-numbers i { color: color-mix(in srgb, var(--nbl-muted) 62%, transparent); font: normal 0.58rem/1 var(--font-mono, ui-monospace, monospace); text-align: center; }
  .nbl-step-numbers i.is-beat { color: var(--nbl-text); }
  .nbl-lane { --lane: var(--nbl-c0); }
  .nbl-lane-mute {
    position: sticky;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    min-height: 2.45rem;
    padding: 0.35rem 0.45rem;
    border: 1px solid var(--nbl-line);
    border-radius: 0.55rem;
    background: var(--nbl-panel);
    color: var(--nbl-text);
    text-align: left;
  }
  .nbl-lane-mute > span:last-child,
  .nbl-lane-mute strong,
  .nbl-lane-mute small { display: block; min-width: 0; }
  .nbl-lane-mute strong { overflow: hidden; font-size: 0.72rem; text-overflow: ellipsis; }
  .nbl-lane-mute small { margin-top: 0.08rem; overflow: hidden; color: var(--nbl-muted); font-size: 0.58rem; text-overflow: ellipsis; white-space: nowrap; }
  .nbl-lane-dot { flex: 0 0 auto; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--lane); box-shadow: 0 0 0.7rem color-mix(in srgb, var(--lane) 55%, transparent); }
  .nbl-lane-mute[aria-pressed="true"] { opacity: 0.55; }
  .nbl-lane-mute[aria-pressed="true"] .nbl-lane-dot { background: transparent; box-shadow: inset 0 0 0 1px var(--nbl-muted); }

  .nbl-step {
    position: relative;
    display: grid;
    width: 100%;
    min-width: 1.8rem;
    min-height: 2.45rem;
    place-items: center;
    border: 1px solid var(--nbl-line);
    border-radius: 0.48rem;
    background: color-mix(in srgb, var(--nbl-bg) 72%, var(--nbl-panel));
    transition: border-color 100ms ease, background-color 100ms ease, transform 100ms ease;
  }
  .nbl-step.is-beat-start { border-left-color: var(--nbl-line-strong); }
  .nbl-step span { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: transparent; transition: transform 100ms ease, background-color 100ms ease; }
  .nbl-step[data-on="true"] { border-color: color-mix(in srgb, var(--lane) 62%, transparent); background: color-mix(in srgb, var(--lane) 18%, var(--nbl-bg)); }
  .nbl-step[data-on="true"] span { background: var(--lane); box-shadow: 0 0 0.65rem color-mix(in srgb, var(--lane) 60%, transparent); }
  .nbl-step.is-current { border-color: var(--nbl-text); transform: translateY(-1px); }
  .nbl-step:hover { border-color: var(--lane); }

  .nbl-player-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 1.5rem; }
  .nbl-player-footer p { margin: 0; color: var(--nbl-muted); font-size: 0.68rem; }
  .nbl-player-footer p:last-child { text-align: right; }

  .nbl-root button:focus-visible,
  .nbl-root input:focus-visible,
  .nbl-root textarea:focus-visible {
    outline: 2px solid var(--nbl-c0);
    outline-offset: 2px;
  }

  @keyframes nblBounce {
    0%, 100% { transform: translateY(0); opacity: 0.45; }
    50% { transform: translateY(-0.2rem); opacity: 1; }
  }

  @media (max-width: 760px) {
    .nbl-topbar { min-height: 4rem; }
    .nbl-top-status { display: none; }
    .nbl-setup { grid-template-columns: 1fr; align-content: center; gap: 1.8rem; width: min(100% - 1.4rem, 34rem); padding: 1.4rem 0 2rem; }
    .nbl-setup-copy { text-align: center; }
    .nbl-setup-copy h1 { max-width: 9ch; margin-inline: auto; font-size: clamp(2.7rem, 14vw, 4.2rem); }
    .nbl-setup-copy p { margin-top: 1rem; font-size: 0.95rem; }
    .nbl-mood-options { grid-template-columns: repeat(2, 1fr); }
    .nbl-player { width: calc(100% - 1.2rem); gap: 0.85rem; padding-top: 1rem; }
    .nbl-track-head { align-items: stretch; flex-direction: column; gap: 1rem; }
    .nbl-track-head h2 { font-size: 2.25rem; }
    .nbl-track-head p { white-space: normal; }
    .nbl-controls { justify-content: stretch; }
    .nbl-controls button { flex: 1; padding-inline: 0.55rem; }
    .nbl-controls .nbl-play { flex: 1.15; }
    .nbl-visualizer,
    .nbl-visualizer canvas { min-height: 5.5rem; height: 5.5rem; }
    .nbl-sequencer-heading p { display: none; }
    .nbl-player-footer { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
    .nbl-player-footer p:last-child { text-align: left; }
  }

  @media (max-height: 700px) and (min-width: 761px) {
    .nbl-setup { padding-block: 1.5rem; }
    .nbl-setup-copy h1 { font-size: 4rem; }
    .nbl-form { gap: 0.8rem; }
    .nbl-form textarea { min-height: 5rem; }
    .nbl-player { gap: 0.75rem; padding-top: 1rem; }
    .nbl-visualizer,
    .nbl-visualizer canvas { min-height: 5rem; height: 5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nbl-root *,
    .nbl-root *::before,
    .nbl-root *::after {
      scroll-behavior: auto !important;
      animation: none !important;
      transition: none !important;
    }
    .nbl-step.is-current,
    .nbl-compose-button:hover,
    .nbl-controls button:hover { transform: none; }
    .nbl-step-pulse span.is-current { box-shadow: none; }
  }
</style>

<script>
  type Mood = 'dreamy' | 'focused' | 'bright' | 'electric';
  type LaneName = 'kick' | 'clap' | 'hats' | 'synth';
  type BeatPatterns = Record<LaneName, number[]>;
  type BeatArrangement = {
    title: string;
    tempo: number;
    root: number;
    palette: [string, string, string, string];
    patterns: BeatPatterns;
  };
  type BeatInput = { prompt: string; mood: Mood; energy: number; remix: number };
  type ArrangementResponse = { source: 'ai' | 'local'; arrangement: BeatArrangement };

  const lab = document.querySelector<HTMLElement>('[data-neural-beat-lab]');

  if (lab) {
    const lanes: LaneName[] = ['kick', 'clap', 'hats', 'synth'];
    const laneLabels: Record<LaneName, string> = { kick: 'Kick', clap: 'Clap', hats: 'Hats', synth: 'Pulse' };
    const form = lab.querySelector<HTMLFormElement>('[data-nbl-form]');
    const setupView = lab.querySelector<HTMLElement>('[data-nbl-setup]');
    const playerView = lab.querySelector<HTMLElement>('[data-nbl-player]');
    const promptInput = lab.querySelector<HTMLTextAreaElement>('#nbl-prompt');
    const energyInput = lab.querySelector<HTMLInputElement>('#nbl-energy');
    const energyOutput = lab.querySelector<HTMLOutputElement>('[data-nbl-energy-output]');
    const composeButton = lab.querySelector<HTMLButtonElement>('[data-nbl-compose]');
    const composeLabel = lab.querySelector<HTMLElement>('[data-nbl-compose-label]');
    const formStatus = lab.querySelector<HTMLElement>('[data-nbl-form-status]');
    const topStatus = lab.querySelector<HTMLElement>('[data-nbl-top-status]');
    const titleElement = lab.querySelector<HTMLElement>('[data-nbl-title]');
    const tempoElement = lab.querySelector<HTMLElement>('[data-nbl-tempo]');
    const briefElement = lab.querySelector<HTMLElement>('[data-nbl-brief]');
    const sourceElement = lab.querySelector<HTMLElement>('[data-nbl-source]');
    const sourceNote = lab.querySelector<HTMLElement>('[data-nbl-source-note]');
    const playerStatus = lab.querySelector<HTMLElement>('[data-nbl-player-status]');
    const playButton = lab.querySelector<HTMLButtonElement>('[data-nbl-play]');
    const playLabel = lab.querySelector<HTMLElement>('[data-nbl-play-label]');
    const remixButton = lab.querySelector<HTMLButtonElement>('[data-nbl-remix]');
    const resetButton = lab.querySelector<HTMLButtonElement>('[data-nbl-reset]');
    const visualizer = lab.querySelector<HTMLCanvasElement>('[data-nbl-visualizer]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let arrangement: BeatArrangement | null = null;
    let arrangementSource: 'ai' | 'local' = 'local';
    let currentInput: BeatInput | null = null;
    let remixCount = 0;
    let mutedLanes = new Set<LaneName>();
    let playing = false;
    let visibleStep = -1;
    let schedulerStep = 0;
    let nextStepTime = 0;
    let schedulerTimer: number | null = null;
    let visualFrame: number | null = null;
    let uiTimers: number[] = [];
    let audioContext: AudioContext | null = null;
    let masterGain: GainNode | null = null;
    let analyser: AnalyserNode | null = null;
    let noiseBuffer: AudioBuffer | null = null;
    let laneGains = {} as Record<LaneName, GainNode>;
    let activeSources = new Set<AudioScheduledSourceNode>();

    const setFormMessage = (message: string, tone = '') => {
      if (!formStatus) return;
      formStatus.textContent = message;
      if (tone) formStatus.dataset.tone = tone;
      else delete formStatus.dataset.tone;
    };

    const setPlayerMessage = (message: string) => {
      if (playerStatus) playerStatus.textContent = message;
    };

    const setBusy = (busy: boolean, label = 'Compose my track') => {
      if (form) form.setAttribute('aria-busy', String(busy));
      if (playerView) playerView.setAttribute('aria-busy', String(busy));
      if (composeButton) composeButton.disabled = busy;
      if (remixButton) remixButton.disabled = busy;
      if (resetButton) resetButton.disabled = busy;
      if (composeLabel) composeLabel.textContent = busy ? 'Composing...' : label;
      if (topStatus) topStatus.textContent = busy ? 'Shaping the loop...' : arrangement ? 'Track ready' : 'Ready to compose';
      lab.dataset.nblState = busy ? 'loading' : arrangement ? 'player' : 'setup';
    };

    const readMood = (): Mood => {
      const selected = form?.querySelector<HTMLInputElement>('input[name="mood"]:checked')?.value;
      return selected === 'focused' || selected === 'bright' || selected === 'electric' ? selected : 'dreamy';
    };

    const hash = (value: string) => {
      let result = 2166136261;
      for (let index = 0; index < value.length; index += 1) {
        result ^= value.charCodeAt(index);
        result = Math.imul(result, 16777619);
      }
      return result >>> 0;
    };

    const buildOfflineArrangement = (input: BeatInput): BeatArrangement => {
      const seed = hash(`${input.prompt}|${input.mood}|${input.energy}|${input.remix}`);
      const paletteMap: Record<Mood, [string, string, string, string]> = {
        dreamy: ['#79B8C9', '#C18BB9', '#9EBB8D', '#E1B980'],
        focused: ['#79A8B8', '#A7B59A', '#D2A47E', '#90A4C2'],
        bright: ['#67C8BE', '#F2B86B', '#E77E73', '#8CA8D8'],
        electric: ['#63C9E6', '#A78BFA', '#F472B6', '#F6C453'],
      };
      const titles: Record<Mood, string[]> = {
        dreamy: ['Velvet Orbit', 'Cloud Signals', 'Soft Afterglow'],
        focused: ['Quiet Momentum', 'Clear Method', 'Patient Current'],
        bright: ['Sunlit Circuit', 'Fresh Bounce', 'Golden Shortcut'],
        electric: ['Midnight Voltage', 'Neon Relay', 'Static Rush'],
      };
      const baseTempo: Record<Mood, number> = { dreamy: 84, focused: 96, bright: 108, electric: 120 };
      const kick = Array(16).fill(0);
      const clap = Array(16).fill(0);
      const hats = Array(16).fill(0);
      kick[0] = 1; kick[8] = 1;
      if (input.energy >= 2) kick[seed % 2 ? 6 : 10] = 1;
      if (input.energy >= 3) kick[14] = 1;
      if (input.energy >= 4) kick[seed % 3 ? 3 : 11] = 1;
      clap[4] = 1; clap[12] = 1;
      if (input.energy >= 5) clap[15] = 1;
      for (let step = 0; step < 16; step += 2) hats[step] = 1;
      if (input.energy >= 3) for (let step = 3; step < 16; step += 4) hats[step] = 1;
      const phraseMap: Record<Mood, number[]> = {
        dreamy: [0, -1, -1, 2, -1, -1, 4, -1, 3, -1, -1, 2, -1, 0, -1, -1],
        focused: [0, -1, 2, -1, 3, -1, 2, -1, 0, -1, 4, -1, 3, -1, 2, -1],
        bright: [0, -1, 2, 4, -1, 2, -1, 5, 4, -1, 2, -1, 3, 2, -1, 0],
        electric: [0, -1, 0, 3, -1, 5, 3, -1, 0, 2, -1, 5, 4, -1, 2, 6],
      };
      let synth = [...phraseMap[input.mood]];
      if (input.energy === 1) synth = synth.map((note, step) => step % 4 === 0 ? note : -1);
      return {
        title: titles[input.mood][seed % titles[input.mood].length],
        tempo: Math.max(82, Math.min(148, baseTempo[input.mood] + input.energy * 4 + seed % 5 - 2)),
        root: 45 + seed % 12,
        palette: paletteMap[input.mood],
        patterns: { kick, clap, hats, synth },
      };
    };

    const normalizeArrangement = (value: unknown): BeatArrangement | null => {
      if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
      const candidate = value as Record<string, unknown>;
      const title = typeof candidate.title === 'string' ? candidate.title.trim().slice(0, 42) : '';
      const tempo = Number(candidate.tempo);
      const rootNote = Number(candidate.root);
      const palette = Array.isArray(candidate.palette) ? candidate.palette : [];
      if (!title || !Number.isInteger(tempo) || tempo < 82 || tempo > 148) return null;
      if (!Number.isInteger(rootNote) || rootNote < 45 || rootNote > 57) return null;
      if (palette.length !== 4 || !palette.every(colour => typeof colour === 'string' && /^#[0-9a-f]{6}$/i.test(colour))) return null;
      if (!candidate.patterns || typeof candidate.patterns !== 'object' || Array.isArray(candidate.patterns)) return null;
      const rawPatterns = candidate.patterns as Record<string, unknown>;
      const patterns = {} as BeatPatterns;
      for (const lane of lanes) {
        const pattern = rawPatterns[lane];
        if (!Array.isArray(pattern) || pattern.length !== 16) return null;
        const values = pattern.map(Number);
        const valid = lane === 'synth'
          ? values.every(step => Number.isInteger(step) && step >= -1 && step <= 7)
          : values.every(step => step === 0 || step === 1);
        if (!valid) return null;
        patterns[lane] = values;
      }
      return {
        title,
        tempo,
        root: rootNote,
        palette: palette as [string, string, string, string],
        patterns,
      };
    };

    const requestArrangement = async (input: BeatInput): Promise<ArrangementResponse> => {
      const offline = { source: 'local' as const, arrangement: buildOfflineArrangement(input) };
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 12_000);
      try {
        const response = await fetch('/api/ai/beat-lab', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(input),
          signal: controller.signal,
        });
        if (!response.ok) return offline;
        const payload = await response.json() as Record<string, unknown>;
        const normalized = normalizeArrangement(payload.arrangement);
        const source = payload.source === 'ai' ? 'ai' : 'local';
        return normalized ? { source, arrangement: normalized } : offline;
      } catch {
        return offline;
      } finally {
        window.clearTimeout(timeout);
      }
    };

    const updateCell = (lane: LaneName, step: number) => {
      if (!arrangement) return;
      const cell = lab.querySelector<HTMLButtonElement>(`[data-nbl-step-lane="${lane}"][data-nbl-step="${step}"]`);
      if (!cell) return;
      const value = arrangement.patterns[lane][step];
      const on = lane === 'synth' ? value >= 0 : value === 1;
      cell.dataset.on = String(on);
      cell.setAttribute('aria-pressed', String(on));
      cell.setAttribute('aria-label', `${laneLabels[lane]} step ${step + 1}, ${on ? 'on' : 'off'}`);
    };

    const setPlayhead = (step: number) => {
      visibleStep = step;
      lab.querySelectorAll<HTMLElement>('[data-nbl-step]').forEach(cell => {
        cell.classList.toggle('is-current', Number(cell.dataset.nblStep) === step);
      });
      lab.querySelectorAll<HTMLElement>('[data-nbl-pulse]').forEach(pulse => {
        pulse.classList.toggle('is-current', Number(pulse.dataset.nblPulse) === step);
      });
      if (reducedMotion) drawStaticVisualizer();
    };

    const clearPlayhead = () => {
      visibleStep = -1;
      lab.querySelectorAll('.is-current').forEach(element => element.classList.remove('is-current'));
    };

    const renderArrangement = (response: ArrangementResponse) => {
      arrangement = response.arrangement;
      arrangementSource = response.source;
      arrangement.palette.forEach((colour, index) => lab.style.setProperty(`--nbl-c${index}`, colour));
      if (titleElement) titleElement.textContent = arrangement.title;
      if (tempoElement) tempoElement.textContent = `${arrangement.tempo} BPM`;
      if (briefElement) briefElement.textContent = currentInput?.prompt || '';
      if (sourceElement) sourceElement.textContent = response.source === 'ai' ? 'AI arrangement' : 'Local arrangement';
      if (sourceNote) sourceNote.textContent = response.source === 'ai'
        ? 'Generated from your prompt with Gemini.'
        : 'Made by the lab’s built-in composer when AI is unavailable.';
      lanes.forEach(lane => arrangement?.patterns[lane].forEach((_, step) => updateCell(lane, step)));
      drawStaticVisualizer();
      setPlayerMessage(response.source === 'ai'
        ? 'Your AI arrangement is ready. Press Play when you are.'
        : 'A local arrangement stepped in. Press Play when you are.');
    };

    const showPlayer = () => {
      if (setupView) setupView.hidden = true;
      if (playerView) playerView.hidden = false;
      lab.dataset.nblState = 'player';
      window.setTimeout(() => playButton?.focus(), 0);
    };

    const trackSource = (source: AudioScheduledSourceNode) => {
      activeSources.add(source);
      source.addEventListener('ended', () => activeSources.delete(source), { once: true });
    };

    const createAudio = async (): Promise<boolean> => {
      if (audioContext) return true;
      const AudioContextClass = window.AudioContext || (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
      if (!AudioContextClass) return false;
      try {
        const context = new AudioContextClass();
        const master = context.createGain();
        const meter = context.createAnalyser();
        meter.fftSize = 64;
        meter.smoothingTimeConstant = 0.72;
        master.gain.value = 0.56;
        master.connect(meter);
        meter.connect(context.destination);
        const gains = {} as Record<LaneName, GainNode>;
        lanes.forEach(lane => {
          const gain = context.createGain();
          gain.gain.value = mutedLanes.has(lane) ? 0 : 1;
          gain.connect(master);
          gains[lane] = gain;
        });
        const noise = context.createBuffer(1, context.sampleRate, context.sampleRate);
        const data = noise.getChannelData(0);
        for (let index = 0; index < data.length; index += 1) data[index] = Math.random() * 2 - 1;
        audioContext = context;
        masterGain = master;
        analyser = meter;
        laneGains = gains;
        noiseBuffer = noise;
        if (context.state === 'suspended') await context.resume();
        return true;
      } catch {
        return false;
      }
    };

    const playKick = (time: number) => {
      if (!audioContext) return;
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(145, time);
      oscillator.frequency.exponentialRampToValueAtTime(46, time + 0.2);
      gain.gain.setValueAtTime(0.001, time);
      gain.gain.linearRampToValueAtTime(0.95, time + 0.006);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.28);
      oscillator.connect(gain);
      gain.connect(laneGains.kick);
      oscillator.start(time);
      oscillator.stop(time + 0.3);
      trackSource(oscillator);
    };

    const playClap = (time: number) => {
      if (!audioContext || !noiseBuffer) return;
      const source = audioContext.createBufferSource();
      const filter = audioContext.createBiquadFilter();
      const gain = audioContext.createGain();
      source.buffer = noiseBuffer;
      filter.type = 'bandpass';
      filter.frequency.value = 1450;
      filter.Q.value = 0.7;
      gain.gain.setValueAtTime(0.001, time);
      gain.gain.linearRampToValueAtTime(0.32, time + 0.004);
      gain.gain.exponentialRampToValueAtTime(0.001, time + 0.16);
      source.connect(filter);
      filter.connect(gain);
      gain.connect(laneGains.clap);
      source.start(time, (time * 0.37) % 0.6, 0.18);
      source.stop(time + 0.19);
      trackSource(source);
    };

    const playHat = (time: number, accent: boolean) => {
      if (!audioContext || !noiseBuffer) return;
      const source = audioContext.createBufferSource();
      const filter = audioContext.createBiquadFilter();
      const gain = audioContext.createGain();
      source.buffer = noiseBuffer;
      filter.type = 'highpass';
      filter.frequency.value = 6800;
      gain.gain.setValueAtTime(accent ? 0.13 : 0.085, time);
      gain.gain.exponentialRampToValueAtTime(0.001, time + (accent ? 0.075 : 0.045));
      source.connect(filter);
      filter.connect(gain);
      gain.connect(laneGains.hats);
      source.start(time, (time * 0.71) % 0.8, 0.09);
      source.stop(time + 0.1);
      trackSource(source);
    };

    const playSynth = (time: number, degree: number, duration: number) => {
      if (!audioContext || !arrangement || !currentInput) return;
      const scales: Record<Mood, number[]> = {
        dreamy: [0, 3, 5, 7, 10, 12, 15, 17],
        focused: [0, 2, 3, 5, 7, 10, 12, 14],
        bright: [0, 2, 4, 5, 7, 9, 11, 12],
        electric: [0, 3, 5, 7, 10, 12, 15, 17],
      };
      const midi = arrangement.root + scales[currentInput.mood][degree];
      const frequency = 440 * Math.pow(2, (midi - 69) / 12);
      const first = audioContext.createOscillator();
      const second = audioContext.createOscillator();
      const filter = audioContext.createBiquadFilter();
      const gain = audioContext.createGain();
      first.type = currentInput.mood === 'electric' ? 'sawtooth' : 'triangle';
      second.type = 'sine';
      first.frequency.value = frequency;
      second.frequency.value = frequency / 2;
      second.detune.value = 4;
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(currentInput.mood === 'electric' ? 1500 : 1050, time);
      filter.frequency.exponentialRampToValueAtTime(420, time + duration);
      gain.gain.setValueAtTime(0.001, time);
      gain.gain.linearRampToValueAtTime(0.18, time + 0.018);
      gain.gain.exponentialRampToValueAtTime(0.001, time + duration);
      first.connect(filter);
      second.connect(filter);
      filter.connect(gain);
      gain.connect(laneGains.synth);
      first.start(time);
      second.start(time);
      first.stop(time + duration + 0.02);
      second.stop(time + duration + 0.02);
      trackSource(first);
      trackSource(second);
    };

    const scheduleStep = (step: number, time: number) => {
      if (!arrangement) return;
      const duration = 60 / arrangement.tempo / 4;
      if (arrangement.patterns.kick[step] === 1) playKick(time);
      if (arrangement.patterns.clap[step] === 1) playClap(time);
      if (arrangement.patterns.hats[step] === 1) playHat(time, step % 4 === 0);
      const degree = arrangement.patterns.synth[step];
      if (degree >= 0) playSynth(time, degree, duration * 1.7);
    };

    const scheduler = () => {
      if (!audioContext || !arrangement || !playing) return;
      const stepDuration = 60 / arrangement.tempo / 4;
      while (nextStepTime < audioContext.currentTime + 0.1) {
        const step = schedulerStep;
        scheduleStep(step, nextStepTime);
        const delay = Math.max(0, (nextStepTime - audioContext.currentTime) * 1000);
        const timer = window.setTimeout(() => setPlayhead(step), delay);
        uiTimers.push(timer);
        nextStepTime += stepDuration;
        schedulerStep = (schedulerStep + 1) % 16;
      }
    };

    const sizeCanvas = () => {
      if (!visualizer) return null;
      const width = Math.max(1, Math.round(visualizer.clientWidth));
      const height = Math.max(1, Math.round(visualizer.clientHeight));
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      if (visualizer.width !== Math.round(width * ratio) || visualizer.height !== Math.round(height * ratio)) {
        visualizer.width = Math.round(width * ratio);
        visualizer.height = Math.round(height * ratio);
      }
      const context = visualizer.getContext('2d');
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
      return context ? { context, width, height } : null;
    };

    function drawStaticVisualizer() {
      const sized = sizeCanvas();
      if (!sized) return;
      const { context, width, height } = sized;
      context.clearRect(0, 0, width, height);
      const colours = arrangement?.palette || ['#79B8C9', '#C18BB9', '#9EBB8D', '#E1B980'];
      const bars = 36;
      const gap = 3;
      const barWidth = Math.max(2, (width - gap * (bars - 1)) / bars);
      for (let index = 0; index < bars; index += 1) {
        const wave = 0.22 + Math.abs(Math.sin(index * 0.57 + (visibleStep + 1) * 0.2)) * 0.42;
        const barHeight = Math.max(3, wave * height);
        const gradient = context.createLinearGradient(0, height, 0, height - barHeight);
        gradient.addColorStop(0, colours[index % colours.length]);
        gradient.addColorStop(1, `${colours[(index + 1) % colours.length]}33`);
        context.fillStyle = gradient;
        context.fillRect(index * (barWidth + gap), height - barHeight, barWidth, barHeight);
      }
    }

    const drawLiveVisualizer = () => {
      if (!playing || reducedMotion || !analyser) return;
      const sized = sizeCanvas();
      if (!sized) return;
      const { context, width, height } = sized;
      const data = new Uint8Array(analyser.frequencyBinCount);
      analyser.getByteFrequencyData(data);
      context.clearRect(0, 0, width, height);
      const colours = arrangement?.palette || ['#79B8C9', '#C18BB9', '#9EBB8D', '#E1B980'];
      const bars = data.length;
      const gap = 4;
      const barWidth = Math.max(3, (width - gap * (bars - 1)) / bars);
      for (let index = 0; index < bars; index += 1) {
        const strength = Math.max(0.04, data[index] / 255);
        const barHeight = Math.max(3, strength * height * 0.92);
        const gradient = context.createLinearGradient(0, height, 0, height - barHeight);
        gradient.addColorStop(0, colours[index % colours.length]);
        gradient.addColorStop(1, `${colours[(index + 1) % colours.length]}55`);
        context.fillStyle = gradient;
        context.fillRect(index * (barWidth + gap), height - barHeight, barWidth, barHeight);
      }
      visualFrame = window.requestAnimationFrame(drawLiveVisualizer);
    };

    const stopPlayback = (clearStep = false) => {
      playing = false;
      lab.dataset.nblPlaying = 'false';
      if (schedulerTimer !== null) window.clearInterval(schedulerTimer);
      schedulerTimer = null;
      uiTimers.forEach(timer => window.clearTimeout(timer));
      uiTimers = [];
      if (visualFrame !== null) window.cancelAnimationFrame(visualFrame);
      visualFrame = null;
      activeSources.forEach(source => { try { source.stop(); } catch {} });
      activeSources.clear();
      const context = audioContext;
      audioContext = null;
      masterGain = null;
      analyser = null;
      noiseBuffer = null;
      laneGains = {} as Record<LaneName, GainNode>;
      if (context && context.state !== 'closed') context.close().catch(() => {});
      if (playLabel) playLabel.textContent = 'Play';
      if (playButton) playButton.setAttribute('aria-label', 'Play track');
      if (clearStep) clearPlayhead();
      drawStaticVisualizer();
    };

    const startPlayback = async () => {
      if (!arrangement) return;
      const audioReady = await createAudio();
      if (!audioReady || !audioContext) {
        setPlayerMessage('This browser could not start the audio engine. Try a current browser.');
        return;
      }
      playing = true;
      lab.dataset.nblPlaying = 'true';
      schedulerStep = visibleStep >= 0 ? (visibleStep + 1) % 16 : 0;
      nextStepTime = audioContext.currentTime + 0.05;
      if (playLabel) playLabel.textContent = 'Pause';
      if (playButton) playButton.setAttribute('aria-label', 'Pause track');
      setPlayerMessage(`${arrangementSource === 'ai' ? 'AI' : 'Local'} arrangement playing. Mute lanes or change steps live.`);
      scheduler();
      schedulerTimer = window.setInterval(scheduler, 25);
      if (!reducedMotion) visualFrame = window.requestAnimationFrame(drawLiveVisualizer);
      else drawStaticVisualizer();
    };

    const compose = async (input: BeatInput) => {
      setBusy(true);
      setFormMessage(input.remix > 0 ? 'Finding a fresh variation...' : 'Turning your idea into four musical lanes...');
      stopPlayback(true);
      const response = await requestArrangement(input);
      renderArrangement(response);
      showPlayer();
      setBusy(false);
    };

    energyInput?.addEventListener('input', () => {
      if (energyOutput) energyOutput.textContent = `${energyInput.value} / 5`;
    });

    form?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!promptInput || !energyInput) return;
      const prompt = promptInput.value.replace(/\s+/g, ' ').trim();
      if (prompt.length < 3) {
        setFormMessage('Add a few words about the track first.', 'error');
        promptInput.focus();
        return;
      }
      remixCount = 0;
      currentInput = { prompt: prompt.slice(0, 160), mood: readMood(), energy: Number(energyInput.value), remix: remixCount };
      await compose(currentInput);
    });

    playButton?.addEventListener('click', async () => {
      if (playing) {
        stopPlayback(false);
        setPlayerMessage('Paused. Your place in the loop is saved.');
      } else {
        await startPlayback();
      }
    });

    remixButton?.addEventListener('click', async () => {
      if (!currentInput) return;
      remixCount = Math.min(99, remixCount + 1);
      currentInput = { ...currentInput, remix: remixCount };
      await compose(currentInput);
    });

    resetButton?.addEventListener('click', () => {
      stopPlayback(true);
      arrangement = null;
      currentInput = null;
      remixCount = 0;
      mutedLanes.clear();
      form?.reset();
      if (energyOutput) energyOutput.textContent = '3 / 5';
      lab.style.removeProperty('--nbl-c0');
      lab.style.removeProperty('--nbl-c1');
      lab.style.removeProperty('--nbl-c2');
      lab.style.removeProperty('--nbl-c3');
      lab.querySelectorAll<HTMLButtonElement>('[data-nbl-mute]').forEach(button => button.setAttribute('aria-pressed', 'false'));
      if (playerView) playerView.hidden = true;
      if (setupView) setupView.hidden = false;
      lab.dataset.nblState = 'setup';
      if (topStatus) topStatus.textContent = 'Ready to compose';
      setFormMessage('Sound only starts when you press Play.');
      window.setTimeout(() => promptInput?.focus(), 0);
    });

    lab.querySelectorAll<HTMLButtonElement>('[data-nbl-mute]').forEach(button => {
      button.addEventListener('click', () => {
        const lane = button.dataset.nblMute as LaneName | undefined;
        if (!lane || !lanes.includes(lane)) return;
        if (mutedLanes.has(lane)) mutedLanes.delete(lane);
        else mutedLanes.add(lane);
        const muted = mutedLanes.has(lane);
        button.setAttribute('aria-pressed', String(muted));
        button.setAttribute('aria-label', `${muted ? 'Unmute' : 'Mute'} ${laneLabels[lane]} lane`);
        if (laneGains[lane] && audioContext) {
          laneGains[lane].gain.setTargetAtTime(muted ? 0 : 1, audioContext.currentTime, 0.015);
        }
        setPlayerMessage(`${laneLabels[lane]} ${muted ? 'muted' : 'back in the mix'}.`);
      });
    });

    lab.querySelectorAll<HTMLButtonElement>('[data-nbl-step-lane]').forEach(cell => {
      cell.addEventListener('click', () => {
        if (!arrangement) return;
        const lane = cell.dataset.nblStepLane as LaneName | undefined;
        const step = Number(cell.dataset.nblStep);
        if (!lane || !lanes.includes(lane) || !Number.isInteger(step) || step < 0 || step > 15) return;
        const current = arrangement.patterns[lane][step];
        arrangement.patterns[lane][step] = lane === 'synth'
          ? current >= 0 ? -1 : (step + (currentInput?.energy || 3) + remixCount) % 8
          : current === 1 ? 0 : 1;
        updateCell(lane, step);
        const updated = arrangement.patterns[lane][step];
        const isOn = lane === 'synth' ? updated >= 0 : updated === 1;
        setPlayerMessage(`${laneLabels[lane]} step ${step + 1} ${isOn ? 'added' : 'removed'}.`);
      });
    });

    const resizeObserver = typeof ResizeObserver !== 'undefined'
      ? new ResizeObserver(() => { if (!playing || reducedMotion) drawStaticVisualizer(); })
      : null;
    if (visualizer) resizeObserver?.observe(visualizer);
    drawStaticVisualizer();

    const visibilityObserver = typeof IntersectionObserver !== 'undefined'
      ? new IntersectionObserver(entries => {
          if (!entries[0]?.isIntersecting && playing) stopPlayback(false);
        }, { threshold: 0 })
      : null;
    visibilityObserver?.observe(lab);

    window.addEventListener('surrey-ai-project-modal-close', () => stopPlayback(true));
    window.addEventListener('pagehide', () => stopPlayback(true));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && playing) {
        stopPlayback(false);
        setPlayerMessage('Paused while this tab is away.');
      }
    });
  }
</script>
