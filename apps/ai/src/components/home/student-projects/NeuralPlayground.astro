---
---

<section data-neural-playground class="np-root" aria-label="Student Project: Neural Playground">
  <div class="np-shell">
    <header class="np-header">
      <span class="np-badge">Machine learning simulation</span>
      <h2>Neural Playground</h2>
      <p>Train a tiny classifier on labelled points and watch the decision boundary move as the model learns.</p>
    </header>

    <div class="np-stage">
      <div class="np-canvas-wrap">
        <canvas id="np-canvas" width="720" height="520" aria-label="Classifier decision boundary"></canvas>
      </div>

      <aside class="np-panel">
        <div class="np-metric">
          <span>Accuracy</span>
          <strong id="np-accuracy">0%</strong>
          <div><i id="np-accuracy-bar"></i></div>
        </div>
        <div class="np-metric">
          <span>Epoch</span>
          <strong id="np-epoch">0</strong>
          <div><i id="np-loss-bar"></i></div>
        </div>

        <div class="np-controls">
          <button type="button" id="np-train">Train 25 epochs</button>
          <button type="button" id="np-step">Step</button>
          <button type="button" id="np-reset">New data</button>
        </div>

        <label>
          <span>Learning rate</span>
          <input id="np-rate" type="range" min="0.005" max="0.08" value="0.035" step="0.005" />
        </label>

        <div class="np-readout" id="np-readout">
          A single neuron starts with random weights. Press train to reduce mistakes on the synthetic dataset.
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .np-root { height: 100%; overflow: hidden; color: var(--ai-fg); }
  .np-shell {
    width: min(100%, 78rem);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .np-header { max-width: 54rem; padding-right: 5.5rem; }
  .np-badge, .np-panel label span, .np-metric span {
    color: var(--ai-sage);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .np-header h2 {
    margin: 0.35rem 0 0;
    font-size: clamp(2.1rem, 4vw, 3.7rem);
    line-height: 0.95;
    font-weight: 850;
    letter-spacing: -0.04em;
  }
  .np-header p { max-width: 44rem; margin: 0.7rem 0 0; color: var(--ai-fg-muted); line-height: 1.5; }
  .np-stage {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.32fr);
    gap: 1rem;
  }
  .np-canvas-wrap, .np-panel {
    min-height: 0;
    border: 1px solid var(--ai-border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--ai-surface) 92%, transparent);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }
  .np-canvas-wrap { position: relative; }
  .np-canvas-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--ai-border) 1px, transparent 1px), linear-gradient(90deg, var(--ai-border) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.35;
  }
  #np-canvas { position: relative; width: 100%; height: 100%; display: block; }
  .np-panel { display: flex; flex-direction: column; gap: 1rem; padding: 1rem; }
  .np-metric {
    border: 1px solid var(--ai-border);
    border-radius: 0.85rem;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--ai-bg) 64%, transparent);
  }
  .np-metric strong { display: block; margin: 0.35rem 0 0.7rem; font-size: 2rem; line-height: 1; }
  .np-metric div { height: 0.55rem; border-radius: 999px; background: color-mix(in srgb, var(--ai-border) 70%, transparent); overflow: hidden; }
  .np-metric i { display: block; height: 100%; width: 0%; border-radius: inherit; background: var(--ai-sage); transition: width 0.25s ease; }
  .np-controls { display: grid; gap: 0.55rem; }
  .np-controls button {
    min-height: 2.55rem;
    border: 1px solid var(--ai-border);
    border-radius: 999px;
    background: transparent;
    color: var(--ai-fg);
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }
  #np-train { background: var(--ai-sage); border-color: var(--ai-sage); color: white; }
  .np-panel label { display: grid; gap: 0.55rem; }
  .np-panel input { width: 100%; accent-color: var(--ai-sage); }
  .np-readout { margin-top: auto; color: var(--ai-fg-muted); font-size: 0.92rem; line-height: 1.5; }
  @media (max-width: 820px) {
    .np-header { padding-right: 3.5rem; }
    .np-header p { display: none; }
    .np-stage { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; }
    .np-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .np-readout { display: none; }
  }
</style>

<script>
  const neuralRoot = document.querySelector('[data-neural-playground]');
  if (neuralRoot) {
    const canvas = neuralRoot.querySelector('#np-canvas');
    const ctx = canvas?.getContext('2d');
    const accuracyEl = neuralRoot.querySelector('#np-accuracy');
    const epochEl = neuralRoot.querySelector('#np-epoch');
    const accBar = neuralRoot.querySelector('#np-accuracy-bar');
    const lossBar = neuralRoot.querySelector('#np-loss-bar');
    const rateEl = neuralRoot.querySelector('#np-rate');
    const readout = neuralRoot.querySelector('#np-readout');
    const panel = neuralRoot.closest('.project-panel');
    let points = [];
    let weights = [Math.random() - 0.5, Math.random() - 0.5];
    let bias = Math.random() - 0.5;
    let epoch = 0;

    const sigmoid = (value) => 1 / (1 + Math.exp(-value));
    const classify = (x, y) => sigmoid(weights[0] * x + weights[1] * y + bias);
    const rand = (min, max) => min + Math.random() * (max - min);

    function makeData() {
      points = [];
      weights = [rand(-1, 1), rand(-1, 1)];
      bias = rand(-0.2, 0.2);
      epoch = 0;
      for (let index = 0; index < 74; index++) {
        const x = rand(-1, 1);
        const y = rand(-1, 1);
        const noise = rand(-0.22, 0.22);
        const label = x * 0.72 - y * 0.54 + noise > 0 ? 1 : 0;
        points.push({ x, y, label });
      }
      draw();
    }

    function metrics() {
      let correct = 0;
      let loss = 0;
      for (const point of points) {
        const prediction = classify(point.x, point.y);
        const binary = prediction >= 0.5 ? 1 : 0;
        if (binary === point.label) correct++;
        loss += Math.abs(point.label - prediction);
      }
      return { accuracy: points.length ? correct / points.length : 0, loss: points.length ? loss / points.length : 0 };
    }

    function trainOnce() {
      const lr = Number(rateEl?.value || 0.035);
      for (const point of points) {
        const prediction = classify(point.x, point.y);
        const error = point.label - prediction;
        weights[0] += error * point.x * lr;
        weights[1] += error * point.y * lr;
        bias += error * lr;
      }
      epoch += 1;
      draw();
    }

    function toScreen(point) {
      return {
        x: (point.x + 1) * 0.5 * canvas.width,
        y: (1 - (point.y + 1) * 0.5) * canvas.height,
      };
    }

    function draw() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      if (rect.width < 10 || rect.height < 10) return;
      const scale = window.devicePixelRatio || 1;
      canvas.width = Math.max(320, Math.floor(rect.width * scale));
      canvas.height = Math.max(240, Math.floor(rect.height * scale));
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      const w = rect.width;
      const h = rect.height;
      ctx.clearRect(0, 0, w, h);

      const cell = Math.max(18, Math.min(w, h) / 18);
      for (let x = 0; x < w; x += cell) {
        for (let y = 0; y < h; y += cell) {
          const nx = (x / w) * 2 - 1;
          const ny = -((y / h) * 2 - 1);
          const p = classify(nx, ny);
          ctx.fillStyle = p > 0.5 ? `rgba(16,185,129,${0.08 + p * 0.12})` : `rgba(79,70,229,${0.12 + (1 - p) * 0.1})`;
          ctx.fillRect(x, y, cell + 1, cell + 1);
        }
      }

      ctx.lineWidth = 2;
      ctx.strokeStyle = 'rgba(248,250,252,0.82)';
      ctx.beginPath();
      let started = false;
      for (let sx = 0; sx <= w; sx += 8) {
        const nx = (sx / w) * 2 - 1;
        const ny = weights[1] === 0 ? 0 : -(weights[0] * nx + bias) / weights[1];
        const sy = (1 - (ny + 1) * 0.5) * h;
        if (!started) { ctx.moveTo(sx, sy); started = true; } else { ctx.lineTo(sx, sy); }
      }
      ctx.stroke();

      for (const point of points) {
        const s = { x: (point.x + 1) * 0.5 * w, y: (1 - (point.y + 1) * 0.5) * h };
        ctx.beginPath();
        ctx.arc(s.x, s.y, 6, 0, Math.PI * 2);
        ctx.fillStyle = point.label ? '#10B981' : '#4F46E5';
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = classify(point.x, point.y) >= 0.5 === Boolean(point.label) ? 'rgba(255,255,255,0.65)' : '#FF6B6B';
        ctx.stroke();
      }

      const { accuracy, loss } = metrics();
      if (accuracyEl) accuracyEl.textContent = `${Math.round(accuracy * 100)}%`;
      if (epochEl) epochEl.textContent = String(epoch);
      if (accBar) accBar.style.width = `${Math.round(accuracy * 100)}%`;
      if (lossBar) lossBar.style.width = `${Math.round((1 - loss) * 100)}%`;
      if (readout) readout.textContent = `Weights: ${weights.map((item) => item.toFixed(2)).join(', ')}. Bias: ${bias.toFixed(2)}. Average error: ${loss.toFixed(2)}.`;
    }

    neuralRoot.querySelector('#np-train')?.addEventListener('click', () => {
      let remaining = 25;
      const tick = () => {
        trainOnce();
        remaining -= 1;
        if (remaining > 0) window.setTimeout(tick, 35);
      };
      tick();
    });
    neuralRoot.querySelector('#np-step')?.addEventListener('click', trainOnce);
    neuralRoot.querySelector('#np-reset')?.addEventListener('click', makeData);
    window.addEventListener('resize', draw);
    if ('ResizeObserver' in window && canvas?.parentElement) {
      new ResizeObserver(draw).observe(canvas.parentElement);
    }
    if (panel) {
      new MutationObserver(() => {
        if (!panel.hasAttribute('hidden')) window.requestAnimationFrame(draw);
      }).observe(panel, { attributes: true, attributeFilter: ['hidden'] });
    }
    makeData();
  }
</script>
