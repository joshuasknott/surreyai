---
---

<section data-pathfinding-lab class="pl-root" aria-label="Student Project: Pathfinding Lab">
  <div class="pl-shell">
    <header class="pl-header">
      <span class="pl-badge">Algorithm game</span>
      <h2>Pathfinding Lab</h2>
      <p>Place walls, move the start and goal, then compare how search algorithms explore a campus map.</p>
    </header>

    <div class="pl-stage">
      <div id="pl-grid" class="pl-grid" aria-label="Pathfinding grid"></div>
      <aside class="pl-panel">
        <div class="pl-tools" role="group" aria-label="Grid edit mode">
          <button type="button" data-tool="wall" aria-pressed="true">Walls</button>
          <button type="button" data-tool="start" aria-pressed="false">Start</button>
          <button type="button" data-tool="goal" aria-pressed="false">Goal</button>
        </div>
        <label>
          <span>Algorithm</span>
          <select id="pl-algorithm">
            <option value="astar">A* search</option>
            <option value="bfs">Breadth-first search</option>
          </select>
        </label>
        <div class="pl-actions">
          <button id="pl-run" type="button">Run search</button>
          <button id="pl-maze" type="button">Campus maze</button>
          <button id="pl-clear" type="button">Clear</button>
        </div>
        <div class="pl-stats">
          <div><strong id="pl-visited">0</strong><span>Visited</span></div>
          <div><strong id="pl-length">0</strong><span>Path length</span></div>
        </div>
        <p id="pl-status">Ready.</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .pl-root { height: 100%; overflow: hidden; color: var(--ai-fg); }
  .pl-shell { width: min(100%, 78rem); height: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
  .pl-header { max-width: 54rem; padding-right: 5.5rem; }
  .pl-badge, .pl-panel label span, .pl-stats span {
    color: var(--ai-coral);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .pl-header h2 { margin: 0.35rem 0 0; font-size: clamp(2.1rem, 4vw, 3.7rem); line-height: 0.95; font-weight: 850; letter-spacing: -0.04em; }
  .pl-header p { max-width: 44rem; margin: 0.7rem 0 0; color: var(--ai-fg-muted); line-height: 1.5; }
  .pl-stage { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.32fr); gap: 1rem; }
  .pl-grid, .pl-panel {
    min-height: 0;
    border: 1px solid var(--ai-border);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--ai-surface) 92%, transparent);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16);
  }
  .pl-grid {
    display: grid;
    grid-template-columns: repeat(16, minmax(0, 1fr));
    grid-template-rows: repeat(12, minmax(0, 1fr));
    gap: 0.3rem;
    padding: 0.85rem;
  }
  .pl-cell {
    border: 1px solid var(--ai-border);
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--ai-bg) 72%, transparent);
    cursor: pointer;
    transition: transform 0.12s ease, background-color 0.16s ease;
  }
  .pl-cell:hover { transform: scale(0.96); }
  .pl-cell[data-state="wall"] { background: #1E293B; border-color: #334155; }
  .pl-cell[data-state="start"] { background: var(--ai-sage); border-color: var(--ai-sage); }
  .pl-cell[data-state="goal"] { background: var(--ai-coral); border-color: var(--ai-coral); }
  .pl-cell[data-state="visited"] { background: color-mix(in srgb, var(--ai-azure) 50%, var(--ai-bg)); }
  .pl-cell[data-state="path"] { background: #FBBF24; border-color: #FBBF24; }
  .pl-panel { display: flex; flex-direction: column; gap: 1rem; padding: 1rem; }
  .pl-tools, .pl-actions { display: grid; gap: 0.55rem; }
  .pl-tools { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pl-tools button, .pl-actions button, .pl-panel select {
    min-height: 2.55rem;
    border: 1px solid var(--ai-border);
    border-radius: 999px;
    background: transparent;
    color: var(--ai-fg);
    font: inherit;
    font-weight: 850;
  }
  .pl-tools button, .pl-actions button { cursor: pointer; }
  .pl-tools button[aria-pressed="true"], #pl-run { background: var(--ai-coral); border-color: var(--ai-coral); color: white; }
  .pl-panel label { display: grid; gap: 0.55rem; }
  .pl-panel select { width: 100%; padding: 0 0.85rem; border-radius: 0.75rem; }
  .pl-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
  .pl-stats div { border: 1px solid var(--ai-border); border-radius: 0.85rem; padding: 0.8rem; background: color-mix(in srgb, var(--ai-bg) 64%, transparent); }
  .pl-stats strong { display: block; font-size: 1.8rem; line-height: 1; }
  .pl-panel p { margin: auto 0 0; color: var(--ai-fg-muted); line-height: 1.45; }
  @media (max-width: 820px) {
    .pl-header { padding-right: 3.5rem; }
    .pl-header p { display: none; }
    .pl-stage { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; }
    .pl-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pl-panel p { display: none; }
  }
</style>

<script>
  const pathRoot = document.querySelector('[data-pathfinding-lab]');
  if (pathRoot) {
    const rows = 12;
    const cols = 16;
    const grid = pathRoot.querySelector('#pl-grid');
    const visitedEl = pathRoot.querySelector('#pl-visited');
    const lengthEl = pathRoot.querySelector('#pl-length');
    const statusEl = pathRoot.querySelector('#pl-status');
    let start = { r: 5, c: 2 };
    let goal = { r: 6, c: 13 };
    let tool = 'wall';
    let walls = new Set();
    let running = false;
    const key = (cell) => `${cell.r},${cell.c}`;
    const parse = (value) => {
      const [r, c] = value.split(',').map(Number);
      return { r, c };
    };

    function stateFor(r, c) {
      const cellKey = key({ r, c });
      if (start.r === r && start.c === c) return 'start';
      if (goal.r === r && goal.c === c) return 'goal';
      if (walls.has(cellKey)) return 'wall';
      return 'empty';
    }

    function render(extra = new Map()) {
      if (!grid) return;
      grid.textContent = '';
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'pl-cell';
          button.dataset.r = String(r);
          button.dataset.c = String(c);
          button.dataset.state = extra.get(key({ r, c })) || stateFor(r, c);
          button.setAttribute('aria-label', `Row ${r + 1}, column ${c + 1}`);
          button.addEventListener('click', () => editCell(r, c));
          grid.appendChild(button);
        }
      }
    }

    function editCell(r, c) {
      if (running) return;
      const cellKey = key({ r, c });
      if (tool === 'start' && !(goal.r === r && goal.c === c)) {
        start = { r, c };
        walls.delete(cellKey);
      } else if (tool === 'goal' && !(start.r === r && start.c === c)) {
        goal = { r, c };
        walls.delete(cellKey);
      } else if (tool === 'wall' && !(start.r === r && start.c === c) && !(goal.r === r && goal.c === c)) {
        if (walls.has(cellKey)) walls.delete(cellKey); else walls.add(cellKey);
      }
      render();
    }

    function neighbors(cell) {
      return [
        { r: cell.r - 1, c: cell.c },
        { r: cell.r + 1, c: cell.c },
        { r: cell.r, c: cell.c - 1 },
        { r: cell.r, c: cell.c + 1 },
      ].filter((next) => next.r >= 0 && next.r < rows && next.c >= 0 && next.c < cols && !walls.has(key(next)));
    }

    function findPath() {
      const algorithm = pathRoot.querySelector('#pl-algorithm')?.value || 'astar';
      const open = [start];
      const cameFrom = new Map();
      const cost = new Map([[key(start), 0]]);
      const visited = [];
      const heuristic = (cell) => Math.abs(cell.r - goal.r) + Math.abs(cell.c - goal.c);
      const seen = new Set([key(start)]);

      while (open.length) {
        if (algorithm === 'astar') {
          open.sort((a, b) => (cost.get(key(a)) + heuristic(a)) - (cost.get(key(b)) + heuristic(b)));
        }
        const current = open.shift();
        const currentKey = key(current);
        visited.push(current);
        if (current.r === goal.r && current.c === goal.c) break;
        for (const next of neighbors(current)) {
          const nextKey = key(next);
          const nextCost = (cost.get(currentKey) || 0) + 1;
          if (!seen.has(nextKey) || nextCost < (cost.get(nextKey) || Infinity)) {
            seen.add(nextKey);
            cost.set(nextKey, nextCost);
            cameFrom.set(nextKey, currentKey);
            open.push(next);
          }
        }
      }

      const path = [];
      let current = key(goal);
      while (cameFrom.has(current)) {
        path.unshift(parse(current));
        current = cameFrom.get(current);
      }
      return { visited, path: path.filter((cell) => key(cell) !== key(goal) && key(cell) !== key(start)) };
    }

    async function run() {
      if (running) return;
      running = true;
      const { visited, path } = findPath();
      const extra = new Map();
      for (const cell of visited) {
        const cellKey = key(cell);
        if (cellKey !== key(start) && cellKey !== key(goal)) extra.set(cellKey, 'visited');
        render(extra);
        await new Promise((resolve) => window.setTimeout(resolve, 12));
      }
      for (const cell of path) extra.set(key(cell), 'path');
      render(extra);
      if (visitedEl) visitedEl.textContent = String(visited.length);
      if (lengthEl) lengthEl.textContent = String(path.length + (path.length ? 1 : 0));
      if (statusEl) statusEl.textContent = path.length ? 'Shortest route found.' : 'No route found with the current walls.';
      running = false;
    }

    pathRoot.querySelectorAll('[data-tool]').forEach((button) => {
      button.addEventListener('click', () => {
        tool = button.getAttribute('data-tool') || 'wall';
        pathRoot.querySelectorAll('[data-tool]').forEach((candidate) => {
          candidate.setAttribute('aria-pressed', candidate === button ? 'true' : 'false');
        });
      });
    });

    pathRoot.querySelector('#pl-run')?.addEventListener('click', run);
    pathRoot.querySelector('#pl-clear')?.addEventListener('click', () => { walls = new Set(); render(); });
    pathRoot.querySelector('#pl-maze')?.addEventListener('click', () => {
      walls = new Set();
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if ((r === start.r && c === start.c) || (r === goal.r && c === goal.c)) continue;
          if ((r % 2 === 0 && c > 1 && c < cols - 2 && c % 5 !== 0) || Math.random() < 0.08) walls.add(key({ r, c }));
        }
      }
      render();
    });
    render();
  }
</script>
