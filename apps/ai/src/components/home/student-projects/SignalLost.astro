---
---

<section
  class="sl-root"
  data-signal-lost
  data-phase="intro"
  data-scene-tone="alert"
  aria-labelledby="sl-title"
>
  <div class="sl-shell">
    <header class="sl-header">
      <div class="sl-brand">
        <span class="sl-brand__mark" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
        <div>
          <p class="sl-kicker">Interactive AI mystery</p>
          <h2 id="sl-title">Signal Lost</h2>
        </div>
      </div>

      <div class="sl-metrics" aria-label="Investigation status">
        <span><small>Case</small><strong data-case-metric>&mdash; / 3</strong></span>
        <span><small>Integrity</small><strong data-integrity-metric>100%</strong></span>
        <span><small>Solved</small><strong data-solved-metric>0 / 3</strong></span>
      </div>
    </header>

    <div class="sl-progress" aria-label="Case progress">
      <span data-progress-step="0"><i></i><b>Lab</b></span>
      <span data-progress-step="1"><i></i><b>Route</b></span>
      <span data-progress-step="2"><i></i><b>Broadcast</b></span>
    </div>

    <div class="sl-workspace">
      <div class="sl-visual-column">
        <div class="sl-scene-card">
          <div class="sl-scene-bar">
            <span><i class="sl-live-dot"></i> AURA control room</span>
            <span data-scene-clock>23:47:12</span>
          </div>

          <div class="sl-scene" data-scene>
            <svg viewBox="0 0 1000 620" role="img" aria-label="A dark control room with three monitoring screens and an AI console">
              <defs>
                <linearGradient id="sl-room" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#0b1b23" />
                  <stop offset="1" stop-color="#071015" />
                </linearGradient>
                <linearGradient id="sl-desk" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#162a32" />
                  <stop offset="1" stop-color="#0a171d" />
                </linearGradient>
                <radialGradient id="sl-orb" cx="50%" cy="45%" r="55%">
                  <stop offset="0" stop-color="#d8fbff" />
                  <stop offset="0.22" stop-color="#72d6e6" />
                  <stop offset="0.62" stop-color="#2f7183" />
                  <stop offset="1" stop-color="#132e39" />
                </radialGradient>
                <pattern id="sl-grid" width="26" height="26" patternUnits="userSpaceOnUse">
                  <path d="M26 0H0V26" fill="none" stroke="#8dc8d5" stroke-opacity=".08" />
                </pattern>
                <filter id="sl-glow" x="-100%" y="-100%" width="300%" height="300%">
                  <feGaussianBlur stdDeviation="8" result="blur" />
                  <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
              </defs>

              <rect width="1000" height="620" fill="url(#sl-room)" />
              <rect width="1000" height="620" fill="url(#sl-grid)" />
              <path d="M0 430L500 310L1000 430V620H0Z" fill="#091319" />
              <g stroke="#6eb2c0" stroke-opacity=".08">
                <path d="M500 310V620M500 310L180 620M500 310L820 620M500 310L0 530M500 310L1000 530" />
                <path d="M86 450H914M42 510H958M0 578H1000" />
              </g>

              <path d="M0 0H1000V54H0Z" fill="#050d11" />
              <path d="M76 0V54M924 0V54" stroke="#38525b" />
              <circle cx="104" cy="27" r="4" fill="#e57e69" />
              <circle cx="122" cy="27" r="4" fill="#d4ac68" />
              <circle cx="140" cy="27" r="4" fill="#79b99a" />

              <g class="sl-monitor-shell">
                <rect x="62" y="82" width="270" height="206" rx="12" fill="#050c10" stroke="#395763" />
                <rect x="78" y="98" width="238" height="174" rx="6" fill="#0b2028" stroke="#6ca4b4" stroke-opacity=".34" />
                <rect x="350" y="55" width="300" height="235" rx="12" fill="#050c10" stroke="#395763" />
                <rect x="366" y="71" width="268" height="203" rx="6" fill="#0b2028" stroke="#6ca4b4" stroke-opacity=".34" />
                <rect x="668" y="82" width="270" height="206" rx="12" fill="#050c10" stroke="#395763" />
                <rect x="684" y="98" width="238" height="174" rx="6" fill="#0b2028" stroke="#6ca4b4" stroke-opacity=".34" />
              </g>

              <g data-scene-layer="0">
                <text x="94" y="122" fill="#9db8c1" font-size="14" font-family="system-ui">AIR / PARTICLES</text>
                <path d="M96 222L130 220L160 219L190 216L212 128L232 218L274 220L300 218" fill="none" stroke="#e57e69" stroke-width="4" />
                <path d="M96 242L300 241" stroke="#78b99a" stroke-width="3" />
                <text x="98" y="260" fill="#78b99a" font-size="12" font-family="system-ui">HEAT NORMAL</text>

                <text x="390" y="101" fill="#9db8c1" font-size="14" font-family="system-ui">SAFETY AUTOMATION</text>
                <circle cx="500" cy="164" r="50" fill="#e57e69" fill-opacity=".12" stroke="#e57e69" stroke-width="3" />
                <path d="M500 128V171" stroke="#f2b3a6" stroke-width="7" stroke-linecap="round" />
                <circle cx="500" cy="189" r="5" fill="#f2b3a6" />
                <text x="454" y="238" fill="#f2b3a6" font-size="14" font-family="system-ui">LOCKDOWN</text>

                <text x="702" y="122" fill="#9db8c1" font-size="14" font-family="system-ui">VENT CAMERA</text>
                <path d="M710 235L752 176L792 210L830 148L895 235" fill="#17323b" stroke="#5e8b97" />
                <g stroke="#d9f4f5" stroke-opacity=".22" stroke-width="5">
                  <path d="M712 150C760 132 802 166 890 140" />
                  <path d="M704 177C762 155 838 197 900 166" />
                </g>

                <rect x="180" y="360" width="640" height="162" rx="18" fill="url(#sl-desk)" stroke="#355661" />
                <text x="212" y="396" fill="#9db8c1" font-size="13" font-family="system-ui">EVENT RUN / 22:40 FOG TEST</text>
                <path d="M212 420H440M212 444H386M212 468H472" stroke="#5f8793" stroke-width="10" stroke-linecap="round" opacity=".55" />
                <rect x="582" y="394" width="196" height="92" rx="8" fill="#0a1d24" stroke="#e57e69" stroke-opacity=".55" />
                <text x="605" y="425" fill="#e9b1a7" font-size="13" font-family="system-ui">RULE 04</text>
                <text x="605" y="452" fill="#9db8c1" font-size="12" font-family="system-ui">PARTICLES → SEAL</text>
              </g>

              <g data-scene-layer="1" hidden>
                <text x="94" y="122" fill="#9db8c1" font-size="14" font-family="system-ui">ROUTE CAMERA</text>
                <path d="M100 250L174 142M294 250L222 142" stroke="#ebf4f2" stroke-width="9" stroke-linecap="round" />
                <path d="M112 250L184 146M282 250L212 146" stroke="#f1c178" stroke-opacity=".65" stroke-width="3" />
                <text x="108" y="260" fill="#e5a487" font-size="12" font-family="system-ui">BOUNDARY CONFLICT</text>

                <text x="390" y="101" fill="#9db8c1" font-size="14" font-family="system-ui">CAMPUS ROUTE</text>
                <path d="M397 230C435 174 472 214 500 153C528 94 570 165 610 112" fill="none" stroke="#6dc2d1" stroke-width="12" stroke-linecap="round" opacity=".22" />
                <path d="M397 230C435 174 472 214 500 153C528 94 570 165 610 112" fill="none" stroke="#83d5df" stroke-width="3" stroke-dasharray="8 8" />
                <circle cx="500" cy="153" r="14" fill="#e57e69" filter="url(#sl-glow)" />
                <text x="445" y="254" fill="#e9b1a7" font-size="13" font-family="system-ui">SAFE STOP</text>

                <text x="702" y="122" fill="#9db8c1" font-size="14" font-family="system-ui">DEPTH SENSOR</text>
                <g fill="#75c4cf">
                  <circle cx="724" cy="154" r="3" /><circle cx="758" cy="174" r="3" /><circle cx="796" cy="148" r="3" />
                  <circle cx="842" cy="181" r="3" /><circle cx="884" cy="155" r="3" /><circle cx="744" cy="226" r="3" />
                  <circle cx="806" cy="220" r="3" /><circle cx="870" cy="230" r="3" />
                </g>
                <path d="M710 242H898" stroke="#78b99a" stroke-width="4" />
                <text x="720" y="262" fill="#78b99a" font-size="12" font-family="system-ui">PATH CLEAR</text>

                <rect x="180" y="360" width="640" height="162" rx="18" fill="url(#sl-desk)" stroke="#355661" />
                <text x="212" y="396" fill="#9db8c1" font-size="13" font-family="system-ui">VISION / DEPTH DISAGREEMENT</text>
                <path d="M212 430H448" stroke="#e57e69" stroke-width="13" stroke-linecap="round" opacity=".7" />
                <path d="M212 466H522" stroke="#78b99a" stroke-width="13" stroke-linecap="round" opacity=".7" />
                <path d="M592 388L770 474" stroke="#eef7f5" stroke-width="8" />
                <path d="M620 388L798 474" stroke="#eef7f5" stroke-width="8" />
              </g>

              <g data-scene-layer="2" hidden>
                <text x="94" y="122" fill="#9db8c1" font-size="14" font-family="system-ui">UPLOAD QUEUE</text>
                <rect x="98" y="142" width="198" height="42" rx="6" fill="#17333d" />
                <rect x="98" y="194" width="198" height="42" rx="6" fill="#3a2525" stroke="#e57e69" stroke-opacity=".6" />
                <text x="112" y="168" fill="#c8dde0" font-size="12" font-family="system-ui">launch_final.mp4</text>
                <text x="112" y="220" fill="#efb7ad" font-size="12" font-family="system-ui">launch_final.mp4</text>

                <text x="390" y="101" fill="#9db8c1" font-size="14" font-family="system-ui">LOBBY BROADCAST</text>
                <rect x="404" y="122" width="192" height="108" rx="5" fill="#6f2f31" />
                <path d="M434 151H566M434 174H540" stroke="#f5d6cd" stroke-width="12" stroke-linecap="round" opacity=".8" />
                <text x="430" y="210" fill="#f5d6cd" font-size="14" font-family="system-ui">EVENT PAUSED</text>
                <text x="462" y="254" fill="#e9b1a7" font-size="12" font-family="system-ui">12.0 SEC</text>

                <text x="702" y="122" fill="#9db8c1" font-size="14" font-family="system-ui">FEED HEALTH</text>
                <path d="M706 205L726 203L746 198L766 208L786 198L806 210L826 151L846 231L866 202L900 205" fill="none" stroke="#70c6d3" stroke-width="4" />
                <path d="M706 244H900" stroke="#e57e69" stroke-width="3" stroke-dasharray="8 7" />
                <text x="718" y="263" fill="#e9b1a7" font-size="12" font-family="system-ui">FAILOVER FIRED</text>

                <rect x="180" y="360" width="640" height="162" rx="18" fill="url(#sl-desk)" stroke="#355661" />
                <text x="212" y="396" fill="#9db8c1" font-size="13" font-family="system-ui">AUTOMATIC PUBLISH CHAIN</text>
                <g fill="#183640" stroke="#6aa7b5">
                  <rect x="212" y="424" width="135" height="54" rx="8" />
                  <rect x="433" y="424" width="135" height="54" rx="8" />
                  <rect x="654" y="424" width="135" height="54" rx="8" />
                </g>
                <path d="M347 451H433M568 451H654" stroke="#e57e69" stroke-width="3" stroke-dasharray="7 6" />
                <text x="237" y="456" fill="#bad2d7" font-size="12" font-family="system-ui">FEED DIP</text>
                <text x="452" y="456" fill="#bad2d7" font-size="12" font-family="system-ui">MATCH NAME</text>
                <text x="675" y="456" fill="#bad2d7" font-size="12" font-family="system-ui">PUBLISH</text>
              </g>

              <g data-scene-layer="finale" hidden>
                <g fill="#14382f" stroke="#79c49a">
                  <rect x="78" y="98" width="238" height="174" rx="6" />
                  <rect x="366" y="71" width="268" height="203" rx="6" />
                  <rect x="684" y="98" width="238" height="174" rx="6" />
                </g>
                <g fill="none" stroke="#b8f2ce" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M157 185L188 216L248 148" />
                  <path d="M446 176L483 213L557 128" />
                  <path d="M759 185L790 216L850 148" />
                </g>
                <rect x="180" y="360" width="640" height="162" rx="18" fill="#102b25" stroke="#79c49a" />
                <text x="332" y="422" fill="#b8f2ce" font-size="28" font-family="system-ui" letter-spacing="4">SIGNAL RESTORED</text>
                <path d="M280 458H720" stroke="#79c49a" stroke-width="3" />
              </g>

              <g class="sl-aura-orb" aria-hidden="true">
                <circle cx="500" cy="548" r="40" fill="#4ba8b9" fill-opacity=".12" filter="url(#sl-glow)" />
                <circle cx="500" cy="548" r="25" fill="url(#sl-orb)" stroke="#c7f4f7" stroke-opacity=".75" />
                <path d="M489 548H511" stroke="#09212a" stroke-width="4" stroke-linecap="round" />
              </g>
            </svg>

            <div class="sl-hotspots" data-hotspots aria-label="Evidence hotspots">
              <button type="button" data-hotspot="0"><span>1</span><b></b></button>
              <button type="button" data-hotspot="1"><span>2</span><b></b></button>
              <button type="button" data-hotspot="2"><span>3</span><b></b></button>
              <button type="button" data-hotspot="3"><span>4</span><b></b></button>
            </div>

            <div class="sl-intro" data-intro>
              <div class="sl-intro__card">
                <p><span></span> 23:47 / launch night</p>
                <h3>Three systems went dark.</h3>
                <div class="sl-intro__signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                <p class="sl-intro__copy">Inspect the room, question AURA, and restore the signal before the showcase opens.</p>
                <button type="button" class="sl-primary" data-start>Enter control room</button>
                <small>Three cases · about three minutes</small>
              </div>
            </div>

            <div class="sl-transmission" aria-live="polite">
              <span>Transmission</span>
              <strong data-transmission>Waiting for investigator</strong>
            </div>
          </div>
        </div>

        <section class="sl-tray" aria-labelledby="sl-tray-title">
          <div class="sl-tray__header">
            <h3 id="sl-tray-title">Evidence tray</h3>
            <span data-evidence-count>0 / 4 found</span>
          </div>
          <div class="sl-tray__items" data-evidence-tray role="list">
            <p data-tray-empty>Select a numbered signal in the room.</p>
          </div>
        </section>
      </div>

      <aside class="sl-panel" aria-label="Case file">
        <div class="sl-view sl-view--investigate" data-investigate-view>
          <div class="sl-case-heading">
            <p data-case-sector>Sector 01</p>
            <h3 data-case-title tabindex="-1">The Locked Lab</h3>
            <span data-case-time>Signal lost 22:41</span>
          </div>
          <p class="sl-briefing" data-case-briefing></p>

          <div class="sl-evidence-reader" data-evidence-reader>
            <span data-evidence-reader-label>Awaiting evidence</span>
            <h4 data-evidence-reader-title>Choose a signal marker</h4>
            <p data-evidence-reader-text>The room holds four clues. Two are enough to make a deduction.</p>
          </div>

          <div class="sl-aura">
            <div class="sl-aura__topline">
              <span class="sl-aura__face" aria-hidden="true"><i></i><i></i></span>
              <div><strong>AURA</strong><small data-aura-mode>Witness channel</small></div>
              <button type="button" data-ask-aura>Ask AURA</button>
            </div>
            <p data-aura-response aria-live="polite">I can offer one contextual nudge in each case.</p>
            <small class="sl-aura__note" data-aura-note hidden></small>
          </div>

          <button type="button" class="sl-primary sl-deduce-start" data-open-deduction disabled>
            Find 2 clues to deduce
          </button>
        </div>

        <div class="sl-view sl-view--deduction" data-deduction-view hidden>
          <button type="button" class="sl-back" data-back-to-evidence>&larr; Review evidence</button>
          <p class="sl-panel-kicker">Lock a deduction</p>
          <h3>What caused the signal loss?</h3>
          <div class="sl-options" data-deduction-options role="radiogroup" aria-label="Possible causes"></div>
          <p class="sl-deduction-feedback" data-deduction-feedback aria-live="polite">Choose the explanation that fits every clue.</p>
          <button type="button" class="sl-primary" data-confirm-deduction disabled>Confirm deduction</button>
        </div>

        <div class="sl-view sl-view--resolved" data-resolved-view hidden>
          <span class="sl-resolved-icon" aria-hidden="true">✓</span>
          <p class="sl-panel-kicker">Case resolved</p>
          <h3 data-resolution-title>Signal recovered</h3>
          <p data-resolution-text></p>
          <div class="sl-resolution-stats">
            <span><small>Clues found</small><strong data-resolution-clues>0 / 4</strong></span>
            <span><small>Integrity</small><strong data-resolution-integrity>100%</strong></span>
          </div>
          <button type="button" class="sl-primary" data-next-case>Open next case</button>
        </div>

        <div class="sl-view sl-view--finale" data-finale-view hidden>
          <p class="sl-panel-kicker">All sectors online</p>
          <h3 data-finale-title>Signal restored.</h3>
          <p class="sl-finale-lead">There was no rogue mastermind. Three ordinary systems acted on incomplete context.</p>
          <div class="sl-finale-causes" aria-label="Resolved causes">
            <span>Stage fog</span><span>Reflective banner</span><span>Rehearsal fallback</span>
          </div>
          <blockquote>“Automation followed the rules. You supplied the judgement.” <cite>— AURA</cite></blockquote>
          <div class="sl-final-score"><span>Final integrity</span><strong data-final-score>100%</strong></div>
          <button type="button" class="sl-primary" data-restart>Investigate again</button>
        </div>
      </aside>
    </div>

    <p class="sl-privacy">AURA receives only the current case ID and the clues you opened. Nothing from this game is saved.</p>
  </div>

  <noscript>
    <div class="sl-noscript">
      Signal Lost needs JavaScript for its evidence controls. The mystery's lesson still stands: automated systems need context and human judgement.
    </div>
  </noscript>
</section>

<style>
  .sl-root {
    --sl-bg: var(--ai-bg, #f7f8f3);
    --sl-surface: var(--ai-surface, #ffffff);
    --sl-text: var(--ai-fg, #172329);
    --sl-muted: var(--ai-fg-muted, #5e6c70);
    --sl-line: var(--ai-border, #dce4e0);
    --sl-line-strong: var(--ai-border-strong, #bfcbc8);
    --sl-blue: var(--ai-azure, #3f6d80);
    --sl-coral: var(--ai-coral, #a9674b);
    --sl-green: var(--ai-sage, #617c65);
    width: 100%;
    height: 100%;
    min-height: 44rem;
    box-sizing: border-box;
    color: var(--sl-text);
    background:
      radial-gradient(circle at 8% 10%, color-mix(in srgb, var(--sl-blue) 10%, transparent), transparent 24rem),
      radial-gradient(circle at 90% 90%, color-mix(in srgb, var(--sl-coral) 8%, transparent), transparent 25rem),
      var(--sl-bg);
    overflow: hidden;
  }

  .sl-root *,
  .sl-root *::before,
  .sl-root *::after { box-sizing: border-box; }

  .sl-root [hidden] { display: none !important; }

  .sl-shell {
    width: min(100%, 96rem);
    height: 100%;
    min-height: 0;
    margin: 0 auto;
    padding: clamp(1rem, 2.4vw, 2rem);
    display: flex;
    flex-direction: column;
    overflow: auto;
  }

  .sl-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex: 0 0 auto;
  }

  .sl-brand { display: flex; align-items: center; gap: .85rem; min-width: 0; }

  .sl-brand__mark {
    position: relative;
    width: 2.8rem;
    height: 2.8rem;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--sl-blue) 35%, var(--sl-line));
    border-radius: .75rem;
    background: color-mix(in srgb, var(--sl-blue) 10%, var(--sl-surface));
    display: grid;
    place-items: center;
  }

  .sl-brand__mark i { position: absolute; display: block; border-radius: 999px; }
  .sl-brand__mark i:nth-child(1) { width: 1.35rem; height: 1.35rem; border: 1px solid var(--sl-blue); }
  .sl-brand__mark i:nth-child(2) { width: .55rem; height: .55rem; background: var(--sl-coral); }
  .sl-brand__mark i:nth-child(3) { width: .18rem; height: 1.9rem; background: var(--sl-blue); transform: rotate(42deg); opacity: .42; }

  .sl-kicker,
  .sl-brand h2 { margin: 0; }
  .sl-kicker { color: var(--sl-blue); font-size: .67rem; font-weight: 850; letter-spacing: .11em; text-transform: uppercase; }
  .sl-brand h2 { margin-top: .12rem; font-size: clamp(1.35rem, 2.4vw, 2rem); line-height: 1; letter-spacing: -.03em; }

  .sl-metrics { display: flex; border: 1px solid var(--sl-line); border-radius: .9rem; background: color-mix(in srgb, var(--sl-surface) 88%, transparent); overflow: hidden; }
  .sl-metrics > span { min-width: 5.8rem; padding: .58rem .8rem; display: grid; gap: .08rem; }
  .sl-metrics > span + span { border-left: 1px solid var(--sl-line); }
  .sl-metrics small { color: var(--sl-muted); font-size: .61rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .sl-metrics strong { font-size: .88rem; }

  .sl-progress {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .45rem;
    margin: .8rem 0;
    flex: 0 0 auto;
  }

  .sl-progress > span { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: .45rem; color: var(--sl-muted); }
  .sl-progress i { display: block; height: .18rem; border-radius: 999px; background: var(--sl-line); }
  .sl-progress b { font-size: .63rem; font-weight: 750; }
  .sl-progress span.is-current i { background: var(--sl-coral); }
  .sl-progress span.is-current b { color: var(--sl-coral); }
  .sl-progress span.is-complete i { background: var(--sl-green); }
  .sl-progress span.is-complete b { color: var(--sl-green); }

  .sl-workspace {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(18rem, .62fr);
    gap: 1rem;
  }

  .sl-visual-column { min-width: 0; min-height: 0; display: grid; grid-template-rows: minmax(25rem, 1fr) auto; gap: .8rem; }
  .sl-scene-card { min-height: 0; border: 1px solid #29434d; border-radius: 1.05rem; overflow: hidden; background: #071015; box-shadow: 0 1.4rem 3rem rgba(4, 13, 17, .16); }
