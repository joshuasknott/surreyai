</style>

<script>
  type Evidence = {
    id: string;
    title: string;
    description: string;
    x: number;
    y: number;
  };

  type Deduction = { id: string; label: string };

  type SignalCase = {
    id: string;
    sector: string;
    title: string;
    time: string;
    clock: string;
    briefing: string;
    transmission: string;
    evidence: Evidence[];
    deductions: Deduction[];
    correctId: string;
    resolutionTitle: string;
    resolution: string;
  };

  const SIGNAL_CASES: SignalCase[] = [
    {
      id: "locked-lab",
      sector: "Sector 01 / Showcase lab",
      title: "The Locked Lab",
      time: "Signal lost 22:41",
      clock: "23:47:12",
      briefing: "The safety system sealed the lab after reporting smoke. Strangely, the heat alarm stayed quiet.",
      transmission: "Safety lock active / heat channel normal",
      evidence: [
        { id: "air-sensor", title: "Air sensor", description: "Particles spiked at 22:41, but the temperature line never moved.", x: 20, y: 29 },
        { id: "automation-log", title: "Automation log", description: "The lab sealed when particles rose. The rule never checked the heat reading.", x: 50, y: 25 },
        { id: "event-plan", title: "Event plan", description: "A stage-fog rehearsal began next door at 22:40—one minute before the alert.", x: 31, y: 70 },
        { id: "vent-camera", title: "Vent camera", description: "The haze cleared in ninety seconds. No continuing smoke source appears on camera.", x: 81, y: 31 },
      ],
      deductions: [
        { id: "fire", label: "A real fire started inside the showcase lab" },
        { id: "fog", label: "The rehearsal fog tripped an incomplete safety rule" },
        { id: "vent", label: "Someone deliberately disabled the ventilation" },
      ],
      correctId: "fog",
      resolutionTitle: "False alarm isolated",
      resolution: "Stage fog reached the air sensor. A one-signal safety rule reacted correctly—but without enough context.",
    },
    {
      id: "phantom-shuttle",
      sector: "Sector 02 / Campus route",
      title: "The Phantom Shuttle",
      time: "Signal lost 22:57",
      clock: "23:49:38",
      briefing: "The autonomous shuttle stopped beside the showcase hall even though its physical route was clear.",
      transmission: "Vehicle safe / camera-depth conflict",
      evidence: [
        { id: "route-camera", title: "Route camera", description: "The camera marked two bright diagonal strips as unexpected lane boundaries.", x: 19, y: 30 },
        { id: "lidar", title: "Depth sensor", description: "The depth map shows open space: no person, barrier, or vehicle blocked the route.", x: 81, y: 31 },
        { id: "print-order", title: "Banner order", description: "A reflective silver launch banner was installed beside the route at 22:55.", x: 70, y: 70 },
        { id: "brake-log", title: "Brake log", description: "The shuttle chose a safe stop because its camera and depth readings disagreed.", x: 50, y: 25 },
      ],
      deductions: [
        { id: "brake", label: "A passenger pulled the emergency brake" },
        { id: "forgot", label: "The route model forgot the campus map" },
        { id: "banner", label: "The reflective banner looked like a road marker" },
      ],
      correctId: "banner",
      resolutionTitle: "Route interpretation restored",
      resolution: "The reflective banner resembled lane paint to the camera. The shuttle's safe stop prevented a worse mistake.",
    },
    {
      id: "missing-message",
      sector: "Sector 03 / Lobby broadcast",
      title: "The Missing Message",
      time: "Signal lost 23:03",
      clock: "23:52:04",
      briefing: "Lobby screens replaced the countdown with an old cancellation card for exactly twelve seconds.",
      transmission: "Live feed stable / fallback origin unknown",
      evidence: [
        { id: "upload-queue", title: "Upload queue", description: "Two different clips entered the system with the same filename: launch_final.mp4.", x: 19, y: 30 },
        { id: "rehearsal-plan", title: "Rehearsal plan", description: "Yesterday's failover test used a temporary cancellation card on the lobby screens.", x: 69, y: 70 },
        { id: "fingerprint", title: "File fingerprint", description: "The twelve-second lobby clip exactly matches the old rehearsal asset. It was not newly generated.", x: 81, y: 31 },
        { id: "publish-rule", title: "Publish rule", description: "When the live feed dipped, the newest file with a matching name was promoted automatically.", x: 50, y: 25 },
      ],
      deductions: [
        { id: "aura", label: "AURA wrote a new cancellation message" },
        { id: "hack", label: "Someone hacked the lobby screen network" },
        { id: "fallback", label: "The failover rule promoted the rehearsal clip" },
      ],
      correctId: "fallback",
      resolutionTitle: "Broadcast chain corrected",
      resolution: "A brief feed dip promoted the newest matching filename—the old rehearsal card—without checking its meaning.",
    },
  ];

  document.querySelectorAll<HTMLElement>("[data-signal-lost]").forEach((root) => {
    if (root.dataset.signalLostReady === "true") return;
    root.dataset.signalLostReady = "true";

    const intro = root.querySelector<HTMLElement>("[data-intro]");
    const startButton = root.querySelector<HTMLButtonElement>("[data-start]");
    const investigateView = root.querySelector<HTMLElement>("[data-investigate-view]");
    const deductionView = root.querySelector<HTMLElement>("[data-deduction-view]");
    const resolvedView = root.querySelector<HTMLElement>("[data-resolved-view]");
    const finaleView = root.querySelector<HTMLElement>("[data-finale-view]");
    const caseMetric = root.querySelector<HTMLElement>("[data-case-metric]");
    const integrityMetric = root.querySelector<HTMLElement>("[data-integrity-metric]");
    const solvedMetric = root.querySelector<HTMLElement>("[data-solved-metric]");
    const sceneClock = root.querySelector<HTMLElement>("[data-scene-clock]");
    const transmission = root.querySelector<HTMLElement>("[data-transmission]");
    const caseSector = root.querySelector<HTMLElement>("[data-case-sector]");
    const caseTitle = root.querySelector<HTMLElement>("[data-case-title]");
    const caseTime = root.querySelector<HTMLElement>("[data-case-time]");
    const caseBriefing = root.querySelector<HTMLElement>("[data-case-briefing]");
    const evidenceCount = root.querySelector<HTMLElement>("[data-evidence-count]");
    const evidenceTray = root.querySelector<HTMLElement>("[data-evidence-tray]");
    const trayEmpty = root.querySelector<HTMLElement>("[data-tray-empty]");
    const readerLabel = root.querySelector<HTMLElement>("[data-evidence-reader-label]");
    const readerTitle = root.querySelector<HTMLElement>("[data-evidence-reader-title]");
    const readerText = root.querySelector<HTMLElement>("[data-evidence-reader-text]");
    const auraButton = root.querySelector<HTMLButtonElement>("[data-ask-aura]");
    const auraMode = root.querySelector<HTMLElement>("[data-aura-mode]");
    const auraResponse = root.querySelector<HTMLElement>("[data-aura-response]");
    const auraNote = root.querySelector<HTMLElement>("[data-aura-note]");
    const openDeduction = root.querySelector<HTMLButtonElement>("[data-open-deduction]");
    const deductionOptions = root.querySelector<HTMLElement>("[data-deduction-options]");
    const deductionFeedback = root.querySelector<HTMLElement>("[data-deduction-feedback]");
    const confirmDeduction = root.querySelector<HTMLButtonElement>("[data-confirm-deduction]");
    const backButton = root.querySelector<HTMLButtonElement>("[data-back-to-evidence]");
    const resolutionTitle = root.querySelector<HTMLElement>("[data-resolution-title]");
    const resolutionText = root.querySelector<HTMLElement>("[data-resolution-text]");
    const resolutionClues = root.querySelector<HTMLElement>("[data-resolution-clues]");
    const resolutionIntegrity = root.querySelector<HTMLElement>("[data-resolution-integrity]");
    const nextCaseButton = root.querySelector<HTMLButtonElement>("[data-next-case]");
    const finalScore = root.querySelector<HTMLElement>("[data-final-score]");
    const finaleTitle = root.querySelector<HTMLElement>("[data-finale-title]");
    const restartButton = root.querySelector<HTMLButtonElement>("[data-restart]");
    const hotspots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-hotspot]"));
    const progressSteps = Array.from(root.querySelectorAll<HTMLElement>("[data-progress-step]"));
    const sceneLayers = Array.from(root.querySelectorAll<SVGGElement>("[data-scene-layer]"));

    if (
      !intro || !startButton || !investigateView || !deductionView || !resolvedView ||
      !finaleView || !caseMetric || !integrityMetric || !solvedMetric || !sceneClock ||
      !transmission || !caseSector || !caseTitle || !caseTime || !caseBriefing ||
      !evidenceCount || !evidenceTray || !trayEmpty || !readerLabel || !readerTitle ||
      !readerText || !auraButton || !auraMode || !auraResponse || !auraNote ||
      !openDeduction || !deductionOptions || !deductionFeedback || !confirmDeduction ||
      !backButton || !resolutionTitle || !resolutionText || !resolutionClues ||
      !resolutionIntegrity || !nextCaseButton || !finalScore || !finaleTitle || !restartButton
    ) return;

    let caseIndex = 0;
    let integrity = 100;
    let solved = 0;
    let selectedDeduction = "";
    let collected = new Set<string>();
    let rejected = new Set<string>();
    let auraUsed = false;
    let auraController: AbortController | null = null;

    const currentCase = () => SIGNAL_CASES[caseIndex];

    function setPhase(phase: "intro" | "investigate" | "deduce" | "resolved" | "finale") {
      root.dataset.phase = phase;
      intro.hidden = phase !== "intro";
      investigateView.hidden = phase !== "intro" && phase !== "investigate";
      deductionView.hidden = phase !== "deduce";
      resolvedView.hidden = phase !== "resolved";
      finaleView.hidden = phase !== "finale";
    }

    function updateMetrics() {
      caseMetric.textContent = root.dataset.phase === "intro" ? "— / 3" : `${Math.min(caseIndex + 1, 3)} / 3`;
      integrityMetric.textContent = `${integrity}%`;
      solvedMetric.textContent = `${solved} / 3`;
      progressSteps.forEach((step, index) => {
        step.classList.toggle("is-current", root.dataset.phase !== "intro" && index === caseIndex && solved <= index);
        step.classList.toggle("is-complete", index < solved || root.dataset.phase === "finale");
      });
    }

    function showSceneLayer(layer: string) {
      sceneLayers.forEach((item) => {
        item.hidden = item.dataset.sceneLayer !== layer;
      });
    }

    function showEvidence(item: Evidence, number: number) {
      readerLabel.textContent = `Evidence ${String(number).padStart(2, "0")}`;
      readerTitle.textContent = item.title;
      readerText.textContent = item.description;
    }

    function addEvidenceChip(item: Evidence, number: number) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "sl-evidence-chip";
      chip.setAttribute("role", "listitem");
      chip.setAttribute("aria-label", `Review evidence: ${item.title}`);
      const index = document.createElement("span");
      index.textContent = String(number);
      const label = document.createElement("strong");
      label.textContent = item.title;
      chip.append(index, label);
      chip.addEventListener("click", () => showEvidence(item, number));
      evidenceTray.append(chip);
    }

    function inspectEvidence(index: number) {
      if (root.dataset.phase !== "investigate") return;
      const item = currentCase().evidence[index];
      if (!item) return;

      const isNew = !collected.has(item.id);
      if (isNew) {
        collected.add(item.id);
        trayEmpty.hidden = true;
        hotspots[index]?.classList.add("is-found");
        hotspots[index]?.setAttribute("aria-pressed", "true");
        addEvidenceChip(item, index + 1);
        evidenceCount.textContent = `${collected.size} / 4 found`;
        transmission.textContent = `Evidence captured / ${item.title}`;
      }

      showEvidence(item, index + 1);
      if (collected.size >= 2) {
        openDeduction.disabled = false;
        openDeduction.textContent = "Make a deduction";
      } else {
        openDeduction.textContent = `Find ${2 - collected.size} more clue${collected.size === 1 ? "" : "s"} to deduce`;
      }
    }

    function renderHotspots() {
      hotspots.forEach((button, index) => {
        const item = currentCase().evidence[index];
        if (!item) return;
        button.style.setProperty("--hotspot-x", `${item.x}%`);
        button.style.setProperty("--hotspot-y", `${item.y}%`);
        button.classList.remove("is-found");
        button.setAttribute("aria-pressed", "false");
        button.setAttribute("aria-label", `Inspect ${item.title}`);
        const label = button.querySelector<HTMLElement>("b");
        if (label) label.textContent = item.title;
      });
    }

    function renderDeductionOptions() {
      deductionOptions.replaceChildren();
      currentCase().deductions.forEach((deduction) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "sl-option";
        button.dataset.deductionId = deduction.id;
        button.setAttribute("role", "radio");
        button.setAttribute("aria-checked", "false");
        button.textContent = deduction.label;
        button.addEventListener("click", () => {
          if (rejected.has(deduction.id)) return;
          selectedDeduction = deduction.id;
          deductionOptions.querySelectorAll<HTMLButtonElement>(".sl-option").forEach((option) => {
            option.setAttribute("aria-checked", option === button ? "true" : "false");
          });
          deductionFeedback.dataset.tone = "";
          deductionFeedback.textContent = "Ready to test that theory against the evidence.";
          confirmDeduction.disabled = false;
        });
        deductionOptions.append(button);
      });
    }

    function renderCase() {
      const item = currentCase();
      collected = new Set();
      rejected = new Set();
      selectedDeduction = "";
      auraUsed = false;
      root.dataset.sceneTone = "alert";
      caseSector.textContent = item.sector;
      caseTitle.textContent = item.title;
      caseTime.textContent = item.time;
      caseBriefing.textContent = item.briefing;
      sceneClock.textContent = item.clock;
      transmission.textContent = item.transmission;
      evidenceCount.textContent = "0 / 4 found";
      evidenceTray.querySelectorAll(".sl-evidence-chip").forEach((chip) => chip.remove());
      trayEmpty.hidden = false;
      readerLabel.textContent = "Awaiting evidence";
      readerTitle.textContent = "Choose a signal marker";
      readerText.textContent = "The room holds four clues. Two are enough to make a deduction.";
      auraMode.textContent = "Witness channel";
      auraResponse.textContent = "I can offer one contextual nudge in each case.";
      auraNote.hidden = true;
      auraNote.textContent = "";
      auraButton.disabled = false;
      auraButton.textContent = "Ask AURA";
      openDeduction.disabled = true;
      openDeduction.textContent = "Find 2 clues to deduce";
      deductionFeedback.dataset.tone = "";
      deductionFeedback.textContent = "Choose the explanation that fits every clue.";
      confirmDeduction.disabled = true;
      renderHotspots();
      renderDeductionOptions();
      showSceneLayer(String(caseIndex));
      setPhase("investigate");
      updateMetrics();
      window.setTimeout(() => caseTitle.focus(), 0);
    }

    async function askAura() {
      if (auraUsed || auraController) return;
      auraButton.disabled = true;
      auraButton.textContent = "Listening…";
      auraResponse.textContent = "AURA is checking the signals you opened…";
      auraMode.textContent = "Connecting";
      auraNote.hidden = true;

      const controller = new AbortController();
      auraController = controller;
      let timedOut = false;
      const timeout = window.setTimeout(() => {
        timedOut = true;
        controller.abort();
      }, 11_500);

      try {
        const response = await fetch("/api/ai/signal-lost", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ caseId: currentCase().id, evidence: Array.from(collected) }),
          signal: controller.signal,
        });
        const payload = await response.json() as Record<string, unknown>;
        if (!response.ok || typeof payload.message !== "string") {
          throw new Error(typeof payload.error === "string" ? payload.error : "AURA did not answer.");
        }

        auraUsed = true;
        auraMode.textContent = payload.source === "ai" ? "Live witness" : "Built-in case notes";
        auraResponse.textContent = payload.message;
        auraButton.textContent = "AURA answered";
        auraButton.disabled = true;
        if (typeof payload.modeNote === "string") {
          auraNote.textContent = payload.modeNote;
          auraNote.hidden = false;
        }
      } catch (error) {
        if (controller.signal.aborted && !timedOut) return;
        auraMode.textContent = "Channel interrupted";
        auraResponse.textContent = timedOut
          ? "AURA's reply took too long. Your investigation can continue without it."
          : error instanceof Error ? error.message : "AURA did not answer. Continue with the evidence.";
        auraButton.disabled = false;
        auraButton.textContent = "Retry AURA";
      } finally {
        window.clearTimeout(timeout);
        if (auraController === controller) auraController = null;
      }
    }

    function openDeductionView() {
      if (collected.size < 2) return;
      setPhase("deduce");
      selectedDeduction = "";
      confirmDeduction.disabled = true;
      deductionOptions.querySelectorAll<HTMLButtonElement>(".sl-option").forEach((option) => {
        option.setAttribute("aria-checked", "false");
      });
      deductionOptions.querySelector<HTMLButtonElement>(".sl-option:not(.is-rejected)")?.focus();
    }

    function confirmChoice() {
      if (!selectedDeduction) return;
      const item = currentCase();
      if (selectedDeduction !== item.correctId) {
        integrity = Math.max(40, integrity - 15);
        rejected.add(selectedDeduction);
        const rejectedButton = deductionOptions.querySelector<HTMLButtonElement>(`[data-deduction-id="${selectedDeduction}"]`);
        rejectedButton?.classList.add("is-rejected");
        rejectedButton?.setAttribute("aria-disabled", "true");
        selectedDeduction = "";
        confirmDeduction.disabled = true;
        deductionFeedback.dataset.tone = "error";
        deductionFeedback.textContent = collected.size < 4
          ? "That theory leaves a signal unexplained. Inspect another clue or question AURA."
          : "That theory does not connect the timing and the system logs. Try another cause.";
        updateMetrics();
        deductionOptions.querySelector<HTMLButtonElement>(".sl-option:not(.is-rejected)")?.focus();
        return;
      }

      solved += 1;
      root.dataset.sceneTone = "resolved";
      resolutionTitle.textContent = item.resolutionTitle;
      resolutionText.textContent = item.resolution;
      resolutionClues.textContent = `${collected.size} / 4`;
      resolutionIntegrity.textContent = `${integrity}%`;
      nextCaseButton.textContent = caseIndex === SIGNAL_CASES.length - 1 ? "Restore all signals" : "Open next case";
      transmission.textContent = "Sector restored / signal verified";
      setPhase("resolved");
      updateMetrics();
      window.setTimeout(() => nextCaseButton.focus(), 0);
    }

    function showFinale() {
      root.dataset.sceneTone = "resolved";
      showSceneLayer("finale");
      transmission.textContent = "All sectors nominal / showcase online";
      sceneClock.textContent = "23:55:00";
      finalScore.textContent = `${integrity}%`;
      finaleTitle.textContent = integrity >= 85
        ? "Signal restored. Clean read."
        : integrity >= 70
          ? "Signal restored. Mystery solved."
          : "Signal restored—with a few false leads.";
      setPhase("finale");
      updateMetrics();
      window.setTimeout(() => restartButton.focus(), 0);
    }

    hotspots.forEach((button, index) => button.addEventListener("click", () => inspectEvidence(index)));
    startButton.addEventListener("click", renderCase);
    auraButton.addEventListener("click", () => void askAura());
    openDeduction.addEventListener("click", openDeductionView);
    backButton.addEventListener("click", () => {
      setPhase("investigate");
      openDeduction.focus();
    });
    confirmDeduction.addEventListener("click", confirmChoice);
    nextCaseButton.addEventListener("click", () => {
      if (caseIndex < SIGNAL_CASES.length - 1) {
        caseIndex += 1;
        renderCase();
      } else {
        showFinale();
      }
    });
    restartButton.addEventListener("click", () => {
      caseIndex = 0;
      integrity = 100;
      solved = 0;
      renderCase();
    });

    const abortAura = () => {
      auraController?.abort();
      auraController = null;
    };
    window.addEventListener("surrey-ai-project-modal-close", abortAura);
    document.addEventListener("astro:before-swap", abortAura, { once: true });

    showSceneLayer("0");
    caseBriefing.textContent = SIGNAL_CASES[0].briefing;
    renderHotspots();
    updateMetrics();
  });
</script>
