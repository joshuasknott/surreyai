  .sl-privacy { margin: .55rem 0 0; color: var(--sl-muted); font-size: .59rem; line-height: 1.35; text-align: center; flex: 0 0 auto; }
  .sl-noscript { margin: 1rem; padding: 1rem; border: 1px solid var(--sl-line); border-radius: .75rem; background: var(--sl-surface); color: var(--sl-text); }

  .sl-root[data-scene-tone="resolved"] .sl-live-dot { background: #79c49a; box-shadow: 0 0 0 .24rem rgba(121, 196, 154, .12); }
  .sl-root[data-scene-tone="resolved"] .sl-aura-orb { opacity: 1; }
