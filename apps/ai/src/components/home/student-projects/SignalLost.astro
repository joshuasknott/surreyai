  .sl-primary { min-height: 2.65rem; padding: .75rem 1rem; border: 1px solid var(--sl-blue); border-radius: 999px; background: var(--sl-blue); color: var(--ai-accent-contrast, #fff); cursor: pointer; font: 800 .76rem/1 inherit; transition: transform .18s ease, box-shadow .18s ease; }
  .sl-primary:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 .6rem 1.2rem color-mix(in srgb, var(--sl-blue) 18%, transparent); }
  .sl-primary:disabled { cursor: not-allowed; opacity: .45; }
  .sl-primary:focus-visible { outline: 2px solid var(--sl-blue); outline-offset: 3px; }
  .sl-deduce-start { width: 100%; margin-top: auto; }
  .sl-intro .sl-primary { color: #fff; background: #4d8ca0; border-color: #6fb3c4; }

  .sl-back { width: max-content; margin: 0 0 1rem; padding: .35rem 0; border: 0; background: transparent; color: var(--sl-muted); cursor: pointer; font: 750 .7rem/1 inherit; }
  .sl-back:hover { color: var(--sl-text); }
  .sl-back:focus-visible { outline: 2px solid var(--sl-blue); outline-offset: 2px; }
  .sl-options { display: grid; gap: .55rem; margin: 1rem 0 .75rem; }
  .sl-option { width: 100%; min-height: 3.25rem; padding: .7rem .8rem; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .65rem; border: 1px solid var(--sl-line); border-radius: .68rem; background: var(--sl-bg); color: var(--sl-text); cursor: pointer; font: 750 .74rem/1.35 inherit; text-align: left; }
  .sl-option::before { content: ""; width: .9rem; height: .9rem; border: 1px solid var(--sl-line-strong); border-radius: 50%; }
