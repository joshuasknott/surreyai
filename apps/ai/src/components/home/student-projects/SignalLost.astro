  .sl-aura__topline button:hover { background: var(--sl-blue); color: var(--ai-accent-contrast, #fff); }
  .sl-aura__topline button:disabled { cursor: default; opacity: .52; }
  .sl-aura__topline button:focus-visible { outline: 2px solid var(--sl-blue); outline-offset: 2px; }
  .sl-aura > p { min-height: 2.3em; margin: .62rem 0 0; color: var(--sl-text); font-size: .72rem; line-height: 1.48; }
