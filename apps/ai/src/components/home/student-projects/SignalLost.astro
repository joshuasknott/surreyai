  .sl-view--finale blockquote { margin: .3rem 0 .9rem; padding: .8rem; border-left: 2px solid var(--sl-blue); color: var(--sl-text); background: var(--sl-bg); font-size: .74rem; line-height: 1.5; }
  .sl-view--finale cite { display: block; margin-top: .3rem; color: var(--sl-muted); font-size: .62rem; font-style: normal; }
  .sl-final-score { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; }
