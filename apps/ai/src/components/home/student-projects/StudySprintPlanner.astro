---
---

<section data-study-sprint class="ss-root" aria-label="Student Project: Study Sprint Planner">
  <div class="ss-shell">
    <header class="ss-header">
      <span class="ss-badge">Student productivity tool</span>
      <h2>Study Sprint Planner</h2>
      <p>Create a practical revision schedule from task difficulty, deadline pressure, and available focus time.</p>
    </header>

    <div class="ss-stage">
      <form class="ss-panel ss-form">
        <div class="ss-grid">
          <label><span>Task</span><input id="ss-task" maxlength="70" value="Revise search algorithms" /></label>
          <label><span>Hours</span><input id="ss-hours" type="number" min="1" max="18" value="4" /></label>
          <label><span>Difficulty</span><select id="ss-difficulty"><option>Medium</option><option>High</option><option>Low</option></select></label>
          <label><span>Deadline</span><select id="ss-deadline"><option>Tomorrow</option><option>This week</option><option>Next week</option></select></label>
        </div>
        <div class="ss-actions">
          <button type="button" id="ss-add">Add task</button>
          <button type="button" id="ss-plan">Build plan</button>
        </div>
        <div id="ss-list" class="ss-list" aria-label="Revision tasks"></div>
      </form>

      <aside class="ss-panel ss-output">
        <div class="ss-summary">
          <div><strong id="ss-total">0h</strong><span>Total work</span></div>
          <div><strong id="ss-focus">0</strong><span>Sprints</span></div>
          <div><strong id="ss-balance">0%</strong><span>Balance</span></div>
        </div>
        <div id="ss-timeline" class="ss-timeline" aria-label="Generated sprint plan"></div>
      </aside>
    </div>
  </div>
</section>

<style>
  .ss-root { height: 100%; overflow: hidden; color: var(--ai-fg); }
  .ss-shell { width: min(100%, 78rem); height: 100%; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem; }
  .ss-header { max-width: 54rem; padding-right: 5.5rem; }
  .ss-badge, .ss-form label span, .ss-summary span {
    color: var(--ai-azure);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .ss-header h2 { margin: 0.35rem 0 0; font-size: clamp(2.1rem, 4vw, 3.7rem); line-height: 0.95; font-weight: 850; letter-spacing: -0.04em; }
  .ss-header p { max-width: 44rem; margin: 0.7rem 0 0; color: var(--ai-fg-muted); line-height: 1.5; }
  .ss-stage { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 1rem; }
  .ss-panel { min-height: 0; border: 1px solid var(--ai-border); border-radius: 1rem; background: color-mix(in srgb, var(--ai-surface) 92%, transparent); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16); }
  .ss-form, .ss-output { display: flex; flex-direction: column; gap: 1rem; padding: 1rem; overflow: hidden; }
  .ss-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .ss-form label { display: grid; gap: 0.45rem; }
  .ss-form input, .ss-form select {
    width: 100%;
    min-height: 2.65rem;
    border: 1px solid var(--ai-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--ai-bg) 74%, transparent);
    color: var(--ai-fg);
    padding: 0 0.8rem;
    font: inherit;
  }
  .ss-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .ss-actions button {
    min-height: 2.55rem;
    border: 1px solid var(--ai-border);
    border-radius: 999px;
    background: transparent;
    color: var(--ai-fg);
    padding: 0 1rem;
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }
  #ss-plan, #ss-add { background: var(--ai-azure); border-color: var(--ai-azure); color: white; }
  #ss-add { background: var(--ai-sage); border-color: var(--ai-sage); }
  .ss-list, .ss-timeline { display: grid; gap: 0.55rem; overflow-y: auto; padding-right: 0.25rem; }
  .ss-list { flex: 1; min-height: 0; }
  .ss-item, .ss-block { border: 1px solid var(--ai-border); border-radius: 0.85rem; background: color-mix(in srgb, var(--ai-bg) 64%, transparent); padding: 0.8rem; }
  .ss-item { display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .ss-item strong, .ss-block strong { display: block; }
  .ss-item small, .ss-block small { color: var(--ai-fg-muted); }
  .ss-item button { border: 0; background: transparent; color: var(--ai-coral); font: inherit; font-weight: 850; cursor: pointer; }
  .ss-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.65rem; }
  .ss-summary div { border: 1px solid var(--ai-border); border-radius: 0.85rem; padding: 0.8rem; background: color-mix(in srgb, var(--ai-bg) 64%, transparent); }
  .ss-summary strong { display: block; font-size: 1.55rem; line-height: 1; margin-bottom: 0.35rem; }
  .ss-block { position: relative; padding-left: 1rem; }
  .ss-block::before { content: ""; position: absolute; left: 0; top: 0.85rem; bottom: 0.85rem; width: 0.28rem; border-radius: 999px; background: var(--block-color, var(--ai-azure)); }
  @media (max-width: 760px) {
    .ss-header { padding-right: 3.5rem; }
    .ss-header p { display: none; }
    .ss-stage { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); }
    .ss-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ss-list { max-height: 9rem; }
  }
</style>

<script>
  const studyRoot = document.querySelector('[data-study-sprint]');
  if (studyRoot) {
    let tasks = [
      { name: 'Revise search algorithms', hours: 4, difficulty: 'Medium', deadline: 'Tomorrow' },
      { name: 'Build flashcards for neural networks', hours: 3, difficulty: 'Low', deadline: 'This week' },
      { name: 'Practice exam questions', hours: 5, difficulty: 'High', deadline: 'This week' },
    ];
    const taskEl = studyRoot.querySelector('#ss-task');
    const hoursEl = studyRoot.querySelector('#ss-hours');
    const difficultyEl = studyRoot.querySelector('#ss-difficulty');
    const deadlineEl = studyRoot.querySelector('#ss-deadline');
    const listEl = studyRoot.querySelector('#ss-list');
    const timelineEl = studyRoot.querySelector('#ss-timeline');
    const totalEl = studyRoot.querySelector('#ss-total');
    const focusEl = studyRoot.querySelector('#ss-focus');
    const balanceEl = studyRoot.querySelector('#ss-balance');
    const weight = { High: 1.45, Medium: 1.1, Low: 0.82 };
    const urgency = { Tomorrow: 2, 'This week': 1, 'Next week': 0 };

    function renderTasks() {
      if (!listEl) return;
      listEl.textContent = '';
      tasks.forEach((task, index) => {
        const item = document.createElement('div');
        item.className = 'ss-item';
        item.innerHTML = `<div><strong></strong><small></small></div><button type="button">Remove</button>`;
        item.querySelector('strong').textContent = task.name;
        item.querySelector('small').textContent = `${task.hours}h · ${task.difficulty} · ${task.deadline}`;
        item.querySelector('button').addEventListener('click', () => {
          tasks = tasks.filter((_, candidate) => candidate !== index);
          renderTasks();
          buildPlan();
        });
        listEl.appendChild(item);
      });
    }

    function buildPlan() {
      const ordered = [...tasks].sort((a, b) => (urgency[b.deadline] + weight[b.difficulty]) - (urgency[a.deadline] + weight[a.difficulty]));
      const blocks = [];
      for (const task of ordered) {
        const sprintCount = Math.max(1, Math.ceil((task.hours * weight[task.difficulty]) / 1.5));
        for (let index = 0; index < sprintCount; index++) {
          blocks.push({
            title: task.name,
            label: index === 0 ? 'Learn and map gaps' : index === sprintCount - 1 ? 'Test recall' : 'Focused practice',
            color: task.difficulty === 'High' ? 'var(--ai-coral)' : task.difficulty === 'Medium' ? 'var(--ai-azure)' : 'var(--ai-sage)',
          });
        }
      }

      if (timelineEl) {
        timelineEl.textContent = '';
        blocks.forEach((block, index) => {
          const node = document.createElement('div');
          node.className = 'ss-block';
          node.style.setProperty('--block-color', block.color);
          node.innerHTML = `<strong></strong><small></small>`;
          node.querySelector('strong').textContent = `Sprint ${index + 1}: ${block.title}`;
          node.querySelector('small').textContent = `${block.label} · 45 min focus + 10 min break`;
          timelineEl.appendChild(node);
        });
      }

      const total = tasks.reduce((sum, task) => sum + Number(task.hours || 0), 0);
      const high = tasks.filter((task) => task.difficulty === 'High').length;
      const balance = tasks.length ? Math.max(35, Math.round(100 - (high / tasks.length) * 28 - Math.max(0, blocks.length - 10) * 3)) : 0;
      if (totalEl) totalEl.textContent = `${total}h`;
      if (focusEl) focusEl.textContent = String(blocks.length);
      if (balanceEl) balanceEl.textContent = `${balance}%`;
    }

    studyRoot.querySelector('#ss-add')?.addEventListener('click', () => {
      const name = String(taskEl?.value || '').trim();
      const hours = Math.max(1, Math.min(18, Number(hoursEl?.value || 1)));
      if (!name) return;
      tasks.push({ name, hours, difficulty: difficultyEl?.value || 'Medium', deadline: deadlineEl?.value || 'This week' });
      renderTasks();
      buildPlan();
    });
    studyRoot.querySelector('#ss-plan')?.addEventListener('click', buildPlan);
    renderTasks();
    buildPlan();
  }
</script>
