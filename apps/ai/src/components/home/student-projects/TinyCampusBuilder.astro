---
---

<section data-tiny-campus-builder class="tcb-section" aria-label="Student Project: Tiny Campus Builder">
  <div class="tcb-inner">
    <div class="tcb-header">
      <span class="tcb-badge">Student Project</span>
      <h2 class="tcb-title">Tiny Campus Builder</h2>
      <p class="tcb-subtitle">
        A miniature tile-based campus sandbox. Place paths, buildings, trees, caf&#233;s, and more to create your dream tiny university.
      </p>
    </div>

    <div class="tcb-game" id="tcb-game">
      <div class="tcb-overlay" id="tcb-intro">
        <div class="tcb-overlay-inner">
          <h3 class="tcb-overlay-title">Tiny Campus Builder</h3>
          <p class="tcb-overlay-sub">Build a miniature campus &#8212; place tiles, watch students wander, and chase the perfect vibe score.</p>
          <div class="tcb-tools-preview">
            <div class="tcb-preview-item"><span>&#127807;</span> Grass</div>
            <div class="tcb-preview-item"><span>&#128726;&#65039;</span> Path</div>
            <div class="tcb-preview-item"><span>&#127963;&#65039;</span> Building</div>
            <div class="tcb-preview-item"><span>&#127795;</span> Tree</div>
            <div class="tcb-preview-item"><span>&#9749;</span> Caf&#233;</div>
            <div class="tcb-preview-item"><span>&#128214;</span> Study Pod</div>
            <div class="tcb-preview-item"><span>&#127914;</span> Society</div>
            <div class="tcb-preview-item"><span>&#129529;</span> Eraser</div>
          </div>
          <button id="tcb-start-btn" class="tcb-start-btn" type="button">
            Start Building
          </button>
          <p class="tcb-overlay-hint">Click or drag to paint tiles. Press keys 1&#8211;8 to switch tools.</p>
        </div>
      </div>

      <div class="tcb-builder" id="tcb-builder">
        <div class="tcb-toolbar" role="toolbar" aria-label="Tile placement tools">
          <button class="tcb-tool active" data-tool="grass" type="button" aria-pressed="true" aria-label="Grass tool (key 1)">
            <span class="tcb-tool-icon">&#127807;</span>
            <span class="tcb-tool-label">Grass</span>
            <span class="tcb-tool-key" aria-hidden="true">1</span>
          </button>
          <button class="tcb-tool" data-tool="path" type="button" aria-pressed="false" aria-label="Path tool (key 2)">
            <span class="tcb-tool-icon">&#128726;&#65039;</span>
            <span class="tcb-tool-label">Path</span>
            <span class="tcb-tool-key" aria-hidden="true">2</span>
          </button>
          <button class="tcb-tool" data-tool="building" type="button" aria-pressed="false" aria-label="Building tool (key 3)">
            <span class="tcb-tool-icon">&#127963;&#65039;</span>
            <span class="tcb-tool-label">Building</span>
            <span class="tcb-tool-key" aria-hidden="true">3</span>
          </button>
          <button class="tcb-tool" data-tool="tree" type="button" aria-pressed="false" aria-label="Tree tool (key 4)">
            <span class="tcb-tool-icon">&#127795;</span>
            <span class="tcb-tool-label">Tree</span>
            <span class="tcb-tool-key" aria-hidden="true">4</span>
          </button>
          <button class="tcb-tool" data-tool="cafe" type="button" aria-pressed="false" aria-label="Caf&#233; tool (key 5)">
            <span class="tcb-tool-icon">&#9749;</span>
            <span class="tcb-tool-label">Caf&#233;</span>
            <span class="tcb-tool-key" aria-hidden="true">5</span>
          </button>
          <button class="tcb-tool" data-tool="study" type="button" aria-pressed="false" aria-label="Study Pod tool (key 6)">
            <span class="tcb-tool-icon">&#128214;</span>
            <span class="tcb-tool-label">Study Pod</span>
            <span class="tcb-tool-key" aria-hidden="true">6</span>
          </button>
          <button class="tcb-tool" data-tool="society" type="button" aria-pressed="false" aria-label="Society Booth tool (key 7)">
            <span class="tcb-tool-icon">&#127914;</span>
            <span class="tcb-tool-label">Society</span>
            <span class="tcb-tool-key" aria-hidden="true">7</span>
          </button>
          <button class="tcb-tool" data-tool="eraser" type="button" aria-pressed="false" aria-label="Eraser tool (key 8)">
            <span class="tcb-tool-icon">&#129529;</span>
            <span class="tcb-tool-label">Eraser</span>
            <span class="tcb-tool-key" aria-hidden="true">8</span>
          </button>
        </div>

        <div class="tcb-canvas-wrap">
          <div class="tcb-grid" id="tcb-grid" role="grid" aria-label="Campus building grid"></div>
          <div class="tcb-students-layer" id="tcb-students" aria-hidden="true"></div>
          <div class="tcb-vignette" aria-hidden="true"></div>
        </div>

        <div class="tcb-scores" aria-label="Campus scores">
          <div class="tcb-score-card" data-score-type="green">
            <span class="tcb-score-icon" aria-hidden="true">&#127807;</span>
            <div class="tcb-score-info">
              <span class="tcb-score-label">Green</span>
              <div class="tcb-score-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="tcb-score-fill" id="tcb-score-green"></div></div>
            </div>
            <span class="tcb-score-value" id="tcb-score-val-green">0</span>
          </div>
          <div class="tcb-score-card" data-score-type="study">
            <span class="tcb-score-icon" aria-hidden="true">&#128218;</span>
            <div class="tcb-score-info">
              <span class="tcb-score-label">Study</span>
              <div class="tcb-score-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="tcb-score-fill" id="tcb-score-study"></div></div>
            </div>
            <span class="tcb-score-value" id="tcb-score-val-study">0</span>
          </div>
          <div class="tcb-score-card" data-score-type="social">
            <span class="tcb-score-icon" aria-hidden="true">&#127881;</span>
            <div class="tcb-score-info">
              <span class="tcb-score-label">Social</span>
              <div class="tcb-score-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="tcb-score-fill" id="tcb-score-social"></div></div>
            </div>
            <span class="tcb-score-value" id="tcb-score-val-social">0</span>
          </div>
          <div class="tcb-score-card" data-score-type="vibe">
            <span class="tcb-score-icon" aria-hidden="true">&#10024;</span>
            <div class="tcb-score-info">
              <span class="tcb-score-label">Vibe</span>
              <div class="tcb-score-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><div class="tcb-score-fill" id="tcb-score-vibe"></div></div>
            </div>
            <span class="tcb-score-value" id="tcb-score-val-vibe">0</span>
          </div>
        </div>

        <div class="tcb-actions">
          <button id="tcb-randomise" class="tcb-action-btn" type="button" aria-label="Randomise campus layout">
            &#127922; Randomise
          </button>
          <button id="tcb-clear" class="tcb-action-btn" type="button" aria-label="Clear all tiles">
            &#128465; Clear
          </button>
          <button id="tcb-copy" class="tcb-action-btn" type="button" aria-label="Copy campus summary to clipboard">
            &#128203; Copy Summary
          </button>
        </div>
      </div>

      <noscript>
        <div class="tcb-nojs">
          <p>JavaScript is required to use Tiny Campus Builder.</p>
        </div>
      </noscript>
    </div>

    <p class="tcb-note">
      A creative sandbox built for the Student Projects showcase. Built with HTML, CSS, and vanilla JavaScript.
    </p>
  </div>
</section>

<style>
  .tcb-section {
    border-top: 1px solid var(--ai-border);
    border-bottom: 1px solid var(--ai-border);
    background: var(--ai-slate-base);
    color: #F8FAFC;
    padding: 4.5rem 1.5rem;
  }

  .tcb-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .tcb-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .tcb-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.15);
    color: #6EE7B7;
    border: 1px solid rgba(16, 185, 129, 0.25);
    margin-bottom: 1.25rem;
  }

  .tcb-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    color: #F8FAFC;
  }

  .tcb-subtitle {
    font-size: 1.05rem;
    color: #94A3B8;
    max-width: 34rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  .tcb-game {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      0 0 60px rgba(16, 185, 129, 0.06),
      0 0 120px rgba(79, 70, 229, 0.04),
      0 2px 20px rgba(0, 0, 0, 0.3);
    background: #080c14;
  }

  .tcb-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(8, 12, 20, 0.93);
    backdrop-filter: blur(16px);
    z-index: 10;
  }

  .tcb-overlay[hidden] {
    display: none;
  }

  .tcb-overlay-inner {
    text-align: center;
    padding: 2rem;
    max-height: 100%;
    overflow-y: auto;
  }

  .tcb-overlay-title {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.4rem;
    color: #F8FAFC;
  }

  .tcb-overlay-sub {
    color: #94A3B8;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    max-width: 26rem;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .tcb-tools-preview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    max-width: 26rem;
    margin: 0 auto 1.5rem;
  }

  .tcb-preview-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #94A3B8;
    padding: 0.35rem 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tcb-preview-item span {
    font-size: 1.05rem;
    line-height: 1;
  }

  .tcb-start-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 2.4rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    background: #10B981;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
    box-shadow: 0 8px 28px rgba(16, 185, 129, 0.35);
    font-family: inherit;
    margin-bottom: 1rem;
  }

  .tcb-start-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(16, 185, 129, 0.45);
  }

  .tcb-start-btn:focus-visible {
    outline: 2px solid #6EE7B7;
    outline-offset: 3px;
  }

  .tcb-overlay-hint {
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.5;
  }

  .tcb-builder {
    padding: 1rem;
  }

  .tcb-toolbar {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    justify-content: center;
  }

  .tcb-tool {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.7rem;
    background: rgba(255, 255, 255, 0.04);
    border: 2px solid rgba(255, 255, 255, 0.07);
    border-radius: 0.5rem;
    color: #94A3B8;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.8rem;
    transition: background 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s;
    position: relative;
  }

  .tcb-tool:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #E2E8F0;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .tcb-tool.active {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.5);
    color: #6EE7B7;
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.12);
  }

  .tcb-tool:focus-visible {
    outline: 2px solid #818CF8;
    outline-offset: 2px;
  }

  .tcb-tool-icon {
    font-size: 1.05rem;
    line-height: 1;
  }

  .tcb-tool-label {
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.01em;
  }

  .tcb-tool-key {
    position: absolute;
    top: -7px;
    right: -5px;
    font-size: 0.52rem;
    background: rgba(255, 255, 255, 0.08);
    color: #64748B;
    padding: 0.1rem 0.28rem;
    border-radius: 3px;
    font-weight: 700;
    line-height: 1.2;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tcb-tool.active .tcb-tool-key {
    background: rgba(16, 185, 129, 0.2);
    color: #6EE7B7;
    border-color: rgba(16, 185, 129, 0.3);
  }

  .tcb-canvas-wrap {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #0b0f17;
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.3);
  }

  .tcb-grid {
    display: grid;
    grid-template-columns: repeat(14, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.025);
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  .tcb-tile {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: background-color 0.08s ease;
    border-radius: 2px;
    overflow: hidden;
  }

  .tcb-tile[data-type="empty"] {
    background: rgba(255, 255, 255, 0.015);
  }

  .tcb-tile[data-type="grass"] {
    background:
      radial-gradient(circle at 30% 35%, rgba(120, 220, 120, 0.2) 0.5px, transparent 0.5px),
      radial-gradient(circle at 70% 65%, rgba(120, 220, 120, 0.15) 0.5px, transparent 0.5px),
      radial-gradient(circle at 55% 20%, rgba(120, 220, 120, 0.12) 0.5px, transparent 0.5px),
      #2A6B2E;
    box-shadow: inset 0 0 6px rgba(46, 125, 50, 0.25);
  }

  .tcb-tile[data-type="path"] {
    background:
      repeating-linear-gradient(
        45deg,
        rgba(0, 0, 0, 0.08) 0px,
        rgba(0, 0, 0, 0.08) 1px,
        transparent 1px,
        transparent 4px
      ),
      #8B7B63;
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.2);
  }

  .tcb-tile[data-type="building"] {
    background: #3B4D7A;
    box-shadow: inset 0 0 8px rgba(59, 77, 122, 0.3);
  }

  .tcb-tile[data-type="building"]::after {
    content: '';
    position: absolute;
    top: 18%;
    left: 15%;
    width: 70%;
    height: 45%;
    background:
      radial-gradient(circle, rgba(255, 255, 200, 0.45) 1.2px, transparent 1.2px) 0 0 / 5px 5px;
    pointer-events: none;
    border-radius: 1px;
  }

  .tcb-tile[data-type="tree"] {
    background: #1A5C20;
    box-shadow: inset 0 0 10px rgba(27, 94, 32, 0.35);
  }

  .tcb-tile[data-type="cafe"] {
    background: #7D4E2B;
    box-shadow: inset 0 0 8px rgba(160, 82, 45, 0.35);
  }

  .tcb-tile[data-type="cafe"]::after {
    content: '~';
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 220, 180, 0.4);
    font-size: 0.6rem;
    pointer-events: none;
    animation: tcb-steam 2s ease-out infinite;
  }

  .tcb-tile[data-type="study"] {
    background: #1A4F6E;
    box-shadow: inset 0 0 8px rgba(44, 110, 138, 0.35);
  }

  .tcb-tile[data-type="society"] {
    background: #5E2D82;
    box-shadow: inset 0 0 8px rgba(106, 27, 154, 0.35);
  }

  .tcb-tile[data-type="society"]::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 35%;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 200, 50, 0.15) 0px,
      rgba(255, 200, 50, 0.15) 2px,
      transparent 2px,
      transparent 4px
    );
    pointer-events: none;
    border-radius: 2px 2px 0 0;
  }

  .tcb-tile:hover {
    filter: brightness(1.25);
    z-index: 1;
  }

  .tcb-tile-icon {
    font-size: clamp(0.65rem, 1.8vw, 1.15rem);
    line-height: 1;
    pointer-events: none;
    position: relative;
    z-index: 1;
  }

  .tcb-tile[data-type="tree"] .tcb-tile-icon {
    display: inline-block;
    animation: tcb-sway 3.5s ease-in-out infinite;
  }

  .tcb-tile[data-type="tree"]:nth-child(even) .tcb-tile-icon {
    animation-delay: -1.5s;
    animation-duration: 4s;
  }

  @keyframes tcb-sway {
    0%, 100% { transform: rotate(-2deg) scale(1); }
    50% { transform: rotate(2deg) scale(1.02); }
  }

  @keyframes tcb-steam {
    0% { opacity: 0.5; transform: translateX(-50%) translateY(0) scale(0.8); }
    100% { opacity: 0; transform: translateX(-50%) translateY(-6px) scale(1.2); }
  }

  .tcb-students-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

  .tcb-student {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    will-change: left, top;
  }

  .tcb-student::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: inherit;
    opacity: 0.25;
    filter: blur(2px);
  }

  .tcb-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(8, 12, 20, 0.35) 100%);
    border-radius: 0.75rem;
  }

  .tcb-scores {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tcb-score-card {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 0.5rem;
    padding: 0.5rem 0.55rem;
  }

  .tcb-score-icon {
    font-size: 0.95rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .tcb-score-info {
    flex: 1;
    min-width: 0;
  }

  .tcb-score-label {
    font-size: 0.6rem;
    font-weight: 700;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 0.25rem;
  }

  .tcb-score-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    overflow: hidden;
  }

  .tcb-score-fill {
    height: 100%;
    width: 0%;
    border-radius: 2px;
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcb-score-card[data-score-type="green"] .tcb-score-fill {
    background: linear-gradient(90deg, #059669, #34D399);
  }

  .tcb-score-card[data-score-type="study"] .tcb-score-fill {
    background: linear-gradient(90deg, #4338CA, #818CF8);
  }

  .tcb-score-card[data-score-type="social"] .tcb-score-fill {
    background: linear-gradient(90deg, #DC2626, #F87171);
  }

  .tcb-score-card[data-score-type="vibe"] .tcb-score-fill {
    background: linear-gradient(90deg, #D97706, #FBBF24);
  }

  .tcb-score-value {
    font-size: 0.8rem;
    font-weight: 800;
    color: #F8FAFC;
    min-width: 1.6rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .tcb-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .tcb-action-btn {
    padding: 0.45rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #94A3B8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 9999px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    font-family: inherit;
  }

  .tcb-action-btn:hover {
    color: #F8FAFC;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .tcb-action-btn:focus-visible {
    outline: 2px solid #818CF8;
    outline-offset: 2px;
  }

  .tcb-nojs {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94A3B8;
    font-size: 0.85rem;
    padding: 2rem;
  }

  .tcb-note {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: #475569;
  }

  .tcb-toast {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #059669;
    color: #fff;
    padding: 0.5rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    z-index: 20;
    opacity: 0;
    transition: opacity 0.25s, transform 0.25s;
    pointer-events: none;
    box-shadow: 0 4px 16px rgba(5, 150, 105, 0.35);
  }

  .tcb-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 640px) {
    .tcb-section {
      padding: 2.5rem 0.75rem;
    }

    .tcb-tools-preview {
      grid-template-columns: repeat(2, 1fr);
    }

    .tcb-scores {
      grid-template-columns: repeat(2, 1fr);
    }

    .tcb-toolbar {
      gap: 0.25rem;
    }

    .tcb-tool {
      padding: 0.3rem 0.5rem;
    }

    .tcb-tool-label {
      display: none;
    }

    .tcb-tool-icon {
      font-size: 1.15rem;
    }

    .tcb-builder {
      padding: 0.6rem;
    }

    .tcb-overlay-hint {
      display: none;
    }

    .tcb-score-card {
      padding: 0.4rem 0.45rem;
      gap: 0.3rem;
    }

    .tcb-score-label {
      font-size: 0.55rem;
    }

    .tcb-score-icon {
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tcb-start-btn,
    .tcb-tool,
    .tcb-score-fill,
    .tcb-tile,
    .tcb-action-btn,
    .tcb-toast {
      transition: none;
    }

    .tcb-tile[data-type="tree"] .tcb-tile-icon {
      animation: none;
    }

    .tcb-tile[data-type="cafe"]::after {
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var ROOT = document.querySelector('[data-tiny-campus-builder]');
    if (!ROOT) return;

    var COLS = 14;
    var ROWS = 9;
    var TOTAL = COLS * ROWS;

    var TOOL_ORDER = ['grass', 'path', 'building', 'tree', 'cafe', 'study', 'society', 'eraser'];
    var TILE_EMOJIS = {
      grass: '\u{1F33F}',
      path: '',
      building: '\u{1F3DB}\uFE0F',
      tree: '\u{1F333}',
      cafe: '\u2615',
      study: '\u{1F4D6}',
      society: '\u{1F3AA}'
    };

    var grid = new Array(TOTAL);
    for (var i = 0; i < TOTAL; i++) grid[i] = 'empty';

    var selectedTool = 'grass';
    var isPainting = false;
    var students = [];
    var studentTimer = null;
    var started = false;
    var visible = false;

    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var gridEl = ROOT.querySelector('#tcb-grid');
    var studentsEl = ROOT.querySelector('#tcb-students');
    var introEl = ROOT.querySelector('#tcb-intro');
    var startBtn = ROOT.querySelector('#tcb-start-btn');
    var randomiseBtn = ROOT.querySelector('#tcb-randomise');
    var clearBtn = ROOT.querySelector('#tcb-clear');
    var copyBtn = ROOT.querySelector('#tcb-copy');
    var gameEl = ROOT.querySelector('#tcb-game');
    var toolBtns = ROOT.querySelectorAll('.tcb-tool');

    var scoreFills = {
      green: ROOT.querySelector('#tcb-score-green'),
      study: ROOT.querySelector('#tcb-score-study'),
      social: ROOT.querySelector('#tcb-score-social'),
      vibe: ROOT.querySelector('#tcb-score-vibe')
    };
    var scoreVals = {
      green: ROOT.querySelector('#tcb-score-val-green'),
      study: ROOT.querySelector('#tcb-score-val-study'),
      social: ROOT.querySelector('#tcb-score-val-social'),
      vibe: ROOT.querySelector('#tcb-score-val-vibe')
    };
    var scoreBars = {
      green: ROOT.querySelector('[data-score-type="green"] .tcb-score-bar'),
      study: ROOT.querySelector('[data-score-type="study"] .tcb-score-bar'),
      social: ROOT.querySelector('[data-score-type="social"] .tcb-score-bar'),
      vibe: ROOT.querySelector('[data-score-type="vibe"] .tcb-score-bar')
    };

    var tileEls = [];

    for (var r = 0; r < ROWS; r++) {
      for (var c = 0; c < COLS; c++) {
        var tile = document.createElement('div');
        tile.className = 'tcb-tile';
        tile.dataset.row = r;
        tile.dataset.col = c;
        tile.dataset.type = 'empty';
        gridEl.appendChild(tile);
        tileEls.push(tile);
      }
    }

    function renderTile(idx) {
      var type = grid[idx];
      var el = tileEls[idx];
      el.dataset.type = type;
      var emoji = TILE_EMOJIS[type];
      if (emoji) {
        el.innerHTML = '<span class="tcb-tile-icon">' + emoji + '</span>';
      } else {
        el.innerHTML = '';
      }
    }

    function renderAll() {
      for (var i = 0; i < TOTAL; i++) renderTile(i);
    }

    function paint(row, col) {
      if (row < 0 || row >= ROWS || col < 0 || col >= COLS) return;
      var idx = row * COLS + col;
      var newType = selectedTool === 'eraser' ? 'empty' : selectedTool;
      if (grid[idx] === newType) return;
      grid[idx] = newType;
      renderTile(idx);
      updateScores();
    }

    function getTileFromEvent(e) {
      var target = e.target;
      if (!target) return null;
      var tile = target.closest ? target.closest('.tcb-tile') : null;
      if (!tile && target.classList && target.classList.contains('tcb-tile')) tile = target;
      return tile;
    }

    gridEl.addEventListener('mousedown', function (e) {
      if (!started) return;
      var tile = getTileFromEvent(e);
      if (!tile) return;
      e.preventDefault();
      isPainting = true;
      paint(+tile.dataset.row, +tile.dataset.col);
    });

    gridEl.addEventListener('mouseover', function (e) {
      if (!isPainting || !started) return;
      var tile = getTileFromEvent(e);
      if (!tile) return;
      paint(+tile.dataset.row, +tile.dataset.col);
    });

    document.addEventListener('mouseup', function () {
      isPainting = false;
    });

    gridEl.addEventListener('touchstart', function (e) {
      if (!started) return;
      e.preventDefault();
      isPainting = true;
      var touch = e.touches[0];
      var el = document.elementFromPoint(touch.clientX, touch.clientY);
      var tile = el ? (el.closest ? el.closest('.tcb-tile') : null) : null;
      if (tile) paint(+tile.dataset.row, +tile.dataset.col);
    }, { passive: false });

    gridEl.addEventListener('touchmove', function (e) {
      if (!isPainting || !started) return;
      e.preventDefault();
      var touch = e.touches[0];
      var el = document.elementFromPoint(touch.clientX, touch.clientY);
      var tile = el ? (el.closest ? el.closest('.tcb-tile') : null) : null;
      if (tile) paint(+tile.dataset.row, +tile.dataset.col);
    }, { passive: false });

    gridEl.addEventListener('touchend', function () {
      isPainting = false;
    });

    function selectTool(tool) {
      selectedTool = tool;
      for (var i = 0; i < toolBtns.length; i++) {
        var btn = toolBtns[i];
        var isActive = btn.dataset.tool === tool;
        if (isActive) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }
    }

    for (var ti = 0; ti < toolBtns.length; ti++) {
      toolBtns[ti].addEventListener('click', function () {
        selectTool(this.dataset.tool);
      });
    }

    ROOT.addEventListener('keydown', function (e) {
      if (!started) return;
      var num = parseInt(e.key);
      if (num >= 1 && num <= 8) {
        e.preventDefault();
        selectTool(TOOL_ORDER[num - 1]);
      }
    });

    function calculateScores() {
      var counts = { grass: 0, path: 0, building: 0, tree: 0, cafe: 0, study: 0, society: 0, eraser: 0, empty: 0 };
      for (var i = 0; i < TOTAL; i++) {
        var t = grid[i];
        if (counts[t] !== undefined) counts[t]++;
      }

      var placed = TOTAL - counts.empty;
      if (placed === 0) return { green: 0, study: 0, social: 0, vibe: 0 };

      var greenRaw = (counts.tree + counts.grass) / placed;
      var green = Math.min(100, Math.round(greenRaw * 130));

      var studyRaw = (counts.building + counts.study) / placed;
      var study = Math.min(100, Math.round(studyRaw * 180));

      var socialRaw = (counts.cafe + counts.society) / placed;
      var social = Math.min(100, Math.round(socialRaw * 220));

      var typesUsed = 0;
      var placeableTypes = ['grass', 'path', 'building', 'tree', 'cafe', 'study', 'society'];
      for (var j = 0; j < placeableTypes.length; j++) {
        if (counts[placeableTypes[j]] > 0) typesUsed++;
      }
      var variety = typesUsed / 7;
      var fillRatio = placed / TOTAL;
      var balance = 1 - Math.abs(0.55 - fillRatio);
      if (balance < 0) balance = 0;
      var pathBonus = Math.min(1, counts.path / (placed * 0.14 + 1));
      var vibe = Math.min(100, Math.round(variety * 45 + balance * 25 + pathBonus * 30));

      return { green: green, study: study, social: social, vibe: vibe };
    }

    function updateScores() {
      var scores = calculateScores();
      var keys = ['green', 'study', 'social', 'vibe'];
      for (var i = 0; i < keys.length; i++) {
        var k = keys[i];
        scoreFills[k].style.width = scores[k] + '%';
        scoreVals[k].textContent = scores[k];
        if (scoreBars[k]) scoreBars[k].setAttribute('aria-valuenow', scores[k]);
      }
      manageStudents();
    }

    function getPathTiles() {
      var paths = [];
      for (var r = 0; r < ROWS; r++) {
        for (var c = 0; c < COLS; c++) {
          if (grid[r * COLS + c] === 'path') paths.push([r, c]);
        }
      }
      return paths;
    }

    function getAdjacentPaths(row, col) {
      var adj = [];
      var dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]];
      for (var i = 0; i < dirs.length; i++) {
        var nr = row + dirs[i][0];
        var nc = col + dirs[i][1];
        if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS && grid[nr * COLS + nc] === 'path') {
          adj.push([nr, nc]);
        }
      }
      return adj;
    }

    var STUDENT_COLORS = ['#FBBF24', '#F87171', '#60A5FA', '#34D399', '#FB923C', '#C084FC'];

    function spawnStudent() {
      var paths = getPathTiles();
      if (paths.length === 0) return null;
      var pos = paths[Math.floor(Math.random() * paths.length)];
      var idx = students.length;
      var el = document.createElement('div');
      el.className = 'tcb-student';
      el.style.backgroundColor = STUDENT_COLORS[idx % STUDENT_COLORS.length];
      el.style.boxShadow = '0 0 5px ' + STUDENT_COLORS[idx % STUDENT_COLORS.length];

      var s = {
        el: el,
        row: pos[0],
        col: pos[1],
        targetRow: pos[0],
        targetCol: pos[1],
        progress: 1,
        speed: 0.012 + Math.random() * 0.014
      };

      positionStudent(s);
      studentsEl.appendChild(el);
      return s;
    }

    function removeStudents() {
      for (var i = 0; i < students.length; i++) {
        students[i].el.remove();
      }
      students = [];
    }

    function positionStudent(s) {
      var x = (s.col + (s.targetCol - s.col) * s.progress + 0.5) / COLS * 100;
      var y = (s.row + (s.targetRow - s.row) * s.progress + 0.5) / ROWS * 100;
      s.el.style.left = x + '%';
      s.el.style.top = y + '%';
    }

    function manageStudents() {
      if (reducedMotion) {
        removeStudents();
        return;
      }

      var paths = getPathTiles();
      var targetCount = Math.min(6, Math.max(0, Math.floor(paths.length / 3)));

      while (students.length > targetCount) {
        students.pop().el.remove();
      }

      while (students.length < targetCount) {
        var s = spawnStudent();
        if (s) students.push(s);
        else break;
      }

      for (var i = 0; i < students.length; i++) {
        var st = students[i];
        var curType = grid[st.row * COLS + st.col];
        var tgtType = grid[st.targetRow * COLS + st.targetCol];
        if (curType !== 'path' && tgtType !== 'path') {
          if (paths.length > 0) {
            var p = paths[Math.floor(Math.random() * paths.length)];
            st.row = p[0];
            st.col = p[1];
            st.targetRow = p[0];
            st.targetCol = p[1];
            st.progress = 1;
          }
        }
      }
    }

    function animateStudents() {
      for (var i = 0; i < students.length; i++) {
        var s = students[i];
        if (s.progress >= 1) {
          s.row = s.targetRow;
          s.col = s.targetCol;
          var adj = getAdjacentPaths(s.row, s.col);
          if (adj.length > 0) {
            var next = adj[Math.floor(Math.random() * adj.length)];
            s.targetRow = next[0];
            s.targetCol = next[1];
          } else {
            var paths = getPathTiles();
            if (paths.length > 0) {
              var p = paths[Math.floor(Math.random() * paths.length)];
              s.targetRow = p[0];
              s.targetCol = p[1];
              s.row = p[0];
              s.col = p[1];
            }
          }
          s.progress = 0;
        }
        s.progress = Math.min(1, s.progress + s.speed);
        positionStudent(s);
      }
    }

    function startAnimation() {
      if (studentTimer) return;
      studentTimer = setInterval(animateStudents, 45);
    }

    function stopAnimation() {
      if (studentTimer) {
        clearInterval(studentTimer);
        studentTimer = null;
      }
    }

    function randomise() {
      var types = ['grass', 'path', 'building', 'tree', 'cafe', 'study', 'society'];
      var weights = [28, 16, 10, 20, 7, 7, 5];
      var totalW = 0;
      for (var w = 0; w < weights.length; w++) totalW += weights[w];

      for (var i = 0; i < TOTAL; i++) {
        var rr = Math.random() * totalW;
        var chosen = types[0];
        for (var j = 0; j < types.length; j++) {
          rr -= weights[j];
          if (rr <= 0) { chosen = types[j]; break; }
        }
        grid[i] = chosen;
      }

      var pathCount = 0;
      for (var k = 0; k < TOTAL; k++) {
        if (grid[k] === 'path') pathCount++;
      }
      while (pathCount < 10) {
        var idx = Math.floor(Math.random() * TOTAL);
        if (grid[idx] !== 'path') {
          grid[idx] = 'path';
          pathCount++;
        }
      }

      renderAll();
      updateScores();
    }

    function clearGrid() {
      for (var i = 0; i < TOTAL; i++) grid[i] = 'empty';
      renderAll();
      updateScores();
    }

    function copySummary() {
      var counts = {};
      var allTypes = ['grass', 'path', 'building', 'tree', 'cafe', 'study', 'society', 'eraser', 'empty'];
      for (var i = 0; i < allTypes.length; i++) counts[allTypes[i]] = 0;
      for (var j = 0; j < TOTAL; j++) {
        if (counts[grid[j]] !== undefined) counts[grid[j]]++;
      }

      var scores = calculateScores();

      var lines = [];
      lines.push('\u{1F3EB} My Tiny Campus (' + COLS + '\u00D7' + ROWS + ')');
      lines.push('');
      lines.push('\u{1F33F} Grass: ' + counts.grass);
      lines.push('\u{1F6E4}\uFE0F Paths: ' + counts.path);
      lines.push('\u{1F3DB}\uFE0F Buildings: ' + counts.building);
      lines.push('\u{1F333} Trees: ' + counts.tree);
      lines.push('\u2615 Caf\u00E9s: ' + counts.cafe);
      lines.push('\u{1F4D6} Study Pods: ' + counts.study);
      lines.push('\u{1F3AA} Society Booths: ' + counts.society);
      lines.push('');
      lines.push('Scores:');
      lines.push('  \u{1F33F} Green: ' + scores.green + '  \u{1F4DA} Study: ' + scores.study);
      lines.push('  \u{1F389} Social: ' + scores.social + '  \u2728 Vibe: ' + scores.vibe);
      lines.push('');
      lines.push('Built with Tiny Campus Builder \u2013 Surrey AI Society');

      var text = lines.join('\n');

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          showToast('Summary copied!');
        }).catch(function () {
          showToast('Could not copy');
        });
      } else {
        showToast('Clipboard not available');
      }
    }

    function showToast(msg) {
      var toast = ROOT.querySelector('.tcb-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.className = 'tcb-toast';
        gameEl.appendChild(toast);
      }
      toast.textContent = msg;
      toast.classList.remove('show');
      void toast.offsetWidth;
      toast.classList.add('show');
      setTimeout(function () {
        toast.classList.remove('show');
      }, 1800);
    }

    startBtn.addEventListener('click', function () {
      started = true;
      introEl.setAttribute('hidden', '');
      if (!reducedMotion && visible) startAnimation();
      randomise();
    });

    randomiseBtn.addEventListener('click', randomise);
    clearBtn.addEventListener('click', clearGrid);
    copyBtn.addEventListener('click', copySummary);

    var obs = new IntersectionObserver(function (entries) {
      var entry = entries[0];
      visible = entry.isIntersecting;
      if (visible && started && !reducedMotion) {
        startAnimation();
      } else {
        stopAnimation();
      }
    }, { threshold: 0 });
    obs.observe(gameEl);

    updateScores();
  })();
</script>
