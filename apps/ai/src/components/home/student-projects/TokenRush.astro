---
---
<section data-token-rush aria-label="Student Project: Token Rush">
  <div class="tr-inner">
    <div class="tr-header">
      <span class="tr-badge">Student Project</span>
      <h2 class="tr-title">Token Rush</h2>
      <p class="tr-subtitle">
        Type fast, dodge bugs, collect powerups. How high can you score?
      </p>
    </div>

    <div class="tr-game" id="tr-game">
      <div class="tr-arena" id="tr-arena">
        <div class="tr-arena-bg"></div>
        <div class="tr-arena-pulse" id="tr-pulse"></div>
      </div>

      <div class="tr-hud" id="tr-hud" hidden>
        <div class="tr-hud-left">
          <div class="tr-score" id="tr-score">0</div>
          <div class="tr-combo" id="tr-combo" hidden>x1</div>
        </div>
        <div class="tr-hud-center">
          <div class="tr-timer" id="tr-timer">60</div>
        </div>
        <div class="tr-hud-right">
          <div class="tr-streak-label">Streak</div>
          <div class="tr-streak-bar">
            <div class="tr-streak-fill" id="tr-streak-fill"></div>
          </div>
          <div class="tr-streak-count" id="tr-streak-count">0</div>
        </div>
      </div>

      <div class="tr-input-area" id="tr-input-area" hidden>
        <label for="tr-type-input" class="tr-input-label">Type the word:</label>
        <input
          type="text"
          id="tr-type-input"
          class="tr-type-input"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="type here..."
        />
      </div>

      <div class="tr-mobile-tap" id="tr-mobile-tap" hidden>
        <span class="tr-tap-hint">Tap matching word</span>
      </div>

      <div class="tr-overlay tr-start-overlay" id="tr-start">
        <div class="tr-overlay-inner">
          <div class="tr-overlay-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
          </div>
          <h3 class="tr-game-title">Token Rush</h3>
          <p class="tr-game-desc">Type the highlighted words before they vanish. Dodge bugs. Grab powerups.</p>

          <div class="tr-legend">
            <div class="tr-legend-row">
              <span class="tr-legend-swatch tr-sw-good"></span>
              <span class="tr-legend-text">Good tokens &mdash; type to score</span>
            </div>
            <div class="tr-legend-row">
              <span class="tr-legend-swatch tr-sw-bug"></span>
              <span class="tr-legend-text">Bug tokens &mdash; skip or tap to dismiss</span>
            </div>
            <div class="tr-legend-row">
              <span class="tr-legend-swatch tr-sw-power"></span>
              <span class="tr-legend-text">Powerups &mdash; type or tap to activate</span>
            </div>
          </div>

          <div class="tr-controls-info">
            <div class="tr-key-row"><kbd>A-Z</kbd> Type words&emsp;<kbd>Esc</kbd> Quit</div>
            <div class="tr-key-row">Mobile: tap tokens to interact</div>
          </div>

          <button id="tr-play-btn" class="tr-play-btn" type="button">
            Play
          </button>
          <div class="tr-best-start" id="tr-best-start"></div>
        </div>
      </div>

      <div class="tr-overlay tr-over-overlay" id="tr-over" hidden>
        <div class="tr-overlay-inner">
          <h3 class="tr-over-title">Time's Up!</h3>
          <div class="tr-final-score" id="tr-final-score">0</div>
          <div class="tr-final-stats" id="tr-final-stats"></div>
          <div class="tr-new-best" id="tr-new-best" hidden>New best!</div>
          <button id="tr-again-btn" class="tr-play-btn" type="button">
            Play Again
          </button>
          <p class="tr-over-hint">Press Space or click to play again</p>
        </div>
      </div>

      <noscript>
        <div class="tr-nojs">
          <p>JavaScript is required to play Token Rush.</p>
        </div>
      </noscript>
    </div>

    <p class="tr-note">
      A fast arcade typing game built for the Student Projects showcase. Vanilla JS, no external dependencies.
    </p>
  </div>
</section>

<style>
  [data-token-rush] {
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: #0F172A;
    color: #F8FAFC;
    padding: 4.5rem 1.5rem;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .tr-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .tr-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .tr-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.15);
    color: #34D399;
    border: 1px solid rgba(16, 185, 129, 0.25);
    margin-bottom: 1.25rem;
  }

  .tr-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    color: #F8FAFC;
  }

  .tr-subtitle {
    font-size: 1.05rem;
    color: #94A3B8;
    max-width: 34rem;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Game Container ── */

  .tr-game {
    position: relative;
    width: 100%;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      0 0 60px rgba(16, 185, 129, 0.06),
      0 0 120px rgba(79, 70, 229, 0.04),
      0 2px 20px rgba(0, 0, 0, 0.3);
    background: #060a12;
    min-height: 480px;
    display: flex;
    flex-direction: column;
  }

  /* ── Arena ── */

  .tr-arena {
    position: relative;
    flex: 1;
    min-height: 320px;
    overflow: hidden;
  }

  .tr-arena-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 20% 80%, rgba(16, 185, 129, 0.03), transparent),
      radial-gradient(ellipse 50% 60% at 80% 20%, rgba(79, 70, 229, 0.03), transparent),
      #060a12;
  }

  .tr-arena-pulse {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .tr-arena-pulse.tr-pulse-green {
    background: radial-gradient(circle at center, rgba(16, 185, 129, 0.15), transparent 70%);
    opacity: 1;
  }

  .tr-arena-pulse.tr-pulse-red {
    background: radial-gradient(circle at center, rgba(255, 107, 107, 0.15), transparent 70%);
    opacity: 1;
  }

  .tr-arena-pulse.tr-pulse-gold {
    background: radial-gradient(circle at center, rgba(251, 191, 36, 0.15), transparent 70%);
    opacity: 1;
  }

  /* ── Tokens ── */

  .tr-token {
    position: absolute;
    padding: 0.45rem 1rem;
    border-radius: 0.6rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    white-space: nowrap;
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s ease;
    border: 1.5px solid transparent;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    z-index: 2;
  }

  .tr-token.tr-active {
    z-index: 3;
  }

  .tr-token-good {
    background: rgba(16, 185, 129, 0.15);
    color: #34D399;
    border-color: rgba(16, 185, 129, 0.3);
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.1);
  }

  .tr-token-good.tr-active {
    border-color: #10B981;
    box-shadow: 0 0 30px rgba(16, 185, 129, 0.25), 0 0 60px rgba(16, 185, 129, 0.1);
    transform: scale(1.08);
    animation: tr-glow-good 1.5s ease-in-out infinite;
  }

  @keyframes tr-glow-good {
    0%, 100% { box-shadow: 0 0 30px rgba(16, 185, 129, 0.25), 0 0 60px rgba(16, 185, 129, 0.1); }
    50% { box-shadow: 0 0 40px rgba(16, 185, 129, 0.35), 0 0 80px rgba(16, 185, 129, 0.15); }
  }

  .tr-token-good .tr-token-match {
    color: #fff;
    text-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
  }

  .tr-token-bug {
    background: rgba(255, 107, 107, 0.15);
    color: #FCA5A5;
    border-color: rgba(255, 107, 107, 0.3);
    box-shadow: 0 0 20px rgba(255, 107, 107, 0.1);
  }

  .tr-token-bug::after {
    content: ' \2620';
    font-size: 0.8em;
  }

  .tr-token-bug.tr-active {
    border-color: #FF6B6B;
    box-shadow: 0 0 30px rgba(255, 107, 107, 0.25), 0 0 60px rgba(255, 107, 107, 0.1);
    transform: scale(1.08);
    animation: tr-glow-bug 1s ease-in-out infinite;
  }

  @keyframes tr-glow-bug {
    0%, 100% { box-shadow: 0 0 30px rgba(255, 107, 107, 0.25), 0 0 60px rgba(255, 107, 107, 0.1); }
    50% { box-shadow: 0 0 40px rgba(255, 107, 107, 0.35), 0 0 80px rgba(255, 107, 107, 0.15); }
  }

  .tr-token-power {
    background: rgba(251, 191, 36, 0.15);
    color: #FCD34D;
    border-color: rgba(251, 191, 36, 0.35);
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.15);
    animation: tr-shimmer 2s ease-in-out infinite;
  }

  @keyframes tr-shimmer {
    0%, 100% { box-shadow: 0 0 20px rgba(251, 191, 36, 0.15); }
    50% { box-shadow: 0 0 35px rgba(251, 191, 36, 0.3); }
  }

  .tr-token-power.tr-active {
    border-color: #FBBF24;
    box-shadow: 0 0 40px rgba(251, 191, 36, 0.3), 0 0 80px rgba(251, 191, 36, 0.1);
    transform: scale(1.12);
  }

  .tr-token-power::before {
    content: '\2728 ';
  }

  .tr-token-clearing {
    animation: tr-pop 0.3s ease-out forwards;
    pointer-events: none;
  }

  @keyframes tr-pop {
    0% { transform: scale(1.08); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
    100% { transform: scale(0.5); opacity: 0; }
  }

  .tr-token-expiring {
    animation: tr-shake 0.4s ease-in-out;
  }

  @keyframes tr-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-3px); }
    75% { transform: translateX(3px); }
  }

  .tr-token-faded {
    opacity: 0.35;
    transition: opacity 0.3s;
  }

  /* ── Score popup ── */

  .tr-score-pop {
    position: absolute;
    font-weight: 800;
    font-size: 1.2rem;
    pointer-events: none;
    z-index: 10;
    animation: tr-pop-up 0.8s ease-out forwards;
  }

  @keyframes tr-pop-up {
    0% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; transform: translateY(-40px) scale(0.8); }
  }

  .tr-combo-flash {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 2.5rem;
    font-weight: 900;
    pointer-events: none;
    z-index: 12;
    animation: tr-combo-pop 0.7s ease-out forwards;
    text-shadow: 0 0 30px rgba(79, 70, 229, 0.5);
  }

  @keyframes tr-combo-pop {
    0% { opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
    30% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
  }

  /* ── HUD ── */

  .tr-hud {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.75rem 1.25rem;
    background: rgba(6, 10, 18, 0.85);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    z-index: 5;
    position: relative;
  }

  .tr-hud[hidden] { display: none; }

  .tr-hud-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tr-score {
    font-size: 1.5rem;
    font-weight: 800;
    color: #F8FAFC;
    font-family: 'Fira Code', ui-monospace, monospace;
    min-width: 4rem;
  }

  .tr-combo {
    font-size: 0.9rem;
    font-weight: 700;
    color: #818CF8;
    padding: 0.2rem 0.6rem;
    background: rgba(79, 70, 229, 0.15);
    border-radius: 9999px;
    border: 1px solid rgba(79, 70, 229, 0.3);
  }

  .tr-combo[hidden] { display: none; }

  .tr-hud-center {
    display: flex;
    align-items: center;
  }

  .tr-timer {
    font-size: 1.6rem;
    font-weight: 800;
    color: #F8FAFC;
    font-family: 'Fira Code', ui-monospace, monospace;
    min-width: 3rem;
    text-align: center;
  }

  .tr-timer.tr-timer-low {
    color: #FF6B6B;
    animation: tr-timer-pulse 0.5s ease-in-out infinite;
  }

  @keyframes tr-timer-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .tr-hud-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tr-streak-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748B;
  }

  .tr-streak-bar {
    width: 80px;
    height: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 3px;
    overflow: hidden;
  }

  .tr-streak-fill {
    height: 100%;
    width: 0%;
    border-radius: 3px;
    background: linear-gradient(90deg, #10B981, #34D399);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tr-streak-fill.tr-streak-hot {
    background: linear-gradient(90deg, #FBBF24, #F59E0B);
    box-shadow: 0 0 8px rgba(251, 191, 36, 0.4);
  }

  .tr-streak-fill.tr-streak-fire {
    background: linear-gradient(90deg, #FF6B6B, #F59E0B);
    box-shadow: 0 0 12px rgba(255, 107, 107, 0.5);
  }

  .tr-streak-count {
    font-size: 0.85rem;
    font-weight: 700;
    color: #94A3B8;
    font-family: 'Fira Code', ui-monospace, monospace;
    min-width: 1.5rem;
    text-align: right;
  }

  /* ── Input ── */

  .tr-input-area {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.25rem;
    background: rgba(6, 10, 18, 0.9);
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .tr-input-area[hidden] { display: none; }

  .tr-input-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .tr-type-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.5rem;
    padding: 0.55rem 1rem;
    color: #F8FAFC;
    font-size: 1.05rem;
    font-weight: 600;
    font-family: 'Fira Code', ui-monospace, monospace;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .tr-type-input:focus {
    border-color: rgba(16, 185, 129, 0.5);
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.1);
  }

  .tr-type-input::placeholder {
    color: #475569;
    font-weight: 400;
  }

  /* ── Mobile tap ── */

  .tr-mobile-tap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: rgba(6, 10, 18, 0.9);
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .tr-mobile-tap[hidden] { display: none; }

  .tr-tap-hint {
    font-size: 0.75rem;
    color: #64748B;
  }

  /* ── Overlays ── */

  .tr-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 10, 18, 0.92);
    backdrop-filter: blur(14px);
    z-index: 20;
  }

  .tr-overlay[hidden] { display: none; }

  .tr-overlay-inner {
    text-align: center;
    padding: 2rem;
    max-height: 100%;
    overflow-y: auto;
    max-width: 26rem;
  }

  .tr-overlay-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 1.25rem;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: #34D399;
    margin-bottom: 1.5rem;
  }

  .tr-game-title {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    color: #F8FAFC;
  }

  .tr-game-desc {
    color: #94A3B8;
    font-size: 0.95rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .tr-legend {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .tr-legend-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tr-legend-swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    flex-shrink: 0;
    border: 1.5px solid transparent;
  }

  .tr-sw-good {
    background: rgba(16, 185, 129, 0.3);
    border-color: #10B981;
  }

  .tr-sw-bug {
    background: rgba(255, 107, 107, 0.3);
    border-color: #FF6B6B;
  }

  .tr-sw-power {
    background: rgba(251, 191, 36, 0.3);
    border-color: #FBBF24;
  }

  .tr-legend-text {
    font-size: 0.8rem;
    color: #94A3B8;
    line-height: 1.4;
  }

  .tr-controls-info {
    margin-bottom: 1.8rem;
    color: #475569;
    font-size: 0.75rem;
    line-height: 2.2;
  }

  .tr-key-row {
    white-space: nowrap;
  }

  .tr-controls-info kbd {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.75rem;
    color: #CBD5E1;
    margin: 0 0.1rem;
  }

  .tr-play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 2.4rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    background: #10B981;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
    box-shadow: 0 8px 28px rgba(16, 185, 129, 0.35);
    font-family: inherit;
  }

  .tr-play-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(16, 185, 129, 0.45);
  }

  .tr-play-btn:focus-visible {
    outline: 2px solid #34D399;
    outline-offset: 3px;
  }

  .tr-best-start {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: #64748B;
    min-height: 1.2em;
  }

  /* ── Game Over ── */

  .tr-over-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: #FF6B6B;
  }

  .tr-final-score {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: #F8FAFC;
    font-family: 'Fira Code', ui-monospace, monospace;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .tr-final-stats {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: #94A3B8;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .tr-final-stats span {
    color: #CBD5E1;
    font-weight: 600;
  }

  .tr-new-best {
    display: inline-block;
    padding: 0.3rem 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #FBBF24;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 9999px;
    margin-bottom: 1rem;
    animation: tr-best-glow 1.5s ease-in-out infinite;
  }

  .tr-new-best[hidden] { display: none; }

  @keyframes tr-best-glow {
    0%, 100% { box-shadow: 0 0 12px rgba(251, 191, 36, 0.2); }
    50% { box-shadow: 0 0 24px rgba(251, 191, 36, 0.4); }
  }

  .tr-over-hint {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: #475569;
  }

  .tr-nojs {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94A3B8;
    font-size: 0.85rem;
  }

  .tr-note {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    color: #475569;
  }

  /* ── Powerup indicator ── */

  .tr-powerup-indicator {
    position: absolute;
    top: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    z-index: 6;
    animation: tr-pu-fade 3s ease-out forwards;
  }

  @keyframes tr-pu-fade {
    0% { opacity: 1; }
    70% { opacity: 1; }
    100% { opacity: 0; }
  }

  .tr-pu-coffee {
    background: rgba(251, 191, 36, 0.2);
    color: #FCD34D;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  .tr-pu-focus {
    background: rgba(79, 70, 229, 0.2);
    color: #A5B4FC;
    border: 1px solid rgba(79, 70, 229, 0.3);
  }

  .tr-pu-streak {
    background: rgba(16, 185, 129, 0.2);
    color: #34D399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  /* ── Responsive ── */

  @media (max-width: 640px) {
    [data-token-rush] {
      padding: 2.5rem 0.75rem;
    }

    .tr-arena {
      min-height: 260px;
    }

    .tr-game {
      min-height: 400px;
    }

    .tr-legend {
      display: none;
    }

    .tr-controls-info {
      display: none;
    }

    .tr-score {
      font-size: 1.2rem;
    }

    .tr-timer {
      font-size: 1.3rem;
    }

    .tr-streak-bar {
      width: 50px;
    }

    .tr-token {
      font-size: 0.9rem;
      padding: 0.35rem 0.75rem;
    }

    .tr-type-input {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tr-token-good.tr-active,
    .tr-token-bug.tr-active,
    .tr-token-power.tr-active,
    .tr-token-power {
      animation: none;
    }

    .tr-token-clearing {
      animation: none;
      opacity: 0;
    }

    .tr-score-pop,
    .tr-combo-flash {
      animation: none;
      display: none;
    }

    .tr-play-btn {
      transition: none;
    }

    .tr-streak-fill {
      transition: none;
    }

    .tr-timer.tr-timer-low {
      animation: none;
    }

    .tr-arena-pulse {
      transition: none;
    }
  }
</style>

<script>
(function() {
  const GOOD_WORDS = ['prompt','build','ship','debug','deploy','sprint','idea','focus','model','launch','train','learn','code','data','parse','train','query','agent','batch','stack','cache','layer','fetch','valid','merge'];
  const BUG_WORDS = ['error','crash','loop','delay','scope','merge','panic','fatal','stack','null','segfault','deadlock','overflow','timeout','syntax'];
  const POWER_WORDS = ['coffee','focus','streak'];
  const GAME_DURATION = 60;
  const TOKEN_LIFETIME = 5.5;
  const MAX_TOKENS = 8;
  const TOKEN_SPAWN_INTERVAL = 1.4;
  const STREAK_MILESTONES = [5, 10, 20, 35, 50];

  const ST = { MENU: 0, PLAY: 1, OVER: 2 };

  const gameEl = document.getElementById('tr-game');
  const arenaEl = document.getElementById('tr-arena');
  const pulseEl = document.getElementById('tr-pulse');
  const hudEl = document.getElementById('tr-hud');
  const inputArea = document.getElementById('tr-input-area');
  const inputEl = document.getElementById('tr-type-input');
  const mobileTapEl = document.getElementById('tr-mobile-tap');
  const scoreEl = document.getElementById('tr-score');
  const comboEl = document.getElementById('tr-combo');
  const timerEl = document.getElementById('tr-timer');
  const streakFill = document.getElementById('tr-streak-fill');
  const streakCount = document.getElementById('tr-streak-count');
  const startEl = document.getElementById('tr-start');
  const overEl = document.getElementById('tr-over');
  const playBtn = document.getElementById('tr-play-btn');
  const againBtn = document.getElementById('tr-again-btn');
  const finalScoreEl = document.getElementById('tr-final-score');
  const finalStatsEl = document.getElementById('tr-final-stats');
  const newBestEl = document.getElementById('tr-new-best');
  const bestStartEl = document.getElementById('tr-best-start');

  if (!gameEl || !arenaEl || !inputEl) return;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);

  let state = ST.MENU;
  let score = 0;
  let combo = 1;
  let streak = 0;
  let maxCombo = 1;
  let maxStreak = 0;
  let wordsTyped = 0;
  let bugsAvoided = 0;
  let bugsHit = 0;
  let powerupsCollected = 0;
  let timeLeft = GAME_DURATION;
  let timeScale = 1;
  let timeScaleTimer = 0;
  let multiplierBonus = 0;
  let multiplierBonusTimer = 0;
  let spawnTimer = 0;
  let lastTs = 0;
  let visible = false;
  let bestScore = 0;
  let activeTokens = [];
  let tokenEls = [];
  let activeIndex = 0;
  let lastTokenId = 0;

  try {
    const saved = localStorage.getItem('token-rush-best');
    if (saved && !isNaN(parseInt(saved))) bestScore = parseInt(saved);
  } catch {}

  if (bestScore > 0 && bestStartEl) {
    bestStartEl.textContent = 'Best: ' + bestScore;
  }

  function pickRandom(arr) {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  function spawnToken() {
    if (activeTokens.length >= MAX_TOKENS) return;

    const arenaRect = arenaEl.getBoundingClientRect();
    if (arenaRect.width === 0 || arenaRect.height === 0) return;

    const rand = Math.random();
    let word, type;
    if (rand < 0.12) {
      word = pickRandom(POWER_WORDS);
      type = 'power';
    } else if (rand < 0.35) {
      word = pickRandom(BUG_WORDS);
      type = 'bug';
    } else {
      word = pickRandom(GOOD_WORDS);
      type = 'good';
    }

    for (const t of activeTokens) {
      if (t.word === word) return;
    }

    const padding = 60;
    const x = padding + Math.random() * (arenaRect.width - padding * 2 - 80);
    const y = padding + Math.random() * (arenaRect.height - padding * 2 - 40);

    const id = ++lastTokenId;
    const token = {
      id,
      word,
      type,
      x,
      y,
      age: 0,
      lifetime: TOKEN_LIFETIME + (type === 'power' ? 1.5 : 0),
      el: null
    };

    const el = document.createElement('div');
    el.className = 'tr-token tr-token-' + type;
    el.textContent = word;
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    el.dataset.tokenId = id;
    el.setAttribute('role', 'button');
    el.setAttribute('aria-label', (type === 'bug' ? 'Bug: ' : type === 'power' ? 'Powerup: ' : '') + word);

    el.addEventListener('click', function() {
      handleTokenTap(token);
    });

    arenaEl.appendChild(el);
    token.el = el;
    activeTokens.push(token);
    tokenEls.push(el);

    updateActiveHighlight();
  }

  function updateActiveHighlight() {
    activeTokens.forEach(function(t, i) {
      if (t.el) {
        t.el.classList.toggle('tr-active', i === activeIndex);
        t.el.classList.toggle('tr-faded', i !== activeIndex);
        t.el.setAttribute('aria-pressed', i === activeIndex ? 'true' : 'false');
      }
    });
  }

  function removeToken(token, animate) {
    const idx = activeTokens.indexOf(token);
    if (idx === -1) return;

    if (animate && token.el) {
      token.el.classList.add('tr-token-clearing');
      const el = token.el;
      setTimeout(function() {
        if (el.parentNode) el.parentNode.removeChild(el);
      }, 300);
    } else if (token.el && token.el.parentNode) {
      token.el.parentNode.removeChild(token.el);
    }

    activeTokens.splice(idx, 1);

    if (activeIndex >= activeTokens.length) {
      activeIndex = Math.max(0, activeTokens.length - 1);
    }

    updateActiveHighlight();
  }

  function clearAllBugs() {
    const bugs = activeTokens.filter(function(t) { return t.type === 'bug'; });
    bugs.forEach(function(b) {
      showScorePop(b.x, b.y, 'CLEARED', '#818CF8');
      removeToken(b, true);
      bugsAvoided++;
    });
  }

  function handleTokenTap(token) {
    if (state !== ST.PLAY) return;

    if (token.type === 'bug') {
      removeToken(token, true);
      bugsHit++;
      streak = 0;
      combo = 1;
      updateHUD();
      triggerPulse('red');
      showScorePop(token.x, token.y, '-50', '#FF6B6B');
      score = Math.max(0, score - 50);
      updateHUD();
      if (inputEl) inputEl.value = '';
      return;
    }

    if (token.type === 'power') {
      activatePowerup(token.word, token);
      removeToken(token, true);
      powerupsCollected++;
      if (inputEl) inputEl.value = '';
      return;
    }

    removeToken(token, true);
    wordsTyped++;
    const points = Math.floor(10 * combo);
    score += points;
    streak++;
    if (streak > maxStreak) maxStreak = streak;

    const prevCombo = combo;
    if (streak % 5 === 0 && streak > 0) {
      combo++;
      if (combo > maxCombo) maxCombo = combo;
      if (combo > prevCombo) showComboFlash('x' + combo);
    }

    showScorePop(token.x, token.y, '+' + points, '#34D399');
    triggerPulse('green');
    updateHUD();
    if (inputEl) inputEl.value = '';
  }

  function activatePowerup(name, token) {
    triggerPulse('gold');
    showScorePop(token.x, token.y, name.toUpperCase() + '!', '#FCD34D');
    showPowerupIndicator(name);

    if (name === 'coffee') {
      timeScale = 0.5;
      timeScaleTimer = 5;
    } else if (name === 'focus') {
      clearAllBugs();
      score += 25;
    } else if (name === 'streak') {
      multiplierBonus = 2;
      multiplierBonusTimer = 8;
      streak += 3;
    }
  }

  function showPowerupIndicator(name) {
    const existing = arenaEl.querySelector('.tr-powerup-indicator');
    if (existing) existing.remove();

    const el = document.createElement('div');
    el.className = 'tr-powerup-indicator tr-pu-' + name;
    const labels = { coffee: '\u2615 Slow Time', focus: '\uD83D\uDC41 Focus Blast', streak: '\u26A1 Streak Boost' };
    el.textContent = labels[name] || name;
    arenaEl.appendChild(el);

    setTimeout(function() {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 3000);
  }

  function showScorePop(x, y, text, color) {
    if (reducedMotion) return;
    const el = document.createElement('div');
    el.className = 'tr-score-pop';
    el.textContent = text;
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    el.style.color = color;
    arenaEl.appendChild(el);
    setTimeout(function() {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 800);
  }

  function showComboFlash(text) {
    if (reducedMotion) return;
    const el = document.createElement('div');
    el.className = 'tr-combo-flash';
    el.textContent = text;
    el.style.color = '#818CF8';
    arenaEl.appendChild(el);
    setTimeout(function() {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 700);
  }

  function triggerPulse(color) {
    if (reducedMotion) return;
    pulseEl.className = 'tr-arena-pulse tr-pulse-' + color;
    setTimeout(function() {
      pulseEl.className = 'tr-arena-pulse';
    }, 400);
  }

  function updateHUD() {
    scoreEl.textContent = score;

    const effectiveCombo = combo + (multiplierBonus > 0 ? multiplierBonus : 0);
    if (effectiveCombo > 1) {
      comboEl.textContent = 'x' + effectiveCombo;
      comboEl.removeAttribute('hidden');
    } else {
      comboEl.setAttribute('hidden', '');
    }

    const displayTime = Math.ceil(timeLeft);
    timerEl.textContent = displayTime;
    timerEl.classList.toggle('tr-timer-low', timeLeft <= 10);

    streakCount.textContent = streak;
    const fillPct = Math.min(100, (streak % 10) * 10);
    streakFill.style.width = fillPct + '%';
    streakFill.classList.toggle('tr-streak-hot', streak >= 10 && streak < 25);
    streakFill.classList.toggle('tr-streak-fire', streak >= 25);
  }

  function handleInput() {
    if (state !== ST.PLAY || activeTokens.length === 0) return;
    const val = inputEl.value.toLowerCase().trim();

    if (activeIndex < activeTokens.length) {
      const token = activeTokens[activeIndex];
      if (token.type !== 'bug' && val === token.word) {
        handleTokenTap(token);
        return;
      }
      if (token.type === 'bug' && val === 'fix') {
        removeToken(token, true);
        bugsAvoided++;
        score += 15;
        triggerPulse('green');
        showScorePop(token.x, token.y, '+15 FIX', '#34D399');
        inputEl.value = '';
        updateHUD();
        return;
      }
    }

    for (let i = 0; i < activeTokens.length; i++) {
      const token = activeTokens[i];
      if (i === activeIndex) continue;
      if (token.type === 'power' && val === token.word) {
        activatePowerup(token.word, token);
        removeToken(token, true);
        powerupsCollected++;
        inputEl.value = '';
        return;
      }
      if (token.type !== 'bug' && val === token.word) {
        activeIndex = i;
        handleTokenTap(token);
        return;
      }
    }

    if (activeIndex < activeTokens.length) {
      const token = activeTokens[activeIndex];
      const word = token.word;
      const matching = val.length > 0 && word.startsWith(val);
      if (matching && token.el) {
        const matchLen = val.length;
        const matched = word.substring(0, matchLen);
        const rest = word.substring(matchLen);
        token.el.innerHTML = '<span class="tr-token-match">' + matched + '</span>' + rest;
      } else if (token.el) {
        token.el.textContent = token.word;
      }
    }
  }

  function startGame() {
    state = ST.PLAY;
    score = 0;
    combo = 1;
    streak = 0;
    maxCombo = 1;
    maxStreak = 0;
    wordsTyped = 0;
    bugsAvoided = 0;
    bugsHit = 0;
    powerupsCollected = 0;
    timeLeft = GAME_DURATION;
    timeScale = 1;
    timeScaleTimer = 0;
    multiplierBonus = 0;
    multiplierBonusTimer = 0;
    spawnTimer = 0;
    activeIndex = 0;
    lastTs = 0;

    activeTokens.forEach(function(t) {
      if (t.el && t.el.parentNode) t.el.parentNode.removeChild(t.el);
    });
    activeTokens = [];
    tokenEls = [];

    startEl.setAttribute('hidden', '');
    overEl.setAttribute('hidden', '');
    hudEl.removeAttribute('hidden');
    inputArea.removeAttribute('hidden');

    if (isTouchDevice) {
      mobileTapEl.removeAttribute('hidden');
    }

    updateHUD();
    if (inputEl) {
      inputEl.value = '';
      inputEl.focus();
    }
  }

  function endGame() {
    state = ST.OVER;

    activeTokens.forEach(function(t) {
      if (t.el && t.el.parentNode) t.el.parentNode.removeChild(t.el);
    });
    activeTokens = [];
    tokenEls = [];

    hudEl.setAttribute('hidden', '');
    inputArea.setAttribute('hidden', '');
    if (mobileTapEl) mobileTapEl.setAttribute('hidden', '');

    const isNewBest = score > bestScore;
    if (isNewBest) {
      bestScore = score;
      try { localStorage.setItem('token-rush-best', bestScore.toString()); } catch {}
    }

    finalScoreEl.textContent = score;

    let statsHtml = '';
    statsHtml += 'Words typed: <span>' + wordsTyped + '</span>';
    statsHtml += '<br>Max combo: <span>x' + maxCombo + '</span>';
    statsHtml += '<br>Best streak: <span>' + maxStreak + '</span>';
    statsHtml += '<br>Bugs avoided: <span>' + bugsAvoided + '</span>';
    if (bugsHit > 0) statsHtml += '<br>Bugs hit: <span>' + bugsHit + '</span>';
    statsHtml += '<br>Powerups: <span>' + powerupsCollected + '</span>';
    if (bestScore > 0) statsHtml += '<br>Session best: <span>' + bestScore + '</span>';
    finalStatsEl.innerHTML = statsHtml;

    if (isNewBest) {
      newBestEl.removeAttribute('hidden');
    } else {
      newBestEl.setAttribute('hidden', '');
    }

    overEl.removeAttribute('hidden');
  }

  function tick(ts) {
    requestAnimationFrame(tick);

    if (!visible) { lastTs = 0; return; }
    if (state !== ST.PLAY) { lastTs = 0; return; }
    if (lastTs === 0) { lastTs = ts; return; }

    const rawDt = Math.min((ts - lastTs) / 1000, 0.1);
    lastTs = ts;
    const dt = rawDt * timeScale;

    timeLeft -= dt;
    if (timeLeft <= 0) {
      timeLeft = 0;
      endGame();
      return;
    }

    if (timeScaleTimer > 0) {
      timeScaleTimer -= rawDt;
      if (timeScaleTimer <= 0) {
        timeScale = 1;
        timeScaleTimer = 0;
      }
    }

    if (multiplierBonusTimer > 0) {
      multiplierBonusTimer -= rawDt;
      if (multiplierBonusTimer <= 0) {
        multiplierBonus = 0;
        multiplierBonusTimer = 0;
        updateHUD();
      }
    }

    spawnTimer += dt;
    const spawnInterval = Math.max(0.6, TOKEN_SPAWN_INTERVAL - (GAME_DURATION - timeLeft) * 0.008);
    if (spawnTimer >= spawnInterval) {
      spawnTimer = 0;
      spawnToken();
    }

    for (let i = activeTokens.length - 1; i >= 0; i--) {
      const token = activeTokens[i];
      token.age += dt;

      if (token.age >= token.lifetime) {
        if (token.type === 'good') {
          streak = 0;
          combo = Math.max(1, combo - 1);
        }
        removeToken(token, false);
        continue;
      }

      if (token.el) {
        const remaining = token.lifetime - token.age;
        if (remaining < 1.5 && !token.el.classList.contains('tr-token-expiring')) {
          if (!reducedMotion) token.el.classList.add('tr-token-expiring');
        }
      }
    }

    if (activeIndex >= activeTokens.length) {
      activeIndex = Math.max(0, activeTokens.length - 1);
    }
    updateActiveHighlight();
    updateHUD();
  }

  playBtn.addEventListener('click', startGame);
  againBtn.addEventListener('click', startGame);

  if (inputEl) {
    inputEl.addEventListener('input', handleInput);
  }

  document.addEventListener('keydown', function(e) {
    if (e.code === 'Space') {
      if (state === ST.MENU || state === ST.OVER) {
        e.preventDefault();
        startGame();
      }
    }
    if (e.code === 'Escape' && state === ST.PLAY) {
      endGame();
    }
  });

  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      visible = entry.isIntersecting;
    });
  }, { threshold: 0 });
  observer.observe(gameEl);

  requestAnimationFrame(tick);
})();
</script>
