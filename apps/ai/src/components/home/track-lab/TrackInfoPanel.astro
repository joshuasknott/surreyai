---
import type { AITrack } from "../../../data/aiTracks";

interface Props {
  tracks: AITrack[];
  activeId: string;
}

const { tracks, activeId } = Astro.props;
---

<div class="track-info-panels" data-track-info-panels>
  {tracks.map((track, index) => (
    <div
      class={`track-info-panel${track.id === activeId ? " is-active" : ""}`}
      id={`track-panel-${track.id}`}
      role="tabpanel"
      aria-labelledby={`track-tab-${track.id}`}
      data-track-info={track.id}
      hidden={track.id !== activeId}
      aria-hidden={track.id !== activeId ? "true" : "false"}
      style={`--panel-accent: ${track.accentColor}; --panel-accent-rgb: ${track.accentRgb};`}
    >
      <div class="track-info-panel__header">
        <span class="track-info-panel__index">Track {String(index + 1).padStart(2, "0")}</span>
        <span class="track-info-panel__mode">{track.aiMode}</span>
      </div>

      <div>
        <h3 class="track-info-panel__title">{track.title}</h3>
        <p class="track-info-panel__explanation">{track.explanation}</p>
      </div>

      <div class="track-info-panel__meaning">
        <span class="track-info-panel__section-label">What this demonstrates</span>
        <p>{track.meaning}</p>
      </div>

      <div class="track-info-panel__society">
        <span class="track-info-panel__section-label">How the society makes it practical</span>
        <ul class="track-info-panel__society-list" aria-label={`${track.title} society activities`}>
          {track.societyBullets.map((sb) => (
            <li class="track-info-panel__society-item">
              <span class="track-info-panel__society-marker" aria-hidden="true"></span>
              <span>{sb}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="track-info-panel__cue">
        <span class="track-info-panel__cue-icon" aria-hidden="true">&#x2197;</span>
        <span class="track-info-panel__cue-text">{track.interactionCue}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .track-info-panels {
    display: flex;
    width: 100%;
  }

  .track-info-panel {
    position: relative;
    display: none;
    width: 100%;
    min-height: 100%;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--panel-accent) 32%, var(--ai-border));
    border-radius: 1.35rem;
    background:
      radial-gradient(circle at 20% 0%, rgba(var(--panel-accent-rgb), 0.17), transparent 11rem),
      color-mix(in srgb, var(--ai-surface) 82%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 48%, transparent);
    opacity: 0;
    transform: translateY(0.35rem);
    transition: opacity 280ms ease, transform 280ms ease;
  }

  .track-info-panel.is-active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .track-info-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .track-info-panel__index,
  .track-info-panel__mode,
  .track-info-panel__section-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .track-info-panel__index {
    color: var(--panel-accent);
  }

  .track-info-panel__mode {
    padding: 0.38rem 0.55rem;
    border: 1px solid rgba(var(--panel-accent-rgb), 0.34);
    border-radius: 9999px;
    color: var(--ai-fg-muted);
    background: rgba(var(--panel-accent-rgb), 0.08);
  }

  .track-info-panel__title {
    margin: 0;
    color: var(--ai-fg);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.07em;
    line-height: 0.95;
  }

  .track-info-panel__explanation {
    margin: 0.9rem 0 0;
    color: var(--ai-fg);
    font-size: 1.02rem;
    line-height: 1.62;
  }

  .track-info-panel__meaning,
  .track-info-panel__society {
    padding-top: 1rem;
    border-top: 1px solid var(--ai-border);
  }

  .track-info-panel__section-label {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--ai-fg-muted);
  }

  .track-info-panel__meaning p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.55;
  }

  .track-info-panel__society-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .track-info-panel__society-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    color: var(--ai-fg);
    font-size: 0.93rem;
    line-height: 1.45;
  }

  .track-info-panel__society-marker {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 9999px;
    margin-top: 0.42rem;
    background: var(--panel-accent);
    box-shadow: 0 0 1rem rgba(var(--panel-accent-rgb), 0.72);
  }

  .track-info-panel__cue {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-top: auto;
    padding: 0.95rem;
    border: 1px solid rgba(var(--panel-accent-rgb), 0.3);
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(var(--panel-accent-rgb), 0.12), color-mix(in srgb, var(--ai-bg) 70%, transparent));
  }

  .track-info-panel__cue-icon {
    color: var(--panel-accent);
    font-size: 1rem;
    line-height: 1.2;
  }

  .track-info-panel__cue-text {
    color: var(--ai-fg);
    font-size: 0.9rem;
    font-weight: 750;
    line-height: 1.45;
  }

  @media (max-width: 980px) {
    .track-info-panel {
      min-height: auto;
    }
  }
</style>
