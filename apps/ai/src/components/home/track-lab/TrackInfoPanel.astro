---
import type { AITrack } from "../../../data/aiTracks";

interface Props {
  tracks: AITrack[];
  activeId: string;
}

const { tracks, activeId } = Astro.props;
---

<div class="track-info-panels" data-track-info-panels>
  {tracks.map((track) => (
    <div
      class={`track-info-panel${track.id === activeId ? " is-active" : ""}`}
      id={`track-panel-${track.id}`}
      role="tabpanel"
      aria-labelledby={`track-tab-${track.id}`}
      data-track-info={track.id}
      hidden={track.id !== activeId}
      aria-hidden={track.id !== activeId ? "true" : "false"}
    >
      <h3 class="track-info-panel__title" style={`color: ${track.accentColor}`}>
        {track.title}
      </h3>
      <p class="track-info-panel__explanation">{track.explanation}</p>

      <ul class="track-info-panel__bullets" aria-label="What you will learn">
        {track.bullets.map((bullet) => (
          <li class="track-info-panel__bullet">
            <span class="track-info-panel__bullet-dot" style={`background: ${track.accentColor};`} aria-hidden="true"></span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>

      <div class="track-info-panel__society">
        <span class="track-info-panel__section-label">What we do</span>
        <ul class="track-info-panel__society-list" aria-label="Society Activities">
          {track.societyBullets.map((sb) => (
            <li class="track-info-panel__society-item">
              <span class="track-info-panel__society-marker" style={`background: ${track.accentColor};`} aria-hidden="true"></span>
              <span>{sb}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="track-info-panel__meaning">
        <span class="track-info-panel__section-label">Why it matters</span>
        <p class="track-info-panel__meaning-text">{track.meaning}</p>
      </div>

      <div class="track-info-panel__cue">
        <span class="track-info-panel__cue-icon" aria-hidden="true" style={`color: ${track.accentColor};`}>&#x2197;</span>
        <span class="track-info-panel__cue-text">{track.interactionCue}</span>
      </div>

      <div class="track-info-panel__mode">
        <span class="track-info-panel__mode-badge" style={`color: ${track.accentColor}; border-color: color-mix(in srgb, ${track.accentColor} 30%, transparent); background: color-mix(in srgb, ${track.accentColor} 10%, transparent);`}>
          {track.aiMode}
        </span>
      </div>
    </div>
  ))}
</div>

<style>
  .track-info-panels {
    display: flex;
    flex-direction: column;
  }

  .track-info-panel {
    display: none;
    flex-direction: column;
    gap: 20px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 280ms ease, transform 280ms ease;
  }

  .track-info-panel.is-active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .track-info-panel__title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .track-info-panel__explanation {
    color: var(--ai-fg);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 480px;
  }

  .track-info-panel__bullets,
  .track-info-panel__society-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .track-info-panel__bullet,
  .track-info-panel__society-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--ai-fg-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .track-info-panel__bullet-dot,
  .track-info-panel__society-marker {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 8px;
  }

  .track-info-panel__society-marker {
    border-radius: 2px;
  }

  .track-info-panel__section-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ai-fg-muted);
    margin-bottom: 12px;
  }

  .track-info-panel__meaning-text {
    color: var(--ai-fg-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    font-style: italic;
  }

  .track-info-panel__cue {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    background: var(--ai-bg);
  }

  .track-info-panel__cue-icon {
    font-size: 1.2rem;
    line-height: 1;
  }

  .track-info-panel__cue-text {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ai-fg);
  }

  .track-info-panel__mode-badge {
    display: inline-block;
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-sans);
    border: 1px solid;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .track-info-panel {
      gap: 16px;
    }
  }
</style>
