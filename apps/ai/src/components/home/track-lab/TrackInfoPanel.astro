---
import type { AITrack } from "../../../data/aiTracks";

interface Props {
  tracks: AITrack[];
  activeId: string;
}

const { tracks, activeId } = Astro.props;
---

<div class="track-info-panels" data-track-info-panels>
  {tracks.map((track) => (
    <div
      class={`track-info-panel${track.id === activeId ? " is-active" : ""}`}
      data-track-info={track.id}
      hidden={track.id !== activeId}
      aria-hidden={track.id !== activeId ? "true" : "false"}
    >
      <h3 class="track-info-panel__title" style={`--track-accent: ${track.accentColor}`}>
        {track.title}
      </h3>
      <p class="track-info-panel__explanation">{track.explanation}</p>

      <ul class="track-info-panel__bullets">
        {track.bullets.map((bullet) => (
          <li class="track-info-panel__bullet">
            <span class="track-info-panel__bullet-dot" style={`background: ${track.accentColor}; box-shadow: 0 0 8px ${track.accentColor}66;`}></span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>

      <div class="track-info-panel__society">
        <span class="track-info-panel__section-label">What we do</span>
        <ul class="track-info-panel__society-list">
          {track.societyBullets.map((sb) => (
            <li class="track-info-panel__society-item">
              <span class="track-info-panel__society-marker" style={`border-color: ${track.accentColor}44; color: ${track.accentColor};`}></span>
              <span>{sb}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="track-info-panel__meaning">
        <span class="track-info-panel__section-label">Why it matters</span>
        <p class="track-info-panel__meaning-text">{track.meaning}</p>
      </div>

      <div class="track-info-panel__cue">
        <span class="track-info-panel__cue-icon" style={`color: ${track.accentColor};`}>&#x2197;</span>
        <span class="track-info-panel__cue-text">{track.interactionCue}</span>
      </div>

      <div class="track-info-panel__mode">
        <span class="track-info-panel__mode-badge" style={`border-color: ${track.accentColor}44; color: ${track.accentColor};`}>
          {track.aiMode}
        </span>
      </div>
    </div>
  ))}
</div>

<style>
  .track-info-panels {
    display: flex;
    flex-direction: column;
  }

  .track-info-panel {
    display: none;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 280ms ease, transform 280ms ease;
  }

  .track-info-panel.is-active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .track-info-panel__title {
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 950;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--track-accent, #06B6D4);
  }

  .track-info-panel__explanation {
    color: #CBD5E1;
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 420px;
  }

  .track-info-panel__bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .track-info-panel__bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #CBD5E1;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .track-info-panel__bullet-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
  }

  .track-info-panel__section-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #64748B;
    margin-bottom: 6px;
  }

  .track-info-panel__society {
    margin-top: 2px;
  }

  .track-info-panel__society-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .track-info-panel__society-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #94A3B8;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .track-info-panel__society-marker {
    width: 6px;
    height: 6px;
    border: 1.5px solid;
    border-radius: 2px;
    flex-shrink: 0;
    margin-top: 6px;
  }

  .track-info-panel__meaning-text {
    color: #94A3B8;
    font-size: 0.85rem;
    line-height: 1.6;
    font-style: italic;
  }

  .track-info-panel__cue {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid rgba(148, 163, 184, 0.1);
    border-radius: 8px;
    background: rgba(5, 8, 16, 0.4);
  }

  .track-info-panel__cue-icon {
    font-size: 1rem;
    font-weight: 700;
  }

  .track-info-panel__cue-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94A3B8;
    font-style: italic;
  }

  .track-info-panel__mode-badge {
    display: inline-block;
    padding: 4px 10px;
    font-size: 0.68rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid;
    border-radius: 6px;
    background: rgba(5, 8, 16, 0.5);
  }

  @media (max-width: 768px) {
    .track-info-panel__title {
      font-size: 1.35rem;
    }
  }
</style>
