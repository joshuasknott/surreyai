---
import type { AITrack } from "../../../data/aiTracks";

interface Props {
  tracks: AITrack[];
  activeId: string;
}

const { tracks, activeId } = Astro.props;
---

<div class="track-selectors" role="tablist" aria-label="AI Tracks" data-track-selectors>
  {tracks.map((track, index) => (
    <button
      type="button"
      role="tab"
      id={`track-tab-${track.id}`}
      aria-selected={track.id === activeId ? "true" : "false"}
      aria-controls={`track-panel-${track.id} track-stage-${track.id}`}
      class={`track-selectors__tab${track.id === activeId ? " is-active" : ""}`}
      data-track-tab={track.id}
      data-accent={track.accentColor}
      data-accent-rgb={track.accentRgb}
      tabindex={track.id === activeId ? 0 : -1}
    >
      <span class="track-selectors__tab-icon" aria-hidden="true">{track.icon}</span>
      <span class="track-selectors__tab-label">{track.title}</span>
    </button>
  ))}
</div>

<style>
  .track-selectors {
    display: flex;
    gap: 2px;
    padding: 12px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--ai-border) transparent;
  }

  .track-selectors::-webkit-scrollbar {
    height: 4px;
  }

  .track-selectors::-webkit-scrollbar-track {
    background: transparent;
  }

  .track-selectors::-webkit-scrollbar-thumb {
    background: var(--ai-border);
    border-radius: 2px;
  }

  .track-selectors__tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--ai-fg-muted);
    background: transparent;
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
  }

  .track-selectors__tab:hover {
    color: var(--ai-fg);
    background: var(--ai-bg);
  }

  .track-selectors__tab:focus-visible {
    outline: 2px solid var(--ai-cyan);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .track-selectors__tab.is-active {
    color: var(--ai-fg);
    background: var(--ai-surface);
    border-color: var(--ai-border);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--ai-fg) 4%, transparent);
  }

  .track-selectors__tab-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .track-selectors__tab {
      padding: 8px 12px;
      font-size: 0.72rem;
    }
  }
</style>
