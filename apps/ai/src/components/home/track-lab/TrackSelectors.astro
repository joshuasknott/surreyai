---
import type { AITrack } from "../../../data/aiTracks";

interface Props {
  tracks: AITrack[];
  activeId: string;
}

const { tracks, activeId } = Astro.props;
---

<div class="track-selectors" role="tablist" aria-label="AI Tracks" data-track-selectors>
  {tracks.map((track, index) => (
    <button
      type="button"
      role="tab"
      id={`track-tab-${track.id}`}
      aria-selected={track.id === activeId ? "true" : "false"}
      aria-controls={`track-panel-${track.id} track-stage-${track.id}`}
      class={`track-selectors__tab${track.id === activeId ? " is-active" : ""}`}
      data-track-tab={track.id}
      data-accent={track.accentColor}
      data-accent-rgb={track.accentRgb}
      tabindex={track.id === activeId ? 0 : -1}
      style={`--track-accent: ${track.accentColor}; --track-accent-rgb: ${track.accentRgb};`}
    >
      <span class="track-selectors__tab-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
      <span class="track-selectors__tab-main">
        <span class="track-selectors__tab-icon" aria-hidden="true">{track.icon}</span>
        <span class="track-selectors__tab-label">{track.title}</span>
      </span>
    </button>
  ))}
</div>

<style>
  .track-selectors {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(6, minmax(8rem, 1fr));
    gap: 0.55rem;
    padding: 0.85rem;
    border-bottom: 1px solid var(--ai-border);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--ai-border-strong) transparent;
    background: color-mix(in srgb, var(--ai-bg) 50%, transparent);
  }

  .track-selectors::-webkit-scrollbar {
    height: 0.38rem;
  }

  .track-selectors::-webkit-scrollbar-track {
    background: transparent;
  }

  .track-selectors::-webkit-scrollbar-thumb {
    background: var(--ai-border-strong);
    border-radius: 9999px;
  }

  .track-selectors__tab {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.62rem;
    min-height: 6.4rem;
    padding: 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ai-border-strong) 52%, transparent);
    border-radius: 1.15rem;
    color: var(--ai-fg-muted);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ai-surface) 78%, transparent), color-mix(in srgb, var(--ai-bg) 72%, transparent));
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, color 200ms ease, box-shadow 200ms ease;
  }

  .track-selectors__tab::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 0.18rem;
    background: linear-gradient(90deg, transparent, var(--track-accent), transparent);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .track-selectors__tab:hover {
    transform: translateY(-1px);
    color: var(--ai-fg);
    border-color: color-mix(in srgb, var(--track-accent) 42%, var(--ai-border));
  }

  .track-selectors__tab:focus-visible {
    outline: 2px solid var(--track-accent);
    outline-offset: 3px;
  }

  .track-selectors__tab.is-active {
    color: var(--ai-fg);
    border-color: color-mix(in srgb, var(--track-accent) 58%, var(--ai-border));
    background:
      radial-gradient(circle at 18% 0%, rgba(var(--track-accent-rgb), 0.18), transparent 5.8rem),
      color-mix(in srgb, var(--ai-surface) 90%, transparent);
    box-shadow: 0 16px 34px rgba(var(--track-accent-rgb), 0.12);
  }

  .track-selectors__tab.is-active::after {
    opacity: 1;
  }

  .track-selectors__tab-index {
    color: var(--track-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .track-selectors__tab-main {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.85rem;
    margin-top: auto;
  }

  .track-selectors__tab-icon {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid rgba(var(--track-accent-rgb), 0.35);
    border-radius: 0.8rem;
    color: var(--track-accent);
    background: rgba(var(--track-accent-rgb), 0.1);
    font-size: 0.9rem;
    line-height: 1;
  }

  .track-selectors__tab-label {
    font-size: clamp(0.78rem, 1vw, 0.95rem);
    font-weight: 850;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  @media (max-width: 980px) {
    .track-selectors {
      display: flex;
    }

    .track-selectors__tab {
      min-width: 10rem;
    }
  }

  @media (max-width: 640px) {
    .track-selectors__tab {
      min-width: 8.7rem;
      min-height: 5.5rem;
      padding: 0.72rem;
    }
  }
</style>
