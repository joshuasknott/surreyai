---
---

<div class="task-relay" data-task-relay hidden>
  <div class="tr-header">
    <div class="tr-goals" data-goals role="group" aria-label="Goal Selection">
      <button class="tr-goal" data-goal="plan-event" type="button" aria-pressed="false">Plan a society event</button>
      <button class="tr-goal" data-goal="research" type="button" aria-pressed="false">Research a topic</button>
      <button class="tr-goal" data-goal="build" type="button" aria-pressed="false">Prepare a group project</button>
      <button class="tr-goal" data-goal="organise" type="button" aria-pressed="false">Organise notes</button>
      <button class="tr-goal" data-goal="launch" type="button" aria-pressed="false">Launch a project team</button>
    </div>
    <div class="tr-custom">
      <label for="custom-goal" class="tr-sr-only">Custom goal input</label>
      <input
        id="custom-goal"
        class="tr-input"
        type="text"
        data-custom-goal
        placeholder="Or type a custom goal&#8230;"
        maxlength="100"
      />
      <button class="tr-start" data-action="start" type="button" disabled>
        Start Workflow
      </button>
      <button class="tr-reset" data-action="reset" type="button" hidden>
        New Workflow
      </button>
    </div>
  </div>

  <div class="tr-pipeline" data-pipeline>
    <div class="tr-track" role="list" aria-label="Workflow Stages">
      <div class="tr-node" data-stage="0" role="listitem" aria-label="Stage 1: Understand">1</div>
      <div class="tr-seg" data-seg="0" aria-hidden="true"></div>
      <div class="tr-node" data-stage="1" role="listitem" aria-label="Stage 2: Research">2</div>
      <div class="tr-seg" data-seg="1" aria-hidden="true"></div>
      <div class="tr-node" data-stage="2" role="listitem" aria-label="Stage 3: Plan">3</div>
      <div class="tr-seg" data-seg="2" aria-hidden="true"></div>
      <div class="tr-node" data-stage="3" role="listitem" aria-label="Stage 4: Draft">4</div>
      <div class="tr-seg" data-seg="3" aria-hidden="true"></div>
      <div class="tr-node" data-stage="4" role="listitem" aria-label="Stage 5: Review">5</div>
      <div class="tr-seg" data-seg="4" aria-hidden="true"></div>
      <div class="tr-node" data-stage="5" role="listitem" aria-label="Stage 6: Finalise">6</div>
    </div>
    <div class="tr-labels" aria-hidden="true">
      <span class="tr-label">Understand</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Research</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Plan</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Draft</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Review</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Finalise</span>
    </div>
  </div>

  <div class="tr-log" data-output aria-live="polite">
    <span class="tr-log__hint">Select a goal and start the workflow</span>
  </div>
</div>

<style>
  .task-relay {
    --tr: var(--ai-cyan, #22d3ee);
    --tr-dim: color-mix(in srgb, var(--tr) 15%, transparent);
    --tr-mid: color-mix(in srgb, var(--tr) 35%, transparent);
    
    /* Theme variables for black/white support */
    --tr-bg: var(--ai-bg, transparent);
    --tr-surface: var(--ai-surface, rgba(5, 8, 16, 0.6));
    --tr-input-bg: var(--ai-surface, rgba(5, 8, 16, 0.5));
    --tr-text: var(--ai-fg, #cbd5e1);
    --tr-text-muted: var(--ai-fg-muted, #94a3b8);
    --tr-border: var(--ai-border, rgba(148, 163, 184, 0.15));

    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px;
    font-family: var(--font-sans);
    color: var(--tr-text);
    position: relative;
    overflow: hidden;
    background: var(--tr-bg);
  }

  .tr-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ── Header ─────────────────────────────────────── */

  .tr-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tr-goals {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tr-goal {
    padding: 6px 14px;
    border: 1px solid var(--tr-border);
    border-radius: 8px;
    background: transparent;
    color: var(--tr-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 180ms, background 180ms, border-color 180ms;
    font-family: var(--font-sans);
    white-space: nowrap;
    line-height: 1.4;
  }

  .tr-goal:hover {
    color: var(--tr-text);
    border-color: color-mix(in srgb, var(--tr) 40%, var(--tr-border));
  }

  .tr-goal:focus-visible {
    outline: 2px solid var(--tr);
    outline-offset: 2px;
  }

  .tr-goal.is-selected,
  .tr-goal[aria-pressed="true"] {
    color: var(--tr);
    background: var(--tr-dim);
    border-color: color-mix(in srgb, var(--tr) 50%, transparent);
  }

  .tr-goal:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .tr-custom {
    display: flex;
    gap: 8px;
  }

  .tr-input {
    flex: 1;
    min-width: 0;
    padding: 8px 14px;
    border: 1px solid var(--tr-border);
    border-radius: 8px;
    background: var(--tr-input-bg);
    color: var(--tr-text);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 180ms;
    line-height: 1.4;
  }

  .tr-input:focus {
    border-color: color-mix(in srgb, var(--tr) 50%, transparent);
  }

  .tr-input::placeholder {
    color: color-mix(in srgb, var(--tr-text-muted) 70%, transparent);
  }

  .tr-input:disabled {
    opacity: 0.4;
  }

  .tr-start,
  .tr-reset {
    padding: 8px 18px;
    border: 1px solid color-mix(in srgb, var(--tr) 40%, transparent);
    border-radius: 8px;
    background: var(--tr-dim);
    color: var(--tr);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 180ms, border-color 180ms;
    font-family: var(--font-sans);
    white-space: nowrap;
    line-height: 1.4;
  }

  .tr-start:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .tr-start:not(:disabled):hover,
  .tr-reset:hover {
    background: color-mix(in srgb, var(--tr) 25%, transparent);
    border-color: color-mix(in srgb, var(--tr) 60%, transparent);
  }

  .tr-start:focus-visible,
  .tr-reset:focus-visible {
    outline: 2px solid var(--tr);
    outline-offset: 2px;
  }

  /* ── Pipeline ───────────────────────────────────── */

  .tr-pipeline {
    position: relative;
    padding: 12px 0 0;
  }

  .tr-track {
    display: flex;
    align-items: center;
  }

  .tr-node {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border: 2px solid color-mix(in srgb, var(--tr) 20%, transparent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--tr) 50%, var(--tr-text-muted));
    background: var(--tr-surface);
    transition: border-color 350ms, color 350ms, background 350ms;
    position: relative;
    z-index: 2;
    padding: 0;
  }

  .tr-node.is-active {
    border-color: var(--tr);
    color: var(--tr);
    background: var(--tr-dim);
  }

  .tr-node.is-done {
    border-color: color-mix(in srgb, var(--tr) 60%, transparent);
    color: var(--tr);
    background: color-mix(in srgb, var(--tr) 15%, transparent);
  }

  .tr-seg {
    flex: 1;
    height: 3px;
    background: color-mix(in srgb, var(--tr) 10%, transparent);
    transition: background 500ms ease;
    position: relative;
    z-index: 1;
  }

  .tr-seg.is-active {
    background: color-mix(in srgb, var(--tr) 50%, transparent);
  }

  .tr-seg.is-done {
    background: color-mix(in srgb, var(--tr) 35%, transparent);
  }

  .tr-labels {
    display: flex;
    margin-top: 8px;
  }

  .tr-label {
    flex-shrink: 0;
    width: 40px;
    text-align: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--tr-text-muted);
    transition: color 350ms;
    line-height: 1.3;
  }

  .tr-label.is-active {
    color: var(--tr);
  }

  .tr-label.is-done {
    color: color-mix(in srgb, var(--tr-text-muted) 80%, transparent);
  }

  .tr-label-gap {
    flex: 1;
  }

  /* ── Log ────────────────────────────────────────── */

  .tr-log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--tr-text-muted) 20%, transparent) transparent;
  }

  .tr-log::-webkit-scrollbar {
    width: 4px;
  }

  .tr-log::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--tr-text-muted) 20%, transparent);
    border-radius: 2px;
  }

  .tr-log__hint {
    color: var(--tr-text-muted);
    font-size: 0.95rem;
    font-style: italic;
    opacity: 0.8;
  }

  .tr-entry {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.95rem;
    line-height: 1.5;
    animation: tr-fadein 350ms ease both;
    padding: 4px 0;
  }

  .tr-entry__status {
    flex-shrink: 0;
    width: 16px;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .tr-entry__step {
    font-weight: 600;
    color: var(--tr);
    flex-shrink: 0;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    min-width: 80px;
    padding-top: 0.1em;
  }

  .tr-entry__text {
    color: var(--tr-text-muted);
    min-width: 0;
  }

  .tr-entry.is-current .tr-entry__status {
    color: var(--tr);
  }

  .tr-entry.is-current .tr-entry__text {
    color: var(--tr-text);
  }

  .tr-entry.is-done .tr-entry__status {
    color: #4ade80;
  }

  .tr-entry.is-done .tr-entry__text {
    color: var(--tr-text-muted);
  }

  .tr-entry.is-current::after {
    content: "\258A";
    animation: tr-blink 1s step-end infinite;
    color: var(--tr);
    margin-left: 4px;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .tr-log__complete {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #4ade80;
    animation: tr-fadein 500ms ease both;
  }

  .tr-log__complete-mark {
    font-size: 1.1rem;
  }

  /* ── Keyframes ──────────────────────────────────── */

  @keyframes tr-fadein {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tr-blink {
    50% {
      opacity: 0;
    }
  }

  /* ── Responsive ─────────────────────────────────── */

  @media (max-width: 768px) {
    .task-relay {
      padding: 16px 14px;
      gap: 12px;
    }

    .tr-goal {
      padding: 5px 12px;
      font-size: 0.85rem;
    }

    .tr-node {
      width: 32px;
      height: 32px;
      font-size: 0.9rem;
      border-radius: 10px;
    }

    .tr-label {
      width: 32px;
      font-size: 0.6rem;
    }

    .tr-entry {
      font-size: 0.85rem;
    }

    .tr-entry__step {
      font-size: 0.75rem;
      min-width: 65px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .task-relay *,
    .task-relay *::before,
    .task-relay *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initTaskRelay() {
    var root = document.querySelector("[data-task-relay]");
    if (!root) return;

    var slot = document.querySelector('[data-proto-slot="agents"]');
    if (slot && !slot.contains(root)) {
      while (slot.firstChild) slot.removeChild(slot.firstChild);
      slot.appendChild(root);
    }
    root.removeAttribute("hidden");

    var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var STEPS = ["Understand", "Research", "Plan", "Draft", "Review", "Finalise"];
    var STAGE_MS = prefersReducedMotion ? 200 : 1800;

    var GOAL_OUTPUTS = {
      "plan-event": [
        "Scope: social mixer, 50\u201380 students, \u00A3200 budget, 3 weeks",
        "3 venues found. Similar events: 65 avg attendance. 2 caterers quoted",
        "Wk 1: book venue + poster \u2192 Wk 2: promote \u2192 Wk 3: finalise + run",
        "Poster done. Campaign scheduled. Venue booked. RSVP form live",
        "On schedule. Budget OK. Added day-5 nudge for low RSVP risk",
        "Plan packaged with timeline visual. Ready for committee approval",
      ],
      research: [
        "Topic scoped. Key question identified. Information gaps mapped",
        "12 sources found: 4 papers, 3 blogs, 5 docs. Ranked by relevance",
        "Structure: intro \u2192 findings \u2192 analysis \u2192 conclusion. Sources prioritised",
        "Draft compiled with 8 citations. Counterarguments addressed",
        "3 claims fact-checked. 2 arguments strengthened. Context gaps filled",
        "Summary polished. Key insights highlighted. Ready to share",
      ],
      build: [
        "Scope: Group project. Core requirements mapped. Constraints noted",
        "3 approaches evaluated. Existing solutions analysed. Architecture planned",
        "Roles distributed. Tech stack set. Milestones defined",
        "Core module drafted. API wired. Initial work combined.",
        "Output reviewed. 2 edge cases fixed. Formatting standardised.",
        "Project ready. Docs written. Staged. Ready for submission",
      ],
      organise: [
        "47 notes scanned. 4 topics, 12 sub-topics. 3 priority areas",
        "Tag taxonomy designed. Cross-refs mapped. Orphans flagged",
        "Folders: topic-based. Tags: hierarchical. Flow: capture \u2192 process \u2192 archive",
        "All 47 notes sorted. Tags applied. Cross-references linked",
        "12 re-categorised. 3 duplicates merged. Dead links pruned",
        "Notebook exported. Quick-ref guide generated. Search indexed",
      ],
      launch: [
        "Team 4\u20136. Project: AI tool. Timeline: 8 weeks. 4 skill areas",
        "4 candidates matched. 3 past projects studied. Roles templated",
        "Roles assigned. Sprints planned. Channels opened. Kick-off drafted",
        "Repo created. Board configured. Docs written. Sprint 1 queued",
        "Alignment confirmed. Dependencies mapped. Risk register live",
        "Charter signed. Roadmap visualised. Kick-off scheduled",
      ],
    };

    var GENERIC_OUTPUTS = [
      "Goal decomposed. Key requirements surfaced. Constraints noted",
      "Background research complete. 5 relevant sources catalogued",
      "Action plan: 4 phases, clear milestones, dependencies mapped",
      "Core deliverables produced. Components assembled and verified",
      "Output reviewed against spec. 2 refinements applied",
      "Package finalised. Results documented. Ready for delivery",
    ];

    var selectedGoal = null;
    var isRunning = false;
    var currentStage = -1;

    var goalBtns = root.querySelectorAll("[data-goal]");
    var customInput = root.querySelector("[data-custom-goal]");
    var startBtn = root.querySelector('[data-action="start"]');
    var resetBtn = root.querySelector('[data-action="reset"]');
    var nodes = root.querySelectorAll("[data-stage]");
    var segs = root.querySelectorAll("[data-seg]");
    var labels = root.querySelectorAll(".tr-label");
    var outputEl = root.querySelector("[data-output]");

    function sleep(ms) {
      return new Promise(function (r) {
        setTimeout(r, ms);
      });
    }

    function updateUI() {
      var hasGoal = selectedGoal !== null;
      startBtn.disabled = !hasGoal || isRunning;

      goalBtns.forEach(function (btn) {
        var match = btn.dataset.goal === selectedGoal;
        btn.classList.toggle("is-selected", match);
        btn.setAttribute("aria-pressed", match.toString());
        btn.disabled = isRunning;
      });

      customInput.disabled = isRunning;
    }

    function updateLabel(idx, cls) {
      if (labels[idx]) {
        labels[idx].classList.remove("is-active", "is-done");
        if (cls) labels[idx].classList.add(cls);
      }
    }

    function getOutput(goalKey, stageIdx) {
      if (goalKey === "custom") return GENERIC_OUTPUTS[stageIdx] || "";
      var bank = GOAL_OUTPUTS[goalKey];
      if (bank) return bank[stageIdx] || "";
      return GENERIC_OUTPUTS[stageIdx] || "";
    }

    function clearLogExtras() {
      var hint = outputEl.querySelector(".tr-log__hint");
      if (hint) hint.remove();
      var completeMsg = outputEl.querySelector(".tr-log__complete");
      if (completeMsg) completeMsg.remove();
    }

    function addLogEntry(idx, text, isCurrent) {
      clearLogExtras();

      var div = document.createElement("div");
      div.className = "tr-entry" + (isCurrent ? " is-current" : " is-done");
      div.dataset.entry = String(idx);

      var statusSpan = document.createElement("span");
      statusSpan.className = "tr-entry__status";
      statusSpan.textContent = isCurrent ? "\u25B6" : "\u2713";

      var stepSpan = document.createElement("span");
      stepSpan.className = "tr-entry__step";
      stepSpan.textContent = STEPS[idx];

      var textSpan = document.createElement("span");
      textSpan.className = "tr-entry__text";
      textSpan.textContent = text;

      div.appendChild(statusSpan);
      div.appendChild(stepSpan);
      div.appendChild(textSpan);

      outputEl.appendChild(div);
      outputEl.scrollTop = outputEl.scrollHeight;
    }

    function markEntryDone(idx) {
      var entry = outputEl.querySelector('[data-entry="' + idx + '"]');
      if (!entry) return;
      entry.classList.remove("is-current");
      entry.classList.add("is-done");
      var status = entry.querySelector(".tr-entry__status");
      if (status) status.textContent = "\u2713";
    }

    function addCompleteMsg() {
      clearLogExtras();
      var div = document.createElement("div");
      div.className = "tr-log__complete";

      var mark = document.createElement("span");
      mark.className = "tr-log__complete-mark";
      mark.textContent = "\u2713";

      var txt = document.createElement("span");
      txt.textContent = "Workflow complete \u2014 6 stages passed";

      div.appendChild(mark);
      div.appendChild(txt);
      outputEl.appendChild(div);
      outputEl.scrollTop = outputEl.scrollHeight;
    }

    async function callAI(goal, stageIdx) {
      try {
        var lab = document.querySelector("[data-track-lab]");
        var aiOn =
          (lab && lab.dataset.aiEnabled === "true") ||
          document.documentElement.dataset.aiEnabled === "true";
        if (!aiOn) return null;

        var ctrl = new AbortController();
        var tid = setTimeout(function () {
          ctrl.abort();
        }, 5000);

        var res = await fetch("/api/ai/track-lab", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            feature: "task-relay",
            goal: goal,
            stage: stageIdx,
          }),
          signal: ctrl.signal,
        });

        clearTimeout(tid);
        if (!res.ok) return null;
        var data = await res.json();
        return (data && data.output) || null;
      } catch (e) {
        return null;
      }
    }

    async function runStage(idx) {
      currentStage = idx;

      nodes[idx].classList.add("is-active");
      updateLabel(idx, "is-active");
      if (idx > 0) segs[idx - 1].classList.add("is-active");

      var goalKey =
        selectedGoal === "custom" ? "custom" : selectedGoal || "custom";
      var aiResult = await callAI(goalKey, idx);
      var text = aiResult || getOutput(goalKey, idx);

      addLogEntry(idx, text, true);

      await sleep(STAGE_MS);

      nodes[idx].classList.remove("is-active");
      nodes[idx].classList.add("is-done");
      updateLabel(idx, "is-done");
      if (idx > 0) {
        segs[idx - 1].classList.remove("is-active");
        segs[idx - 1].classList.add("is-done");
      }

      markEntryDone(idx);
    }

    async function runWorkflow() {
      isRunning = true;
      root.classList.add("is-running");
      updateUI();

      for (var i = 0; i < 6; i++) {
        await runStage(i);
      }

      completeWorkflow();
    }

    function completeWorkflow() {
      root.classList.add("is-complete");

      addCompleteMsg();

      startBtn.hidden = true;
      resetBtn.hidden = false;
      isRunning = false;
    }

    function resetWorkflow() {
      root.classList.remove("is-running", "is-complete");
      currentStage = -1;

      nodes.forEach(function (n) {
        n.classList.remove("is-active", "is-done");
      });
      segs.forEach(function (s) {
        s.classList.remove("is-active", "is-done");
      });
      labels.forEach(function (l) {
        l.classList.remove("is-active", "is-done");
      });

      outputEl.innerHTML = "";
      var hint = document.createElement("span");
      hint.className = "tr-log__hint";
      hint.textContent = "Select a goal and start the workflow";
      outputEl.appendChild(hint);

      startBtn.hidden = false;
      resetBtn.hidden = true;
      updateUI();
    }

    goalBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        if (isRunning) return;
        selectedGoal = btn.dataset.goal;
        customInput.value = "";
        updateUI();
      });
    });

    customInput.addEventListener("input", function () {
      if (isRunning) return;
      var v = customInput.value.trim();
      if (v) {
        selectedGoal = "custom";
        goalBtns.forEach(function (b) {
          b.classList.remove("is-selected");
          b.setAttribute("aria-pressed", "false");
        });
      } else if (!root.querySelector(".tr-goal.is-selected")) {
        selectedGoal = null;
      }
      updateUI();
    });

    startBtn.addEventListener("click", function () {
      if (!selectedGoal || isRunning) return;
      outputEl.innerHTML = "";
      runWorkflow();
    });

    resetBtn.addEventListener("click", function () {
      resetWorkflow();
    });
  }

  initTaskRelay();
</script>
