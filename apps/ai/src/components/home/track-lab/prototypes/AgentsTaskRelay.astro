---
---

<div class="task-relay" data-task-relay hidden>
  <div class="tr-header">
    <div class="tr-goals" data-goals>
      <button class="tr-goal" data-goal="plan-event" type="button">Plan a society event</button>
      <button class="tr-goal" data-goal="research" type="button">Research a topic</button>
      <button class="tr-goal" data-goal="build" type="button">Build a prototype</button>
      <button class="tr-goal" data-goal="organise" type="button">Organise notes</button>
      <button class="tr-goal" data-goal="launch" type="button">Launch a project team</button>
    </div>
    <div class="tr-custom">
      <input
        class="tr-input"
        type="text"
        data-custom-goal
        placeholder="Or type a custom goal&#8230;"
        maxlength="100"
      />
      <button class="tr-start" data-action="start" type="button" disabled>
        Start Relay
      </button>
      <button class="tr-reset" data-action="reset" type="button" hidden>
        New Relay
      </button>
    </div>
  </div>

  <div class="tr-pipeline" data-pipeline>
    <div class="tr-track">
      <div class="tr-node" data-stage="0">&#x25C8;</div>
      <div class="tr-seg" data-seg="0"></div>
      <div class="tr-node" data-stage="1">&#x25C6;</div>
      <div class="tr-seg" data-seg="1"></div>
      <div class="tr-node" data-stage="2">&#x25B3;</div>
      <div class="tr-seg" data-seg="2"></div>
      <div class="tr-node" data-stage="3">&#x25B2;</div>
      <div class="tr-seg" data-seg="3"></div>
      <div class="tr-node" data-stage="4">&#x25C9;</div>
      <div class="tr-seg" data-seg="4"></div>
      <div class="tr-node" data-stage="5">&#x25C7;</div>
    </div>
    <div class="tr-labels">
      <span class="tr-label">Understand</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Research</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Plan</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Build</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Review</span>
      <span class="tr-label-gap"></span>
      <span class="tr-label">Present</span>
    </div>
    <div class="tr-agent" data-agent hidden>
      <div class="tr-agent__inner">
        <span class="tr-agent__mark">&#x26A1;</span>
        <span class="tr-agent__name" data-agent-name></span>
      </div>
    </div>
  </div>

  <div class="tr-log" data-output>
    <span class="tr-log__hint">Select a goal and start the relay</span>
  </div>
</div>

<style>
  .task-relay {
    --tr: var(--stage-accent, #22d3ee);
    --tr-dim: color-mix(in srgb, var(--tr) 12%, transparent);
    --tr-mid: color-mix(in srgb, var(--tr) 35%, transparent);

    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px;
    font-family: var(--font-sans);
    color: #cbd5e1;
    position: relative;
    overflow: hidden;
  }

  /* ── Header ─────────────────────────────────────── */

  .tr-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tr-goals {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .tr-goal {
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--tr) 12%, transparent);
    border-radius: 6px;
    background: transparent;
    color: #94a3b8;
    font-size: 0.67rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 180ms, background 180ms, border-color 180ms, box-shadow 180ms;
    font-family: var(--font-sans);
    white-space: nowrap;
    line-height: 1.4;
  }

  .tr-goal:hover {
    color: #cbd5e1;
    border-color: color-mix(in srgb, var(--tr) 25%, transparent);
  }

  .tr-goal:focus-visible {
    outline: 2px solid var(--tr);
    outline-offset: 2px;
  }

  .tr-goal.is-selected {
    color: var(--tr);
    background: var(--tr-dim);
    border-color: color-mix(in srgb, var(--tr) 40%, transparent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--tr) 10%, transparent);
  }

  .tr-goal:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .tr-custom {
    display: flex;
    gap: 6px;
  }

  .tr-input {
    flex: 1;
    min-width: 0;
    padding: 5px 10px;
    border: 1px solid rgba(148, 163, 184, 0.1);
    border-radius: 6px;
    background: rgba(5, 8, 16, 0.5);
    color: #cbd5e1;
    font-size: 0.67rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 180ms;
    line-height: 1.4;
  }

  .tr-input:focus {
    border-color: color-mix(in srgb, var(--tr) 35%, transparent);
  }

  .tr-input::placeholder {
    color: #475569;
  }

  .tr-input:disabled {
    opacity: 0.35;
  }

  .tr-start,
  .tr-reset {
    padding: 5px 14px;
    border: 1px solid color-mix(in srgb, var(--tr) 30%, transparent);
    border-radius: 6px;
    background: var(--tr-dim);
    color: var(--tr);
    font-size: 0.67rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 180ms, border-color 180ms, box-shadow 180ms;
    font-family: var(--font-sans);
    white-space: nowrap;
    line-height: 1.4;
  }

  .tr-start:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .tr-start:not(:disabled):hover,
  .tr-reset:hover {
    background: color-mix(in srgb, var(--tr) 18%, transparent);
    border-color: color-mix(in srgb, var(--tr) 50%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--tr) 12%, transparent);
  }

  .tr-start:focus-visible,
  .tr-reset:focus-visible {
    outline: 2px solid var(--tr);
    outline-offset: 2px;
  }

  /* ── Pipeline ───────────────────────────────────── */

  .tr-pipeline {
    position: relative;
    padding: 6px 0 0;
  }

  .tr-track {
    display: flex;
    align-items: center;
  }

  .tr-node {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border: 2px solid color-mix(in srgb, var(--tr) 14%, transparent);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--tr) 35%, #475569);
    background: rgba(5, 8, 16, 0.6);
    transition: border-color 350ms, color 350ms, background 350ms, box-shadow 350ms;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }

  .tr-node:hover {
    border-color: color-mix(in srgb, var(--tr) 30%, transparent);
  }

  .tr-node.is-active {
    border-color: var(--tr);
    color: var(--tr);
    background: var(--tr-dim);
    box-shadow: 0 0 18px color-mix(in srgb, var(--tr) 25%, transparent);
    animation: tr-pulse 1.4s ease-in-out infinite;
  }

  .tr-node.is-done {
    border-color: color-mix(in srgb, var(--tr) 45%, transparent);
    color: var(--tr);
    background: color-mix(in srgb, var(--tr) 12%, transparent);
  }

  .tr-node.is-delayed {
    animation: tr-delay-pulse 0.7s ease-in-out infinite !important;
    border-color: #fbbf24;
    box-shadow: 0 0 14px rgba(251, 191, 36, 0.25);
  }

  .tr-seg {
    flex: 1;
    height: 2px;
    background: color-mix(in srgb, var(--tr) 6%, transparent);
    transition: background 500ms ease;
    position: relative;
    z-index: 1;
  }

  .tr-seg.is-active {
    background: color-mix(in srgb, var(--tr) 40%, transparent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--tr) 15%, transparent);
  }

  .tr-seg.is-done {
    background: color-mix(in srgb, var(--tr) 30%, transparent);
  }

  .tr-labels {
    display: flex;
    margin-top: 4px;
  }

  .tr-label {
    flex-shrink: 0;
    width: 34px;
    text-align: center;
    font-size: 0.52rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #3e4c63;
    transition: color 350ms;
    line-height: 1.3;
  }

  .tr-label.is-active {
    color: var(--tr);
  }

  .tr-label.is-done {
    color: #64748b;
  }

  .tr-label-gap {
    flex: 1;
  }

  /* ── Agent card ─────────────────────────────────── */

  .tr-agent {
    position: absolute;
    top: -12px;
    left: 0;
    transform: translateX(-50%);
    transition: left 550ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
    pointer-events: none;
  }

  .tr-agent__inner {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px 3px 6px;
    background: color-mix(in srgb, var(--tr) 14%, rgba(5, 8, 16, 0.85));
    border: 1px solid color-mix(in srgb, var(--tr) 35%, transparent);
    border-radius: 7px;
    backdrop-filter: blur(8px);
    box-shadow: 0 0 22px color-mix(in srgb, var(--tr) 18%, transparent);
    white-space: nowrap;
  }

  .tr-agent__mark {
    font-size: 0.72rem;
    line-height: 1;
  }

  .tr-agent__name {
    font-size: 0.58rem;
    font-weight: 700;
    color: var(--tr);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tr-agent.is-complete .tr-agent__inner {
    background: color-mix(in srgb, var(--tr) 20%, rgba(5, 8, 16, 0.85));
    border-color: color-mix(in srgb, var(--tr) 50%, transparent);
    box-shadow: 0 0 30px color-mix(in srgb, var(--tr) 25%, transparent);
  }

  .tr-agent.is-complete .tr-agent__mark {
    color: #4ade80;
  }

  /* ── Log ────────────────────────────────────────── */

  .tr-log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 3px;
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.12) transparent;
  }

  .tr-log::-webkit-scrollbar {
    width: 3px;
  }

  .tr-log::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.12);
    border-radius: 2px;
  }

  .tr-log__hint {
    color: #3e4c63;
    font-size: 0.62rem;
    font-style: italic;
  }

  .tr-entry {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 0.62rem;
    line-height: 1.45;
    animation: tr-fadein 350ms ease both;
    padding: 2px 0;
  }

  .tr-entry__status {
    flex-shrink: 0;
    width: 12px;
    text-align: center;
    font-weight: 700;
  }

  .tr-entry__agent {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--tr);
    flex-shrink: 0;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    min-width: 52px;
  }

  .tr-entry__text {
    color: #94a3b8;
    min-width: 0;
  }

  .tr-entry.is-current .tr-entry__status {
    color: var(--tr);
  }

  .tr-entry.is-current .tr-entry__text {
    color: #cbd5e1;
  }

  .tr-entry.is-done .tr-entry__status {
    color: #4ade80;
  }

  .tr-entry.is-done .tr-entry__text {
    color: #94a3b8;
  }

  .tr-entry.is-current::after {
    content: "\258A";
    animation: tr-blink 1s step-end infinite;
    color: var(--tr);
    margin-left: 3px;
    font-size: 0.58rem;
    flex-shrink: 0;
  }

  .tr-log__complete {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    font-size: 0.62rem;
    font-weight: 700;
    color: #4ade80;
    animation: tr-fadein 500ms ease both;
  }

  .tr-log__complete-mark {
    font-size: 0.72rem;
  }

  /* ── Completion glow ────────────────────────────── */

  .task-relay.is-complete .tr-pipeline {
    animation: tr-glow 800ms ease;
  }

  /* ── Keyframes ──────────────────────────────────── */

  @keyframes tr-pulse {
    0%,
    100% {
      box-shadow: 0 0 12px color-mix(in srgb, var(--tr) 15%, transparent);
    }
    50% {
      box-shadow: 0 0 26px color-mix(in srgb, var(--tr) 35%, transparent);
    }
  }

  @keyframes tr-delay-pulse {
    0%,
    100% {
      box-shadow: 0 0 10px rgba(251, 191, 36, 0.15);
      border-color: rgba(251, 191, 36, 0.4);
    }
    50% {
      box-shadow: 0 0 22px rgba(251, 191, 36, 0.35);
      border-color: rgba(251, 191, 36, 0.65);
    }
  }

  @keyframes tr-fadein {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tr-blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes tr-glow {
    0% {
      filter: brightness(1);
    }
    40% {
      filter: brightness(1.25);
    }
    100% {
      filter: brightness(1);
    }
  }

  /* ── Responsive ─────────────────────────────────── */

  @media (max-width: 768px) {
    .task-relay {
      padding: 10px 12px;
      gap: 8px;
    }

    .tr-goal {
      padding: 3px 8px;
      font-size: 0.6rem;
    }

    .tr-node {
      width: 28px;
      height: 28px;
      font-size: 0.68rem;
      border-radius: 7px;
    }

    .tr-label {
      width: 28px;
      font-size: 0.46rem;
    }

    .tr-agent__inner {
      padding: 2px 8px 2px 5px;
    }

    .tr-agent__name {
      font-size: 0.52rem;
    }

    .tr-entry {
      font-size: 0.56rem;
    }

    .tr-entry__agent {
      font-size: 0.52rem;
      min-width: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .task-relay *,
    .task-relay *::before,
    .task-relay *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initTaskRelay() {
    var root = document.querySelector("[data-task-relay]");
    if (!root) return;

    var slot = document.querySelector('[data-proto-slot="agents"]');
    if (slot && !slot.contains(root)) {
      while (slot.firstChild) slot.removeChild(slot.firstChild);
      slot.appendChild(root);
    }
    root.removeAttribute("hidden");

    var AGENTS = ["Analyst", "Scholar", "Architect", "Builder", "Critic", "Speaker"];
    var STAGE_MS = 1800;
    var DELAY_MS = 3000;

    var GOAL_OUTPUTS = {
      "plan-event": [
        "Scope: social mixer, 50\u201380 students, \u00A3200 budget, 3 weeks",
        "3 venues found. Similar events: 65 avg attendance. 2 caterers quoted",
        "Wk 1: book venue + poster \u2192 Wk 2: promote \u2192 Wk 3: finalise + run",
        "Poster done. Campaign scheduled. Venue booked. RSVP form live",
        "On schedule. Budget OK. Added day-5 nudge for low RSVP risk",
        "Plan packaged with timeline visual. Ready for committee approval",
      ],
      research: [
        "Topic scoped. Key question identified. Information gaps mapped",
        "12 sources found: 4 papers, 3 blogs, 5 docs. Ranked by relevance",
        "Structure: intro \u2192 findings \u2192 analysis \u2192 conclusion. Sources prioritised",
        "Draft compiled with 8 citations. Counterarguments addressed",
        "3 claims fact-checked. 2 arguments strengthened. Context gaps filled",
        "Summary polished. Key insights highlighted. Ready to share",
      ],
      build: [
        "Scope: web component. Core feature mapped. Constraints noted",
        "3 frameworks evaluated. Existing solutions analysed. Architecture planned",
        "Modular design chosen. Tech stack set. Build phases defined",
        "Core module shipped. API wired. UI rendered. Tests green",
        "Perf benchmarked. 2 edge cases fixed. A11y audit passed",
        "Demo ready. Docs written. Staged. Ready for showcase",
      ],
      organise: [
        "47 notes scanned. 4 topics, 12 sub-topics. 3 priority areas",
        "Tag taxonomy designed. Cross-refs mapped. Orphans flagged",
        "Folders: topic-based. Tags: hierarchical. Flow: capture \u2192 process \u2192 archive",
        "All 47 notes sorted. Tags applied. Cross-references linked",
        "12 re-categorised. 3 duplicates merged. Dead links pruned",
        "Notebook exported. Quick-ref guide generated. Search indexed",
      ],
      launch: [
        "Team 4\u20136. Project: AI tool. Timeline: 8 weeks. 4 skill areas",
        "4 candidates matched. 3 past projects studied. Roles templated",
        "Roles assigned. Sprints planned. Channels opened. Kick-off drafted",
        "Repo created. Board configured. Docs written. Sprint 1 queued",
        "Alignment confirmed. Dependencies mapped. Risk register live",
        "Charter signed. Roadmap visualised. Kick-off scheduled",
      ],
    };

    var GENERIC_OUTPUTS = [
      "Goal decomposed. Key requirements surfaced. Constraints noted",
      "Background research complete. 5 relevant sources catalogued",
      "Action plan: 4 phases, clear milestones, dependencies mapped",
      "Core deliverables produced. Components assembled and verified",
      "Output reviewed against spec. 2 refinements applied",
      "Package finalised. Results documented. Ready for delivery",
    ];

    var selectedGoal = null;
    var isRunning = false;
    var currentStage = -1;
    var delays = new Set();

    var goalBtns = root.querySelectorAll("[data-goal]");
    var customInput = root.querySelector("[data-custom-goal]");
    var startBtn = root.querySelector('[data-action="start"]');
    var resetBtn = root.querySelector('[data-action="reset"]');
    var nodes = root.querySelectorAll("[data-stage]");
    var segs = root.querySelectorAll("[data-seg]");
    var labels = root.querySelectorAll(".tr-label");
    var agentEl = root.querySelector("[data-agent]");
    var agentName = root.querySelector("[data-agent-name]");
    var outputEl = root.querySelector("[data-output]");
    var pipelineEl = root.querySelector("[data-pipeline]");

    function sleep(ms) {
      return new Promise(function (r) {
        setTimeout(r, ms);
      });
    }

    function updateUI() {
      var hasGoal = selectedGoal !== null;
      startBtn.disabled = !hasGoal || isRunning;

      goalBtns.forEach(function (btn) {
        var match = btn.dataset.goal === selectedGoal;
        btn.classList.toggle("is-selected", match);
        btn.disabled = isRunning;
      });

      customInput.disabled = isRunning;
    }

    function updateLabel(idx, cls) {
      if (labels[idx]) {
        labels[idx].classList.remove("is-active", "is-done");
        if (cls) labels[idx].classList.add(cls);
      }
    }

    function positionAgent(idx) {
      var node = nodes[idx];
      if (!node || !pipelineEl) return;
      var nr = node.getBoundingClientRect();
      var pr = pipelineEl.getBoundingClientRect();
      var cx = nr.left - pr.left + nr.width / 2;
      agentEl.style.left = cx + "px";
    }

    function recalcAgent() {
      if (currentStage >= 0) positionAgent(currentStage);
    }

    function getOutput(goalKey, stageIdx) {
      if (goalKey === "custom") return GENERIC_OUTPUTS[stageIdx] || "";
      var bank = GOAL_OUTPUTS[goalKey];
      if (bank) return bank[stageIdx] || "";
      return GENERIC_OUTPUTS[stageIdx] || "";
    }

    function clearLogExtras() {
      var hint = outputEl.querySelector(".tr-log__hint");
      if (hint) hint.remove();
      var completeMsg = outputEl.querySelector(".tr-log__complete");
      if (completeMsg) completeMsg.remove();
    }

    function addLogEntry(idx, text, isCurrent) {
      clearLogExtras();

      var div = document.createElement("div");
      div.className = "tr-entry" + (isCurrent ? " is-current" : " is-done");
      div.dataset.entry = String(idx);

      var statusSpan = document.createElement("span");
      statusSpan.className = "tr-entry__status";
      statusSpan.textContent = isCurrent ? "\u25B6" : "\u2713";

      var agentSpan = document.createElement("span");
      agentSpan.className = "tr-entry__agent";
      agentSpan.textContent = AGENTS[idx];

      var textSpan = document.createElement("span");
      textSpan.className = "tr-entry__text";
      textSpan.textContent = text;

      div.appendChild(statusSpan);
      div.appendChild(agentSpan);
      div.appendChild(textSpan);

      outputEl.appendChild(div);
      outputEl.scrollTop = outputEl.scrollHeight;
    }

    function markEntryDone(idx) {
      var entry = outputEl.querySelector('[data-entry="' + idx + '"]');
      if (!entry) return;
      entry.classList.remove("is-current");
      entry.classList.add("is-done");
      var status = entry.querySelector(".tr-entry__status");
      if (status) status.textContent = "\u2713";
    }

    function addCompleteMsg() {
      clearLogExtras();
      var div = document.createElement("div");
      div.className = "tr-log__complete";

      var mark = document.createElement("span");
      mark.className = "tr-log__complete-mark";
      mark.textContent = "\u2713";

      var txt = document.createElement("span");
      txt.textContent = "Relay complete \u2014 6 stages passed";

      div.appendChild(mark);
      div.appendChild(txt);
      outputEl.appendChild(div);
      outputEl.scrollTop = outputEl.scrollHeight;
    }

    async function callAI(goal, stageIdx) {
      try {
        var lab = document.querySelector("[data-track-lab]");
        var aiOn =
          (lab && lab.dataset.aiEnabled === "true") ||
          document.documentElement.dataset.aiEnabled === "true";
        if (!aiOn) return null;

        var ctrl = new AbortController();
        var tid = setTimeout(function () {
          ctrl.abort();
        }, 5000);

        var res = await fetch("/api/ai/track-lab", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            feature: "task-relay",
            goal: goal,
            stage: stageIdx,
          }),
          signal: ctrl.signal,
        });

        clearTimeout(tid);
        if (!res.ok) return null;
        var data = await res.json();
        return (data && data.output) || null;
      } catch (e) {
        return null;
      }
    }

    async function runStage(idx) {
      currentStage = idx;

      nodes[idx].classList.add("is-active");
      updateLabel(idx, "is-active");
      if (idx > 0) segs[idx - 1].classList.add("is-active");

      positionAgent(idx);
      agentName.textContent = AGENTS[idx];

      var goalKey =
        selectedGoal === "custom" ? "custom" : selectedGoal || "custom";
      var aiResult = await callAI(goalKey, idx);
      var text = aiResult || getOutput(goalKey, idx);

      addLogEntry(idx, text, true);

      if (delays.has(idx)) {
        nodes[idx].classList.add("is-delayed");
        await sleep(DELAY_MS);
        nodes[idx].classList.remove("is-delayed");
        delays.delete(idx);
      }

      await sleep(STAGE_MS);

      nodes[idx].classList.remove("is-active");
      nodes[idx].classList.add("is-done");
      updateLabel(idx, "is-done");
      if (idx > 0) {
        segs[idx - 1].classList.remove("is-active");
        segs[idx - 1].classList.add("is-done");
      }

      markEntryDone(idx);
    }

    async function runRelay() {
      isRunning = true;
      root.classList.add("is-running");
      updateUI();

      agentEl.hidden = false;
      agentEl.classList.remove("is-complete");

      for (var i = 0; i < 6; i++) {
        await runStage(i);
      }

      completeRelay();
    }

    function completeRelay() {
      root.classList.add("is-complete");
      agentEl.classList.add("is-complete");
      agentName.textContent = "DONE";

      addCompleteMsg();

      startBtn.hidden = true;
      resetBtn.hidden = false;
      isRunning = false;
    }

    function resetRelay() {
      root.classList.remove("is-running", "is-complete");
      agentEl.hidden = true;
      agentEl.classList.remove("is-complete");
      agentEl.style.left = "0";
      currentStage = -1;
      delays.clear();

      nodes.forEach(function (n) {
        n.classList.remove("is-active", "is-done", "is-delayed");
      });
      segs.forEach(function (s) {
        s.classList.remove("is-active", "is-done");
      });
      labels.forEach(function (l) {
        l.classList.remove("is-active", "is-done");
      });

      outputEl.innerHTML = "";
      var hint = document.createElement("span");
      hint.className = "tr-log__hint";
      hint.textContent = "Select a goal and start the relay";
      outputEl.appendChild(hint);

      startBtn.hidden = false;
      resetBtn.hidden = true;
      updateUI();
    }

    goalBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        if (isRunning) return;
        selectedGoal = btn.dataset.goal;
        customInput.value = "";
        updateUI();
      });
    });

    customInput.addEventListener("input", function () {
      if (isRunning) return;
      var v = customInput.value.trim();
      if (v) {
        selectedGoal = "custom";
        goalBtns.forEach(function (b) {
          return b.classList.remove("is-selected");
        });
      } else if (!root.querySelector(".tr-goal.is-selected")) {
        selectedGoal = null;
      }
      updateUI();
    });

    startBtn.addEventListener("click", function () {
      if (!selectedGoal || isRunning) return;
      outputEl.innerHTML = "";
      runRelay();
    });

    resetBtn.addEventListener("click", function () {
      resetRelay();
    });

    nodes.forEach(function (node) {
      node.addEventListener("click", function () {
        var idx = parseInt(node.dataset.stage, 10);
        if (!isRunning || idx < currentStage) return;
        if (delays.has(idx)) {
          delays.delete(idx);
          node.classList.remove("is-delayed");
        } else {
          delays.add(idx);
          node.classList.add("is-delayed");
        }
      });

      node.setAttribute("title", "Click to inject a delay during relay");
    });

    window.addEventListener("resize", recalcAgent);
  }

  initTaskRelay();
</script>
