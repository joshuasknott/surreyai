---
---

<div class="ethics-compass" data-track-prototype="ethics" role="region" aria-label="AI Ethics Impact Compass">
  <div class="ec__layout">
    <div class="ec__visual">
      <div class="ec__body">
        <svg class="ec__svg" viewBox="0 0 500 440" aria-hidden="true">
          <circle class="ec__ring ec__ring--outer" cx="250" cy="200" r="175" />
          <circle class="ec__ring ec__ring--main" cx="250" cy="200" r="140" />
          <circle class="ec__ring ec__ring--inner" cx="250" cy="200" r="70" />
          
          <g class="ec__ticks"></g>
          
          <g class="ec__spokes">
            <line class="ec__spoke" data-dim="fairness" x1="250" y1="200" x2="250" y2="60" />
            <line class="ec__spoke" data-dim="privacy" x1="250" y1="200" x2="371" y2="130" />
            <line class="ec__spoke" data-dim="accountability" x1="250" y1="200" x2="371" y2="270" />
            <line class="ec__spoke" data-dim="safety" x1="250" y1="200" x2="250" y2="340" />
            <line class="ec__spoke" data-dim="bias" x1="250" y1="200" x2="129" y2="270" />
            <line class="ec__spoke" data-dim="usefulness" x1="250" y1="200" x2="129" y2="130" />
          </g>
          
          <polygon class="ec__polygon" points="" />
          
          <g class="ec__dim" data-dim="fairness" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0" aria-valuetext="not weighted" aria-label="Fairness weight">
            <circle class="ec__dim-glow" cx="250" cy="60" r="32" />
            <circle class="ec__dim-ring" cx="250" cy="60" r="16" />
            <circle class="ec__dim-dot" cx="250" cy="60" r="6" />
            <text class="ec__dim-text" x="250" y="30" text-anchor="middle">Fairness</text>
            <text class="ec__dim-val" x="250" y="86" text-anchor="middle"></text>
          </g>
          <g class="ec__dim" data-dim="privacy" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0" aria-valuetext="not weighted" aria-label="Privacy weight">
            <circle class="ec__dim-glow" cx="371" cy="130" r="32" />
            <circle class="ec__dim-ring" cx="371" cy="130" r="16" />
            <circle class="ec__dim-dot" cx="371" cy="130" r="6" />
            <text class="ec__dim-text" x="395" y="134" text-anchor="start">Privacy</text>
            <text class="ec__dim-val" x="395" y="152" text-anchor="start"></text>
          </g>
          <g class="ec__dim" data-dim="accountability" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0" aria-valuetext="not weighted" aria-label="Accountability weight">
            <circle class="ec__dim-glow" cx="371" cy="270" r="32" />
            <circle class="ec__dim-ring" cx="371" cy="270" r="16" />
            <circle class="ec__dim-dot" cx="371" cy="270" r="6" />
            <text class="ec__dim-text" x="395" y="274" text-anchor="start">Accountability</text>
            <text class="ec__dim-val" x="395" y="292" text-anchor="start"></text>
          </g>
          <g class="ec__dim" data-dim="safety" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0" aria-valuetext="not weighted" aria-label="Safety weight">
            <circle class="ec__dim-glow" cx="250" cy="340" r="32" />
            <circle class="ec__dim-ring" cx="250" cy="340" r="16" />
            <circle class="ec__dim-dot" cx="250" cy="340" r="6" />
            <text class="ec__dim-text" x="250" y="378" text-anchor="middle">Safety</text>
            <text class="ec__dim-val" x="250" y="396" text-anchor="middle"></text>
          </g>
          <g class="ec__dim" data-dim="bias" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0" aria-valuetext="not weighted" aria-label="Bias weight">
            <circle class="ec__dim-glow" cx="129" cy="270" r="32" />
            <circle class="ec__dim-ring" cx="129" cy="270" r="16" />
            <circle class="ec__dim-dot" cx="129" cy="270" r="6" />
            <text class="ec__dim-text" x="105" y="274" text-anchor="end">Bias</text>
            <text class="ec__dim-val" x="105" y="292" text-anchor="end"></text>
          </g>
          <g class="ec__dim" data-dim="usefulness" tabindex="0" role="slider" aria-valuemin="0" aria-valuemax="3" aria-valuenow="0" aria-valuetext="not weighted" aria-label="Usefulness weight">
            <circle class="ec__dim-glow" cx="129" cy="130" r="32" />
            <circle class="ec__dim-ring" cx="129" cy="130" r="16" />
            <circle class="ec__dim-dot" cx="129" cy="130" r="6" />
            <text class="ec__dim-text" x="105" y="134" text-anchor="end">Usefulness</text>
            <text class="ec__dim-val" x="105" y="152" text-anchor="end"></text>
          </g>
        </svg>
        <div class="ec__center" aria-hidden="true">
          <span class="ec__center-title">Impact Compass</span>
          <span class="ec__center-sub">Adjust priorities</span>
        </div>
      </div>
      <div class="ec__scenarios" role="group" aria-label="Workshop scenarios">
        <button class="ec__btn" type="button" data-scenario="marking" aria-pressed="false">AI Marking</button>
        <button class="ec__btn" type="button" data-scenario="transcription" aria-pressed="false">Lecture Transcription</button>
        <button class="ec__btn" type="button" data-scenario="internships" aria-pressed="false">Hiring Internships</button>
        <button class="ec__btn" type="button" data-scenario="triage" aria-pressed="false">Healthcare Triage</button>
        <button class="ec__btn" type="button" data-scenario="coursework" aria-pressed="false">Creative Coursework</button>
        <button class="ec__btn" type="button" data-scenario="safety" aria-pressed="false">Campus Safety</button>
      </div>
    </div>
    
    <div class="ec__panel">
      <div class="ec__panel-header">
        <h3 class="ec__panel-title">Ethics Assessment</h3>
        <button class="ec__btn ec__btn--primary" type="button" data-action="assess">Run Assessment</button>
      </div>
      
      <div class="ec__results-box">
        <div class="ec__loading" style="display: none;">
          <div class="ec__spinner"></div>
          <span>Analyzing scenario impacts...</span>
        </div>
        
        <div class="ec__results-content" aria-live="polite">
          <div class="ec__empty-state">
            <p>Select a scenario and adjust dimension weights, then run the assessment to generate ethical tradeoffs and safeguards.</p>
          </div>
        </div>
        <div class="ec__source" style="display: none;"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .ethics-compass {
    --ec-text-main: var(--ai-text-main, #0F172A);
    --ec-text-muted: var(--ai-text-muted, #475569);
    --ec-text-faint: var(--ai-text-faint, #94A3B8);
    --ec-accent: var(--ai-primary, #3B82F6);
    --ec-bg-hover: var(--ai-bg-hover, rgba(59, 130, 246, 0.08));
    --ec-bg-active: var(--ai-bg-active, rgba(59, 130, 246, 0.15));
    --ec-border: var(--ai-border, rgba(148, 163, 184, 0.2));
    --ec-surface: var(--ai-surface, #ffffff);
    
    width: 100%;
    height: 100%;
    font-family: var(--font-sans, system-ui, sans-serif);
    box-sizing: border-box;
    padding: 24px;
    background: var(--ai-bg, transparent);
  }

  :global([data-theme="dark"]) .ethics-compass {
    --ec-text-main: var(--ai-text-main, #F8FAFC);
    --ec-text-muted: var(--ai-text-muted, #94A3B8);
    --ec-text-faint: var(--ai-text-faint, #475569);
    --ec-accent: var(--ai-primary, #60A5FA);
    --ec-bg-hover: var(--ai-bg-hover, rgba(96, 165, 250, 0.12));
    --ec-bg-active: var(--ai-bg-active, rgba(96, 165, 250, 0.2));
    --ec-border: var(--ai-border, rgba(148, 163, 184, 0.2));
    --ec-surface: var(--ai-surface, #1e293b);
  }

  .ec__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    height: 100%;
    align-items: start;
  }

  @media (max-width: 900px) {
    .ec__layout {
      grid-template-columns: 1fr;
    }
  }

  .ec__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .ec__body {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1;
  }

  .ec__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ec__ring {
    fill: none;
    stroke: var(--ec-accent);
  }

  .ec__ring--outer {
    stroke-opacity: 0.08;
    stroke-width: 1;
    stroke-dasharray: 4 12;
    transform-origin: 250px 200px;
  }

  .ec__ring--main {
    stroke-opacity: 0.2;
    stroke-width: 1.5;
  }

  .ec__ring--inner {
    stroke-opacity: 0.1;
    stroke-width: 0.75;
  }

  .ec__tick {
    stroke: var(--ec-accent);
    stroke-width: 1;
  }

  .ec__tick--major {
    stroke-width: 1.5;
  }

  .ec__spoke {
    stroke: var(--ec-accent);
    stroke-opacity: 0;
    stroke-width: 1.5;
    transition: stroke-opacity 400ms ease;
  }

  .ec__spoke.is-active {
    stroke-opacity: 0.15;
  }

  .ec__polygon {
    fill: var(--ec-accent);
    fill-opacity: 0;
    stroke: var(--ec-accent);
    stroke-opacity: 0;
    stroke-width: 2;
    stroke-linejoin: round;
    transition: fill-opacity 600ms ease, stroke-opacity 600ms ease, points 400ms ease;
  }

  .ec__polygon.is-active {
    fill-opacity: 0.12;
    stroke-opacity: 0.4;
  }

  .ec__dim {
    cursor: pointer;
    outline: none;
  }

  .ec__dim-glow {
    fill: var(--ec-accent);
    fill-opacity: 0;
    transition: fill-opacity 300ms ease;
  }

  .ec__dim-ring {
    fill: none;
    stroke: var(--ec-accent);
    stroke-opacity: 0;
    stroke-width: 1.5;
    transition: stroke-opacity 300ms ease, r 300ms ease;
  }

  .ec__dim-dot {
    fill: var(--ec-accent);
    fill-opacity: 0.25;
    transition: fill-opacity 300ms ease, r 300ms ease;
  }

  .ec__dim-text {
    fill: var(--ec-text-faint);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: fill 300ms ease, font-size 300ms ease;
    pointer-events: none;
    user-select: none;
  }
  
  .ec__dim-val {
    fill: var(--ec-text-faint);
    fill-opacity: 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: fill-opacity 300ms ease, fill 300ms ease;
    pointer-events: none;
    user-select: none;
  }

  .ec__dim:hover .ec__dim-dot {
    fill-opacity: 0.5;
    r: 8;
  }

  .ec__dim:focus-visible .ec__dim-ring {
    stroke-opacity: 0.8;
    stroke-width: 2;
  }
  
  .ec__dim:focus-visible .ec__dim-text {
    fill: var(--ec-text-main);
  }

  .ec__dim[data-level="1"] .ec__dim-dot { fill-opacity: 0.5; r: 7; }
  .ec__dim[data-level="1"] .ec__dim-glow { fill-opacity: 0.04; }
  .ec__dim[data-level="1"] .ec__dim-ring { stroke-opacity: 0.25; r: 18; }
  .ec__dim[data-level="1"] .ec__dim-text { fill: var(--ec-text-muted); font-size: 14px; }
  .ec__dim[data-level="1"] .ec__dim-val { fill: var(--ec-text-muted); fill-opacity: 0.6; }

  .ec__dim[data-level="2"] .ec__dim-dot { fill-opacity: 0.75; r: 9; }
  .ec__dim[data-level="2"] .ec__dim-glow { fill-opacity: 0.08; }
  .ec__dim[data-level="2"] .ec__dim-ring { stroke-opacity: 0.4; r: 21; }
  .ec__dim[data-level="2"] .ec__dim-text { fill: var(--ec-text-main); font-size: 15px; }
  .ec__dim[data-level="2"] .ec__dim-val { fill: var(--ec-text-main); fill-opacity: 0.8; }

  .ec__dim[data-level="3"] .ec__dim-dot { fill-opacity: 1; r: 12; }
  .ec__dim[data-level="3"] .ec__dim-glow { fill-opacity: 0.12; }
  .ec__dim[data-level="3"] .ec__dim-ring { stroke-opacity: 0.6; r: 26; }
  .ec__dim[data-level="3"] .ec__dim-text { fill: var(--ec-text-main); font-size: 16px; font-weight: 700; }
  .ec__dim[data-level="3"] .ec__dim-val { fill: var(--ec-text-main); fill-opacity: 1; }

  .ec__center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
    width: 120px;
    margin-top: -20px;
  }

  .ec__center-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--ec-text-main);
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .ec__center-sub {
    display: block;
    font-size: 0.7rem;
    color: var(--ec-text-muted);
    margin-top: 4px;
    line-height: 1.4;
  }

  .ec__scenarios {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .ec__btn {
    padding: 8px 16px;
    border: 1px solid var(--ec-border);
    border-radius: 999px;
    background: transparent;
    color: var(--ec-text-muted);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .ec__btn:hover:not(:disabled) {
    color: var(--ec-text-main);
    border-color: var(--ec-accent);
    background: var(--ec-bg-hover);
  }

  .ec__btn:focus-visible {
    outline: 2px solid var(--ec-accent);
    outline-offset: 2px;
  }

  .ec__btn.is-active {
    color: var(--ec-text-main);
    background: var(--ec-bg-active);
    border-color: var(--ec-accent);
  }
  
  .ec__btn--primary {
    background: var(--ec-accent);
    color: white;
    border-color: var(--ec-accent);
  }
  
  .ec__btn--primary:hover:not(:disabled) {
    background: color-mix(in srgb, var(--ec-accent) 80%, black);
    color: white;
  }
  
  .ec__btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ec__panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    min-height: 400px;
  }
  
  .ec__panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--ec-border);
    padding-bottom: 12px;
  }
  
  .ec__panel-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--ec-text-main);
    margin: 0;
  }

  .ec__results-box {
    background: var(--ec-surface);
    border: 1px solid var(--ec-border);
    border-radius: 12px;
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-y: auto;
  }
  
  .ec__empty-state {
    color: var(--ec-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    text-align: center;
    margin: auto;
    max-width: 300px;
  }

  .ec__loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    height: 100%;
    color: var(--ec-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .ec__spinner {
    width: 24px;
    height: 24px;
    border: 3px solid var(--ec-border);
    border-top-color: var(--ec-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .ec__result-section {
    margin-bottom: 24px;
  }
  
  .ec__result-section:last-child {
    margin-bottom: 0;
  }

  .ec__result-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ec-text-main);
    margin: 0 0 12px 0;
  }

  .ec__result-text {
    font-size: 0.95rem;
    color: var(--ec-text-muted);
    line-height: 1.6;
    margin: 0;
  }
  
  .ec__result-list {
    margin: 0;
    padding-left: 20px;
    color: var(--ec-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  
  .ec__result-list li {
    margin-bottom: 8px;
  }

  .ec__source {
    font-size: 0.75rem;
    color: var(--ec-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--ec-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .ethics-compass *,
    .ethics-compass *::before,
    .ethics-compass *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const root = document.querySelector("[data-track-prototype=\"ethics\"]");
  if (root) {
    const CX = 250;
    const CY = 200;
    const DIMS = ["fairness", "privacy", "accountability", "safety", "bias", "usefulness"];
    
    const NODE_POS: Record<string, { x: number; y: number }> = {
      fairness: { x: 250, y: 60 },
      privacy: { x: 371, y: 130 },
      accountability: { x: 371, y: 270 },
      safety: { x: 250, y: 340 },
      bias: { x: 129, y: 270 },
      usefulness: { x: 129, y: 130 },
    };
    
    const LEVEL_LABELS = ["not weighted", "low", "medium", "high"];

    const SCENARIOS: Record<string, { label: string; impacts: Record<string, number> }> = {
      marking: { label: "AI Marking", impacts: { fairness: 3, privacy: 2, accountability: 3, safety: 1, bias: 3, usefulness: 3 } },
      transcription: { label: "Lecture Transcription", impacts: { fairness: 1, privacy: 1, accountability: 1, safety: 1, bias: 2, usefulness: 3 } },
      internships: { label: "Hiring Internships", impacts: { fairness: 3, privacy: 3, accountability: 2, safety: 1, bias: 3, usefulness: 2 } },
      triage: { label: "Healthcare Triage", impacts: { fairness: 2, privacy: 3, accountability: 3, safety: 3, bias: 2, usefulness: 3 } },
      coursework: { label: "Creative Coursework", impacts: { fairness: 2, privacy: 1, accountability: 2, safety: 1, bias: 2, usefulness: 3 } },
      safety: { label: "Campus Safety", impacts: { fairness: 3, privacy: 3, accountability: 3, safety: 3, bias: 3, usefulness: 2 } },
    };

    let activeScenarioId: string | null = null;
    const weights: Record<string, number> = {};
    DIMS.forEach((d) => { weights[d] = 0; });

    const polygon = root.querySelector<SVGPolygonElement>(".ec__polygon");
    const dimGroups = Array.from(root.querySelectorAll<SVGGElement>(".ec__dim"));
    const spokes = Array.from(root.querySelectorAll<SVGLineElement>(".ec__spoke"));
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>(".ec__btn[data-scenario]"));
    const ticksGroup = root.querySelector<SVGGElement>(".ec__ticks");
    const assessBtn = root.querySelector<HTMLButtonElement>("[data-action='assess']");
    const contentBox = root.querySelector(".ec__results-content");
    const loadingBox = root.querySelector(".ec__loading");
    const sourceBox = root.querySelector<HTMLElement>(".ec__source");

    function buildTicks() {
      if (!ticksGroup) return;
      const svgNS = "http://www.w3.org/2000/svg";
      for (let i = 0; i < 24; i++) {
        const deg = (i * 15 - 90) * (Math.PI / 180);
        const isMajor = i % 6 === 0;
        const r1 = isMajor ? 150 : 154;
        const r2 = isMajor ? 168 : 162;
        const line = document.createElementNS(svgNS, "line");
        line.setAttribute("x1", String(CX + r1 * Math.cos(deg)));
        line.setAttribute("y1", String(CY + r1 * Math.sin(deg)));
        line.setAttribute("x2", String(CX + r2 * Math.cos(deg)));
        line.setAttribute("y2", String(CY + r2 * Math.sin(deg)));
        line.setAttribute("class", isMajor ? "ec__tick ec__tick--major" : "ec__tick");
        line.setAttribute("stroke-opacity", isMajor ? "0.3" : "0.15");
        ticksGroup.appendChild(line);
      }
    }

    function update() {
      const activeDims = DIMS.filter((d) => weights[d] > 0);

      if (polygon) {
        if (activeDims.length > 0) {
          const pts = DIMS.map((d) => {
            const weight = weights[d];
            if (weight === 0) return `${CX},${CY}`;
            const targetPos = NODE_POS[d];
            const t = weight / 3;
            const x = CX + (targetPos.x - CX) * t;
            const y = CY + (targetPos.y - CY) * t;
            return `${x},${y}`;
          }).join(" ");
          
          polygon.setAttribute("points", pts);
          polygon.classList.add("is-active");
        } else {
          polygon.classList.remove("is-active");
        }
      }

      dimGroups.forEach((g) => {
        const dim = g.dataset.dim!;
        const level = weights[dim];
        g.dataset.level = String(level);
        g.setAttribute("aria-valuenow", String(level));
        g.setAttribute("aria-valuetext", LEVEL_LABELS[level]);
        
        const valText = g.querySelector(".ec__dim-val");
        if (valText) {
          valText.textContent = level > 0 ? LEVEL_LABELS[level] : "";
        }
      });

      spokes.forEach((spoke) => {
        const dim = spoke.dataset.dim!;
        spoke.classList.toggle("is-active", weights[dim] > 0);
      });

      btns.forEach((btn) => {
        const isActive = btn.dataset.scenario === activeScenarioId;
        btn.classList.toggle("is-active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      });
      
      if (assessBtn) {
        assessBtn.disabled = activeDims.length === 0 && !activeScenarioId;
      }
    }

    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.scenario!;
        if (activeScenarioId === id) {
          activeScenarioId = null;
          DIMS.forEach((d) => { weights[d] = 0; });
        } else {
          activeScenarioId = id;
          const impacts = SCENARIOS[id].impacts;
          DIMS.forEach((d) => { weights[d] = impacts[d]; });
        }
        update();
      });
    });

    dimGroups.forEach((g) => {
      function cycleWeight() {
        const dim = g.dataset.dim!;
        weights[dim] = (weights[dim] + 1) % 4;
        activeScenarioId = null;
        update();
      }
      g.addEventListener("click", cycleWeight);
      g.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          cycleWeight();
        } else if (e.key === "ArrowUp" || e.key === "ArrowRight") {
          e.preventDefault();
          const dim = g.dataset.dim!;
          weights[dim] = Math.min(weights[dim] + 1, 3);
          activeScenarioId = null;
          update();
        } else if (e.key === "ArrowDown" || e.key === "ArrowLeft") {
          e.preventDefault();
          const dim = g.dataset.dim!;
          weights[dim] = Math.max(weights[dim] - 1, 0);
          activeScenarioId = null;
          update();
        }
      });
    });

    function isRecord(value: unknown): value is Record<string, unknown> {
      return typeof value === "object" && value !== null && !Array.isArray(value);
    }

    function cleanText(value: unknown, maxLength: number): string {
      const text = typeof value === "string" || typeof value === "number" || typeof value === "boolean"
        ? String(value)
        : "";
      const normalized = text.replace(/\s+/g, " ").trim();
      return normalized.length <= maxLength ? normalized : `${normalized.slice(0, maxLength - 3).trimEnd()}...`;
    }

    function cleanArray(value: unknown, maxItems: number, maxLength: number): string[] {
      if (!Array.isArray(value)) return [];
      return value.map((item) => cleanText(item, maxLength)).filter(Boolean).slice(0, maxItems);
    }

    function normalizeEthicsOutput(value: unknown) {
      if (!isRecord(value)) return null;
      const output = {
        summary: cleanText(value.summary, 340),
        tradeoffs: cleanArray(value.tradeoffs, 5, 150),
        safeguards: cleanArray(value.safeguards, 5, 150),
        discussionQuestion: cleanText(value.discussionQuestion, 220),
      };
      return output.summary && output.discussionQuestion ? output : null;
    }

    function createEl(tag: string, className: string, text?: string): HTMLElement {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (text !== undefined) el.textContent = text;
      return el;
    }

    function appendTextSection(parent: Node, title: string, text: string) {
      const section = createEl("div", "ec__result-section");
      section.appendChild(createEl("h4", "ec__result-title", title));
      section.appendChild(createEl("p", "ec__result-text", text));
      parent.appendChild(section);
    }

    function appendListSection(parent: Node, title: string, items: string[]) {
      if (items.length === 0) return;
      const section = createEl("div", "ec__result-section");
      section.appendChild(createEl("h4", "ec__result-title", title));
      const list = createEl("ul", "ec__result-list");
      items.forEach((item) => list.appendChild(createEl("li", "", item)));
      section.appendChild(list);
      parent.appendChild(section);
    }

    function appendDiscussion(parent: Node, text: string) {
      const section = createEl("div", "ec__result-section");
      section.appendChild(createEl("h4", "ec__result-title", "Discussion Starter"));
      const p = createEl("p", "ec__result-text");
      const em = document.createElement("em");
      em.textContent = text;
      p.appendChild(em);
      section.appendChild(p);
      parent.appendChild(section);
    }

    function setEmptyMessage(message: string) {
      if (!contentBox) return;
      const empty = createEl("div", "ec__empty-state");
      empty.appendChild(createEl("p", "", message));
      contentBox.replaceChildren(empty);
    }

    function renderAssessment(output: ReturnType<typeof normalizeEthicsOutput>, source: unknown) {
      if (!contentBox || !output) throw new Error("Invalid output");
      const frag = document.createDocumentFragment();
      appendTextSection(frag, "Summary", output.summary);
      appendListSection(frag, "Key Tradeoffs", output.tradeoffs);
      appendListSection(frag, "Suggested Safeguards", output.safeguards);
      appendDiscussion(frag, output.discussionQuestion);
      contentBox.replaceChildren(frag);

      if (sourceBox) {
        sourceBox.textContent = `Generated by ${source === "ai" ? "Gemini AI" : "Deterministic Fallback"}`;
        sourceBox.style.display = "block";
      }
    }

    if (assessBtn) {
      assessBtn.addEventListener("click", async () => {
        if (assessBtn.disabled) return;
        
        let scenarioLabel = activeScenarioId ? SCENARIOS[activeScenarioId].label : "Custom Student Scenario";
        
        assessBtn.disabled = true;
        if (contentBox) (contentBox as HTMLElement).style.display = "none";
        if (sourceBox) sourceBox.style.display = "none";
        if (loadingBox) (loadingBox as HTMLElement).style.display = "flex";

        let timeout: ReturnType<typeof setTimeout> | undefined;
        try {
          const controller = new AbortController();
          timeout = setTimeout(() => controller.abort(), 6000);
          const res = await fetch("/api/ai/track-lab", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              feature: "ethics-assess",
              scenario: scenarioLabel,
              scores: weights,
            }),
            signal: controller.signal,
          });

          if (!res.ok) throw new Error("API error");
          const data = await res.json();
          const { source, output } = data;
          renderAssessment(normalizeEthicsOutput(output), source);
        } catch (err) {
          setEmptyMessage("Failed to generate assessment. Please try again.");
        } finally {
          if (timeout) clearTimeout(timeout);
          assessBtn.disabled = false;
          if (loadingBox) (loadingBox as HTMLElement).style.display = "none";
          if (contentBox) (contentBox as HTMLElement).style.display = "block";
        }
      });
    }

    buildTicks();
    update();
  }
</script>
