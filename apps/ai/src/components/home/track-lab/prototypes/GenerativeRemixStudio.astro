---
import type { AITrack } from "../../../../data/aiTracks";

interface Props {
  track: AITrack;
}

const { track } = Astro.props;

const seedIdeas = [
  "Study group tool",
  "Society poster",
  "Dissertation helper",
  "Campus event finder",
  "Revision plan",
  "Accessibility helper",
];

const modes = [
  { id: "sharpen", label: "Sharpen", icon: "-", tip: "Refine & clarify" },
  { id: "visual", label: "Visual", icon: "-^", tip: "Design direction" },
  { id: "project", label: "Project", icon: "-", tip: "Action plan" },
  { id: "beginner", label: "Beginner", icon: "-<", tip: "Simplify & explain" },
];
---

<div
  class="remix-studio"
  data-remix-studio
  style={`--remix-accent: ${track.accentColor}; --remix-accent-rgb: ${track.accentRgb};`}
>
  <div class="remix-studio__panel remix-studio__panel--input">
    <div class="remix-studio__header">
      <h3 class="remix-studio__title">Generative Remix Studio</h3>
      <p class="remix-studio__desc">
        Experience how Generative AI transforms rough ideas into actionable concepts, project briefs, and visual directions.
      </p>
    </div>

    <div class="remix-studio__input-group">
      <label class="remix-studio__label" for="remix-idea-input">Your Idea</label>
      <div class="remix-studio__field-wrapper">
        <input
          id="remix-idea-input"
          type="text"
          class="remix-studio__field"
          placeholder="Type a rough idea or pick one below..."
          data-remix-input
          autocomplete="off"
        />
        <button type="button" class="remix-studio__action" data-remix-action aria-label="Remix your idea">
          <span class="remix-studio__action-text" data-remix-action-text>Remix</span>
        </button>
      </div>
    </div>

    <div class="remix-studio__seeds" aria-label="Seed ideas">
      {seedIdeas.map((idea) => (
        <button type="button" class="remix-studio__seed" data-remix-seed>
          {idea}
        </button>
      ))}
    </div>

    <div class="remix-studio__modes" role="radiogroup" aria-label="Transform Mode">
      {modes.map((mode) => (
        <button
          type="button"
          role="radio"
          class={`remix-studio__mode${mode.id === "sharpen" ? " is-active" : ""}`}
          data-remix-mode={mode.id}
          aria-checked={mode.id === "sharpen" ? "true" : "false"}
          tabindex={mode.id === "sharpen" ? "0" : "-1"}
          title={mode.tip}
        >
          <span class="remix-studio__mode-icon" aria-hidden="true">{mode.icon}</span>
          <span>{mode.label}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="remix-studio__panel remix-studio__panel--output" data-remix-output-panel hidden>
    <div class="sr-only" aria-live="polite" data-remix-status></div>

    <div class="remix-studio__processing" data-remix-processing hidden>
      <div class="remix-studio__shimmer" aria-hidden="true"></div>
      <div class="remix-studio__shimmer remix-studio__shimmer--short" aria-hidden="true"></div>
      <div class="remix-studio__shimmer remix-studio__shimmer--mid" aria-hidden="true"></div>
      <span class="remix-studio__processing-label">Remixing your idea&hellip;</span>
    </div>

    <div class="remix-studio__card" data-remix-card hidden></div>
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .remix-studio {
    --rs-focus-ring: rgba(var(--remix-accent-rgb), 0.4);

    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    font-family: var(--font-sans);
    color: var(--ai-fg);
    background: transparent;
    box-sizing: border-box;
  }

  .remix-studio__panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .remix-studio__panel--output {
    background: var(--ai-surface);
    border-radius: 12px;
    padding: 16px;
    border: 1px solid var(--ai-border);
  }
  
  .remix-studio__panel--output[hidden] {
    display: none;
  }

  .remix-studio__header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .remix-studio__title {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--ai-fg);
    letter-spacing: -0.02em;
  }

  .remix-studio__desc {
    font-size: 0.95rem;
    color: var(--ai-fg-muted);
    line-height: 1.5;
    margin: 0;
  }

  .remix-studio__input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .remix-studio__label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ai-fg-muted);
  }

  .remix-studio__field-wrapper {
    display: flex;
    gap: 8px;
  }

  .remix-studio__field {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    background: var(--ai-bg);
    color: var(--ai-fg);
    font-size: 1rem;
    font-family: inherit;
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .remix-studio__field::placeholder {
    color: var(--ai-fg-muted);
    opacity: 0.7;
  }

  .remix-studio__field:focus-visible {
    border-color: var(--rs-focus-ring);
    box-shadow: 0 0 0 3px rgba(var(--remix-accent-rgb), 0.1);
  }

  .remix-studio__field:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .remix-studio__action {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: none;
    border-radius: 8px;
    background: var(--remix-accent);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: transform 150ms ease, box-shadow 200ms ease, opacity 200ms ease;
  }

  .remix-studio__action:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(var(--remix-accent-rgb), 0.3);
  }

  .remix-studio__action:active:not(:disabled) {
    transform: translateY(0);
  }

  .remix-studio__action:focus-visible {
    outline: 2px solid var(--remix-accent);
    outline-offset: 4px;
  }

  .remix-studio__action:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .remix-studio__seeds {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .remix-studio__seed {
    padding: 6px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 16px;
    background: var(--ai-surface);
    color: var(--ai-fg-muted);
    font-size: 0.85rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: all 180ms ease;
    white-space: nowrap;
  }

  .remix-studio__seed:hover:not(:disabled) {
    color: var(--ai-fg);
    border-color: rgba(var(--remix-accent-rgb), 0.4);
    background: rgba(var(--remix-accent-rgb), 0.05);
  }

  .remix-studio__seed:focus-visible {
    outline: 2px solid var(--rs-focus-ring);
    outline-offset: 2px;
  }

  .remix-studio__seed:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .remix-studio__modes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .remix-studio__mode {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    background: var(--ai-surface);
    color: var(--ai-fg-muted);
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: all 180ms ease;
    white-space: nowrap;
  }

  .remix-studio__mode:hover:not(:disabled) {
    color: var(--ai-fg);
    background: var(--ai-bg);
  }

  .remix-studio__mode[aria-checked="true"] {
    color: var(--remix-accent);
    border-color: rgba(var(--remix-accent-rgb), 0.4);
    background: rgba(var(--remix-accent-rgb), 0.1);
  }

  .remix-studio__mode:focus-visible {
    outline: 2px solid var(--rs-focus-ring);
    outline-offset: 2px;
  }

  .remix-studio__mode:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .remix-studio__mode-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  .remix-studio__processing {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  .remix-studio__shimmer {
    height: 16px;
    border-radius: 8px;
    background: linear-gradient(
      90deg,
      var(--ai-border),
      rgba(var(--remix-accent-rgb), 0.1),
      var(--ai-border)
    );
    background-size: 200% 100%;
    animation: remix-shimmer 2s ease-in-out infinite;
  }

  .remix-studio__shimmer--short {
    width: 60%;
  }

  .remix-studio__shimmer--mid {
    width: 80%;
  }

  .remix-studio__processing-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--remix-accent);
    text-align: center;
    margin-top: 12px;
    font-family: inherit;
    letter-spacing: 0.04em;
  }

  .remix-studio__card {
    position: relative;
    border-radius: 12px;
    background: var(--ai-bg);
    border: 1px solid var(--ai-border);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: remix-card-enter 450ms ease both;
  }

  .remix-studio__card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--remix-accent), transparent);
    border-radius: 12px 12px 0 0;
    opacity: 0.8;
  }

  /* Classes used via JavaScript */
  :global(.remix-studio__card-badge) {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--remix-accent);
    padding: 4px 8px;
    border: 1px solid rgba(var(--remix-accent-rgb), 0.3);
    border-radius: 6px;
    background: rgba(var(--remix-accent-rgb), 0.1);
    width: fit-content;
  }

  :global(.remix-studio__card-title) {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ai-fg);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  :global(.remix-studio__card-tagline) {
    font-size: 1rem;
    font-style: italic;
    color: var(--ai-fg-muted);
    line-height: 1.4;
  }

  :global(.remix-studio__card-source) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ai-fg-muted);
  }

  :global(.remix-studio__card-section) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    animation: remix-section-in 350ms ease both;
  }

  :global(.remix-studio__card-section-label) {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ai-fg-muted);
  }

  :global(.remix-studio__card-section ul),
  :global(.remix-studio__card-section ol) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :global(.remix-studio__card-section li) {
    font-size: 0.95rem;
    color: var(--ai-fg-muted);
    line-height: 1.4;
    padding-left: 14px;
    position: relative;
  }

  :global(.remix-studio__card-section li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(var(--remix-accent-rgb), 0.6);
  }

  :global(.remix-studio__card-section li strong) {
    color: var(--ai-fg);
    font-weight: 600;
  }

  :global(.remix-studio__card-section p),
  :global(.remix-studio__card-section > span:not(.remix-studio__card-section-label)) {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ai-fg-muted);
  }

  :global(.remix-studio__card-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  :global(.remix-studio__card-tag) {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--ai-surface);
    color: var(--ai-fg);
    border: 1px solid var(--ai-border);
  }

  :global(.remix-studio__swatches) {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  :global(.remix-studio__swatch-group) {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--ai-surface);
    padding: 4px 8px 4px 4px;
    border-radius: 20px;
    border: 1px solid var(--ai-border);
  }

  :global(.remix-studio__swatch-dot) {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
  }

  :global(.remix-studio__swatch-name) {
    font-size: 0.75rem;
    color: var(--ai-fg);
    font-weight: 500;
  }

  :global(.remix-studio__level-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  :global(.remix-studio__level-pip) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  :global(.remix-studio__level-pip--on) {
    background: var(--remix-accent);
  }

  :global(.remix-studio__level-pip--off) {
    background: var(--ai-border);
  }

  :global(.remix-studio__level-label) {
    font-size: 0.8rem;
    color: var(--ai-fg);
    font-weight: 500;
    margin-left: 4px;
  }

  @keyframes remix-shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  @keyframes remix-card-enter {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes remix-section-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .remix-studio *,
    .remix-studio *::before,
    .remix-studio *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script define:vars={{ accentColor: track.accentColor, accentRgb: track.accentRgb }}>
  (() => {
    const studio = document.querySelector("[data-remix-studio]");
    if (!studio) return;

    const inputEl = studio.querySelector("[data-remix-input]");
    const seedEls = studio.querySelectorAll("[data-remix-seed]");
    const modeEls = studio.querySelectorAll("[data-remix-mode]");
    const actionEl = studio.querySelector("[data-remix-action]");
    const actionTextEl = studio.querySelector("[data-remix-action-text]");
    const outputPanel = studio.querySelector("[data-remix-output-panel]");
    const processingEl = studio.querySelector("[data-remix-processing]");
    const cardEl = studio.querySelector("[data-remix-card]");
    const statusEl = studio.querySelector("[data-remix-status]");

    let currentMode = "sharpen";
    let remixing = false;

    seedEls.forEach((seed) => {
      seed.addEventListener("click", () => {
        inputEl.value = seed.textContent;
        inputEl.focus();
      });
    });

    modeEls.forEach((mode) => {
      mode.addEventListener("click", () => {
        modeEls.forEach((m) => {
          m.classList.remove("is-active");
          m.setAttribute("aria-checked", "false");
          m.setAttribute("tabindex", "-1");
        });
        mode.classList.add("is-active");
        mode.setAttribute("aria-checked", "true");
        mode.setAttribute("tabindex", "0");
        currentMode = mode.dataset.remixMode;
      });
    });

    inputEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter") actionEl.click();
    });

    actionEl.addEventListener("click", () => {
      const value = inputEl.value.trim();
      if (!value || remixing) return;
      runRemix(value, currentMode);
    });

    async function runRemix(input, mode) {
      remixing = true;
      actionEl.disabled = true;
      actionEl.setAttribute("aria-busy", "true");
      actionTextEl.textContent = "Remixing...";
      if (statusEl) statusEl.textContent = "Remixing your idea...";
      
      inputEl.disabled = true;
      modeEls.forEach(m => m.disabled = true);
      seedEls.forEach(s => s.disabled = true);

      outputPanel.hidden = false;
      cardEl.hidden = true;
      processingEl.hidden = false;

      const result = (await requestRemix(input, mode)) || {
        source: "fallback",
        output: buildUnavailableResult(input),
      };

      processingEl.hidden = true;
      
      cardEl.replaceChildren();
      cardEl.appendChild(buildCard(result.output, result.source));
      cardEl.hidden = false;
      if (statusEl) statusEl.textContent = "Remix complete.";

      remixing = false;
      actionEl.disabled = false;
      actionEl.removeAttribute("aria-busy");
      actionTextEl.textContent = "Remix";
      
      inputEl.disabled = false;
      modeEls.forEach(m => m.disabled = false);
      seedEls.forEach(s => s.disabled = false);
      
      cardEl.setAttribute("tabindex", "-1");
      cardEl.focus();
    }

    async function requestRemix(input, mode) {
      let tid;
      try {
        const ctrl = new AbortController();
        tid = setTimeout(() => ctrl.abort(), 6000);
        const res = await fetch("/api/ai/track-lab", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ feature: "remix-studio", input, mode }),
          signal: ctrl.signal,
        });
        if (!res.ok) return null;
        const data = await res.json();
        const output = normalizeRemixResult(data && data.output);
        if (!output) return null;
        return {
          source: data && data.source === "ai" ? "ai" : "fallback",
          output,
        };
      } catch {
        return null;
      } finally {
        if (tid) clearTimeout(tid);
      }
    }

    function buildUnavailableResult(input) {
      const title = cleanText(input, 80) || "Remix unavailable";
      return {
        badge: "Fallback",
        title,
        sections: [
          {
            label: "Status",
            text: "The generation endpoint was unavailable. Try again to request a fresh server-generated remix.",
          },
        ],
      };
    }

    function normalizeRemixResult(value) {
      if (!isRecord(value)) return null;
      const title = cleanText(value.title, 90);
      const sections = Array.isArray(value.sections)
        ? value.sections.map(normalizeSection).filter(Boolean)
        : [];
      if (!title || sections.length === 0) return null;

      const result = {
        badge: cleanText(value.badge, 40) || "Generated Concept",
        title,
        sections,
      };
      const tagline = cleanText(value.tagline, 180);
      const tags = cleanArray(value.tags, 5, 28);
      if (tagline) result.tagline = tagline;
      if (tags.length) result.tags = tags;
      return result;
    }

    function normalizeSection(value) {
      if (!isRecord(value)) return null;
      const label = cleanText(value.label, 50);
      if (!label) return null;
      const section = { label };
      const text = cleanText(value.text, 260);
      const items = cleanArray(value.items, 6, 130);
      const stackTags = cleanArray(value.stackTags, 6, 28);
      const swatches = Array.isArray(value.swatches)
        ? value.swatches.map(normalizeSwatch).filter(Boolean).slice(0, 6)
        : [];
      const level = normalizeLevel(value.level);

      if (text) section.text = text;
      if (items.length) section.items = items;
      if (stackTags.length) section.stackTags = stackTags;
      if (swatches.length) section.swatches = swatches;
      if (level) section.level = level;
      return Object.keys(section).length > 1 ? section : null;
    }

    function normalizeSwatch(value) {
      if (!isRecord(value)) return null;
      const name = cleanText(value.name, 40);
      const hex = cleanText(value.hex, 12);
      return name && /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(hex)
        ? { name, hex }
        : null;
    }

    function normalizeLevel(value) {
      if (!isRecord(value)) return null;
      const total = clampNumber(value.total, 1, 5, 3);
      return {
        filled: clampNumber(value.filled, 0, total, 1),
        total,
        label: cleanText(value.label, 40) || "Beginner",
      };
    }

    function cleanArray(value, maxItems, maxLength) {
      if (!Array.isArray(value)) return [];
      return value.map((item) => cleanText(item, maxLength)).filter(Boolean).slice(0, maxItems);
    }

    function cleanText(value, maxLength) {
      const text = typeof value === "string" || typeof value === "number" || typeof value === "boolean"
        ? String(value)
        : "";
      const normalized = text.replace(/\s+/g, " ").trim();
      return normalized.length <= maxLength ? normalized : `${normalized.slice(0, maxLength - 3).trimEnd()}...`;
    }

    function clampNumber(value, min, max, fallback) {
      const number = typeof value === "number" ? value : Number.parseInt(String(value), 10);
      if (!Number.isFinite(number)) return fallback;
      return Math.max(min, Math.min(max, Math.floor(number)));
    }

    function isRecord(value) {
      return typeof value === "object" && value !== null && !Array.isArray(value);
    }

    function buildCard(result, source) {
      const frag = document.createDocumentFragment();
      const wrapper = document.createElement("div");
      wrapper.className = "remix-studio__card-inner";

      let delay = 0;

      const badge = el("span", "remix-studio__card-badge", result.badge);
      badge.style.animationDelay = `${delay}ms`;
      wrapper.appendChild(badge);

      delay += 40;
      const sourceEl = el(
        "span",
        "remix-studio__card-source",
        source === "ai" ? "Generated by Gemini AI" : "Deterministic fallback"
      );
      sourceEl.style.animationDelay = `${delay}ms`;
      wrapper.appendChild(sourceEl);

      delay += 60;
      const title = el("h4", "remix-studio__card-title", result.title);
      title.style.animationDelay = `${delay}ms`;
      title.classList.add("remix-studio__card-section");
      wrapper.appendChild(title);

      if (result.tagline) {
        delay += 60;
        const tagline = el("span", "remix-studio__card-tagline", result.tagline);
        tagline.style.animationDelay = `${delay}ms`;
        tagline.classList.add("remix-studio__card-section");
        wrapper.appendChild(tagline);
      }

      if (result.sections) {
        result.sections.forEach((sec) => {
          delay += 80;
          const section = document.createElement("div");
          section.className = "remix-studio__card-section";
          section.style.animationDelay = `${delay}ms`;

          section.appendChild(el("span", "remix-studio__card-section-label", sec.label));

          if (sec.items) {
            const ul = document.createElement("ul");
            sec.items.forEach((item) => {
              ul.appendChild(el("li", "", item));
            });
            section.appendChild(ul);
          }

          if (sec.text) {
            section.appendChild(el("span", "", sec.text));
          }

          if (sec.swatches) {
            const row = document.createElement("div");
            row.className = "remix-studio__swatches";
            sec.swatches.forEach((sw) => {
              const g = document.createElement("div");
              g.className = "remix-studio__swatch-group";
              const dot = document.createElement("span");
              dot.className = "remix-studio__swatch-dot";
              dot.style.background = sw.hex;
              g.appendChild(dot);
              g.appendChild(el("span", "remix-studio__swatch-name", sw.name));
              row.appendChild(g);
            });
            section.appendChild(row);
          }

          if (sec.stackTags) {
            const row = document.createElement("div");
            row.className = "remix-studio__card-tags";
            sec.stackTags.forEach((t) => {
              row.appendChild(el("span", "remix-studio__card-tag", t));
            });
            section.appendChild(row);
          }

          if (sec.level) {
            const row = document.createElement("div");
            row.className = "remix-studio__level-row";
            for (let i = 0; i < sec.level.total; i++) {
              const pip = document.createElement("span");
              pip.className =
                "remix-studio__level-pip " +
                (i < sec.level.filled
                  ? "remix-studio__level-pip--on"
                  : "remix-studio__level-pip--off");
              row.appendChild(pip);
            }
            row.appendChild(
              el("span", "remix-studio__level-label", sec.level.label)
            );
            section.appendChild(row);
          }

          wrapper.appendChild(section);
        });
      }

      if (result.tags) {
        delay += 60;
        const tagRow = document.createElement("div");
        tagRow.className = "remix-studio__card-tags remix-studio__card-section";
        tagRow.style.animationDelay = `${delay}ms`;
        result.tags.forEach((t) => {
          tagRow.appendChild(el("span", "remix-studio__card-tag", t));
        });
        wrapper.appendChild(tagRow);
      }

      frag.appendChild(wrapper);
      return frag;
    }

    function el(tag, cls, text) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    }
  })();
</script>
