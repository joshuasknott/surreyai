---
const chipData = [
  { id: "creative", label: "Media & Arts", color: "var(--ai-purple, #a78bfa)" },
  { id: "coding", label: "Software Eng", color: "var(--ai-cyan, #22d3ee)" },
  { id: "research", label: "Dissertations", color: "var(--color-blue-500, #3b82f6)" },
  { id: "societies", label: "Student Societies", color: "var(--color-orange-500, #f97316)" },
  { id: "business", label: "Business & Startups", color: "var(--color-violet-500, #8b5cf6)" },
  { id: "games", label: "Game Dev", color: "var(--color-amber-500, #f59e0b)" },
  { id: "design", label: "UX/UI Design", color: "var(--color-fuchsia-500, #d946ef)" },
  { id: "science", label: "Natural Sciences", color: "var(--color-emerald-500, #10b981)" },
];

const nodeData = [
  { label: "Asset Generation", x: 15, y: 20, chips: ["creative", "design", "games"], desc: "Generating textures and graphics for projects." },
  { label: "Music Synthesis", x: 26.6, y: 12.5, chips: ["creative"], desc: "Audio creation for student media projects." },
  { label: "Creative Writing", x: 12, y: 41.1, chips: ["creative", "research"], desc: "Brainstorming narrative structures." },
  { label: "Literature Review", x: 46.6, y: 16.1, chips: ["research", "science"], desc: "Summarising academic papers efficiently." },
  { label: "Data Analysis", x: 58.3, y: 29.1, chips: ["science", "coding"], desc: "Finding trends in lab experiment data." },
  { label: "Bioinformatics", x: 43.6, y: 35.5, chips: ["science", "research"], desc: "Processing genomic sequences for research." },
  { label: "Code Copilots", x: 76.3, y: 20, chips: ["coding"], desc: "Assisting with assignment debugging." },
  { label: "App Backends", x: 83, y: 40.2, chips: ["coding", "business"], desc: "Scaling student startup platforms." },
  { label: "Cloud Hosting", x: 72, y: 52.7, chips: ["coding", "business"], desc: "Deploying projects to the web." },
  { label: "Academic Search", x: 31.3, y: 43, chips: ["research"], desc: "Finding relevant scholarly sources." },
  { label: "Survey Processing", x: 36.3, y: 59.7, chips: ["research", "societies"], desc: "Analysing student feedback data." },
  { label: "Event Planning", x: 16.3, y: 72.7, chips: ["societies", "business"], desc: "Optimising society event schedules." },
  { label: "Member Engagement", x: 27, y: 82.7, chips: ["societies", "creative"], desc: "Drafting newsletters and updates." },
  { label: "Study Assistants", x: 11.6, y: 89.4, chips: ["societies", "games"], desc: "Creating interactive flashcards." },
  { label: "Market Research", x: 55.3, y: 74.4, chips: ["business", "research"], desc: "Analysing competitor landscapes." },
  { label: "Pitch Decks", x: 65.8, y: 85.5, chips: ["business", "design"], desc: "Generating presentation outlines." },
  { label: "Financial Models", x: 46.3, y: 86.1, chips: ["business", "science"], desc: "Forecasting startup revenue." },
  { label: "NPC Logic", x: 79.6, y: 74.4, chips: ["games", "coding"], desc: "Creating intelligent game characters." },
  { label: "Level Generation", x: 90.3, y: 84.7, chips: ["games", "creative"], desc: "Procedural world building." },
  { label: "Wireframing", x: 92.5, y: 35.5, chips: ["design", "business"], desc: "Rapid prototyping for apps." },
  { label: "Accessibility", x: 89.1, y: 57.7, chips: ["design", "coding"], desc: "Checking contrast and screen-reader support." },
];

const edgePairs: [number, number][] = [
  [0, 1], [0, 2], [1, 2],
  [3, 4], [3, 5], [4, 5],
  [6, 7], [6, 8], [7, 8],
  [9, 10],
  [11, 12], [11, 13], [12, 13],
  [14, 15], [14, 16], [15, 16],
  [17, 18],
  [19, 20],
  [2, 9], [3, 10], [4, 6], [5, 10],
  [8, 14], [8, 20], [12, 15],
  [17, 6], [18, 19],
];

const edges = edgePairs.map(([a, b]) => {
  const shared = nodeData[a].chips.filter((c) => nodeData[b].chips.includes(c));
  return {
    x1: nodeData[a].x,
    y1: nodeData[a].y,
    x2: nodeData[b].x,
    y2: nodeData[b].y,
    a,
    b,
    sharedChips: shared,
  };
});
---

<div data-track-prototype="ml" class="mlpf">
  <div class="mlpf__top">
    <span class="mlpf__badge">Use Case Discovery</span>
    <div class="mlpf__chips" role="group" aria-label="Study domains">
      {chipData.map((chip) => (
        <button
          class="mlpf__chip"
          type="button"
          data-mlpf-chip={chip.id}
          aria-pressed="false"
          style={`--chip-color: ${chip.color}`}
        >
          <span class="mlpf__chip-dot" />
          {chip.label}
        </button>
      ))}
    </div>
  </div>

  <div class="mlpf__canvas">
    <svg
      class="mlpf__svg"
      aria-hidden="true"
      width="100%"
      height="100%"
    >
      <g class="mlpf__edges">
        {edges.map((edge) => (
          <line
            class="mlpf__edge"
            data-mlpf-edge={edge.sharedChips.join(",")}
            data-mlpf-edge-nodes={`${edge.a}-${edge.b}`}
            x1={`${edge.x1}%`}
            y1={`${edge.y1}%`}
            x2={`${edge.x2}%`}
            y2={`${edge.y2}%`}
            stroke-width="1.5"
          />
        ))}
      </g>
    </svg>

    <div class="mlpf__nodes">
      {nodeData.map((node, i) => {
        const primaryChip = chipData.find((c) => c.id === node.chips[0]);
        return (
          <button
            class="mlpf__node"
            type="button"
            data-mlpf-node={i}
            data-mlpf-node-chips={node.chips.join(",")}
            data-mlpf-node-label={node.label}
            data-mlpf-node-desc={node.desc}
            style={`left: ${node.x}%; top: ${node.y}%; --node-color: ${primaryChip?.color ?? "currentColor"}`}
            aria-label={`${node.label}. ${node.desc}`}
          >
            <div class="mlpf__node-dot"></div>
            <span class="mlpf__node-label">{node.label}</span>
          </button>
        );
      })}
    </div>
  </div>

  <div class="mlpf__info" aria-live="polite" aria-atomic="true">
    <div class="mlpf__info-content">
      <div class="mlpf__info-header">
        <h3 class="mlpf__info-title" data-mlpf-info-title>Use Case Discovery</h3>
        <span class="mlpf__count" data-mlpf-count style="display: none;"></span>
      </div>
      <p class="mlpf__info-desc" data-mlpf-info-desc>Select study domains above or explore the map to see how AI is applied.</p>
      <div class="mlpf__info-chips" data-mlpf-info-chips></div>
    </div>
  </div>
</div>

<style>
  .mlpf {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 16px;
    padding: 24px;
    position: relative;
    background: var(--ai-bg, transparent);
    color: var(--ai-fg, inherit);
    font-family: var(--font-sans, system-ui, sans-serif);
  }

  .mlpf__top {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    z-index: 10;
  }

  .mlpf__badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ai-fg-muted);
    padding: 6px 12px;
    border: 1px solid var(--ai-border);
    border-radius: 9999px;
    white-space: nowrap;
  }

  .mlpf__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    flex: 1;
  }

  .mlpf__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px; /* Increased touch target */
    border: 1px solid var(--ai-border);
    border-radius: 9999px;
    background: var(--ai-surface);
    color: var(--ai-fg);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mlpf__chip:hover {
    background: var(--ai-border);
    transform: translateY(-1px);
  }

  .mlpf__chip:focus-visible {
    outline: 2px solid var(--chip-color);
    outline-offset: 2px;
  }

  .mlpf__chip[aria-pressed="true"] {
    background: color-mix(in srgb, var(--chip-color) 15%, transparent);
    border-color: color-mix(in srgb, var(--chip-color) 40%, transparent);
    color: var(--ai-fg);
  }

  .mlpf__chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--chip-color);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .mlpf__chip[aria-pressed="true"] .mlpf__chip-dot {
    opacity: 1;
  }

  .mlpf__canvas {
    flex: 1;
    min-height: 450px;
    position: relative;
    border-radius: 16px;
    background: var(--ai-surface);
    border: 1px solid var(--ai-border);
  }

  .mlpf__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .mlpf__edge {
    opacity: 0.15;
    stroke: var(--ai-border-strong);
    transition: opacity 0.4s ease, stroke-width 0.4s ease, stroke 0.4s ease;
  }

  .mlpf__edge.is-active {
    opacity: 0.8;
    stroke-width: 2;
  }

  .mlpf__nodes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mlpf__node {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 16px; /* Increased touch target */
    cursor: pointer;
    z-index: 2;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease, filter 0.3s ease;
  }

  .mlpf__node.is-dimmed {
    opacity: 0.3;
    filter: grayscale(80%);
  }

  .mlpf__node:hover, .mlpf__node:focus-visible {
    z-index: 10;
    transform: translate(-50%, -50%) scale(1.05);
    outline: none;
  }

  .mlpf__node-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ai-border-strong);
    border: 2px solid var(--ai-surface);
    transition: all 0.3s ease;
  }

  .mlpf__node.is-active .mlpf__node-dot,
  .mlpf__node:not(.is-dimmed):hover .mlpf__node-dot,
  .mlpf__node:not(.is-dimmed):focus-visible .mlpf__node-dot {
    background: var(--node-color);
    border-color: var(--ai-surface);
    transform: scale(1.2);
  }

  .mlpf__node-label {
    font-size: 0.875rem; /* Increased readability */
    font-weight: 500;
    color: var(--ai-fg);
    background: color-mix(in srgb, var(--ai-bg) 90%, transparent);
    padding: 4px 10px;
    border-radius: 6px;
    backdrop-filter: blur(4px);
    white-space: nowrap;
    transition: all 0.3s ease;
    pointer-events: none;
    border: 1px solid var(--ai-border); /* Subtle definition */
  }

  .mlpf__node.is-active .mlpf__node-label {
    font-weight: 700;
    border-color: var(--node-color);
  }

  .mlpf__info {
    background: var(--ai-surface);
    border: 1px solid var(--ai-border);
    border-radius: 12px;
    padding: 20px; /* Increased padding */
    margin-top: 8px;
    min-height: 120px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .mlpf__info-content {
    display: flex;
    flex-direction: column;
  }

  .mlpf__info-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .mlpf__info-title {
    font-size: 1.125rem; /* Larger */
    font-weight: 700;
    color: var(--ai-fg);
    margin: 0;
  }

  .mlpf__info-desc {
    font-size: 0.9375rem; /* Increased readability */
    color: var(--ai-fg-muted);
    margin: 0;
    line-height: 1.5;
  }

  .mlpf__count {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ai-fg-muted);
    background: var(--ai-border);
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .mlpf__info-chips {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .mlpf__info-chip {
    font-size: 0.75rem; /* Increased readability */
    font-weight: 600;
    color: var(--ai-fg);
    background: color-mix(in srgb, var(--chip-color) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--chip-color) 30%, transparent);
    padding: 4px 10px;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .mlpf {
      padding: 16px;
    }
    .mlpf__node-label {
      font-size: 0.75rem;
    }
    .mlpf__canvas {
      min-height: 350px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mlpf *, .mlpf *::before, .mlpf *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector("[data-track-prototype=\"ml\"]");
    if (root instanceof HTMLElement) {
      const chips = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-mlpf-chip]")
      );
      const nodeEls = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-mlpf-node]")
      );
      const edgeEls = Array.from(
        root.querySelectorAll<SVGLineElement>("[data-mlpf-edge]")
      );
      const infoTitle = root.querySelector<HTMLElement>("[data-mlpf-info-title]");
      const infoDesc = root.querySelector<HTMLElement>("[data-mlpf-info-desc]");
      const infoChips = root.querySelector<HTMLElement>("[data-mlpf-info-chips]");
      const countEl = root.querySelector<HTMLElement>("[data-mlpf-count]");

      if (!infoTitle || !infoDesc || !infoChips || !countEl) return;

      const selected = new Set<string>();

      const chipMeta: Record<string, { color: string; label: string }> = {
        creative: { color: "var(--ai-purple, #a78bfa)", label: "Media & Arts" },
        coding: { color: "var(--ai-cyan, #22d3ee)", label: "Software Eng" },
        research: { color: "var(--color-blue-500, #3b82f6)", label: "Dissertations" },
        societies: { color: "var(--color-orange-500, #f97316)", label: "Student Societies" },
        business: { color: "var(--color-violet-500, #8b5cf6)", label: "Business & Startups" },
        games: { color: "var(--color-amber-500, #f59e0b)", label: "Game Dev" },
        design: { color: "var(--color-fuchsia-500, #d946ef)", label: "UX/UI Design" },
        science: { color: "var(--color-emerald-500, #10b981)", label: "Natural Sciences" },
      };

      let activeHoverNode: HTMLButtonElement | null = null;

      function updateGlobalInfo() {
        if (activeHoverNode) {
          showNodeInfo(activeHoverNode);
          return;
        }

        const hasSelection = selected.size > 0;
        if (!hasSelection) {
          infoTitle!.textContent = "Use Case Discovery";
          infoDesc!.textContent = "Select study domains above or explore the map to see how AI is applied.";
          infoChips!.innerHTML = "";
          countEl!.style.display = "none";
        } else {
          const names = Array.from(selected).map((c) => chipMeta[c]?.label ?? c);
          let title: string;
          let desc: string;
          
          if (selected.size === 1) {
            title = `${names[0]} Applications`;
            desc = "Showing how AI is used within this field.";
          } else if (selected.size === 2) {
            title = `Intersecting ${names[0]} & ${names[1]}`;
            desc = `Exploring how ${names[0]} and ${names[1]} overlap in student projects.`;
          } else {
            title = `Cross-Disciplinary: ${names.slice(0, 3).join(", ")}${names.length > 3 ? "..." : ""}`;
            desc = "Multiple overlapping domains highlighted.";
          }
          
          infoTitle!.textContent = title;
          infoDesc!.textContent = desc;
          infoChips!.innerHTML = "";
          
          const activeCount = nodeEls.filter(n => n.classList.contains("is-active")).length;
          if (activeCount > 0) {
            countEl!.textContent = `${activeCount} path${activeCount !== 1 ? "s" : ""} found`;
            countEl!.style.display = "inline-flex";
          } else {
            countEl!.style.display = "none";
          }
        }
      }

      function showNodeInfo(node: HTMLButtonElement) {
        infoTitle!.textContent = node.dataset.mlpfNodeLabel ?? "";
        infoDesc!.textContent = node.dataset.mlpfNodeDesc ?? "";
        
        const nodeChips = node.dataset.mlpfNodeChips!.split(",");
        infoChips!.innerHTML = nodeChips.map((c) => {
          const meta = chipMeta[c];
          return `<span class="mlpf__info-chip" style="--chip-color: ${meta?.color ?? 'currentColor'}">${meta?.label ?? c}</span>`;
        }).join("");
        
        countEl!.style.display = "none";
      }

      function update() {
        const hasSelection = selected.size > 0;

        nodeEls.forEach((node) => {
          const nodeChips = node.dataset.mlpfNodeChips!.split(",");
          const isActive = !hasSelection || nodeChips.some((c) => selected.has(c));
          
          if (hasSelection && isActive) {
            node.classList.add("is-active");
            node.classList.remove("is-dimmed");
          } else if (hasSelection && !isActive) {
            node.classList.remove("is-active");
            node.classList.add("is-dimmed");
          } else {
            node.classList.remove("is-active", "is-dimmed");
          }
        });

        edgeEls.forEach((edge) => {
          if (!hasSelection) {
            edge.classList.remove("is-active");
            edge.removeAttribute("stroke");
            return;
          }

          const [aStr, bStr] = edge.dataset.mlpfEdgeNodes!.split("-");
          const aIdx = parseInt(aStr, 10);
          const bIdx = parseInt(bStr, 10);
          const aMatch = nodeEls[aIdx].classList.contains("is-active");
          const bMatch = nodeEls[bIdx].classList.contains("is-active");

          if (aMatch && bMatch) {
            const sharedChip = edge.dataset.mlpfEdge!
              .split(",")
              .find((c) => selected.has(c));
            
            if (sharedChip) {
              edge.setAttribute("stroke", chipMeta[sharedChip]?.color ?? "currentColor");
            }
            edge.classList.add("is-active");
          } else {
            edge.classList.remove("is-active");
            edge.removeAttribute("stroke");
          }
        });

        updateGlobalInfo();
      }

      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const id = chip.dataset.mlpfChip!;
          if (selected.has(id)) {
            selected.delete(id);
            chip.setAttribute("aria-pressed", "false");
          } else {
            selected.add(id);
            chip.setAttribute("aria-pressed", "true");
          }
          update();
        });
      });

      nodeEls.forEach((node) => {
        node.addEventListener("mouseenter", () => {
          activeHoverNode = node;
          updateGlobalInfo();
        });
        node.addEventListener("mouseleave", () => {
          activeHoverNode = null;
          updateGlobalInfo();
        });
        node.addEventListener("focus", () => {
          activeHoverNode = node;
          updateGlobalInfo();
        });
        node.addEventListener("blur", () => {
          activeHoverNode = null;
          updateGlobalInfo();
        });
        
        node.addEventListener("click", () => {
          const nodeChips = node.dataset.mlpfNodeChips!.split(",");
          const isExactMatch = selected.size === nodeChips.length && nodeChips.every(c => selected.has(c));
          
          chips.forEach(chip => {
            const id = chip.dataset.mlpfChip!;
            if (isExactMatch) {
              selected.delete(id);
              chip.setAttribute("aria-pressed", "false");
            } else {
              if (nodeChips.includes(id)) {
                selected.add(id);
                chip.setAttribute("aria-pressed", "true");
              } else {
                selected.delete(id);
                chip.setAttribute("aria-pressed", "false");
              }
            }
          });
          update();
        });
      });

      const chipContainer = root.querySelector(".mlpf__chips");
      if (chipContainer) {
        chipContainer.addEventListener("keydown", (e) => {
          const ke = e as KeyboardEvent;
          const current = document.activeElement as HTMLButtonElement;
          const currentIndex = chips.indexOf(current);
          if (currentIndex === -1) return;
          let next = -1;
          if (ke.key === "ArrowRight" || ke.key === "ArrowDown") {
            next = (currentIndex + 1) % chips.length;
          } else if (ke.key === "ArrowLeft" || ke.key === "ArrowUp") {
            next = (currentIndex - 1 + chips.length) % chips.length;
          }
          if (next >= 0) {
            ke.preventDefault();
            chips[next].focus();
          }
        });
      }
    }
  })();
</script>


