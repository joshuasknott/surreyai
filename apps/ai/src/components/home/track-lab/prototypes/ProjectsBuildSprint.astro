---
---

<div class="bs-root" data-build-sprint-root hidden>
  <div class="bs-intro" data-bs-intro>
    <span class="bs-intro__label">Project Lifecycle</span>
    <h3 class="bs-intro__title">From Idea to Demo</h3>
    <p class="bs-intro__hint">Select a project theme to see how we guide a concept through our development pipeline.</p>
    <div class="bs-pills" role="group" aria-label="Project Themes">
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="campus">Campus Assistant</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="study">Revision Tool</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="creative">Creative AI</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="vision">Vision Demo</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="automation">Automation Helper</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="ethics">Ethics Debate Tool</button>
    </div>
  </div>

  <div class="bs-board" data-bs-board hidden>
    <div class="bs-board__head">
      <div class="bs-board__title-group">
        <h4 class="bs-board__name" data-project-name></h4>
        <span class="bs-board__stage" data-stage-badge aria-live="polite"></span>
      </div>
      <button type="button" class="bs-ai-btn" data-ai-btn hidden aria-live="polite">
        <span aria-hidden="true">↻</span>
        <span class="bs-ai-btn__text">Refresh Stage</span>
      </button>
    </div>

    <div class="bs-pipeline" role="list" aria-label="Project Pipeline">
      <div class="bs-pipe" role="listitem" data-pipe-stage="0">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Idea<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="0"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="1">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Team<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="1"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="2">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Prototype<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="2"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="3">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Demo<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="3"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="4">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Showcase<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
    </div>

    <div class="bs-card" data-bs-card aria-live="polite" aria-atomic="true">
      <p class="bs-card__text" data-stage-desc></p>
      <span class="bs-card__ai-tag" data-ai-tag hidden></span>
    </div>

    <div class="bs-actions">
      <button type="button" class="bs-advance" data-advance-btn hidden>Next Stage →</button>
    </div>
  </div>

  <div class="bs-done" data-bs-done hidden>
    <div class="bs-done__icon" aria-hidden="true">✨</div>
    <h3 class="bs-done__title">Project Complete</h3>
    <p class="bs-done__sub">From raw idea to live demo — that is how we build impactful student projects.</p>
    <button type="button" class="bs-again" data-reset-btn>Start New Project</button>
  </div>
</div>

<style>
  .bs-root {
    --bs-accent: var(--ai-accent, #4f46e5);
    --bs-accent-text: var(--ai-accent-text, #ffffff);
    --bs-text-main: var(--ai-text, #0f172a);
    --bs-text-muted: var(--ai-text-muted, #64748b);
    --bs-bg-surface: var(--ai-surface, #ffffff);
    --bs-bg-subtle: var(--ai-surface-subtle, #f8fafc);
    --bs-border: var(--ai-border, #e2e8f0);
    --bs-bg-solid: var(--ai-bg, #ffffff);

    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 32px;
    gap: 20px;
    color: var(--bs-text-main);
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    font-family: var(--font-sans);
  }

  :global([data-theme="dark"]) .bs-root {
    --bs-accent: var(--ai-accent, #818cf8);
    --bs-accent-text: var(--ai-accent-text, #0f172a);
    --bs-text-main: var(--ai-text, #f8fafc);
    --bs-text-muted: var(--ai-text-muted, #94a3b8);
    --bs-bg-surface: var(--ai-surface, #1e293b);
    --bs-bg-subtle: var(--ai-surface-subtle, #0f172a);
    --bs-border: var(--ai-border, #334155);
    --bs-bg-solid: var(--ai-bg, #0f172a);
  }

  .bs-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Intro ---------- */
  .bs-intro {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    animation: bs-fade-up 400ms ease;
  }

  .bs-intro__label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bs-accent);
    font-family: var(--font-mono);
  }

  .bs-intro__title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .bs-intro__hint {
    font-size: 0.95rem;
    color: var(--bs-text-muted);
    max-width: 400px;
    line-height: 1.6;
    margin: 0 0 12px 0;
  }

  .bs-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    max-width: 480px;
  }

  .bs-pill {
    padding: 8px 16px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--bs-text-main);
    background: var(--bs-bg-subtle);
    border: 1px solid var(--bs-border);
    border-radius: 99px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
    white-space: nowrap;
  }

  .bs-pill:hover {
    background: var(--bs-bg-surface);
    border-color: var(--bs-accent);
  }

  .bs-pill:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
  }

  .bs-pill[aria-pressed="true"] {
    background: var(--bs-accent);
    border-color: var(--bs-accent);
    color: var(--bs-accent-text);
  }

  /* ---------- Board ---------- */
  .bs-board {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: bs-fade-up 350ms ease;
  }

  .bs-board__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bs-board__title-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bs-board__name {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .bs-board__stage {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bs-accent);
    padding: 4px 10px;
    border: 1px solid var(--bs-border);
    border-radius: 6px;
    background: var(--bs-bg-subtle);
  }

  /* ---------- Pipeline ---------- */
  .bs-pipeline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 12px 0;
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
    list-style: none;
  }

  .bs-pipe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 2;
  }

  .bs-pipe__node {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--bs-border);
    background: var(--bs-bg-solid);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 300ms ease;
  }

  .bs-pipe__label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bs-text-muted);
    transition: color 300ms ease;
    font-family: var(--font-sans);
  }

  .bs-pipe__line {
    flex: 1;
    height: 2px;
    background: var(--bs-border);
    margin-top: 13px;
    border-radius: 2px;
    transition: background 300ms ease;
    z-index: 1;
    min-width: 12px;
  }

  .bs-pipe.is-done .bs-pipe__node {
    background: var(--bs-accent);
    border-color: var(--bs-accent);
  }

  .bs-pipe.is-done .bs-pipe__node::after {
    content: "✓";
    color: var(--bs-accent-text);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .bs-pipe.is-done .bs-pipe__label {
    color: var(--bs-text-main);
  }

  .bs-pipe.is-active .bs-pipe__node {
    border-color: var(--bs-accent);
    border-width: 3px;
    background: var(--bs-bg-solid);
  }

  .bs-pipe.is-active .bs-pipe__node::after {
    content: "";
    width: 10px;
    height: 10px;
    background: var(--bs-accent);
    border-radius: 50%;
  }

  .bs-pipe.is-active .bs-pipe__label {
    color: var(--bs-accent);
  }

  .bs-pipe__line.is-filled {
    background: var(--bs-accent);
  }

  /* ---------- Card ---------- */
  .bs-card {
    padding: 24px;
    border-radius: 12px;
    background: var(--bs-bg-surface);
    border: 1px solid var(--bs-border);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    min-height: 80px;
  }

  .bs-card__text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--bs-text-main);
    margin: 0;
    transition: opacity 200ms ease;
  }

  .bs-card__ai-tag {
    position: absolute;
    top: -12px;
    right: 20px;
    font-size: 0.7rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bs-accent-text);
    background: var(--bs-accent);
    padding: 4px 10px;
    border-radius: 12px;
  }

  /* ---------- Actions ---------- */
  .bs-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
  }

  .bs-advance {
    padding: 12px 28px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--bs-accent-text);
    background: var(--bs-accent);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
  }

  .bs-advance:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .bs-advance:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 4px;
  }

  .bs-ai-btn {
    padding: 8px 14px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--bs-text-main);
    background: var(--bs-bg-subtle);
    border: 1px solid var(--bs-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .bs-ai-btn:hover {
    background: var(--bs-bg-surface);
    border-color: var(--bs-accent);
  }

  .bs-ai-btn[aria-busy="true"] {
    opacity: 0.6;
    pointer-events: none;
  }

  .bs-ai-btn:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
  }

  /* ---------- Done ---------- */
  .bs-done {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    animation: bs-fade-up 500ms ease;
  }

  .bs-done__icon {
    font-size: 3rem;
    line-height: 1;
    color: var(--bs-accent);
    margin-bottom: 8px;
    animation: bs-fade-up 600ms ease;
  }

  .bs-done__title {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0;
    color: var(--bs-text-main);
  }

  .bs-done__sub {
    font-size: 1rem;
    color: var(--bs-text-muted);
    max-width: 380px;
    line-height: 1.6;
    margin: 0 0 8px 0;
  }

  .bs-again {
    padding: 10px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--bs-text-main);
    background: var(--bs-bg-subtle);
    border: 1px solid var(--bs-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
  }

  .bs-again:hover {
    background: var(--bs-bg-surface);
    border-color: var(--bs-border);
    transform: translateY(-1px);
  }

  .bs-again:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
  }

  /* ---------- Keyframes ---------- */
  @keyframes bs-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .bs-root {
      padding: 24px 20px;
      gap: 16px;
    }

    .bs-intro__title {
      font-size: 1.3rem;
    }

    .bs-board__name {
      font-size: 1rem;
    }

    .bs-card {
      padding: 16px;
    }

    .bs-card__text {
      font-size: 0.95rem;
    }

    .bs-pipe__node {
      width: 24px;
      height: 24px;
    }

    .bs-pipe.is-active .bs-pipe__node::after {
      width: 6px;
      height: 6px;
    }

    .bs-pipe__line {
      margin-top: 11px;
    }

    .bs-pipe__label {
      font-size: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bs-intro,
    .bs-board,
    .bs-done,
    .bs-done__icon {
      animation: none;
    }

    .bs-advance,
    .bs-pill,
    .bs-again {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  const THEMES: Record<string, { label: string }> = {
    campus: {
      label: "Campus Assistant",
    },
    study: {
      label: "Revision Tool",
    },
    creative: {
      label: "Creative AI",
    },
    vision: {
      label: "Vision Demo",
    },
    automation: {
      label: "Automation Helper",
    },
    ethics: {
      label: "Ethics Debate Tool",
    },
  };

  const STAGE_LABELS = ["Idea", "Team", "Prototype", "Demo", "Showcase"];

  function initBuildSprint() {
    const root = document.querySelector("[data-build-sprint-root]") as HTMLDivElement | null;
    if (!root) return;

    const slot = document.querySelector('[data-proto-slot="projects"]');
    if (slot && !slot.contains(root)) {
      while (slot.firstChild) slot.removeChild(slot.firstChild);
      slot.appendChild(root);
    } else if (slot) {
      const siblings = Array.from(slot.children);
      for (const child of siblings) {
        if (child !== root) slot.removeChild(child);
      }
    }

    root.removeAttribute("hidden");

    const intro = root.querySelector("[data-bs-intro]") as HTMLDivElement;
    const board = root.querySelector("[data-bs-board]") as HTMLDivElement;
    const done = root.querySelector("[data-bs-done]") as HTMLDivElement;
    const pills = root.querySelectorAll("[data-bs-theme]") as NodeListOf<HTMLButtonElement>;
    const projectName = root.querySelector("[data-project-name]") as HTMLHeadingElement;
    const stageBadge = root.querySelector("[data-stage-badge]") as HTMLSpanElement;
    const stageDesc = root.querySelector("[data-stage-desc]") as HTMLParagraphElement;
    const advanceBtn = root.querySelector("[data-advance-btn]") as HTMLButtonElement;
    const aiBtn = root.querySelector("[data-ai-btn]") as HTMLButtonElement;
    const aiBtnText = aiBtn?.querySelector(".bs-ai-btn__text") as HTMLSpanElement;
    const aiTag = root.querySelector("[data-ai-tag]") as HTMLSpanElement;
    const resetBtn = root.querySelector("[data-reset-btn]") as HTMLButtonElement;
    const pipeStages = root.querySelectorAll("[data-pipe-stage]") as NodeListOf<HTMLDivElement>;
    const pipeLines = root.querySelectorAll("[data-pipe-line]") as NodeListOf<HTMLDivElement>;

    let currentTheme = "";
    let currentStage = 0;
    let descriptions: Record<number, { text: string; source: "ai" | "fallback" }> = {};
    let requestSeq = 0;

    function show(el: HTMLElement) {
      el.removeAttribute("hidden");
    }

    function hide(el: HTMLElement) {
      el.setAttribute("hidden", "");
    }

    function resetPipeline() {
      pipeStages.forEach((p) => {
        p.classList.remove("is-done", "is-active");
        p.removeAttribute("aria-current");
        const statusSpan = p.querySelector("[data-pipe-status]");
        if (statusSpan) statusSpan.textContent = " (Pending)";
      });
      pipeLines.forEach((l) => {
        l.classList.remove("is-filled");
      });
    }

    function renderPipeline() {
      pipeStages.forEach((p, i) => {
        p.classList.remove("is-done", "is-active");
        p.removeAttribute("aria-current");
        
        const statusSpan = p.querySelector("[data-pipe-status]");
        
        if (i < currentStage) {
          p.classList.add("is-done");
          if (statusSpan) statusSpan.textContent = " (Completed)";
        } else if (i === currentStage) {
          p.classList.add("is-active");
          p.setAttribute("aria-current", "step");
          if (statusSpan) statusSpan.textContent = " (Current)";
        } else {
          if (statusSpan) statusSpan.textContent = " (Pending)";
        }
      });
      pipeLines.forEach((l, i) => {
        l.classList.toggle("is-filled", i < currentStage);
      });
    }

    function localStageFallback(themeId: string, stage: number): string {
      const theme = THEMES[themeId]?.label || "Student project";
      return `${STAGE_LABELS[stage]} stage for ${theme} is ready. Try again for server-generated sprint detail.`;
    }

    function selectedDescription(stage: number) {
      return descriptions[stage] || { text: localStageFallback(currentTheme, stage), source: "fallback" as const };
    }

    function updateDescription(text: string, source?: "ai" | "fallback") {
      const content = text;
      stageDesc.style.opacity = "0";
      setTimeout(() => {
        stageDesc.textContent = content;
        stageDesc.style.opacity = "1";
      }, 200);

      if (source) {
        aiTag.textContent = source === "ai" ? "Gemini AI" : "Deterministic fallback";
        show(aiTag);
      } else {
        hide(aiTag);
      }
    }

    function selectTheme(themeId: string) {
      const theme = THEMES[themeId];
      if (!theme) return;

      currentTheme = themeId;
      currentStage = 0;
      descriptions = {};
      hide(aiTag);

      pills.forEach((pill) => {
        const isSelected = pill.dataset.bsTheme === themeId;
        pill.setAttribute("aria-pressed", isSelected ? "true" : "false");
      });

      projectName.textContent = theme.label;
      stageBadge.textContent = STAGE_LABELS[0];
      resetPipeline();
      renderPipeline();
      updateDescription("Preparing generated sprint description...");

      hide(intro);
      hide(done);
      show(board);
      show(advanceBtn);
      
      void loadStageDescription(0, true);

      // Ensure advance button is focused to guide keyboard users
      advanceBtn.focus();

      show(aiBtn);
    }

    function advanceStage() {
      if (currentStage < 0 || currentStage > 4) return;

      currentStage++;

      if (currentStage > 4) {
        pipeStages.forEach((p) => {
          p.classList.remove("is-active");
          p.classList.add("is-done");
          p.removeAttribute("aria-current");
          const statusSpan = p.querySelector("[data-pipe-status]");
          if (statusSpan) statusSpan.textContent = " (Completed)";
        });
        pipeLines.forEach((l) => l.classList.add("is-filled"));

        hide(board);
        show(done);
        resetBtn.focus();
        return;
      }

      renderPipeline();
      stageBadge.textContent = STAGE_LABELS[currentStage];
      const cached = descriptions[currentStage];
      if (cached) updateDescription(cached.text, cached.source);
      else {
        updateDescription("Preparing generated sprint description...");
        void loadStageDescription(currentStage, true);
      }
    }

    async function loadStageDescription(stage: number, force = false) {
      if (!currentTheme) return;
      if (!force && descriptions[stage]) {
        const cached = descriptions[stage];
        updateDescription(cached.text, cached.source);
        return;
      }

      const themeAtRequest = currentTheme;
      const seq = ++requestSeq;
      aiBtn.setAttribute("aria-busy", "true");
      if (aiBtnText) aiBtnText.textContent = "Loading...";

      let timeout: ReturnType<typeof setTimeout> | undefined;
      try {
        const controller = new AbortController();
        timeout = setTimeout(() => controller.abort(), 6000);

        const res = await fetch("/api/ai/track-lab", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            feature: "build-sprint",
            theme: themeAtRequest,
            currentStage: stage,
            structured: true,
          }),
          signal: controller.signal,
        });

        if (!res.ok) throw new Error("not ok");
        const data = await res.json();
        const text = cleanText(data?.output?.description || data?.description, 320);
        if (!text) throw new Error("invalid output");

        descriptions[stage] = {
          text,
          source: data?.source === "ai" ? "ai" : "fallback",
        };
      } catch {
        descriptions[stage] = {
          text: localStageFallback(themeAtRequest, stage),
          source: "fallback",
        };
      } finally {
        if (timeout) clearTimeout(timeout);
        aiBtn.setAttribute("aria-busy", "false");
        if (aiBtnText) aiBtnText.textContent = "Refresh Stage";
      }

      if (seq === requestSeq && currentTheme === themeAtRequest && currentStage === stage) {
        const result = selectedDescription(stage);
        updateDescription(result.text, result.source);
      }
    }

    function cleanText(value: unknown, maxLength: number) {
      const text = typeof value === "string" || typeof value === "number" || typeof value === "boolean"
        ? String(value)
        : "";
      const normalized = text.replace(/\s+/g, " ").trim();
      return normalized.length <= maxLength ? normalized : `${normalized.slice(0, maxLength - 3).trimEnd()}...`;
    }

    function resetSprint() {
      currentTheme = "";
      currentStage = 0;
      descriptions = {};
      requestSeq++;

      pills.forEach((pill) => pill.setAttribute("aria-pressed", "false"));
      resetPipeline();
      hide(aiTag);

      hide(done);
      hide(board);
      show(intro);
      
      pills[0]?.focus();
    }

    pills.forEach((pill) => {
      pill.addEventListener("click", () => selectTheme(pill.dataset.bsTheme!));
    });

    advanceBtn.addEventListener("click", advanceStage);

    if (aiBtn) aiBtn.addEventListener("click", () => loadStageDescription(currentStage, true));
    resetBtn.addEventListener("click", resetSprint);
  }

  initBuildSprint();
</script>
