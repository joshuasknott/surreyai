---
---

<div class="bs-root" data-build-sprint-root hidden>
  <div class="bs-intro" data-bs-intro>
    <span class="bs-intro__label">Project Lifecycle</span>
    <h3 class="bs-intro__title">From Idea to Demo</h3>
    <p class="bs-intro__hint">Select a project theme to see how we guide a concept through our development pipeline.</p>
    <div class="bs-pills" role="group" aria-label="Project Themes">
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="campus">Campus Assistant</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="study">Revision Tool</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="creative">Creative AI</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="vision">Vision Demo</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="automation">Automation Helper</button>
      <button type="button" class="bs-pill" aria-pressed="false" data-bs-theme="ethics">Ethics Debate Tool</button>
    </div>
  </div>

  <div class="bs-board" data-bs-board hidden>
    <div class="bs-board__head">
      <div class="bs-board__title-group">
        <h4 class="bs-board__name" data-project-name></h4>
        <span class="bs-board__stage" data-stage-badge aria-live="polite"></span>
      </div>
      <button type="button" class="bs-ai-btn" data-ai-btn hidden aria-live="polite">
        <span aria-hidden="true">✨</span>
        <span class="bs-ai-btn__text">AI Assist</span>
      </button>
    </div>

    <div class="bs-pipeline" role="list" aria-label="Project Pipeline">
      <div class="bs-pipe" role="listitem" data-pipe-stage="0">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Idea<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="0"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="1">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Team<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="1"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="2">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Prototype<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="2"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="3">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Demo<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
      <div class="bs-pipe__line" role="presentation" data-pipe-line="3"></div>
      <div class="bs-pipe" role="listitem" data-pipe-stage="4">
        <div class="bs-pipe__node" aria-hidden="true"></div>
        <span class="bs-pipe__label">Showcase<span class="bs-sr-only" data-pipe-status></span></span>
      </div>
    </div>

    <div class="bs-card" data-bs-card aria-live="polite" aria-atomic="true">
      <p class="bs-card__text" data-stage-desc></p>
      <span class="bs-card__ai-tag" data-ai-tag hidden>AI-enhanced</span>
    </div>

    <div class="bs-actions">
      <button type="button" class="bs-advance" data-advance-btn hidden>Next Stage →</button>
    </div>
  </div>

  <div class="bs-done" data-bs-done hidden>
    <div class="bs-done__icon" aria-hidden="true">✨</div>
    <h3 class="bs-done__title">Project Complete</h3>
    <p class="bs-done__sub">From raw idea to live demo — that is how we build impactful student projects.</p>
    <button type="button" class="bs-again" data-reset-btn>Start New Project</button>
  </div>
</div>

<style>
  .bs-root {
    --bs-accent: var(--ai-accent, #4f46e5);
    --bs-accent-text: var(--ai-accent-text, #ffffff);
    --bs-text-main: var(--ai-text, #0f172a);
    --bs-text-muted: var(--ai-text-muted, #64748b);
    --bs-bg-surface: var(--ai-surface, #ffffff);
    --bs-bg-subtle: var(--ai-surface-subtle, #f8fafc);
    --bs-border: var(--ai-border, #e2e8f0);
    --bs-bg-solid: var(--ai-bg, #ffffff);

    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 32px;
    gap: 20px;
    color: var(--bs-text-main);
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    font-family: var(--font-sans);
  }

  :global([data-theme="dark"]) .bs-root {
    --bs-accent: var(--ai-accent, #818cf8);
    --bs-accent-text: var(--ai-accent-text, #0f172a);
    --bs-text-main: var(--ai-text, #f8fafc);
    --bs-text-muted: var(--ai-text-muted, #94a3b8);
    --bs-bg-surface: var(--ai-surface, #1e293b);
    --bs-bg-subtle: var(--ai-surface-subtle, #0f172a);
    --bs-border: var(--ai-border, #334155);
    --bs-bg-solid: var(--ai-bg, #0f172a);
  }

  .bs-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Intro ---------- */
  .bs-intro {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    animation: bs-fade-up 400ms ease;
  }

  .bs-intro__label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bs-accent);
    font-family: var(--font-mono);
  }

  .bs-intro__title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .bs-intro__hint {
    font-size: 0.95rem;
    color: var(--bs-text-muted);
    max-width: 400px;
    line-height: 1.6;
    margin: 0 0 12px 0;
  }

  .bs-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    max-width: 480px;
  }

  .bs-pill {
    padding: 8px 16px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--bs-text-main);
    background: var(--bs-bg-subtle);
    border: 1px solid var(--bs-border);
    border-radius: 99px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
    white-space: nowrap;
  }

  .bs-pill:hover {
    background: var(--bs-bg-surface);
    border-color: var(--bs-accent);
  }

  .bs-pill:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
  }

  .bs-pill[aria-pressed="true"] {
    background: var(--bs-accent);
    border-color: var(--bs-accent);
    color: var(--bs-accent-text);
  }

  /* ---------- Board ---------- */
  .bs-board {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: bs-fade-up 350ms ease;
  }

  .bs-board__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bs-board__title-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bs-board__name {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }

  .bs-board__stage {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bs-accent);
    padding: 4px 10px;
    border: 1px solid var(--bs-border);
    border-radius: 6px;
    background: var(--bs-bg-subtle);
  }

  /* ---------- Pipeline ---------- */
  .bs-pipeline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 12px 0;
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
    list-style: none;
  }

  .bs-pipe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 2;
  }

  .bs-pipe__node {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--bs-border);
    background: var(--bs-bg-solid);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 300ms ease;
  }

  .bs-pipe__label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bs-text-muted);
    transition: color 300ms ease;
    font-family: var(--font-sans);
  }

  .bs-pipe__line {
    flex: 1;
    height: 2px;
    background: var(--bs-border);
    margin-top: 13px;
    border-radius: 2px;
    transition: background 300ms ease;
    z-index: 1;
    min-width: 12px;
  }

  .bs-pipe.is-done .bs-pipe__node {
    background: var(--bs-accent);
    border-color: var(--bs-accent);
  }

  .bs-pipe.is-done .bs-pipe__node::after {
    content: "✓";
    color: var(--bs-accent-text);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .bs-pipe.is-done .bs-pipe__label {
    color: var(--bs-text-main);
  }

  .bs-pipe.is-active .bs-pipe__node {
    border-color: var(--bs-accent);
    border-width: 3px;
    background: var(--bs-bg-solid);
  }

  .bs-pipe.is-active .bs-pipe__node::after {
    content: "";
    width: 10px;
    height: 10px;
    background: var(--bs-accent);
    border-radius: 50%;
  }

  .bs-pipe.is-active .bs-pipe__label {
    color: var(--bs-accent);
  }

  .bs-pipe__line.is-filled {
    background: var(--bs-accent);
  }

  /* ---------- Card ---------- */
  .bs-card {
    padding: 24px;
    border-radius: 12px;
    background: var(--bs-bg-surface);
    border: 1px solid var(--bs-border);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    min-height: 80px;
  }

  .bs-card__text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--bs-text-main);
    margin: 0;
    transition: opacity 200ms ease;
  }

  .bs-card__ai-tag {
    position: absolute;
    top: -12px;
    right: 20px;
    font-size: 0.7rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bs-accent-text);
    background: var(--bs-accent);
    padding: 4px 10px;
    border-radius: 12px;
  }

  /* ---------- Actions ---------- */
  .bs-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
  }

  .bs-advance {
    padding: 12px 28px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--bs-accent-text);
    background: var(--bs-accent);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
  }

  .bs-advance:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .bs-advance:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 4px;
  }

  .bs-ai-btn {
    padding: 8px 14px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--bs-text-main);
    background: var(--bs-bg-subtle);
    border: 1px solid var(--bs-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .bs-ai-btn:hover {
    background: var(--bs-bg-surface);
    border-color: var(--bs-accent);
  }

  .bs-ai-btn[aria-busy="true"] {
    opacity: 0.6;
    pointer-events: none;
  }

  .bs-ai-btn:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
  }

  /* ---------- Done ---------- */
  .bs-done {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
    animation: bs-fade-up 500ms ease;
  }

  .bs-done__icon {
    font-size: 3rem;
    line-height: 1;
    color: var(--bs-accent);
    margin-bottom: 8px;
    animation: bs-fade-up 600ms ease;
  }

  .bs-done__title {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0;
    color: var(--bs-text-main);
  }

  .bs-done__sub {
    font-size: 1rem;
    color: var(--bs-text-muted);
    max-width: 380px;
    line-height: 1.6;
    margin: 0 0 8px 0;
  }

  .bs-again {
    padding: 10px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--bs-text-main);
    background: var(--bs-bg-subtle);
    border: 1px solid var(--bs-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 200ms ease;
    font-family: var(--font-sans);
  }

  .bs-again:hover {
    background: var(--bs-bg-surface);
    border-color: var(--bs-border);
    transform: translateY(-1px);
  }

  .bs-again:focus-visible {
    outline: 2px solid var(--bs-accent);
    outline-offset: 2px;
  }

  /* ---------- Keyframes ---------- */
  @keyframes bs-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 768px) {
    .bs-root {
      padding: 24px 20px;
      gap: 16px;
    }

    .bs-intro__title {
      font-size: 1.3rem;
    }

    .bs-board__name {
      font-size: 1rem;
    }

    .bs-card {
      padding: 16px;
    }

    .bs-card__text {
      font-size: 0.95rem;
    }

    .bs-pipe__node {
      width: 24px;
      height: 24px;
    }

    .bs-pipe.is-active .bs-pipe__node::after {
      width: 6px;
      height: 6px;
    }

    .bs-pipe__line {
      margin-top: 11px;
    }

    .bs-pipe__label {
      font-size: 0.65rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bs-intro,
    .bs-board,
    .bs-done,
    .bs-done__icon {
      animation: none;
    }

    .bs-advance,
    .bs-pill,
    .bs-again {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  const THEMES: Record<string, { label: string; stages: string[] }> = {
    campus: {
      label: "Campus Assistant",
      stages: [
        "A society chatbot that answers freshers' questions about campus facilities and events",
        "Assembled a 3-person squad \u2014 designer, backend developer, and content strategist",
        "Working chat interface connected to a university knowledge base with natural language queries",
        "Presented live to 30 students at the society meetup \u2014 answered real questions in real time",
        "Published to the society website, now helping students navigate campus every day",
      ],
    },
    study: {
      label: "Revision Tool",
      stages: [
        "Smart flashcard generator that transforms lecture notes into interactive revision decks",
        "Formed a 4-person crew \u2014 ML engineer, full-stack dev, UX designer, and tester",
        "Web app that parses lecture PDFs, extracts key concepts, and generates spaced-repetition cards",
        "Demonstrated to computer science students \u2014 processed a real ML lecture live",
        "Open-sourced on GitHub \u2014 adopted by students across multiple university modules",
      ],
    },
    creative: {
      label: "Creative AI",
      stages: [
        "An interactive collaborative art tool where students and AI co-create visual compositions",
        "Gathered a 3-person collective \u2014 creative coder, digital artist, and interaction designer",
        "Canvas-based app with style transfer, generative patterns, and real-time collaboration",
        "Interactive gallery at the end-of-semester exhibition \u2014 200 visitors tried it",
        "Featured in the university\u2019s digital arts showcase alongside professional work",
      ],
    },
    vision: {
      label: "Vision Demo",
      stages: [
        "A computer vision accessibility app to help visually impaired students navigate lecture halls",
        "Recruited a 4-person team \u2014 CV specialist, mobile dev, accessibility lead, and tester",
        "Camera-based app that identifies and describes objects and text in the surroundings",
        "Live demo with student volunteers testing real-world recognition accuracy on campus",
        "Submitted to the university\u2019s accessibility innovation challenge and won recognition",
      ],
    },
    automation: {
      label: "Automation Helper",
      stages: [
        "A script to automate the entire lifecycle of society events from ticketing to feedback",
        "Built a 3-person ops team \u2014 automation dev, event planner, and integrations specialist",
        "Automated pipeline: RSVP collection, reminder scheduling, attendance tracking, and feedback forms",
        "Ran a real society event end-to-end through the system \u2014 80 attendees, zero manual overhead",
        "Adopted by three other societies for their own event management workflows",
      ],
    },
    ethics: {
      label: "Ethics Debate Tool",
      stages: [
        "A platform used in tutorials to explore ethical tradeoffs in AI hiring algorithms",
        "Convened a 4-person panel \u2014 ethicist, full-stack dev, UX researcher, and content lead",
        "Web app with timed debate rounds, argument mapping, stakeholder analysis, and scoring rubrics",
        "Hosted a live debate night with 40 participants tackling real AI ethics case studies",
        "Integrated into the society\u2019s regular ethics workshop series as a permanent tool",
      ],
    },
  };

  const STAGE_LABELS = ["Idea", "Team", "Prototype", "Demo", "Showcase"];

  function initBuildSprint() {
    const root = document.querySelector("[data-build-sprint-root]") as HTMLDivElement | null;
    if (!root) return;

    const slot = document.querySelector('[data-proto-slot="projects"]');
    if (slot && !slot.contains(root)) {
      while (slot.firstChild) slot.removeChild(slot.firstChild);
      slot.appendChild(root);
    } else if (slot) {
      const siblings = Array.from(slot.children);
      for (const child of siblings) {
        if (child !== root) slot.removeChild(child);
      }
    }

    root.removeAttribute("hidden");

    const intro = root.querySelector("[data-bs-intro]") as HTMLDivElement;
    const board = root.querySelector("[data-bs-board]") as HTMLDivElement;
    const done = root.querySelector("[data-bs-done]") as HTMLDivElement;
    const pills = root.querySelectorAll("[data-bs-theme]") as NodeListOf<HTMLButtonElement>;
    const projectName = root.querySelector("[data-project-name]") as HTMLHeadingElement;
    const stageBadge = root.querySelector("[data-stage-badge]") as HTMLSpanElement;
    const stageDesc = root.querySelector("[data-stage-desc]") as HTMLParagraphElement;
    const advanceBtn = root.querySelector("[data-advance-btn]") as HTMLButtonElement;
    const aiBtn = root.querySelector("[data-ai-btn]") as HTMLButtonElement;
    const aiBtnText = aiBtn?.querySelector(".bs-ai-btn__text") as HTMLSpanElement;
    const aiTag = root.querySelector("[data-ai-tag]") as HTMLSpanElement;
    const resetBtn = root.querySelector("[data-reset-btn]") as HTMLButtonElement;
    const pipeStages = root.querySelectorAll("[data-pipe-stage]") as NodeListOf<HTMLDivElement>;
    const pipeLines = root.querySelectorAll("[data-pipe-line]") as NodeListOf<HTMLDivElement>;

    const lab = document.querySelector("[data-track-lab]");
    const aiEnabled = lab != null && lab.hasAttribute("data-ai-enabled");

    let currentTheme = "";
    let currentStage = 0;
    let aiDescriptions: string[] | null = null;

    function show(el: HTMLElement) {
      el.removeAttribute("hidden");
    }

    function hide(el: HTMLElement) {
      el.setAttribute("hidden", "");
    }

    function resetPipeline() {
      pipeStages.forEach((p) => {
        p.classList.remove("is-done", "is-active");
        p.removeAttribute("aria-current");
        const statusSpan = p.querySelector("[data-pipe-status]");
        if (statusSpan) statusSpan.textContent = " (Pending)";
      });
      pipeLines.forEach((l) => {
        l.classList.remove("is-filled");
      });
    }

    function renderPipeline() {
      pipeStages.forEach((p, i) => {
        p.classList.remove("is-done", "is-active");
        p.removeAttribute("aria-current");
        
        const statusSpan = p.querySelector("[data-pipe-status]");
        
        if (i < currentStage) {
          p.classList.add("is-done");
          if (statusSpan) statusSpan.textContent = " (Completed)";
        } else if (i === currentStage) {
          p.classList.add("is-active");
          p.setAttribute("aria-current", "step");
          if (statusSpan) statusSpan.textContent = " (Current)";
        } else {
          if (statusSpan) statusSpan.textContent = " (Pending)";
        }
      });
      pipeLines.forEach((l, i) => {
        l.classList.toggle("is-filled", i < currentStage);
      });
    }

    function getDescription(stage: number): string {
      if (aiDescriptions && aiDescriptions[stage]) return aiDescriptions[stage];
      const theme = THEMES[currentTheme];
      if (!theme) return "";
      return theme.stages[stage] || "";
    }

    function updateDescription(text?: string) {
      const content = text || getDescription(currentStage);
      stageDesc.style.opacity = "0";
      setTimeout(() => {
        stageDesc.textContent = content;
        stageDesc.style.opacity = "1";
      }, 200);
    }

    function selectTheme(themeId: string) {
      const theme = THEMES[themeId];
      if (!theme) return;

      currentTheme = themeId;
      currentStage = 0;
      aiDescriptions = null;
      hide(aiTag);

      pills.forEach((pill) => {
        const isSelected = pill.dataset.bsTheme === themeId;
        pill.setAttribute("aria-pressed", isSelected ? "true" : "false");
      });

      projectName.textContent = theme.label;
      stageBadge.textContent = STAGE_LABELS[0];
      resetPipeline();
      renderPipeline();
      updateDescription(theme.stages[0]);

      hide(intro);
      hide(done);
      show(board);
      show(advanceBtn);
      
      // Ensure advance button is focused to guide keyboard users
      advanceBtn.focus();

      if (aiEnabled) show(aiBtn);
      else hide(aiBtn);
    }

    function advanceStage() {
      if (currentStage < 0 || currentStage > 4) return;

      currentStage++;

      if (currentStage > 4) {
        pipeStages.forEach((p) => {
          p.classList.remove("is-active");
          p.classList.add("is-done");
          p.removeAttribute("aria-current");
          const statusSpan = p.querySelector("[data-pipe-status]");
          if (statusSpan) statusSpan.textContent = " (Completed)";
        });
        pipeLines.forEach((l) => l.classList.add("is-filled"));

        hide(board);
        show(done);
        resetBtn.focus();
        return;
      }

      renderPipeline();
      stageBadge.textContent = STAGE_LABELS[currentStage];
      updateDescription();
    }

    async function callAI() {
      if (!aiEnabled || !currentTheme) return;

      aiBtn.setAttribute("aria-busy", "true");
      if (aiBtnText) aiBtnText.textContent = "Loading\u2026";

      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 5000);

        const res = await fetch("/api/ai/track-lab", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            feature: "build-sprint",
            theme: currentTheme,
            currentStage,
          }),
          signal: controller.signal,
        });

        clearTimeout(timeout);

        if (!res.ok) throw new Error("not ok");
        const data = await res.json();

        if (data.stages && Array.isArray(data.stages)) {
          aiDescriptions = data.stages;
        } else if (typeof data.description === "string") {
          if (!aiDescriptions) {
            const fallback = THEMES[currentTheme].stages.slice();
            aiDescriptions = fallback;
          }
          aiDescriptions[currentStage] = data.description;
        }

        updateDescription();
        show(aiTag);
      } catch {
        updateDescription();
      } finally {
        aiBtn.setAttribute("aria-busy", "false");
        if (aiBtnText) aiBtnText.textContent = "AI Assist";
      }
    }

    function resetSprint() {
      currentTheme = "";
      currentStage = 0;
      aiDescriptions = null;

      pills.forEach((pill) => pill.setAttribute("aria-pressed", "false"));
      resetPipeline();
      hide(aiTag);

      hide(done);
      hide(board);
      show(intro);
      
      // Focus first pill for keyboard users
      pills[0]?.focus();
    }

    pills.forEach((pill) => {
      pill.addEventListener("click", () => selectTheme(pill.dataset.bsTheme!));
    });

    advanceBtn.addEventListener("click", advanceStage);

    if (aiBtn) aiBtn.addEventListener("click", callAI);
    resetBtn.addEventListener("click", resetSprint);
  }

  initBuildSprint();
</script>

