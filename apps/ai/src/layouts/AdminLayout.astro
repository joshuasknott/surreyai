---
export const prerender = false;
import '../styles/admin.css';
import { getSocietyById } from '@surreysocieties/admin';

interface Props {
  title: string;
  societyId: string;
  currentPath: string;
}

const { title, societyId, currentPath } = Astro.props;
const user = Astro.locals.user;
const society = getSocietyById(societyId);

const navItems = [
  { href: '/admin/events', label: 'Events', icon: 'calendar' },
  { href: '/admin/committee', label: 'Committee', icon: 'users' },
  { href: '/admin/past-committee', label: 'Past Committee', icon: 'users' },
  { href: '/admin/admins', label: 'Admins', icon: 'shield' },
  { href: '/admin/settings', label: 'Settings', icon: 'settings' },
];

function isActive(href: string): boolean {
  return currentPath.startsWith(href);
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logos/brand/surrey-ai-avatar-light.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title} - {society?.name || 'Admin'}</title>
  </head>
  <body class="admin-body">
    <div class="admin-layout">
      <aside class="admin-sidebar" id="admin-sidebar">
        <div class="admin-sidebar-logo">
          <img src="/logos/brand/surrey-ai-avatar-light.png" alt="" />
          <span>{society?.shortName || 'Admin'}</span>
          <button id="admin-sidebar-close" class="admin-sidebar-close" type="button" aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 1.25rem; height: 1.25rem;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <nav class="admin-sidebar-nav">
          {navItems.map(item => (
            <a href={item.href} class:list={['admin-sidebar-link', { active: isActive(item.href) }]}>
              {item.icon === 'grid' && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V18ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z" /></svg>}
              {item.icon === 'calendar' && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>}
              {item.icon === 'users' && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>}
              {item.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>}
              {item.icon === 'settings' && <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a7.723 7.723 0 0 1 0 .255c-.007.378.138.75.43.992l1.005.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.397-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.145-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>}
              {item.label}
            </a>
          ))}
        </nav>
        <div style="padding: 0.75rem; border-top: 1px solid rgba(255,255,255,0.1);">
          <a href="/" class="admin-sidebar-link" style="font-size: 0.75rem; color: rgba(255,255,255,0.5);">
            Back to public site
          </a>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <button id="admin-menu-toggle" class="admin-menu-toggle" type="button" aria-controls="admin-sidebar" aria-expanded="false" aria-label="Toggle navigation menu">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
          <div class="admin-topbar-user">
            <span>{user?.name || 'Admin'}</span>
            <span style="color: var(--color-admin-text-muted);">({user?.role})</span>
            <button id="sign-out-btn" class="btn btn-ghost btn-sm">Logout</button>
          </div>
        </header>
        <div class="admin-content">
          <slot />
        </div>
      </div>
      <div id="admin-sidebar-backdrop" class="admin-sidebar-backdrop" hidden></div>
    </div>
    <script is:inline>
      const sidebar = document.getElementById('admin-sidebar');
      const menuToggle = document.getElementById('admin-menu-toggle');
      const sidebarClose = document.getElementById('admin-sidebar-close');
      const backdrop = document.getElementById('admin-sidebar-backdrop');

      function setMenuOpen(isOpen) {
        sidebar?.classList.toggle('open', isOpen);
        menuToggle?.setAttribute('aria-expanded', String(isOpen));
        if (backdrop) backdrop.hidden = !isOpen;
      }

      menuToggle?.addEventListener('click', function() {
        setMenuOpen(!sidebar?.classList.contains('open'));
      });
      sidebarClose?.addEventListener('click', function() {
        setMenuOpen(false);
      });
      backdrop?.addEventListener('click', function() { setMenuOpen(false); });
      sidebar?.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() { setMenuOpen(false); });
      });

      document.getElementById('sign-out-btn')?.addEventListener('click', async function() {
        if (window.Clerk) {
          await window.Clerk.signOut({ redirectUrl: '/admin/login' });
        }
      });

      document.querySelectorAll('[data-admin-upload]').forEach(function(input) {
        const hiddenField = document.querySelector(input.getAttribute('data-target') || '[name="imageStorageId"]');
        const statusEl = document.querySelector(input.getAttribute('data-status') || '#uploadStatus');
        const submitButtons = Array.from(document.querySelectorAll('form button[type="submit"]'));

        function setStatus(message, state) {
          if (!statusEl) return;
          statusEl.textContent = message;
          statusEl.classList.remove('is-success', 'is-error', 'is-loading');
          if (state) statusEl.classList.add(`is-${state}`);
        }

        function setUploading(isUploading) {
          submitButtons.forEach(function(button) {
            button.disabled = isUploading;
          });
        }

        input.addEventListener('change', function(event) {
          const file = event.target.files && event.target.files[0];
          if (!file) {
            setStatus('No new image selected.', '');
            return;
          }

          if (['image/jpeg', 'image/png', 'image/webp'].indexOf(file.type) === -1) {
            setStatus('Use a JPEG, PNG, or WebP image.', 'error');
            event.target.value = '';
            return;
          }

          if (file.size > 5 * 1024 * 1024) {
            setStatus('Choose an image under 5 MB.', 'error');
            event.target.value = '';
            return;
          }

          setStatus('Uploading image. Keep this page open until it finishes.', 'loading');
          setUploading(true);

          fetch('/api/admin/upload-url', { method: 'POST' })
            .then(function(response) {
              if (!response.ok) throw new Error('Upload URL request failed');
              return response.json();
            })
            .then(function(data) {
              if (!data.uploadUrl) throw new Error('Missing upload URL');
              return fetch(data.uploadUrl, {
                method: 'POST',
                headers: file.type ? { 'Content-Type': file.type } : {},
                body: file,
              });
            })
            .then(function(response) {
              if (!response.ok) throw new Error('Image upload failed');
              return response.json();
            })
            .then(function(data) {
              if (!data.storageId) throw new Error('Missing storage ID');
              if (hiddenField) hiddenField.value = data.storageId;
              setStatus('Image uploaded. Save the form to publish this change.', 'success');
            })
            .catch(function() {
              setStatus('Image upload failed. Check the file and try again, or use an image URL.', 'error');
              event.target.value = '';
            })
            .finally(function() {
              setUploading(false);
            });
        });
      });
    </script>
  </body>
</html>
