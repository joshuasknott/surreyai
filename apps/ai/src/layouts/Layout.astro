---
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import AssistantWidget from '@surreysocieties/ui/components/AssistantWidget';
import { ASSISTANT_CONFIGS } from '@surreysocieties/ui';
import { getSocietyById } from '@surreysocieties/admin/config';
import JoinCTA from '../components/home/JoinCTA.astro';
import BrandLogo from '../components/common/BrandLogo.astro';
import defaultOgImage from '../assets/generated/ai-surrey-campus-signal-sketch-hero.optimized.webp';

interface Props {
  title: string;
  description: string;
  /** Absolute URL to OG share image. Defaults to site-wide fallback. */
  ogImage?: string;
  /** Whether to hide the global Join CTA at the bottom of the page */
  hideCTA?: boolean;
}

const { title, description, ogImage, hideCTA = false } = Astro.props;
const resolvedOgImage = ogImage ?? new URL(defaultOgImage.src, Astro.site).toString();

const society = getSocietyById('ai')!;
const assistantConfig = ASSISTANT_CONFIGS.ai;
const siteName = society.name;
const fullTitle = `${title} — ${siteName}`;

// Canonical URL from Astro.site + current path
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#join', label: 'Join' },
];

const footerName = 'Surrey Artificial Intelligence Society';
---

<BaseLayout
  title={fullTitle}
  description={description}
  ogImage={resolvedOgImage}
  canonicalUrl={canonicalUrl}
  htmlClass="motion-safe:scroll-smooth"
  bodyClass="bg-ai-bg text-ai-fg font-sans min-h-screen flex flex-col"
>
  <Fragment slot="head">
    <link rel="icon" type="image/png" href="/logos/brand/surrey-ai-avatar-light.png" />
  </Fragment>

  <!-- Skip link -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-ai-surface focus:text-ai-fg focus:font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan shadow-lg rounded-lg">
    Skip to content
  </a>

  <!-- Navigation -->
  <header class="site-header sticky top-0 z-50 border-b border-ai-border">
    <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 sm:px-6">
      <a href="/" class="site-brand flex min-w-0 items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan" aria-label="Surrey Artificial Intelligence Society home">
        <BrandLogo variant="dark" compact priority />
      </a>

      <div class="flex items-center gap-4">
        <!-- Desktop nav -->
        <nav aria-label="Primary navigation" class="hidden md:flex items-center gap-1">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="site-nav-link px-3.5 py-2 text-sm font-semibold border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan transition-colors"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Mobile menu button -->
        <button
          type="button"
          id="ai-mobile-menu-btn"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="ai-mobile-menu"
          class="header-icon-button inline-flex h-11 w-11 items-center justify-center rounded-full border transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan md:hidden"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path id="ai-menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile nav -->
    <div id="ai-mobile-menu" class="mobile-navigation hidden md:hidden" role="region" aria-label="Mobile navigation">
      <nav aria-label="Primary mobile navigation" class="px-6 py-3 flex flex-col gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="px-4 py-3 text-base font-semibold rounded-xl border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main id="main-content" class="flex-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan" tabindex="-1">
    <slot />
  </main>

  <!-- Global CTA -->
  {!hideCTA && <JoinCTA />}

  <!-- Footer -->
  <footer class="site-footer mt-auto">
    <div class="mx-auto max-w-7xl px-6 py-12">
      <div class="grid sm:grid-cols-3 gap-8 mb-8">
        <div>
          <div class="footer-brand mb-5">
            <BrandLogo variant="light" priority />
          </div>
          <p class="text-sm leading-relaxed max-w-xs">
            A student-led community for anyone curious about artificial intelligence, machine learning and data science, whatever their degree or experience.
          </p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-widest text-ai-cyan">Established {society.establishedYear}</p>
        </div>
        <div>
          <h4 class="text-ai-fg font-semibold mb-3 text-sm">Explore</h4>
          <nav aria-label="Footer navigation" class="flex flex-col gap-2">
            {navLinks.map(link => (
              <a href={link.href} class="text-sm hover:text-ai-cyan transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan w-max rounded">{link.label}</a>
            ))}
          </nav>
        </div>
        <div>
          <h4 class="text-ai-fg font-semibold mb-3 text-sm">Connect</h4>
          <div class="flex flex-col gap-2 text-sm">
            <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-ai-cyan transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan w-max rounded">Instagram</a>
            <a href={`mailto:${society.contactEmail}`} class="hover:text-ai-cyan transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan w-max rounded">Email</a>
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="hover:text-ai-cyan transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan w-max rounded">Surrey Students&apos; Union</a>
            <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="hover:text-ai-cyan transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-cyan w-max rounded">Membership</a>
          </div>
        </div>
      </div>
      <div class="border-t border-ai-border pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
        <p>&copy; {new Date().getFullYear()} {footerName}.</p>
        <p class="text-ai-fg-muted">{society.domain}</p>
      </div>
    </div>
  </footer>

  <AssistantWidget config={assistantConfig} endpoint="/api/assistant/chat" />

  <script>
    // ── Mobile menu toggle ──
    const btn = document.getElementById('ai-mobile-menu-btn');
    const menu = document.getElementById('ai-mobile-menu');
    const icon = document.getElementById('ai-menu-icon');

    const closeMenu = () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.setAttribute('aria-label', 'Open navigation menu');
      if (icon) icon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    };

    btn?.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn?.setAttribute('aria-expanded', (!isExpanded).toString());

      // Update the aria-label to reflect available action
      btn?.setAttribute(
        'aria-label',
        isExpanded ? 'Open navigation menu' : 'Close navigation menu'
      );

      if (isExpanded) {
        closeMenu();
      } else {
        menu?.classList.remove('hidden');
        if (icon) icon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      }
    });

    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  </script>
</BaseLayout>
