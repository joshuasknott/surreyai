---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist on the Surrey Artificial Intelligence Society website."
>
  <section class="bg-ai-bg text-ai-fg relative overflow-hidden flex items-center justify-center min-h-[70vh] border-b border-ai-border">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center relative z-10">
      <span class="font-mono-tech text-ai-cyan text-sm mb-6 block tracking-widest uppercase">
        Page Not Found
      </span>

      <h1 class="text-7xl sm:text-9xl font-black tracking-tight leading-none mb-6">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-ai-cyan to-ai-purple">404</span>
      </h1>

      <p class="text-ai-fg-muted text-sm sm:text-base leading-relaxed max-w-xl mx-auto mb-10">
        Sorry, we couldn't find the page you're looking for. It might have been moved or the link could be broken.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="px-8 py-3.5 bg-ai-cyan hover:bg-ai-cyan/90 text-black font-bold uppercase tracking-wide text-sm transition-all duration-200 border border-ai-cyan hover:shadow-[0_0_15px_rgba(6,182,212,0.5)] text-center"
        >
          Return Home
        </a>
        <a
          href="/events"
          class="px-8 py-3.5 bg-transparent hover:bg-ai-surface text-ai-fg font-bold uppercase tracking-wide text-sm border border-ai-border-strong transition-all duration-200 hover:shadow-[0_0_15px_rgba(139,92,246,0.3)] text-center"
        >
          View Events
        </a>
      </div>
    </div>
  </section>
</Layout>
