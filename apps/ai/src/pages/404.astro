---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="404 — Page Not Found"
  description="The page you're looking for doesn't exist on the Surrey Artificial Intelligence Society website."
>
  <section class="bg-navy-deep text-text-on-dark relative overflow-hidden flex items-center justify-center min-h-[70vh] border-b border-border-subtle">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center relative z-10">
      <span class="font-mono-tech text-accent-blue text-sm mb-6 block tracking-widest uppercase">
        [Error 404: Route Not Found]
      </span>

      <h1 class="text-7xl sm:text-9xl font-black tracking-tight leading-none mb-6">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-blue to-accent-purple">404</span>
      </h1>

      <p class="font-mono-tech text-text-secondary text-sm sm:text-base leading-relaxed max-w-xl mx-auto border-l-2 border-accent-purple/50 pl-4 text-left mb-10">
        The requested resource could not be located. This route does not exist in the system. Try navigating back to a known endpoint.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="px-8 py-3.5 bg-accent-blue hover:bg-accent-blue-light text-navy-deep font-bold uppercase tracking-wide text-sm transition-all duration-200 border border-accent-blue hover:shadow-[0_0_15px_rgba(6,182,212,0.5)] text-center"
        >
          Return Home
        </a>
        <a
          href="/events"
          class="px-8 py-3.5 bg-transparent hover:bg-surface-card text-text-on-dark font-bold uppercase tracking-wide text-sm border border-border-strong transition-all duration-200 hover:shadow-[0_0_15px_rgba(139,92,246,0.3)] text-center"
        >
          View Events
        </a>
      </div>
    </div>
  </section>
</Layout>
