---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="404 - Page Not Found"
  description="The page you're looking for does not exist on the Surrey Artificial Intelligence Society website."
>
  <section class="page-hero page-hero--center">
    <h1>404</h1>
    <p>
      This link does not point to a current Surrey AI Society page. Try the homepage, events, or joining route instead.
    </p>
    <div class="not-found-actions">
      <a href="/" class="btn-primary">Return home</a>
      <a href="/events" class="btn-secondary">View events</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero--center {
    min-height: 62vh;
    text-align: center;
  }

  .page-hero--center h1 {
    color: var(--ai-azure);
    font-size: clamp(6rem, 18vw, 14rem);
    line-height: 0.85;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
