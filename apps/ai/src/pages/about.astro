---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Picture } from "astro:assets";
import studentsWhiteboardCoding from "../assets/images/studentswhiteboardcoding.jpg";
import studentsCodingWorkshop from "../assets/images/studentscodingworkshop.jpg";
import '../styles/global.css';
---

<Layout title="About" description="Learn about Surrey Artificial Intelligence Society — our mission, values, and what members can expect from our student-led AI community.">

  <!-- Header -->
  <section class="bg-navy text-text-on-dark py-16 sm:py-20 px-6 relative overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <Picture
        src={studentsWhiteboardCoding}
        alt="Students collaborating at a whiteboard"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="w-full h-full object-cover"
        style={{ objectPosition: 'center 30%' }}
        pictureAttributes={{ class: 'w-full h-full block overflow-hidden' }}
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/90 to-navy/40"></div>
    </div>
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-8 h-px bg-accent-blue"></span>
        <span class="text-accent-blue text-sm font-semibold uppercase tracking-wider">About Us</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">About Surrey Artificial Intelligence Society</h1>
      <p class="mt-4 text-text-on-dark-secondary text-lg max-w-2xl">Understanding who we are, what we do, and why we exist.</p>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6">Our Mission</h2>
          <p class="text-text-secondary leading-relaxed mb-4">
            Surrey Artificial Intelligence Society exists to make artificial intelligence accessible, understandable, and engaging for students at the University of Surrey — regardless of their course or prior experience.
          </p>
          <p class="text-text-secondary leading-relaxed mb-4">
            We believe AI literacy will be important across every discipline. Whether you're studying computer science, law, medicine, business, or the arts, understanding how AI works and what it means for your field matters.
          </p>
        <div class="flex flex-col gap-6">
          <p class="text-text-secondary leading-relaxed">
            We're a student-led society under Surrey Students' Union, run by students who are passionate about technology and want to build a space where anyone can learn and contribute.
          </p>
          <div class="mt-4 relative h-64 sm:h-80 w-full overflow-hidden border border-border-subtle shadow-md">
            <Picture
              src={studentsCodingWorkshop}
              alt="Students coding together in a workshop"
              widths={[768, 1280]}
              sizes="(max-width: 768px) 100vw, 50vw"
              class="w-full h-full object-cover"
              pictureAttributes={{ class: 'absolute inset-0 w-full h-full block overflow-hidden' }}
            />
          </div>
        </div>
        </div>
        <div class="bg-surface-alt rounded-xl p-8 border border-navy/5">
          <h3 class="font-semibold text-lg mb-6 text-navy">What to Expect</h3>
          <ul class="space-y-4">
            <li class="flex gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-blue mt-2 shrink-0"></span>
              <span class="text-text-secondary text-sm leading-relaxed">Beginner-friendly workshops on machine learning, NLP, computer vision, and more</span>
            </li>
            <li class="flex gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-blue mt-2 shrink-0"></span>
              <span class="text-text-secondary text-sm leading-relaxed">Hands-on build nights and collaborative projects</span>
            </li>
            <li class="flex gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-blue mt-2 shrink-0"></span>
              <span class="text-text-secondary text-sm leading-relaxed">Discussions on AI ethics, policy, and societal impact</span>
            </li>
            <li class="flex gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-blue mt-2 shrink-0"></span>
              <span class="text-text-secondary text-sm leading-relaxed">Careers-focused events and industry insight sessions</span>
            </li>
            <li class="flex gap-3">
              <span class="w-1.5 h-1.5 rounded-full bg-accent-blue mt-2 shrink-0"></span>
              <span class="text-text-secondary text-sm leading-relaxed">A welcoming community of curious, motivated students</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Who It's For -->
  <section class="bg-surface-alt py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl sm:text-3xl font-bold mb-6">Who Is This For?</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="bg-surface-card rounded-xl p-6 border border-navy/5 shadow-sm">
          <h3 class="font-semibold mb-3">Complete Beginners</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Never touched AI before? That's completely fine. Many of our events are designed as starting points, with no prerequisites.</p>
        </div>
        <div class="bg-surface-card rounded-xl p-6 border border-navy/5 shadow-sm">
          <h3 class="font-semibold mb-3">Builders & Coders</h3>
          <p class="text-text-secondary text-sm leading-relaxed">If you already code and want to apply your skills to AI projects, our build nights and project groups are for you.</p>
        </div>
        <div class="bg-surface-card rounded-xl p-6 border border-navy/5 shadow-sm">
          <h3 class="font-semibold mb-3">Thinkers & Debaters</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Interested in the ethics, policy, or societal implications of AI? We host discussions and panels on these topics too.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-2xl sm:text-3xl font-bold mb-8">Our Principles</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 font-bold text-sm">01</div>
          <div>
            <h3 class="font-semibold mb-1">Accessibility First</h3>
            <p class="text-text-secondary text-sm leading-relaxed">Every event should be approachable. We don't gatekeep knowledge.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 font-bold text-sm">02</div>
          <div>
            <h3 class="font-semibold mb-1">Responsible AI</h3>
            <p class="text-text-secondary text-sm leading-relaxed">We care about how AI is built and deployed, not just what it can do.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 font-bold text-sm">03</div>
          <div>
            <h3 class="font-semibold mb-1">Learn by Doing</h3>
            <p class="text-text-secondary text-sm leading-relaxed">Theory matters, but building things teaches you faster.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 font-bold text-sm">04</div>
          <div>
            <h3 class="font-semibold mb-1">Cross-Disciplinary</h3>
            <p class="text-text-secondary text-sm leading-relaxed">AI touches every field. We welcome students from all backgrounds.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
