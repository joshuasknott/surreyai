---
return Astro.redirect('/#about', 302);
export const prerender = true;
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import aboutHero from "../assets/generated/ai-about-campus-sketch-hero.optimized.webp";
import "../styles/global.css";

const principles = [
  {
    title: "Open to every level and discipline",
    text: "The society is built for expert coders, curious beginners, and students from computing, business, health, arts, law, science, and any other background.",
  },
  {
    title: "Hands-on where possible",
    text: "Members should be able to learn by doing: writing notebooks, testing models, exploring datasets, building prototypes, and comparing outputs together.",
  },
  {
    title: "Impact is part of the technical work",
    text: "Responsible use, bias, accessibility, data quality, privacy, and human consequences are treated as practical design questions, not optional extras.",
  },
];

const pathways = [
  {
    title: "Learn the foundations",
    text: "Plain-language sessions connect Python, machine learning, data science, generative AI, evaluation, and ethics without assuming everyone starts from computer science.",
  },
  {
    title: "Build and compete",
    text: "Challenges, project nights, and prototypes give members something concrete to test, critique, improve, and show in a portfolio.",
  },
  {
    title: "Connect and reflect",
    text: "Talks, career conversations, socials, and discussions help members meet people while thinking clearly about AI's role in work, research, and society.",
  },
];
---

<Layout
  title="About"
  description="Learn about Surrey Artificial Intelligence Society - our mission, values, and student-led approach to artificial intelligence."
>
  <section class="ai-photo-hero ai-photo-hero--about" aria-labelledby="about-title">
    <Image
      src={aboutHero}
      alt=""
      aria-hidden="true"
      class="ai-photo-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={72}
    />
    <div class="ai-photo-hero__inner">
      <div class="ai-photo-hero__copy">
        <p class="ai-photo-hero__eyebrow">About the society</p>
        <h1 id="about-title">About the society</h1>
        <p>
          Surrey AI Society is a student-led society under Surrey Students' Union. We make space for students to learn practical skills, work on data-driven projects, explore modern AI tools, and discuss how these systems affect the world around them.
        </p>
      </div>
    </div>
  </section>

  <section class="ai-section" aria-labelledby="mission-title">
    <div class="ai-section__inner mission-grid">
      <div class="mission-panel">
        <h2 id="mission-title">Our mission</h2>
        <p>
          AI literacy now reaches well beyond computing. It shapes study, work, creativity, research, and everyday decisions. We help students build enough understanding to take part with confidence, whether they are writing their first script or already experimenting with models.
        </p>
        <p>
          That means mixing beginner-friendly explainers with workshops, tutorials, competitions, project collaboration, career awareness, and enough ethical judgement to ask whether a system should be built at all.
        </p>
      </div>
      <div class="mission-proof" aria-label="Mission emphasis">
        <article>
          <span>Learn</span>
          <strong>Plain language before jargon.</strong>
        </article>
        <article>
          <span>Build</span>
          <strong>Small prototypes before hype.</strong>
        </article>
        <article>
          <span>Question</span>
          <strong>Impact before autopilot.</strong>
        </article>
      </div>
    </div>
  </section>

  <section class="ai-section ai-section--tinted" aria-labelledby="principles-title">
    <div class="ai-section__inner">
      <div class="ai-section__header">
        <h2 id="principles-title" class="section-title">How we work</h2>
        <p class="section-intro">
          Each activity should help students understand something, make something, meet someone, or judge a technology more clearly than before.
        </p>
      </div>

      <div class="principle-list">
        {principles.map((principle, index) => (
          <article class="principle-row">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ai-section" aria-labelledby="route-title">
    <div class="ai-section__inner">
      <div class="ai-section__header ai-section__header--split">
        <div>
          <h2 id="route-title" class="section-title">Ways to get involved</h2>
        </div>
        <p class="section-intro">
          The society should be clear enough for a beginner, useful enough for a builder, relevant enough for career-minded students, and serious enough for anyone thinking about impact.
        </p>
      </div>

      <div class="route-grid">
        {pathways.map((pathway) => (
          <article>
            <span aria-hidden="true"></span>
            <h3>{pathway.title}</h3>
            <p>{pathway.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .mission-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(18rem, 0.58fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .mission-panel {
    max-width: 58rem;
    border-left: 4px solid var(--ai-azure);
    padding-left: clamp(1.25rem, 4vw, 2rem);
  }

  .mission-panel h2 {
    margin: 0 0 1rem;
    color: var(--ai-fg);
    font-size: clamp(1.75rem, 3.6vw, 3.1rem);
    letter-spacing: 0;
    line-height: 1.1;
  }

  .mission-panel p {
    margin: 0;
    color: var(--ai-fg-muted);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .mission-panel p + p {
    margin-top: 1rem;
  }

  .mission-proof {
    display: grid;
    align-content: center;
    gap: 1px;
    border: 1px solid var(--ai-border);
    border-radius: 1.2rem;
    overflow: hidden;
    background: var(--ai-border);
  }

  .mission-proof article {
    padding: clamp(1.1rem, 3vw, 1.5rem);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-azure) 8%, transparent), transparent 44%),
      var(--ai-surface);
  }

  .mission-proof article:nth-child(2) {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-sage) 8%, transparent), transparent 44%),
      var(--ai-surface);
  }

  .mission-proof article:nth-child(3) {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-coral) 8%, transparent), transparent 44%),
      var(--ai-surface);
  }

  .mission-proof span {
    display: block;
    color: var(--ai-azure);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .mission-proof strong {
    display: block;
    margin-top: 0.45rem;
    color: var(--ai-fg);
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .principle-list {
    border-top: 1px solid var(--ai-border);
  }

  .principle-row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .principle-row {
    border-bottom: 1px solid var(--ai-border);
  }

  .principle-row > span {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .principle-row h3,
  .route-grid h3 {
    margin: 0 0 0.45rem;
    color: var(--ai-fg);
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  .principle-row p,
  .route-grid p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.6;
  }

  .route-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 2.25rem);
  }

  .route-grid article {
    padding-top: 1.4rem;
    border-top: 3px solid var(--ai-azure);
  }

  .route-grid article:nth-child(2) {
    border-top-color: var(--ai-sage);
  }

  .route-grid article:nth-child(3) {
    border-top-color: var(--ai-coral);
  }

  @media (max-width: 760px) {
    .mission-grid,
    .principle-row,
    .route-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
