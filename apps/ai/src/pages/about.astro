---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import AnimatedHero from '../components/common/AnimatedHero.astro';
import '../styles/global.css';
---

<Layout title="About" description="Learn about Surrey Artificial Intelligence Society — our mission, values, and what members can expect from our student-led AI community.">

  <AnimatedHero title="Why we built this society." centered={true} />

  <!-- Mission -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg relative z-10 border-b border-ai-border">
    <div class="mx-auto max-w-5xl relative bg-ai-surface border border-ai-border rounded-[1.5rem] p-8 sm:p-16 overflow-hidden shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_20px_rgba(0,0,0,0.02)] backdrop-blur-md">
      <div class="absolute inset-0 bg-gradient-to-br from-ai-azure/5 to-ai-coral/5 pointer-events-none"></div>
      
      <div class="relative z-10">
        <div class="mb-10 pb-10 border-b border-ai-border/50">
          <p class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-ai-fg leading-tight max-w-4xl">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-ai-azure to-ai-coral">AI literacy</span> is no longer just for computer scientists. It is a fundamental requirement for law, medicine, arts, and business.
          </p>
        </div>
        
        <div class="grid sm:grid-cols-2 gap-8 sm:gap-16 text-lg sm:text-xl leading-relaxed text-ai-fg-muted">
          <p>
            <strong class="text-ai-fg font-semibold">Surrey Artificial Intelligence Society</strong> exists to make artificial intelligence accessible, understandable, and engaging for students — regardless of course or prior experience. We believe that understanding how AI works and what it means for your field matters more than ever.
          </p>
          <p>
            As a student-led society under the Surrey Students' Union, we provide a space to learn, debate, and build — with <strong class="text-ai-fg font-semibold">no gatekeeping and no jargon</strong>. We welcome arts, humanities, and business students just as much as computer science students.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg relative z-10">
    <div class="mx-auto max-w-7xl">
      <div class="mb-16">
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">Our Approach</h2>
        <p class="text-ai-fg-muted text-lg leading-relaxed max-w-2xl">The values that shape how we run the society — practically, not just on paper.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <article class="relative bg-ai-surface border border-ai-border rounded-[1.5rem] p-8 overflow-hidden group transition-all duration-300 hover:-translate-y-1 hover:border-ai-border-strong shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_20px_rgba(0,0,0,0.02)] backdrop-blur-md">
          <div class="absolute inset-0 bg-[var(--ai-coral)] opacity-0 group-hover:opacity-[0.15] blur-[60px] scale-150 transition-opacity duration-500 pointer-events-none"></div>
          <div class="relative z-10">
            <h3 class="text-2xl font-bold mb-4 text-ai-fg tracking-tight">Beginner Friendly</h3>
            <p class="text-ai-fg-muted leading-relaxed text-base">Every event should be approachable. We don't gatekeep knowledge or use unnecessary jargon. If a concept is complex, we break it down. We actively recruit and welcome students from non-STEM backgrounds to ensure diverse perspectives.</p>
          </div>
        </article>
        
        <article class="relative bg-ai-surface border border-ai-border rounded-[1.5rem] p-8 overflow-hidden group transition-all duration-300 hover:-translate-y-1 hover:border-ai-border-strong shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_20px_rgba(0,0,0,0.02)] backdrop-blur-md">
          <div class="absolute inset-0 bg-[var(--ai-azure)] opacity-0 group-hover:opacity-[0.15] blur-[60px] scale-150 transition-opacity duration-500 pointer-events-none"></div>
          <div class="relative z-10">
            <h3 class="text-2xl font-bold mb-4 text-ai-fg tracking-tight">Project Driven</h3>
            <p class="text-ai-fg-muted leading-relaxed text-base">Theory matters, but building things teaches you faster. We emphasize practical application over purely academic lectures, hosting build nights and workshops designed to give you hands-on experience.</p>
          </div>
        </article>
        
        <article class="relative bg-ai-surface border border-ai-border rounded-[1.5rem] p-8 overflow-hidden group transition-all duration-300 hover:-translate-y-1 hover:border-ai-border-strong shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_20px_rgba(0,0,0,0.02)] backdrop-blur-md">
          <div class="absolute inset-0 bg-[var(--ai-sage)] opacity-0 group-hover:opacity-[0.15] blur-[60px] scale-150 transition-opacity duration-500 pointer-events-none"></div>
          <div class="relative z-10">
            <h3 class="text-2xl font-bold mb-4 text-ai-fg tracking-tight">Ethically Grounded</h3>
            <p class="text-ai-fg-muted leading-relaxed text-base">We care about how AI is built and deployed, not just what it can do. Safety, bias, and ethics are regular topics of our discussions. We think about the long-term impacts of the systems we build.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

</Layout>
