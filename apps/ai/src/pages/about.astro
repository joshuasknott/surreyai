---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Picture } from "astro:assets";
import studentsWhiteboardCoding from "../assets/images/studentswhiteboardcoding.jpg";
import studentsCodingWorkshop from "../assets/images/studentscodingworkshop.jpg";
import '../styles/global.css';
---

<Layout title="About" description="Learn about Surrey Artificial Intelligence Society — our mission, values, and what members can expect from our student-led AI community.">

  <!-- Header -->
  <header class="bg-ai-bg text-ai-fg py-16 sm:py-24 px-6 relative border-b border-ai-border overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
      <Picture
        src={studentsWhiteboardCoding}
        alt="Students collaborating on a whiteboard"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="w-full h-full object-cover"
        style={{ objectPosition: 'center 30%' }}
        pictureAttributes={{ class: 'w-full h-full block overflow-hidden' }}
      />
    </div>
    <div class="mx-auto max-w-5xl relative z-10">
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="w-8 h-px bg-ai-purple"></span>
        <span class="font-mono-tech text-ai-purple text-sm font-semibold uppercase tracking-wider">Overview</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight mb-6">About the Society</h1>
      <p class="text-ai-fg-muted text-xl max-w-2xl leading-relaxed">
        Demystifying artificial intelligence, fostering discussion, and building the next generation of technical literacy at the University of Surrey.
      </p>
    </div>
  </header>

  <!-- Mission -->
  <section class="py-16 sm:py-24 px-6 bg-ai-surface text-ai-fg border-b border-ai-border">
    <div class="mx-auto max-w-5xl">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <section>
          <h2 class="text-3xl font-bold mb-8 font-mono-tech text-ai-cyan">Our Mission</h2>
          <div class="space-y-6 text-ai-fg-muted leading-relaxed text-lg">
            <p>
              Surrey Artificial Intelligence Society exists to make artificial intelligence accessible, understandable, and engaging for students — regardless of their course or prior experience.
            </p>
            <p>
              We believe AI literacy will be critical across every discipline. Whether you're studying computer science, law, medicine, business, or the arts, understanding how AI works and what it means for your field matters.
            </p>
            <p>
              As a student-led society under the Surrey Students' Union, we provide a space to learn, debate, and build.
            </p>
          </div>
          
          <div class="mt-8 border border-ai-border bg-ai-bg p-6">
            <h3 class="font-bold text-lg mb-4 font-mono-tech">What We Run</h3>
            <ul class="space-y-3 font-mono-tech text-sm text-ai-fg-muted">
              <li class="flex items-start gap-2"><span class="text-ai-cyan">>&nbsp;</span>Beginner-friendly ML & NLP workshops</li>
              <li class="flex items-start gap-2"><span class="text-ai-cyan">>&nbsp;</span>Hands-on hackathons and build nights</li>
              <li class="flex items-start gap-2"><span class="text-ai-cyan">>&nbsp;</span>AI ethics, policy, and impact panels</li>
              <li class="flex items-start gap-2"><span class="text-ai-cyan">>&nbsp;</span>Industry insight and careers sessions</li>
            </ul>
          </div>
        </section>

        <div class="relative h-64 sm:h-[500px] w-full border border-ai-border overflow-hidden">
          <Picture
            src={studentsCodingWorkshop}
            alt="Students collaborating at a coding workshop"
            widths={[768, 1280]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="w-full h-full object-cover"
            pictureAttributes={{ class: 'absolute inset-0 w-full h-full block overflow-hidden' }}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Target Audience -->
  <section class="bg-ai-bg py-16 sm:py-24 px-6 border-b border-ai-border text-ai-fg">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold mb-12 font-mono-tech">Who It's For</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        <article class="border border-ai-border p-8 hover:border-ai-cyan transition-colors bg-ai-surface">
          <div class="text-ai-cyan font-mono-tech mb-4">01</div>
          <h3 class="font-bold text-lg mb-3">Beginners</h3>
          <p class="text-ai-fg-muted text-sm leading-relaxed">Never touched AI before? That's completely fine. Many of our events are designed as starting points, with no prerequisites or coding required.</p>
        </article>
        <article class="border border-ai-border p-8 hover:border-ai-cyan transition-colors bg-ai-surface">
          <div class="text-ai-cyan font-mono-tech mb-4">02</div>
          <h3 class="font-bold text-lg mb-3">Builders</h3>
          <p class="text-ai-fg-muted text-sm leading-relaxed">If you already code and want to apply your skills to AI projects, our build nights, hackathons, and project groups provide the perfect sandbox.</p>
        </article>
        <article class="border border-ai-border p-8 hover:border-ai-cyan transition-colors bg-ai-surface">
          <div class="text-ai-cyan font-mono-tech mb-4">03</div>
          <h3 class="font-bold text-lg mb-3">Thinkers</h3>
          <p class="text-ai-fg-muted text-sm leading-relaxed">Interested in the ethics, policy, or societal implications of AI? We host debates and panels focusing on the philosophical and regulatory side.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-3xl font-bold mb-12 font-mono-tech">Our Principles</h2>
      <div class="grid sm:grid-cols-2 gap-8">
        <div class="flex gap-6 border-l border-ai-purple pl-6 py-2">
          <div>
            <h3 class="font-bold text-lg mb-2">Accessibility First</h3>
            <p class="text-ai-fg-muted leading-relaxed">Every event should be approachable. We don't gatekeep knowledge or use unnecessary jargon. If a concept is complex, we break it down.</p>
          </div>
        </div>
        <div class="flex gap-6 border-l border-ai-cyan pl-6 py-2">
          <div>
            <h3 class="font-bold text-lg mb-2">Responsible AI</h3>
            <p class="text-ai-fg-muted leading-relaxed">We care about how AI is built and deployed, not just what it can do. Safety, bias, and ethics are regular topics of our discussions.</p>
          </div>
        </div>
        <div class="flex gap-6 border-l border-ai-cyan pl-6 py-2">
          <div>
            <h3 class="font-bold text-lg mb-2">Learn by Doing</h3>
            <p class="text-ai-fg-muted leading-relaxed">Theory matters, but building things teaches you faster. We emphasize practical application over purely academic lectures.</p>
          </div>
        </div>
        <div class="flex gap-6 border-l border-ai-purple pl-6 py-2">
          <div>
            <h3 class="font-bold text-lg mb-2">Cross-Disciplinary</h3>
            <p class="text-ai-fg-muted leading-relaxed">AI touches every field. We actively recruit and welcome students from non-STEM backgrounds to ensure diverse perspectives.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
