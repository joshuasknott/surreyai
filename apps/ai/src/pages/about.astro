---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import CutoutVisual from "../components/common/CutoutVisual.astro";
import aboutLiteracyCutout from "../assets/generated/ai-about-literacy-cutout.png";
import "../styles/global.css";

const principles = [
  {
    title: "Open to every discipline",
    text: "The society is built for students who are curious about AI and data science, whether they arrive from computing, business, health, arts, law, or somewhere else entirely.",
  },
  {
    title: "Project-led where possible",
    text: "Members should be able to see ideas become prototypes: small tools, experiments, demos, analyses, and creative uses that can be discussed and improved.",
  },
  {
    title: "Impact is part of the work",
    text: "Responsible use, bias, accessibility, data quality, and human consequences are treated as practical design questions, not optional extras.",
  },
];

const pathways = [
  {
    title: "Learn the field",
    text: "Plain-language sessions connect models, datasets, evaluation, and ethics without assuming everyone starts from computer science.",
  },
  {
    title: "Build in public",
    text: "Small demos and prototypes give members something concrete to test, critique, and improve together.",
  },
  {
    title: "Discuss consequences",
    text: "Bias, accessibility, reliability, privacy, and creative work stay part of the same conversation as the technical material.",
  },
];
---

<Layout
  title="About"
  description="Learn about Surrey Artificial Intelligence and Data Science Society - our mission, values, and student-led approach to AI and data science."
>
  <section class="about-hero">
    <div class="about-hero__inner">
      <div class="about-hero__copy">
        <h1>AI and data science should feel possible to start, useful to build, and responsible to question.</h1>
        <p>
          Surrey AI and DS is a student-led society under Surrey Students' Union. We create space for students to learn the ideas, build practical projects, and discuss how AI and data science affect the world around them.
        </p>
      </div>
      <CutoutVisual
        image={aboutLiteracyCutout}
        alt="Open notebook, model cards, magnifying glass, balance objects, and tablet for responsible AI literacy"
        title="Literacy, usefulness, and impact belong together."
        body="The society treats AI as something students can inspect, shape, and question."
        align="right"
        compact
        loading="eager"
      />
    </div>
  </section>

  <section class="ai-section" aria-labelledby="mission-title">
    <div class="ai-section__inner mission-grid">
      <div class="mission-panel">
        <h2 id="mission-title">Make AI literacy social, practical, and honest.</h2>
        <p>
          AI literacy is no longer only a computing topic. It now shapes study, work, creativity, research, public services, and everyday decisions. The society helps students build enough understanding to participate with confidence.
        </p>
        <p>
          That means mixing beginner-friendly explainers with real tools, visible data, and enough ethical pressure to ask whether a system should be built at all.
        </p>
      </div>
      <div class="mission-proof" aria-label="Mission emphasis">
        <article>
          <span>Learn</span>
          <strong>Plain language before jargon.</strong>
        </article>
        <article>
          <span>Build</span>
          <strong>Small prototypes before hype.</strong>
        </article>
        <article>
          <span>Question</span>
          <strong>Impact before autopilot.</strong>
        </article>
      </div>
    </div>
  </section>

  <section class="ai-section ai-section--tinted" aria-labelledby="principles-title">
    <div class="ai-section__inner">
      <div class="ai-section__header">
        <h2 id="principles-title" class="section-title">A society with standards, not just ambition.</h2>
        <p class="section-intro">
          Each activity should help students understand something, make something, or judge something more clearly than before.
        </p>
      </div>

      <div class="principle-list">
        {principles.map((principle, index) => (
          <article class="principle-row">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ai-section" aria-labelledby="route-title">
    <div class="ai-section__inner">
      <div class="ai-section__header ai-section__header--split">
        <div>
          <h2 id="route-title" class="section-title">Different students need different first steps.</h2>
        </div>
        <p class="section-intro">
          The society should be clear enough for a beginner, useful enough for a builder, and serious enough for students thinking about impact.
        </p>
      </div>

      <div class="route-grid">
        {pathways.map((pathway) => (
          <article>
            <span aria-hidden="true"></span>
            <h3>{pathway.title}</h3>
            <p>{pathway.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    position: relative;
    overflow: clip;
    padding: clamp(4.5rem, 8vw, 7rem) 1.25rem clamp(3.5rem, 7vw, 5rem);
    background:
      radial-gradient(circle at 80% 26%, color-mix(in srgb, var(--ai-azure) 15%, transparent), transparent 22rem),
      linear-gradient(180deg, color-mix(in srgb, var(--ai-surface) 60%, var(--ai-bg)), var(--ai-bg));
    color: var(--ai-fg);
    border-bottom: 1px solid var(--ai-border);
  }

  .about-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(22rem, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    width: min(100%, 82rem);
    margin: 0 auto;
  }

  .about-hero__copy {
    max-width: 62rem;
  }

  .about-hero h1 {
    margin: 0;
    color: var(--ai-fg);
    font-size: clamp(2.7rem, 5.2vw, 5.2rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1;
  }

  .about-hero p {
    max-width: 43rem;
    margin: 1.35rem 0 0;
    color: var(--ai-fg-muted);
    font-size: 1.12rem;
    line-height: 1.65;
  }

  .mission-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(18rem, 0.58fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .mission-panel {
    max-width: 58rem;
    border-left: 4px solid var(--ai-azure);
    padding-left: clamp(1.25rem, 4vw, 2rem);
  }

  .mission-panel h2 {
    margin: 0 0 1rem;
    color: var(--ai-fg);
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    letter-spacing: 0;
    line-height: 1.03;
  }

  .mission-panel p {
    margin: 0;
    color: var(--ai-fg-muted);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .mission-panel p + p {
    margin-top: 1rem;
  }

  .mission-proof {
    display: grid;
    align-content: center;
    gap: 1px;
    border: 1px solid var(--ai-border);
    border-radius: 1.2rem;
    overflow: hidden;
    background: var(--ai-border);
  }

  .mission-proof article {
    padding: clamp(1.1rem, 3vw, 1.5rem);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-azure) 8%, transparent), transparent 44%),
      var(--ai-surface);
  }

  .mission-proof article:nth-child(2) {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-sage) 8%, transparent), transparent 44%),
      var(--ai-surface);
  }

  .mission-proof article:nth-child(3) {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-coral) 8%, transparent), transparent 44%),
      var(--ai-surface);
  }

  .mission-proof span {
    display: block;
    color: var(--ai-azure);
    font-size: 0.78rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .mission-proof strong {
    display: block;
    margin-top: 0.45rem;
    color: var(--ai-fg);
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .principle-list {
    border-top: 1px solid var(--ai-border);
  }

  .principle-row {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .principle-row {
    border-bottom: 1px solid var(--ai-border);
  }

  .principle-row > span {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .principle-row h3,
  .route-grid h3 {
    margin: 0 0 0.45rem;
    color: var(--ai-fg);
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  .principle-row p,
  .route-grid p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.6;
  }

  .route-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 2.25rem);
  }

  .route-grid article {
    padding-top: 1.4rem;
    border-top: 3px solid var(--ai-azure);
  }

  .route-grid article:nth-child(2) {
    border-top-color: var(--ai-sage);
  }

  .route-grid article:nth-child(3) {
    border-top-color: var(--ai-coral);
  }

  @media (max-width: 760px) {
    .about-hero__inner,
    .mission-grid,
    .principle-row,
    .route-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
