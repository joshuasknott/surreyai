---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { generateCsrfToken } from '@surreysocieties/admin';

const SOCIETY_ID = 'ai';
const user = Astro.locals.user!;
const client = Astro.locals.convexClient;
const isManager = user.role === 'owner' || user.role === 'protectedAdmin' || user.role === 'admin';
const csrfToken = generateCsrfToken(user._id);

const members: any[] = isManager ? await client.query("memberships:listBySociety", { societySlug: SOCIETY_ID }) : [];
const invitations: any[] = isManager ? await client.query("memberships:listInvitations", { societySlug: SOCIETY_ID }) : [];
const pendingInvitations = invitations.filter(i => i.status === 'pending');

const success = Astro.url.searchParams.get('success');
const invited = Astro.url.searchParams.get('invited');

const removeResult = Astro.getActionResult(actions.admin.removeAdmin);
const revokeResult = Astro.getActionResult(actions.admin.revokeInvite);
const actionSuccess = (removeResult && !removeResult.error) || (revokeResult && !revokeResult.error);

function formatRole(role: string): string {
  if (role === 'protectedAdmin') return 'Protected Admin';
  return role.charAt(0).toUpperCase() + role.slice(1);
}
---
<AdminLayout title="Admin Users" societyId={SOCIETY_ID} currentPath="/admin/admins">

  <div class="admin-page-header">
    <div><h1 class="admin-page-title">Admin Users</h1><p class="admin-page-description">Manage who can edit this society and copy pending invite links for manual sharing.</p></div>
    {isManager && <a href="/admin/admins/invite" class="btn btn-primary">Invite Admin</a>}
  </div>

  {(success || actionSuccess) && <div class="alert alert-success">Admin action completed.</div>}
  {invited && <div class="alert alert-success">Invitation sent.</div>}

  {isManager ? (
    <>
  <div class="admin-table-wrapper" style="margin-bottom: 2.5rem;">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {members.map(member => (
          <tr>
            <td style="font-weight: 600;">{member.user?.name || 'Unknown'}</td>
            <td>{member.user?.email || 'No email'}</td>
            <td><span class={`pill pill-${member.role}`}>{formatRole(member.role)}</span></td>
            {isManager && (
              <td>
                {member.role !== 'owner' && (user.role === 'owner' || member.role !== 'protectedAdmin') && member.user?._id !== user._id && (
                  <form method="POST" action={actions.admin.removeAdmin} style="display:inline;" onsubmit="return confirm('Remove admin access for this user?')">
                    <input type="hidden" name="_csrf" value={csrfToken} />
                    <input type="hidden" name="userId" value={member.user?._id} />
                    <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-admin-danger);">Remove</button>
                  </form>
                )}
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {pendingInvitations.length > 0 ? (
    <>
      <h2 style="font-size: 1.125rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-admin-text);">Pending Invitations</h2>

      <div class="notice-card" style="margin-bottom: 1.5rem;">
        <strong>Manual sharing:</strong> Email notifications are not active. Copy the <em>Invite Link</em> below and send it to the invitee manually (e.g. via WhatsApp, Slack, or email). The link expires in 7 days.
      </div>

      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Email</th>
              <th>Role</th>
              <th>Expires</th>
              <th>Invite Link</th>
              {isManager && <th>Actions</th>}
            </tr>
          </thead>
          <tbody>
            {pendingInvitations.map(inv => {
              const fullAcceptUrl = new URL(`/admin/invite/accept?token=${inv.token}`, Astro.url).href;
              return (
                <tr>
                  <td>{inv.email}</td>
                  <td><span class={`pill pill-${inv.role}`}>{formatRole(inv.role)}</span></td>
                  <td>{new Date(inv.expiresAt).toLocaleDateString()}</td>
                  <td>
                    <div class="invite-link-row">
                      <input
                        type="text"
                        readonly
                        value={fullAcceptUrl}
                        class="form-input"

                        onclick="this.select();"
                      />
                      <button
                        class="btn btn-outline btn-sm copy-btn"
                        data-clipboard-text={fullAcceptUrl}
                        type="button"

                      >
                        Copy
                      </button>
                    </div>
                  </td>
                  {isManager && (
                    <td>
                      <form method="POST" action={actions.admin.revokeInvite} style="display:inline;">
                        <input type="hidden" name="_csrf" value={csrfToken} />
                        <input type="hidden" name="invitationId" value={inv._id} />
                        <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-admin-danger);">Revoke</button>
                      </form>
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </>
  ) : (
    <div class="notice-card">No pending invitations. New invite links will appear here until they are accepted, revoked, or expired.</div>
  )}
    </>
  ) : (
    <div class="admin-table-wrapper">
      <div class="empty-state">
        <div class="empty-state-title">Admin role required</div>
        <p>User and invitation management is available to society admins only.</p>
      </div>
    </div>
  )}

  <script is:inline>
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-clipboard-text');
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
          const originalText = btn.textContent;
          btn.textContent = 'Copied!';
          btn.classList.add('btn-success');
          setTimeout(() => {
            btn.textContent = originalText;
            btn.classList.remove('btn-success');
          }, 2000);
        }).catch(() => {
          const originalText = btn.textContent;
          btn.textContent = 'Copy failed';
          setTimeout(() => {
            btn.textContent = originalText;
          }, 2000);
        });
      });
    });
  </script>

</AdminLayout>
