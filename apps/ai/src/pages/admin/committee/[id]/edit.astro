---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { validateCommitteeInput, generateCsrfToken, verifyCsrfToken } from '@surreysocieties/admin';

const SOCIETY_ID = 'ai';
const { id } = Astro.params;
const client = Astro.locals.convexClient;

let member: any = await client.query("committee:getById", { id });

if (!member) return Astro.redirect('/admin/committee');

const userId = Astro.locals.user?._id || '';
const csrfToken = generateCsrfToken(userId);
let errors: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  if (!verifyCsrfToken(formData.get('_csrf')?.toString(), userId)) {
    errors._csrf = 'Invalid or expired form submission. Please try again.';
  } else {
    const input = {
      name: formData.get('name')?.toString() || '',
      role: formData.get('role')?.toString() || '',
      bio: formData.get('bio')?.toString() || '',
      image: formData.get('image')?.toString() || '',
      imageStorageId: formData.get('imageStorageId')?.toString() || '',
      email: formData.get('email')?.toString() || '',
      linkedIn: formData.get('linkedIn')?.toString() || '',
      displayOrder: formData.get('displayOrder')?.toString() ? parseInt(formData.get('displayOrder')!.toString()) : undefined,
      isActive: formData.get('isActive') !== 'false',
    };

  const validation = validateCommitteeInput(input, true);
  if (validation.valid) {
    await client.mutation("committee:update", {
      societySlug: SOCIETY_ID,
      memberId: member._id,
      ...input,
    });
    return Astro.redirect('/admin/committee?success=1');
  }
    errors = validation.errors;
    member = { ...member, ...input };
  }
}
---
<AdminLayout title="Edit Committee Member" societyId={SOCIETY_ID} currentPath="/admin/committee">

  <div class="admin-page-header">
    <h1 class="admin-page-title">Edit Committee Member</h1>
    <a href="/admin/committee" class="btn btn-outline">← Back</a>
  </div>

  <div class="form-card">
    <form method="POST">
      <input type="hidden" name="_csrf" value={csrfToken} />
      <div class="form-group">
        <label for="name" class="form-label">Name *</label>
        <input type="text" id="name" name="name" class="form-input" value={member.name} required />
        {errors.name && <div class="form-error">{errors.name}</div>}
      </div>

      <div class="form-group">
        <label for="role" class="form-label">Role *</label>
        <input type="text" id="role" name="role" class="form-input" value={member.role} required />
        {errors.role && <div class="form-error">{errors.role}</div>}
      </div>

      <div class="form-group">
        <label for="bio" class="form-label">Bio</label>
        <textarea id="bio" name="bio" class="form-textarea">{member.bio}</textarea>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" name="email" class="form-input" value={member.email} />
      </div>

      <div class="form-group">
        <label for="linkedIn" class="form-label">LinkedIn</label>
        <input type="url" id="linkedIn" name="linkedIn" class="form-input" value={member.linkedIn} />
      </div>

      <div class="form-group">
        <label class="form-label">Photo</label>
        {member.imageUrl && (
          <div style="margin-bottom: 0.5rem;">
            <img src={member.imageUrl} alt="Current photo" style="max-width: 200px; max-height: 200px; border-radius: 8px;" />
          </div>
        )}
        <input type="file" id="imageFile" accept="image/jpeg,image/png,image/webp" />
        <input type="hidden" name="imageStorageId" value={member.imageStorageId || ''} />
        <div id="uploadStatus" style="font-size: 0.875rem; margin-top: 0.25rem;"></div>
      </div>
      <div class="form-group">
        <label for="image" class="form-label">Or image URL (fallback)</label>
        <input type="text" id="image" name="image" class="form-input" value={member.image || ''} />
      </div>

      <div class="form-group">
        <label for="displayOrder" class="form-label">Display Order</label>
        <input type="number" id="displayOrder" name="displayOrder" class="form-input" value={member.displayOrder} />
      </div>

      <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/admin/committee" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>

<script is:inline>
(function() {
  var fileInput = document.getElementById('imageFile');
  var hiddenField = document.querySelector('[name="imageStorageId"]');
  var statusEl = document.getElementById('uploadStatus');
  if (!fileInput) return;
  fileInput.addEventListener('change', function(e) {
    var file = e.target.files[0];
    if (!file) return;
    if (['image/jpeg','image/png','image/webp'].indexOf(file.type) === -1) {
      statusEl.textContent = 'Only JPEG, PNG, and WebP images are allowed.';
      statusEl.style.color = 'red';
      e.target.value = '';
      return;
    }
    if (file.size > 5 * 1024 * 1024) {
      statusEl.textContent = 'File must be under 5MB.';
      statusEl.style.color = 'red';
      e.target.value = '';
      return;
    }
    statusEl.textContent = 'Uploading...';
    statusEl.style.color = '';
    fetch('/api/admin/upload-url', { method: 'POST' })
      .then(function(res) { if (!res.ok) throw new Error('Failed'); return res.json(); })
      .then(function(data) { return fetch(data.uploadUrl, { method: 'POST', body: file }); })
      .then(function(res) { if (!res.ok) throw new Error('Upload failed'); return res.json(); })
      .then(function(data) { hiddenField.value = data.storageId; statusEl.textContent = 'Image uploaded successfully.'; statusEl.style.color = 'green'; })
      .catch(function() { statusEl.textContent = 'Upload failed. Please try again.'; statusEl.style.color = 'red'; e.target.value = ''; });
  });
})();
</script>
</AdminLayout>
