---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getCommitteeMemberById, updateCommitteeMember, validateCommitteeInput } from '@surreysocieties/admin';

const SOCIETY_ID = 'ai';
const { id } = Astro.params;
let member = getCommitteeMemberById(SOCIETY_ID, id!);

if (!member) return Astro.redirect('/admin/committee');

let errors: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const input = {
    name: formData.get('name')?.toString() || '',
    role: formData.get('role')?.toString() || '',
    bio: formData.get('bio')?.toString() || '',
    image: formData.get('image')?.toString() || '',
    email: formData.get('email')?.toString() || '',
    linkedIn: formData.get('linkedIn')?.toString() || '',
    displayOrder: parseInt(formData.get('displayOrder')?.toString() || '0') || 0,
    isActive: formData.get('isActive') === 'on',
  };

  const validation = validateCommitteeInput(input, true);
  if (validation.valid) {
    updateCommitteeMember(SOCIETY_ID, id!, input);
    return Astro.redirect('/admin/committee?success=1');
  }
  errors = validation.errors;
  member = { ...member, ...input };
}
---
<AdminLayout title="Edit Committee Member" societyId={SOCIETY_ID} currentPath="/admin/committee">

  <div class="admin-page-header">
    <h1 class="admin-page-title">Edit Committee Member</h1>
    <a href="/admin/committee" class="btn btn-outline">← Back</a>
  </div>

  <div class="form-card">
    <form method="POST">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="name" class="form-label">Name *</label>
          <input type="text" id="name" name="name" class="form-input" value={member.name} required />
          {errors.name && <div class="form-error">{errors.name}</div>}
        </div>
        <div class="form-group">
          <label for="role" class="form-label">Role *</label>
          <input type="text" id="role" name="role" class="form-input" value={member.role} required />
          {errors.role && <div class="form-error">{errors.role}</div>}
        </div>
      </div>

      <div class="form-group">
        <label for="bio" class="form-label">Bio</label>
        <textarea id="bio" name="bio" class="form-textarea">{member.bio}</textarea>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input type="email" id="email" name="email" class="form-input" value={member.email} />
        </div>
        <div class="form-group">
          <label for="linkedIn" class="form-label">LinkedIn URL</label>
          <input type="url" id="linkedIn" name="linkedIn" class="form-input" value={member.linkedIn} />
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="image" class="form-label">Photo URL</label>
          <input type="text" id="image" name="image" class="form-input" value={member.image} />
        </div>
        <div class="form-group">
          <label for="displayOrder" class="form-label">Display Order</label>
          <input type="number" id="displayOrder" name="displayOrder" class="form-input" value={member.displayOrder} min="0" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-checkbox-row">
          <input type="checkbox" name="isActive" checked={member.isActive} />
          <span class="form-label" style="margin-bottom: 0;">Active member</span>
        </label>
      </div>

      <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/admin/committee" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>

</AdminLayout>
