---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { generateCsrfToken } from '@surreysocieties/admin';

const SOCIETY_ID = 'ai';
const client = Astro.locals.convexClient;
const csrfToken = generateCsrfToken(Astro.locals.user!._id);
const members: any[] = await client.query("committee:list", { societySlug: SOCIETY_ID });
const success = Astro.url.searchParams.get('success');
const deleted = Astro.url.searchParams.get('deleted');

const actionResult = Astro.getActionResult(actions.admin.deleteCommitteeMember);
const actionDeleted = actionResult && !actionResult.error;
const syncResult = Astro.getActionResult(actions.admin.syncCommitteeFromUnion);
---
<AdminLayout title="Committee" societyId={SOCIETY_ID} currentPath="/admin/committee">

  <div class="admin-page-header">
    <h1 class="admin-page-title">Committee Members</h1>
    <div class="table-actions">
      <form method="POST" action={actions.admin.syncCommitteeFromUnion}>
        <input type="hidden" name="_csrf" value={csrfToken} />
        <button type="submit" class="btn btn-outline">Refresh from Students' Union</button>
      </form>
      <a href="/admin/committee/new" class="btn btn-primary">+ Add Member</a>
    </div>
  </div>

  {success && <div class="alert alert-success">Committee member saved.</div>}
  {(deleted || actionDeleted) && <div class="alert alert-success">Committee member removed.</div>}
  {syncResult && !syncResult.error && <div class="alert alert-success">President, Vice President and Treasurer refreshed from the Students' Union.</div>}
  {syncResult?.error && <div class="alert alert-error">{syncResult.error.message}</div>}

  {members.length === 0 ? (
    <div class="admin-table-wrapper">
      <div class="empty-state">
        <div class="empty-state-title">No committee members yet</div>
        <p>Add your first committee member.</p>
        <a href="/admin/committee/new" class="btn btn-primary" style="margin-top: 1rem;">+ Add Member</a>
      </div>
    </div>
  ) : (
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Status</th>
            <th>Order</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {members.map(member => (
            <tr>
              <td style="font-weight: 600;">{member.name}</td>
              <td>{member.role}</td>
              <td><span class={`pill pill-${member.isActive ? 'active' : 'inactive'}`}>{member.isActive ? 'Active' : 'Inactive'}</span></td>
              <td>{member.displayOrder}</td>
              <td>
                <div class="table-actions">
                  <a href={`/admin/committee/${member._id}/edit`} class="btn btn-outline btn-sm">Edit</a>
                  <form method="POST" action={actions.admin.deleteCommitteeMember} style="display:inline;" onsubmit="return confirm('Remove this committee member?')">
                    <input type="hidden" name="_csrf" value={csrfToken} />
                    <input type="hidden" name="id" value={member._id} />
                    <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--color-admin-danger);">Remove</button>
                  </form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

</AdminLayout>
