---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { validateEventInput, EVENT_CATEGORIES, generateCsrfToken, verifyCsrfToken } from '@surreysocieties/admin';

const SOCIETY_ID = 'ai';
const userId = Astro.locals.user?._id || '';
const csrfToken = generateCsrfToken(userId);
let errors: Record<string, string> = {};
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const client = Astro.locals.convexClient;
  const formData = await Astro.request.formData();

  if (!verifyCsrfToken(formData.get('_csrf')?.toString(), userId)) {
    errors._csrf = 'Invalid or expired form submission. Please try again.';
  } else {
    const input = {
      title: formData.get('title')?.toString() || '',
      description: formData.get('description')?.toString() || '',
      date: formData.get('date')?.toString() || '',
      startTime: formData.get('startTime')?.toString() || '',
      endTime: formData.get('endTime')?.toString() || '',
      location: formData.get('location')?.toString() || '',
      category: formData.get('category')?.toString() || 'Other',
      image: formData.get('image')?.toString() || '',
      imageStorageId: formData.get('imageStorageId')?.toString() || '',
      registrationUrl: formData.get('registrationUrl')?.toString() || '',
      status: (formData.get('status')?.toString() || 'draft') as 'draft' | 'published',
      isFeatured: formData.get('isFeatured') === 'on',
    };

    values = input as unknown as Record<string, string>;

    const validation = validateEventInput(input);
    if (validation.valid) {
      await client.mutation("events:create", {
        societySlug: SOCIETY_ID,
        ...input,
      });
      return Astro.redirect('/admin/events?success=1');
    }
    errors = validation.errors;
  }
}
---
<AdminLayout title="Add Event" societyId={SOCIETY_ID} currentPath="/admin/events">

  <div class="admin-page-header">
    <h1 class="admin-page-title">Add Event</h1>
    <a href="/admin/events" class="btn btn-outline">Back to Events</a>
  </div>

  {errors._csrf && <div class="alert alert-error" style="color: var(--color-admin-danger); margin-bottom: 1rem;">{errors._csrf}</div>}

  <div class="form-card">
    <form method="POST">
      <input type="hidden" name="_csrf" value={csrfToken} />
      <div class="form-group">
        <label for="title" class="form-label">Title *</label>
        <input type="text" id="title" name="title" class="form-input" value={values.title || ''} required />
        {errors.title && <div class="form-error">{errors.title}</div>}
      </div>

      <div class="form-group">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="description" class="form-textarea">{values.description || ''}</textarea>
        <p class="form-hint">Use short, public-facing copy that can be scanned quickly.</p>
      </div>

      <div class="form-grid form-grid-3">
        <div class="form-group">
          <label for="date" class="form-label">Date</label>
          <input type="date" id="date" name="date" class="form-input" value={values.date || ''} />
          {errors.date && <div class="form-error">{errors.date}</div>}
        </div>
        <div class="form-group">
          <label for="startTime" class="form-label">Start time</label>
          <input type="time" id="startTime" name="startTime" class="form-input" value={values.startTime || ''} />

          {errors.startTime && <div class="form-error">{errors.startTime}</div>}</div>
        <div class="form-group">
          <label for="endTime" class="form-label">End time</label>
          <input type="time" id="endTime" name="endTime" class="form-input" value={values.endTime || ''} />

          {errors.endTime && <div class="form-error">{errors.endTime}</div>}</div>
      </div>

      <div class="form-group">
        <label for="location" class="form-label">Location</label>
        <input type="text" id="location" name="location" class="form-input" value={values.location || ''} />
      </div>

      <div class="form-grid form-grid-2">
        <div class="form-group">
          <label for="category" class="form-label">Category</label>
          <select id="category" name="category" class="form-select">
            {EVENT_CATEGORIES.map(cat => (
              <option value={cat} selected={values.category === cat}>{cat}</option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label for="status" class="form-label">Status</label>
          <select id="status" name="status" class="form-select">
            <option value="draft" selected={values.status !== 'published'}>Draft - hidden from public site</option>
            <option value="published" selected={values.status === 'published'}>Published - visible to students</option>
          </select>
          {errors.status && <div class="form-error">{errors.status}</div>}
          <p class="form-hint">Published events are visible to students immediately.</p>
        </div>
      </div>

      <div class="form-group">
        <label for="registrationUrl" class="form-label">Registration URL</label>
        <input type="url" id="registrationUrl" name="registrationUrl" class="form-input" value={values.registrationUrl || ''} placeholder="https://" />
        {errors.registrationUrl && <div class="form-error">{errors.registrationUrl}</div>}
      </div>

      <div class="form-group">
        <label class="form-label">Photo</label>
        <div class="upload-field"><input type="file" id="imageFile" accept="image/jpeg,image/png,image/webp" data-admin-upload data-target="[name='imageStorageId']" data-status="#uploadStatus" />
        <input type="hidden" name="imageStorageId" value="" />
        <div id="uploadStatus" class="upload-status" role="status">Optional. JPEG, PNG, or WebP under 5 MB.</div></div>
      </div>
      <div class="form-group">
        <label for="image" class="form-label">Image URL fallback</label>
        <input type="text" id="image" name="image" class="form-input" value={values.image || ''} placeholder="https:// or /path/to/image" />

        <p class="form-hint">Use this only when you are not uploading a file.</p>
        {errors.image && <div class="form-error">{errors.image}</div>}</div>

      <div class="form-group">
        <label class="form-checkbox-row">
          <input type="checkbox" name="isFeatured" checked={values.isFeatured === 'on'} />
          <span class="form-label" style="margin-bottom: 0;">Feature this event</span>
        </label>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create Event</button>
        <a href="/admin/events" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>


</AdminLayout>
