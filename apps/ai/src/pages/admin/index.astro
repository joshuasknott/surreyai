---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';

const SOCIETY_ID = 'ai';
const user = Astro.locals.user!;
const client = Astro.locals.convexClient;

const events: any[] = await client.query('events:list', { societySlug: SOCIETY_ID });
const committee: any[] = await client.query('committee:list', { societySlug: SOCIETY_ID });
const pastCommittee: any[] = await client.query('committee:listPastForAdmin', { societySlug: SOCIETY_ID });
const members: any[] = await client.query('memberships:listBySociety', { societySlug: SOCIETY_ID });
const settingsData = await client.query('settings:getSettings', { societySlug: SOCIETY_ID });
const society = settingsData?.society;

const now = new Date();
const publishedEvents = events.filter((event) => event.status === 'published');
const draftEvents = events.filter((event) => event.status === 'draft');
const upcomingEvents = publishedEvents.filter((event) => !event.date || new Date(event.date) >= now);
const activeMembers = committee.filter((member) => member.isActive);
const hasContact = Boolean(society?.contactEmail);
const hasJoinLink = Boolean(society?.membershipUrl || society?.studentsUnionUrl);
const settingsReady = hasContact && hasJoinLink;
const publishedReady = publishedEvents.length > 0 && activeMembers.length > 0 && settingsReady;

const nextActions = [
  ...(publishedEvents.length === 0 ? [{ href: '/admin/events/new', title: 'Publish a first event', body: 'Students will see published events on the public site. Drafts stay hidden.' }] : []),
  ...(draftEvents.length > 0 ? [{ href: '/admin/events', title: 'Review draft events', body: `${draftEvents.length} event${draftEvents.length === 1 ? '' : 's'} waiting as draft.` }] : []),
  ...(activeMembers.length === 0 ? [{ href: '/admin/committee/new', title: 'Add active committee records', body: 'Active committee members appear on the public committee section.' }] : []),
  ...(!settingsReady ? [{ href: '/admin/settings', title: 'Complete public contact settings', body: 'Contact and membership links help students reach the society from the public site.' }] : []),
];
---
<AdminLayout title="Dashboard" societyId={SOCIETY_ID} currentPath="/admin">
  <div class="admin-page-header">
    <div>
      <h1 class="admin-page-title">Dashboard</h1>
      <p class="admin-page-description">Check what is visible on the public site and jump to the next useful admin task.</p>
    </div>
  </div>

  <div class="status-grid">
    <div class="status-card">
      <div class="status-card-title">
        <span>Public site state</span>
        <span class:list={['pill', publishedReady ? 'pill-published' : 'pill-draft']}>{publishedReady ? 'Ready' : 'Needs content'}</span>
      </div>
      <p>{publishedReady ? 'Events, committee records, and contact settings are in place.' : 'Add published content and settings before sending students to the public pages.'}</p>
    </div>
    <div class="status-card">
      <div class="status-card-title">
        <span>Published events</span>
        <span class:list={['pill', publishedEvents.length > 0 ? 'pill-published' : 'pill-draft']}>{publishedEvents.length > 0 ? 'Visible' : 'Empty'}</span>
      </div>
      <p>{publishedEvents.length > 0 ? `${publishedEvents.length} published event${publishedEvents.length === 1 ? '' : 's'}; ${upcomingEvents.length} upcoming.` : 'No events are visible to students yet.'}</p>
    </div>
    <div class="status-card">
      <div class="status-card-title">
        <span>Committee section</span>
        <span class:list={['pill', activeMembers.length > 0 ? 'pill-active' : 'pill-inactive']}>{activeMembers.length > 0 ? 'Active' : 'Empty'}</span>
      </div>
      <p>{activeMembers.length > 0 ? `${activeMembers.length} active committee member${activeMembers.length === 1 ? '' : 's'} listed.` : 'Add active committee members so students know who runs the society.'}</p>
    </div>
  </div>

  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-card-label">Upcoming Events</div>
      <div class="stat-card-value">{upcomingEvents.length}</div>
      <div class="stat-card-description">Published events dated today or later.</div>
    </div>
    <div class="stat-card">
      <div class="stat-card-label">Draft Events</div>
      <div class="stat-card-value">{draftEvents.length}</div>
      <div class="stat-card-description">Hidden until switched to Published.</div>
    </div>
    <div class="stat-card">
      <div class="stat-card-label">Active Committee</div>
      <div class="stat-card-value">{activeMembers.length}</div>
      <div class="stat-card-description">Visible in the current committee section.</div>
    </div>
    <div class="stat-card">
      <div class="stat-card-label">Admin Users</div>
      <div class="stat-card-value">{members.length}</div>
      <div class="stat-card-description">People with access to this admin area.</div>
    </div>
    <div class="stat-card">
      <div class="stat-card-label">Past Committee</div>
      <div class="stat-card-value">{pastCommittee.length}</div>
      <div class="stat-card-description">Archived committee records grouped by year or term.</div>
    </div>
  </div>

  <div class="admin-section-header">
    <div>
      <h2 class="admin-section-title">Next actions</h2>
      <p class="admin-section-description">Start with the item that affects public clarity most.</p>
    </div>
    <div class="quick-actions">
      <a href="/admin/events/new" class="btn btn-primary">Add Event</a>
      <a href="/admin/committee/new" class="btn btn-outline">Add Committee Member</a>
      {(user.role === 'owner' || user.role === 'protectedAdmin' || user.role === 'admin') && (
        <a href="/admin/admins/invite" class="btn btn-outline">Invite Admin</a>
      )}
    </div>
  </div>

  {nextActions.length > 0 ? (
    <div class="next-action-list">
      {nextActions.map((action) => (
        <div class="next-action">
          <div>
            <strong>{action.title}</strong>
            <span>{action.body}</span>
          </div>
          <a href={action.href} class="btn btn-outline btn-sm">Open</a>
        </div>
      ))}
    </div>
  ) : (
    <div class="notice-card">No urgent admin tasks detected. Keep events fresh and review settings when contact details change.</div>
  )}
</AdminLayout>
