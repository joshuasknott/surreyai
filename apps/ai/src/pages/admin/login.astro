---
export const prerender = false;
import { getSocietyById } from '@surreysocieties/admin';
import '../../styles/admin.css';

const SOCIETY_ID = 'ai';
const society = getSocietyById(SOCIETY_ID);

const { userId } = Astro.locals.auth();
if (userId) return Astro.redirect('/admin');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>Login — {society?.name || 'Admin'}</title>
  </head>
  <body class="admin-body">
    <div class="login-container">
      <div class="login-card">
        <div class="login-logo">
          <img src={society?.logo || '/favicon.svg'} alt="" />
          <h1>{society?.shortName || 'Admin'}</h1>
          <p>Admin Dashboard</p>
        </div>
        <div id="clerk-sign-in"></div>
        <p style="margin-top: 1rem; text-align: center;">
          <a href="/" style="color: var(--color-admin-primary);">← Back to public site</a>
        </p>
      </div>
    </div>
  </body>
  <script is:inline>
    (function() {
      var interval = setInterval(function() {
        if (window.Clerk && window.Clerk.isReady && window.Clerk.isReady()) {
          clearInterval(interval);
          window.Clerk.openSignIn({
            element: '#clerk-sign-in',
            redirectUrl: '/admin'
          });
        }
      }, 100);
    })();
  </script>
</html>
