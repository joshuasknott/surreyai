---
export const prerender = false;
import { getSocietyById } from '@surreysocieties/admin';
import { SignIn } from '@clerk/astro/components';
import '../../styles/admin.css';

const SOCIETY_ID = 'ai';
const society = getSocietyById(SOCIETY_ID);

const { userId } = Astro.locals.auth();
if (userId) return Astro.redirect('/admin');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logos/ai-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>Login - {society?.name || 'Admin'}</title>
  </head>
  <body class="admin-body">
    <div class="login-container">
      <div style="display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 400px; gap: 1rem;">
        <div class="login-logo" style="margin-bottom: 0;">
          <img src={society?.logo || '/logos/ai-logo.png'} alt="" />
          <h1>{society?.shortName || 'Admin'}</h1>
          <p>Admin Dashboard</p>
        </div>
        <SignIn fallbackRedirectUrl="/admin" />
        <p style="margin-top: 1rem; text-align: center;">
          <a href="/" style="color: var(--color-admin-primary); text-decoration: none; font-size: 0.875rem;">Back to public site</a>
        </p>
      </div>
    </div>
  </body>
</html>
