---
export const prerender = false;
import CampusQuestShell from '../components/campus-quest/CampusQuestShell.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VibeCooking Caf&eacute; &mdash; Surrey AI Society</title>
    <meta name="description" content="Walk through a cozy first-person cafe prototype and collect a coffee at the counter." />
    <link rel="icon" type="image/png" href="/logos/optimized/ai-logo.optimized.png" />
    <link rel="canonical" href="https://surreyaisociety.org/campus-quest" />
    <meta name="robots" content="noindex" />
    <style>
      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #0f0d0a;
      }
    </style>
  </head>
  <body>
    <CampusQuestShell />
  </body>
</html>
