---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AnimatedHero from '../components/common/AnimatedHero.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'ai';
const client = createConvexClient();
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );
const pastCommittee: any[] = (await client.query("committee:listPast", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (b.yearLabel || '').localeCompare(a.yearLabel || '') ||
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
    (a.name || '').localeCompare(b.name || '')
  );
const pastCommitteeYears = [...new Set(pastCommittee.map(member => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};
---

<Layout title="Committee" description="Meet the student committee running Surrey Artificial Intelligence Society — the team behind our workshops, events, and community.">

  <AnimatedHero 
    title="Meet the people running the society."
    description="Student volunteers who plan and run the society — organising workshops, events, and everything in between."
    centered={true}
  />

  <!-- Committee Grid -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg relative z-10">
    <div class="mx-auto max-w-7xl">
      {committee.length === 0 ? (
        <div class="premium-card p-10 text-center" style="--card-brand-color: var(--ai-azure);">
          <!-- Cybernetic Corner Brackets -->
          <div class="corner-tick top-left"></div>
          <div class="corner-tick top-right"></div>
          <div class="corner-tick bottom-left"></div>
          <div class="corner-tick bottom-right"></div>
          <div class="premium-glow"></div>
          <div class="premium-grid opacity-30"></div>
          <div class="premium-scan"></div>

          <div class="relative z-10">
            <h2 class="text-2xl font-bold mb-4 text-ai-fg">Committee details will appear here once confirmed</h2>
            <p class="text-ai-fg-muted leading-relaxed mb-6 max-w-2xl mx-auto text-lg">
              Our current committee roster will be published once confirmed through the Surrey Students' Union.
            </p>
            <a href="/join" class="btn-primary">
              Learn about joining the society
            </a>
          </div>
        </div>
      ) : (
        <div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {committee.map((member, i) => {
              const colors = ['var(--ai-coral)', 'var(--ai-azure)', 'var(--ai-sage)'];
              const glowColor = colors[i % colors.length];
              return (
                <article class="premium-card items-center text-center p-6 group" style={`--card-brand-color: ${glowColor};`}>
                  <!-- Cybernetic Corner Brackets -->
                  <div class="corner-tick top-left"></div>
                  <div class="corner-tick top-right"></div>
                  <div class="corner-tick bottom-left"></div>
                  <div class="corner-tick bottom-right"></div>

                  <!-- Luminescent Glow, Grid, and Sweep Scan -->
                  <div class="premium-glow"></div>
                  <div class="premium-grid opacity-20"></div>
                  <div class="premium-scan"></div>

                  <div class="relative z-10 w-full flex flex-col items-center h-full justify-between">
                    
                    <div class="flex flex-col items-center w-full">
                      <!-- Cyber Profile Photo Frame -->
                      <div class="relative w-28 h-28 mb-6 group/photo">
                        <!-- Cybernetic decorative rings -->
                        <div class="absolute inset-0 rounded-full border border-dashed border-ai-border/80 group-hover:border-[var(--card-brand-color)]/50 group-hover:rotate-90 transition-all duration-1000 ease-out"></div>
                        <div class="absolute -inset-1 rounded-full border border-ai-border/30 group-hover:border-[var(--card-brand-color)]/30 group-hover:scale-105 transition-all duration-300"></div>
                        <!-- Status indicator dot -->
                        <div class="absolute top-1 right-1 w-3.5 h-3.5 rounded-full bg-[var(--card-brand-color)] shadow-[0_0_8px_var(--card-brand-color)] border-2 border-ai-bg z-20 animate-pulse"></div>

                        <!-- Main profile image mask -->
                        <div class="absolute inset-2 rounded-full overflow-hidden border border-ai-border/80 bg-ai-surface relative z-10 group-hover/photo:scale-[1.02] transition-transform duration-300">
                          {member.imageUrl ? (
                            <img src={member.imageUrl} alt={member.name || member.role} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center text-[var(--card-brand-color)] font-bold text-2xl">
                              {getInitials(member.name, member.role)}
                            </div>
                          )}
                        </div>
                      </div>

                      <h2 class="font-bold text-xl text-ai-fg mb-1 group-hover:text-[var(--card-brand-color)] transition-colors duration-300 line-clamp-1">{member.name || 'Pending Confirmation'}</h2>
                      <p class="text-ai-fg-muted text-[11px] font-bold uppercase tracking-widest">{member.role}</p>
                    </div>

                    <!-- Cyber Monospace Signature metadata -->
                    <div class="mt-6 pt-4 border-t border-ai-border/30 w-full flex items-center justify-between text-[10px] font-mono-tech text-ai-fg-muted uppercase tracking-wider">
                      <span>SEC // AI-2026</span>
                      <span class="text-[var(--card-brand-color)] font-bold">CONFIRMED</span>
                    </div>

                  </div>
                </article>
              );
            })}
          </div>
        </div>
      )}

      {pastCommittee.length > 0 && (
        <div class="mt-24 pt-16 border-t border-ai-border">
          <div class="mb-12">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-ai-fg tracking-tight">Past Committee</h2>
          </div>
          <div class="space-y-16">
            {pastCommitteeYears.map(yearLabel => (
              <section>
                <h3 class="font-bold text-2xl text-ai-fg mb-6">{yearLabel}</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                  {pastCommittee.filter(member => member.yearLabel === yearLabel).map((member, i) => {
                    const colors = ['var(--ai-sage)', 'var(--ai-coral)', 'var(--ai-azure)'];
                    const glowColor = colors[i % colors.length];
                    return (
                      <article class="premium-card p-4 flex flex-row items-center gap-4 group" style={`--card-brand-color: ${glowColor};`}>
                        <!-- Cybernetic Corner Brackets -->
                        <div class="corner-tick top-left"></div>
                        <div class="corner-tick top-right"></div>
                        <div class="corner-tick bottom-left"></div>
                        <div class="corner-tick bottom-right"></div>

                        <!-- Luminescent Glow and Grid -->
                        <div class="premium-glow"></div>
                        <div class="premium-grid opacity-15"></div>

                        <div class="relative z-10 flex flex-row items-center gap-4 w-full">
                          
                          <!-- Cyber mini frame -->
                          <div class="relative w-12 h-12 shrink-0">
                            <div class="absolute inset-0 rounded-full border border-dashed border-ai-border/60 group-hover:rotate-45 transition-transform duration-700"></div>
                            <div class="absolute inset-1 rounded-full overflow-hidden border border-ai-border/80 bg-ai-surface z-10">
                              {member.imageUrl ? (
                                <img src={member.imageUrl} alt={member.name || member.role} class="w-full h-full object-cover" />
                              ) : (
                                <div class="w-full h-full flex items-center justify-center text-[var(--card-brand-color)] font-bold text-[10px]">
                                  {getInitials(member.name, member.role)}
                                </div>
                              )}
                            </div>
                          </div>

                          <div class="overflow-hidden">
                            <h4 class="font-semibold text-base text-ai-fg truncate group-hover:text-[var(--card-brand-color)] transition-colors duration-300">{member.name || 'Pending Confirmation'}</h4>
                            <p class="text-ai-fg-muted text-[10px] uppercase tracking-wider font-bold mt-0.5 truncate">{member.role}</p>
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
