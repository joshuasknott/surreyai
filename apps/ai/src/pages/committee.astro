---
export const prerender = false;
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { queryPublicConvex } from "@surreysocieties/admin";
import { api } from "../../../../convex/_generated/api.js";
import { getSocietyById } from "@surreysocieties/admin/config";
import committeeHero from "../assets/generated/ai-events-campus-sketch-hero.optimized.webp";
import "../styles/global.css";

const SOCIETY_ID = "ai";
Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=3600");
const society = getSocietyById(SOCIETY_ID)!;
const [committeeResult, pastCommitteeResult] = await Promise.all([
  queryPublicConvex(api.committee.listActive, { societySlug: SOCIETY_ID }, []),
  queryPublicConvex(api.committee.listPast, { societySlug: SOCIETY_ID }, []),
]);
const committee: any[] = committeeResult
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || "").localeCompare(b.name || "")
  );
const pastCommittee: any[] = pastCommitteeResult
  .sort((a: any, b: any) =>
    (b.yearLabel || "").localeCompare(a.yearLabel || "")
    || (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || "").localeCompare(b.name || "")
  );
const pastCommitteeYears = [...new Set(pastCommittee.map((member) => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || "?").trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return "?";
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join("").toUpperCase();
};

const operatingModel = [
  {
    title: "Programme planning",
    text: "Choose workshops, tutorials, challenges, project sessions, talks, socials, and discussion topics that are useful for different levels of experience.",
  },
  {
    title: "Member support",
    text: "Make routes into artificial intelligence visible for beginners, builders, researchers, career-minded students, and members from non-computing disciplines.",
  },
  {
    title: "Responsible delivery",
    text: "Keep accessibility, data quality, safeguarding, and social impact in view when activities are planned and promoted.",
  },
];

---
return Astro.redirect('/#join', 302);

<Layout
  title="Committee"
  description="Meet the student committee running Surrey Artificial Intelligence Society and shaping its workshops, projects, competitions, talks, socials, and responsible AI activity."
>
  <section
    class="ai-photo-hero ai-photo-hero--committee"
    aria-labelledby="committee-hero-title"
  >
    <Image
      src={committeeHero}
      alt=""
      aria-hidden="true"
      class="ai-photo-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={72}
    />
    <div class="ai-photo-hero__inner">
      <div class="ai-photo-hero__copy">
        <p class="ai-photo-hero__eyebrow">Committee</p>
      <h1 id="committee-hero-title">Meet the committee</h1>
      <p>
        The committee turns student interest into workshops, tutorials, challenges, projects, discussions, socials, and clear routes into the society. Named records appear here once committee members add them.
      </p>
    </div>
    </div>
  </section>

  <section class="ai-section ai-section--tinted" aria-labelledby="leadership-title">
    <div class="ai-section__inner">
      <div class="ai-section__header ai-section__header--split">
        <h2 id="leadership-title" class="section-title">What the committee does</h2>
        <p class="section-intro">
          The page is less about headshots and more about the system of work: programming, inclusion, project momentum, career relevance, community, and responsible delivery.
        </p>
      </div>

      <div class="leadership-list">
        {operatingModel.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ai-section" aria-labelledby="committee-title">
    <div class="ai-section__inner">
      <div class="ai-section__header ai-section__header--split">
        <div>
          <h2 id="committee-title" class="section-title">Current committee</h2>
          <p class="section-intro">Committee records appear once the team is ready to share them publicly.</p>
        </div>
        <a href={`mailto:${society.contactEmail}`} class="text-link">Contact the society &rarr;</a>
      </div>

      {committee.length === 0 ? (
        <div class="committee-empty">
          <h3>Committee details will appear here once confirmed.</h3>
          <p>
            The current roster will be published once committee members add it. Until then, use the Students' Union page or email for verified contact routes.
          </p>
          <div class="committee-empty__actions">
            <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Students' Union page</a>
            <a href={`mailto:${society.contactEmail}`} class="btn-secondary">Email the society</a>
          </div>
        </div>
      ) : (
        <div class="committee-grid">
          {committee.map((member) => (
            <article class="person-card">
              <div class="person-card__avatar">
                {member.imageUrl ? (
                  <img src={member.imageUrl} alt={member.name || member.role} />
                ) : (
                  <span>{getInitials(member.name, member.role)}</span>
                )}
              </div>
              <div>
                <h3>{member.name || "Pending confirmation"}</h3>
                <p>{member.role}</p>
              </div>
            </article>
          ))}
        </div>
      )}

      {pastCommittee.length > 0 && (
        <div class="past-committee">
          <div class="ai-section__header">
            <h2 class="section-title">Past committee</h2>
          </div>
          {pastCommitteeYears.map((yearLabel) => (
            <section class="past-year">
              <h3>{yearLabel}</h3>
              <div class="committee-grid committee-grid--compact">
                {pastCommittee.filter((member) => member.yearLabel === yearLabel).map((member) => (
                  <article class="person-card person-card--compact">
                    <div class="person-card__avatar">
                      {member.imageUrl ? (
                        <img src={member.imageUrl} alt={member.name || member.role} />
                      ) : (
                        <span>{getInitials(member.name, member.role)}</span>
                      )}
                    </div>
                    <div>
                      <h3>{member.name || "Pending confirmation"}</h3>
                      <p>{member.role}</p>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .committee-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 8rem) 1.25rem clamp(3rem, 6vw, 5rem);
  }

  .committee-hero__copy h1 {
    margin: 0;
    color: var(--ai-fg);
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .committee-hero__copy p {
    max-width: 42rem;
    margin: 1.3rem 0 0;
    color: var(--ai-fg-muted);
    font-size: 1.12rem;
    line-height: 1.65;
  }

  .leadership-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .leadership-list article {
    border-top: 3px solid var(--ai-azure);
    padding-top: 1.25rem;
  }

  .leadership-list article:nth-child(2) {
    border-top-color: var(--ai-sage);
  }

  .leadership-list article:nth-child(3) {
    border-top-color: var(--ai-coral);
  }

  .leadership-list span {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .leadership-list h3 {
    margin: 0.75rem 0 0.45rem;
    color: var(--ai-fg);
    font-size: 1.2rem;
    letter-spacing: 0;
  }

  .leadership-list p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.6;
  }

  .committee-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--ai-border);
  }

  .person-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--ai-border);
    padding: 1rem 0;
  }

  .person-card__avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--ai-azure) 10%, var(--ai-surface));
    color: var(--ai-azure);
    flex: 0 0 auto;
    font-weight: 850;
  }

  .person-card__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person-card h3 {
    margin: 0 0 0.25rem;
    color: var(--ai-fg);
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .person-card p {
    margin: 0;
    color: var(--ai-fg-muted);
    font-weight: 700;
  }

  .past-committee {
    margin-top: 5rem;
    padding-top: 4rem;
    border-top: 1px solid var(--ai-border);
  }

  .past-year + .past-year {
    margin-top: 2.5rem;
  }

  .past-year h3 {
    color: var(--ai-fg);
    font-size: 1.4rem;
    letter-spacing: 0;
  }

  .person-card--compact .person-card__avatar {
    width: 2.6rem;
    height: 2.6rem;
    font-size: 0.85rem;
  }

  .committee-empty {
    max-width: 58rem;
    border-top: 1px solid var(--ai-border);
    padding-top: clamp(1.6rem, 4vw, 2.4rem);
  }

  .committee-empty h3 {
    margin: 0 0 0.85rem;
    color: var(--ai-fg);
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .committee-empty p {
    color: var(--ai-fg-muted);
    line-height: 1.65;
  }

  .committee-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.6rem;
  }

  @media (max-width: 840px) {
    .committee-hero,
    .leadership-list {
      grid-template-columns: 1fr;
    }
  }
</style>
