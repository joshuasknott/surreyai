---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'ai';
const client = createConvexClient();
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );
const pastCommittee: any[] = (await client.query("committee:listPast", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (b.yearLabel || '').localeCompare(a.yearLabel || '') ||
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
    (a.name || '').localeCompare(b.name || '')
  );
const pastCommitteeYears = [...new Set(pastCommittee.map(member => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};
---

<Layout title="Committee" description="Meet the student committee running Surrey Artificial Intelligence Society — the team behind our workshops, events, and community.">

  <section class="bg-ai-bg text-ai-fg border-b border-ai-border">
    <div class="mx-auto max-w-5xl px-6 pt-10 pb-8 sm:pt-14 sm:pb-10">
      <span class="text-ai-purple text-xs font-semibold uppercase tracking-widest block mb-3">Leadership</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-[1.1] mb-4">The Committee</h1>
      <p class="text-ai-fg-muted text-base sm:text-lg leading-relaxed max-w-2xl">
        Student volunteers who plan and run the society — organising workshops, events, and everything in between.
      </p>
    </div>
  </section>

  <!-- Committee Grid -->
  <section class="py-10 sm:py-14 px-6 bg-ai-bg text-ai-fg">
    <div class="mx-auto max-w-5xl">
      {committee.length === 0 ? (
        <!-- Intentionally designed empty state -->
        <div class="bg-ai-surface border border-ai-border rounded-xl p-8">
          <h2 class="text-2xl font-bold mb-4 text-ai-fg">Committee details will appear here once confirmed</h2>
          <p class="text-ai-fg-muted leading-relaxed mb-5 max-w-2xl">
            Our current committee roster will be published once confirmed through the Surrey Students' Union.
          </p>
          <a href="/join" class="inline-flex items-center gap-2 text-sm font-semibold text-ai-purple hover:text-ai-purple/80 transition-colors">
            Learn about joining the society →
          </a>
        </div>
      ) : (
        <div>
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-ai-fg">Meet the Team</h2>
            <p class="mt-2 text-ai-fg-muted">The students directing Surrey Artificial Intelligence Society.</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {committee.map(member => (
              <article class="bg-ai-bg border border-ai-border rounded-xl p-6 flex flex-col hover:border-ai-purple transition-colors duration-200">
                {member.imageUrl ? (
                  <img src={member.imageUrl} alt={member.name || member.role} class="w-12 h-12 rounded-full object-cover mb-5" />
                ) : (
                  <div class="w-12 h-12 rounded-full bg-ai-purple/10 flex items-center justify-center text-ai-purple font-bold text-sm mb-5">
                    {getInitials(member.name, member.role)}
                  </div>
                )}
                <h2 class="font-semibold text-base text-ai-fg mb-1">{member.role}</h2>
                {member.name && <p class="text-ai-fg-muted text-sm">{member.name}</p>}
              </article>
            ))}
          </div>
        </div>
      )}

      <div class="mt-14 pt-8 border-t border-ai-border">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-ai-fg">Past Committee</h2>
          <p class="mt-2 text-ai-fg-muted">Confirmed previous committee records will appear here.</p>
        </div>
        {pastCommittee.length === 0 ? (
          <div class="bg-ai-surface border border-ai-border rounded-xl p-6">
            <h3 class="font-semibold text-base text-ai-fg mb-2">No past committee records yet</h3>
            <p class="text-ai-fg-muted text-sm">Past committee details will be published once confirmed.</p>
          </div>
        ) : (
          <div class="space-y-8">
            {pastCommitteeYears.map(yearLabel => (
              <section>
                <h3 class="font-semibold text-lg text-ai-fg mb-4">{yearLabel}</h3>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
                  {pastCommittee.filter(member => member.yearLabel === yearLabel).map(member => (
                    <article class="bg-ai-bg border border-ai-border rounded-xl p-5 flex items-start gap-4">
                      {member.imageUrl ? (
                        <img src={member.imageUrl} alt={member.name || member.role} class="w-10 h-10 rounded-full object-cover shrink-0" />
                      ) : (
                        <div class="w-10 h-10 rounded-full bg-ai-cyan/10 flex items-center justify-center text-ai-cyan font-bold text-xs shrink-0">
                          {getInitials(member.name, member.role)}
                        </div>
                      )}
                      <div>
                        <h4 class="font-semibold text-sm text-ai-fg">{member.role}</h4>
                        <p class="text-ai-fg-muted text-sm mt-1">{member.name}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>

      <div class="mt-14 pt-8 border-t border-ai-border">
        <h3 class="font-semibold text-lg mb-3 text-ai-fg">Get Involved</h3>
        <p class="text-ai-fg-muted text-sm max-w-xl mb-5">
          Interested in helping run the society or volunteering at events? We welcome students from any course who want to contribute.
        </p>
        <a href="/join" class="inline-flex items-center gap-2 text-ai-purple hover:text-ai-purple/80 text-sm font-semibold transition-colors">
          See membership details →
        </a>
      </div>
    </div>
  </section>

</Layout>
