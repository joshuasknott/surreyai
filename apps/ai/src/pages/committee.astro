---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AnimatedHero from '../components/common/AnimatedHero.astro';
import { createConvexClient } from '@surreysocieties/admin';
import { getSocietyById } from '@surreysocieties/admin/config';
import '../styles/global.css';

const SOCIETY_ID = 'ai';
const society = getSocietyById(SOCIETY_ID)!;
const client = createConvexClient();
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );
const pastCommittee: any[] = (await client.query("committee:listPast", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (b.yearLabel || '').localeCompare(a.yearLabel || '') ||
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
    (a.name || '').localeCompare(b.name || '')
  );
const pastCommitteeYears = [...new Set(pastCommittee.map(member => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};
---

<Layout title="Committee" description="Meet the student committee running Surrey Artificial Intelligence Society — the team behind our workshops, events, and community.">

  <AnimatedHero 
    title="Meet the people running the society."
    description="Student volunteers who plan and run the society — organising workshops, events, and everything in between."
    centered={true}
  />

  <!-- Committee Grid -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg relative z-10">
    <div class="mx-auto max-w-7xl">
      {committee.length === 0 ? (
        <div class="premium-card p-12 text-center" style="--card-brand-color: var(--ai-azure);">
          <div class="premium-glow"></div>

          <div class="relative z-10">
            <h2 class="text-2xl sm:text-3xl font-extrabold mb-4 text-ai-fg tracking-tight">Committee details will appear here once confirmed</h2>
            <p class="text-ai-fg-muted leading-relaxed mb-8 max-w-2xl mx-auto text-lg">
              Our current committee roster will be published once confirmed through the Surrey Students&apos; Union. In the meantime, get in touch via our socials.
            </p>
            <a href="/join" class="btn-primary">
              Learn about joining the society
            </a>
            <p class="text-ai-fg-muted text-sm mt-6">
              Follow us on <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-ai-azure hover:underline font-semibold">Instagram</a> · <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="text-ai-azure hover:underline font-semibold">Students&apos; Union</a>
            </p>
          </div>
        </div>
      ) : (
        <div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {committee.map((member, i) => {
              const colors = ['var(--ai-coral)', 'var(--ai-azure)', 'var(--ai-sage)'];
              const glowColor = colors[i % colors.length];
              return (
                <article class="premium-card items-center text-center p-7 group" style={`--card-brand-color: ${glowColor};`}>
                  <div class="premium-glow"></div>

                  <div class="relative z-10 w-full flex flex-col items-center h-full justify-between">
                    
                    <div class="flex flex-col items-center w-full">
                      <!-- Sleek Profile Photo Frame -->
                      <div class="relative w-28 h-28 mb-6 group/photo">
                        <!-- Premium gradient ring -->
                        <div class="absolute -inset-1.5 rounded-full bg-gradient-to-tr from-[var(--card-brand-color)]/25 to-transparent p-0.5 opacity-60 group-hover:opacity-100 transition-opacity duration-300"></div>
                        <div class="absolute inset-0 rounded-full border border-ai-border/40 bg-ai-bg"></div>

                        <!-- Main profile image mask -->
                        <div class="absolute inset-1.5 rounded-full overflow-hidden border border-ai-border/70 bg-ai-surface relative z-10 group-hover/photo:scale-[1.03] transition-transform duration-300">
                          {member.imageUrl ? (
                            <img src={member.imageUrl} alt={member.name || member.role} class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500" />
                          ) : (
                            <div class="w-full h-full flex items-center justify-center text-[var(--card-brand-color)] font-bold text-2xl">
                              {getInitials(member.name, member.role)}
                            </div>
                          )}
                        </div>
                      </div>

                      <h2 class="font-bold text-xl text-ai-fg mb-1 group-hover:text-[var(--card-brand-color)] transition-colors duration-300 line-clamp-1 tracking-tight">{member.name || 'Pending Confirmation'}</h2>
                      <p class="text-ai-fg-muted text-[11px] font-bold uppercase tracking-wider">{member.role}</p>
                    </div>

                    <!-- Committee year metadata -->
                    <div class="mt-6 pt-4 border-t border-ai-border/30 w-full flex items-center justify-between text-[11px] font-medium text-ai-fg-muted tracking-wide">
                      <span class="flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-[var(--card-brand-color)] opacity-60"></span>
                        Current Committee
                      </span>
                      <span class="text-[var(--card-brand-color)] font-semibold">2025–26</span>
                    </div>

                  </div>
                </article>
              );
            })}
          </div>
        </div>
      )}

      {pastCommittee.length > 0 && (
        <div class="mt-24 pt-16 border-t border-ai-border/40">
          <div class="mb-12">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-ai-fg tracking-tight">Past Committee</h2>
          </div>
          <div class="space-y-16">
            {pastCommitteeYears.map(yearLabel => (
              <section>
                <h3 class="font-bold text-2xl text-ai-fg mb-6 tracking-tight">{yearLabel}</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                  {pastCommittee.filter(member => member.yearLabel === yearLabel).map((member, i) => {
                    const colors = ['var(--ai-sage)', 'var(--ai-coral)', 'var(--ai-azure)'];
                    const glowColor = colors[i % colors.length];
                    return (
                      <article class="premium-card p-4 flex flex-row items-center gap-4 group" style={`--card-brand-color: ${glowColor};`}>
                        <div class="premium-glow"></div>

                        <div class="relative z-10 flex flex-row items-center gap-4 w-full">
                          
                          <!-- Clean mini photo frame -->
                          <div class="relative w-12 h-12 shrink-0">
                            <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-[var(--card-brand-color)]/20 to-transparent opacity-60"></div>
                            <div class="absolute inset-0.5 rounded-full overflow-hidden border border-ai-border/80 bg-ai-surface z-10">
                              {member.imageUrl ? (
                                <img src={member.imageUrl} alt={member.name || member.role} class="w-full h-full object-cover" />
                              ) : (
                                <div class="w-full h-full flex items-center justify-center text-[var(--card-brand-color)] font-bold text-[10px]">
                                  {getInitials(member.name, member.role)}
                                </div>
                              )}
                            </div>
                          </div>

                          <div class="overflow-hidden">
                            <h4 class="font-semibold text-base text-ai-fg truncate group-hover:text-[var(--card-brand-color)] transition-colors duration-300 tracking-tight">{member.name || 'Pending Confirmation'}</h4>
                            <p class="text-ai-fg-muted text-[10px] uppercase tracking-wider font-bold mt-0.5 truncate">{member.role}</p>
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
