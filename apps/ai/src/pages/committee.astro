---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'ai';
const client = createConvexClient();
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );
const pastCommittee: any[] = (await client.query("committee:listPast", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (b.yearLabel || '').localeCompare(a.yearLabel || '') ||
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
    (a.name || '').localeCompare(b.name || '')
  );
const pastCommitteeYears = [...new Set(pastCommittee.map(member => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};
---

<Layout title="Committee" description="Meet the student committee running Surrey Artificial Intelligence Society — the team behind our workshops, events, and community.">

  <section class="bg-ai-bg text-ai-fg border-b border-ai-border">
    <div class="mx-auto max-w-5xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-16">
      <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6">Meet the people running the society.</h1>
      <p class="text-ai-fg-muted text-lg sm:text-xl leading-relaxed max-w-2xl">
        Student volunteers who plan and run the society — organising workshops, events, and everything in between.
      </p>
    </div>
  </section>

  <!-- Committee Grid -->
  <section class="py-16 sm:py-24 px-6 bg-ai-surface text-ai-fg">
    <div class="mx-auto max-w-5xl">
      {committee.length === 0 ? (
        <div class="bg-ai-bg rounded-2xl p-10 text-center shadow-sm">
          <h2 class="text-2xl font-bold mb-4 text-ai-fg">Committee details will appear here once confirmed</h2>
          <p class="text-ai-fg-muted leading-relaxed mb-6 max-w-2xl mx-auto">
            Our current committee roster will be published once confirmed through the Surrey Students' Union.
          </p>
          <a href="/join" class="btn-primary">
            Learn about joining the society
          </a>
        </div>
      ) : (
        <div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {committee.map(member => (
              <article class="bg-ai-bg rounded-2xl p-8 flex flex-col shadow-sm border border-ai-border/50 hover:shadow-md transition-shadow">
                {member.imageUrl ? (
                  <img src={member.imageUrl} alt={member.name || member.role} class="w-20 h-20 rounded-full object-cover mb-6" />
                ) : (
                  <div class="w-20 h-20 rounded-full bg-ai-surface flex items-center justify-center text-ai-coral font-bold text-xl mb-6 shadow-sm border border-ai-border">
                    {getInitials(member.name, member.role)}
                  </div>
                )}
                <h2 class="font-bold text-2xl text-ai-fg mb-2">{member.name || 'Pending Confirmation'}</h2>
                <p class="text-ai-fg-muted text-sm font-semibold uppercase tracking-widest">{member.role}</p>
              </article>
            ))}
          </div>
        </div>
      )}

      <div class="mt-20 pt-12 border-t border-ai-border">
        <div class="mb-10">
          <h2 class="text-3xl font-extrabold text-ai-fg">Past Committee</h2>
        </div>
        {pastCommittee.length === 0 ? (
          <p class="text-ai-fg-muted text-lg">Past committee details will be published once confirmed.</p>
        ) : (
          <div class="space-y-12">
            {pastCommitteeYears.map(yearLabel => (
              <section>
                <h3 class="font-bold text-xl text-ai-fg mb-6">{yearLabel}</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                  {pastCommittee.filter(member => member.yearLabel === yearLabel).map(member => (
                    <article class="bg-ai-bg rounded-xl p-6 flex items-start gap-4 shadow-sm border border-ai-border/50">
                      {member.imageUrl ? (
                        <img src={member.imageUrl} alt={member.name || member.role} class="w-12 h-12 rounded-full object-cover shrink-0" />
                      ) : (
                        <div class="w-12 h-12 rounded-full bg-ai-surface flex items-center justify-center text-ai-azure font-bold text-sm shrink-0 border border-ai-border">
                          {getInitials(member.name, member.role)}
                        </div>
                      )}
                      <div>
                        <h4 class="font-semibold text-base text-ai-fg">{member.name || 'Pending Confirmation'}</h4>
                        <p class="text-ai-fg-muted text-xs uppercase tracking-wider font-medium mt-1">{member.role}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>

    </div>
  </section>

</Layout>
