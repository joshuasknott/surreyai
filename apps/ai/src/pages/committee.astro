---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AnimatedHero from '../components/common/AnimatedHero.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'ai';
const client = createConvexClient();
const committee: any[] = (await client.query("committee:listActive", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER)
    || (a.name || '').localeCompare(b.name || '')
  );
const pastCommittee: any[] = (await client.query("committee:listPast", { societySlug: SOCIETY_ID }))
  .sort((a: any, b: any) =>
    (b.yearLabel || '').localeCompare(a.yearLabel || '') ||
    (a.displayOrder ?? Number.MAX_SAFE_INTEGER) - (b.displayOrder ?? Number.MAX_SAFE_INTEGER) ||
    (a.name || '').localeCompare(b.name || '')
  );
const pastCommitteeYears = [...new Set(pastCommittee.map(member => member.yearLabel))];

const getInitials = (name?: string, role?: string) => {
  const source = (name || role || '?').trim();
  const words = source.split(/\s+/).filter(Boolean);
  if (words.length === 0) return '?';
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return words.slice(0, 2).map((word) => word[0]).join('').toUpperCase();
};
---

<Layout title="Committee" description="Meet the student committee running Surrey Artificial Intelligence Society — the team behind our workshops, events, and community.">

  <AnimatedHero 
    title="Meet the people running the society."
    description="Student volunteers who plan and run the society — organising workshops, events, and everything in between."
    centered={true}
  />

  <!-- Committee Grid -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg relative z-10">
    <div class="mx-auto max-w-7xl">
      {committee.length === 0 ? (
        <div class="bg-ai-surface border border-ai-border rounded-[1.5rem] p-10 text-center shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_20px_rgba(0,0,0,0.02)] backdrop-blur-md">
          <h2 class="text-2xl font-bold mb-4 text-ai-fg">Committee details will appear here once confirmed</h2>
          <p class="text-ai-fg-muted leading-relaxed mb-6 max-w-2xl mx-auto text-lg">
            Our current committee roster will be published once confirmed through the Surrey Students' Union.
          </p>
          <a href="/join" class="btn-primary">
            Learn about joining the society
          </a>
        </div>
      ) : (
        <div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {committee.map((member, i) => {
              const colors = ['var(--ai-coral)', 'var(--ai-azure)', 'var(--ai-sage)'];
              const glowColor = colors[i % colors.length];
              return (
                <article class="relative bg-ai-surface border border-ai-border rounded-[1.5rem] p-8 flex flex-col items-center text-center overflow-hidden group transition-all duration-300 hover:-translate-y-1 hover:border-ai-border-strong shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_20px_rgba(0,0,0,0.02)] backdrop-blur-md">
                  <div class="absolute inset-0 opacity-0 group-hover:opacity-[0.15] blur-[60px] scale-150 transition-opacity duration-500 pointer-events-none" style={`background-color: ${glowColor};`}></div>
                  <div class="relative z-10 w-full flex flex-col items-center">
                    {member.imageUrl ? (
                      <img src={member.imageUrl} alt={member.name || member.role} class="w-24 h-24 rounded-full object-cover mb-6 border border-ai-border" />
                    ) : (
                      <div class="w-24 h-24 rounded-full bg-ai-bg flex items-center justify-center text-ai-coral font-bold text-2xl mb-6 shadow-sm border border-ai-border">
                        {getInitials(member.name, member.role)}
                      </div>
                    )}
                    <h2 class="font-bold text-xl text-ai-fg mb-1">{member.name || 'Pending Confirmation'}</h2>
                    <p class="text-ai-fg-muted text-xs font-bold uppercase tracking-widest">{member.role}</p>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      )}

      {pastCommittee.length > 0 && (
        <div class="mt-24 pt-16 border-t border-ai-border">
          <div class="mb-12">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-ai-fg tracking-tight">Past Committee</h2>
          </div>
          <div class="space-y-16">
            {pastCommitteeYears.map(yearLabel => (
              <section>
                <h3 class="font-bold text-2xl text-ai-fg mb-6">{yearLabel}</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                  {pastCommittee.filter(member => member.yearLabel === yearLabel).map((member, i) => {
                    const colors = ['var(--ai-sage)', 'var(--ai-coral)', 'var(--ai-azure)'];
                    const glowColor = colors[i % colors.length];
                    return (
                      <article class="relative bg-ai-surface border border-ai-border rounded-[1.25rem] p-6 flex items-center gap-4 overflow-hidden group transition-all duration-300 hover:-translate-y-1 hover:border-ai-border-strong shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_20px_rgba(0,0,0,0.02)] backdrop-blur-md">
                        <div class="absolute inset-0 opacity-0 group-hover:opacity-[0.10] blur-[40px] scale-150 transition-opacity duration-500 pointer-events-none" style={`background-color: ${glowColor};`}></div>
                        <div class="relative z-10 flex items-center gap-4 w-full">
                          {member.imageUrl ? (
                            <img src={member.imageUrl} alt={member.name || member.role} class="w-12 h-12 rounded-full object-cover shrink-0 border border-ai-border" />
                          ) : (
                            <div class="w-12 h-12 rounded-full bg-ai-bg flex items-center justify-center text-ai-azure font-bold text-sm shrink-0 border border-ai-border">
                              {getInitials(member.name, member.role)}
                            </div>
                          )}
                          <div class="overflow-hidden">
                            <h4 class="font-semibold text-base text-ai-fg truncate">{member.name || 'Pending Confirmation'}</h4>
                            <p class="text-ai-fg-muted text-xs uppercase tracking-wider font-bold mt-0.5 truncate">{member.role}</p>
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
