---
export const prerender = false;
import BaseLayout from '@surreysocieties/ui/components/BaseLayout';
import { ArrowUpRight, ArrowLeft, Plus, X, CalendarDays, MapPin, UsersRound, Sparkles, LockKeyhole, LogOut, Settings, Bell, Circle, AtSign, Send, Ellipsis, Columns3, Archive, ChevronsLeft, Menu, Search, MessageCircle, ListChecks, GripVertical, Check, Paperclip, FileText } from 'lucide-astro';
import { plannerTeams } from '../../../../../convex/plannerTeams';
import { SOCIETIES } from '@surreysocieties/admin/config';
import '../../styles/planner.css';
import { isAIEnabled } from '../../lib/server/ai/gemini';

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const publishableKey = process.env.PUBLIC_CLERK_PUBLISHABLE_KEY || import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY || '';
const convexUrl = process.env.CONVEX_URL || import.meta.env.CONVEX_URL || '';
---
<BaseLayout title="Committee planner | Surrey AI Society" description="Private programme planning for the Surrey AI Society committee." bodyClass="planner-page">
  <Fragment slot="head"><meta name="robots" content="noindex,nofollow" /></Fragment>
  <a class="planner-skip" href="#planner-main">Skip to planner</a>
  <aside id="planner-sidebar" class="planner-sidebar" aria-label="Planner navigation">
    <div class="sidebar-brand-row">
    <a class="planner-brand" href="/" aria-label="Surrey AI Society home"><img src="/logos/brand/surrey-ai-icon-dark.webp" alt="" width="46" height="46" /><strong>Surrey AI Society</strong></a>
    <button id="collapse-sidebar" class="icon-button" aria-label="Collapse navigation" aria-expanded="true" aria-controls="planner-sidebar"><ChevronsLeft size={18} /></button>
    </div>
    <nav id="workspace-nav" class="sidebar-nav" aria-label="Planner views" hidden>
      <button data-view="board" aria-pressed="true" title="Board"><Columns3 size={20} /><span>Board</span></button>
      <button data-view="calendar" aria-pressed="false" title="Calendar"><CalendarDays size={20} /><span>Calendar</span></button>
      <button data-view="archive" aria-pressed="false" title="Archive"><Archive size={20} /><span>Archive</span></button>
    </nav>
    <div class="sidebar-bottom">
      <a href="/" target="_blank" rel="noopener" title="View website"><ArrowUpRight size={20} /><span>View website</span></a>
      <button id="open-settings" hidden title="Settings"><Settings size={20} /><span>Settings</span></button>
      <div id="sidebar-account" class="sidebar-account" hidden><span id="account-avatar" class="person-avatar" aria-hidden="true" hidden></span><span id="account-name"></span></div>
      <button id="sign-out" hidden title="Sign out"><LogOut size={20} /><span>Sign out</span></button>
    </div>
  </aside>
  <button id="sidebar-scrim" class="sidebar-scrim" aria-label="Close navigation" hidden></button>
  <main id="planner-main" data-planner data-key={publishableKey} data-convex={convexUrl} data-ai={String(isAIEnabled())}>
    <header class="planner-header">
      <button id="toggle-sidebar" class="icon-button" aria-label="Open navigation" aria-expanded="false" aria-controls="planner-sidebar"><Menu size={22} /></button>
      <h1><LockKeyhole size={18} aria-hidden="true" /><span id="workspace-title">Committee board</span></h1>
      <div class="planner-header-actions">
        <button id="open-members" class="member-stack" hidden aria-label="View committee members" title="Committee members"></button>
        <button id="open-notifications" class="icon-button notification-trigger" hidden aria-label="Notifications" title="Notifications"><Bell size={22} /><span id="notification-count" class="notification-count" aria-hidden="true" hidden></span></button>
      </div>
    </header>
    <section id="access-state" class="planner-access" aria-live="polite">
      <LockKeyhole size={24} aria-hidden="true" /><h1>Committee planner</h1><p id="access-message">Checking your access…</p>
      <div id="sign-in" class="planner-sign-in" hidden>
        <form id="email-sign-in">
          <label for="sign-in-email">Committee email</label>
          <input id="sign-in-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required placeholder="you@example.com" />
          <button id="send-code" class="primary-button" type="submit" disabled>Send sign-in code</button>
        </form>
        <form id="code-sign-in" hidden>
          <p id="code-destination" class="code-destination"></p>
          <label for="sign-in-code">Six-digit code</label>
          <input id="sign-in-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required aria-describedby="code-destination" />
          <button id="verify-code" class="primary-button" type="submit">Verify and sign in</button>
          <div class="code-actions"><button id="change-email" class="quiet-button" type="button">Use another email</button><button id="resend-code" class="quiet-button" type="button" disabled>Resend code</button></div>
        </form>
        <p id="sign-in-feedback" class="form-message" role="alert"></p>
        <p class="sign-in-hint">Your sign-in is remembered on this browser.</p>
      </div>
      <button id="retry-access" class="quiet-button" hidden>Try again</button>
      <noscript><p>Enable JavaScript to sign in and use the private planner.</p></noscript>
    </section>
    <section id="workspace" hidden>
      <div class="planner-toolbar">
        <div class="team-filters" role="group" aria-label="Filter by team"><button data-team="all" aria-pressed="true">All</button>{plannerTeams.map(team => <button data-team={team.id} aria-pressed="false">{team.name}</button>)}</div>
        <div class="planner-tools"><button id="toggle-search" class="icon-button" aria-label="Search cards" aria-expanded="false" aria-controls="board-search"><Search size={20} /></button><button id="new-item" class="primary-button"><Plus size={18} /><span>New card</span></button></div>
      </div>
      <div id="board-search" class="board-search" hidden><label for="card-search" class="sr-only">Search cards</label><input id="card-search" type="search" placeholder="Search cards…" autocomplete="off" /></div>
      <div id="board" class="planner-board"></div>
      <div id="calendar" class="planner-calendar" hidden></div>
      <div id="archive" hidden></div>
    </section>
    <p id="planner-status" class="planner-status" role="status" aria-live="polite"></p>
  </main>

  <dialog id="card-dialog" class="card-dialog" aria-labelledby="item-heading">
    <header class="card-preview-top"><div class="card-header-context"><LockKeyhole size={16} /><span>Committee board</span><div id="card-stage-slot"></div></div><div class="card-preview-actions"><details id="card-actions" class="card-options"><summary aria-label="Card options"><Ellipsis size={20} /></summary><div id="card-actions-slot" class="card-options-panel"></div></details><button type="button" data-close class="icon-button" aria-label="Close card"><X size={22} /></button></div></header>
    <div class="card-mobile-tabs" role="tablist" aria-label="Card panels"><button type="button" role="tab" aria-selected="true" aria-controls="card-editor-slot" id="card-tab">Card</button><button type="button" role="tab" aria-selected="false" aria-controls="card-discussion" id="discussion-tab">Discussion</button></div>
    <div class="card-workspace"><div id="card-editor-slot" role="region" aria-label="Card details"></div>
    <section class="card-comments" aria-labelledby="card-comments-title">
      <h3 id="card-comments-title">Discussion <span id="comment-count"></span></h3>
      <div id="card-discussion" class="card-discussion-history" role="region" aria-label="Discussion history">
      <button id="older-comments" type="button" class="quiet-button" hidden>Load earlier comments</button>
      <p id="comments-status" class="field-help" role="status"></p>
      <ol id="comment-list" class="comment-list"></ol>
      </div>
      <form id="comment-form" class="comment-form">
        <label for="comment-text" class="sr-only">Add a comment</label>
        <div id="comment-author" class="composer-avatar" aria-hidden="true"></div>
        <div class="comment-composer">
          <textarea id="comment-text" name="comment" rows="2" maxlength="2000" required placeholder="Write a comment…"></textarea>
          <div class="comment-actions"><button id="mention-person" type="button" class="mention-button" aria-label="Mention a committee member"><AtSign size={19} /><span>Mention someone</span></button><button id="post-comment" type="submit" class="primary-button" aria-label="Post comment"><Send size={16} />Send</button></div>
        </div>
        <p id="comment-message" class="form-message" role="status"></p>
      </form>
    </section>
    </div>
    <footer class="card-save-footer"><div class="card-save-state"><Check size={16} /><span id="card-save-status" role="status" aria-live="polite">All changes saved</span><button type="button" id="retry-card-save" class="quiet-button" hidden>Retry</button></div><span><LockKeyhole size={13} />Private to committee</span></footer>
  </dialog>

  <dialog id="item-dialog" class="item-dialog" aria-labelledby="item-heading">
    <form id="item-form">
      <div class="editor-top"><button type="button" data-close class="quiet-button"><ArrowLeft size={16} /><span id="editor-back-label">Planner</span></button><span id="item-state" class="muted">Idea · Private</span><button type="button" data-close class="icon-button" aria-label="Close activity"><X size={20} /></button></div>
      <div class="editor-actions"><h2 id="item-heading">New activity</h2><div id="editor-action-buttons"><button type="button" id="archive-item" class="quiet-button" hidden>Archive</button><button type="submit" form="item-form" id="save-item" class="secondary-button">Save draft</button><button type="button" id="publish-item" class="primary-button" hidden>Publish to website</button><button type="button" id="card-review" class="quiet-button" hidden>Review website details</button><button type="button" id="card-notes" class="quiet-button" hidden>Notes &amp; collaborators</button><button type="button" id="card-people-toggle" class="quiet-button" hidden>Worked on by</button></div></div>
      <p id="item-message" role="status" class="form-message"></p>
      <div class="editor-stage-bar"><label id="stage-field">Stage<select name="stage" form="item-form"><option value="ideas">Ideas</option><option value="planning">In progress</option><option value="ready">Ready</option><option value="done">Done</option></select></label><p id="stage-help" class="field-help">Start with a title and a few words. Work out the details later.</p></div>
      <div class="editor-columns">
        <div class="editor-fields">
          <label class="card-title-field">Title<input name="title" maxlength="160" required autocomplete="off" /></label>
          <div class="card-metadata">
          <div class="team-picker"><span class="metadata-label">Team(s)</span><details id="team-picker-menu"><summary id="team-picker-summary" aria-label="Choose teams">Choose teams <Plus size={16} /></summary><fieldset class="team-options"><legend class="sr-only">Team(s)</legend>{plannerTeams.map(team => <label class="team-option"><input type="checkbox" name="teams" value={team.id} /><span>{team.name}</span></label>)}</fieldset></details></div>
          <label class="lead-field">Lead<div class="lead-control"><span id="lead-avatar" class="person-avatar" aria-hidden="true"></span><select name="lead"><option value="">Unassigned</option><optgroup label="Signatories">{SOCIETIES.ai.signatories.map(person => <option value={person.name}>{person.name}</option>)}</optgroup>{plannerTeams.map(team => <optgroup label={team.name}>{team.members.map(name => <option value={name}>{name}</option>)}</optgroup>)}</select></div></label>
          <label id="internal-due-label">Due<input type="date" name="dueDate" aria-label="Due date (optional)" /></label>
          <label class="purpose-field">Card purpose<select name="purpose"><option value="internal">Internal work</option><option value="activity">Website activity</option></select></label>
          </div>
          <div class="description-field">
            <div class="field-label-row"><label for="activity-description">Description</label><button type="button" id="help-description" class="inline-ai" hidden><Sparkles size={14} />Help write this</button></div>
            <textarea id="activity-description" name="description" rows="4" maxlength="4000" placeholder="What’s the idea?"></textarea>
            <p id="description-ai-message" class="form-message" role="status"></p>
            <div id="description-suggestion" class="description-suggestion" hidden><strong>Suggested description</strong><p id="suggested-description"></p><div><button type="button" id="use-description" class="secondary-button">Use description</button><button type="button" id="dismiss-description" class="quiet-button">Dismiss</button></div></div>
          </div>
          <div id="collaborators-home"><label id="collaborators-field">Collaborators (optional)<input name="owner" maxlength="160" autocomplete="off" placeholder="Who might help with this?" /></label></div>
          <details id="activity-details" class="activity-details card-detail-panel" hidden>
            <summary>Activity details</summary><div class="detail-panel-content"><button type="button" class="close-card-panel icon-button" aria-label="Close activity details"><X size={18} /></button>
            <div class="field-pair"><label>Type<select name="kind"><option value="event">Event</option><option value="project">Project</option><option value="hackathon">Hackathon</option></select></label><label>Category<select name="category"><option>Workshop</option><option>Talk</option><option>Social</option><option>Project session</option><option>Other</option></select></label></div>
            <div class="field-pair"><label>Date<input type="date" name="date" /></label><label>Room or location<input name="location" maxlength="200" autocomplete="off" placeholder="Room number, venue or online" /></label></div>
            <div class="field-pair"><label>Start time<input type="time" name="startTime" /></label><label>End time<input type="time" name="endTime" /></label></div>
            <label>Booking or project link<input type="url" name="registrationUrl" maxlength="1500" placeholder="https://" /></label>
            <p class="field-help">Times use Europe/London. Events need a room or location and booking link before publishing. Ongoing projects can stay undated.</p>
          </div></details>
          <details id="private-options" class="private-fields card-detail-panel" hidden><summary>Notes &amp; collaborators <span>Private · optional</span></summary><div class="detail-panel-content"><button type="button" class="close-card-panel icon-button" aria-label="Close private details"><X size={18} /></button><div id="card-collaborators-slot"></div><label>Notes<textarea name="notes" rows="3" maxlength="8000"></textarea></label></div></details>
          <fieldset id="card-checklist" class="checklist"><legend>Checklist <span id="task-progress"></span></legend><div id="task-list"></div><div class="add-task"><input id="task-text" maxlength="300" aria-label="New checklist task" placeholder="Add an item…" /><button type="button" id="add-task" class="quiet-button" aria-label="Add checklist item"><Plus size={16} /></button></div></fieldset>
          <section id="card-attachments" class="card-attachments"><div class="attachment-heading"><h3>Attachments</h3><button type="button" id="add-attachment" class="icon-button" aria-label="Attach a link"><Paperclip size={17} /></button></div><div id="attachment-list"></div><div id="attachment-editor" hidden><label>Link<input type="text" inputmode="url" id="attachment-url" placeholder="https://" /></label><label>Name<input id="attachment-name" maxlength="160" placeholder="Document or link name" /></label><div><button type="button" id="save-attachment" class="quiet-button">Add link</button><button type="button" id="cancel-attachment" class="quiet-button">Cancel</button></div><p id="attachment-error" role="status" class="form-message"></p></div></section>
        </div>
        <aside id="editor-preview" class="editor-preview" aria-labelledby="preview-heading" hidden><h3 id="preview-heading">Website preview</h3><p class="muted">surreyaisociety.org</p><div id="public-preview" class="public-preview"></div><p id="publication-help" class="field-help">Ready stays private. Publish when the public details are confirmed.</p><ul id="publication-missing" class="publication-missing"></ul><button type="button" id="unpublish-item" class="quiet-button danger" hidden>Unpublish and move to Ready</button><p class="field-help">Collaborators, committee notes and preparation tasks stay private.</p></aside>
      </div>
    </form>
  </dialog>
  <dialog id="card-people-dialog" class="small-dialog" aria-labelledby="card-people-heading"><div class="dialog-heading"><h2 id="card-people-heading">Worked on by</h2><button type="button" data-close class="icon-button" aria-label="Close contributors"><X size={20} /></button></div><div id="card-people" class="avatar-group"></div></dialog>

  <dialog id="members-dialog" class="small-dialog members-dialog" aria-labelledby="members-heading">
    <div class="dialog-heading"><h2 id="members-heading">Committee members</h2><button type="button" data-close class="icon-button" aria-label="Close members"><X size={20} /></button></div>
    <div id="team-members"></div>
  </dialog>

  <dialog id="notifications-dialog" class="notifications-dialog" aria-labelledby="notifications-heading">
    <div class="dialog-heading"><h2 id="notifications-heading">Notifications</h2><button type="button" data-close class="icon-button" aria-label="Close notifications"><X size={20} /></button></div>
    <div class="notifications-intro"><p>Mentions from your committee.</p><button id="read-all-notifications" type="button" class="quiet-button" hidden>Mark all as read</button></div>
    <p id="notifications-status" class="field-help" role="status"></p>
    <ol id="notification-list" class="notification-list"></ol>
    <button id="older-notifications" type="button" class="quiet-button" hidden>Load earlier notifications</button>
  </dialog>

  <dialog id="settings-dialog" class="small-dialog" aria-labelledby="settings-heading">
    <div class="dialog-heading"><h2 id="settings-heading">Settings</h2><button type="button" data-close class="icon-button" aria-label="Close settings"><X size={20} /></button></div>
    <p id="settings-account" class="settings-account"></p>
    <section id="committee-settings" hidden aria-labelledby="access-heading">
      <h3 id="access-heading">Committee access</h3><p>Only you can add or remove emails. People you add can sign in and use the private board.</p>
      <form id="access-form"><label>Committee email<input name="email" type="email" maxlength="254" required autocomplete="off" /></label><button type="submit" class="primary-button">Add email</button></form>
      <p class="field-help">They can sign in with this email without registering separately. Share the planner link with them; no invitation email is sent.</p>
      <p id="access-feedback" class="form-message" role="status"></p><div id="access-list"></div>
    </section>
  </dialog>

  <template id="plus-icon"><Plus size={17} aria-hidden="true" /></template>
  <template id="close-icon"><X size={15} aria-hidden="true" /></template>
  <template id="drag-icon"><GripVertical size={17} aria-hidden="true" /></template>
  <template id="external-icon"><ArrowUpRight size={15} aria-hidden="true" /></template>
  <template id="calendar-icon"><CalendarDays size={18} aria-hidden="true" /></template>
  <template id="location-icon"><MapPin size={16} aria-hidden="true" /></template>
  <template id="collaborators-icon"><UsersRound size={16} aria-hidden="true" /></template>
  <template id="attachment-icon"><FileText size={20} aria-hidden="true" /></template>
  <template id="stage-icon"><Circle size={12} fill="currentColor" aria-hidden="true" /></template>
  <template id="lock-icon"><LockKeyhole size={14} aria-hidden="true" /></template>
  <template id="more-icon"><Ellipsis size={19} aria-hidden="true" /></template>
  <template id="comments-icon"><MessageCircle size={14} aria-hidden="true" /></template>
  <template id="checklist-icon"><ListChecks size={14} aria-hidden="true" /></template>
  <script>import '../../scripts/planner';</script>
</BaseLayout>
