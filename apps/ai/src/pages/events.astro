---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import AnimatedHero from '../components/common/AnimatedHero.astro';
import { queryPublicConvex } from '@surreysocieties/admin';
import { getSocietyById } from '@surreysocieties/admin/config';
import '../styles/global.css';

const SOCIETY_ID = 'ai';
const society = getSocietyById(SOCIETY_ID)!;
const events: any[] = (await queryPublicConvex<any[]>("events:listPublished", { societySlug: SOCIETY_ID }, []))
  .filter((event: any) => event.status === 'published');

const formatEventMonth = (date?: string) => {
  if (!date) return 'TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return 'TBC';
  return parsed.toLocaleDateString('en-GB', { month: 'short' }).toUpperCase();
};

const formatEventDay = (date?: string) => {
  if (!date) return '-';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return '-';
  return parsed.toLocaleDateString('en-GB', { day: '2-digit' });
};
---

<Layout title="Events" description="Upcoming and planned events from Surrey Artificial Intelligence Society — workshops, build nights, discussions, and careers events.">

  <AnimatedHero 
    title="What's happening next."
    description="Technical deep-dives, hands-on build nights, and industry speakers. Open to all Surrey students."
    centered={true}
  />

  <!-- Events List -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg relative z-10">
    <div class="mx-auto max-w-7xl">
      {events.length === 0 ? (
        <div class="premium-card py-16 text-center max-w-4xl mx-auto" style="--card-brand-color: var(--ai-azure);">
          <div class="premium-glow"></div>

          <div class="relative z-10 px-6">
            <!-- Premium Google-style Calendar Pending Visual -->
            <div class="mx-auto max-w-[280px] bg-ai-surface border border-ai-border rounded-2xl p-6 mb-8 flex flex-col items-center shadow-sm">
              <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-ai-azure/20 to-ai-coral/20 flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-ai-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="text-xs font-semibold text-ai-azure tracking-widest uppercase">Next Semester</span>
              <span class="text-sm font-bold text-ai-fg mt-1">Calendar Pending</span>
            </div>
            
            <p class="text-ai-fg-muted text-lg leading-relaxed max-w-xl mx-auto mb-8">
              We&apos;re currently planning our next semester of events. Join our community to get notified, or follow us on socials.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
              <a href="/join" class="btn-primary">
                Become a member
              </a>
            </div>
            <p class="text-ai-fg-muted text-sm mt-6">
              Follow us on <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-ai-azure hover:underline font-semibold">Instagram</a> · <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="text-ai-azure hover:underline font-semibold">Students&apos; Union</a>
            </p>
          </div>
        </div>
      ) : (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {events.map((event, i) => {
            const colors = ['var(--ai-coral)', 'var(--ai-azure)', 'var(--ai-sage)'];
            const glowColor = colors[i % colors.length];
            return (
              <article class="premium-card group p-6 sm:p-8 flex flex-col justify-between" style={`--card-brand-color: ${glowColor};`}>
                <div class="premium-glow"></div>
                
                <div class="relative z-10 flex flex-col h-full justify-between">
                  <div>
                    <!-- Premium Header -->
                    <div class="flex items-center justify-between mb-5 text-[11px] font-semibold tracking-wider uppercase text-ai-fg-muted border-b border-ai-border/30 pb-3">
                      <span class="text-[var(--card-brand-color)]">Upcoming Session</span>
                      <span class="opacity-60">Confirmed</span>
                    </div>

                    <!-- Glowing Calendar date badge wrapper -->
                    <div class="relative mb-6 self-start inline-block">
                      <div class="absolute -inset-0.5 rounded-[1rem] bg-gradient-to-br from-ai-border to-[var(--card-brand-color)]/30 opacity-40 blur-xs"></div>
                      <div class="relative z-10 text-center bg-ai-bg/90 border border-ai-border/85 px-4 py-3 rounded-[1rem] min-w-[5rem] shadow-sm">
                        <span class="block text-ai-coral font-bold text-xs tracking-widest uppercase mb-1">{formatEventMonth(event.date)}</span>
                        <span class="block text-ai-fg font-extrabold text-3xl leading-none tracking-tight">{formatEventDay(event.date)}</span>
                      </div>
                    </div>

                    <h2 class="font-bold text-2xl text-ai-fg mb-3 tracking-tight group-hover:text-[var(--card-brand-color)] transition-colors duration-300 line-clamp-2">{event.title}</h2>
                    <div class="flex flex-wrap gap-x-4 gap-y-2 mb-4 text-xs font-semibold text-ai-azure tracking-wide uppercase">
                      {event.startTime && <span>{event.startTime}{event.endTime ? ` - ${event.endTime}` : ''}</span>}
                      {event.location && <span>{event.location}</span>}
                      {event.category && <span class="text-ai-fg-muted border border-ai-border px-2 py-0.5 rounded-md">{event.category}</span>}
                    </div>
                    <p class="text-ai-fg-muted leading-relaxed text-base line-clamp-4">{event.description || 'Details to be announced.'}</p>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

</Layout>
