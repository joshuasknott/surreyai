---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { queryPublicConvex } from "@surreysocieties/admin";
import { getSocietyById } from "@surreysocieties/admin/config";
import CutoutVisual from "../components/common/CutoutVisual.astro";
import eventsWorkshopCutout from "../assets/generated/ai-events-workshop-cutout.png";
import "../styles/global.css";

const SOCIETY_ID = "ai";
const society = getSocietyById(SOCIETY_ID)!;
const events: any[] = (await queryPublicConvex<any[]>("events:listPublished", { societySlug: SOCIETY_ID }, []))
  .filter((event: any) => event.status === "published");

const formatEventDate = (date?: string) => {
  if (!date) return "Date TBC";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return "Date TBC";
  return parsed.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
};

const programmeFormats = [
  {
    title: "Build sessions",
    text: "Hands-on evenings for small tools, model experiments, data notebooks, and member demos.",
  },
  {
    title: "AI literacy workshops",
    text: "Beginner-friendly sessions on prompts, datasets, evaluation, model limits, and everyday AI use.",
  },
  {
    title: "Impact discussions",
    text: "Structured conversations about bias, reliability, labour, accessibility, privacy, and creative practice.",
  },
];
---

<Layout
  title="Events"
  description="Upcoming and planned events from Surrey Artificial Intelligence and Data Science Society."
>
  <section class="events-hero">
    <div class="events-hero__copy">
      <h1>Workshops, discussions, and project sessions for AI curious students.</h1>
      <p>
        Confirmed sessions appear from the society admin system. The programme is designed around learning by seeing, building, testing, and debating real AI and data workflows.
      </p>
    </div>
    <CutoutVisual
      compact
      image={eventsWorkshopCutout}
      alt="AI workshop kit with projector, laptop, sticky notes, blank event cards, coffee, and cable"
      title="Events are built around things students can try."
      body="Workshops, clinics, and discussions stay practical without becoming a technical wall."
      loading="eager"
    />
  </section>

  <section class="ai-section ai-section--tinted" aria-labelledby="formats-title">
    <div class="ai-section__inner">
      <div class="ai-section__header ai-section__header--split">
        <h2 id="formats-title" class="section-title">Programme formats.</h2>
        <p class="section-intro">
          The calendar can shift each semester, but these are the recurring types of activities members should expect.
        </p>
      </div>

      <div class="format-list">
        {programmeFormats.map((format, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{format.title}</h3>
              <p>{format.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ai-section" aria-labelledby="events-title">
    <div class="ai-section__inner">
      <div class="ai-section__header ai-section__header--split">
        <div>
          <h2 id="events-title" class="section-title">Confirmed events</h2>
        </div>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-link">
          Follow updates on Instagram ->
        </a>
      </div>

      {events.length === 0 ? (
        <div class="calendar-empty">
          <div class="calendar-empty__copy">
            <h3>Next events will appear here once confirmed.</h3>
            <p>
              This page stays honest until the next committee or signatories publish the calendar. Join the society or follow the socials for updates.
            </p>
            <div class="calendar-empty__actions">
              <a href="/join" class="btn-primary">Join the Society</a>
              <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">Students' Union page</a>
            </div>
          </div>
          <div class="calendar-empty__board" aria-label="Planned event formats">
            <span>Build sessions</span>
            <span>AI literacy workshops</span>
            <span>Impact discussions</span>
          </div>
        </div>
      ) : (
        <div class="event-directory">
          {events.map((event) => (
            <article class="event-entry">
              <time>{formatEventDate(event.date)}</time>
              <div class="event-entry__body">
                <p class="event-entry__meta">
                  {[event.startTime, event.endTime, event.location, event.category].filter(Boolean).join(" / ") || "Details to be announced"}
                </p>
                <h2>{event.title}</h2>
                <p>{event.description || "Details to be announced."}</p>
                {event.registrationUrl && (
                  <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="text-link">Register -></a>
                )}
              </div>
              {event.imageUrl && (
                <img src={event.imageUrl} alt="" loading="lazy" />
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .events-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(22rem, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 8rem) 1.25rem clamp(3rem, 6vw, 5rem);
  }

  .events-hero__copy h1 {
    margin: 0;
    color: var(--ai-fg);
    font-size: clamp(2.55rem, 4.6vw, 4.65rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1;
  }

  .events-hero__copy p {
    max-width: 42rem;
    margin: 1.3rem 0 0;
    color: var(--ai-fg-muted);
    font-size: 1.12rem;
    line-height: 1.65;
  }

  .format-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .format-list article {
    border-top: 3px solid var(--ai-azure);
    padding-top: 1.25rem;
  }

  .format-list article:nth-child(2) {
    border-top-color: var(--ai-sage);
  }

  .format-list article:nth-child(3) {
    border-top-color: var(--ai-coral);
  }

  .format-list span {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .format-list h3 {
    margin: 0.75rem 0 0.45rem;
    color: var(--ai-fg);
    font-size: 1.2rem;
    letter-spacing: 0;
  }

  .format-list p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.6;
  }

  .calendar-empty {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(20rem, 0.82fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .calendar-empty h3 {
    margin: 0 0 0.85rem;
    color: var(--ai-fg);
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    letter-spacing: 0;
    line-height: 1.08;
  }

  .calendar-empty p {
    max-width: 42rem;
    color: var(--ai-fg-muted);
    line-height: 1.65;
  }

  .calendar-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .calendar-empty__board {
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--ai-border);
    border-radius: 1.2rem;
    background:
      radial-gradient(circle at 88% 10%, color-mix(in srgb, var(--ai-azure) 14%, transparent), transparent 11rem),
      var(--ai-surface);
  }

  .calendar-empty__board span {
    display: block;
    padding: 1rem;
    border: 1px solid var(--ai-border);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--ai-bg) 74%, var(--ai-surface));
    color: var(--ai-fg);
    font-weight: 850;
  }

  .calendar-empty__board span:nth-child(2) {
    transform: translateX(1rem);
  }

  .calendar-empty__board span:nth-child(3) {
    transform: translateX(2rem);
  }

  .event-directory {
    border-top: 1px solid var(--ai-border);
  }

  .event-entry {
    display: grid;
    grid-template-columns: 13rem 1fr minmax(9rem, 14rem);
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--ai-border);
  }

  .event-entry time {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .event-entry__meta {
    color: var(--ai-fg-muted);
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0 0 0.55rem;
  }

  .event-entry h2 {
    margin: 0 0 0.65rem;
    color: var(--ai-fg);
    font-size: clamp(1.45rem, 3vw, 2rem);
    letter-spacing: 0;
  }

  .event-entry p {
    color: var(--ai-fg-muted);
    line-height: 1.65;
  }

  .event-entry img {
    width: 100%;
    min-height: 8rem;
    border-radius: 1rem;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .events-hero,
    .format-list,
    .calendar-empty {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .event-entry {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
