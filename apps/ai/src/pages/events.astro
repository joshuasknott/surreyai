---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createConvexClient } from '@surreysocieties/admin';
import '../styles/global.css';

const SOCIETY_ID = 'ai';
const client = createConvexClient();
const events: any[] = (await client.query("events:listPublished", { societySlug: SOCIETY_ID }))
  .filter((event: any) => event.status === 'published');

const formatEventMonth = (date?: string) => {
  if (!date) return 'TBC';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return 'TBC';
  return parsed.toLocaleDateString('en-GB', { month: 'short' }).toUpperCase();
};

const formatEventDay = (date?: string) => {
  if (!date) return '-';
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return '-';
  return parsed.toLocaleDateString('en-GB', { day: '2-digit' });
};
---

<Layout title="Events" description="Upcoming and planned events from Surrey Artificial Intelligence Society — workshops, build nights, discussions, and careers events.">

  <section class="bg-ai-bg text-ai-fg border-b border-ai-border">
    <div class="mx-auto max-w-4xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-16 text-center">
      <h1 class="text-5xl sm:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6">What's happening next.</h1>
      <p class="text-ai-fg-muted text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto">
        Technical deep-dives, hands-on build nights, and industry speakers. Open to all Surrey students.
      </p>
    </div>
  </section>

  <!-- Events List -->
  <section class="py-16 sm:py-24 px-6 bg-ai-surface text-ai-fg">
    <div class="mx-auto max-w-4xl">
      {events.length === 0 ? (
        <div class="text-center py-16 bg-ai-bg border border-ai-border rounded-2xl shadow-sm">
          <p class="text-ai-fg-muted text-lg leading-relaxed max-w-xl mx-auto mb-8">
            We're currently planning our next semester of events. Join our community to get notified.
          </p>
          <a href="/join" class="btn-primary">
            Become a member
          </a>
        </div>
      ) : (
        <div class="flex flex-col gap-6">
          {events.map(event => (
            <article class="bg-ai-bg border border-ai-border rounded-xl p-6 sm:p-8 flex flex-col sm:flex-row gap-6 sm:gap-10 hover:shadow-md transition-shadow">
              
              <div class="flex flex-row sm:flex-col items-center sm:items-start gap-4 sm:gap-1 shrink-0 sm:w-32">
                <div class="text-center bg-ai-surface border border-ai-border px-4 py-3 rounded-lg min-w-20">
                  <span class="block text-ai-coral font-bold text-sm tracking-widest">{formatEventMonth(event.date)}</span>
                  <span class="block text-ai-fg font-extrabold text-3xl">{formatEventDay(event.date)}</span>
                </div>
              </div>

              <div class="flex-grow flex flex-col justify-center">
                <h2 class="font-bold text-2xl text-ai-fg mb-3">{event.title}</h2>
                <div class="flex flex-wrap gap-x-4 gap-y-2 mb-4 text-sm font-medium text-ai-azure tracking-wide uppercase">
                  {event.startTime && <span>{event.startTime}{event.endTime ? ` - ${event.endTime}` : ''}</span>}
                  {event.location && <span>{event.location}</span>}
                  {event.category && <span class="text-ai-fg-muted border border-ai-border px-2 py-0.5 rounded-md">{event.category}</span>}
                </div>
                <p class="text-ai-fg-muted leading-relaxed text-base">{event.description || 'Details to be announced.'}</p>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

</Layout>
