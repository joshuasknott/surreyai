---
export const prerender = false;
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import { getSocietyById } from '@surreysocieties/admin/config';
import eventsHero from '../assets/generated/ai-join-campus-sketch-hero.optimized.webp';
import '../styles/global.css';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
const society = getSocietyById('ai')!;
const events = await queryPublicConvex(api.events.listPublished, { societySlug: 'ai' }, []);
const formatDate = (date?: string) => {
  const parsed = new Date((date || '') + 'T00:00:00');
  return Number.isNaN(parsed.getTime()) ? 'Date to be announced' : parsed.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
};
const formats = [
  ['Workshops and tutorials', 'Get hands-on with AI tools, Python, machine learning and data analysis. Beginner sessions help you find a starting point.'],
  ['Projects and challenges', 'Bring an idea, build with other students and share what you make. Try a challenge or develop a portfolio project.'],
  ['Talks, careers and socials', 'Hear from speakers, explore the impact of AI and meet people with shared interests.'],
];
---

<Layout title="Events" description="Discover AI workshops, project nights, talks and socials from Surrey Artificial Intelligence Society.">
  <section class="ai-photo-hero ai-photo-hero--events" aria-labelledby="events-hero-title">
    <Image src={eventsHero} alt="" aria-hidden="true" class="ai-photo-hero__image" widths={[640, 960, 1440, 1800]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={72} />
    <div class="ai-photo-hero__inner"><div class="ai-photo-hero__copy">
      <p class="ai-photo-hero__eyebrow">What's on</p>
      <h1 id="events-hero-title">Events and workshops</h1>
      <p>Learn something new, try an idea and meet other students. Find published dates and joining details below.</p>
      <a href="#event-listings" class="btn-primary events-hero__link">Browse events</a>
    </div></div>
  </section>

  <section id="event-listings" class="ai-section" aria-labelledby="events-title">
    <div class="ai-section__inner">
      <div class="ai-section__header ai-section__header--split">
        <h2 id="events-title" class="section-title">Society events</h2>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-link">Follow event announcements &rarr;</a>
      </div>
      {events.length ? (
        <div class="event-directory">
          {events.map(event => (
            <article id={'event-' + event._id} class:list={['event-entry', { 'event-entry--image': event.imageUrl }]}>
              <time datetime={event.date}>{formatDate(event.date)}</time>
              <div class="event-entry__body">
                <p class="event-entry__meta">{[event.startTime && [event.startTime, event.endTime].filter(Boolean).join('–'), event.location, event.category].filter(Boolean).join(' · ') || 'More details coming soon'}</p>
                <h3>{event.title}</h3>
                {event.description && <p>{event.description}</p>}
                {event.registrationUrl && <a href={event.registrationUrl} target="_blank" rel="noopener noreferrer" class="text-link">Register for this event &rarr;</a>}
              </div>
              {event.imageUrl && <img src={event.imageUrl} alt="" loading="lazy" />}
            </article>
          ))}
        </div>
      ) : (
        <div class="calendar-empty">
          <div><h3>New dates are on the way.</h3><p>No events are listed at the moment. Follow @surreyaisociety for announcements, or join the society so you're ready for the next session.</p></div>
          <a href="/join" class="btn-primary">Join the society</a>
        </div>
      )}
    </div>
  </section>

  <section class="ai-section ai-section--tinted" aria-labelledby="formats-title">
    <div class="ai-section__inner">
      <div class="ai-section__header"><h2 id="formats-title" class="section-title">What to expect</h2><p class="section-intro">From a first workshop to a project of your own.</p></div>
      <div class="format-list">{formats.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div>
  </section>
</Layout>

<style>
  .events-hero__link { margin-top: 1.75rem; }
  .calendar-empty { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: 2rem; border: 1px solid var(--ai-border); background: var(--ai-surface); }
  .calendar-empty h3 { margin: 0 0 0.75rem; font-size: 1.6rem; font-weight: 750; letter-spacing: -0.025em; }
  .calendar-empty p { margin: 0; max-width: 40rem; color: var(--ai-fg-muted); line-height: 1.65; }
  .calendar-empty a { flex-shrink: 0; }
  .format-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .format-list article { border-top: 2px solid var(--ai-accent); padding-top: 1.25rem; }
  .format-list h3 { margin: 0 0 0.75rem; font-weight: 750; font-size: 1.25rem; line-height: 1.3; }
  .format-list p { margin: 0; color: var(--ai-fg-muted); line-height: 1.65; }
  .event-directory { border-top: 1px solid var(--ai-border); }
  .event-entry { display: grid; grid-template-columns: 12rem minmax(0, 1fr); gap: 2rem; padding: 2rem 0; border-bottom: 1px solid var(--ai-border); scroll-margin-top: 6rem; }
  .event-entry--image { grid-template-columns: 12rem minmax(0, 1fr) 12rem; }
  .event-entry time { color: var(--ai-link); font-weight: 750; }
  .event-entry h3 { margin: 0 0 0.75rem; font-size: 1.6rem; font-weight: 750; line-height: 1.2; }
  .event-entry p { color: var(--ai-fg-muted); line-height: 1.65; overflow-wrap: anywhere; }
  .event-entry__meta { margin: 0 0 0.5rem; font-size: 0.9rem; }
  .event-entry img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
  @media (max-width: 820px) { .format-list { grid-template-columns: 1fr; } .calendar-empty { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 640px) { .calendar-empty { padding: 1.25rem; } .calendar-empty a { width: 100%; } .event-entry, .event-entry--image { grid-template-columns: 1fr; gap: 0.75rem; } }
</style>
