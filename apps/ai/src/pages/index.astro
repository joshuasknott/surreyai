---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { queryPublicConvex } from "@surreysocieties/admin";
import "../styles/global.css";

import HomeHero from "../components/home/HomeHero.astro";
import AreasWeExplore from "../components/home/AreasWeExplore.astro";
import StudentProjects from "../components/home/StudentProjects.astro";
import EventsPreview from "../components/home/EventsPreview.astro";

const SOCIETY_ID = "ai";

const events: any[] = (
  await queryPublicConvex<any[]>("events:listPublished", { societySlug: SOCIETY_ID }, [])
).filter((event: any) => event.status === "published");
---

<Layout
  title="Home"
  description="Surrey Artificial Intelligence and Data Science Society - a student-led community for learning, building, and discussing AI and data science at the University of Surrey."
>
  <HomeHero />
  <AreasWeExplore />
  <StudentProjects />
  <EventsPreview events={events} />
</Layout>
