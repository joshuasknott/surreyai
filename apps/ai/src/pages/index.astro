---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import "../styles/flow-home.css";

import HomeHero from "../components/home/HomeHero.astro";
import FlowHomeSections from "../components/home/FlowHomeSections.astro";
import Programme from "../components/home/Programme.astro";
import HackPromotion from "../components/home/HackPromotion.astro";
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from "@surreysocieties/admin";
import { api } from "../../../../convex/_generated/api.js";

Astro.response.headers.set("Cache-Control", "no-store");
const committee = await queryPublicConvex(api.committee.listActive, { societySlug: 'ai' }, []);
const activities = await queryPublicConvex(api.planner.listPublished, {}, []);
const society = getSocietyById('ai')!;
---

<Layout
  title="Home"
  bodyClass="ai-curious-home"
  description="Surrey Artificial Intelligence Society is a student-led community for anyone curious about artificial intelligence, machine learning and data science, whatever their degree or experience."
>
  <HomeHero slot="hero" />
  <Programme activities={activities} />
  <HackPromotion />
  <FlowHomeSections society={society} committee={committee} />
</Layout>
