---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Home" description="Surrey AI Society — A student-led community for learning, building, and discussing artificial intelligence at the University of Surrey.">

  <!-- Hero -->
  <section class="snap-start bg-navy text-text-on-dark relative overflow-hidden flex items-center min-h-[85vh] border-b-2 border-accent-blue/30">
    <!-- Grid noise overlay -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(91,142,219,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(91,142,219,0.04)_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>
    <!-- Interactive Canvas Background -->
    <canvas id="hero-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>
    <!-- Accent corner block -->
    <div class="absolute top-0 right-0 w-40 h-40 border-l-2 border-b-2 border-accent-blue/20 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-24 h-24 border-r-2 border-t-2 border-accent-blue/20 pointer-events-none"></div>
    <!-- Nodes -->
    <div class="absolute top-[20%] left-[25%] node-dot"></div>
    <div class="absolute top-[60%] right-[20%] node-dot"></div>
    <div class="absolute bottom-[25%] left-[30%] node-dot"></div>
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32 relative z-10 w-full">
      <div class="flex flex-col items-start max-w-3xl">
        <div class="inline-flex items-center gap-3 mb-6 border border-accent-blue/30 px-3 py-1.5 bg-accent-blue/10">
          <div class="w-2 h-2 bg-accent-blue"></div>
          <span class="text-accent-blue text-xs font-bold uppercase tracking-widest">University of Surrey</span>
        </div>
        <h1 id="typewriter" class="text-4xl sm:text-5xl lg:text-7xl font-black tracking-tight leading-[1.05]">
          Surrey <span class="text-accent-blue">AI</span> Society
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-text-on-dark-secondary leading-relaxed max-w-2xl font-medium border-l-2 border-accent-blue/40 pl-4">
          A student-led community for learning, building, and exploring artificial intelligence at Surrey.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="/join" class="px-8 py-3.5 bg-accent-blue hover:bg-accent-blue-dark text-white font-bold uppercase tracking-wide text-sm transition-all duration-200 border border-accent-blue hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-accent-blue-light)]">
            Join the Society
          </a>
          <a href="/events" class="px-8 py-3.5 bg-transparent hover:bg-white/5 text-text-on-dark font-bold uppercase tracking-wide text-sm border border-white/20 transition-all duration-200 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_rgba(255,255,255,0.2)]">
            View Events
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Do — Bento Grid -->
  <section class="snap-start py-20 sm:py-24 px-6 bg-surface">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12">
        <div class="inline-flex items-center gap-3 mb-4 border border-border-subtle px-3 py-1.5">
          <span class="text-accent-blue text-xs font-bold uppercase tracking-widest">What We Do</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight">Explore AI Together</h2>
      </div>

      <!-- Bento grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-border-subtle border border-border-subtle">
        <div class="bg-surface-card p-8 hover:bg-surface-alt transition-all duration-200 group relative overflow-hidden col-span-2 lg:col-span-1 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-border-strong)]">
          <div class="absolute top-0 left-0 w-full h-1 bg-accent-blue transform -translate-y-full group-hover:translate-y-0 transition-transform"></div>
          <div class="w-10 h-10 border-2 border-accent-blue flex items-center justify-center text-accent-blue mb-6 text-xs font-bold font-mono">01</div>
          <h3 class="font-black text-xl mb-3 uppercase tracking-tight">Learn</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Workshops covering machine learning, neural networks, NLP, and more — beginner to advanced.</p>
        </div>
        <div class="bg-surface-card p-8 hover:bg-surface-alt transition-all duration-200 group relative overflow-hidden col-span-2 lg:col-span-1 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-border-strong)]">
          <div class="absolute top-0 left-0 w-full h-1 bg-accent-blue transform -translate-y-full group-hover:translate-y-0 transition-transform"></div>
          <div class="w-10 h-10 border-2 border-accent-blue flex items-center justify-center text-accent-blue mb-6 text-xs font-bold font-mono">02</div>
          <h3 class="font-black text-xl mb-3 uppercase tracking-tight">Build</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Collaborative projects, build nights, and hackathons where you create real things with AI.</p>
        </div>
        <div class="bg-surface-card p-8 hover:bg-surface-alt transition-all duration-200 group relative overflow-hidden hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-border-strong)]">
          <div class="absolute top-0 left-0 w-full h-1 bg-accent-blue transform -translate-y-full group-hover:translate-y-0 transition-transform"></div>
          <div class="w-10 h-10 border-2 border-accent-blue flex items-center justify-center text-accent-blue mb-6 text-xs font-bold font-mono">03</div>
          <h3 class="font-black text-xl mb-3 uppercase tracking-tight">Discuss</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Open conversations about AI ethics, policy, and careers.</p>
        </div>
        <div class="bg-surface-card p-8 hover:bg-surface-alt transition-all duration-200 group relative overflow-hidden hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-border-strong)]">
          <div class="absolute top-0 left-0 w-full h-1 bg-accent-blue transform -translate-y-full group-hover:translate-y-0 transition-transform"></div>
          <div class="w-10 h-10 border-2 border-accent-blue flex items-center justify-center text-accent-blue mb-6 text-xs font-bold font-mono">04</div>
          <h3 class="font-black text-xl mb-3 uppercase tracking-tight">Connect</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Meet students from every discipline curious about AI.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Events Preview -->
  <section class="snap-start bg-navy text-text-on-dark py-20 sm:py-24 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(91,142,219,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(91,142,219,0.04)_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>
    <div class="mx-auto max-w-6xl relative z-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <div class="inline-flex items-center gap-4 mb-4">
            <span class="w-12 h-px bg-border-subtle"></span>
            <span class="text-accent-blue text-xs font-bold uppercase tracking-widest">Events</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight">What's Coming Up</h2>
        </div>
        <a href="/events" class="text-accent-blue hover:text-accent-blue-dark text-sm font-semibold transition-colors">
          View all events →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 gap-px bg-white/10 border border-white/10">
        <div class="bg-surface-card p-8 hover:bg-surface-alt transition-colors group relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-accent-blue transform -translate-y-full group-hover:translate-y-0 transition-transform"></div>
          <span class="inline-block text-[10px] font-bold text-accent-blue border border-accent-blue/40 px-3 py-1 mb-4 uppercase tracking-wider">Coming Soon</span>
          <h3 class="font-bold text-lg mb-2 uppercase tracking-tight">Intro to AI at Surrey</h3>
          <p class="text-text-secondary text-sm">Our opening event — what AI is, why it matters, and what we'll be doing this year. Open to all students.</p>
        </div>
        <div class="bg-surface-card p-8 hover:bg-surface-alt transition-colors group relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-accent-blue transform -translate-y-full group-hover:translate-y-0 transition-transform"></div>
          <span class="inline-block text-[10px] font-bold text-accent-blue border border-accent-blue/40 px-3 py-1 mb-4 uppercase tracking-wider">Planned Format</span>
          <h3 class="font-bold text-lg mb-2 uppercase tracking-tight">Practical AI Build Night</h3>
          <p class="text-text-secondary text-sm">Hands-on session where you build something with AI tools — no prior experience required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Committee -->
  <section class="snap-start py-20 sm:py-24 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="mb-12">
        <div class="inline-flex items-center gap-3 mb-4 border border-border-subtle px-3 py-1.5">
          <span class="text-accent-blue text-xs font-bold uppercase tracking-widest">Our Team</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight">Meet the Committee</h2>
        <p class="mt-3 text-text-secondary">The students behind Surrey AI Society.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-px bg-border-subtle border border-border-subtle">
        {['President', 'Vice President', 'Treasurer', 'Events Lead', 'Technical Workshops Lead', 'Marketing Lead', 'Partnerships Lead', 'AI Ethics Lead', 'Projects Lead', 'First Year Rep'].map(role => (
          <div class="bg-surface-card p-6 text-center hover:bg-surface-alt transition-all duration-200 group relative overflow-hidden hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-border-strong)]">
            <div class="absolute top-0 left-0 w-full h-0.5 bg-accent-blue transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300"></div>
            <div class="w-12 h-12 border-2 border-accent-blue/30 group-hover:border-accent-blue flex items-center justify-center text-accent-blue text-xs font-bold font-mono mx-auto mb-4 transition-colors">
              {role.split(' ').map(w => w[0]).join('')}
            </div>
            <p class="text-sm font-bold uppercase tracking-tight">{role}</p>
            <p class="text-xs text-text-muted mt-1">Name TBC</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="snap-start bg-navy text-text-on-dark py-20 sm:py-28 px-6 relative overflow-hidden border-t-2 border-accent-blue/30">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(91,142,219,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(91,142,219,0.04)_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>
    <div class="mx-auto max-w-3xl text-center relative z-10">
      <div class="inline-flex items-center gap-3 mb-6 border border-accent-blue/30 px-3 py-1.5 bg-accent-blue/10">
        <div class="w-2 h-2 bg-accent-blue"></div>
        <span class="text-accent-blue text-xs font-bold uppercase tracking-widest">Get Involved</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-6">Ready to get involved?</h2>
      <p class="text-text-on-dark-secondary text-lg mb-10 max-w-xl mx-auto leading-relaxed border-l-2 border-accent-blue/40 pl-4 text-left">
        Whether you're studying computer science, business, psychology, or anything else — if you're curious about AI, you're welcome here.
      </p>
      <a href="/join" class="inline-block px-10 py-4 bg-accent-blue hover:bg-accent-blue-dark text-white font-bold uppercase tracking-wide text-sm transition-all duration-200 border border-accent-blue hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[4px_4px_0px_0px_var(--color-accent-blue-light)]">
        Join Surrey AI Society
      </a>
    </div>
  </section>

</Layout>

<script>
  // Terminal Typing Effect
  const titleElement = document.getElementById('typewriter');
  if (titleElement) {
    const originalHTML = titleElement.innerHTML;
    const textToType = "Surrey AI Society";
    titleElement.innerHTML = '<span class="text-accent-blue font-mono">_</span>';
    
    let i = 0;
    const speed = 70; // typing speed
    
    function typeWriter() {
      if (i < textToType.length) {
        const char = textToType.charAt(i);
        let currentText = textToType.substring(0, i + 1);
        // Style 'AI' correctly as it's typed
        currentText = currentText.replace('AI', '<span class="text-accent-blue">AI</span>');
        titleElement.innerHTML = currentText + '<span class="text-accent-blue font-mono animate-pulse">_</span>';
        i++;
        setTimeout(typeWriter, speed);
      } else {
        // Once done, set back to original HTML perfectly
        titleElement.innerHTML = originalHTML;
      }
    }
    
    setTimeout(typeWriter, 500);
  }

  // Interactive Canvas Background
  const canvas = document.getElementById('hero-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      let width = canvas.width = window.innerWidth;
      let height = canvas.height = window.innerHeight;
      
      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const particles = [];
      const numParticles = Math.min(80, Math.floor(window.innerWidth / 15));
      
      for (let i = 0; i < numParticles; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.8,
          vy: (Math.random() - 0.5) * 0.8,
          size: Math.random() * 2 + 1.5
        });
      }

      let mouse = { x: -1000, y: -1000 };
      
      // Update mouse position on move
      window.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });

      // Reset mouse position when leaving the hero area
      window.addEventListener('mouseout', () => {
        mouse.x = -1000;
        mouse.y = -1000;
      });

      function animate() {
        ctx.clearRect(0, 0, width, height);
        
        ctx.fillStyle = 'rgba(91, 142, 219, 0.7)';
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          
          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;
          
          // Draw brutalist square nodes instead of circles
          ctx.fillRect(p.x - p.size/2, p.y - p.size/2, p.size, p.size);
        });
        
        ctx.lineWidth = 1;
        
        for (let i = 0; i < numParticles; i++) {
          // Connect particles to each other
          for (let j = i + 1; j < numParticles; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            
            if (dist < 120) {
              ctx.strokeStyle = `rgba(91, 142, 219, ${0.15 - dist/800})`;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
          
          // Connect particles to mouse
          const dxMouse = particles[i].x - mouse.x;
          const dyMouse = particles[i].y - mouse.y;
          const distMouse = Math.sqrt(dxMouse * dxMouse + dyMouse * dyMouse);
          
          if (distMouse < 180) {
            ctx.strokeStyle = `rgba(91, 142, 219, ${0.4 - distMouse/450})`;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.stroke();
          }
        }
        
        requestAnimationFrame(animate);
      }
      
      animate();
    }
  }
</script>
