---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Join" description="Join Surrey Artificial Intelligence Society — find out how to become a member, what you'll get, and how to stay connected.">

  <section class="bg-ai-bg text-ai-fg border-b border-ai-border">
    <div class="mx-auto max-w-5xl px-6 pt-10 pb-8 sm:pt-14 sm:pb-10">
      <span class="text-ai-cyan text-xs font-semibold uppercase tracking-widest block mb-3">Membership</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-[1.1] mb-4">Join the Society</h1>
      <p class="text-ai-fg-muted text-base sm:text-lg leading-relaxed max-w-2xl">
        Open to all students at the University of Surrey — regardless of course, year, or prior experience with AI.
      </p>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-10 sm:py-14 px-6 bg-ai-bg text-ai-fg">
    <div class="mx-auto max-w-5xl">
      <div class="grid lg:grid-cols-5 gap-12 lg:gap-8 items-start">

        <!-- Left: benefits and eligibility -->
        <div class="lg:col-span-3 space-y-10">
          <div>
            <h2 class="text-2xl font-bold mb-5 text-ai-fg">What Membership Gets You</h2>
            <ul class="space-y-5">
              {[
                "Access to all technical workshops, build nights, and hackathons.",
                "Opportunity to join collaborative open-source AI projects.",
                "A multidisciplinary network of AI-curious students across every course.",
                "Early access to careers events and industry speaker panels.",
                "A voice in shaping the society's direction and event programme.",
              ].map(item => (
                <li class="flex items-start gap-4">
                  <svg class="w-5 h-5 text-ai-cyan shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-ai-fg-muted leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="text-2xl font-bold mb-5 text-ai-fg">Who Can Join?</h2>
            <div class="bg-ai-surface border border-ai-border rounded-xl p-6 sm:p-8">
              <p class="font-semibold text-ai-fg mb-3">No prior experience required.</p>
              <p class="text-ai-fg-muted leading-relaxed text-sm">
                You do not need to be studying computer science. AI impacts every field — we actively welcome members from law, business, arts, biosciences, and beyond. Many of our events assume no prior coding knowledge.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: membership CTA sidebar -->
        <aside class="lg:col-span-2">
          <div class="bg-ai-surface border border-ai-border rounded-xl p-6 sticky top-24">
            <h2 class="text-lg font-bold mb-2 text-ai-fg">Ready to Join?</h2>
            <p class="text-ai-fg-muted text-sm leading-relaxed mb-5">
              Official membership is registered through the Surrey Students' Union platform. We will link to the SU page once it is live.
            </p>

            <!-- Honest placeholder — membership URL not yet confirmed -->
            <div class="w-full py-4 px-5 bg-ai-bg border border-ai-border-strong text-ai-fg-muted text-sm text-center rounded-lg mb-3 select-none">
              Membership portal — opening soon
            </div>
            <p class="text-xs text-ai-fg-muted text-center">
              <!-- PLACEHOLDER: replace with SU membership link when live -->
              Check back here or follow our channels when the portal opens.
            </p>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- FAQ & Contact -->
  <section class="py-10 sm:py-14 px-6 bg-ai-surface border-t border-ai-border text-ai-fg">
    <div class="mx-auto max-w-5xl">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16">

        <div>
          <h2 class="text-2xl font-bold mb-6 text-ai-fg">FAQ</h2>
          <dl class="space-y-5">
            {[
              {
                q: "Do I need to know how to code?",
                a: "No. We run non-technical tracks covering AI ethics, implications, and tooling for students from any background.",
              },
              {
                q: "Is there a membership fee?",
                a: "Fees are set by the Surrey Students' Union and will be shown on the SU portal when membership opens.",
              },
              {
                q: "I'm a first-year — is this for me?",
                a: "Absolutely. We start from first principles. Many of our longest-serving members joined in their first term.",
              },
              {
                q: "How often do events run?",
                a: "We aim to run events throughout each term. Frequency depends on our programme — check the Events page for the latest.",
              },
            ].map(item => (
              <div>
                <dt class="font-semibold text-ai-fg mb-2">{item.q}</dt>
                <dd class="text-ai-fg-muted text-sm leading-relaxed">{item.a}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-6 text-ai-fg">Contact</h2>
          <div class="space-y-4">

            <!-- Email — confirmed -->
            <div class="bg-ai-bg border border-ai-border rounded-xl p-5 flex items-center justify-between gap-4">
              <div>
                <h3 class="font-semibold text-sm text-ai-fg">Email</h3>
                <p class="text-ai-fg-muted text-sm mt-0.5">su.ai@surrey.ac.uk</p>
              </div>
              <a
                href="mailto:su.ai@surrey.ac.uk"
                class="shrink-0 text-xs font-semibold text-ai-purple bg-ai-surface hover:bg-ai-border px-3 py-1.5 rounded-lg transition-colors uppercase tracking-wide"
              >
                Email us
              </a>
            </div>

            <!-- Instagram — placeholder, not yet confirmed -->
            <div class="bg-ai-bg border border-ai-border rounded-xl p-5 flex items-center justify-between gap-4">
              <div>
                <h3 class="font-semibold text-sm text-ai-fg">Instagram</h3>
                <!-- PLACEHOLDER: replace handle when account is confirmed -->
                <p class="text-ai-fg-muted text-sm mt-0.5">Social channels — coming soon</p>
              </div>
              <span class="shrink-0 text-xs font-semibold text-ai-fg-muted bg-ai-surface px-3 py-1.5 rounded-lg uppercase tracking-wide select-none">
                Soon
              </span>
            </div>

          </div>

          <p class="text-xs text-ai-fg-muted mt-6 leading-relaxed">
            For general enquiries or partnership interest, email us at the address above. We aim to respond within a few working days.
          </p>
        </div>

      </div>
    </div>
  </section>

</Layout>
