---
export const prerender = true;
import { getSocietyById } from "@surreysocieties/admin/config";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import joinHero from "../assets/generated/ai-committee-campus-sketch-hero.optimized.webp";
import "../styles/global.css";

const society = getSocietyById("ai")!;

const faqs = [
  {
    question: "Do I need to know how to code?",
    answer: "No. The society covers beginner sessions, AI tools, data literacy, careers, ethics, creative uses, and technical projects.",
  },
  {
    question: "Where is membership handled?",
    answer: "Membership is handled through Surrey Students' Union. Use the official membership link on this page so your membership is recorded properly.",
  },
  {
    question: "Can I join before events are listed?",
    answer: "Yes. Join now through the official membership page. Events appear once the committee confirms dates and locations.",
  },
  {
    question: "What can I get involved with?",
    answer: "Workshops, tutorials, challenges, competitions, project work, talks, careers sessions, and socials.",
  },
];

const membershipSteps = [
  {
    title: "Join through the Students' Union",
    text: "Use the official membership page so your membership is recorded correctly.",
  },
  {
    title: "Follow the society channels",
    text: "Instagram and email are the confirmed routes for updates on workshops, competitions, talks, projects, and socials.",
  },
  {
    title: "Get involved",
    text: "Come to events, try a project, or help with the next activity.",
  },
];
---

<Layout
  title="Join"
  description="Join Surrey Artificial Intelligence Society through Surrey Students' Union and get involved with AI workshops, data science projects, competitions, talks, careers activity, and socials."
  hideCTA={true}
>
  <section class="ai-photo-hero ai-photo-hero--join" aria-labelledby="join-hero-title">
    <Image
      src={joinHero}
      alt=""
      aria-hidden="true"
      class="ai-photo-hero__image"
      widths={[640, 960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      format="webp"
      quality={72}
    />
    <div class="ai-photo-hero__inner">
      <div class="ai-photo-hero__copy">
        <p class="ai-photo-hero__eyebrow">Membership</p>
      <h1 id="join-hero-title">Join the society</h1>
      <p>
        Membership is managed by Surrey Students' Union. Use the official membership page, then follow the society channels for event updates.
      </p>
      <div class="join-hero__actions">
        <a href={society.membershipUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Join via Students' Union</a>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="btn-secondary">Follow updates</a>
      </div>
    </div>
    </div>
  </section>

  <section class="ai-section" aria-labelledby="join-title">
    <div class="ai-section__inner join-layout">
      <div class="join-main">
        <h2 id="join-title">How to join</h2>
        <p>
          Join if you want to learn AI, build prototypes, enter challenges, discuss impact, explore careers, or meet students working with similar tools.
        </p>
        <div class="join-path">
          {membershipSteps.map((step, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <aside class="join-aside" aria-label="Society contact details">
        <h2>Official contact routes</h2>
        <p>Use these links for membership, updates, and society contact.</p>
        <a href={`mailto:${society.contactEmail}`}>{society.contactEmail}</a>
        <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer">@surreyaisociety</a>
        <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer">Students' Union page</a>
      </aside>
    </div>
  </section>

  <section class="ai-section ai-section--tinted join-signal" aria-labelledby="join-signal-title">
    <div class="ai-section__inner join-signal__inner">
      <div>
        <h2 id="join-signal-title" class="section-title">What members discuss</h2>
        <p class="section-intro">
          Sessions cover how data is made, how models behave, what outputs affect, and where human judgement still matters.
        </p>
      </div>
      <div class="join-judgement" aria-label="Questions members learn to ask">
        <span>Where did the data come from?</span>
        <span>Who benefits from the output?</span>
        <span>What should stay human?</span>
      </div>
    </div>
  </section>

  <section class="ai-section ai-section--tinted" aria-labelledby="faq-title">
    <div class="ai-section__inner">
      <div class="ai-section__header">
        <h2 id="faq-title" class="section-title">Before you join</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .join-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(22rem, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: 82rem;
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 8rem) 1.25rem clamp(3rem, 6vw, 5rem);
  }

  .join-hero__copy h1 {
    margin: 0;
    color: var(--ai-fg);
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .join-hero__copy p {
    max-width: 42rem;
    margin: 1.3rem 0 0;
    color: var(--ai-fg-muted);
    font-size: 1.12rem;
    line-height: 1.65;
  }

  .join-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .join-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .join-main {
    max-width: 54rem;
  }

  .join-main h2 {
    margin: 0 0 1rem;
    color: var(--ai-fg);
    font-size: clamp(1.65rem, 3vw, 2.75rem);
    letter-spacing: 0;
    line-height: 1.1;
  }

  .join-main > p {
    max-width: 42rem;
    margin: 0;
  }

  .join-main p,
  .join-aside p {
    color: var(--ai-fg-muted);
    line-height: 1.65;
  }

  .join-path {
    display: grid;
    gap: 1.35rem;
    margin-top: 2.2rem;
    border-top: 1px solid var(--ai-border);
  }

  .join-path article {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-top: 1.35rem;
  }

  .join-path span {
    color: var(--ai-azure);
    font-weight: 850;
  }

  .join-path h3 {
    margin: 0 0 0.35rem;
    color: var(--ai-fg);
    font-size: 1.15rem;
    letter-spacing: 0;
  }

  .join-path p {
    margin: 0;
  }

  .join-aside {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-left: 1px solid var(--ai-border);
    padding-left: clamp(1.5rem, 4vw, 2.2rem);
  }

  .join-aside h2 {
    margin: 0;
    color: var(--ai-fg);
    font-size: 1.6rem;
    letter-spacing: 0;
  }

  .join-aside a {
    color: var(--ai-azure);
    font-weight: 800;
    text-decoration: none;
    word-break: break-word;
  }

  .join-signal__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(22rem, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .join-judgement {
    display: grid;
    gap: 1rem;
  }

  .join-judgement span {
    display: block;
    padding: clamp(1.1rem, 3vw, 1.45rem);
    border: 1px solid var(--ai-border);
    border-radius: 1rem;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-azure) 8%, transparent), transparent 46%),
      var(--ai-bg);
    color: var(--ai-fg);
    font-weight: 850;
    line-height: 1.35;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.22s ease;
  }

  .join-judgement span:nth-child(2) {
    width: calc(100% - 1.2rem);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-sage) 8%, transparent), transparent 46%),
      var(--ai-bg);
    transform: translateX(1.2rem);
  }

  .join-judgement span:nth-child(3) {
    width: calc(100% - 2.4rem);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ai-coral) 8%, transparent), transparent 46%),
      var(--ai-bg);
    transform: translateX(2.4rem);
  }

  .join-judgement:hover span {
    border-color: var(--ai-border-strong);
  }

  .join-judgement:hover span:nth-child(2),
  .join-judgement:hover span:nth-child(3) {
    transform: translateX(0);
  }

  .faq-list {
    border-top: 1px solid var(--ai-border);
  }

  .faq-list details + details {
    border-top: 1px solid var(--ai-border);
  }

  .faq-list summary {
    color: var(--ai-fg);
    cursor: pointer;
    font-weight: 850;
    list-style: none;
    padding: 1.35rem 0;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list p {
    margin: 0;
    color: var(--ai-fg-muted);
    line-height: 1.65;
    padding: 0 0 1.35rem;
  }

  @media (max-width: 820px) {
    .join-hero,
    .join-layout,
    .join-signal__inner {
      grid-template-columns: 1fr;
    }

    .join-aside {
      border-left: 0;
      border-top: 1px solid var(--ai-border);
      padding-left: 0;
      padding-top: 1.5rem;
    }

    .join-judgement span:nth-child(2),
    .join-judgement span:nth-child(3) {
      transform: none;
      width: 100%;
    }
  }
</style>
