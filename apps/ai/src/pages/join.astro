---
export const prerender = true;
import { getSocietyById } from '@surreysocieties/admin/config';
import Layout from '../layouts/Layout.astro';
import AnimatedHero from '../components/common/AnimatedHero.astro';
import '../styles/global.css';

const society = getSocietyById('ai')!;
---

<Layout title="Join" description="Join Surrey Artificial Intelligence Society — find out how to become a member, what you'll get, and how to stay connected." hideCTA={true}>

  <AnimatedHero title="Become a part of the future." centered={false} minHeight="75vh">
    <div class="grid lg:grid-cols-12 gap-12 items-center max-w-6xl mx-auto mt-6 text-left relative z-10 w-full">
      
      <!-- Left Column: Vision & Benefits text -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
          Join a community of <span class="text-transparent bg-clip-text bg-gradient-to-r from-ai-azure to-ai-coral">builders, researchers, and thinkers</span>.
        </h2>
        <p class="text-lg sm:text-xl text-ai-fg-muted leading-relaxed mb-8 max-w-2xl">
          Whether you want to write your first neural network, debate the safety of large models, or design beautiful interfaces with generative tools — there is a place for you here. No prior technical background required.
        </p>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-6">
          <a 
            href={society.membershipUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary text-center px-8 py-4 text-base font-bold shadow-lg hover:scale-105 transition-transform"
          >
            Join via Students' Union
          </a>
          <a 
            href={society.studentsUnionUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-ai-fg-muted hover:text-ai-fg text-center text-sm font-semibold underline underline-offset-4 transition-colors py-2"
          >
            View society SU page
          </a>
        </div>
      </div>

      <!-- Right Column: Membership Pass Card (Frosted Glass Digital Pass) -->
      <div class="lg:col-span-5 w-full">
        <div class="premium-card p-8 sm:p-10 relative overflow-hidden membership-tilt-card cursor-pointer" style="--card-brand-color: var(--ai-azure);">
          <div class="premium-glow opacity-80"></div>

          <div class="relative z-10 flex flex-col h-full justify-between pointer-events-none">
            <!-- Card Header -->
            <div class="flex items-center justify-between border-b border-ai-border/40 pb-6 mb-6">
              <div class="flex items-center gap-3">
                <img
                  src="/logos/optimized/ai-logo.optimized.png"
                  alt="Surrey AI Logo"
                  width="36"
                  height="36"
                  class="h-9 w-9 rounded-full ring-2 ring-ai-azure/20"
                />
                <div>
                  <h3 class="font-bold text-sm tracking-tight text-ai-fg">Surrey AI Society</h3>
                  <p class="text-[9px] uppercase tracking-wider text-ai-azure font-bold font-sans">MEMBERSHIP CREDENTIAL</p>
                </div>
              </div>
              <div class="px-3 py-1 bg-ai-azure/10 text-ai-azure border border-ai-azure/20 rounded-md text-[9px] font-bold uppercase tracking-wider font-sans">
                ACTIVE
              </div>
            </div>

            <!-- Card Body: Benefits -->
            <div class="space-y-5 mb-6">
              <div class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full bg-ai-coral/10 border border-ai-coral/20 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-ai-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-sm sm:text-base text-ai-fg">Practical Workshops</h4>
                  <p class="text-xs sm:text-sm text-ai-fg-muted mt-0.5">Build agents, fine-tune models, and design systems from scratch.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full bg-ai-azure/10 border border-ai-azure/20 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-ai-azure" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-sm sm:text-base text-ai-fg">Society Hackathons</h4>
                  <p class="text-xs sm:text-sm text-ai-fg-muted mt-0.5">Team up to build innovative systems in our semester build nights.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-6 h-6 rounded-full bg-ai-sage/10 border border-ai-sage/20 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5 text-ai-sage" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-sm sm:text-base text-ai-fg">Industry Networking</h4>
                  <p class="text-xs sm:text-sm text-ai-fg-muted mt-0.5">Access exclusive career talks and network with industry experts.</p>
                </div>
              </div>
            </div>

            <!-- Card Footer -->
            <div class="flex items-center justify-between border-t border-ai-border/40 pt-5 mt-1 text-[9px] text-ai-fg-muted uppercase tracking-wider font-sans font-semibold">
              <div>VAL: 2026 / 2027</div>
              <div>NO. SU-AI-2026</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </AnimatedHero>

  <!-- FAQ & Contact -->
  <section class="py-16 sm:py-24 px-6 bg-ai-bg text-ai-fg relative z-10">
    <div class="mx-auto max-w-7xl">
      <div class="grid md:grid-cols-2 gap-8 lg:gap-12">

        <!-- FAQ Card -->
        <div class="premium-card p-8 sm:p-12 relative overflow-hidden" style="--card-brand-color: var(--ai-coral);">
          <div class="premium-glow"></div>

          <div class="relative z-10 flex flex-col h-full justify-between">
            <div>
              <h2 class="text-3xl sm:text-4xl font-extrabold mb-8 text-ai-fg tracking-tight">FAQ</h2>
              <div class="space-y-1">
                
                <!-- FAQ Item 1 -->
                <div class="faq-item border-b border-ai-border/40 py-5 group/faq cursor-pointer">
                  <button class="w-full flex items-center justify-between text-left focus:outline-none" aria-expanded="false">
                    <span class="font-bold text-lg text-ai-fg group-hover/faq:text-ai-coral transition-colors duration-300">Do I need to know how to code?</span>
                    <span class="faq-icon text-ai-coral shrink-0 ml-4 transition-transform duration-300 font-bold text-sm">+</span>
                  </button>
                  <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <p class="text-ai-fg-muted text-base leading-relaxed mt-3">
                      No. We run non-technical sessions covering AI ethics, implications, and tooling for students from any background.
                    </p>
                  </div>
                </div>

                <!-- FAQ Item 2 -->
                <div class="faq-item border-b border-ai-border/40 py-5 group/faq cursor-pointer">
                  <button class="w-full flex items-center justify-between text-left focus:outline-none" aria-expanded="false">
                    <span class="font-bold text-lg text-ai-fg group-hover/faq:text-ai-coral transition-colors duration-300">Is there a membership fee?</span>
                    <span class="faq-icon text-ai-coral shrink-0 ml-4 transition-transform duration-300 font-bold text-sm">+</span>
                  </button>
                  <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <p class="text-ai-fg-muted text-base leading-relaxed mt-3">
                      Fees are set by the Surrey Students' Union and will be shown on the SU portal when membership opens.
                    </p>
                  </div>
                </div>

                <!-- FAQ Item 3 -->
                <div class="faq-item border-b border-ai-border/40 py-5 group/faq cursor-pointer">
                  <button class="w-full flex items-center justify-between text-left focus:outline-none" aria-expanded="false">
                    <span class="font-bold text-lg text-ai-fg group-hover/faq:text-ai-coral transition-colors duration-300">I'm a first-year — is this for me?</span>
                    <span class="faq-icon text-ai-coral shrink-0 ml-4 transition-transform duration-300 font-bold text-sm">+</span>
                  </button>
                  <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <p class="text-ai-fg-muted text-base leading-relaxed mt-3">
                      Absolutely. We start from first principles. Many of our longest-serving members joined in their first term.
                    </p>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>

        <!-- Contact Card -->
        <div class="premium-card p-8 sm:p-12 relative overflow-hidden" style="--card-brand-color: var(--ai-azure);">
          <div class="premium-glow"></div>

          <div class="relative z-10 flex flex-col h-full justify-between">
            <div>
              <h2 class="text-3xl sm:text-4xl font-extrabold mb-8 text-ai-fg tracking-tight">Contact</h2>
              <div class="space-y-6">

                <!-- Email Link -->
                <a href={`mailto:${society.contactEmail}`} class="block group/link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-azure rounded-[2rem]">
                  <div class="bg-ai-bg/60 border border-ai-border rounded-[2rem] p-6 flex items-center justify-between gap-4 group-hover/link:border-ai-azure group-hover/link:bg-ai-surface transition-all duration-300 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)]">
                    <div>
                      <h3 class="font-bold text-base text-ai-fg">Email</h3>
                      <p class="text-ai-fg-muted text-sm mt-1 font-sans">{society.contactEmail}</p>
                    </div>
                    <span class="shrink-0 text-sm font-bold text-ai-azure group-hover/link:translate-x-1.5 transition-transform duration-300">
                      &rarr;
                    </span>
                  </div>
                </a>

                <!-- Instagram Link -->
                <a href={society.socials.instagram} target="_blank" rel="noopener noreferrer" class="block group/link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ai-coral rounded-[2rem]">
                  <div class="bg-ai-bg/60 border border-ai-border rounded-[2rem] p-6 flex items-center justify-between gap-4 group-hover/link:border-ai-coral group-hover/link:bg-ai-surface transition-all duration-300 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)]">
                    <div>
                      <h3 class="font-bold text-base text-ai-fg">Instagram</h3>
                      <p class="text-ai-fg-muted text-sm mt-1 font-sans">@surrey.ai.ds</p>
                    </div>
                    <span class="shrink-0 text-sm font-bold text-ai-coral group-hover/link:translate-x-1.5 transition-transform duration-300">
                      &rarr;
                    </span>
                  </div>
                </a>

              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  // 3D Card Hover Tilt Effect for Membership Card
  const memberCard = document.querySelector(".membership-tilt-card") as HTMLDivElement | null;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (memberCard && !prefersReducedMotion) {
    memberCard.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = memberCard.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const xc = rect.width / 2;
      const yc = rect.height / 2;
      const dx = x - xc;
      const dy = y - yc;
      
      const tiltX = (dy / yc) * -10;
      const tiltY = (dx / xc) * 10;
      
      memberCard.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale3d(1.02, 1.02, 1.02)`;
    });
    
    memberCard.style.transition = "transform 0.15s ease-out, box-shadow 0.3s ease";
    
    memberCard.addEventListener("mouseleave", () => {
      memberCard.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)";
    });
  }

  // FAQ Accordions
  const faqItems = document.querySelectorAll(".faq-item");
  faqItems.forEach((item) => {
    const button = item.querySelector("button");
    const content = item.querySelector(".faq-content") as HTMLElement | null;
    const icon = item.querySelector(".faq-icon");

    if (button && content) {
      item.addEventListener("click", () => {
        const isExpanded = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", isExpanded ? "false" : "true");
        
        if (isExpanded) {
          content.style.maxHeight = "0px";
          if (icon) icon.textContent = "+";
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
          if (icon) icon.textContent = "−";
        }
      });
    }
  });
</script>

<style>
  .membership-tilt-card {
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
</style>
