---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Join" description="Join Surrey Artificial Intelligence Society — find out how to become a member, what you'll get, and how to stay connected.">

  <!-- Header -->
  <section class="bg-navy text-text-on-dark py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-8 h-px bg-accent-blue"></span>
        <span class="text-accent-blue text-sm font-semibold uppercase tracking-wider">Get Involved</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">Join Us</h1>
      <p class="mt-4 text-text-on-dark-secondary text-lg max-w-2xl">Becoming a member takes less than a minute through Surrey Students' Union.</p>
    </div>
  </section>

  <!-- Why Join -->
  <section class="py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6">Why Join?</h2>
          <div class="space-y-4">
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Access to all workshops, build nights, and events throughout the year</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Join collaborative AI projects with other students</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Be part of a growing community of AI-curious students from every discipline</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Get early access to careers events and networking opportunities</p>
            </div>
            <div class="flex gap-3">
              <div class="w-6 h-6 rounded bg-accent-blue/10 flex items-center justify-center text-accent-blue shrink-0 mt-0.5">✓</div>
              <p class="text-text-secondary leading-relaxed">Shape the society — we're student-run and always open to ideas</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl sm:text-3xl font-bold mb-6">Who Can Join?</h2>
          <p class="text-text-secondary leading-relaxed mb-6">
            Any student at the University of Surrey can join. You don't need to be studying computer science or have any prior experience with AI. We welcome students from all years and all courses.
          </p>
          <p class="text-text-secondary leading-relaxed">
            Membership is managed through Surrey Students' Union. You can sign up on their website — the link will be available once our membership page is live.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-surface-alt py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="bg-surface-card rounded-xl p-8 sm:p-12 border border-navy/5 shadow-sm text-center">
        <h2 class="text-2xl sm:text-3xl font-bold mb-4">Become a Member</h2>
        <p class="text-text-secondary mb-8 max-w-lg mx-auto">Membership is handled through Surrey Students' Union. Click below when the link is available.</p>
        <a href="#" class="inline-block px-8 py-3.5 bg-accent-blue hover:bg-accent-blue-dark text-white font-semibold rounded-lg transition-all hover:shadow-lg hover:shadow-accent-blue/20">
          Surrey Union Link — Coming Soon
        </a>
      </div>
    </div>
  </section>

  <!-- Contact & FAQ -->
  <section class="py-16 sm:py-20 px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold mb-6">Stay Connected</h2>
          <div class="space-y-4">
            <div class="bg-surface-card rounded-xl p-5 border border-navy/5 shadow-sm">
              <h3 class="font-semibold mb-1">Instagram</h3>
              <p class="text-text-muted text-sm">Coming soon — follow us for event announcements and updates.</p>
            </div>
            <div class="bg-surface-card rounded-xl p-5 border border-navy/5 shadow-sm">
              <h3 class="font-semibold mb-1">Email</h3>
              <p class="text-text-muted text-sm">Contact details coming soon.</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold mb-6">FAQ</h2>
          <div class="space-y-4">
            <div>
              <h3 class="font-semibold mb-1">Do I need to know how to code?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">No. Many of our events are accessible to non-coders. We cover concepts, ethics, and careers as well as technical topics.</p>
            </div>
            <div>
              <h3 class="font-semibold mb-1">Is there a membership fee?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Membership fees are set through Surrey Students' Union. Details will be confirmed on our membership page.</p>
            </div>
            <div>
              <h3 class="font-semibold mb-1">Can I attend events without being a member?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Some events may be open to all, but membership gives you access to our full programme and community channels.</p>
            </div>
            <div>
              <h3 class="font-semibold mb-1">I'm a first-year. Is this for me?</h3>
              <p class="text-text-secondary text-sm leading-relaxed">Absolutely. We have a dedicated First Year Representative on our committee, and most events are designed to be beginner-friendly.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
