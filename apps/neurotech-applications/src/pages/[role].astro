---
import { getSecret } from 'astro:env/server';
import Layout from '../layouts/Layout.astro';
import { getCommitteeRole } from '../data/committeeRoles';
import { applicationsClosed } from '../lib/applicationWindow';
import '../styles/global.css';
import '../styles/committeeApplications.css';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store, max-age=0');
const role = getCommitteeRole(Astro.params.role ?? '');
if (!role) return Astro.redirect('/', 302);
const closed = applicationsClosed();
const social = role.slug === 'social-media-content';
const applicationsOpen = !closed && Boolean(getSecret('RESEND_API_KEY') && (getSecret('COMMITTEE_FROM_EMAIL') || getSecret('CONTACT_FROM_EMAIL'))) && (!social || Boolean(getSecret('BLOB_READ_WRITE_TOKEN')));
---

<Layout title={`${role.title} application 2026–27`} description={`Apply to be the Surrey Neurotech Society ${role.title} for 2026–27.`}>
  <div class="committee-page">
    <div class="committee-shell committee-detail">
      <a class="committee-back" href="/">← All committee roles</a>
      <div class="committee-detail-grid">
        <section class="committee-role-brief" aria-labelledby="role-title">
          <p class="committee-kicker">Role brief · 2026–27</p>
          <h1 id="role-title">{role.title}</h1>
          <p class="committee-lede">{role.intro}</p>
          <div class="committee-brief-block">
            <h2>What you could do</h2>
            <ul>{role.responsibilities.map((responsibility) => <li>{responsibility}</li>)}</ul>
          </div>
          <p class="committee-brief-note">Your experience can come from coursework, volunteering, personal projects or simply getting things started. We care about your ideas and your willingness to help.</p>
        </section>

        <section class="committee-form-panel" aria-labelledby="apply-title">
          {applicationsOpen ? <>
            <div class="committee-form-heading"><h2 id="apply-title">Tell us about yourself.</h2><p>Fields marked * are required. Your answers go directly to the application reviewer.</p></div>
            <form id="committee-application-form" action="/api/committee-applications" method="post" enctype="multipart/form-data" data-role={role.slug}>
              <input type="hidden" name="role" value={role.slug} />
              <div class="committee-honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
              <fieldset><legend>About you</legend>
                <div class="committee-field-grid">
                  <div class="committee-field"><label for="fullName">Full name <span>*</span></label><input id="fullName" name="fullName" type="text" autocomplete="name" maxlength="120" required /></div>
                  <div class="committee-field"><label for="email">Email address <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
                  <div class="committee-field"><label for="course">Course <span>*</span></label><input id="course" name="course" type="text" maxlength="150" required /></div>
                  <div class="committee-field"><label for="yearOfStudy">Year of study <span>*</span></label><input id="yearOfStudy" name="yearOfStudy" type="text" maxlength="60" placeholder="e.g. Year 2 or postgraduate" required /></div>
                </div>
                <div class="committee-field"><label for="experience">Relevant experience <span>*</span></label><textarea id="experience" name="experience" maxlength="2000" rows="4" placeholder="Coursework, clubs, volunteering, personal projects — all count." required></textarea></div>
                <div class="committee-field"><label for="motivation">Why would you like this role? <span>*</span></label><textarea id="motivation" name="motivation" maxlength="2000" rows="4" required></textarea></div>
                <div class="committee-field"><label for="availability">What time could you realistically contribute? <span>*</span></label><input id="availability" name="availability" type="text" maxlength="300" placeholder="e.g. Around two hours a week in term time" required /></div>
              </fieldset>
              <fieldset><legend>Your role task</legend>
                <p class="committee-task">{role.task}</p>
                {social && <div class="committee-assets"><p>Use one or more of these society assets in your mock post. You can combine them with your own design.</p><div><a href="/logos/brand/surrey-neurotech-logo.png" download>Society logo ↓</a><a href="/logos/brand/surrey-neurotech-avatar.png" download>Avatar ↓</a><a href="/social-cover.png" download>Cover artwork ↓</a></div></div>}
                {role.questions.map((question) => <div class="committee-field"><label for={question.key}>{question.label} <span>*</span></label><textarea id={question.key} name={question.key} maxlength="2000" rows="4" placeholder={question.hint} required></textarea></div>)}
                {social && <div class="committee-field"><label for="mockPost">Upload your mock post <span>*</span></label><input id="mockPost" name="mockPost" type="file" accept=".png,.jpg,.jpeg,.webp,.pdf,image/png,image/jpeg,image/webp,application/pdf" aria-describedby="mock-post-help" required /><small id="mock-post-help">PNG, JPG, WebP or PDF; maximum 15 MB. Your file uploads securely before the form is sent.</small></div>}
              </fieldset>
              <label class="committee-consent"><input type="checkbox" name="consent" value="yes" required /><span>I agree to my answers and any uploaded work being emailed to the application reviewer for committee selection. <strong>*</strong></span></label>
              <button class="committee-submit" type="submit">Send application <span aria-hidden="true">↗</span></button>
              <p id="committee-form-message" class="committee-form-message" role="alert" aria-live="polite" hidden></p>
            </form>
            <div id="committee-form-success" class="committee-success" role="status" hidden><p class="committee-kicker">Application sent</p><h2>Thank you for applying.</h2><p>Your application has been sent to the reviewer. Keep a copy of your work for your records.</p><a href="/">Explore other roles →</a></div>
          </> : <div class="committee-unavailable" role="status"><p class="committee-kicker">Applications</p><h2 id="apply-title">{closed ? 'Applications have closed.' : 'Thanks for your interest.'}</h2><p>{closed ? 'The application window has ended. You can still read the role brief above.' : 'Submissions will open when secure email delivery is connected. Please check back shortly.'}</p><a href="/">Explore all roles →</a></div>}
        </section>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { uploadCommitteeFile } from '../lib/committeeUploadClient';
  const form = document.querySelector<HTMLFormElement>('#committee-application-form');
  let uploaded: { file: File; url: string } | undefined;
  form?.querySelector('#mockPost')?.addEventListener('change', () => { uploaded = undefined; });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const message = document.querySelector<HTMLElement>('#committee-form-message');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const file = form.querySelector<HTMLInputElement>('#mockPost')?.files?.[0];
    if (!message || !button || button.disabled) return;
    message.hidden = true;
    if (file && file.size > 15_000_000) {
      message.textContent = 'Your mock post is over 15 MB. Please upload a smaller file.';
      message.hidden = false;
      return;
    }
    button.disabled = true;
    button.textContent = 'Sending…';
    try {
      const data = new FormData(form);
      data.delete('mockPost');
      if (file) {
        if (!uploaded || uploaded.file !== file) {
          button.textContent = 'Uploading mock post…';
          const url = await uploadCommitteeFile(file, percentage => { button.textContent = `Uploading mock post… ${percentage}%`; });
          uploaded = { file, url };
        }
        data.set('mockPostUrl', uploaded.url);
        button.textContent = 'Sending application…';
      }
      const response = await fetch(form.action, { method: 'POST', body: data });
      let result: { message?: string };
      try { result = await response.json(); } catch { throw new Error('We could not confirm delivery. Your answers are still on this page. Please try again shortly.'); }
      if (!response.ok) {
        if (response.status === 400) uploaded = undefined;
        throw new Error(result.message || 'We could not send your application. Please try again.');
      }
      form.hidden = true;
      document.querySelector<HTMLElement>('#committee-form-success')!.hidden = false;
      document.querySelector<HTMLElement>('#committee-form-success')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (error) {
      message.textContent = error instanceof TypeError || (error instanceof Error && error.name === 'TimeoutError')
        ? 'We could not connect to the website to confirm delivery. Your answers are still on this page. Check your connection and try again; on campus Wi-Fi, try mobile data.'
        : error instanceof Error ? error.message : 'We could not send your application. Please try again.';
      message.hidden = false;
    } finally {
      button.disabled = false;
      button.textContent = 'Send application ↗';
    }
  });
</script>
