---
import SocietyLayout from '@surreysocieties/ui/components/SocietyLayout';
interface Props { title: string; description: string; ogImage?: string; bodyClass?: string; hideCTA?: boolean; }
const { title, description, ogImage, bodyClass = 'nt-body' } = Astro.props;
---
<SocietyLayout societyKey="neurotech" title={title} description={description} ogImage={ogImage} bodyClass={bodyClass} assistantMascotSrc="/images/neurotech-assistant-neuron.webp" extraFontHrefs={["https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"]}>
  <slot />
</SocietyLayout>
