---
export const prerender = false;

import { Image } from 'astro:assets';
import { BrainCircuit } from 'lucide-astro';
import { getSocietyById } from '@surreysocieties/admin/config';
import { queryPublicConvex } from '@surreysocieties/admin';
import { api } from '../../../../convex/_generated/api.js';
import Layout from '../layouts/Layout.astro';
import NeurotechCommunity from '../components/NeurotechCommunity.astro';
import heroImage from '../assets/showcase/neurotech-hero-lab.png';
import workshopImage from '../assets/showcase/neurotech-workshop-bci.png';
import talkImage from '../assets/showcase/neurotech-journal-talk.png';
import communityImage from '../assets/showcase/neurotech-community.png';
import '../styles/global.css';
import '../styles/editorial-home.css';

const SOCIETY_ID = 'neurotech';
const society = getSocietyById(SOCIETY_ID)!;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

const committee = await queryPublicConvex(api.committee.listActive, { societySlug: SOCIETY_ID }, []);

const activityRows = [
  {
    title: 'Workshops & projects',
    copy: 'Record electrical activity from the scalp with EEG, learn to make sense of the signals, and explore brain–computer interfaces together.',
    image: workshopImage,
    alt: 'Students working with an EEG cap and neural signal software in a lab.',
    reverse: false,
  },
  {
    title: 'Journal clubs and talks',
    copy: 'Discuss a paper, ask questions and hear from researchers and people working in neurotechnology.',
    image: talkImage,
    alt: 'A neurotechnology talk with students viewing EEG and neuroimaging material.',
    reverse: true,
  },
  {
    title: 'Meet the community',
    copy: 'Get to know students from other courses through socials, shared projects and collaborations with other societies.',
    image: communityImage,
    alt: 'Students talking together around a neurotechnology project in a campus space.',
    reverse: false,
  },
];
---

<Layout
  title="Home"
  description="Take part in neurotechnology at Surrey through practical workshops, brain-computer interface projects, journal clubs, talks, collaborations and socials."
  bodyClass="nt-body nt-editorial"
>
  <section class="nt-hero" aria-labelledby="nt-hero-title">
    <div class="nt-hero__inner">
      <div class="nt-hero__copy">
        <h1 id="nt-hero-title">Take part in <span>neurotechnology</span> at Surrey.</h1>
        <p class="nt-hero__intro">
          Explore the brain and the technology that connects with it. Join workshops, research discussions and socials — no experience needed.
        </p>
        <div class="nt-actions" data-hero-actions>
          <a class="nt-button nt-button--yellow" href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer">
            Join the society <span aria-hidden="true">↗</span>
          </a>
          <a class="nt-button nt-button--outline" href={society.socials.linktree} target="_blank" rel="noopener noreferrer">
            Linktree <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="nt-hero__visual">
        <Image
          src={heroImage}
          alt="Students running an EEG session in a university laboratory."
          widths={[720, 960, 1200, 1600]}
          sizes="(min-width: 1440px) 720px, (min-width: 760px) 52vw, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          quality={82}
        />
      </div>
    </div>
    <img class="nt-hero__wave" src="/images/editorial/hero-wave.png" alt="" aria-hidden="true" width="1536" height="512" />
  </section>

  <section id="about" class="nt-facts" aria-labelledby="nt-facts-title">
    <img class="nt-facts__art" src="/images/editorial/neural-detail.webp" alt="" aria-hidden="true" width="540" height="414" loading="lazy" decoding="async" />
    <div class="nt-facts__inner">
      <BrainCircuit size={64} strokeWidth={1.5} aria-hidden="true" />
      <div>
        <h2 id="nt-facts-title">Where neuroscience meets technology.</h2>
        <p>We’re students from psychology, engineering, computing and beyond, exploring how technology can help us understand the brain. From recording brain signals to discussing new research, there’s room to learn whatever your background.</p>
      </div>
    </div>
  </section>

  <section id="activities" class="nt-activities" aria-labelledby="nt-activities-title">
    <div class="nt-section-heading">
      <h2 id="nt-activities-title">What happens in the society.</h2>
    </div>

    <div class="nt-activity-list">
      {activityRows.map((activity) => (
        <article class:list={['nt-activity', activity.reverse && 'nt-activity--reverse']}>
          <div class="nt-activity__image">
            <Image
              src={activity.image}
              alt={activity.alt}
              widths={[640, 960, 1200]}
              sizes="(min-width: 1440px) 760px, (min-width: 760px) 53vw, 100vw"
              loading="lazy"
              decoding="async"
              quality={80}
            />
          </div>
          <div class="nt-activity__copy">
            <h3>{activity.title}</h3>
            <p>{activity.copy}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <NeurotechCommunity society={society} committee={committee} />
</Layout>
