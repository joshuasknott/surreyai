# Local development (never commit real values)
PUBLIC_APP_URL=http://127.0.0.1:8787
APP_ORIGIN=http://127.0.0.1:8787
ADMIN_USER_IDS=
# SHA-256 hash (base64url) of a one-time, 32-byte administrator claim token.
ADMIN_BOOTSTRAP_HASH=
# Set as a Worker secret in production. Never expose this through VITE_ variables.
BYOK_ENCRYPTION_KEY=
# Cloudflare Pages custom-domain management (set as Worker secrets/vars in production)
PAGES_ACCOUNT_ID=
PAGES_PROJECT_NAME=
PAGES_PROJECT_SUBDOMAIN=
PAGES_API_TOKEN=
# Workers AI allowance is measured in neurons, not model tokens. Defaults stay
# below the free daily allocation; raise them only when a paid allocation exists.
SOCIETY_AI_DAILY_NEURONS=9000
SOCIETY_AI_USER_DAILY_NEURONS=1500
SOCIETY_AI_MAX_INPUT_TOKENS=16384
SOCIETY_AI_MAX_OUTPUT_TOKENS=4096
# Cloudflare Worker secrets/bindings are configured in wrangler.jsonc; do not put provider keys in VITE_ variables.
