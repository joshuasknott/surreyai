{
  "name": "surreyai",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/ai",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:ai",
    "dev:ai": "npm run dev -w apps/ai",
    "build": "npm run build:ai",
    "build:ai": "npm run build -w apps/ai",
    "build:vercel": "node scripts/build-vercel.mjs ai",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:planner": "playwright test --config e2e/planner.config.ts planner.spec.ts",
    "dev:portfolio": "npm --prefix apps/portfoliostudio run dev",
    "build:portfolio": "npm --prefix apps/portfoliostudio run build",
    "test:portfolio": "npm --prefix apps/portfoliostudio test",
    "typecheck:portfolio": "npm --prefix apps/portfoliostudio run typecheck",
    "test:e2e:portfolio": "npm --prefix apps/portfoliostudio run test:e2e",
    "deploy:portfolio": "npm --prefix apps/portfoliostudio run deploy",
    "backend:check": "tsc --noEmit -p convex/tsconfig.json",
    "build:hack": "npm --prefix apps/hack run build",
    "test:hack": "npm --prefix apps/hack test"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "astro": {
      "esbuild": "0.28.1"
    },
    "vite": {
      ".": "^7.3.2",
      "esbuild": "0.28.1"
    }
  },
  "dependencies": {
    "convex": "^1.37.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "convex-test": "^0.0.54",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
