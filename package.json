{
  "name": "surreysocieties",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:ai": "npm run dev -w apps/ai",
    "dev:business": "npm run dev -w apps/business",
    "dev:neurotech": "npm run dev -w apps/neurotech",
    "build:ai": "npm run build -w apps/ai",
    "build:business": "npm run build -w apps/business",
    "build:neurotech": "npm run build -w apps/neurotech",
    "build:all": "npm run build -w apps/ai && npm run build -w apps/business && npm run build -w apps/neurotech",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e": "npm run test:e2e",
    "provision:admins": "node scripts/provision-admins.mjs"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "astro": {
      "esbuild": "0.28.1"
    },
    "vite": {
      ".": "^7.3.2",
      "esbuild": "0.28.1"
    }
  },
  "dependencies": {
    "convex": "^1.37.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "convex-test": "^0.0.54",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
