{
  "name": "surreysocieties",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:ai": "npm run dev -w apps/ai",
    "dev:business": "npm run dev -w apps/business",
    "dev:neurotech": "npm run dev -w apps/neurotech",
    "build:ai": "npm run build -w apps/ai",
    "build:business": "npm run build -w apps/business",
    "build:neurotech": "npm run build -w apps/neurotech",
    "build:all": "npm run build -w apps/ai && npm run build -w apps/business && npm run build -w apps/neurotech",
    "provision:admins": "node scripts/provision-admins.mjs"
  },
  "overrides": {
    "vite": "^7.3.2"
  },
  "dependencies": {
    "convex": "^1.37.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
