---
import type { AssistantSocietyConfig } from '../assistant';

interface Props {
  config: AssistantSocietyConfig;
  endpoint?: string;
}

const { config, endpoint = '/api/assistant/chat' } = Astro.props;
const widgetId = `society-assistant-${config.societyKey}`;
const starterPrompts = JSON.stringify(config.starterPrompts);
const fallbackLinks = JSON.stringify(config.fallbackLinks);
const styleVars = [
  `--assistant-accent:${config.brand.accent}`,
  `--assistant-accent-text:${config.brand.accentText}`,
  `--assistant-surface:${config.brand.surface}`,
  `--assistant-text:${config.brand.text}`,
  `--assistant-muted:${config.brand.mutedText}`,
  `--assistant-border:${config.brand.border}`,
].join(';');
---

<div
  id={widgetId}
  class="society-assistant"
  data-assistant-widget
  data-endpoint={endpoint}
  data-society-name={config.societyName}
  data-short-name={config.shortName}
  data-description={config.shortDescription}
  data-starter-prompts={starterPrompts}
  data-fallback-links={fallbackLinks}
  style={styleVars}
>
  <button
    type="button"
    class="assistant-toggle"
    aria-label={`Open ${config.shortName} assistant`}
    aria-expanded="false"
    aria-controls={`${widgetId}-panel`}
  >
    <span class="assistant-toggle-mark" aria-hidden="true">
      <img src={config.logo.src} alt="" width="42" height="42" loading="lazy" decoding="async" />
    </span>
    <span class="assistant-toggle-spark" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M7 8.25h10M7 12h6.5M7 15.75h4.75" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
      </svg>
    </span>
  </button>

  <section
    id={`${widgetId}-panel`}
    class="assistant-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby={`${widgetId}-title`}
    hidden
  >
    <header class="assistant-header">
      <div class="assistant-brand">
        <span class="assistant-brand-mark">
          <img src={config.logo.src} alt={config.logo.alt} width="44" height="44" loading="lazy" decoding="async" />
        </span>
        <div>
        <p class="assistant-eyebrow">{config.shortName}</p>
        <h2 id={`${widgetId}-title`}>Website assistant</h2>
        </div>
      </div>
      <div class="assistant-header-actions">
        <button type="button" class="assistant-reset" aria-label="Reset assistant conversation">Reset</button>
        <button type="button" class="assistant-close" aria-label={`Close ${config.shortName} assistant`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="assistant-body">
      <div class="assistant-intro">
        <p>{config.shortDescription}</p>
      </div>
      <div class="assistant-starters" aria-label="Suggested questions"></div>
      <div class="assistant-messages" aria-live="polite" aria-relevant="additions"></div>
    </div>

    <form class="assistant-form">
      <label class="sr-only" for={`${widgetId}-input`}>Ask {config.shortName}</label>
      <textarea
        id={`${widgetId}-input`}
        class="assistant-input"
        name="message"
        rows="1"
        maxlength="1200"
        placeholder="Ask a quick question..."
      ></textarea>
      <button type="submit" class="assistant-send">Send</button>
    </form>
  </section>
</div>

<style>
  .society-assistant {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    color: var(--assistant-text);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .assistant-toggle {
    width: 3.5rem;
    height: 3.5rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--assistant-accent) 54%, transparent);
    border-radius: 999px;
    background: var(--assistant-accent);
    color: var(--assistant-accent-text);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.22);
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .assistant-toggle:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 52px rgba(15, 23, 42, 0.26);
  }

  .assistant-toggle:focus-visible,
  .assistant-close:focus-visible,
  .assistant-reset:focus-visible,
  .assistant-send:focus-visible,
  .assistant-input:focus-visible,
  .assistant-starter:focus-visible {
    outline: 2px solid var(--assistant-accent);
    outline-offset: 3px;
  }

  .assistant-toggle-mark {
    width: 2.45rem;
    height: 2.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--assistant-accent-text) 58%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--assistant-surface) 92%, transparent);
  }

  .assistant-toggle-mark img,
  .assistant-brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .assistant-toggle-spark {
    position: absolute;
    right: -0.18rem;
    bottom: -0.18rem;
    width: 1.45rem;
    height: 1.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--assistant-accent) 45%, var(--assistant-border));
    border-radius: 999px;
    background: var(--assistant-surface);
    color: var(--assistant-accent);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.16);
  }

  .assistant-toggle-spark svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .assistant-panel {
    position: fixed;
    right: 1.25rem;
    bottom: 5.4rem;
    width: min(25.5rem, calc(100vw - 2.5rem));
    height: min(40rem, calc(100vh - 7rem));
    max-height: calc(100dvh - 7rem);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--assistant-border);
    border-radius: 1rem;
    background: var(--assistant-surface);
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.24);
  }

  .assistant-panel[hidden] {
    display: none;
  }

  .assistant-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border-bottom: 1px solid var(--assistant-border);
    background: color-mix(in srgb, var(--assistant-surface) 92%, var(--assistant-accent) 8%);
  }

  .assistant-brand {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 0.75rem;
  }

  .assistant-brand-mark {
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--assistant-accent) 28%, var(--assistant-border));
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--assistant-surface) 88%, #ffffff 12%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.48);
  }

  .assistant-eyebrow {
    margin: 0 0 0.2rem;
    color: var(--assistant-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .assistant-header h2 {
    margin: 0;
    color: var(--assistant-text);
    font-size: 1rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0;
  }

  .assistant-header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .assistant-reset,
  .assistant-close {
    border: 1px solid var(--assistant-border);
    background: var(--assistant-surface);
    color: var(--assistant-text);
    cursor: pointer;
  }

  .assistant-reset {
    min-height: 2rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .assistant-close {
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
  }

  .assistant-close svg {
    width: 1rem;
    height: 1rem;
  }

  .assistant-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0.95rem;
    background:
      radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--assistant-accent) 10%, transparent), transparent 13rem),
      var(--assistant-surface);
  }

  .assistant-intro {
    margin-bottom: 0.85rem;
    padding: 0.85rem;
    border: 1px solid var(--assistant-border);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--assistant-surface) 88%, var(--assistant-accent) 12%);
  }

  .assistant-intro p {
    margin: 0;
    color: var(--assistant-muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .assistant-starters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .assistant-starter {
    max-width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--assistant-border);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--assistant-surface) 96%, var(--assistant-accent) 4%);
    color: var(--assistant-text);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
  }

  .assistant-starter:hover {
    border-color: color-mix(in srgb, var(--assistant-accent) 65%, var(--assistant-border));
  }

  .assistant-messages {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .assistant-message {
    max-width: 88%;
    padding: 0.75rem 0.85rem;
    border-radius: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .assistant-message.user {
    align-self: flex-end;
    background: var(--assistant-accent);
    color: var(--assistant-accent-text);
    border-bottom-right-radius: 0.25rem;
  }

  .assistant-message.assistant,
  .assistant-message.loading,
  .assistant-message.error {
    align-self: flex-start;
    border: 1px solid var(--assistant-border);
    background: color-mix(in srgb, var(--assistant-surface) 92%, #f8fafc 8%);
    color: var(--assistant-text);
    border-bottom-left-radius: 0.25rem;
  }

  .assistant-message.error {
    color: #991b1b;
    border-color: #fecaca;
    background: #fef2f2;
  }

  .assistant-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
    padding: 0.85rem;
    border-top: 1px solid var(--assistant-border);
    background: color-mix(in srgb, var(--assistant-surface) 94%, var(--assistant-accent) 6%);
  }

  .assistant-input {
    min-height: 2.55rem;
    max-height: 7rem;
    resize: none;
    border: 1px solid var(--assistant-border);
    border-radius: 0.8rem;
    padding: 0.7rem 0.8rem;
    color: var(--assistant-text);
    background: var(--assistant-surface);
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .assistant-send {
    align-self: end;
    min-height: 2.55rem;
    padding: 0 0.95rem;
    border: 1px solid var(--assistant-accent);
    border-radius: 0.8rem;
    background: var(--assistant-accent);
    color: var(--assistant-accent-text);
    font-weight: 800;
    cursor: pointer;
  }

  .assistant-send:disabled,
  .assistant-input:disabled,
  .assistant-starter:disabled {
    opacity: 0.62;
    cursor: not-allowed;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .society-assistant {
      right: 1rem;
      bottom: 1rem;
    }

    .assistant-panel {
      right: 0.75rem;
      left: 0.75rem;
      bottom: 5.1rem;
      width: auto;
      height: min(38rem, calc(100vh - 6.25rem));
      max-height: calc(100dvh - 6.25rem);
      border-radius: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .assistant-toggle {
      transition: none;
    }
  }
</style>

<style is:global>
  [data-assistant-widget] .assistant-starter {
    max-width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--assistant-border);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--assistant-surface) 96%, var(--assistant-accent) 4%);
    color: var(--assistant-text);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
  }

  [data-assistant-widget] .assistant-starter:hover {
    border-color: color-mix(in srgb, var(--assistant-accent) 65%, var(--assistant-border));
  }

  [data-assistant-widget] .assistant-starter:focus-visible,
  [data-assistant-widget] .assistant-message:focus-visible {
    outline: 2px solid var(--assistant-accent);
    outline-offset: 3px;
  }

  [data-assistant-widget] .assistant-message {
    max-width: 88%;
    padding: 0.75rem 0.85rem;
    border-radius: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-word;
  }

  [data-assistant-widget] .assistant-message.user {
    align-self: flex-end;
    background: var(--assistant-accent);
    color: var(--assistant-accent-text);
    border-bottom-right-radius: 0.25rem;
  }

  [data-assistant-widget] .assistant-message.assistant,
  [data-assistant-widget] .assistant-message.loading,
  [data-assistant-widget] .assistant-message.error {
    align-self: flex-start;
    border: 1px solid var(--assistant-border);
    background: color-mix(in srgb, var(--assistant-surface) 92%, #f8fafc 8%);
    color: var(--assistant-text);
    border-bottom-left-radius: 0.25rem;
  }

  [data-assistant-widget] .assistant-message.error {
    color: #991b1b;
    border-color: #fecaca;
    background: #fef2f2;
  }
</style>

<script>
  let assistantModulePromise;

  const loadAssistant = () => {
    assistantModulePromise ??= import('../assistantWidget.client');
    return assistantModulePromise;
  };

  document.querySelectorAll('[data-assistant-widget]').forEach((root) => {
    const toggle = root.querySelector('.assistant-toggle');

    toggle?.addEventListener('pointerenter', () => {
      loadAssistant();
    }, { once: true, passive: true });

    toggle?.addEventListener('focus', () => {
      loadAssistant();
    }, { once: true });

    toggle?.addEventListener('click', async (event) => {
      if (root.dataset.initialized === 'true') return;
      event.preventDefault();
      const { initSocietyAssistant } = await loadAssistant();
      initSocietyAssistant(root, { open: true });
    });
  });
</script>
