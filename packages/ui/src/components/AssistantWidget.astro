---
import { AtSign, BookOpen, RotateCcw, Send, UsersRound, X } from 'lucide-astro';
import { getSocietyById } from '@surreysocieties/admin/config';
import type { AssistantSocietyConfig } from '../assistant';

interface Props {
  config: AssistantSocietyConfig;
  endpoint?: string;
}

const { config, endpoint = '/api/assistant/chat' } = Astro.props;
const widgetId = 'society-assistant-' + config.societyKey;
const title = config.societyKey === 'ai' ? 'AI Society assistant' : config.societyKey === 'business' ? 'Business Society assistant' : 'Neurotech assistant';
const logo = getSocietyById(config.societyKey)!.logo;
const starterIcons = {
  ai: [BookOpen, AtSign, UsersRound],
  business: [BookOpen, AtSign, UsersRound],
  neurotech: [BookOpen, AtSign, UsersRound],
};
const starters = config.starterPrompts.map((starter, index) => ({
  ...starter,
  Icon: starterIcons[config.societyKey][index],
}));
const styleVars = [
  '--assistant-accent:' + config.brand.accent,
  '--assistant-accent-text:' + config.brand.accentText,
  '--assistant-surface:' + config.brand.surface,
  '--assistant-text:' + config.brand.text,
  '--assistant-muted:' + config.brand.mutedText,
  '--assistant-border:' + config.brand.border,
].join(';');
---

<div
  id={widgetId}
  class={'society-assistant assistant--' + config.societyKey}
  data-assistant-widget
  data-endpoint={endpoint}
  data-society-name={config.societyName}
  data-short-name={config.shortName}
  style={styleVars}
>
  <button
    type="button"
    class="assistant-toggle"
    aria-label={'Open ' + config.shortName + ' assistant'}
    aria-expanded="false"
    aria-controls={widgetId + '-panel'}
  >
    <img src={logo} alt="" width="56" height="56" loading="lazy" decoding="async" />
  </button>

  <section
    id={widgetId + '-panel'}
    class="assistant-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby={widgetId + '-title'}
    hidden
  >
    <header class="assistant-header">
      <div class="assistant-brand">
        <span class="assistant-brand-mark" aria-hidden="true"><img src={logo} alt="" width="34" height="34" loading="lazy" decoding="async" /></span>
        <h2 id={widgetId + '-title'}>{title}</h2>
      </div>
      <div class="assistant-header-actions">
        <button type="button" class="assistant-reset" aria-label="Reset assistant conversation" title="Reset conversation">
          <RotateCcw size={17} strokeWidth={1.8} aria-hidden="true" />
        </button>
        <button type="button" class="assistant-close" aria-label={'Close ' + config.shortName + ' assistant'}>
          <X size={20} strokeWidth={1.8} aria-hidden="true" />
        </button>
      </div>
    </header>

    <div class="assistant-body">
      <div class="assistant-welcome">
        <p class="assistant-greeting">{config.greeting}</p>
        <p class="assistant-intro">{config.intro}</p>
        <div class="assistant-starters" aria-label="Suggested questions">
          {starters.map(({ label, prompt, Icon }) => (
            <button type="button" class="assistant-starter" data-prompt={prompt}>
              <Icon size={17} strokeWidth={1.8} aria-hidden="true" />
              <span>{label}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="assistant-messages" aria-live="polite" aria-relevant="additions"></div>
      <nav class="assistant-recovery" aria-label="Society information" hidden>
        <p>You can also find what you need here:</p>
        <div>{config.fallbackLinks.map(link => <a href={link.href}>{link.label} &rarr;</a>)}</div>
      </nav>
    </div>

    <form class="assistant-form">
      <label class="assistant-sr-only" for={widgetId + '-input'}>Ask {config.shortName}</label>
      <textarea
        id={widgetId + '-input'}
        class="assistant-input"
        name="message"
        rows="1"
        maxlength="1200"
        placeholder="Ask a question"
      ></textarea>
      <button type="submit" class="assistant-send" aria-label="Send message" disabled>
        <Send size={19} strokeWidth={1.9} aria-hidden="true" />
      </button>
    </form>
  </section>
</div>

<style is:global>
  [data-assistant-widget] {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    color: var(--assistant-text);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  [data-assistant-widget].assistant--business { font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif; }
  [data-assistant-widget].assistant--neurotech { font-family: Manrope, Inter, ui-sans-serif, system-ui, sans-serif; }

  [data-assistant-widget] .assistant-toggle {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--assistant-accent) 25%, transparent);
    border-radius: 50%;
    background: #102338;
    box-shadow: 0 8px 24px #0b1a2d24;
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  [data-assistant-widget] .assistant-toggle:hover { transform: translateY(-2px); box-shadow: 0 12px 26px #0b1a2d2e; }
  [data-assistant-widget] .assistant-toggle img { display: block; width: 100%; height: 100%; object-fit: cover; }

  [data-assistant-widget] .assistant-panel {
    position: fixed;
    right: 1.25rem;
    bottom: 5.5rem;
    display: flex;
    flex-direction: column;
    width: min(28rem, calc(100vw - 2.5rem));
    height: min(21rem, calc(100dvh - 7rem));
    overflow: hidden;
    border: 1px solid var(--assistant-border);
    border-radius: 1.15rem;
    background: var(--assistant-surface);
    box-shadow: 0 16px 42px #0b1a2d29;
  }
  [data-assistant-widget] .assistant-panel[hidden] { display: none; }
  [data-assistant-widget] .assistant-panel:has(.assistant-messages:not(:empty)) { height: min(28rem, calc(100dvh - 7rem)); }
  [data-assistant-widget].assistant--business .assistant-panel { border-color: #071a2d; border-radius: 0.9rem; }
  [data-assistant-widget].assistant--neurotech .assistant-panel { border-color: #d7dfe8; }

  [data-assistant-widget] .assistant-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 4.25rem;
    padding: 0.65rem 0.9rem 0.65rem 1.15rem;
    border-bottom: 1px solid var(--assistant-border);
  }
  [data-assistant-widget] .assistant-brand { display: flex; align-items: center; min-width: 0; gap: 0.65rem; }
  [data-assistant-widget] .assistant-brand-mark { display: grid; place-items: center; flex: 0 0 2.15rem; width: 2.15rem; height: 2.15rem; overflow: hidden; border-radius: 50%; }
  [data-assistant-widget] .assistant-brand-mark img { display: block; width: 100%; height: 100%; object-fit: cover; }
  [data-assistant-widget] .assistant-header h2 { margin: 0; color: var(--assistant-text); font-size: 0.92rem; font-weight: 750; letter-spacing: -0.015em; line-height: 1.2; }
  [data-assistant-widget].assistant--business .assistant-header h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.04rem; }
  [data-assistant-widget] .assistant-header-actions { display: flex; align-items: center; gap: 0.1rem; }
  [data-assistant-widget] .assistant-reset,
  [data-assistant-widget] .assistant-close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--assistant-text);
    cursor: pointer;
  }
  [data-assistant-widget] .assistant-reset:hover,
  [data-assistant-widget] .assistant-close:hover { background: #0b1a2d0c; }
  [data-assistant-widget] .assistant-reset:disabled { opacity: 0.35; cursor: not-allowed; }

  [data-assistant-widget] .assistant-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.2rem 1.25rem 1rem;
  }
  [data-assistant-widget] .assistant-welcome[hidden] { display: none; }
  [data-assistant-widget] .assistant-greeting {
    margin: 0 0 0.3rem;
    color: var(--assistant-text);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  [data-assistant-widget].assistant--business .assistant-greeting { font-family: 'Playfair Display', Georgia, serif; font-size: 1.55rem; font-weight: 700; }
  [data-assistant-widget].assistant--neurotech .assistant-greeting { font-size: 1.35rem; font-weight: 750; }
  [data-assistant-widget] .assistant-intro { margin: 0 0 1rem; color: var(--assistant-muted); font-size: 0.82rem; line-height: 1.45; }
  [data-assistant-widget] .assistant-starters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.45rem; }
  [data-assistant-widget] .assistant-starters[hidden] { display: none; }
  [data-assistant-widget] .assistant-starter {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.45rem;
    min-height: 3.5rem;
    max-width: 100%;
    padding: 0.55rem 0.6rem;
    border: 1px solid var(--assistant-border);
    border-radius: 0.8rem;
    background: transparent;
    color: var(--assistant-text);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }
  [data-assistant-widget] .assistant-starter:hover { border-color: var(--assistant-accent); background: color-mix(in srgb, var(--assistant-accent) 7%, var(--assistant-surface)); }
  [data-assistant-widget].assistant--business .assistant-starter { border-radius: 0.5rem; }
  [data-assistant-widget].assistant--business .assistant-starter { flex-direction: column; align-items: flex-start; justify-content: space-between; min-height: 4.4rem; }
  [data-assistant-widget].assistant--business .assistant-starter svg { color: var(--assistant-accent); }
  [data-assistant-widget].assistant--neurotech .assistant-starter { border-radius: 999px; background: #edf3fb; }
  [data-assistant-widget] .assistant-welcome:has(+ .assistant-messages:not(:empty)) { padding-bottom: 0.9rem; border-bottom: 1px solid var(--assistant-border); }
  [data-assistant-widget] .assistant-messages:not(:empty) { margin-top: 0.9rem; }

  [data-assistant-widget] .assistant-messages { display: flex; flex-direction: column; gap: 0.65rem; }
  [data-assistant-widget] .assistant-message {
    max-width: 89%;
    padding: 0.7rem 0.85rem;
    border-radius: 0.8rem;
    font-size: 0.86rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  [data-assistant-widget] .assistant-message.user { align-self: flex-end; background: var(--assistant-accent); color: var(--assistant-accent-text); }
  [data-assistant-widget] .assistant-message.assistant,
  [data-assistant-widget] .assistant-message.loading { align-self: flex-start; border: 1px solid var(--assistant-border); background: color-mix(in srgb, var(--assistant-surface) 90%, #e8edf2 10%); }
  [data-assistant-widget] .assistant-message.error { align-self: flex-start; border: 1px solid #e4a9a9; background: #fff5f5; color: #8c2424; }
  [data-assistant-widget] .assistant-message a { color: inherit; font-weight: 750; text-decoration: underline; text-underline-offset: 0.18em; }
  [data-assistant-widget] .assistant-message a:hover { color: var(--assistant-accent); }
  [data-assistant-widget] .assistant-recovery { margin-top: 0.9rem; padding-top: 0.7rem; border-top: 1px solid var(--assistant-border); }
  [data-assistant-widget] .assistant-recovery[hidden] { display: none; }
  [data-assistant-widget] .assistant-recovery p { margin: 0 0 0.4rem; color: var(--assistant-muted); font-size: 0.8rem; }
  [data-assistant-widget] .assistant-recovery > div { display: flex; flex-wrap: wrap; gap: 0.3rem 0.9rem; }
  [data-assistant-widget] .assistant-recovery a { display: inline-flex; align-items: center; min-height: 2.5rem; color: var(--assistant-text); font-size: 0.8rem; font-weight: 700; text-underline-offset: 0.2em; }

  [data-assistant-widget] .assistant-form {
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
    margin: 0.5rem 1rem 1rem;
    padding: 0.25rem;
    border: 1px solid var(--assistant-border);
    border-radius: 999px;
    background: var(--assistant-surface);
  }
  [data-assistant-widget] .assistant-input {
    flex: 1;
    min-width: 0;
    min-height: 2.5rem;
    max-height: 7rem;
    padding: 0.65rem 0.75rem;
    resize: none;
    border: 0;
    background: transparent;
    color: var(--assistant-text);
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.25;
  }
  [data-assistant-widget] .assistant-input::placeholder { color: var(--assistant-muted); }
  [data-assistant-widget] .assistant-send {
    display: grid;
    place-items: center;
    flex: 0 0 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--assistant-accent);
    color: var(--assistant-accent-text);
    cursor: pointer;
  }
  [data-assistant-widget].assistant--ai .assistant-send { color: #fff; }
  [data-assistant-widget] .assistant-send:disabled { opacity: 0.85; cursor: not-allowed; }
  [data-assistant-widget] .assistant-input:disabled,
  [data-assistant-widget] .assistant-starter:disabled { opacity: 0.55; cursor: not-allowed; }

  [data-assistant-widget] :is(button, textarea, a):focus-visible { outline: 2px solid var(--assistant-accent); outline-offset: 3px; }
  [data-assistant-widget] .assistant-input:focus-visible { outline: none; }
  [data-assistant-widget] .assistant-form:focus-within { border-color: var(--assistant-accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--assistant-accent) 25%, transparent); }
  [data-assistant-widget] .assistant-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 640px) {
    [data-assistant-widget] { right: 1rem; bottom: 1rem; }
    [data-assistant-widget] .assistant-panel {
      right: 0.75rem;
      left: 0.75rem;
      bottom: 5.25rem;
      width: auto;
      height: min(23rem, calc(100dvh - 6.5rem));
    }
    [data-assistant-widget] .assistant-panel:has(.assistant-messages:not(:empty)) { height: min(29rem, calc(100dvh - 6.5rem)); }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-assistant-widget] *, [data-assistant-widget] *::before, [data-assistant-widget] *::after { transition: none !important; scroll-behavior: auto !important; }
  }
</style>

<script>
  let assistantModulePromise;
  const loadAssistant = () => {
    assistantModulePromise ??= import('../assistantWidget.client');
    return assistantModulePromise;
  };
  document.querySelectorAll('[data-assistant-widget]').forEach((root) => {
    const toggle = root.querySelector('.assistant-toggle');
    toggle?.addEventListener('pointerenter', () => { loadAssistant(); }, { once: true, passive: true });
    toggle?.addEventListener('focus', () => { loadAssistant(); }, { once: true });
    toggle?.addEventListener('click', async (event) => {
      if (root.dataset.initialized === 'true') return;
      event.preventDefault();
      const { initSocietyAssistant } = await loadAssistant();
      initSocietyAssistant(root, { open: true });
    });
  });
</script>
