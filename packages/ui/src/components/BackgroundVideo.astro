---
interface Props {
  src: string;
  webmSrc?: string;
  poster?: string;
  className?: string;
  videoClass?: string;
  overlayClass?: string;
  objectPosition?: string;
}

const {
  src,
  webmSrc,
  poster,
  className = '',
  videoClass = '',
  overlayClass = '',
  objectPosition = 'center',
} = Astro.props;
---

<div
  class={`background-video ${className}`}
  style={`--media-poster: ${poster ? `url('${poster}')` : 'none'}; --media-position: ${objectPosition};`}
  aria-hidden="true"
>
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster}
    class={`background-video__media ${videoClass}`}
    tabindex="-1"
  >
    {webmSrc && <source src={webmSrc} type="video/webm" />}
    <source src={src} type="video/mp4" />
  </video>
  <div class={`background-video__overlay ${overlayClass}`}></div>
  <slot />
</div>

<style>
  .background-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-image: var(--media-poster);
    background-position: var(--media-position);
    background-size: cover;
  }

  .background-video__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--media-position);
    pointer-events: none;
  }

  .background-video__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .background-video__media {
      display: none;
    }
  }
</style>
