---
/**
 * BaseLayout — minimal structural shell shared by all public society layouts.
 *
 * Renders the full HTML document. App-specific layouts compose on top of this
 * by passing their own nav/footer in the named slots, or simply using the
 * default slot for full-page control.
 *
 * Props are forwarded to SiteHead — see SiteHead.astro for full docs.
 */
import SiteHead from './SiteHead.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: URL | string;
  ogType?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  extraFontHrefs?: string[];
  /** Additional class(es) on <html>, e.g. 'scroll-smooth'. */
  htmlClass?: string;
  /** Additional class(es) on <body>. */
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl = Astro.url,
  ogType,
  twitterCard,
  extraFontHrefs,
  htmlClass,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[htmlClass]}>
  <head>
    <SiteHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      ogType={ogType}
      twitterCard={twitterCard}
      extraFontHrefs={extraFontHrefs}
    />
    {/* App-specific <head> additions (inline styles, extra scripts, etc.) */}
    <slot name="head" />
  </head>
  <body class:list={[bodyClass]}>
    <slot />
  </body>
</html>
