---
import type { Society } from '@surreysocieties/admin/types';
interface Props { society: Society; }
const { society } = Astro.props;
---
<form class="contact-form" data-contact-form data-email={society.contactEmail} data-society={society.shortName}>
  <div class="contact-form__row">
    <div><label for="contact-name">Your name</label><input id="contact-name" name="name" autocomplete="name" required maxlength="100" /></div>
    <div><label for="contact-email">Your email</label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
  </div>
  <div><label for="contact-message">Your message</label><textarea id="contact-message" name="message" required maxlength="4000" rows="5"></textarea></div>
  <button class="community-button" type="submit">Open email app <span aria-hidden="true">↗</span></button>
  <p class="contact-form__note">Your email app will open with the message ready for you to send.</p>
  <a class="contact-form__mailto" href={`mailto:${society.contactEmail}`} hidden aria-hidden="true" tabindex="-1"></a>
  <noscript><p>Email us directly at <a href={`mailto:${society.contactEmail}`}>{society.contactEmail}</a>. Enable JavaScript to use this form.</p></noscript>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form => {
    const emailLink = form.querySelector<HTMLAnchorElement>('.contact-form__mailto')!;
    const emailHref = () => {
      const data = new FormData(form);
      const body = `${String(data.get('message')).trim()}\n\nFrom: ${String(data.get('name')).trim()}\nReply to: ${String(data.get('email')).trim()}`;
      return `mailto:${form.dataset.email}?subject=${encodeURIComponent(`Enquiry for ${form.dataset.society}`)}&body=${encodeURIComponent(body)}`;
    };
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      emailLink.href = emailHref();
      emailLink.click();
    });
  });
</script>

<style>
  .contact-form { display: grid; gap: 20px; }
  .contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .contact-form label { display: block; margin-bottom: 8px; font-size: 16px; font-weight: 600; }
  .contact-form input, .contact-form textarea { box-sizing: border-box; width: 100%; border: 1px solid #84909b; border-radius: 0; padding: 12px; color: var(--society-ink); background: #fff; font: inherit; font-size: 16px; line-height: 1.5; }
  .contact-form textarea { resize: vertical; min-height: 144px; }
  .contact-form .contact-form__note { margin: -12px 0 0; font-size: 15px; line-height: 1.6; }
  .contact-form .community-button { justify-self: start; min-width: 200px; }
  @media (max-width: 540px) { .contact-form__row { grid-template-columns: 1fr; } }
</style>
