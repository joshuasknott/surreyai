---
interface Props {
  src: string;
  fallbackSrc?: string;
  alt: string;
  className?: string;
  imgClass?: string;
  loading?: 'eager' | 'lazy';
  objectPosition?: string;
  sizes?: string;
}

const {
  src,
  fallbackSrc,
  alt,
  className = '',
  imgClass = '',
  loading = 'lazy',
  objectPosition = 'center',
  sizes = '(min-width: 1024px) 50vw, 100vw',
} = Astro.props;
---

<figure class={`responsive-image-frame ${className}`} style={`--media-position: ${objectPosition};`}>
  <picture>
    {fallbackSrc && <source srcset={src} type="image/webp" sizes={sizes} />}
    <img
      src={fallbackSrc ?? src}
      alt={alt}
      loading={loading}
      decoding="async"
      sizes={sizes}
      class={`responsive-image-frame__image ${imgClass}`}
    />
  </picture>
</figure>

<style>
  .responsive-image-frame {
    overflow: hidden;
  }

  .responsive-image-frame picture,
  .responsive-image-frame__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .responsive-image-frame__image {
    object-fit: cover;
    object-position: var(--media-position);
  }
</style>
