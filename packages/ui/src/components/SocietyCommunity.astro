---
import type { Society } from '@surreysocieties/admin/types';
import ContactForm from './ContactForm.astro';
import SocialIcon from './SocialIcon.astro';
interface Props { society: Society; committee?: Array<{ name: string; role?: string }>; }
const { society, committee = [] } = Astro.props;
// The Union-confirmed roster remains visible if the public backend is unavailable.
const officers = society.signatories.map(officer => {
  const member = committee.find(member => member.role === officer.role && member.name.trim()) ?? officer;
  return { ...member, name: member.name === 'Josh Knott' ? 'Joshua Knott' : member.name };
});
const socialNames: Record<string, string> = { instagram: 'Instagram', linkedin: 'LinkedIn', tiktok: 'TikTok', discord: 'Discord', whatsapp: 'WhatsApp', linktree: 'Linktree' };
const socialLinks = Object.entries(society.socials).filter(([key, href]) => socialNames[key] && href);
---
<section id="committee" class="community-section" aria-labelledby="committee-title">
  <div class="community-shell">
    <div class="community-heading">
      <h2 id="committee-title">Meet the committee.</h2>
      <p>The students running {society.shortName}.</p>
    </div>
    <div class="community-officers">
      {officers.map(officer => (
        <article class="officer-card">
          <div class="officer-card__identity">
            <span class="officer-card__initials" aria-hidden="true">{officer.name.trim().split(/\s+/).filter((_, index, names) => index === 0 || index === names.length - 1).map(name => name[0]).join('')}</span>
            <p>{officer.role}</p>
          </div>
          <h3>{officer.name}</h3>
        </article>
      ))}
    </div>
  </div>
</section>
<section id="join" class="community-section community-join" aria-labelledby="join-title">
  <div class="community-shell community-join__inner">
    <div>
      <h2 id="join-title">Come and join us.</h2>
      <p>{society.membershipUrl ? 'Get your membership through the Union, then join our WhatsApp group for events and society news.' : 'Join our WhatsApp group to meet the society and hear about upcoming events. Everyone is welcome, whatever you study.'}</p>
    </div>
    <div class="community-join__actions">
      {society.membershipUrl && <a class="community-button" href={society.membershipUrl} target="_blank" rel="noopener noreferrer">Get your membership <span aria-hidden="true">↗</span></a>}
      <a class:list={['community-button', society.membershipUrl && 'community-button--outline']} href={society.socials.whatsapp} target="_blank" rel="noopener noreferrer">Join our WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
<section id="contact" class="community-section" aria-labelledby="contact-title">
  <div class="community-shell community-contact">
    <div>
      <h2 id="contact-title">Get in touch.</h2>
      <p>Got a question, an idea for an event, or want to work with us? Send the committee a message.</p>
      <a class="community-email" href={`mailto:${society.contactEmail}`}><SocialIcon name="email" /><span>{society.contactEmail}</span></a>
      <nav class="community-socials" aria-label="Society social channels">
        {socialLinks.map(([key, href]) => <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${socialNames[key]} (opens in a new tab)`}><SocialIcon name={key} /><span>{socialNames[key]}</span><span class="social-arrow" aria-hidden="true">↗</span></a>)}
        <a href={society.studentsUnionUrl} target="_blank" rel="noopener noreferrer" aria-label="Union page (opens in a new tab)"><SocialIcon name="union" /><span>Union page</span><span class="social-arrow" aria-hidden="true">↗</span></a>
      </nav>
    </div>
    <ContactForm society={society} />
  </div>
</section>

<style is:global>
  .community-section { padding: clamp(56px, 7vw, 96px) 28px; background: var(--society-paper); color: var(--society-ink); }
  .community-shell { max-width: 1168px; margin-inline: auto; }
  .community-section h2 { font-size: clamp(32px, 4vw, 48px); font-weight: 700; line-height: 1.15; letter-spacing: -0.035em; margin: 0 0 16px; text-wrap: balance; }
  .society-business .community-section h2 { font-family: 'Playfair Display', Georgia, serif; }
  .community-section p { font-size: 17px; line-height: 1.65; color: var(--society-muted); margin: 0; }
  .community-heading { margin-bottom: 40px; }
  .community-officers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .community-officers .officer-card { display: flex; flex-direction: column; gap: 32px; min-width: 0; padding: 28px; border: 1px solid var(--society-line); border-top: 3px solid var(--society-accent); border-radius: 16px; background: #fff; box-shadow: 0 6px 20px #081b3010; }
  .officer-card__identity { display: flex; align-items: center; gap: 18px; }
  .officer-card__initials { display: grid; place-items: center; flex-shrink: 0; width: 68px; height: 68px; border-radius: 50%; background: var(--society-ink); color: var(--society-accent); font-size: 24px; font-weight: 600; letter-spacing: -.03em; }
  .community-officers .officer-card p { font-size: 16px; line-height: 1.4; font-weight: 550; color: var(--society-muted); }
  .community-officers h3 { font-size: 26px; line-height: 1.3; font-weight: 650; letter-spacing: -.025em; margin: 0; max-width: 24ch; text-wrap: balance; overflow-wrap: anywhere; }
  .community-join { background: var(--society-ink); color: #fffaf1; }
  .community-join__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px); gap: 64px; align-items: center; }
  .community-join p { color: #dddfe4; max-width: 56ch; }
  .community-join__actions { display: grid; gap: 12px; }
  .community-button { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 52px; padding: 14px 22px; border: 1px solid var(--society-accent); background: var(--society-accent); color: var(--society-ink); font-size: 17px; font-weight: 650; text-decoration: none; cursor: pointer; }
  .community-button--outline { background: transparent; border-color: #ffffff70; color: #fffaf1; }
  .society-public .community-button:not(.community-button--outline) { color: var(--society-ink); }
  .community-button:hover { filter: brightness(1.08); }
  .community-button:disabled { opacity: .65; cursor: wait; }
  .community-contact { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1fr); gap: clamp(32px, 7vw, 96px); }
  .community-contact > div > p { max-width: 40ch; }
  .community-email { display: flex; align-items: center; gap: 12px; margin: 24px 0; padding-block: 10px; font-size: 17px; text-underline-offset: 5px; overflow-wrap: anywhere; }
  .community-email span { min-width: 0; }
  .community-socials { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 460px; }
  .community-socials a { display: flex; gap: 12px; align-items: center; min-height: 54px; padding: 14px; font-size: 16px; font-weight: 550; border: 1px solid #aab2ba; border-radius: 6px; background: #fff; text-decoration: none; }
  .community-socials a:hover { border-color: var(--society-ink); background: #f0f0ed; }
  .social-arrow { margin-left: auto; font-size: 17px; }
  @media (max-width: 359px) { .community-socials { grid-template-columns: 1fr; } }
  .community-section :is(a, button, input, textarea):focus-visible { outline: 3px solid var(--society-ink); outline-offset: 4px; }
  .community-join a:focus-visible { outline-color: var(--society-accent); }
  @media (max-width: 760px) {
    .community-officers, .community-contact, .community-join__inner { grid-template-columns: 1fr; gap: 32px; }
    .community-officers { gap: 20px; }
    .community-officers .officer-card { padding: 24px; gap: 24px; }
    .community-officers h3 { font-size: 24px; }
    .community-section { padding-inline: 20px; }
    .community-heading { margin-bottom: 28px; }
    .community-join__actions { max-width: 420px; }
  }
</style>
